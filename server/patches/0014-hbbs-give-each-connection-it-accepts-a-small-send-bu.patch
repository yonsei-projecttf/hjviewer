+/// HJViewer: sets the kernel's send buffer (SO_SNDBUF) of a connection to `size` bytes and
+/// returns the size the kernel then reports for it: Linux keeps twice the size asked for, the
+/// other half being its own bookkeeping, and with it set no longer grows the buffer with the
+/// traffic. Unix only; elsewhere the system's buffer stays and this returns an error.
+#[allow(dead_code)]
+#[cfg(unix)]
+pub fn set_send_buffer(
+    stream: &hbb_common::tokio::net::TcpStream,
+    size: usize,
+) -> std::io::Result<usize> {
+    use hbb_common::libc;
+    use std::os::unix::io::AsRawFd;
+    let fd = stream.as_raw_fd();
+    let mut value = libc::c_int::try_from(size).unwrap_or(libc::c_int::MAX);
+    let mut len = std::mem::size_of::<libc::c_int>() as libc::socklen_t;
+    let value_ptr = &mut value as *mut libc::c_int as *mut libc::c_void;
+    // SAFETY: fd is the stream's open socket, and value_ptr and len describe one c_int.
+    if unsafe { libc::setsockopt(fd, libc::SOL_SOCKET, libc::SO_SNDBUF, value_ptr, len) } != 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    // SAFETY: as above, and getsockopt writes at most len bytes there.
+    if unsafe { libc::getsockopt(fd, libc::SOL_SOCKET, libc::SO_SNDBUF, value_ptr, &mut len) } != 0
+    {
+        return Err(std::io::Error::last_os_error());
+    }
+    Ok(value.max(0) as usize)
+}
+
+#[allow(dead_code)]
+#[cfg(not(unix))]
+pub fn set_send_buffer(
+    _stream: &hbb_common::tokio::net::TcpStream,
+    _size: usize,
+) -> std::io::Result<usize> {
+    Err(std::io::ErrorKind::Unsupported.into())
+}
