+#[test]
+fn a_client_that_reads_gets_what_hbbs_forwards_up_to_the_largest_message() {
+    let server = Hbbs::start("reads", &["-r", "192.0.2.10"]);
+    runtime().block_on(async {
+        // A registration, a punch hole with an SDP offer and its answer, ICE candidates both
+        // ways and a relay request with its response, each message near MAX_MESSAGE_KB: through
+        // a send buffer smaller than any of them, every one arrives whole.
+        let large = MAX_MESSAGE - 4096;
+        let mut pc = registered_pc(&server).await;
+        let mut controller = Client::connect(&server, "198.51.100.62", Some(50062)).await;
+        let mut msg = punch_hole_request(&server);
+        msg.mut_punch_hole_request().webrtc_sdp_offer = "o".repeat(large);
+        controller.send(msg).await;
+        let rendezvous_message::Union::PunchHole(ph) = pc.recv().await else {
+            panic!("expected a punch hole");
+        };
+        assert_eq!(ph.webrtc_sdp_offer.len(), large);
+        let mut msg = RendezvousMessage::new();
+        msg.set_punch_hole_sent(PunchHoleSent {
+            socket_addr: ph.socket_addr.clone(),
+            id: PEER_ID.to_owned(),
+            relay_server: "192.0.2.10".to_owned(),
+            version: "1.5.0".to_owned(),
+            webrtc_sdp_answer: "a".repeat(large),
+            ..Default::default()
+        });
+        // the PC answers each on a connection of its own
+        let mut answer = Client::connect(&server, "203.0.113.10", Some(40011)).await;
+        answer.send(msg).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(res.webrtc_sdp_answer.len(), large);
+
+        let to = AddrMangle::decode(&ph.socket_addr);
+        let mut trickle = Client::connect(&server, "203.0.113.10", Some(40012)).await;
+        for i in 0..20 {
+            controller
+                .send(ice_candidate(PEER_ID, &format!("{i:-<large$}")))
+                .await;
+            let rendezvous_message::Union::IceCandidate(ice) = pc.recv().await else {
+                panic!("expected the controller's candidate");
+            };
+            assert_eq!(ice.candidate, format!("{i:-<large$}"));
+            trickle.send(candidate_to(to, large)).await;
+            let rendezvous_message::Union::IceCandidate(ice) = controller.recv().await else {
+                panic!("expected the peer's candidate");
+            };
+            assert_eq!(ice.candidate.len(), large);
+        }
+
+        let mut msg = RendezvousMessage::new();
+        msg.set_request_relay(RequestRelay {
+            id: PEER_ID.to_owned(),
+            uuid: "01890a5d-ac96-774b-bcce-b302099a8057".to_owned(),
+            relay_server: "192.0.2.10".to_owned(),
+            licence_key: server.key.clone(),
+            ..Default::default()
+        });
+        controller.send(msg).await;
+        let rendezvous_message::Union::RequestRelay(rf) = pc.recv().await else {
+            panic!("expected a relay request");
+        };
+        let mut rr = RelayResponse {
+            socket_addr: rf.socket_addr.clone(),
+            uuid: rf.uuid.clone(),
+            relay_server: "192.0.2.10".to_owned(),
+            version: "1.5.0".to_owned(),
+            ..Default::default()
+        };
+        rr.set_id(PEER_ID.to_owned());
+        let mut msg = RendezvousMessage::new();
+        msg.set_relay_response(rr);
+        let mut relayed = Client::connect(&server, "203.0.113.10", Some(40013)).await;
+        relayed.send(msg).await;
+        let rendezvous_message::Union::RelayResponse(rr) = controller.recv().await else {
+            panic!("expected a relay response");
+        };
+        assert_eq!(rr.uuid, rf.uuid);
+        assert_eq!(rr.relay_server, "192.0.2.10");
+
+        // and the PC is still online
+        controller
+            .send(online_request(vec![PEER_ID.to_owned()]))
+            .await;
+        let rendezvous_message::Union::OnlineResponse(res) = controller.recv().await else {
+            panic!("expected an online response");
+        };
+        assert_eq!(res.states.first().map(|s| s & 0x80), Some(0x80));
+        assert!(!server.log().contains("Close the connection from"));
+    });
+}
