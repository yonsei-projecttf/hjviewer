+/// hbbs's side of a connection in the kernel's table (Linux): its TCP state and the bytes it
+/// holds for the client, unsent or not yet acknowledged; `None` once the socket is gone.
+fn kernel_socket(server_port: u16, client_port: u16) -> Option<(u8, usize)> {
+    let port = |field: &str| {
+        field
+            .rsplit(':')
+            .next()
+            .and_then(|p| u16::from_str_radix(p, 16).ok())
+    };
+    // hbbs listens on both families: a connection to 127.0.0.1 is in tcp6, IPv4-mapped
+    for table in ["/proc/net/tcp", "/proc/net/tcp6"] {
+        let text = std::fs::read_to_string(table).unwrap_or_default();
+        for line in text.lines().skip(1) {
+            let fields: Vec<&str> = line.split_whitespace().collect();
+            if fields.len() > 4
+                && port(fields[1]) == Some(server_port)
+                && port(fields[2]) == Some(client_port)
+            {
+                let state = u8::from_str_radix(fields[3], 16).expect("a TCP state");
+                let queued = fields[4].split(':').next().expect("tx_queue:rx_queue");
+                return Some((
+                    state,
+                    usize::from_str_radix(queued, 16).expect("a tx_queue"),
+                ));
+            }
+        }
+    }
+    None
+}
+
+const TCP_ESTABLISHED: u8 = 1;
+
+/// The local port of a client's connection to hbbs.
+fn client_port(client: &Client) -> u16 {
+    match client.ws.get_ref() {
+        MaybeTlsStream::Plain(stream) => stream.local_addr().expect("local address").port(),
+        _ => unreachable!("a plain connection"),
+    }
+}
+
+/// A connection that sent a punch hole request, for an ID nobody registered, and then stopped
+/// reading: hbbs forwards to it what names its address, `addr`, and logs it as `logged`.
+/// `ports` are hbbs's port and the connection's own, which tell hbbs's side of it in the
+/// kernel's table.
+struct Unread {
+    addr: SocketAddr,
+    logged: String,
+    ports: (u16, u16),
+    _ws: Option<Client>,
+    _tcp: Option<Framed<TcpStream, BytesCodec>>,
+}
+
+fn nobody_punched(server: &Hbbs) -> RendezvousMessage {
+    let mut msg = punch_hole_request(server);
+    msg.mut_punch_hole_request().id = "100000999".to_owned();
+    msg
+}
+
+fn assert_id_not_exist(answer: rendezvous_message::Union) {
+    let rendezvous_message::Union::PunchHoleResponse(res) = answer else {
+        panic!("expected a punch hole response: {answer:?}");
+    };
+    assert_eq!(
+        res.failure.enum_value(),
+        Ok(punch_hole_response::Failure::ID_NOT_EXIST)
+    );
+}
+
+/// An `Unread` on the WebSocket port, from the reverse proxy for a client at `addr`.
+async fn unread_ws(server: &Hbbs, addr: SocketAddr) -> Unread {
+    let mut client = Client::connect(server, &addr.ip().to_string(), Some(addr.port())).await;
+    client.send(nobody_punched(server)).await;
+    assert_id_not_exist(client.recv().await);
+    Unread {
+        addr,
+        logged: addr.to_string(),
+        ports: (server.port + 2, client_port(&client)),
+        _ws: Some(client),
+        _tcp: None,
+    }
+}
+
+/// An `Unread` on the TCP port, whose address is the connection's own.
+async fn unread_tcp(server: &Hbbs) -> Unread {
+    let stream = TcpStream::connect(("127.0.0.1", server.port))
+        .await
+        .expect("connect to the tcp port");
+    let addr = stream.local_addr().expect("local address");
+    let mut tcp = Framed::new(stream, BytesCodec::new());
+    let bytes = nobody_punched(server).write_to_bytes().expect("encode");
+    tcp.send(Bytes::from(bytes)).await.expect("send over tcp");
+    let reply = timeout(Duration::from_secs(5), tcp.next())
+        .await
+        .expect("an answer within 5s")
+        .expect("an answer")
+        .expect("read over tcp");
+    assert_id_not_exist(
+        RendezvousMessage::parse_from_bytes(&reply)
+            .expect("decode")
+            .union
+            .expect("a message with a body"),
+    );
+    Unread {
+        addr,
+        // as hbbs's dual-stack listener has it
+        logged: format!("[::ffff:{}]:{}", addr.ip(), addr.port()),
+        ports: (server.port, addr.port()),
+        _ws: None,
+        _tcp: Some(tcp),
+    }
+}
+
+/// An ICE candidate of `len` bytes that hbbs forwards to whatever connection is at `to`.
+fn candidate_to(to: SocketAddr, len: usize) -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_ice_candidate(IceCandidate {
+        socket_addr: AddrMangle::encode(to).into(),
+        session_key: "session".to_owned(),
+        candidate: "c".repeat(len),
+        ..Default::default()
+    });
+    msg
+}
