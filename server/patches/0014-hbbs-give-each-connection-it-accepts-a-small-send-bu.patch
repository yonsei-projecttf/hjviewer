+#[test]
+fn a_connection_hbbs_accepts_gets_a_small_send_buffer_on_either_port() {
+    let server = Hbbs::start("send-buffer", &[]);
+    runtime().block_on(async {
+        let ws = Client::connect(&server, "198.51.100.60", Some(50060)).await;
+        let tcp = TcpStream::connect(("127.0.0.1", server.port))
+            .await
+            .expect("connect to the tcp port");
+        // As hbbs reads it back from its side of each connection: Linux keeps twice the 16 KiB
+        // it sets, and no longer grows it with the traffic.
+        for (port, ws) in [
+            (client_port(&ws), true),
+            (tcp.local_addr().expect("local address").port(), false),
+        ] {
+            server
+                .wait_wrote(format!(":{port}, ws: {ws}, send buffer Ok(32768)").as_bytes())
+                .await;
+        }
+    });
+}
