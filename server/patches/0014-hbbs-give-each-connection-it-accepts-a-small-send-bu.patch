+#[test]
+fn a_connection_that_stops_reading_is_reset_at_the_write_deadline_and_holds_little_until_then() {
+    let server = Hbbs::start("stalled", &[]);
+    runtime().block_on(async {
+        // Connections that stop reading, over the WebSocket port as from the reverse proxy and
+        // over the TCP port, and from another connection, with no key or ticket, 300 KiB of ICE
+        // candidates for each: more than its socket and hbbs's own buffer take, less than
+        // CONN_QUEUE_BYTES past that, so that only a write waiting ends the connection. Without
+        // a send buffer of its own, the kernel took all but what the client's socket took on
+        // hbbs's side, with no write waiting, and the connection stayed until its idle timeout.
+        let mut unread = Vec::new();
+        for i in 0..8u16 {
+            let addr = SocketAddr::from(([198, 51, 100, 70], 50100 + i));
+            unread.push(unread_ws(&server, addr).await);
+            unread.push(unread_tcp(&server).await);
+        }
+        let before = server.rss_kib();
+        let started = Instant::now();
+        // one candidate for each at a time, which each connection's task takes on to its socket
+        // before the next: the queue's bound holds for what it has not taken yet
+        for round in 0..5 {
+            let mut sender = Client::connect(&server, "198.51.100.71", Some(50071 + round)).await;
+            for target in &unread {
+                sender.send(candidate_to(target.addr, 60 << 10)).await;
+            }
+            // hbbs takes a connection's messages in order: once it answers this, which ends the
+            // connection, it took them all
+            sender.send(online_request(vec![PEER_ID.to_owned()])).await;
+            let rendezvous_message::Union::OnlineResponse(_) = sender.recv().await else {
+                panic!("expected an online response");
+            };
+            sleep(Duration::from_millis(100)).await;
+        }
+        sleep(Duration::from_secs(1)).await;
+
+        // What the kernel holds on hbbs's side meanwhile: the 32 KiB buffer and a segment of up
+        // to 64 KiB past it.
+        let mut held = 0;
+        for target in &unread {
+            let (state, queued) = kernel_socket(target.ports.0, target.ports.1)
+                .expect("hbbs's side of the connection, before the deadline");
+            assert_eq!(state, TCP_ESTABLISHED, "{}", target.addr);
+            assert!(queued <= 96 << 10, "{} holds {queued} bytes", target.addr);
+            held += queued;
+        }
+        let grown = server.rss_kib().saturating_sub(before);
+        assert!(grown < 16 << 10, "hbbs grew by {grown} KiB");
+        eprintln!(
+            "the kernel holds {held} bytes for {} connections",
+            unread.len()
+        );
+
+        // Within the write deadline (10 s) and a margin, each connection is gone from hbbs's
+        // side: reset, rather than left orphaned with what it holds while the kernel probes the
+        // client's closed window.
+        for target in &unread {
+            while kernel_socket(target.ports.0, target.ports.1).is_some() {
+                assert!(
+                    started.elapsed() < Duration::from_secs(18),
+                    "hbbs's side of {} is still there: {:?}",
+                    target.addr,
+                    kernel_socket(target.ports.0, target.ports.1)
+                );
+                sleep(Duration::from_millis(200)).await;
+            }
+        }
+        let log = server.log();
+        for target in &unread {
+            let closed = format!(
+                "Close the connection from {}: a write to it waited 10 s unread",
+                target.logged
+            );
+            assert!(log.contains(&closed), "no {closed:?} in the log");
+        }
+        assert!(
+            !log.contains("queued for it unread"),
+            "a queue went over its bound"
+        );
+    });
+}
