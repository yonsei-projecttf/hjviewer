+#[test]
+fn the_always_use_relay_command_changes_that_setting_and_not_the_relay_names() {
+    let server = Hbbs::start("relay-aur", &["-r", "192.0.2.10"]);
+    runtime().block_on(async {
+        let mut pc = registered_pc(&server).await;
+        assert_eq!(server.console("aur").await, "ALWAYS_USE_RELAY: false\n");
+        for (arg, on) in [("Y", true), ("N", false), ("y", true)] {
+            assert_eq!(server.console(&format!("aur {arg}")).await, "");
+            assert_eq!(
+                server.console("aur").await,
+                format!("ALWAYS_USE_RELAY: {on}\n")
+            );
+            // upstream also took the argument for the relay server list
+            assert_eq!(
+                server.console("rs").await,
+                "192.0.2.10\n",
+                "after aur {arg}"
+            );
+            let named = forward_relay_names(&server, &mut pc, OTHER_RELAY).await;
+            let ours = Some("192.0.2.10".to_owned());
+            assert_eq!(named.relay_response, ours, "relay response after aur {arg}");
+            assert_eq!(
+                named.punch_hole_response, ours,
+                "punch hole report after aur {arg}"
+            );
+            assert_eq!(named.request_relay, ours, "relay request after aur {arg}");
+
+            // and the setting holds: with it, a punch hole has the peer go through the relay
+            let mut controller = Client::connect(&server, "198.51.100.25", Some(50005)).await;
+            let mut msg = punch_hole_request(&server);
+            msg.mut_punch_hole_request().force_relay = false;
+            controller.send(msg).await;
+            let rendezvous_message::Union::PunchHole(ph) = pc.recv().await else {
+                panic!("expected a punch hole");
+            };
+            assert_eq!(
+                ph.nat_type.enum_value() == Ok(NatType::SYMMETRIC),
+                on,
+                "the punch hole after aur {arg}"
+            );
+        }
+    });
+}
