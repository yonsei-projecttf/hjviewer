+#[test]
+fn the_test_keys_are_the_vectors() {
+    for (kid, key) in [(1u8, KEY_1), (2, KEY_2)] {
+        let (pk, _) = sign::keypair_from_seed(&sign::Seed([0x73 + kid; 32]));
+        assert_eq!(base64::encode(pk), key);
+    }
+    let vectors: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/tests/vectors/access-tickets.json"
+        ))
+        .expect("the vectors"),
+    )
+    .expect("JSON");
+    assert_eq!(vectors["keys"]["ticket_1"]["pk"], KEY_1);
+    assert_eq!(vectors["keys"]["ticket_2"]["pk"], KEY_2);
+    assert_eq!(vectors["keys"]["pc"]["pk"], PC_PK);
+    assert_eq!(vectors["keys"]["other_pc"]["pk"], OTHER_PK);
+    assert_eq!(vectors["builtin_text"], BUILTIN_TEXT);
+    // a ticket made here is one the vectors' generator would make
+    let staff = &vectors["tickets"][0];
+    assert_eq!(staff["name"], "staff-ctl");
+    let ticket = Ticket::staff_ctl().times(1760000000, 1760086400);
+    assert_eq!(
+        ticket.payload(),
+        staff["payload"].as_str().expect("payload")
+    );
+    assert_eq!(ticket.sign(), staff["ticket"].as_str().expect("ticket"));
+}
