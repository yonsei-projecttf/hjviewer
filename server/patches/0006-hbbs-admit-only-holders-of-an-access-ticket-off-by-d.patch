+            assert!(!shared.logs_this_one());
+        }
+        assert_eq!(shared.next_log_period(), 1000);
+        assert!(shared.logs_this_one());
+        assert_eq!(shared.next_log_period(), 0);
+    }
+
+    #[test]
+    fn a_strict_reading_of_the_parts() {
+        assert_eq!(kid_number("1"), Some(1));
+        assert_eq!(kid_number("65535"), Some(65535));
+        for bad in [
+            "", "0", "01", "65536", "99999", "123456", "+1", "-1", " 1", "a", "١",
+        ] {
+            assert_eq!(kid_number(bad), None, "{bad:?}");
+        }
+        assert_eq!(base64url("AA"), Some(vec![0]));
+        for bad in ["", "A", "AB", "AA==", "A+", "A/", "AA ", "AAAAA"] {
+            assert_eq!(base64url(bad), None, "{bad:?}");
+        }
+        let pk = "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOFhgk=";
+        assert_eq!(key_32(pk).map(|k| k.len()), Some(32));
+        for bad in [
+            "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOFhgk",
+            "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOFhgl=",
+            "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOFhg==",
+            "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOFhgk==",
+            "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOFh-k=",
+            "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOF가=",
+        ] {
+            assert_eq!(key_32(bad), None, "{bad:?}");
+        }
+        assert!(valid_id("Office-PC_7") && valid_id(&"a".repeat(64)));
+        assert!(!valid_id("") && !valid_id(&"a".repeat(65)) && !valid_id("a b") && !valid_id("가"));
+    }
+}
