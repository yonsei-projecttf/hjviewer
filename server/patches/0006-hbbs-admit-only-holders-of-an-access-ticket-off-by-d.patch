+        );
+        serde_json::from_slice(&bytes).unwrap()
+    }
+
+    fn to_hex(bytes: &[u8]) -> String {
+        bytes.iter().map(|b| format!("{b:02x}")).collect()
+    }
+
+    fn from_hex(text: &str) -> Vec<u8> {
+        (0..text.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&text[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    fn str_of<'a>(v: &'a Value, key: &str) -> &'a str {
+        v[key].as_str().unwrap_or_else(|| panic!("{key} in {v}"))
+    }
+
+    /// The rule of the vectors' access_conf, which every ticket case is decided under.
+    fn vector_rule(v: &Value) -> Rule {
+        match parse(str_of(v, "access_conf").as_bytes()) {
+            Ok(Policy::On(rule)) => rule,
+            other => panic!("the vectors' access_conf: {other:?}"),
+        }
+    }
+
+    fn with_mode(mut rule: Rule, mode: Mode) -> Policy {
+        rule.mode = mode;
+        Policy::On(rule)
+    }
+
+    /// The rule as the vectors write it.
+    fn as_json(policy: &Policy) -> Value {
+        match policy {
+            Policy::Off => json!({ "mode": "off" }),
+            Policy::On(rule) => {
+                let keys: serde_json::Map<String, Value> = rule
+                    .keys
+                    .iter()
+                    .map(|(kid, pk)| (kid.to_string(), json!(base64::encode(pk))))
+                    .collect();
+                json!({
+                    "mode": policy.mode_name(),
+                    "keys": keys,
+                    "not_before": rule.not_before.map(|t| t.timestamp()),
