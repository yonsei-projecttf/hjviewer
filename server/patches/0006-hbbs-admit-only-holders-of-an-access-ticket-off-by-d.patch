+    #[test]
+    fn an_admitted_registration_lapses_with_its_ticket() {
+        let admitted = Admitted {
+            kid: 1,
+            iat: 1000,
+            exp: 2000,
+        };
+        let enforce = rule(&format!("MODE=enforce\n{KEY_1}{KEY_2}NOT_BEFORE=\n"));
+        assert_eq!(lapse(&enforce, Some(&admitted), 1999), None);
+        assert_eq!(
+            lapse(&enforce, Some(&admitted), 2000),
+            Some(Reason::Expired)
+        );
+        // let in while MODE was off: no ticket to go by
+        assert_eq!(lapse(&enforce, None, 1500), Some(Reason::Missing));
+        // NOT_BEFORE after the ticket was made: 1970-01-01T00:16:41Z is 1001
+        let revoked = rule(&format!(
+            "MODE=enforce\n{KEY_1}NOT_BEFORE=1970-01-01T00:16:41Z\n"
+        ));
+        assert_eq!(
+            lapse(&revoked, Some(&admitted), 1500),
+            Some(Reason::Revoked)
+        );
+        let kept = rule(&format!(
+            "MODE=enforce\n{KEY_1}NOT_BEFORE=1970-01-01T00:16:40Z\n"
+        ));
+        assert_eq!(lapse(&kept, Some(&admitted), 1500), None);
+        // its key taken out of the file
+        let other_key = rule(&format!("MODE=enforce\n{KEY_2}NOT_BEFORE=\n"));
+        assert_eq!(
+            lapse(&other_key, Some(&admitted), 1500),
+            Some(Reason::UnknownKid)
+        );
+        // nothing is closed unless the tickets are enforced
+        let count = rule(&format!("MODE=count\n{KEY_2}NOT_BEFORE=\n"));
+        for policy in [&count, &Policy::Off] {
+            assert_eq!(lapse(policy, None, 1500), None);
+            assert_eq!(lapse(policy, Some(&admitted), 5000), None);
+        }
+        assert_eq!(
+            lapse(&Policy::Closed, Some(&admitted), 1500),
+            Some(Reason::Closed)
+        );
+    }
