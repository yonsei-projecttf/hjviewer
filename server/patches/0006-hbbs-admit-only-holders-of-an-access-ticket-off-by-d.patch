+    fn without_a_usable_file_since_the_start_everything_is_refused() {
+        let mut watcher = Watcher::new(PathBuf::from("/p/access.conf"));
+        assert_eq!(*watcher.shared.policy(), Policy::Closed);
+        for (seen, why) in [
+            (Seen::Missing, "no such file"),
+            (
+                Seen::Unusable("not a regular file".to_owned()),
+                "not a regular file",
+            ),
+            (content("MODE=enforce\n"), "no KEY= line"),
+            (
+                content("MODE=on\n"),
+                "line 1: MODE must be off, count or enforce",
+            ),
+        ] {
