+            assert_eq!(level, log::Level::Error);
+            assert_eq!(
+                line,
+                format!(
+                    "access file /p/access.conf: {why}; access closed: every request is refused"
+                )
+            );
+            assert_eq!(*watcher.shared.policy(), Policy::Closed);
+        }
+        // said once, and again an hour later
+        assert_eq!(u64::from(REPEAT_LOOKS) * RELOAD_SECS, 3600);
+        for _ in 1..REPEAT_LOOKS {
+            assert!(watcher.look(content("MODE=on\n")).is_none());
+        }
+        assert!(watcher
+            .look(content("MODE=on\n"))
+            .unwrap()
+            .1
+            .ends_with("every request is refused"));
+        // a good file takes effect
+        let (level, line) = watcher
+            .look(content(&format!("MODE=count\n{KEY_2}NOT_BEFORE=\n")))
+            .unwrap();
+        assert_eq!(
+            (level, line.as_str()),
+            (log::Level::Info, "access count: keys 2")
