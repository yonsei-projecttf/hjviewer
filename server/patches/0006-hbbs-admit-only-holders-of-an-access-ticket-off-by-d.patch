+        let socket = UdpSocket::bind("127.0.0.1:0").await.expect("a UDP socket");
+        let mut buf = [0u8; 1024];
+        for (server, answered) in [(&enforcing, false), (&off, true)] {
+            for bytes in [
+                register_peer.write_to_bytes().expect("encode"),
+                register_pk.clone(),
+            ] {
+                socket
+                    .send_to(&bytes, ("127.0.0.1", server.port))
+                    .await
+                    .expect("send over UDP");
+                let got = timeout(Duration::from_secs(1), socket.recv_from(&mut buf)).await;
+                assert_eq!(got.is_ok(), answered);
