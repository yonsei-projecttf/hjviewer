+        for ticket in [
+            Ticket::staff_ctl(),
+            Ticket::staff_ctl().kid(2),
+            Ticket::guest_ctl(PEER_ID),
+            review,
+            Ticket::pc(OTHER_ID),
+        ] {
+            let token = ticket.sign();
+            assert_eq!(
+                punch_hole(&server, &mut pc, PEER_ID, &token).await,
+                None,
+                "{}",
+                ticket.payload()
+            );
+        }
+        assert_eq!(
+            punch_hole_nobody(&server, &Ticket::staff_ctl().sign()).await,
+            None
+        );
+        // what the console and the log say
+        let counts = server.console("hjv-access").await;
+        assert_eq!(
+            counts,
+            "HJVACCESS1 mode=enforce ph.ok=6 ph.missing=2 ph.malformed=2 ph.unknown_kid=2 \
+             ph.bad_signature=2 ph.wrong_use=2 ph.expired=2 ph.not_yet_valid=2 \
+             ph.wrong_target=2 reg.ok=1\n"
+        );
+        let refused = server
+            .wait_for_lines("access refused ph 198.51.100.20:", 16)
+            .await;
+        assert_eq!(refused.len(), 16, "{refused:?}");
+        assert!(refused[0].contains("] INFO ["), "{refused:?}");
+        assert!(
+            refused[0].ends_with(&format!("for \"{PEER_ID}\": missing")),
+            "{refused:?}"
+        );
+        // the file's rule once, and of a ticket, its sub and TEXT nothing at all
+        let lines = server.access_lines();
+        assert_eq!(lines.len(), 1 + 16, "{lines:?}");
+        assert!(
+            lines[0].ends_with("] access enforce: keys 1,2"),
+            "{lines:?}"
+        );
+        let log = server.log();
+        for (_, token) in &bad {
+            for part in token.split('.').filter(|p| p.len() > 8) {
+                assert!(!log.contains(part), "a part of a ticket in the log: {part}");
+            }
+        }
+        for secret in [SUB, "교직원만", "Staff only"] {
+            assert!(!log.contains(secret), "{secret} in the log");
+        }
+    });
