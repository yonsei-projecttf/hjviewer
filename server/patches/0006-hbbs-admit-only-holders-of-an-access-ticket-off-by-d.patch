index 0000000..a7283bb
--- /dev/null
+++ b/tests/access.rs
@@ -0,0 +1,1484 @@
+//! HJViewer: hbbs admits only holders of an access ticket (hjviewer's docs/access-tickets.md)
+//! once the file named by `--hjv-access-file` (HJV_ACCESS_FILE) says so: at the punch hole
+//! request, the relay request and the registration over TCP/WebSocket; it closes an admitted
+//! registration whose ticket no longer holds and takes no registration over UDP. hbbs reads the
+//! file again every 10 seconds; with the option and no usable file since the start it refuses
+//! everything. The tickets here are signed at run time with the vectors' public test keys
+//! (repeated-byte seeds), since hbbs judges them by its own clock.
+
+use chrono::{SecondsFormat, Utc};
+use hbb_common::{
+    futures_util::{SinkExt, StreamExt},
+    protobuf::Message as _,
+    rendezvous_proto::*,
+    tokio::{
+        self,
+        io::{AsyncReadExt, AsyncWriteExt},
+        net::{TcpStream, UdpSocket},
+        time::{sleep, timeout, Duration, Instant},
+    },
+};
+use sodiumoxide::crypto::sign;
+use std::{
+    net::SocketAddr,
+    path::PathBuf,
+    process::{Child, Command},
+    sync::{
+        atomic::{AtomicU16, Ordering},
+        Mutex,
+    },
+    time::SystemTime,
+};
+use tokio_tungstenite::{
+    tungstenite::{client::IntoClientRequest, http::HeaderValue, Message as WsMessage},
+    MaybeTlsStream, WebSocketStream,
+};
+
+/// The public halves of the vectors' ticket keys 1 and 2 (seeds of 0x74 and 0x75); key 3 (0x76)
+/// is in no KEY line.
+const KEY_1: &str = "VV9GnCIYjpABW92FuIlnjUWfhr349700lxsQubOFhgk=";
+const KEY_2: &str = "LJuaQtV63/1Q5usdpUPek62X022XbSorlzXnFC8/uFk=";
+/// The vectors' PC key (pc_device of hjviewer's tests/data/v3-vectors.json): the bytes every PC
+/// here registers with.
+const PC_PK: &str = "gTl3Dqh9F19Wo1Rmw0x+zMuNipG07jeiXfYPW4/Js5Q=";
+const OTHER_PK: &str = "yFOtDwzSthmuqSzuxP1Wok1kmdWEznklfkXP2BObYKc=";
+const PEER_ID: &str = "123456789";
+const OTHER_ID: &str = "222333444";
+/// An ID nobody registers.
+const NO_PEER_ID: &str = "987654321";
+/// The staff account tag of the vectors.
+const SUB: &str = "598891f1a14389ce";
+const TEXT: &str = "교직원만 연결할 수 있습니다. Staff only. (access not allowed)";
+/// What hbbs shows without a TEXT line and while it has no usable file (5-3).
+const BUILTIN_TEXT: &str = "HJViewer는 연세대학교 교직원용입니다. 연세포탈로 로그인하거나 이용 \
+    비밀번호를 넣어야 연결할 수 있습니다. HJViewer is for Yonsei University staff: sign in with a \
+    Yonsei portal account or enter the access password to connect. (access not allowed)";
+/// hbbs reads the file again this often, and sends a registered peer a heartbeat this often.
+const PERIOD: Duration = Duration::from_secs(10);
+const SLACK: Duration = Duration::from_secs(4);
+
+fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .expect("a clock after 1970")
+        .as_secs()
+}
+
+fn conf(mode: &str, keys: &[&str], not_before: &str) -> String {
+    let mut file = format!("# read again every 10 seconds\nMODE={mode}\n");
+    for (i, key) in keys.iter().enumerate() {
+        file += &format!("KEY={}:{key}\n", i + 1);
+    }
+    file + &format!("NOT_BEFORE={not_before}\nTEXT={TEXT}\n")
+}
+
+fn enforce() -> String {
+    conf("enforce", &[KEY_1, KEY_2], "")
+}
+
+/// A ticket as hjv-api signs one (2-1 to 2-4), with the vectors' key `kid`.
+#[derive(Clone)]
+struct Ticket {
+    kid: u8,
+    who: &'static str,
+    usage: &'static str,
+    sub: &'static str,
+    id: String,
+    pk: String,
+    to: Vec<String>,
+    iat: u64,
+    exp: u64,
+}
+
+impl Ticket {
+    /// A staff phone's: any target, no registration.
+    fn staff_ctl() -> Self {
+        Self {
+            kid: 1,
+            who: "staff",
+            usage: "ctl",
+            sub: SUB,
+            id: String::new(),
+            pk: String::new(),
+            to: Vec::new(),
+            iat: now() - 60,
+            exp: now() + 3600,
+        }
+    }
+
+    /// A bound PC's or a staff Windows app's: its own ID and key, any target.
+    fn pc(id: &str) -> Self {
+        Self {
+            usage: "both",
+            id: id.to_owned(),
+            pk: PC_PK.to_owned(),
+            ..Self::staff_ctl()
+        }
+    }
+
+    /// The access password's for a controller: one target.
+    fn guest_ctl(target: &str) -> Self {
+        Self {
+            who: "guest",
+            sub: "",
+            to: vec![target.to_owned()],
+            ..Self::staff_ctl()
+        }
+    }
+
+    fn kid(self, kid: u8) -> Self {
+        Self { kid, ..self }
+    }
+
+    fn times(self, iat: u64, exp: u64) -> Self {
+        Self { iat, exp, ..self }
+    }
+
+    fn payload(&self) -> String {
+        let to: Vec<String> = self.to.iter().map(|t| format!("\"{t}\"")).collect();
+        format!(
+            r#"{{"v":1,"who":"{}","use":"{}","sub":"{}","id":"{}","pk":"{}","to":[{}],"iat":{},"exp":{}}}"#,
+            self.who,
+            self.usage,
+            self.sub,
+            self.id,
+            self.pk,
+            to.join(","),
+            self.iat,
+            self.exp
+        )
+    }
+
+    fn sign(&self) -> String {
+        let seed = sign::Seed([0x73 + self.kid; 32]);
+        let (_, sk) = sign::keypair_from_seed(&seed);
+        let payload = self.payload();
+        let signature =
+            sign::sign_detached(&[b"hjv-ticket-v1\0", payload.as_bytes()].concat(), &sk);
+        format!(
+            "t1.{}.{}.{}",
+            self.kid,
+            base64::encode_config(payload, base64::URL_SAFE_NO_PAD),
+            base64::encode_config(signature.to_bytes(), base64::URL_SAFE_NO_PAD)
+        )
+    }
+}
+
+/// How hbbs is told about the file.
+#[derive(Clone, Copy, PartialEq)]
+enum Told {
+    No,
+    Env,
+    Arg,
+}
+
+struct Hbbs {
+    child: Child,
+    dir: PathBuf,
+    port: u16,
+    key: String,
+}
+
+/// One hbbs starts at a time: between picking its ports and binding them, another test of this
+/// file would be given the same ones. The names taken so far: each server has a directory of
+/// its name, and the tests run side by side.
+static STARTING: Mutex<Vec<String>> = Mutex::new(Vec::new());
+static NEXT_CLIENT_PORT: AtomicU16 = AtomicU16::new(20000);
+
+impl Hbbs {
+    fn start(name: &str, told: Told, file: Option<&str>) -> Self {
+        Self::start_with(name, told, file, &[("TEST_HBBS", "no")])
+    }
+
+    /// hbbs in a directory of its own, where `file`, if any, is the file the option names.
+    fn start_with(name: &str, told: Told, file: Option<&str>, env: &[(&str, &str)]) -> Self {
+        let dir = std::env::temp_dir().join(format!("hbbs-access-{name}-{}", std::process::id()));
+        std::fs::remove_dir_all(&dir).ok();
+        std::fs::create_dir_all(&dir).expect("create the server's working directory");
+        let conf = dir.join("access.conf");
+        let mut names = STARTING.lock().unwrap_or_else(|e| e.into_inner());
+        assert!(!names.iter().any(|n| n == name), "two servers named {name}");
+        names.push(name.to_owned());
+        if let Some(file) = file {
+            std::fs::write(&conf, file).expect("write the file");
+        }
+        for _ in 0..3 {
+            let port = free_base_port();
+            let log = std::fs::File::create(dir.join("hbbs.log")).expect("create the server log");
+            let mut cmd = Command::new(env!("CARGO_BIN_EXE_hbbs"));
+            cmd.args(["-p", &port.to_string()])
+                .current_dir(&dir)
+                // hbbs reads its options from the environment first
+                .env_clear()
+                .env("RUST_LOG", "debug")
+                .stdout(log.try_clone().expect("share the server log"))
+                .stderr(log);
+            match told {
+                Told::No => {}
+                Told::Env => {
+                    cmd.env("HJV_ACCESS_FILE", &conf);
+                }
+                Told::Arg => {
+                    cmd.arg("--hjv-access-file").arg(&conf);
+                }
+            }
+            for (k, v) in env {
+                cmd.env(k, v);
+            }
+            let mut server = Self {
+                child: cmd.spawn().expect("start hbbs"),
+                dir: dir.clone(),
+                port,
+                key: String::new(),
+            };
+            for _ in 0..100 {
+                if std::net::TcpStream::connect(("127.0.0.1", port + 2)).is_ok() {
+                    server.key = std::fs::read_to_string(dir.join("id_ed25519.pub"))
+                        .expect("hbbs writes its public key before it listens");
+                    return server;
+                }
+                if server.child.try_wait().expect("wait for hbbs").is_some() {
+                    // somebody else took one of the ports in between
+                    break;
+                }
+                std::thread::sleep(std::time::Duration::from_millis(100));
+            }
+            eprintln!("hbbs did not start listening on {port}:\n{}", server.log());
+            server.dir = PathBuf::new();
+        }
+        panic!("hbbs did not start listening");
+    }
+
+    /// Puts a new file in place in one step, as the runbook does (write beside it, rename).
+    fn write_conf(&self, file: &str) {
+        let new = self.dir.join("access.conf.new");
+        std::fs::write(&new, file).expect("write the new file");
+        std::fs::rename(&new, self.dir.join("access.conf")).expect("put the new file in place");
+    }
+
+    fn log(&self) -> String {
+        std::fs::read_to_string(self.dir.join("hbbs.log")).unwrap_or_default()
+    }
+
+    /// The log lines about access that an operator sees (hbbs logs from INFO up).
+    fn access_lines(&self) -> Vec<String> {
+        self.log()
+            .lines()
+            .filter(|l| l.contains("] access ") && !l.contains("] DEBUG ["))
+            .map(str::to_owned)
+            .collect()
+    }
+
+    /// The first operator line with `needle`, once hbbs has written it.
+    async fn wait_for_line(&self, needle: &str, within: Duration) -> String {
+        let until = Instant::now() + within;
+        loop {
+            if let Some(line) = self.access_lines().into_iter().find(|l| l.contains(needle)) {
+                return line;
+            }
+            if Instant::now() > until {
+                panic!("no log line with {needle:?} within {within:?}");
+            }
+            sleep(Duration::from_millis(100)).await;
+        }
+    }
+
+    /// The operator lines with `needle`, once there are `n` of them (hbbs writes its log a
+    /// moment after the fact).
+    async fn wait_for_lines(&self, needle: &str, n: usize) -> Vec<String> {
+        let until = Instant::now() + Duration::from_secs(5);
+        loop {
+            let lines: Vec<String> = self
+                .access_lines()
+                .into_iter()
+                .filter(|l| l.contains(needle))
+                .collect();
+            if lines.len() >= n || Instant::now() > until {
+                return lines;
+            }
+            sleep(Duration::from_millis(100)).await;
+        }
+    }
+
+    /// One console command over 127.0.0.1:<port - 1>, and the answer up to the close.
+    async fn console(&self, cmd: &str) -> String {
+        let mut stream = TcpStream::connect(("127.0.0.1", self.port - 1))
+            .await
+            .expect("connect to the console");
+        stream
+            .write_all(cmd.as_bytes())
+            .await
+            .expect("send the command");
+        let mut out = Vec::new();
+        timeout(Duration::from_secs(3), stream.read_to_end(&mut out))
+            .await
+            .expect("the console answers within 3s")
+            .expect("read the answer");
+        String::from_utf8(out).expect("a UTF-8 answer")
+    }
+
+    /// Waits until the console says `mode` (the file is read again every 10 seconds).
+    async fn wait_for_mode(&self, mode: &str) {
+        let until = Instant::now() + PERIOD + SLACK;
+        loop {
+            let line = self.console("hjv-access").await;
+            if line.starts_with(&format!("HJVACCESS1 mode={mode}")) {
+                return;
+            }
+            assert!(Instant::now() < until, "still {line:?}");
+            sleep(Duration::from_millis(200)).await;
+        }
+    }
+}
+
+impl Drop for Hbbs {
+    fn drop(&mut self) {
+        self.child.kill().ok();
+        self.child.wait().ok();
+        if self.dir.as_os_str().is_empty() {
+            return;
+        }
+        if std::thread::panicking() {
+            eprintln!("---- hbbs log ----\n{}", self.log());
+        }
+        std::fs::remove_dir_all(&self.dir).ok();
+    }
+}
+
+/// A port p with p-1, p and p+2 free for TCP and p for UDP: hbbs listens on all of them.
+fn free_base_port() -> u16 {
+    for _ in 0..100 {
+        let port = std::net::TcpListener::bind("127.0.0.1:0")
+            .and_then(|l| l.local_addr())
+            .expect("pick a free port")
+            .port();
+        if !(1025..=65000).contains(&port) {
+            continue;
+        }
+        let tcp_free = [port - 1, port, port + 2]
+            .iter()
+            .all(|p| std::net::TcpListener::bind(("0.0.0.0", *p)).is_ok());
+        if tcp_free && std::net::UdpSocket::bind(("0.0.0.0", port)).is_ok() {
+            return port;
+        }
+    }
+    panic!("no free port range for hbbs");
+}
+
+/// A client connection to hbbs's WebSocket port, made the way a TLS-terminating reverse proxy
+/// in front of it does, with the client's real address in X-Real-IP / X-Real-Port.
+struct Client {
+    ws: WebSocketStream<MaybeTlsStream<TcpStream>>,
+}
+
+impl Client {
+    async fn connect(server: &Hbbs, real_addr: &str) -> Self {
+        let real_addr: SocketAddr = real_addr.parse().expect("client address");
+        let mut request = format!("ws://127.0.0.1:{}/", server.port + 2)
+            .into_client_request()
+            .expect("websocket request");
+        let headers = request.headers_mut();
+        headers.insert(
+            "X-Real-IP",
+            HeaderValue::from_str(&real_addr.ip().to_string()).expect("ip header"),
+        );
+        headers.insert(
+            "X-Real-Port",
+            HeaderValue::from_str(&real_addr.port().to_string()).expect("port header"),
+        );
+        let (ws, _) = tokio_tungstenite::connect_async(request)
+            .await
+            .expect("connect to hbbs");
+        Self { ws }
+    }
+
+    /// A client at an address no other connection of this test run has.
+    async fn at(server: &Hbbs, ip: &str) -> Self {
+        let port = NEXT_CLIENT_PORT.fetch_add(1, Ordering::Relaxed);
+        Self::connect(server, &format!("{ip}:{port}")).await
+    }
+
+    async fn controller(server: &Hbbs) -> Self {
+        Self::at(server, "198.51.100.20").await
+    }
+
+    async fn send(&mut self, msg: RendezvousMessage) {
+        let bytes = msg.write_to_bytes().expect("encode");
+        self.send_bytes(bytes).await;
+    }
+
+    async fn send_bytes(&mut self, bytes: Vec<u8>) {
+        self.ws
+            .send(WsMessage::Binary(bytes))
+            .await
+            .expect("send to hbbs");
+    }
+
+    /// The next frame within `within`: `None` if there is none, `Some(None)` once hbbs has closed
+    /// the connection. Empty frames are heartbeats.
+    async fn frame(&mut self, within: Duration) -> Option<Option<Vec<u8>>> {
+        loop {
+            match timeout(within, self.ws.next()).await {
+                Err(_) => return None,
+                Ok(Some(Ok(WsMessage::Binary(bytes)))) => return Some(Some(bytes)),
+                Ok(Some(Ok(WsMessage::Close(_)))) | Ok(None) | Ok(Some(Err(_))) => {
+                    return Some(None)
+                }
+                Ok(Some(Ok(_))) => continue,
+            }
+        }
+    }
+
+    /// The next message, echoing heartbeats on the way like the client does.
+    async fn recv(&mut self) -> rendezvous_message::Union {
+        loop {
+            let bytes = self
+                .frame(Duration::from_secs(5))
+                .await
+                .expect("a message from hbbs within 5s")
+                .expect("hbbs closed the connection");
+            if bytes.is_empty() {
+                self.send_bytes(Vec::new()).await;
+                continue;
+            }
+            return RendezvousMessage::parse_from_bytes(&bytes)
+                .expect("decode")
+                .union
+                .expect("a message with a body");
+        }
+    }
+
+    /// Nothing within `within` but heartbeats, which are echoed, and the connection still open.
+    async fn expect_silence_for(&mut self, within: Duration) {
+        let until = Instant::now() + within;
+        loop {
+            let left = until.saturating_duration_since(Instant::now());
+            match self.frame(left).await {
+                None => return,
+                Some(None) => panic!("hbbs closed the connection"),
+                Some(Some(bytes)) if bytes.is_empty() => self.send_bytes(Vec::new()).await,
+                Some(Some(bytes)) => panic!(
+                    "unexpected message: {:?}",
+                    RendezvousMessage::parse_from_bytes(&bytes)
+                ),
+            }
+        }
+    }
+
+    async fn expect_silence(&mut self) {
+        self.expect_silence_for(Duration::from_millis(500)).await;
+    }
+
+    /// Echoes heartbeats until hbbs closes the connection; how long that took.
+    async fn expect_closed(&mut self, within: Duration) -> Duration {
+        let start = Instant::now();
+        loop {
+            let left = (start + within).saturating_duration_since(Instant::now());
+            match self.frame(left).await {
+                None => panic!("hbbs did not close the connection within {within:?}"),
+                Some(None) => return start.elapsed(),
+                Some(Some(bytes)) if bytes.is_empty() => self.send_bytes(Vec::new()).await,
+                Some(Some(bytes)) => panic!(
+                    "unexpected message: {:?}",
+                    RendezvousMessage::parse_from_bytes(&bytes)
+                ),
+            }
+        }
+    }
+
+    /// Registers `id` with the PC key and `ticket` in field 1001, as 1.8.0 does; the result.
+    async fn register(&mut self, id: &str, ticket: Option<&str>) -> register_pk_response::Result {
+        self.send_bytes(register_pk(id, PC_PK, ticket)).await;
+        let rendezvous_message::Union::RegisterPkResponse(res) = self.recv().await else {
+            panic!("expected a register pk response");
+        };
+        // NOT_DEPLOYED keeps the same keep-alive as OK
+        assert_eq!(res.keep_alive, 30);
+        res.result.enum_value().expect("a known result")
+    }
+
+    /// The refusal of a controller's request, as every app reads it: the text and nothing else.
+    async fn expect_punch_hole_refused(&mut self) -> String {
+        let rendezvous_message::Union::PunchHoleResponse(res) = self.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert!(res.socket_addr.is_empty(), "a refusal carries no address");
+        assert!(res.pk.is_empty(), "nor the peer's key");
+        assert!(res.relay_server.is_empty(), "nor a relay");
+        assert!(!res.other_failure.is_empty(), "the app shows other_failure");
+        res.other_failure
+    }
+}
+
+/// A RegisterPk with field 1001 as 1.8.0's hbb_common writes it, last; none without a ticket.
+fn register_pk(id: &str, pk: &str, ticket: Option<&str>) -> Vec<u8> {
+    let mut msg = RendezvousMessage::new();
+    let rk = RegisterPk {
+        id: id.to_owned(),
+        uuid: format!("uuid-of-{id}").into_bytes().into(),
+        pk: base64::decode(pk).expect("base64 key").into(),
+        ..Default::default()
+    };
+    let mut rk_bytes = rk.write_to_bytes().expect("encode");
+    if let Some(ticket) = ticket {
+        // field 1001, wire type 2
+        rk_bytes.extend_from_slice(&[0xca, 0x3e]);
+        let mut len = ticket.len();
+        while len >= 0x80 {
+            rk_bytes.push((len as u8) | 0x80);
+            len >>= 7;
+        }
+        rk_bytes.push(len as u8);
+        rk_bytes.extend_from_slice(ticket.as_bytes());
+    }
+    let parsed = RegisterPk::parse_from_bytes(&rk_bytes).expect("a RegisterPk");
+    msg.set_register_pk(parsed);
+    msg.write_to_bytes().expect("encode")
+}
+
+fn punch_hole_request(server: &Hbbs, id: &str, version: &str, token: &str) -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_punch_hole_request(PunchHoleRequest {
+        id: id.to_owned(),
+        licence_key: server.key.clone(),
+        version: version.to_owned(),
+        token: token.to_owned(),
+        // what HJViewer apps send: allow-websocket forces relay, and relay sends SYMMETRIC
+        nat_type: NatType::SYMMETRIC.into(),
+        force_relay: true,
+        ..Default::default()
+    });
+    msg
+}
+
+fn request_relay(id: &str, token: &str) -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_request_relay(RequestRelay {
+        id: id.to_owned(),
+        uuid: "relay-uuid".to_owned(),
+        relay_server: "relay.example.com".to_owned(),
+        token: token.to_owned(),
+        ..Default::default()
+    });
+    msg
+}
+
+fn runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime")
+}
+
+/// A PC that registered `id` with a ticket of its own and keeps its connection.
+async fn admitted_pc(server: &Hbbs, id: &str, ticket: &Ticket) -> Client {
+    let mut pc = Client::at(server, "203.0.113.10").await;
+    assert_eq!(
+        pc.register(id, Some(&ticket.sign())).await,
+        register_pk_response::Result::OK
+    );
+    pc
+}
+
+/// What a controller with `token` gets for a connection to `id`: the refusal text, or `None`
+/// when the request reached the registered `pc`.
+async fn punch_hole(server: &Hbbs, pc: &mut Client, id: &str, token: &str) -> Option<String> {
+    let mut controller = Client::controller(server).await;
+    controller
+        .send(punch_hole_request(server, id, "1.8.0", token))
+        .await;
+    tokio::select! {
+        msg = pc.recv() => {
+            let rendezvous_message::Union::PunchHole(ph) = msg else {
+                panic!("the PC got {msg:?}");
+            };
+            assert!(ph.force_relay);
+            controller.expect_silence().await;
+            None
+        }
+        text = controller.expect_punch_hole_refused() => {
+            pc.expect_silence().await;
+            Some(text)
+        }
+    }
+}
+
+/// What a controller with `token` gets for an ID nobody registered: the refusal text, or `None`
+/// for ID_NOT_EXIST, the answer of a request hbbs let on.
+async fn punch_hole_nobody(server: &Hbbs, token: &str) -> Option<String> {
+    let mut controller = Client::controller(server).await;
+    controller
+        .send(punch_hole_request(server, NO_PEER_ID, "1.8.0", token))
+        .await;
+    let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+        panic!("expected a punch hole response");
+    };
+    if res.other_failure.is_empty() {
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::ID_NOT_EXIST)
+        );
+        return None;
+    }
+    assert!(res.socket_addr.is_empty());
+    Some(res.other_failure)
+}
