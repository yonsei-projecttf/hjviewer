+#[test]
+fn without_the_option_nothing_changes_and_nothing_is_said() {
+    // the file is there, but hbbs was not told about it
+    let server = Hbbs::start("untold", Told::No, Some(&enforce()));
+    runtime().block_on(async {
+        let mut pc = Client::at(&server, "203.0.113.10").await;
+        assert_eq!(
+            pc.register(PEER_ID, None).await,
+            register_pk_response::Result::OK
+        );
+        assert_eq!(punch_hole(&server, &mut pc, PEER_ID, "").await, None);
+        let mut controller = Client::controller(&server).await;
+        controller.send(request_relay(PEER_ID, "")).await;
+        let rendezvous_message::Union::RequestRelay(rr) = pc.recv().await else {
+            panic!("expected the relay request");
+        };
+        assert_eq!(rr.uuid, "relay-uuid");
+        assert!(server
+            .console("h")
+            .await
+            .ends_with("\nhjv-pk <id>\nhjv-access\n"));
+        assert_eq!(server.console("hjv-access").await, "HJVACCESS1 mode=off\n");
+        // a ticket is carried along and changes nothing either
+        let ticket = Ticket::staff_ctl().sign();
+        assert_eq!(punch_hole(&server, &mut pc, PEER_ID, &ticket).await, None);
+        sleep(Duration::from_millis(1500)).await;
+        let log = server.log();
+        assert!(!log.contains("] access "), "{log}");
+        assert!(!log.contains("store_pk"), "{log}");
+    });
+}
