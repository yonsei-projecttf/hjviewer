+//! HJViewer: only the holders of an access ticket use this server. hjviewer's
+//! docs/access-tickets.md is the contract: the ticket, the decisions and the file.
+//!
+//! From 1.8.0 HJViewer is for Yonsei University staff. hjv-api signs short-lived tickets with an
+//! Ed25519 key: for staff signed in with Yonsei SSO, the PCs bound to them, the App Review account
+//! and whoever enters the access password. The apps carry the tickets without reading them, in
+//! PunchHoleRequest.token, RequestRelay.token and field 1001 of RegisterPk (`hjv_ticket` in the
+//! apps' hbb_common; this server's does not declare it, and protobuf keeps it as an unknown
+//! field). hbbs checks them offline with the public keys of the file named by `--hjv-access-file`
+//! (HJV_ACCESS_FILE):
+//!
+//! ```text
+//! MODE=enforce
+//! KEY=1:<the public key that hjv-api keygen ticket shows>
+//! KEY=2:<the next one, only while the keys change>
+//! NOT_BEFORE=
+//! TEXT=<what a refused app shows> (access not allowed)
+//! ```
+//!
+//! - A punch hole request is checked after the key and the lowest app version, a relay request
+//!   first, both before the peer is looked up. A refusal carries TEXT (the built-in text without
+//!   a TEXT line) in PunchHoleResponse.other_failure or RelayResponse.refuse_reason, and the peer
+//!   never hears of the request.
+//! - A registration over TCP/WebSocket passes the checks of old and has its key stored as
+//!   before, which hjv-api needs to bind a new PC. Without a good ticket the answer is
+//!   NOT_DEPLOYED, and the address, signaling channel and registration time of its ID stay as
+//!   they were. An admitted registration's connection is closed at a heartbeat once its ticket
+//!   has run out, NOT_BEFORE has passed it or its key is gone (counted under `reg` with that
+//!   reason); a newer ticket registered on the same connection extends it. No registration over
+//!   UDP is taken (counted as `udp.ignored`).
+//!
+//! MODE=off checks nothing, as without the option; count decides and counts without refusing;
+//! enforce refuses. hbbs reads the file again every 10 seconds. Unlike the min-controller file,
+//! this one fails closed: with the option and no usable file at the start every request is
+//! refused, and a file that breaks later leaves the last good rule in force. The console command
+//! `hjv-access` answers the mode and how many requests came to each reason since the start.
+//!
+//! No part of a ticket, nor `sub` or TEXT, reaches the log. At the trace level the WebSocket
+//! library logs every frame, the tickets among them: not for production.
+
+use crate::hjv_min_controller::{
+    has_placeholder, head, parse_from, read_file, urls_end_at_spaces, Seen,
+};
+use chrono::{DateTime, SecondsFormat, Utc};
+use hbb_common::{
+    log,
+    protobuf::UnknownValueRef,
+    rendezvous_proto::{PunchHoleResponse, RegisterPk, RelayResponse, RendezvousMessage},
+    tokio::{self, time::MissedTickBehavior},
+};
+use serde_derive::{Deserialize, Serialize};
+use sodiumoxide::crypto::sign;
+use std::{
+    fmt::Write as _,
+    net::SocketAddr,
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc, RwLock,
+    },
+    time::{Duration, SystemTime},
+};
+
+const OPTION: &str = "hjv-access-file";
+const RELOAD_SECS: u64 = 10;
+/// The looks at a file that cannot be used between two errors about it: an hour.
+const REPEAT_LOOKS: u32 = 360;
+const MAX_TICKET_BYTES: usize = 1024;
+/// What a ticket's signature covers in front of its payload (2-2).
+const DOMAIN: &[u8] = b"hjv-ticket-v1\0";
+/// A 64-byte signature in base64url without padding.
+const SIGNATURE_CHARS: usize = 86;
+/// How far ahead of this server's clock a ticket may have been issued.
+const SKEW_SECS: u64 = 60;
+const MAX_LIFETIME_SECS: u64 = 7 * 24 * 3600;
+const MAX_TARGETS: usize = 3;
+/// RegisterPk.hjv_ticket in the apps' hbb_common (1000-1099 are HJViewer's numbers).
+const FIELD_HJV_TICKET: u32 = 1001;
+const MAX_TEXT_CHARS: usize = 2000;
+/// Apps from 1.8.0 on know an access refusal by this phrase. Its "not allowed" also keeps every
+/// older app from asking again on a timer (the client's check_if_retry).
+const MARK: &str = "access not allowed";
+/// What apps from 1.6.0 on take for a version refusal.
+const VERSION_MARK: &str = "version not allowed";
+/// Refusals logged one by one between two looks at the file; the rest are only counted.
+const LOGGED_REFUSALS: u64 = 30;
+/// What the log shows of an ID, which the client chooses.
+const LOGGED_ID_CHARS: usize = 64;
+/// What a refused app shows without a TEXT line, and while no file could be read (5-3). Korean
+/// and English: the apps that show it as it is are those that do not know the mark.
+const BUILTIN_TEXT: &str = "HJViewer는 연세대학교 교직원용입니다. 연세포탈로 로그인하거나 \
+    이용 비밀번호를 넣어야 연결할 수 있습니다. HJViewer is for Yonsei University staff: sign in \
+    with a Yonsei portal account or enter the access password to connect. (access not allowed)";
+/// The ID hbbs's own test_hbbs registers over UDP every second; it stops hbbs when nothing comes
+/// back.
+pub(crate) const TEST_HBBS_ID: &str = "(:test_hbbs:)";
+
+/// Why a request goes on or not: the reasons of 4-1, by the names the log and the console use,
+/// and two states of this server (4-6).
+#[derive(Clone, Copy, PartialEq)]
+#[cfg_attr(test, derive(Debug))]
+enum Reason {
+    Ok,
+    Missing,
+    Oversize,
+    Malformed,
+    UnknownKid,
+    BadSignature,
+    WrongUse,
+    Expired,
+    NotYetValid,
+    Revoked,
+    WrongPc,
+    WrongTarget,
+    /// no usable file since the start: every request is refused unread
+    Closed,
+    /// a registration over UDP while the tickets are enforced
+    Ignored,
+}
+
+const REASON_COUNT: usize = 14;
+const _: () = assert!(Reason::Ignored as usize + 1 == REASON_COUNT);
+/// In the order of the enum, which indexes the counts.
+const REASONS: [Reason; REASON_COUNT] = [
+    Reason::Ok,
+    Reason::Missing,
+    Reason::Oversize,
+    Reason::Malformed,
+    Reason::UnknownKid,
+    Reason::BadSignature,
+    Reason::WrongUse,
+    Reason::Expired,
+    Reason::NotYetValid,
+    Reason::Revoked,
+    Reason::WrongPc,
+    Reason::WrongTarget,
+    Reason::Closed,
+    Reason::Ignored,
+];
+
+impl Reason {
+    fn name(self) -> &'static str {
+        match self {
+            Reason::Ok => "ok",
+            Reason::Missing => "missing",
+            Reason::Oversize => "oversize",
+            Reason::Malformed => "malformed",
+            Reason::UnknownKid => "unknown_kid",
+            Reason::BadSignature => "bad_signature",
+            Reason::WrongUse => "wrong_use",
+            Reason::Expired => "expired",
+            Reason::NotYetValid => "not_yet_valid",
+            Reason::Revoked => "revoked",
+            Reason::WrongPc => "wrong_pc",
+            Reason::WrongTarget => "wrong_target",
+            Reason::Closed => "closed",
+            Reason::Ignored => "ignored",
+        }
+    }
+}
+
+/// Where a request is decided on.
+#[derive(Clone, Copy)]
+enum Point {
+    PunchHole,
+    RequestRelay,
+    Register,
+    Udp,
+}
+
+const POINT_COUNT: usize = 4;
+const _: () = assert!(Point::Udp as usize + 1 == POINT_COUNT);
+/// In the order of the enum, which indexes the counts.
+const POINTS: [Point; POINT_COUNT] = [
+    Point::PunchHole,
+    Point::RequestRelay,
+    Point::Register,
+    Point::Udp,
+];
+
+impl Point {
+    fn name(self) -> &'static str {
+        match self {
+            Point::PunchHole => "ph",
+            Point::RequestRelay => "rr",
+            Point::Register => "reg",
+            Point::Udp => "udp",
+        }
+    }
+}
+
+/// What a ticket is checked against.
+enum At<'a> {
+    /// a punch hole or relay request for the peer `target`
+    Controller { target: &'a str },
+    /// the registration of the ID with the key
+    Peer { id: &'a str, pk: &'a [u8] },
+}
+
+/// What hbbs keeps of the ticket an admitted registration came with, for as long as its
+/// connection lasts (4-4).
+#[derive(Clone, Copy, PartialEq)]
+#[cfg_attr(test, derive(Debug))]
+pub(crate) struct Admitted {
+    kid: u16,
+    iat: u64,
+    exp: u64,
+}
+
+/// What a request comes to under the rule in force (4-6).
+#[derive(Clone, Copy)]
+#[cfg_attr(test, derive(Debug, PartialEq))]
+pub(crate) struct Verdict {
+    /// what it is counted as; `None` while nothing is checked
+    reason: Option<Reason>,
+    refused: bool,
+    /// for a registration with a good ticket: what its connection keeps
+    admitted: Option<Admitted>,
+}
+
+impl Verdict {
+    const OPEN: Verdict = Verdict {
+        reason: None,
+        refused: false,
+        admitted: None,
+    };
+
+    /// Whether a registration may make its connection the peer's signaling channel.
+    pub(crate) fn online(&self) -> bool {
+        !self.refused
+    }
+
+    /// What the connection of an admitted registration keeps of its ticket.
+    pub(crate) fn admitted(&self) -> Option<Admitted> {
+        self.admitted
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+#[cfg_attr(test, derive(Debug))]
+enum Mode {
+    Count,
+    Enforce,
+}
+
+// No Debug outside the tests: TEXT must not reach the log.
+#[cfg_attr(test, derive(Debug, PartialEq))]
+struct Rule {
+    mode: Mode,
+    /// one or two
+    keys: Vec<(u16, sign::PublicKey)>,
+    not_before: Option<DateTime<Utc>>,
+    /// `None`: no TEXT line, the built-in text
+    text: Option<String>,
+}
+
+#[cfg_attr(test, derive(Debug, PartialEq))]
+enum Policy {
+    Off,
+    On(Rule),
+    /// the option names a file, but none could be used since the start
+    Closed,
+}
+
+impl Rule {
+    fn key(&self, kid: u16) -> Option<&sign::PublicKey> {
+        self.keys
+            .iter()
+            .find(|(k, _)| *k == kid)
+            .map(|(_, key)| key)
+    }
+
+    fn revokes(&self, iat: u64) -> bool {
+        self.not_before
+            .is_some_and(|not_before| i128::from(iat) < i128::from(not_before.timestamp()))
+    }
+}
+
+impl Policy {
+    fn text(&self) -> &str {
+        match self {
+            Policy::On(Rule {
+                text: Some(text), ..
+            }) => text,
+            _ => BUILTIN_TEXT,
+        }
+    }
+
+    fn mode_name(&self) -> &'static str {
+        match self {
+            Policy::Off => "off",
+            Policy::On(rule) if rule.mode == Mode::Count => "count",
+            Policy::On(_) => "enforce",
+            Policy::Closed => "closed",
+        }
+    }
+
+    /// For the log: the mode, the key numbers and NOT_BEFORE, never TEXT.
+    fn describe(&self) -> String {
+        let Policy::On(rule) = self else {
+            return format!("access {}", self.mode_name());
+        };
+        let kids: Vec<String> = rule.keys.iter().map(|(kid, _)| kid.to_string()).collect();
+        let mut line = format!("access {}: keys {}", self.mode_name(), kids.join(","));
+        if let Some(not_before) = rule.not_before {
+            let _ = write!(
+                line,
+                ", not before {}",
+                not_before.to_rfc3339_opts(SecondsFormat::AutoSi, true)
+            );
+        }
+        line
+    }
+}
+
+/// The payload of a ticket (2-3), its members in their order.
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Payload {
+    v: u64,
+    who: String,
+    #[serde(rename = "use")]
+    usage: String,
+    sub: String,
+    id: String,
+    pk: String,
+    to: Vec<String>,
+    iat: u64,
+    exp: u64,
+}
+
+/// The reason of 4-1 for `ticket` at `at` under `rule` at `now` (Unix seconds), the first check
+/// that fails; for a good ticket, what an admitted registration keeps of it.
+fn decide(ticket: &[u8], at: &At, rule: &Rule, now: u64) -> Result<Admitted, Reason> {
+    if ticket.is_empty() {
+        return Err(Reason::Missing);
+    }
+    if ticket.len() > MAX_TICKET_BYTES {
+        return Err(Reason::Oversize);
+    }
+    let (kid, payload, signature) = parse_wire(ticket).ok_or(Reason::Malformed)?;
+    let key = rule.key(kid).ok_or(Reason::UnknownKid)?;
+    // from_bytes refuses an S with one of its top three bits set, which libsodium refuses too
+    let signature = sign::Signature::from_bytes(&signature).map_err(|_| Reason::BadSignature)?;
+    if !sign::verify_detached(&signature, &[DOMAIN, &payload].concat(), key) {
+        return Err(Reason::BadSignature);
+    }
+    let p = parse_payload(&payload).ok_or(Reason::Malformed)?;
+    let uses: &[&str] = match at {
+        At::Controller { .. } => &["ctl", "both"],
+        At::Peer { .. } => &["pc", "both"],
+    };
+    if !uses.contains(&p.usage.as_str()) {
+        return Err(Reason::WrongUse);
+    }
+    if now >= p.exp {
+        return Err(Reason::Expired);
+    }
+    if p.iat > now.saturating_add(SKEW_SECS) {
+        return Err(Reason::NotYetValid);
+    }
+    if rule.revokes(p.iat) {
+        return Err(Reason::Revoked);
+    }
+    match at {
+        At::Peer { id, pk } => {
+            if p.id != *id || p.pk != base64::encode(pk) {
+                return Err(Reason::WrongPc);
+            }
+        }
+        At::Controller { target } => {
+            if !p.to.is_empty() && !p.to.iter().any(|to| to == target) {
+                return Err(Reason::WrongTarget);
+            }
+        }
+    }
+    Ok(Admitted {
+        kid,
+        iat: p.iat,
+        exp: p.exp,
+    })
+}
+
+/// The key number, payload and signature of a ticket in the form of 2-1.
+fn parse_wire(ticket: &[u8]) -> Option<(u16, Vec<u8>, Vec<u8>)> {
+    let text = std::str::from_utf8(ticket).ok().filter(|t| t.is_ascii())?;
+    let mut parts = text.split('.');
+    let (version, kid, payload, signature) =
+        (parts.next()?, parts.next()?, parts.next()?, parts.next()?);
+    if parts.next().is_some() || version != "t1" || signature.len() != SIGNATURE_CHARS {
+        return None;
+    }
+    Some((kid_number(kid)?, base64url(payload)?, base64url(signature)?))
+}
+
+/// 1 to 65535 in decimal without zeros in front.
+fn kid_number(text: &str) -> Option<u16> {
+    let digits = !text.is_empty() && text.len() <= 5 && text.bytes().all(|b| b.is_ascii_digit());
+    if !digits || text.starts_with('0') {
+        return None;
+    }
+    text.parse().ok()
+}
+
+/// Unpadded base64url read strictly: only its 64 letters, and exactly the text the bytes give.
+fn base64url(text: &str) -> Option<Vec<u8>> {
+    let letter = |b: u8| b.is_ascii_alphanumeric() || b == b'-' || b == b'_';
+    if text.is_empty() || !text.bytes().all(letter) || text.len() % 4 == 1 {
+        return None;
+    }
+    let bytes = base64::decode_config(text, base64::URL_SAFE_NO_PAD).ok()?;
+    (base64::encode_config(&bytes, base64::URL_SAFE_NO_PAD) == text).then_some(bytes)
+}
+
+/// The 32 bytes of a key in standard base64 with its padding, 44 characters, as written from
+/// them.
+fn key_32(text: &str) -> Option<Vec<u8>> {
+    let letter = |b: &u8| b.is_ascii_alphanumeric() || *b == b'+' || *b == b'/';
+    let b = text.as_bytes();
+    if b.len() != 44 || b[43] != b'=' || !b[..43].iter().all(letter) {
+        return None;
+    }
+    let bytes = base64::decode(text).ok()?;
+    (bytes.len() == 32 && base64::encode(&bytes) == text).then_some(bytes)
+}
+
+/// An ID as hjv-api takes one: 1 to 64 letters, digits, '-' or '_'.
+fn valid_id(text: &str) -> bool {
+    (1..=64).contains(&text.len())
+        && text
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+}
+
+/// The members of a payload that keeps every rule of 2-3 and 2-4.
+fn parse_payload(bytes: &[u8]) -> Option<Payload> {
+    let p: Payload = serde_json::from_slice(bytes).ok()?;
+    // the canonical form: the very bytes these values are written as, so no other order, space,
+    // escape or number form
+    if serde_json::to_vec(&p).ok()? != bytes {
+        return None;
+    }
+    let uses: &[&str] = match p.who.as_str() {
+        "staff" => &["ctl", "pc", "both"],
+        "review" => &["ctl"],
+        "guest" => &["ctl", "pc"],
+        _ => return None,
+    };
+    if p.v != 1 || !uses.contains(&p.usage.as_str()) {
+        return None;
+    }
+    let hex = |b: u8| b.is_ascii_digit() || (b'a'..=b'f').contains(&b);
+    if !p.sub.is_empty() && (p.sub.len() != 16 || !p.sub.bytes().all(hex)) {
+        return None;
+    }
+    if p.usage == "ctl" {
+        if !p.id.is_empty() || !p.pk.is_empty() {
+            return None;
+        }
+    } else if !valid_id(&p.id) || key_32(&p.pk).is_none() {
+        return None;
+    }
+    // so that a mistake of hjv-api's never lets an access password or the review account reach
+    // any PC
+    let (least, most) = match (p.who.as_str(), p.usage.as_str()) {
+        ("review", _) => (1, MAX_TARGETS),
+        ("guest", "ctl") => (1, 1),
+        _ => (0, 0),
+    };
+    let distinct =
+        p.to.iter()
+            .enumerate()
+            .all(|(i, to)| !p.to[..i].contains(to));
+    if !(least..=most).contains(&p.to.len()) || !distinct || !p.to.iter().all(|to| valid_id(to)) {
+        return None;
+    }
+    if p.iat >= p.exp || p.exp - p.iat > MAX_LIFETIME_SECS {
+        return None;
+    }
+    Some(p)
+}
+
+/// The ticket of a registration, read from field 1001 as protobuf reads a string (3-2): the last
+/// value when the field comes length-delimited only, malformed when it comes in another wire
+/// type too, empty when it is not there.
+fn registration_ticket(rk: &RegisterPk) -> Result<&[u8], Reason> {
+    match rk.special_fields.unknown_fields().get(FIELD_HJV_TICKET) {
+        None => Ok(&[]),
+        Some(UnknownValueRef::LengthDelimited(bytes)) => Ok(bytes),
+        Some(_) => Err(Reason::Malformed),
+    }
+}
+
+/// What a request with `ticket` at `at` comes to under `policy` at `now` (4-6).
+fn judge(policy: &Policy, ticket: Result<&[u8], Reason>, at: &At, now: u64) -> Verdict {
+    match policy {
+        Policy::Off => Verdict::OPEN,
+        Policy::Closed => Verdict {
+            reason: Some(Reason::Closed),
+            refused: true,
+            admitted: None,
+        },
+        Policy::On(rule) => {
+            let decided = ticket.and_then(|ticket| decide(ticket, at, rule, now));
+            Verdict {
+                reason: Some(decided.err().unwrap_or(Reason::Ok)),
+                refused: rule.mode == Mode::Enforce && decided.is_err(),
+                admitted: decided.ok(),
+            }
+        }
+    }
+}
+
+/// Why the connection of a registration that came with `admitted` may stay no longer under
+/// `policy` at `now`, if so (4-4).
+fn lapse(policy: &Policy, admitted: Option<&Admitted>, now: u64) -> Option<Reason> {
+    let rule = match policy {
+        Policy::Closed => return Some(Reason::Closed),
+        Policy::On(rule) if rule.mode == Mode::Enforce => rule,
+        _ => return None,
+    };
+    // what came in while MODE was off, or under count without a good ticket, carries none
+    let Some(admitted) = admitted else {
+        return Some(Reason::Missing);
+    };
+    if rule.key(admitted.kid).is_none() {
+        Some(Reason::UnknownKid)
+    } else if now >= admitted.exp {
+        Some(Reason::Expired)
+    } else if rule.revokes(admitted.iat) {
+        Some(Reason::Revoked)
+    } else {
+        None
+    }
+}
+
+/// What is wrong with a refusal text, `None` if the apps show it as it is and stop there: the
+/// rules of the min-controller file's TEXT (hjv_min_controller's text_problem) with this mark.
+fn text_problem(text: &str) -> Option<&'static str> {
+    if text.is_empty() {
+        return Some("is empty");
+    }
+    if text.chars().count() > MAX_TEXT_CHARS {
+        return Some("is longer than 2000 characters");
+    }
+    if text.chars().any(char::is_control) {
+        return Some("has a control character");
+    }
+    if !text.contains(MARK) {
+        return Some(
+            "must contain \"access not allowed\": older apps ask again on a timer without \
+             \"not allowed\", and newer apps know the refusal by the whole phrase",
+        );
+    }
+    if text.to_lowercase().contains(VERSION_MARK) {
+        return Some(
+            "must not contain \"version not allowed\": the apps would take it for a version \
+             refusal",
+        );
+    }
+    if text.starts_with("Failed") {
+        return Some("must not start with \"Failed\": the apps add \": Please try later\" to it");
+    }
+    if text.split(' ').next().is_some_and(|w| w.ends_with("_tip")) {
+        return Some("must not start with a word ending in \"_tip\": the apps translate it alone");
+    }
+    if text.contains(['{', '}']) {
+        return Some("must not have { or }: the apps take them for a translation placeholder");
+    }
+    if text.contains("RustDesk") {
+        return Some("must not name RustDesk: the apps put their own name there");
+    }
+    if has_placeholder(text) {
+        return Some("has a %NAME% in it: nothing is filled in");
+    }
+    if !urls_end_at_spaces(text) {
+        return Some(
+            "must have a space after each URL: the apps make a link of everything up to the \
+             next space",
+        );
+    }
+    None
+}
+
+/// The rule a file's bytes ask for (6-1, 6-2), or why they cannot be used, in words that are
+/// safe to log.
+fn parse(bytes: &[u8]) -> Result<Policy, String> {
+    let Ok(file) = std::str::from_utf8(bytes) else {
+        return Err("not UTF-8".to_owned());
+    };
+    let file = file.strip_prefix('\u{feff}').unwrap_or(file);
+    // a file caught half written must not pass for a shorter one
+    if !file.is_empty() && !file.ends_with('\n') {
+        return Err("the last line has no line break (is it still being written?)".to_owned());
+    }
+    let (mut mode, mut keys, mut not_before, mut text) = (None, Vec::new(), None, None);
+    for (i, line) in file.lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let n = i + 1;
+        let (name, value) = line.split_once('=').unwrap_or_default();
+        let value = (n, value.trim_start());
+        match name {
+            "MODE" if mode.is_none() => mode = Some(value),
+            "KEY" if keys.len() < 2 => keys.push(value),
+            "NOT_BEFORE" if not_before.is_none() => not_before = Some(value),
+            "TEXT" if text.is_none() => text = Some(value),
+            "MODE" | "KEY" | "NOT_BEFORE" | "TEXT" => {
+                return Err(format!("line {n} sets {name} once too often"));
+            }
+            _ if matches!(name.trim_end(), "MODE" | "KEY" | "NOT_BEFORE" | "TEXT") => {
+                return Err(format!("line {n} has a space before its ="));
+            }
+            _ => {
+                return Err(format!(
+                    "line {n} is neither a comment nor MODE=, KEY=, NOT_BEFORE= or TEXT="
+                ));
+            }
+        }
+    }
+    let Some((mode_line, mode)) = mode else {
+        return Err("no MODE= line".to_owned());
+    };
+    let mode = match mode {
+        // so that a mistake in another line never keeps the check from being turned off
+        "off" => return Ok(Policy::Off),
+        "count" => Mode::Count,
+        "enforce" => Mode::Enforce,
+        _ => {
+            return Err(format!(
+                "line {mode_line}: MODE must be off, count or enforce"
+            ))
+        }
+    };
+    if keys.is_empty() {
+        return Err("no KEY= line".to_owned());
+    }
+    let mut parsed: Vec<(u16, sign::PublicKey)> = Vec::new();
+    for (n, value) in keys {
+        let key = value.split_once(':').and_then(|(kid, key)| {
+            Some((
+                kid_number(kid)?,
+                sign::PublicKey::from_slice(&key_32(key)?)?,
+            ))
+        });
+        let Some((kid, key)) = key else {
+            return Err(format!(
+                "line {n}: KEY must be <1-65535>:<a key of 32 bytes in standard base64>, as \
+                 hjv-api keygen ticket shows it"
+            ));
+        };
+        if parsed.iter().any(|(k, pk)| *k == kid || *pk == key) {
+            return Err(format!("line {n}: KEY repeats a key number or a key"));
+        }
+        parsed.push((kid, key));
+    }
+    // NOT_BEFORE comes after the keys: a file cut short at a line break is never a rule without
+    // it, nor one with fewer keys
+    let Some((not_before_line, not_before)) = not_before else {
+        return Err(
+            "no NOT_BEFORE= line (NOT_BEFORE= with nothing after it means none)".to_owned(),
+        );
+    };
+    let not_before = if not_before.is_empty() {
+        None
+    } else {
+        Some(parse_from(not_before).ok_or_else(|| {
+            format!(
+                "line {not_before_line}: NOT_BEFORE must be a UTC time written as \
+                 2026-11-02T00:00:00Z"
+            )
+        })?)
+    };
+    let text = match text {
+        None => None,
+        Some((text_line, text)) => {
+            if let Some(problem) = text_problem(text) {
+                return Err(format!("line {text_line}: TEXT {problem}"));
+            }
+            Some(text.to_owned())
+        }
+    };
+    Ok(Policy::On(Rule {
+        mode,
+        keys: parsed,
+        not_before,
+        text,
+    }))
+}
+
+fn now_secs() -> u64 {
+    // a clock before 1970 is 0, at which no ticket is valid yet
+    SystemTime::now()
+        .duration_since(SystemTime::UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+/// The handle the rendezvous server keeps; clones share one rule and one tally. Without the
+/// option, a handle that checks nothing.
+#[derive(Clone)]
+pub(crate) struct Access(Option<Arc<Shared>>);
+
+struct Shared {
+    /// Written by the watcher only.
+    policy: RwLock<Arc<Policy>>,
+    /// by point and reason, since the start
+    counts: [[AtomicU64; REASON_COUNT]; POINT_COUNT],
+    logged: AtomicU64,
+    not_logged: AtomicU64,
+}
+
+impl Access {
+    /// Reads the file the option names and starts reading it again every 10 seconds; without the
+    /// option, a handle that checks nothing. Needs the tokio runtime.
+    pub(crate) fn start() -> Self {
+        let path = crate::common::get_arg(OPTION);
+        let path = path.trim();
+        if path.is_empty() {
+            return Self(None);
+        }
+        let mut watcher = Watcher::new(PathBuf::from(path));
+        let shared = watcher.shared.clone();
+        let seen = read_file(&watcher.path);
+        watcher.look_and_log(seen);
+        tokio::spawn(watcher.run());
+        Self(Some(shared))
+    }
+
+    /// The answer to a punch hole request for `target` that may not go on, `None` when it may.
+    pub(crate) fn punch_hole(
+        &self,
+        addr: SocketAddr,
+        target: &str,
+        token: &str,
+    ) -> Option<RendezvousMessage> {
+        let text = self
+            .0
+            .as_ref()?
+            .controller(Point::PunchHole, addr, target, token)?;
+        let mut msg_out = RendezvousMessage::new();
+        msg_out.set_punch_hole_response(PunchHoleResponse {
+            other_failure: text,
+            ..Default::default()
+        });
+        Some(msg_out)
+    }
+
+    /// The answer to a relay request for `target` that may not go on, `None` when it may.
+    pub(crate) fn request_relay(
+        &self,
+        addr: SocketAddr,
+        target: &str,
+        token: &str,
+    ) -> Option<RendezvousMessage> {
+        let text = self
+            .0
+            .as_ref()?
+            .controller(Point::RequestRelay, addr, target, token)?;
+        let mut msg_out = RendezvousMessage::new();
+        msg_out.set_relay_response(RelayResponse {
+            refuse_reason: text,
+            ..Default::default()
+        });
+        Some(msg_out)
+    }
+
+    /// What the ticket of a registration comes to, decided before its key is stored; taken in by
+    /// `registered` once the checks of old let the registration through.
+    pub(crate) fn registration(&self, rk: &RegisterPk) -> Verdict {
+        let Some(shared) = self.0.as_ref() else {
+            return Verdict::OPEN;
+        };
+        let at = At::Peer {
+            id: &rk.id,
+            pk: &rk.pk,
+        };
+        judge(&shared.policy(), registration_ticket(rk), &at, now_secs())
+    }
+
+    /// Counts the decision on a registration that the checks of old let through, and logs it if
+    /// it is refused.
+    pub(crate) fn registered(&self, verdict: &Verdict, addr: SocketAddr, id: &str) {
+        if let Some(shared) = self.0.as_ref() {
+            shared.take(Point::Register, verdict, addr, id);
+        }
+    }
+
+    /// Whether a registration over UDP is dropped unanswered: while the tickets are enforced, and
+    /// while no file could be used since the start (4-5).
+    pub(crate) fn refuses_udp(&self, id: &str) -> bool {
+        let Some(shared) = self.0.as_ref() else {
+            return false;
+        };
+        let reason = match &*shared.policy() {
+            Policy::Closed => Reason::Closed,
+            Policy::On(rule) if rule.mode == Mode::Enforce => Reason::Ignored,
+            _ => return false,
+        };
+        // test_hbbs's probe every second would drown what the count is for
+        if id != TEST_HBBS_ID {
+            shared.count(Point::Udp, reason);
+        }
+        true
+    }
+
+    /// Whether the connection the peer `id` registered on is to be closed at its heartbeat, with
+    /// `admitted` what it keeps of its ticket (4-4); counted and logged if so.
+    pub(crate) fn closes(&self, addr: SocketAddr, id: &str, admitted: Option<&Admitted>) -> bool {
+        let Some(shared) = self.0.as_ref() else {
+            return false;
+        };
+        let Some(reason) = lapse(&shared.policy(), admitted, now_secs()) else {
+            return false;
+        };
+        shared.count(Point::Register, reason);
+        if shared.logs_this_one() {
+            log::info!(
+                "access closed reg {} for {:?}: {}",
+                addr,
+                head(id, LOGGED_ID_CHARS),
+                reason.name()
+            );
+        }
+        true
+    }
+
+    /// The console's answer to `hjv-access`, one line: "HJVACCESS1 mode=<mode>" and the counts
+    /// that are not 0 as " <point>.<reason>=<n>". No ID, no address.
+    pub(crate) fn console(&self) -> String {
+        let Some(shared) = self.0.as_ref() else {
+            return "HJVACCESS1 mode=off\n".to_owned();
+        };
+        let mut line = format!("HJVACCESS1 mode={}", shared.policy().mode_name());
+        for point in POINTS {
+            for reason in REASONS {
+                let n = shared.counts[point as usize][reason as usize].load(Ordering::Relaxed);
+                if n > 0 {
+                    let _ = write!(line, " {}.{}={n}", point.name(), reason.name());
+                }
+            }
+        }
+        line.push('\n');
+        line
+    }
+}
+
+impl Shared {
+    fn policy(&self) -> Arc<Policy> {
+        // a poisoned lock still holds a whole rule: the writer only swaps the pointer
+        self.policy
+            .read()
+            .unwrap_or_else(|e| e.into_inner())
+            .clone()
+    }
+
+    fn set_policy(&self, policy: Arc<Policy>) {
+        *self.policy.write().unwrap_or_else(|e| e.into_inner()) = policy;
+    }
+
+    /// Decides on, counts and logs a controller's request; the text to refuse it with.
+    fn controller(
+        &self,
+        point: Point,
+        addr: SocketAddr,
+        target: &str,
+        token: &str,
+    ) -> Option<String> {
+        let policy = self.policy();
+        let at = At::Controller { target };
+        let verdict = judge(&policy, Ok(token.as_bytes()), &at, now_secs());
+        self.take(point, &verdict, addr, target);
+        verdict.refused.then(|| policy.text().to_owned())
+    }
+
+    fn take(&self, point: Point, verdict: &Verdict, addr: SocketAddr, id: &str) {
+        let Some(reason) = verdict.reason else {
+            return;
+        };
+        self.count(point, reason);
+        if verdict.refused && self.logs_this_one() {
+            log::info!(
+                "access refused {} {} for {:?}: {}",
+                point.name(),
+                addr,
+                head(id, LOGGED_ID_CHARS),
+                reason.name()
+            );
+        }
+    }
+
+    fn count(&self, point: Point, reason: Reason) {
+        self.counts[point as usize][reason as usize].fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn logs_this_one(&self) -> bool {
+        if self.logged.fetch_add(1, Ordering::Relaxed) < LOGGED_REFUSALS {
+            return true;
+        }
+        self.not_logged.fetch_add(1, Ordering::Relaxed);
+        false
+    }
+
+    /// Starts the next period of logged refusals and tells how many the last one left out.
+    fn next_log_period(&self) -> u64 {
+        self.logged.store(0, Ordering::Relaxed);
+        self.not_logged.swap(0, Ordering::Relaxed)
+    }
+}
+
+/// Follows the file: every look that finds something new sets the rule and says so once, and a
+/// file that cannot be used is said again every hour while it stays.
+struct Watcher {
+    path: PathBuf,
+    last: Option<Seen>,
+    /// while `last` cannot be used: what was said of it, and the looks since
+    trouble: Option<(String, u32)>,
+    policy: Arc<Policy>,
+    shared: Arc<Shared>,
+}
+
+impl Watcher {
+    fn new(path: PathBuf) -> Self {
+        let policy = Arc::new(Policy::Closed);
+        Self {
+            path,
+            last: None,
+            trouble: None,
+            policy: policy.clone(),
+            shared: Arc::new(Shared {
+                policy: RwLock::new(policy),
+                counts: Default::default(),
+                logged: AtomicU64::new(0),
+                not_logged: AtomicU64::new(0),
+            }),
+        }
+    }
+
+    /// Takes in what a look found; what to log about it, if it is news or a trouble that an hour
+    /// of looks has not seen put right.
+    fn look(&mut self, seen: Seen) -> Option<(log::Level, String)> {
+        if self.last.as_ref() == Some(&seen) {
+            let (line, looks) = self.trouble.as_mut()?;
+            *looks += 1;
+            if *looks < REPEAT_LOOKS {
+                return None;
+            }
+            *looks = 0;
+            return Some((log::Level::Error, line.clone()));
+        }
+        let found = match &seen {
+            // the way to turn the check off is MODE=off, not taking the file away
+            Seen::Missing => Err("no such file".to_owned()),
+            Seen::Unusable(why) => Err(why.clone()),
+            Seen::Content(bytes) => parse(bytes),
+        };
+        let event = match found {
+            Ok(policy) => {
+                self.policy = Arc::new(policy);
+                self.shared.set_policy(self.policy.clone());
+                self.trouble = None;
+                (log::Level::Info, self.policy.describe())
+            }
+            Err(why) => {
+                let kept = match &*self.policy {
+                    Policy::Closed => "access closed: every request is refused".to_owned(),
+                    policy => format!("{} stays in force", policy.describe()),
+                };
+                let line = format!("access file {}: {why}; {kept}", self.path.display());
+                self.trouble = Some((line.clone(), 0));
+                (log::Level::Error, line)
+            }
+        };
+        self.last = Some(seen);
+        Some(event)
+    }
+
+    fn look_and_log(&mut self, seen: Seen) {
+        if let Some((level, line)) = self.look(seen) {
+            log::log!(level, "{}", line);
+        }
+    }
+
+    async fn run(mut self) {
+        let mut timer = tokio::time::interval(Duration::from_secs(RELOAD_SECS));
+        timer.set_missed_tick_behavior(MissedTickBehavior::Delay);
+        // the first tick is at once, and start() has just looked
+        timer.tick().await;
+        loop {
+            timer.tick().await;
+            let not_logged = self.shared.next_log_period();
+            if not_logged > 0 {
+                log::warn!(
+                    "access refused or closed {} more in the last {} seconds",
+                    not_logged,
+                    RELOAD_SECS
+                );
+            }
+            let path = self.path.clone();
+            let seen = match tokio::task::spawn_blocking(move || read_file(&path)).await {
+                Ok(seen) => seen,
+                // the runtime is shutting down
+                Err(err) if err.is_cancelled() => return,
+                Err(_) => Seen::Unusable("cannot be read".to_owned()),
+            };
+            self.look_and_log(seen);
+        }
+    }
+}
