+        // and MODE=off turns it off
+        let (level, line) = watcher.look(content("MODE=off\nKEY=what ever\n")).unwrap();
+        assert_eq!((level, line.as_str()), (log::Level::Info, "access off"));
+        assert_eq!(*watcher.shared.policy(), Policy::Off);
+    }
