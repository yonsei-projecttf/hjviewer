+        let mut msg = punch_hole_request(&server, PEER_ID, "1.8.0", "");
+        if let Some(rendezvous_message::Union::PunchHoleRequest(ph)) = msg.union.as_mut() {
+            ph.licence_key = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=".to_owned();
+        }
+        controller.send(msg).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::LICENSE_MISMATCH)
+        );
+        assert!(res.other_failure.is_empty());
+        // an old version: told to update, not about access
+        for (version, token, answer) in [
+            (
+                "1.7.0",
+                String::new(),
+                Some("Update to 1.8.0. (version not allowed)"),
+            ),
+            (
+                "1.7.0",
+                Ticket::staff_ctl().sign(),
+                Some("Update to 1.8.0. (version not allowed)"),
+            ),
+            ("1.8.0", String::new(), Some(TEXT)),
+            ("1.8.0", Ticket::staff_ctl().sign(), None),
+        ] {
+            let mut controller = Client::controller(&server).await;
+            controller
+                .send(punch_hole_request(&server, PEER_ID, version, &token))
+                .await;
+            match answer {
+                Some(text) => {
+                    assert_eq!(controller.expect_punch_hole_refused().await, text);
+                    pc.expect_silence().await;
+                }
+                None => {
+                    let rendezvous_message::Union::PunchHole(_) = pc.recv().await else {
+                        panic!("expected the punch hole");
+                    };
+                }
+            }
+        }
+        // the version refusals are not access decisions
+        assert_eq!(
+            server.console("hjv-access").await,
+            "HJVACCESS1 mode=enforce ph.ok=1 ph.missing=1 reg.ok=1\n"
+        );
+    });
+    std::fs::remove_dir_all(&dir).ok();
+}
+
+#[test]
+fn field_1001_is_read_off_the_wire() {
+    let vectors: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/tests/vectors/access-tickets.json"
+        ))
+        .expect("the vectors"),
+    )
+    .expect("JSON");
+    let server = Hbbs::start("wire", Told::Env, Some(&enforce()));
+    runtime().block_on(async {
+        let mut pc = Client::at(&server, "203.0.113.10").await;
+        // the vectors' messages as the apps send them; their tickets ran out in 2025
+        // other-pc's ticket ran out too, which is checked before the ID
+        for (name, reason) in [
+            ("ticket", "expired=1"),
+            ("no-field", "missing=1"),
+            ("varint", "malformed=1"),
+            ("other-pc", "expired=2"),
+        ] {
+            let case = vectors["register_pk"]
+                .as_array()
+                .expect("register_pk")
+                .iter()
+                .find(|c| c["name"] == name)
+                .expect("the case");
+            let hex = case["rendezvous_message_hex"].as_str().expect("hex");
+            let bytes: Vec<u8> = (0..hex.len())
+                .step_by(2)
+                .map(|i| u8::from_str_radix(&hex[i..i + 2], 16).expect("hex"))
+                .collect();
+            pc.send_bytes(bytes).await;
+            let rendezvous_message::Union::RegisterPkResponse(res) = pc.recv().await else {
+                panic!("expected a register pk response");
+            };
+            assert_eq!(
+                res.result.enum_value(),
+                Ok(register_pk_response::Result::NOT_DEPLOYED),
+                "{name}"
+            );
+            let counts = server.console("hjv-access").await;
+            assert!(
+                counts.contains(&format!(" reg.{reason}")),
+                "{name}: {counts}"
+            );
+        }
+        // their keys are stored all the same
+        for id in [PEER_ID, OTHER_ID] {
+            let line = server.console(&format!("hjv-pk {id}")).await;
+            assert!(line.starts_with(&format!("HJVPK1 {id} ")), "{line:?}");
+            assert!(line.ends_with(" -\n") && !line.contains(" - -"), "{line:?}");
+        }
+    });
+}
+
+#[test]
+fn the_refusal_also_goes_out_over_plain_tcp() {
+    let server = Hbbs::start("tcp", Told::Env, Some(&enforce()));
+    runtime().block_on(async {
+        let mut stream =
+            hbb_common::tcp::FramedStream::new(format!("127.0.0.1:{}", server.port), None, 3000)
+                .await
+                .expect("connect to hbbs's TCP port");
+        stream
+            .send(&punch_hole_request(&server, NO_PEER_ID, "1.8.0", ""))
+            .await
+            .expect("send to hbbs");
+        let bytes = stream
+            .next_timeout(5000)
+            .await
+            .expect("an answer within 5s")
+            .expect("a whole frame");
+        let Some(rendezvous_message::Union::PunchHoleResponse(res)) =
+            RendezvousMessage::parse_from_bytes(&bytes)
+                .expect("decode")
+                .union
+        else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(res.other_failure, TEXT);
+        let rk = RendezvousMessage::parse_from_bytes(&register_pk(PEER_ID, PC_PK, None))
+            .expect("decode");
+        stream.send(&rk).await.expect("send to hbbs");
+        let bytes = stream
+            .next_timeout(5000)
+            .await
+            .expect("an answer within 5s")
+            .expect("a whole frame");
+        let Some(rendezvous_message::Union::RegisterPkResponse(res)) =
+            RendezvousMessage::parse_from_bytes(&bytes)
+                .expect("decode")
+                .union
+        else {
+            panic!("expected a register pk response");
+        };
+        assert_eq!(
+            res.result.enum_value(),
+            Ok(register_pk_response::Result::NOT_DEPLOYED)
+        );
+    });
+}
