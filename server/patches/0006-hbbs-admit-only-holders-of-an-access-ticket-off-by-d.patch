+    #[test]
+    fn every_ticket_of_the_vectors_comes_to_its_reason() {
+        let v = vectors();
+        let rule = vector_rule(&v);
+        let now = v["now"].as_u64().unwrap();
+        let tickets = v["tickets"].as_array().unwrap();
+        assert_eq!(tickets.len(), 84);
+        let mut seen = Vec::new();
+        for case in tickets {
+            let name = str_of(case, "name");
+            let ticket = str_of(case, "ticket").as_bytes();
+            assert_eq!(case["bytes"], json!(ticket.len()), "{name}");
+            for check in case["checks"].as_array().unwrap() {
+                let expect = str_of(check, "expect");
+                let pk;
+                let at = match str_of(check, "at") {
+                    "punch_hole" | "request_relay" => At::Controller {
+                        target: str_of(check, "target"),
+                    },
+                    "register_pk" => {
+                        pk = base64::decode(str_of(check, "pk")).unwrap();
+                        At::Peer {
+                            id: str_of(check, "id"),
+                            pk: &pk,
+                        }
+                    }
+                    other => panic!("{name}: a check at {other}"),
+                };
+                let decided = decide(ticket, &at, &rule, now);
+                assert_eq!(reason_of(decided), expect, "{name}: {check}");
+                // what the modes make of it
+                let enforce = judge(
+                    &with_mode(vector_rule(&v), Mode::Enforce),
+                    Ok(ticket),
+                    &at,
+                    now,
+                );
+                assert_eq!(enforce.refused, expect != "ok", "{name}: {check}");
+                assert_eq!(enforce.reason.map(Reason::name), Some(expect));
+                let count = judge(
+                    &with_mode(vector_rule(&v), Mode::Count),
+                    Ok(ticket),
+                    &at,
+                    now,
+                );
+                assert!(!count.refused, "{name}: count refuses nothing");
+                assert_eq!(count.reason.map(Reason::name), Some(expect));
+                assert_eq!(count.admitted, decided.ok());
+                assert_eq!(judge(&Policy::Off, Ok(ticket), &at, now), Verdict::OPEN);
+                let closed = judge(&Policy::Closed, Ok(ticket), &at, now);
+                assert!(closed.refused && closed.reason == Some(Reason::Closed));
+                seen.push(expect.to_owned());
+            }
+            if let Some(fields) = case.get("fields") {
+                // a good ticket: what a registration keeps of it
+                let rule_key = rule.key(case["kid"].as_u64().unwrap() as u16);
+                assert!(rule_key.is_some(), "{name}");
+                let (kid, payload, _) = parse_wire(ticket).unwrap();
+                assert_eq!(payload, str_of(case, "payload").as_bytes(), "{name}");
+                assert_eq!(json!(kid), case["kid"], "{name}");
+                let p = parse_payload(&payload).unwrap();
+                assert_eq!(
+                    (json!(p.iat), json!(p.exp)),
+                    (fields["iat"].clone(), fields["exp"].clone())
+                );
+                assert_eq!(
+                    [DOMAIN, &payload].concat(),
+                    from_hex(str_of(case, "signed_hex")),
+                    "{name}"
+                );
+            }
+        }
+        // every reason of 4-1 comes up
+        for reason in &REASONS[..12] {
+            assert!(seen.iter().any(|s| s == reason.name()), "{}", reason.name());
+        }
+    }
