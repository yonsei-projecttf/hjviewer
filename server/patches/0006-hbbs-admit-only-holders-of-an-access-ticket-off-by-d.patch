+#[test]
+fn a_registration_without_a_good_ticket_stays_offline_with_its_key_stored() {
+    let server = Hbbs::start("register", Told::Env, Some(&enforce()));
+    runtime().block_on(async {
+        let mut pc = Client::at(&server, "203.0.113.10").await;
+        assert_eq!(
+            pc.register(PEER_ID, None).await,
+            register_pk_response::Result::NOT_DEPLOYED
+        );
+        // hjv-api can bind it: hbbs knows its key, and that it is not on
+        let line = server.console(&format!("hjv-pk {PEER_ID}")).await;
+        let fields: Vec<&str> = line.trim_end().split(' ').collect();
+        assert_eq!(fields.len(), 4, "{line:?}");
+        assert_eq!(
+            (fields[0], fields[1], fields[3]),
+            ("HJVPK1", PEER_ID, "-"),
+            "{line:?}"
+        );
+        assert_ne!(fields[2], "-", "{line:?}");
+        // and a controller that may connect finds it offline
+        let mut controller = Client::controller(&server).await;
+        controller
+            .send(punch_hole_request(
+                &server,
+                PEER_ID,
+                "1.8.0",
+                &Ticket::staff_ctl().sign(),
+            ))
+            .await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::OFFLINE)
+        );
+        // the ticket of another PC, then its own on the same connection
+        assert_eq!(
+            pc.register(PEER_ID, Some(&Ticket::pc(OTHER_ID).sign()))
+                .await,
+            register_pk_response::Result::NOT_DEPLOYED
+        );
+        assert_eq!(
+            pc.register(PEER_ID, Some(&Ticket::pc(PEER_ID).sign()))
+                .await,
+            register_pk_response::Result::OK
+        );
+        assert_eq!(
+            punch_hole(&server, &mut pc, PEER_ID, &Ticket::staff_ctl().sign()).await,
+            None
+        );
+        // a ticket of its ID for another key
+        let mut other_key = Client::at(&server, "203.0.113.11").await;
+        let mut ticket = Ticket::pc("333444555");
+        ticket.pk = OTHER_PK.to_owned();
+        assert_eq!(
+            other_key.register("333444555", Some(&ticket.sign())).await,
+            register_pk_response::Result::NOT_DEPLOYED
+        );
+        // a registration without a ticket does not push an admitted PC out (an ID of its own:
+        // hbbs answers a fourth registration of one ID within 6 seconds with TOO_FREQUENT)
+        let mut admitted = admitted_pc(&server, "444555666", &Ticket::pc("444555666")).await;
+        let mut intruder = Client::at(&server, "203.0.113.10").await;
+        assert_eq!(
+            intruder.register("444555666", None).await,
+            register_pk_response::Result::NOT_DEPLOYED
+        );
+        assert_eq!(
+            punch_hole(
+                &server,
+                &mut admitted,
+                "444555666",
+                &Ticket::staff_ctl().sign()
+            )
+            .await,
+            None
+        );
+        intruder.expect_silence().await;
+        assert_eq!(
+            server.console("hjv-access").await,
+            "HJVACCESS1 mode=enforce ph.ok=3 reg.ok=2 reg.missing=2 reg.wrong_pc=2\n"
+        );
+        let line = server
+            .wait_for_line("access refused reg 203.0.113.11:", Duration::from_secs(5))
+            .await;
+        assert!(line.ends_with("for \"333444555\": wrong_pc"), "{line}");
+    });
+}
