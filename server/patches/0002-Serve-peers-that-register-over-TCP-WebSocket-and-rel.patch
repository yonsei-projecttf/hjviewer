@@ -0,0 +1,440 @@
+//! The rendezvous protocol over WebSocket, as RustDesk clients speak it with `allow-websocket`
+//! behind firewalls that only let HTTPS out: a peer registers on a kept connection and stays
+//! online through heartbeats, punch hole requests are pushed to it over that connection, and
+//! WebRTC offers, answers and ICE candidates pass between the two sides.
+
+use hbb_common::{
+    futures_util::{SinkExt, StreamExt},
+    protobuf::Message as _,
+    rendezvous_proto::*,
+    tokio::{
+        self,
+        net::{TcpStream, UdpSocket},
+        time::{sleep, timeout, Duration},
+    },
+    AddrMangle,
+};
+use sodiumoxide::crypto::sign;
+use std::{
+    net::SocketAddr,
+    path::PathBuf,
+    process::{Child, Command},
+};
+use tokio_tungstenite::{
+    tungstenite::{client::IntoClientRequest, http::HeaderValue, Message as WsMessage},
+    MaybeTlsStream, WebSocketStream,
+};
+
+const PEER_ID: &str = "123456789";
+const PEER_PK: [u8; 32] = [7; 32];
+const HEARTBEAT_WAIT: Duration = Duration::from_secs(12);
+
+struct Hbbs {
+    child: Child,
+    dir: PathBuf,
+    port: u16,
+    key: String,
+}
+
+impl Hbbs {
+    fn start(name: &str) -> Self {
+        let dir = std::env::temp_dir().join(format!("hbbs-{name}-{}", std::process::id()));
+        std::fs::remove_dir_all(&dir).ok();
+        std::fs::create_dir_all(&dir).expect("create the server's working directory");
+        let port = free_base_port();
+        let log = std::fs::File::create(dir.join("hbbs.log")).expect("create the server log");
+        let child = Command::new(env!("CARGO_BIN_EXE_hbbs"))
+            .args(["-p", &port.to_string()])
+            .current_dir(&dir)
+            // hbbs reads its options from the environment first
+            .env_clear()
+            .env("TEST_HBBS", "no")
+            .env("RUST_LOG", "debug")
+            .stdout(log.try_clone().expect("share the server log"))
+            .stderr(log)
+            .spawn()
+            .expect("start hbbs");
+        let mut server = Self {
+            child,
+            dir,
+            port,
+            key: String::new(),
+        };
+        for _ in 0..100 {
+            if std::net::TcpStream::connect(("127.0.0.1", server.ws_port())).is_ok() {
+                server.key = std::fs::read_to_string(server.dir.join("id_ed25519.pub"))
+                    .expect("hbbs writes its public key before it listens");
+                return server;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(100));
+        }
+        panic!("hbbs did not start listening");
+    }
+
+    fn ws_port(&self) -> u16 {
+        self.port + 2
+    }
+
+    fn public_key(&self) -> sign::PublicKey {
+        let bytes = base64::decode(&self.key).expect("base64 public key");
+        sign::PublicKey::from_slice(&bytes).expect("ed25519 public key")
+    }
+}
+
+impl Drop for Hbbs {
+    fn drop(&mut self) {
+        self.child.kill().ok();
+        self.child.wait().ok();
+        if std::thread::panicking() {
+            let log = std::fs::read_to_string(self.dir.join("hbbs.log")).unwrap_or_default();
+            eprintln!("---- hbbs log ----\n{log}");
+        }
+        std::fs::remove_dir_all(&self.dir).ok();
+    }
+}
+
+/// A port p with p-1, p and p+2 free for TCP and p for UDP: hbbs listens on all of them.
+fn free_base_port() -> u16 {
+    for _ in 0..100 {
+        let port = std::net::TcpListener::bind("127.0.0.1:0")
+            .and_then(|l| l.local_addr())
+            .expect("pick a free port")
+            .port();
+        if !(1025..=65000).contains(&port) {
+            continue;
+        }
+        let tcp_free = [port - 1, port, port + 2]
+            .iter()
+            .all(|p| std::net::TcpListener::bind(("0.0.0.0", *p)).is_ok());
+        if tcp_free && std::net::UdpSocket::bind(("0.0.0.0", port)).is_ok() {
+            return port;
+        }
+    }
+    panic!("no free port range for hbbs");
+}
+
+/// A client connection to hbbs's WebSocket port, made the way a TLS-terminating reverse proxy
+/// in front of it does, with the client's real address in X-Real-IP / X-Real-Port.
+struct Client {
+    ws: WebSocketStream<MaybeTlsStream<TcpStream>>,
+}
+
+impl Client {
+    async fn connect(server: &Hbbs, real_addr: &str) -> Self {
+        let real_addr: SocketAddr = real_addr.parse().expect("client address");
+        let mut request = format!("ws://127.0.0.1:{}/", server.ws_port())
+            .into_client_request()
+            .expect("websocket request");
+        let headers = request.headers_mut();
+        headers.insert(
+            "X-Real-IP",
+            HeaderValue::from_str(&real_addr.ip().to_string()).expect("ip header"),
+        );
+        headers.insert(
+            "X-Real-Port",
+            HeaderValue::from_str(&real_addr.port().to_string()).expect("port header"),
+        );
+        let (ws, _) = tokio_tungstenite::connect_async(request)
+            .await
+            .expect("connect to hbbs");
+        Self { ws }
+    }
+
+    async fn send(&mut self, msg: RendezvousMessage) {
+        let bytes = msg.write_to_bytes().expect("encode");
+        self.ws
+            .send(WsMessage::Binary(bytes))
+            .await
+            .expect("send to hbbs");
+    }
+
+    /// The next frame within `within`, `None` if there is none. Empty frames are heartbeats.
+    async fn frame(&mut self, within: Duration) -> Option<Vec<u8>> {
+        loop {
+            match timeout(within, self.ws.next()).await {
+                Err(_) => return None,
+                Ok(Some(Ok(WsMessage::Binary(bytes)))) => return Some(bytes),
+                Ok(Some(Ok(WsMessage::Close(_)))) | Ok(None) => {
+                    panic!("hbbs closed the connection")
+                }
+                Ok(Some(Ok(_))) => continue,
+                Ok(Some(Err(err))) => panic!("websocket error: {err}"),
+            }
+        }
+    }
+
+    /// The next message, echoing heartbeats on the way like the client does.
+    async fn recv(&mut self) -> rendezvous_message::Union {
+        loop {
+            let bytes = self
+                .frame(Duration::from_secs(5))
+                .await
+                .expect("a message from hbbs within 5s");
+            if bytes.is_empty() {
+                self.ws
+                    .send(WsMessage::Binary(Vec::new()))
+                    .await
+                    .expect("echo the heartbeat");
+                continue;
+            }
+            return RendezvousMessage::parse_from_bytes(&bytes)
+                .expect("decode")
+                .union
+                .expect("a message with a body");
+        }
+    }
+
+    async fn expect_silence(&mut self) {
+        if let Some(bytes) = self.frame(Duration::from_millis(500)).await {
+            panic!(
+                "unexpected message: {:?}",
+                RendezvousMessage::parse_from_bytes(&bytes)
+            );
+        }
+    }
+}
+
+fn register_pk() -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_register_pk(RegisterPk {
+        id: PEER_ID.to_owned(),
+        uuid: b"peer-uuid".to_vec().into(),
+        pk: PEER_PK.to_vec().into(),
+        ..Default::default()
+    });
+    msg
+}
+
+fn punch_hole_request(server: &Hbbs, offer: &str) -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_punch_hole_request(PunchHoleRequest {
+        id: PEER_ID.to_owned(),
+        licence_key: server.key.clone(),
+        version: "1.5.0".to_owned(),
+        force_relay: true,
+        webrtc_sdp_offer: offer.to_owned(),
+        ..Default::default()
+    });
+    msg
+}
+
+fn ice_candidate(ice: IceCandidate) -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_ice_candidate(ice);
+    msg
+}
+
+async fn online_states(server: &Hbbs, peers: &[&str]) -> Vec<u8> {
+    let mut query = Client::connect(server, "198.51.100.7:40100").await;
+    let mut msg = RendezvousMessage::new();
+    msg.set_online_request(OnlineRequest {
+        id: "query".to_owned(),
+        peers: peers.iter().map(|p| p.to_string()).collect(),
+        ..Default::default()
+    });
+    query.send(msg).await;
+    let rendezvous_message::Union::OnlineResponse(res) = query.recv().await else {
+        panic!("expected an online response");
+    };
+    res.states.to_vec()
+}
+
+async fn udp_recv(udp: &UdpSocket) -> rendezvous_message::Union {
+    let mut buf = vec![0u8; 4096];
+    let (n, _) = timeout(Duration::from_secs(5), udp.recv_from(&mut buf))
+        .await
+        .expect("a datagram from hbbs within 5s")
+        .expect("udp receive");
+    RendezvousMessage::parse_from_bytes(&buf[..n])
+        .expect("decode")
+        .union
+        .expect("a message with a body")
+}
+
+fn runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime")
+}
+
+#[test]
+fn peer_registered_over_websocket_receives_signaling() {
+    let server = Hbbs::start("ws-signaling");
+    runtime().block_on(async {
+        // The controlled peer registers on a connection it keeps.
+        let mut peer = Client::connect(&server, "203.0.113.10:40001").await;
+        peer.send(register_pk()).await;
+        let rendezvous_message::Union::RegisterPkResponse(res) = peer.recv().await else {
+            panic!("expected a register pk response");
+        };
+        assert_eq!(res.result.enum_value(), Ok(register_pk_response::Result::OK));
+        assert!(res.keep_alive > 0, "the client needs keep_alive to time out");
+
+        // Online queries arrive on the same WebSocket endpoint.
+        assert_eq!(online_states(&server, &[PEER_ID, "987654321"]).await, vec![0x80]);
+
+        // Two controllers behind one NAT are told apart by their source port.
+        let mut a1 = Client::connect(&server, "198.51.100.20:50001").await;
+        let mut a2 = Client::connect(&server, "198.51.100.20:50002").await;
+        a1.send(punch_hole_request(&server, "offer-1")).await;
+        let rendezvous_message::Union::PunchHole(ph1) = peer.recv().await else {
+            panic!("expected the first punch hole");
+        };
+        assert_eq!(ph1.webrtc_sdp_offer, "offer-1");
+        assert!(ph1.force_relay);
+        assert_eq!(
+            AddrMangle::decode(&ph1.socket_addr),
+            "198.51.100.20:50001".parse::<SocketAddr>().expect("address")
+        );
+        a2.send(punch_hole_request(&server, "offer-2")).await;
+        let rendezvous_message::Union::PunchHole(ph2) = peer.recv().await else {
+            panic!("expected the second punch hole");
+        };
+        assert_eq!(ph2.webrtc_sdp_offer, "offer-2");
+
+        // The controller trickles ICE on its request's connection, addressed by peer id.
+        a1.send(ice_candidate(IceCandidate {
+            id: PEER_ID.to_owned(),
+            session_key: "s1".to_owned(),
+            candidate: "a1-candidate".to_owned(),
+            ..Default::default()
+        }))
+        .await;
+        let rendezvous_message::Union::IceCandidate(ice) = peer.recv().await else {
+            panic!("expected the controller's ICE candidate");
+        };
+        assert_eq!((ice.session_key.as_str(), ice.candidate.as_str()), ("s1", "a1-candidate"));
+
+        // The peer answers each controller on a connection of its own.
+        let mut answer = Client::connect(&server, "203.0.113.10:40002").await;
+        let mut msg = RendezvousMessage::new();
+        msg.set_punch_hole_sent(PunchHoleSent {
+            socket_addr: ph2.socket_addr.clone(),
+            id: PEER_ID.to_owned(),
+            version: "1.5.0".to_owned(),
+            webrtc_sdp_answer: "answer-2".to_owned(),
+            ..Default::default()
+        });
+        answer.send(msg).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = a2.recv().await else {
+            panic!("expected the punch hole response");
+        };
+        assert_eq!(res.webrtc_sdp_answer, "answer-2");
+        let signed = sign::verify(&res.pk, &server.public_key()).expect("signed by the server");
+        let id_pk = IdPk::parse_from_bytes(&signed).expect("IdPk");
+        assert_eq!((id_pk.id.as_str(), &id_pk.pk[..]), (PEER_ID, &PEER_PK[..]));
+
+        let mut relay = Client::connect(&server, "203.0.113.10:40003").await;
+        let mut rr = RelayResponse {
+            socket_addr: ph1.socket_addr.clone(),
+            uuid: "relay-uuid".to_owned(),
+            relay_server: "relay.example.com".to_owned(),
+            version: "1.5.0".to_owned(),
+            webrtc_sdp_answer: "answer-1".to_owned(),
+            ..Default::default()
+        };
+        rr.set_id(PEER_ID.to_owned());
+        let mut msg = RendezvousMessage::new();
+        msg.set_relay_response(rr);
+        relay.send(msg).await;
+        let rendezvous_message::Union::RelayResponse(res) = a1.recv().await else {
+            panic!("expected the relay response");
+        };
+        assert_eq!(res.webrtc_sdp_answer, "answer-1");
+
+        // The peer's trickle reaches its controller after the answer, several candidates on
+        // one connection, and nobody else.
+        let mut trickle = Client::connect(&server, "203.0.113.10:40004").await;
+        for candidate in ["b-candidate-1", "b-candidate-2"] {
+            trickle
+                .send(ice_candidate(IceCandidate {
+                    socket_addr: ph1.socket_addr.clone(),
+                    session_key: "s1".to_owned(),
+                    candidate: candidate.to_owned(),
+                    ..Default::default()
+                }))
+                .await;
+        }
+        for candidate in ["b-candidate-1", "b-candidate-2"] {
+            let rendezvous_message::Union::IceCandidate(ice) = a1.recv().await else {
+                panic!("expected the peer's ICE candidate");
+            };
+            assert_eq!((ice.session_key.as_str(), ice.candidate.as_str()), ("s1", candidate));
+        }
+        a2.expect_silence().await;
+
+        // Heartbeats keep the registration connection alive.
+        let heartbeat = peer
+            .frame(HEARTBEAT_WAIT)
+            .await
+            .expect("a heartbeat within the heartbeat interval");
+        assert!(heartbeat.is_empty());
+        peer.ws
+            .send(WsMessage::Binary(Vec::new()))
+            .await
+            .expect("echo the heartbeat");
+        assert_eq!(online_states(&server, &[PEER_ID]).await, vec![0x80]);
+
+        // Closing it takes the peer offline at once.
+        peer.ws.close(None).await.expect("close");
+        sleep(Duration::from_millis(300)).await;
+        assert_eq!(online_states(&server, &[PEER_ID]).await, vec![0x00]);
+        let mut a3 = Client::connect(&server, "198.51.100.30:50003").await;
+        a3.send(punch_hole_request(&server, "offer-3")).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = a3.recv().await else {
+            panic!("expected a punch hole failure");
+        };
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::OFFLINE)
+        );
+    });
+}
+
+#[test]
+fn peer_registered_over_udp_still_receives_punch_holes_over_udp() {
+    let server = Hbbs::start("udp-signaling");
+    runtime().block_on(async {
+        let udp = UdpSocket::bind("127.0.0.1:0").await.expect("udp socket");
+        let hbbs: SocketAddr = format!("127.0.0.1:{}", server.port)
+            .parse()
+            .expect("address");
+        let mut msg = RendezvousMessage::new();
+        msg.set_register_peer(RegisterPeer {
+            id: PEER_ID.to_owned(),
+            ..Default::default()
+        });
+        let bytes = msg.write_to_bytes().expect("encode");
+        udp.send_to(&bytes, hbbs).await.expect("register peer");
+        let rendezvous_message::Union::RegisterPeerResponse(res) = udp_recv(&udp).await else {
+            panic!("expected a register peer response");
+        };
+        assert!(res.request_pk);
+        let bytes = register_pk().write_to_bytes().expect("encode");
+        udp.send_to(&bytes, hbbs).await.expect("register pk");
+        let rendezvous_message::Union::RegisterPkResponse(res) = udp_recv(&udp).await else {
+            panic!("expected a register pk response");
+        };
+        assert_eq!(res.result.enum_value(), Ok(register_pk_response::Result::OK));
+        // the UDP registration completes with the next register peer, as the client sends them
+        let mut msg = RendezvousMessage::new();
+        msg.set_register_peer(RegisterPeer {
+            id: PEER_ID.to_owned(),
+            ..Default::default()
+        });
+        let bytes = msg.write_to_bytes().expect("encode");
+        udp.send_to(&bytes, hbbs).await.expect("register peer");
+        let rendezvous_message::Union::RegisterPeerResponse(res) = udp_recv(&udp).await else {
+            panic!("expected a register peer response");
+        };
+        assert!(!res.request_pk);
+
+        let mut a = Client::connect(&server, "198.51.100.20:50001").await;
+        a.send(punch_hole_request(&server, "offer-udp")).await;
+        let rendezvous_message::Union::PunchHole(ph) = udp_recv(&udp).await else {
+            panic!("expected the punch hole over udp");
+        };
+        assert_eq!(ph.webrtc_sdp_offer, "offer-udp");
+    });
+}
