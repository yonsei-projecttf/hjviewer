+impl Incoming {
+    /// The next frame, `None` once the connection is closed or broken. Cancel safe.
+    async fn next_frame(&mut self) -> Option<Bytes> {
+        loop {
+            match self {
+                Incoming::TcpStream(s) => return s.next().await?.ok().map(|b| b.freeze()),
+                Incoming::Ws(s) => match s.next().await?.ok()? {
+                    tungstenite::Message::Binary(bytes) => return Some(Bytes::from(bytes)),
+                    tungstenite::Message::Close(_) => return None,
+                    _ => {}
+                },
+            }
+        }
+    }
+}
