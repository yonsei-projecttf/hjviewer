+#[test]
+fn a_blank_option_refuses_everything_too() {
+    // HJV_ACCESS_FILE= in hjviewer.env, as a template line left unfilled: closed, never off
+    let server = Hbbs::start_with(
+        "blank",
+        Told::No,
+        None,
+        &[("TEST_HBBS", "no"), ("HJV_ACCESS_FILE", "")],
+    );
+    runtime().block_on(async {
+        let line = server
+            .wait_for_line("is set but empty", Duration::from_secs(5))
+            .await;
+        assert!(line.contains("] ERROR ["), "{line}");
+        assert!(
+            line.ends_with("; access closed: every request is refused"),
+            "{line}"
+        );
+        assert_eq!(
+            punch_hole_nobody(&server, &Ticket::staff_ctl().sign())
+                .await
+                .as_deref(),
+            Some(BUILTIN_TEXT)
+        );
+        assert_eq!(
+            server.console("hjv-access").await,
+            "HJVACCESS1 mode=closed ph.closed=1\n"
+        );
+    });
+}
