+#[test]
+fn refused_registrations_leave_the_address_budget_of_ticket_holders_alone() {
+    let server = Hbbs::start("budget", Told::Env, Some(&enforce()));
+    runtime().block_on(async {
+        // refused PCs behind one address (old apps retry every 30 seconds), until hbbs answers
+        // TOO_FREQUENT as it did before access tickets
+        let mut refused = Client::at(&server, "203.0.113.40").await;
+        let mut n = 0;
+        loop {
+            n += 1;
+            assert!(n <= 40, "no TOO_FREQUENT in {n} registrations");
+            match refused.register(&(100_000_000 + n).to_string(), None).await {
+                register_pk_response::Result::NOT_DEPLOYED => {}
+                register_pk_response::Result::TOO_FREQUENT => break,
+                other => panic!("registration {n}: {other:?}"),
+            }
+        }
+        assert!(n > 30, "TOO_FREQUENT after {n} registrations");
+        // a PC with a ticket at that address still comes online, while they stay held back
+        let mut pc = Client::at(&server, "203.0.113.40").await;
+        assert_eq!(
+            pc.register(PEER_ID, Some(&Ticket::pc(PEER_ID).sign()))
+                .await,
+            register_pk_response::Result::OK
+        );
+        assert_eq!(
+            refused.register("100000099", None).await,
+            register_pk_response::Result::TOO_FREQUENT
+        );
+        assert_eq!(
+            server.console("hjv-access").await,
+            format!("HJVACCESS1 mode=enforce reg.ok=1 reg.missing={}\n", n - 1)
+        );
+    });
+}
