+#[test]
+fn a_refused_registration_leaves_its_connection_as_it_was_admitted() {
+    let server = Hbbs::start("renewal", Told::Env, Some(&enforce()));
+    runtime().block_on(async {
+        let mut pc = admitted_pc(&server, PEER_ID, &Ticket::pc(PEER_ID)).await;
+        // renewals that fail: no ticket, another PC's
+        assert_eq!(
+            pc.register(PEER_ID, None).await,
+            register_pk_response::Result::NOT_DEPLOYED
+        );
+        assert_eq!(
+            pc.register(PEER_ID, Some(&Ticket::pc(OTHER_ID).sign()))
+                .await,
+            register_pk_response::Result::NOT_DEPLOYED
+        );
+        // the ticket it came in with still holds at the heartbeat
+        pc.expect_silence_for(PERIOD + Duration::from_secs(1)).await;
+        assert_eq!(
+            punch_hole(&server, &mut pc, PEER_ID, &Ticket::staff_ctl().sign()).await,
+            None
+        );
+        assert_eq!(
+            server.console("hjv-access").await,
+            "HJVACCESS1 mode=enforce ph.ok=1 reg.ok=1 reg.missing=1 reg.wrong_pc=1\n"
+        );
+    });
+}
