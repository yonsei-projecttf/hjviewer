+#[test]
+fn ice_candidates_go_only_after_a_punch_hole_with_a_good_ticket() {
+    let server = Hbbs::start("ice", Told::Env, Some(&enforce()));
+    runtime().block_on(async {
+        let mut pc = admitted_pc(&server, PEER_ID, &Ticket::pc(PEER_ID)).await;
+        let ice = |candidate: &str| {
+            let mut msg = RendezvousMessage::new();
+            msg.set_ice_candidate(IceCandidate {
+                id: PEER_ID.to_owned(),
+                session_key: "session".to_owned(),
+                candidate: candidate.to_owned(),
+                ..Default::default()
+            });
+            msg
+        };
+        // one that sent no punch hole request, and one whose request had no good ticket
+        let mut stranger = Client::controller(&server).await;
+        stranger.send(ice("stranger")).await;
+        pc.expect_silence().await;
+        let mut refused = Client::controller(&server).await;
+        refused
+            .send(punch_hole_request(&server, PEER_ID, "1.8.0", ""))
+            .await;
+        assert_eq!(refused.expect_punch_hole_refused().await, TEXT);
+        refused.send(ice("refused")).await;
+        pc.expect_silence().await;
+        // a controller with a good ticket trickles on its punch hole's connection
+        let mut admitted = Client::controller(&server).await;
+        admitted
+            .send(punch_hole_request(
+                &server,
+                PEER_ID,
+                "1.8.0",
+                &Ticket::staff_ctl().sign(),
+            ))
+            .await;
+        let rendezvous_message::Union::PunchHole(_) = pc.recv().await else {
+            panic!("expected the punch hole");
+        };
+        admitted.send(ice("admitted")).await;
+        let rendezvous_message::Union::IceCandidate(got) = pc.recv().await else {
+            panic!("expected the admitted controller's candidate");
+        };
+        assert_eq!(got.candidate, "admitted");
+        pc.expect_silence().await;
+    });
+}
