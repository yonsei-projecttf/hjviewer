     hjv_ticket: Option<crate::hjv_access::Admitted>,
+    /// HJViewer: the peer that the last punch hole request on this connection reached, after
+    /// the key, version and access ticket checks; the one peer its ICE candidates may go to
+    punched: Option<String>,
 }
 // A peer registered over TCP/WebSocket gets an empty frame this often and echoes it, which
 // refreshes its online state and keeps NATs and proxies from idling the connection out.
@@ -567,7 +570,10 @@ impl RendezvousServer {
                         .lock()
                         .await
                         .insert(try_into_v4(addr), conn.tx.clone());
-                    allow_err!(self.handle_tcp_punch_hole_request(addr, ph, key, ws).await);
+                    let id = ph.id.clone();
+                    let reached = self.handle_tcp_punch_hole_request(addr, ph, key, ws).await;
+                    conn.punched = matches!(reached, Ok(true)).then_some(id);
+                    allow_err!(reached);
                     return true;
                 }
                 Some(rendezvous_message::Union::RequestRelay(mut rf)) => {
@@ -615,6 +621,12 @@ impl RendezvousServer {
                     // the connection of its punch hole request; the controlled peer answers on a
                     // connection of its own, addressed by that request's socket_addr.
                     if !ice.id.is_empty() {
+                        // HJViewer: only on the connection whose punch hole request reached
+                        // that peer, as the controller's are; anyone else's are dropped
+                        if conn.punched.as_deref() != Some(ice.id.as_str()) {
+                            log::debug!("Drop IceCandidate from {addr}: no punch hole to it");
+                            return true;
+                        }
                         if let Some(peer) = self.pm.get_in_memory(&ice.id).await {
                             let id = ice.id.clone();
                             let peer_addr = peer.read().await.socket_addr;
@@ -1062,21 +1074,22 @@ impl RendezvousServer {
     }
 
     #[inline]
+    /// Whether the request went on to the peer (HJViewer).
     async fn handle_tcp_punch_hole_request(
         &mut self,
         addr: SocketAddr,
         ph: PunchHoleRequest,
         key: &str,
         ws: bool,
-    ) -> ResultType<()> {
+    ) -> ResultType<bool> {
         let id = ph.id.clone();
         let (msg, to_addr) = self.handle_punch_hole_request(addr, ph, key, ws).await?;
         if let Some(addr) = to_addr {
             self.send_to_peer(&id, addr, msg).await;
-        } else {
-            self.send_to_tcp_sync(msg, addr).await?;
+            return Ok(true);
         }
-        Ok(())
+        self.send_to_tcp_sync(msg, addr).await?;
+        Ok(false)
     }
 
