+
+fn ice_candidate(id: &str, candidate: &str) -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_ice_candidate(IceCandidate {
+        id: id.to_owned(),
+        session_key: "session".to_owned(),
+        candidate: candidate.to_owned(),
+        ..Default::default()
+    });
+    msg
+}
+
+#[test]
+fn ice_candidates_for_a_peer_go_only_from_the_connection_whose_punch_hole_reached_it() {
+    let server = Hbbs::start("ice", &[]);
+    runtime().block_on(async {
+        let mut pc = registered_pc(&server).await;
+        let mut other = Client::connect(&server, "203.0.113.30", Some(40030)).await;
+        assert_eq!(
+            register(&mut other, "987654321", b"other-uuid", &[8u8; 32]).await,
+            register_pk_response::Result::OK
+        );
+
+        // a connection that sent no punch hole request
+        let mut stranger = Client::connect(&server, "198.51.100.30", Some(50030)).await;
+        stranger.send(ice_candidate(PEER_ID, "stranger")).await;
+        assert_eq!(pc.recv_soon().await, None);
+        // one whose punch hole request was refused
+        let mut refused = Client::connect(&server, "198.51.100.31", Some(50031)).await;
+        let mut msg = punch_hole_request(&server);
+        msg.mut_punch_hole_request().licence_key = "not-the-key".to_owned();
+        refused.send(msg).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = refused.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::LICENSE_MISMATCH)
+        );
+        refused.send(ice_candidate(PEER_ID, "refused")).await;
+        assert_eq!(pc.recv_soon().await, None);
+
+        // The controller trickles on the connection of its punch hole request, to that peer.
+        let mut controller = Client::connect(&server, "198.51.100.32", Some(50032)).await;
+        controller.send(punch_hole_request(&server)).await;
+        let rendezvous_message::Union::PunchHole(_) = pc.recv().await else {
+            panic!("expected a punch hole");
+        };
+        for candidate in ["controller-1", "controller-2"] {
+            controller.send(ice_candidate(PEER_ID, candidate)).await;
+            let rendezvous_message::Union::IceCandidate(ice) = pc.recv().await else {
+                panic!("expected the controller's candidate");
+            };
+            assert_eq!(ice.candidate, candidate);
+            // not to another peer
+            controller.send(ice_candidate("987654321", candidate)).await;
+            assert_eq!(other.recv_soon().await, None);
+        }
+    });
+}
