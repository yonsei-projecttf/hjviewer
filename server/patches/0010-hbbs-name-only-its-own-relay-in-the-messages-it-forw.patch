+    /// HJViewer: the relay a message forwarded from one client to another names, `None` if the
+    /// message is to be dropped. The controlled PC dials the relay a RequestRelay names, and the
+    /// controller the one a RelayResponse or PunchHoleResponse names, so the sender could point
+    /// the other side at any address. With one relay configured, that one whatever the sender
+    /// wrote; with several, the sender's if it is one of them; with none, the sender's, as
+    /// upstream. No name (a RelayResponse acknowledging a RequestRelay) stays none, and this
+    /// server's LAN address (--mask, upstream's issue 24) is its own. Configured means as
+    /// written, resolved or not.
+    fn own_relay(&self, what: &str, addr: SocketAddr, name: String) -> Option<String> {
+        let configured = &self.relay_names;
+        let local = !self.inner.local_ip.is_empty() && name == self.inner.local_ip;
+        if name.is_empty() || configured.is_empty() || local {
+            Some(name)
+        } else if configured.len() == 1 {
+            Some(configured[0].clone())
+        } else if configured.contains(&name) {
+            Some(name)
+        } else {
+            let shown: String = name.chars().take(64).collect();
+            log::warn!("Drop {what} from {addr}: relay server {shown:?} is not configured");
+            None
+        }
+    }
+
