+/// The relay server named on the other side of each message that carries one from a client to
+/// another, `name` in all of them; `None` where the message did not arrive. A controller's
+/// punch hole reaches `pc`, which answers with a relay response and a punch hole report naming
+/// `name`, and another controller's relay request names it, which `pc` acknowledges.
+struct Named {
+    relay_response: Option<String>,
+    punch_hole_response: Option<String>,
+    request_relay: Option<String>,
+    acknowledgement: Option<String>,
+}
+
+async fn forward_relay_names(server: &Hbbs, pc: &mut Client, name: &str) -> Named {
+    let mut a = Client::connect(server, "198.51.100.20", Some(50001)).await;
+    a.send(punch_hole_request(server)).await;
+    let rendezvous_message::Union::PunchHole(ph) = pc.recv().await else {
+        panic!("expected a punch hole");
+    };
+
+    let mut rr = RelayResponse {
+        socket_addr: ph.socket_addr.clone(),
+        uuid: "e4c181d0-41c7-4ae6-8ef0-36581b6b2b12".to_owned(),
+        relay_server: name.to_owned(),
+        version: "1.5.0".to_owned(),
+        ..Default::default()
+    };
+    rr.set_id(PEER_ID.to_owned());
+    let mut msg = RendezvousMessage::new();
+    msg.set_relay_response(rr);
+    let mut answer = Client::connect(server, "203.0.113.10", Some(40011)).await;
+    answer.send(msg).await;
+    let relay_response = match a.recv_soon().await {
+        Some(rendezvous_message::Union::RelayResponse(rr)) => Some(rr.relay_server),
+        None => None,
+        Some(other) => panic!("expected a relay response: {other:?}"),
+    };
+
+    let mut msg = RendezvousMessage::new();
+    msg.set_punch_hole_sent(PunchHoleSent {
+        socket_addr: ph.socket_addr.clone(),
+        id: PEER_ID.to_owned(),
+        relay_server: name.to_owned(),
+        version: "1.5.0".to_owned(),
+        ..Default::default()
+    });
+    let mut sent = Client::connect(server, "203.0.113.10", Some(40012)).await;
+    sent.send(msg).await;
+    let punch_hole_response = match a.recv_soon().await {
+        Some(rendezvous_message::Union::PunchHoleResponse(res)) => Some(res.relay_server),
+        None => None,
+        Some(other) => panic!("expected a punch hole response: {other:?}"),
+    };
+
+    let mut c = Client::connect(server, "198.51.100.21", Some(50002)).await;
+    let mut msg = RendezvousMessage::new();
+    msg.set_request_relay(RequestRelay {
+        id: PEER_ID.to_owned(),
+        uuid: "01890a5d-ac96-774b-bcce-b302099a8057".to_owned(),
+        relay_server: name.to_owned(),
+        licence_key: server.key.clone(),
+        ..Default::default()
+    });
+    c.send(msg).await;
+    let (request_relay, acknowledgement) = match pc.recv_soon().await {
+        Some(rendezvous_message::Union::RequestRelay(rf)) => {
+            // the controlled side acknowledges on a connection of its own, naming nothing
+            let mut msg = RendezvousMessage::new();
+            msg.set_relay_response(RelayResponse {
+                socket_addr: rf.socket_addr.clone(),
+                version: "1.5.0".to_owned(),
+                ..Default::default()
+            });
+            let mut ack = Client::connect(server, "203.0.113.10", Some(40013)).await;
+            ack.send(msg).await;
+            let acknowledgement = match c.recv_soon().await {
+                Some(rendezvous_message::Union::RelayResponse(rr)) => Some(rr.relay_server),
+                None => None,
+                Some(other) => panic!("expected the acknowledgement: {other:?}"),
+            };
+            (Some(rf.relay_server), acknowledgement)
+        }
+        None => (None, None),
+        Some(other) => panic!("expected a relay request: {other:?}"),
+    };
+    Named {
+        relay_response,
+        punch_hole_response,
+        request_relay,
+        acknowledgement,
+    }
+}
+
+async fn registered_pc(server: &Hbbs) -> Client {
+    let mut pc = Client::connect(server, "203.0.113.10", Some(40001)).await;
+    assert_eq!(
+        register(&mut pc, PEER_ID, b"peer-uuid", &[7u8; 32]).await,
+        register_pk_response::Result::OK
+    );
+    pc
+}
+
+const OTHER_RELAY: &str = "198.51.100.66:21117";
+
+#[test]
+fn one_relay_configured_is_the_one_every_forwarded_message_names() {
+    // what production runs: hbbs -r <domain>
+    let server = Hbbs::start("relay-one", &["-r", "192.0.2.10"]);
+    runtime().block_on(async {
+        let mut pc = registered_pc(&server).await;
+        for name in [OTHER_RELAY, "192.0.2.10"] {
+            let named = forward_relay_names(&server, &mut pc, name).await;
+            let ours = Some("192.0.2.10".to_owned());
+            assert_eq!(named.relay_response, ours, "relay response naming {name}");
+            assert_eq!(
+                named.punch_hole_response, ours,
+                "punch hole report naming {name}"
+            );
+            assert_eq!(named.request_relay, ours, "relay request naming {name}");
+            assert_eq!(named.acknowledgement, Some(String::new()));
+        }
+    });
+}
+
+#[test]
+fn several_relays_configured_pass_and_others_are_dropped() {
+    let server = Hbbs::start("relay-several", &["-r", "192.0.2.10,192.0.2.11"]);
+    runtime().block_on(async {
+        let mut pc = registered_pc(&server).await;
+        let named = forward_relay_names(&server, &mut pc, "192.0.2.11").await;
+        let listed = Some("192.0.2.11".to_owned());
+        assert_eq!(named.relay_response, listed);
+        assert_eq!(named.punch_hole_response, listed);
+        assert_eq!(named.request_relay, listed);
+        assert_eq!(named.acknowledgement, Some(String::new()));
+
+        let named = forward_relay_names(&server, &mut pc, OTHER_RELAY).await;
+        assert_eq!(named.relay_response, None);
+        assert_eq!(named.punch_hole_response, None);
+        assert_eq!(named.request_relay, None);
+        for line in [
+            "Drop RelayResponse from 203.0.113.10:40011: relay server \"198.51.100.66:21117\"",
+            "Drop PunchHoleSent from 203.0.113.10:40012: relay server \"198.51.100.66:21117\"",
+            "Drop RequestRelay from 198.51.100.21:50002: relay server \"198.51.100.66:21117\"",
+        ] {
+            server.wait_wrote(line.as_bytes()).await;
+        }
+    });
+}
+
+#[test]
+fn no_relay_configured_leaves_the_names_as_upstream() {
+    let server = Hbbs::start("relay-none", &[]);
+    runtime().block_on(async {
+        let mut pc = registered_pc(&server).await;
+        let named = forward_relay_names(&server, &mut pc, OTHER_RELAY).await;
+        let theirs = Some(OTHER_RELAY.to_owned());
+        assert_eq!(named.relay_response, theirs);
+        assert_eq!(named.punch_hole_response, theirs);
+        assert_eq!(named.request_relay, theirs);
+        assert_eq!(named.acknowledgement, Some(String::new()));
+    });
+}
