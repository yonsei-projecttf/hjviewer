+
+    /// The next message within half a second, `None` if there is none or hbbs closed the
+    /// connection. Heartbeats are echoed and do not count.
+    async fn recv_soon(&mut self) -> Option<rendezvous_message::Union> {
+        let until = Instant::now() + Duration::from_millis(500);
+        loop {
+            let left = until.saturating_duration_since(Instant::now());
+            let Ok(Some(Ok(WsMessage::Binary(bytes)))) = timeout(left, self.ws.next()).await else {
+                return None;
+            };
+            if bytes.is_empty() {
+                self.ws
+                    .send(WsMessage::Binary(Default::default()))
+                    .await
+                    .expect("echo the heartbeat");
+                continue;
+            }
+            return RendezvousMessage::parse_from_bytes(&bytes)
+                .expect("decode")
+                .union;
+        }
+    }
 }
 
 fn register_pk(id: &str, uuid: &[u8], pk: &[u8]) -> RendezvousMessage {
