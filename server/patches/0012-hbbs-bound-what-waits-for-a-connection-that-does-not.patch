+#[test]
+fn a_connection_that_does_not_read_holds_no_more_than_its_bound_and_is_closed() {
+    let server = Hbbs::start("unread", &[]);
+    runtime().block_on(async {
+        // A punch hole request, even for an ID nobody registered, puts a connection where
+        // messages addressed to it by its address find it. Then it stops reading.
+        let mut unread = Client::connect(&server, "198.51.100.40", Some(50040)).await;
+        let mut msg = punch_hole_request(&server);
+        msg.mut_punch_hole_request().id = "100000999".to_owned();
+        unread.send(msg).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = unread.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::ID_NOT_EXIST)
+        );
+
+        // From another connection, with no key or ticket: 2000 ICE candidates of 60 KiB
+        // addressed to it, 120 MiB in all, which hbbs used to queue for it whole.
+        let before = server.rss_kib();
+        let mut sender = Client::connect(&server, "198.51.100.41", Some(50041)).await;
+        let to: SocketAddr = "198.51.100.40:50040".parse().expect("address");
+        let candidate = "c".repeat(60 << 10);
+        for _ in 0..2000 {
+            let mut msg = RendezvousMessage::new();
+            msg.set_ice_candidate(IceCandidate {
+                socket_addr: AddrMangle::encode(to).into(),
+                session_key: "session".to_owned(),
+                candidate: candidate.clone(),
+                ..Default::default()
+            });
+            sender.send(msg).await;
+        }
+        // hbbs takes a connection's messages in order: once it answers this, it took them all
+        sender.send(online_request(vec![PEER_ID.to_owned()])).await;
+        let rendezvous_message::Union::OnlineResponse(_) = sender.recv().await else {
+            panic!("expected an online response");
+        };
+        let grown = server.rss_kib().saturating_sub(before);
+        assert!(grown < 32 << 10, "hbbs grew by {grown} KiB");
+
+        // The connection is closed: what reaches it is the bound and what the sockets buffer.
+        let mut got = 0usize;
+        let closed = timeout(Duration::from_secs(15), async {
+            while let Some(Ok(frame)) = unread.ws.next().await {
+                got += frame.len();
+            }
+        })
+        .await;
+        assert!(
+            closed.is_ok(),
+            "hbbs kept the connection that does not read"
+        );
+        assert!(got < 32 << 20, "{got} bytes reached the connection");
+        server
+            .wait_wrote(
+                b"Close the connection from 198.51.100.40:50040: over 256 KiB queued for it unread",
+            )
+            .await;
+    });
+}
