 /// Outbound queue of one TCP/WebSocket connection to hbbs. The connection's task owns the sink
 /// and drains this, so the connection can be addressed while it keeps reading.
-pub(crate) type ConnTx = mpsc::UnboundedSender<Bytes>;
+///
+/// HJViewer: bounded in bytes. Anyone can have messages forwarded to a connection that stopped
+/// reading (an ICE candidate, a punch hole report or a relay response names it by its address,
+/// with no key or ticket), and hbbs kept every one of them until it ran out of memory. Past the
+/// bound a message is dropped and the connection is told to close.
+#[derive(Clone)]
+pub(crate) struct ConnTx {
+    tx: mpsc::UnboundedSender<Bytes>,
+    queue: Arc<ConnQueue>,
+}
+
+struct ConnQueue {
+    bound: usize,
+    queued: AtomicUsize,
+    over: AtomicBool,
+    closing: Notify,
+}
+
+impl ConnTx {
+    /// A queue that holds up to `bound` bytes, and the receiver the connection's task drains.
+    pub(crate) fn new(bound: usize) -> (Self, mpsc::UnboundedReceiver<Bytes>) {
+        let (tx, rx) = mpsc::unbounded_channel();
+        let queue = Arc::new(ConnQueue {
+            bound,
+            queued: AtomicUsize::new(0),
+            over: AtomicBool::new(false),
+            closing: Notify::new(),
+        });
+        (Self { tx, queue }, rx)
+    }
+
+    /// Queues `bytes`; false if the connection is gone, or would be over its bound with them,
+    /// which closes it.
+    pub(crate) fn send(&self, bytes: Bytes) -> bool {
+        let q = &self.queue;
+        if q.over.load(Ordering::Relaxed) {
+            return false;
+        }
+        let len = bytes.len();
+        if q.queued.fetch_add(len, Ordering::Relaxed) + len > q.bound {
+            q.queued.fetch_sub(len, Ordering::Relaxed);
+            if !q.over.swap(true, Ordering::Relaxed) {
+                q.closing.notify_one();
+            }
+            return false;
+        }
+        if self.tx.send(bytes).is_err() {
+            q.queued.fetch_sub(len, Ordering::Relaxed);
+            return false;
+        }
+        true
+    }
+
+    /// What the connection's task calls for each message it takes off the queue.
+    pub(crate) fn taken(&self, len: usize) {
+        self.queue.queued.fetch_sub(len, Ordering::Relaxed);
+    }
+
+    /// Whether the queue went over its bound.
+    pub(crate) fn over(&self) -> bool {
+        self.queue.over.load(Ordering::Relaxed)
+    }
+
+    /// Returns once the queue went over its bound. For the connection's task only: the one
+    /// wakeup goes to one waiter.
+    pub(crate) async fn closing(&self) {
+        if !self.over() {
+            self.queue.closing.notified().await;
+        }
+    }
+
+    pub(crate) fn same_channel(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.queue, &other.queue)
+    }
+}
 
