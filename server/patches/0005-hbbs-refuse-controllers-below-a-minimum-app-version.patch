+#[test]
+fn refusals_start_at_the_time_without_a_restart_or_a_change() {
+    let mut from = Utc::now();
+    let file = || {
+        // six seconds from when it is this server's turn to start, as the file has it: to the
+        // second, as the release tool writes it
+        let written = (from + chrono::Duration::seconds(6))
+            .max(Utc::now() + chrono::Duration::seconds(6))
+            .to_rfc3339_opts(SecondsFormat::Secs, true);
+        from = chrono::DateTime::parse_from_rfc3339(&written)
+            .expect("the time just written")
+            .with_timezone(&Utc);
+        Some(conf("1.6.0", &written, S2).into_bytes())
+    };
+    let server = Hbbs::start_with("from", Told::Env, file, &[]);
+    runtime().block_on(async {
+        let mut passed = 0;
+        loop {
+            let asked = Utc::now();
+            if refusal(&server, "1.5.1").await.is_some() {
+                assert!(Utc::now() >= from, "refused before the time");
+                break;
+            }
+            assert!(asked < from, "went through after the time");
+            passed += 1;
+            sleep(Duration::from_millis(200)).await;
+        }
+        assert!(
+            passed > 0,
+            "hbbs took longer to start than the test allows for"
+        );
+        assert!(Utc::now() < from + chrono::Duration::seconds(3));
+        assert_eq!(refusal(&server, "1.6.0").await, None);
+    });
+}
