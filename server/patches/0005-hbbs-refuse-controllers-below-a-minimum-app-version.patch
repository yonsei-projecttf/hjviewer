+#[test]
+fn a_controller_without_the_server_key_never_sees_the_text() {
+    let server = Hbbs::start("key", Told::Env, Some(conf("1.6.0", "", S1).as_bytes()));
+    runtime().block_on(async {
+        for key in ["", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="] {
+            let mut controller = Client::controller(&server).await;
+            controller
+                .send(punch_hole_request(PEER_ID, key, "1.5.1"))
+                .await;
+            let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+                panic!("expected a punch hole response");
+            };
+            assert_eq!(
+                res.failure.enum_value(),
+                Ok(punch_hole_response::Failure::LICENSE_MISMATCH)
+            );
+            assert!(res.other_failure.is_empty(), "{}", res.other_failure);
+        }
+        assert!(refusal(&server, "1.5.1").await.is_some());
+    });
+}
