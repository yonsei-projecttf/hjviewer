+#[test]
+fn an_edited_file_takes_effect_within_10_seconds() {
+    let text = "Update to %MIN%. (version not allowed)";
+    let server = Hbbs::start("edit", Told::Env, Some(conf("1.6.0", "", text).as_bytes()));
+    runtime().block_on(async {
+        assert_eq!(
+            refusal(&server, "1.5.1").await.as_deref(),
+            Some("Update to 1.6.0. (version not allowed)")
+        );
+        assert_eq!(refusal(&server, "1.6.0").await, None);
+
+        // a higher minimum
+        server.write_conf(&conf("1.7.0", "", text));
+        let (answer, took) = until_refused(&server, "1.6.0", true).await;
+        eprintln!("a higher minimum took effect after {took:?}");
+        assert!(took < RELOAD + SLACK, "{took:?}");
+        assert_eq!(
+            answer.as_deref(),
+            Some("Update to 1.7.0. (version not allowed)")
+        );
+        let line = server
+            .wait_for_line("min-controller 1.7.0 from now", Duration::from_secs(5))
+            .await;
+        assert!(line.contains("] INFO ["), "{line}");
+
+        // another text only
+        server.write_conf(&conf("1.7.0", "", "Now %MIN%. (version not allowed)"));
+        let start = Instant::now();
+        while refusal(&server, "1.6.0").await.as_deref() != Some("Now 1.7.0. (version not allowed)")
+        {
+            assert!(start.elapsed() < RELOAD + SLACK, "{:?}", start.elapsed());
+            sleep(Duration::from_millis(200)).await;
+        }
+
+        // MIN emptied: off, without a restart
+        server.write_conf(&conf("", "", text));
+        let (_, took) = until_refused(&server, "1.5.1", false).await;
+        eprintln!("the emptied minimum took effect after {took:?}");
+        assert!(took < RELOAD + SLACK, "{took:?}");
+        let line = server
+            .wait_for_line(
+                "min-controller off: MIN is empty in ",
+                Duration::from_secs(5),
+            )
+            .await;
+        assert!(line.contains("] INFO ["), "{line}");
+        let lines = server.min_controller_lines();
+        let said = lines
+            .iter()
+            .filter(|l| !l.contains("min-controller refused"))
+            .count();
+        assert_eq!(said, 4, "the start and three changes: {lines:?}");
+    });
+}
