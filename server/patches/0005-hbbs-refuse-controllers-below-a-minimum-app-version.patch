+        assert_eq!(text_problem(&longest), None);
+        assert!(problem(&format!("가{longest}")).starts_with("is longer"));
+        // of the text the apps get: with the minimum in place of %MIN%
+        let filled = format!(
+            "{}%MIN%{mark}",
+            "가".repeat(MAX_TEXT_CHARS - mark.len() - "1.10.0".len())
+        );
+        let text = on(&format!("MIN=1.10.0\nFROM=\nTEXT={filled}\n")).text;
+        assert_eq!(text.chars().count(), MAX_TEXT_CHARS);
+        assert!(error(&format!("MIN=1.10.0\nFROM=\nTEXT=가{filled}\n"))
+            .starts_with("line 3: TEXT is longer than 2000 characters"));
+        assert!(problem("update\u{1b}[2J (version not allowed)").starts_with("has a control"));
+        assert!(problem("update\tnow (version not allowed)").starts_with("has a control"));
+        for no_mark in [
+            "HJViewer를 1.6.0 이상으로 업데이트해야 연결할 수 있습니다.",
+            "Update HJViewer to 1.6.0 or later",
+            "This version is no longer allowed",
+            "This version is not allowed",
+            "(Version Not Allowed)",
+            "version  not allowed",
+        ] {
+            assert!(problem(no_mark).starts_with("must contain"), "{no_mark}");
+        }
+        assert!(problem("Failed: update (version not allowed)")
+            .starts_with("must not start with \"Failed\""));
+        assert!(problem("update_tip now (version not allowed)")
+            .starts_with("must not start with a word"));
+        assert!(problem("update to {1.6.0} (version not allowed)").starts_with("must not have"));
+        assert!(problem("update } (version not allowed)").starts_with("must not have"));
+        assert!(problem("update RustDesk (version not allowed)").starts_with("must not name"));
+        for left in [
+            // %MIN% is filled in before the rules are applied: these are what is left
+            "update to %min% (version not allowed)",
+            "get it at %LINK% (version not allowed)",
+            "update to %MINIMUM% (version not allowed)",
+            "%MIN_VERSION%: update (version not allowed)",
+            "a%bcd%e (version not allowed)",
+        ] {
+            assert!(problem(left).starts_with("has a %NAME% left"), "{left}");
+        }
+        for glued in [
+            "https://rd.example.com/get/에서 받으세요. (version not allowed)",
+            "(https://rd.example.com/get/) (version not allowed)",
+            "\"https://rd.example.com/get/\" (version not allowed)",
+            "http://rd.example.com/a https://rd.example.com/b로 (version not allowed)",
+            "https://rd.example.com/get/(version not allowed)",
+        ] {
+            assert!(problem(glued).starts_with("must have a space"), "{glued}");
+        }
+        for fine in [
+            "update (version not allowed)",
+            "Not failed, update_tip later (version not allowed)",
+            "https://rd.example.com/get/ (version not allowed)",
+            "get it at https://rd.example.com/api/hjv/get/0a1b/?x=1&y=%20#top. (version not allowed)",
+            "http://192.0.2.1:8080/a, https://rd.example.com/b! (version not allowed) https://rd.example.com",
+            "see http and https:/ (version not allowed)",
+            // per cent signs that are no placeholder
+            "100% sure, 50% off: %MIN (version not allowed) %",
+            "https://rd.example.com/%EA%B0%80%2F?q=%ab%cd (version not allowed)",
+            "%% % %1.6.0% %a% %ab% %a b c% (version not allowed)",
+        ] {
+            assert_eq!(text_problem(fine), None, "{fine}");
+        }
+    }
+
+    #[test]
+    fn errors_never_quote_the_file() {
+        // TEXT may carry a link that is not for everyone who can read the log
+        for file in [
+            "MIN=secret-0a1b\nFROM=\nTEXT=x (version not allowed)\n",
+            "MIN=1.6.0\nFROM=secret-0a1b\nTEXT=x (version not allowed)\n",
+            "MIN=1.6.0\nFROM=\nTEXT=https://rd.example.com/secret-0a1b/\n",
+            "MIN=1.6.0\nFROM=\nTEXT=https://rd.example.com/secret-0a1b/에서 (version not allowed)\n",
+            "MIN=1.6.0\nFROM=\nTEXT=x (version not allowed)\nsecret-0a1b=1\n",
+            "MIN=1.6.0\nFROM=\nTEXT=x (version not allowed)\nsecret-0a1b\n",
+            "MIN=1.6.0\nFROM=\nTEXT=x (version not allowed)\nTEXT=secret-0a1b\n",
+            "MIN=1.6.0\nFROM=\nTEXT=secret-0a1b (version not allowed)",
+            "TEXT=secret-0a1b (version not allowed)\n",
+        ] {
+            let why = error(file);
+            assert!(!why.contains("secret") && !why.contains("0a1b"), "{why}");
+        }
+        let mut watcher = Watcher::new(PathBuf::from("/etc/hjviewer/min-controller.conf"));
+        let good =
+            "MIN=1.6.0\nFROM=\nTEXT=https://rd.example.com/secret-0a1b/ (version not allowed)\n";
+        let (_, line) = watcher.look(Seen::Content(good.into())).unwrap();
+        assert_eq!(line, "min-controller 1.6.0 from now");
+        assert!(!format!("{:?}", watcher.rule.describe()).contains("secret"));
+    }
+
+    fn content(file: &str) -> Seen {
+        Seen::Content(file.as_bytes().to_vec())
+    }
+
+    #[test]
+    fn a_bad_file_at_the_start_leaves_the_check_off() {
+        let mut watcher = Watcher::new(PathBuf::from("/p/min.conf"));
+        assert_eq!(*watcher.shared.rule(), Rule::Off);
+        let (level, line) = watcher.look(content("MIN=1.6\nFROM=\nTEXT=x\n")).unwrap();
+        assert_eq!(level, log::Level::Error);
+        assert_eq!(
+            line,
+            "min-controller file /p/min.conf: line 1: MIN must be x.y.z, such as 1.6.0; \
+             no minimum is in force"
+        );
+        assert_eq!(*watcher.shared.rule(), Rule::Off);
+        // said once
+        assert!(watcher.look(content("MIN=1.6\nFROM=\nTEXT=x\n")).is_none());
+        // and the file put right takes effect
+        let (level, line) = watcher
+            .look(content("MIN=1.6.0\nFROM=\nTEXT=x (version not allowed)\n"))
+            .unwrap();
+        assert_eq!(
+            (level, line.as_str()),
+            (log::Level::Info, "min-controller 1.6.0 from now")
+        );
+        assert!(matches!(&*watcher.shared.rule(), Rule::On(m) if m.number == 1006000));
+    }
+
+    #[test]
+    fn a_bad_file_later_keeps_the_last_good_rule() {
+        let mut watcher = Watcher::new(PathBuf::from("/p/min.conf"));
+        let good = format!("MIN=1.6.0\nFROM=2026-11-22T15:00:00Z\nTEXT={S1}\n");
+        let (level, line) = watcher.look(content(&good)).unwrap();
+        assert_eq!(
+            (level, line.as_str()),
+            (
+                log::Level::Info,
+                "min-controller 1.6.0 from 2026-11-22T15:00:00Z"
+            )
+        );
+        let in_force = watcher.shared.rule();
+        for (bad, why) in [
+            (
+                content("MIN=1.7\nFROM=\nTEXT=x (version not allowed)\n"),
+                "line 1: MIN must be x.y.z, such as 1.6.0",
+            ),
+            (
+                content("MIN=1.7.0\nFROM=\nTEXT=update\n"),
+                "line 3: TEXT must contain",
+            ),
+            (content(""), "no MIN= line"),
+            (
+                Seen::Unusable("cannot be read: denied".to_owned()),
+                "cannot be read: denied",
+            ),
+            (
+                Seen::Unusable("not a regular file".to_owned()),
+                "not a regular file",
+            ),
+        ] {
+            let (level, line) = watcher.look(bad).unwrap();
+            assert_eq!(level, log::Level::Error);
+            assert!(
+                line.starts_with(&format!("min-controller file /p/min.conf: {why}")),
+                "{line}"
+            );
+            assert!(
+                line.ends_with("; min-controller 1.6.0 from 2026-11-22T15:00:00Z stays in force"),
+                "{line}"
+            );
+            assert!(
+                Arc::ptr_eq(&in_force, &watcher.shared.rule()),
+                "the rule is untouched"
+            );
+        }
+        // the same trouble again is not news
+        assert!(watcher
+            .look(Seen::Unusable("not a regular file".to_owned()))
+            .is_none());
+        // the good file back is said again, so that who fixed it sees it took
+        let (level, line) = watcher.look(content(&good)).unwrap();
+        assert_eq!(
+            (level, line.as_str()),
+            (
+                log::Level::Info,
+                "min-controller 1.6.0 from 2026-11-22T15:00:00Z"
+            )
+        );
+        assert_eq!(*watcher.shared.rule(), *in_force);
+        assert!(watcher.look(content(&good)).is_none());
+    }
+
+    #[test]
+    fn no_file_means_no_minimum() {
+        let mut watcher = Watcher::new(PathBuf::from("/p/min.conf"));
+        // never there: as without the option, below the default log level
+        let (level, line) = watcher.look(Seen::Missing).unwrap();
+        assert_eq!(
+            (level, line.as_str()),
+            (log::Level::Debug, "min-controller off: no file /p/min.conf")
+        );
+        assert!(watcher.look(Seen::Missing).is_none());
+        assert_eq!(*watcher.shared.rule(), Rule::Off);
+        let good = "MIN=1.6.0\nFROM=\nTEXT=x (version not allowed)\n";
+        assert_eq!(watcher.look(content(good)).unwrap().0, log::Level::Info);
+        assert!(matches!(&*watcher.shared.rule(), Rule::On(_)));
+        // taken away: off, and said
+        let (level, line) = watcher.look(Seen::Missing).unwrap();
+        assert_eq!(
+            (level, line.as_str()),
+            (log::Level::Info, "min-controller off: no file /p/min.conf")
+        );
+        assert_eq!(*watcher.shared.rule(), Rule::Off);
+        // emptied: off, and said
+        assert_eq!(watcher.look(content(good)).unwrap().0, log::Level::Info);
+        let (level, line) = watcher.look(content("MIN=\nFROM=\nTEXT=\n")).unwrap();
+        assert_eq!(
+            (level, line.as_str()),
+            (
+                log::Level::Info,
+                "min-controller off: MIN is empty in /p/min.conf"
+            )
+        );
+        assert_eq!(*watcher.shared.rule(), Rule::Off);
+    }
+
+    #[test]
+    fn only_a_regular_file_of_a_sane_size_is_read() {
+        let dir = std::env::temp_dir().join(format!("hbbs-min-controller-{}", std::process::id()));
+        std::fs::remove_dir_all(&dir).ok();
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("min.conf");
+        assert!(read_file(&path) == Seen::Missing);
+        assert!(read_file(&dir.join("no-dir").join("min.conf")) == Seen::Missing);
+        assert!(read_file(&dir) == Seen::Unusable("not a regular file".to_owned()));
+        std::fs::write(&path, "MIN=\n").unwrap();
+        assert!(read_file(&path) == content("MIN=\n"));
+        // under a file instead of a directory: an error other than "not found"
+        #[cfg(unix)]
+        assert!(
+            matches!(read_file(&path.join("min.conf")), Seen::Unusable(why) if why.starts_with("cannot be read: "))
+        );
+        std::fs::write(&path, vec![b'#'; MAX_FILE_BYTES as usize]).unwrap();
+        assert!(
+            matches!(read_file(&path), Seen::Content(bytes) if bytes.len() == MAX_FILE_BYTES as usize)
+        );
+        std::fs::write(&path, vec![b'#'; MAX_FILE_BYTES as usize + 1]).unwrap();
+        assert!(read_file(&path) == Seen::Unusable("larger than 64 KiB".to_owned()));
+        // all of it is read: the rule after comments that fill the file up to 64 KiB
+        let rule = format!("MIN=1.6.0\nFROM=\nTEXT={S2}\n");
+        let mut file = String::new();
+        while file.len() + rule.len() < MAX_FILE_BYTES as usize {
+            let left = MAX_FILE_BYTES as usize - rule.len() - file.len();
+            file.push_str(&"#".repeat(left.min(80) - 1));
+            file.push('\n');
+        }
+        file.push_str(&rule);
+        assert_eq!(file.len(), MAX_FILE_BYTES as usize);
+        std::fs::write(&path, &file).unwrap();
+        let Seen::Content(bytes) = read_file(&path) else {
+            panic!("a file of 64 KiB is read");
+        };
+        assert!(matches!(parse(&bytes), Ok(Rule::On(m)) if m.number == 1006000));
+        std::fs::remove_dir_all(&dir).ok();
+    }
+
+    #[test]
+    fn a_file_that_cannot_be_used_is_said_again_every_hour() {
+        // the rule in force may be one that the next start of hbbs drops
+        assert_eq!(u64::from(REPEAT_LOOKS) * RELOAD_SECS, 3600);
+        let good = || content("MIN=1.6.0\nFROM=\nTEXT=x (version not allowed)\n");
+        let bad = || content("MIN=1.7\nFROM=\nTEXT=x (version not allowed)\n");
+        let mut watcher = Watcher::new(PathBuf::from("/p/min.conf"));
+        assert_eq!(watcher.look(good()).unwrap().0, log::Level::Info);
+        let said = watcher.look(bad()).unwrap();
+        assert_eq!(said.0, log::Level::Error);
+        assert!(
+            said.1
+                .ends_with("; min-controller 1.6.0 from now stays in force"),
+            "{}",
+            said.1
+        );
+        for hour in 1..=3 {
+            for look in 1..REPEAT_LOOKS {
+                assert_eq!(watcher.look(bad()), None, "hour {hour}, look {look}");
+            }
+            assert_eq!(watcher.look(bad()), Some(said.clone()), "hour {hour}");
+        }
+        // another trouble is news at once, and its own hour starts
+        let unreadable = || Seen::Unusable("cannot be read: denied".to_owned());
+        let said = watcher.look(unreadable()).unwrap();
+        assert!(said.1.contains(": cannot be read: denied; "), "{}", said.1);
+        for _ in 1..REPEAT_LOOKS {
+            assert_eq!(watcher.look(unreadable()), None);
+        }
+        assert_eq!(watcher.look(unreadable()), Some(said));
+        // put right: said once, and then nothing, nor of a file taken away
+        assert_eq!(watcher.look(good()).unwrap().0, log::Level::Info);
+        for _ in 0..2 * REPEAT_LOOKS {
+            assert_eq!(watcher.look(good()), None);
+        }
+        assert_eq!(watcher.look(Seen::Missing).unwrap().0, log::Level::Info);
+        for _ in 0..2 * REPEAT_LOOKS {
+            assert_eq!(watcher.look(Seen::Missing), None);
+        }
+        // a bad file at the start, with no minimum in force, the same
+        let mut watcher = Watcher::new(PathBuf::from("/p/min.conf"));
+        let said = watcher.look(bad()).unwrap();
+        assert!(said.1.ends_with("; no minimum is in force"), "{}", said.1);
+        for _ in 1..REPEAT_LOOKS {
+            assert_eq!(watcher.look(bad()), None);
+        }
+        assert_eq!(watcher.look(bad()), Some(said));
+        assert_eq!(*watcher.shared.rule(), Rule::Off);
+    }
+
+    #[test]
+    fn a_flood_of_refusals_is_counted_not_logged() {
+        let shared = Watcher::new(PathBuf::new()).shared;
+        for _ in 0..LOGGED_REFUSALS {
+            assert!(shared.logs_this_refusal());
+        }
+        for _ in 0..1000 {
+            assert!(!shared.logs_this_refusal());
+        }
+        assert_eq!(shared.next_log_period(), 1000);
+        assert!(shared.logs_this_refusal());
+        assert_eq!(shared.next_log_period(), 0);
+    }
+
+    #[test]
+    fn the_log_shows_the_start_of_what_the_controller_sent() {
+        assert_eq!(head("1.5.1", LOGGED_VERSION_CHARS), "1.5.1");
+        assert_eq!(head(&"가".repeat(100), 32), "가".repeat(32));
+        assert_eq!(head("", 32), "");
+        // and as a quoted string, so a line break in it cannot start a log line of its own
+        assert_eq!(
+            format!("{:?}", head("1.5.1\n[x] ERROR y", 32)),
+            "\"1.5.1\\n[x] ERROR y\""
+        );
+    }
+
+    #[test]
+    fn without_a_file_nobody_is_refused() {
+        let addr = "192.0.2.1:1".parse().unwrap();
+        assert!(MinController(None).refusal(addr, "123456789", "").is_none());
+        let mut watcher = Watcher::new(PathBuf::from("/p/min.conf"));
+        let handle = MinController(Some(watcher.shared.clone()));
+        assert!(handle.refusal(addr, "123456789", "").is_none());
+        watcher.look(content(
+            "MIN=1.6.0\nFROM=\nTEXT=update to %MIN% (version not allowed)\n",
+        ));
+        let msg = handle.clone().refusal(addr, "123456789", "1.5.1").unwrap();
+        let hbb_common::rendezvous_proto::rendezvous_message::Union::PunchHoleResponse(res) =
+            msg.union.unwrap()
+        else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(res.other_failure, "update to 1.6.0 (version not allowed)");
+        assert!(res.socket_addr.is_empty() && res.pk.is_empty() && res.relay_server.is_empty());
+        assert!(handle.refusal(addr, "123456789", "1.6.0").is_none());
+        watcher.look(content(
+            "MIN=1.6.0\nFROM=2999-01-01T00:00:00Z\nTEXT=x (version not allowed)\n",
+        ));
+        assert!(handle.refusal(addr, "123456789", "1.5.1").is_none());
+    }
+}
