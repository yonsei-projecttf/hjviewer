+#[test]
+fn what_a_controller_sends_cannot_forge_or_flood_the_log() {
+    let file = conf("1.6.0", "", "Update to %MIN%. (version not allowed)");
+    let server = Hbbs::start("log", Told::Env, Some(file.as_bytes()));
+    runtime().block_on(async {
+        let mut controller = Client::connect(&server, "198.51.100.40:50001").await;
+        // a line break and a long tail in the version, an ID of 300 characters: the log has the
+        // first 32 characters of the one and 64 of the other, in one line
+        let version = format!("1.5.1\nFORGED ERROR line{}", "x".repeat(1000));
+        let id = "9".repeat(300);
+        controller
+            .send(punch_hole_request(&id, &server.key, &version))
+            .await;
+        controller.expect_refused().await;
+        // a version get_version_number cannot count: refused, and hbbs lives on
+        controller
+            .send(punch_hole_request(
+                NO_PEER_ID,
+                &server.key,
+                "99.1.1.1.1.1.1",
+            ))
+            .await;
+        controller.expect_refused().await;
+        let line = server
+            .wait_for_line(
+                "min-controller refused 198.51.100.40:50001 for \"999",
+                Duration::from_secs(5),
+            )
+            .await;
+        assert!(
+            line.ends_with(&format!(
+                r#"for "{}": version "1.5.1\nFORGED ERROR line{}""#,
+                "9".repeat(64),
+                "x".repeat(32 - "1.5.1\nFORGED ERROR line".len())
+            )),
+            "{line}"
+        );
+        assert!(!server.log().lines().any(|l| l.starts_with("FORGED")));
+
+        // a hundred more in one go: the first of each 10 seconds are logged, the rest counted
+        const FLOOD: usize = 100;
+        for _ in 0..FLOOD {
+            controller
+                .send(punch_hole_request(NO_PEER_ID, &server.key, "1.5.1"))
+                .await;
+            controller.expect_refused().await;
+        }
+        sleep(RELOAD + SLACK).await;
+        let lines = server.min_controller_lines();
+        let one_by_one = lines
+            .iter()
+            .filter(|l| l.contains(r#"": version "1.5.1""#))
+            .count();
+        let counted: usize = lines
+            .iter()
+            .filter_map(|l| {
+                let rest = l.split("] min-controller refused ").nth(1)?;
+                rest.strip_suffix(" more in the last 10 seconds")?
+                    .parse::<usize>()
+                    .ok()
+            })
+            .sum();
+        assert!(
+            counted > 0 && one_by_one < FLOOD,
+            "{one_by_one} logged, {counted} counted"
+        );
+        assert_eq!(one_by_one + counted, FLOOD, "{lines:?}");
+        // and hbbs still answers
+        assert_eq!(refusal(&server, "1.6.0").await, None);
+    });
+}
