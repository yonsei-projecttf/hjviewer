+#[test]
+fn a_bad_file_keeps_the_last_good_one() {
+    let text = "Update to %MIN%. (version not allowed)";
+    let server = Hbbs::start("keep", Told::Env, Some(conf("1.6.0", "", text).as_bytes()));
+    runtime().block_on(async {
+        assert!(refusal(&server, "1.5.1").await.is_some());
+
+        // a minimum that is not x.y.z: what get_version_number would read as 1060
+        server.write_conf(&conf("1.6", "", text));
+        let line = server
+            .wait_for_line("MIN must be x.y.z", RELOAD + SLACK + SLACK)
+            .await;
+        assert!(line.contains("] ERROR ["), "{line}");
+        assert!(
+            line.contains("min-controller.conf: line 2: MIN must be x.y.z, such as 1.6.0; "),
+            "{line}"
+        );
+        assert!(
+            line.ends_with("; min-controller 1.6.0 from now stays in force"),
+            "{line}"
+        );
+        assert_eq!(
+            refusal(&server, "1.5.1").await.as_deref(),
+            Some("Update to 1.6.0. (version not allowed)")
+        );
+        assert_eq!(refusal(&server, "1.6.0").await, None);
+
+        // a text that would make 1.5.1 apps ask again for ever
+        server.write_conf(&conf("1.7.0", "", "Update to %MIN%."));
+        let line = server
+            .wait_for_line("TEXT must contain", RELOAD + SLACK + SLACK)
+            .await;
+        assert!(line.contains("] ERROR ["), "{line}");
+        assert!(
+            line.ends_with("; min-controller 1.6.0 from now stays in force"),
+            "{line}"
+        );
+        assert_eq!(
+            refusal(&server, "1.6.0").await,
+            None,
+            "1.7.0 did not take effect"
+        );
+        assert!(refusal(&server, "1.5.1").await.is_some());
+
+        // put right, it takes effect again
+        server.write_conf(&conf("1.5.1", "", text));
+        let (_, took) = until_refused(&server, "1.5.1", false).await;
+        assert!(took < RELOAD + SLACK, "{took:?}");
+        assert!(refusal(&server, "1.5.0").await.is_some());
+        let lines = server.min_controller_lines();
+        let errors = lines.iter().filter(|l| l.contains("] ERROR [")).count();
+        assert_eq!(errors, 2, "each bad file is said once: {lines:?}");
+    });
+}
