+                "1970-01-01T00:00:00Z",
+            ),
+            (
+                "9999-12-31T23:59:59Z",
+                "9999-12-31T23:59:58Z",
+                "9999-12-31T23:59:59Z",
+            ),
+            // a leap day, and the last second of a day
+            (
+                "2028-02-29T00:00:00Z",
+                "2028-02-28T23:59:59Z",
+                "2028-02-29T00:00:00Z",
+            ),
