+            assert_eq!(Rule::On(minimum).describe(), format!("1.6.0 from {from}"));
+        }
+        // what RFC 3339 also allows but the release tool never writes, and what is no time
+        for from in [
+            "2026-11-23T00:00:00+09:00",
+            "2026-11-22T15:00:00+00:00",
+            "2026-11-22T15:00:00-00:00",
+            "2026-12-31T23:59:60Z",
+            "2026-11-22T15:00:00.25Z",
+            "2026-11-22T15:00:00.000Z",
+            "2026-11-22t15:00:00z",
+            "2026-11-22 15:00:00Z",
+            "2026-11-22T15:00Z",
+            "+2026-11-22T15:00:00Z",
+            "0000-01-01T00:00:00Z",
+            "2026-02-29T00:00:00Z",
+            "2026-13-01T00:00:00Z",
+            "2026-11-31T00:00:00Z",
+            "2026-11-00T00:00:00Z",
+            "2026-11-22T24:00:00Z",
+            "2026-11-22T15:60:00Z",
+            "2026-1１-22T15:00:00Z",
+            "2026-11-22T15:00:0-Z",
+        ] {
+            let why = error(&format!("MIN=1.6.0\nFROM={from}\n{text}"));
+            assert_eq!(
+                why, "line 2: FROM must be a UTC time written as 2026-11-22T15:00:00Z",
+                "{from}"
+            );
+        }
+        // the clock itself at the edges: before 1970, and now
+        let minimum = on(&format!("MIN=1.6.0\nFROM=1970-01-01T00:00:00Z\n{text}"));
+        let before_1970 = SystemTime::UNIX_EPOCH - Duration::from_secs(86400);
+        assert!(!minimum.refuses("1.5.1", before_1970.into()));
+        assert!(minimum.refuses("1.5.1", SystemTime::now().into()));
+    }
