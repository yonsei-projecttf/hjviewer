+++ b/tests/min_version.rs
@@ -0,0 +1,1067 @@
+//! HJViewer: hbbs refuses a controller whose app is older than the minimum in the file named by
+//! `--hjv-min-controller-file` (HJV_MIN_CONTROLLER_FILE), at its punch hole request, with a
+//! PunchHoleResponse whose `other_failure` every app version shows as it is (RustDesk client:
+//! `bail!(ph.other_failure)`), before the peer is looked up or told. hbbs reads the file again
+//! every 10 seconds; a file it cannot use changes nothing.
+
+use chrono::{SecondsFormat, Utc};
+use hbb_common::{
+    futures_util::{SinkExt, StreamExt},
+    protobuf::Message as _,
+    rendezvous_proto::*,
+    tokio::{
+        self,
+        net::TcpStream,
+        time::{sleep, timeout, Duration, Instant},
+    },
+};
+use std::{
+    net::SocketAddr,
+    path::PathBuf,
+    process::{Child, Command},
+    sync::{
+        atomic::{AtomicU16, Ordering},
+        Mutex,
+    },
+};
+use tokio_tungstenite::{
+    tungstenite::{client::IntoClientRequest, http::HeaderValue, Message as WsMessage},
+    MaybeTlsStream, WebSocketStream,
+};
+
+const PEER_ID: &str = "123456789";
+/// An ID nobody registers: a request for it that is not refused for its version is answered
+/// with ID_NOT_EXIST at once.
+const NO_PEER_ID: &str = "987654321";
+/// hbbs reads the file again this often.
+const RELOAD: Duration = Duration::from_secs(10);
+/// What a change may take to show beyond that: the gap between two tries, and a busy machine.
+const SLACK: Duration = Duration::from_secs(3);
+
+// design 2-5: what a 1.5.1 app shows while the download link is open (S1), and after (S2). The
+// host and the code are made up.
+const LINK_CODE: &str = "00112233445566778899aabbccddeeff";
+const S1: &str = "HJViewer를 %MIN% 이상으로 업데이트해야 연결할 수 있습니다. Play 스토어에서 \
+    설치했다면 Play 스토어에서, iPhone은 TestFlight 앱에서 업데이트하세요. 그 밖의 \
+    Windows·Android는 https://rd.example.com/api/hjv/get/00112233445566778899aabbccddeeff/ 에서 \
+    새 버전을 받으세요. (version not allowed)";
+const S2: &str = "HJViewer를 %MIN% 이상으로 업데이트해야 연결할 수 있습니다. 앱의 업데이트 화면을 \
+    쓰거나 관리자에게 새 버전을 받으세요. Play 스토어나 TestFlight로 설치했다면 그곳에서 \
+    업데이트하세요. (version not allowed)";
+
+fn conf(min: &str, from: &str, text: &str) -> String {
+    format!("# read again every 10 seconds\nMIN={min}\nFROM={from}\nTEXT={text}\n")
+}
+
+/// How hbbs is told about the file.
+#[derive(Clone, Copy)]
+enum Told {
+    No,
+    Env,
+    Arg,
+}
+
+struct Hbbs {
+    child: Child,
+    dir: PathBuf,
+    port: u16,
+    key: String,
+}
+
+/// One hbbs starts at a time: between picking its ports and binding them, another test of
+/// this file would be given the same ones. The names taken so far: each server has a directory
+/// of its name, and the tests run side by side.
+static STARTING: Mutex<Vec<String>> = Mutex::new(Vec::new());
+static NEXT_CLIENT_PORT: AtomicU16 = AtomicU16::new(20000);
+
+impl Hbbs {
+    /// hbbs in a directory of its own, where `file`, if any, is the file the option names.
+    fn start(name: &str, told: Told, file: Option<&[u8]>) -> Self {
+        Self::start_with(name, told, || file.map(<[u8]>::to_vec), &[])
+    }
+
+    /// `file` is made when it is this server's turn to start, for a file with a time in it.
+    fn start_with(
+        name: &str,
+        told: Told,
+        file: impl FnOnce() -> Option<Vec<u8>>,
+        env: &[(&str, &str)],
+    ) -> Self {
+        let dir = std::env::temp_dir().join(format!("hbbs-minver-{name}-{}", std::process::id()));
+        std::fs::remove_dir_all(&dir).ok();
+        std::fs::create_dir_all(&dir).expect("create the server's working directory");
+        let conf = dir.join("min-controller.conf");
+        let mut names = STARTING.lock().unwrap_or_else(|e| e.into_inner());
+        assert!(!names.iter().any(|n| n == name), "two servers named {name}");
+        names.push(name.to_owned());
+        if let Some(file) = file() {
+            std::fs::write(&conf, file).expect("write the file");
+        }
+        for _ in 0..3 {
+            let port = free_base_port();
+            let log = std::fs::File::create(dir.join("hbbs.log")).expect("create the server log");
+            let mut cmd = Command::new(env!("CARGO_BIN_EXE_hbbs"));
+            cmd.args(["-p", &port.to_string()])
+                .current_dir(&dir)
+                // hbbs reads its options from the environment first
+                .env_clear()
+                .env("TEST_HBBS", "no")
+                .env("RUST_LOG", "debug")
+                .stdout(log.try_clone().expect("share the server log"))
+                .stderr(log);
+            match told {
+                Told::No => {}
+                Told::Env => {
+                    cmd.env("HJV_MIN_CONTROLLER_FILE", &conf);
+                }
+                Told::Arg => {
+                    cmd.arg("--hjv-min-controller-file").arg(&conf);
+                }
+            }
+            for (k, v) in env {
+                cmd.env(k, v);
+            }
+            let mut server = Self {
+                child: cmd.spawn().expect("start hbbs"),
+                dir: dir.clone(),
+                port,
+                key: String::new(),
+            };
+            for _ in 0..100 {
+                if std::net::TcpStream::connect(("127.0.0.1", port + 2)).is_ok() {
+                    server.key = std::fs::read_to_string(dir.join("id_ed25519.pub"))
+                        .expect("hbbs writes its public key before it listens");
+                    return server;
+                }
+                if server.child.try_wait().expect("wait for hbbs").is_some() {
+                    // somebody else took one of the ports in between
+                    break;
+                }
+                std::thread::sleep(std::time::Duration::from_millis(100));
+            }
+            eprintln!("hbbs did not start listening on {port}:\n{}", server.log());
+            server.dir = PathBuf::new();
+        }
+        panic!("hbbs did not start listening");
+    }
+
+    fn conf(&self) -> PathBuf {
+        self.dir.join("min-controller.conf")
+    }
+
+    /// Puts a new file in place in one step, as the runbook does (write beside it, rename).
+    fn write_conf(&self, file: &str) {
+        let new = self.dir.join("min-controller.conf.new");
+        std::fs::write(&new, file).expect("write the new file");
+        std::fs::rename(&new, self.conf()).expect("put the new file in place");
+    }
+
+    fn log(&self) -> String {
+        std::fs::read_to_string(self.dir.join("hbbs.log")).unwrap_or_default()
+    }
+
+    /// The log lines about the minimum that an operator sees (hbbs logs from INFO up).
+    fn min_controller_lines(&self) -> Vec<String> {
+        self.log()
+            .lines()
+            .filter(|l| l.contains("min-controller") && !l.contains("] DEBUG ["))
+            .map(str::to_owned)
+            .collect()
+    }
+
+    /// Waits until the log shows that hbbs took a connection. hbbs writes its log in order, a
+    /// moment after the fact, so by then all it said while starting is in the log too.
+    async fn wait_for_the_log_of_a_connection(&self) {
+        let until = Instant::now() + Duration::from_secs(5);
+        while !self.log().contains("] Tcp connection from ") {
+            assert!(Instant::now() < until, "no connection in the log within 5s");
+            sleep(Duration::from_millis(100)).await;
+        }
+    }
+
+    /// The operator lines once there are `n` of them (hbbs flushes its log every second).
+    async fn wait_for_lines(&self, n: usize) -> Vec<String> {
+        let until = Instant::now() + Duration::from_secs(5);
+        loop {
+            let lines = self.min_controller_lines();
+            if lines.len() >= n || Instant::now() > until {
+                return lines;
+            }
+            sleep(Duration::from_millis(100)).await;
+        }
+    }
+
+    /// The first operator line with `needle`, once hbbs has written it.
+    async fn wait_for_line(&self, needle: &str, within: Duration) -> String {
+        let until = Instant::now() + within;
+        loop {
+            if let Some(line) = self
+                .min_controller_lines()
+                .into_iter()
+                .find(|l| l.contains(needle))
+            {
+                return line;
+            }
+            if Instant::now() > until {
+                panic!("no log line with {needle:?} within {within:?}");
+            }
+            sleep(Duration::from_millis(100)).await;
+        }
+    }
+}
+
+impl Drop for Hbbs {
+    fn drop(&mut self) {
+        self.child.kill().ok();
+        self.child.wait().ok();
+        if self.dir.as_os_str().is_empty() {
+            return;
+        }
+        if std::thread::panicking() {
+            eprintln!("---- hbbs log ----\n{}", self.log());
+        }
+        std::fs::remove_dir_all(&self.dir).ok();
+    }
+}
+
+/// A port p with p-1, p and p+2 free for TCP and p for UDP: hbbs listens on all of them.
+fn free_base_port() -> u16 {
+    for _ in 0..100 {
+        let port = std::net::TcpListener::bind("127.0.0.1:0")
+            .and_then(|l| l.local_addr())
+            .expect("pick a free port")
+            .port();
+        if !(1025..=65000).contains(&port) {
+            continue;
+        }
+        let tcp_free = [port - 1, port, port + 2]
+            .iter()
+            .all(|p| std::net::TcpListener::bind(("0.0.0.0", *p)).is_ok());
+        if tcp_free && std::net::UdpSocket::bind(("0.0.0.0", port)).is_ok() {
+            return port;
+        }
+    }
+    panic!("no free port range for hbbs");
+}
+
+/// A client connection to hbbs's WebSocket port, made the way a TLS-terminating reverse proxy
+/// in front of it does, with the client's real address in X-Real-IP / X-Real-Port.
+struct Client {
+    ws: WebSocketStream<MaybeTlsStream<TcpStream>>,
+}
+
+impl Client {
+    async fn connect(server: &Hbbs, real_addr: &str) -> Self {
+        let real_addr: SocketAddr = real_addr.parse().expect("client address");
+        let mut request = format!("ws://127.0.0.1:{}/", server.port + 2)
+            .into_client_request()
+            .expect("websocket request");
+        let headers = request.headers_mut();
+        headers.insert(
+            "X-Real-IP",
+            HeaderValue::from_str(&real_addr.ip().to_string()).expect("ip header"),
+        );
+        headers.insert(
+            "X-Real-Port",
+            HeaderValue::from_str(&real_addr.port().to_string()).expect("port header"),
+        );
+        let (ws, _) = tokio_tungstenite::connect_async(request)
+            .await
+            .expect("connect to hbbs");
+        Self { ws }
+    }
+
+    /// A controller at an address no other connection of this test run has.
+    async fn controller(server: &Hbbs) -> Self {
+        let port = NEXT_CLIENT_PORT.fetch_add(1, Ordering::Relaxed);
+        Self::connect(server, &format!("198.51.100.20:{port}")).await
+    }
+
+    async fn send(&mut self, msg: RendezvousMessage) {
+        let bytes = msg.write_to_bytes().expect("encode");
+        self.ws
+            .send(WsMessage::Binary(bytes))
+            .await
+            .expect("send to hbbs");
+    }
+
+    /// The next frame within `within`, `None` if there is none. Empty frames are heartbeats.
+    async fn frame(&mut self, within: Duration) -> Option<Vec<u8>> {
+        loop {
+            match timeout(within, self.ws.next()).await {
+                Err(_) => return None,
+                Ok(Some(Ok(WsMessage::Binary(bytes)))) => return Some(bytes),
+                Ok(Some(Ok(WsMessage::Close(_)))) | Ok(None) => {
+                    panic!("hbbs closed the connection")
+                }
+                Ok(Some(Ok(_))) => continue,
+                Ok(Some(Err(err))) => panic!("websocket error: {err}"),
+            }
+        }
+    }
+
+    /// The next message, echoing heartbeats on the way like the client does.
+    async fn recv(&mut self) -> rendezvous_message::Union {
+        loop {
+            let bytes = self
+                .frame(Duration::from_secs(5))
+                .await
+                .expect("a message from hbbs within 5s");
+            if bytes.is_empty() {
+                self.ws
+                    .send(WsMessage::Binary(Vec::new()))
+                    .await
+                    .expect("echo the heartbeat");
+                continue;
+            }
+            return RendezvousMessage::parse_from_bytes(&bytes)
+                .expect("decode")
+                .union
+                .expect("a message with a body");
+        }
+    }
+
+    /// No message within half a second. Heartbeats (empty frames) are echoed and do not count:
+    /// a peer can get its first one right after registering.
+    async fn expect_silence(&mut self) {
+        let until = Instant::now() + Duration::from_millis(500);
+        loop {
+            let left = until.saturating_duration_since(Instant::now());
+            match self.frame(left).await {
+                None => return,
+                Some(bytes) if bytes.is_empty() => {
+                    self.ws
+                        .send(WsMessage::Binary(Vec::new()))
+                        .await
+                        .expect("echo the heartbeat");
+                }
+                Some(bytes) => {
+                    panic!(
+                        "unexpected message: {:?}",
+                        RendezvousMessage::parse_from_bytes(&bytes)
+                    )
+                }
+            }
+        }
+    }
+
+    /// The refusal as the 1.5.1 app reads it: no socket_addr, so `other_failure` is the error.
+    async fn expect_refused(&mut self) -> String {
+        let rendezvous_message::Union::PunchHoleResponse(res) = self.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert!(res.socket_addr.is_empty(), "a refusal carries no address");
+        assert!(res.pk.is_empty(), "nor the peer's key");
+        assert!(res.relay_server.is_empty(), "nor a relay");
+        assert!(!res.other_failure.is_empty(), "the app shows other_failure");
+        res.other_failure
+    }
+}
+
+fn register_pk() -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_register_pk(RegisterPk {
+        id: PEER_ID.to_owned(),
+        uuid: b"peer-uuid".to_vec().into(),
+        pk: [7u8; 32].to_vec().into(),
+        ..Default::default()
+    });
+    msg
+}
+
+fn punch_hole_request(id: &str, key: &str, version: &str) -> RendezvousMessage {
+    let mut msg = RendezvousMessage::new();
+    msg.set_punch_hole_request(PunchHoleRequest {
+        id: id.to_owned(),
+        licence_key: key.to_owned(),
+        version: version.to_owned(),
+        // what HJViewer apps send: allow-websocket forces relay, and relay sends SYMMETRIC
+        nat_type: NatType::SYMMETRIC.into(),
+        force_relay: true,
+        ..Default::default()
+    });
+    msg
+}
+
+fn runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime")
+}
+
+async fn registered_peer(server: &Hbbs) -> Client {
+    let mut peer = Client::connect(server, "203.0.113.10:40001").await;
+    peer.send(register_pk()).await;
+    let rendezvous_message::Union::RegisterPkResponse(res) = peer.recv().await else {
+        panic!("expected a register pk response");
+    };
+    assert_eq!(
+        res.result.enum_value(),
+        Ok(register_pk_response::Result::OK)
+    );
+    peer
+}
+
+/// What a controller of `version` gets for a connection to an ID nobody registered: the text
+/// of the refusal, or `None` when hbbs went on to look the ID up.
+async fn refusal(server: &Hbbs, version: &str) -> Option<String> {
+    let mut controller = Client::controller(server).await;
+    controller
+        .send(punch_hole_request(NO_PEER_ID, &server.key, version))
+        .await;
+    let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+        panic!("expected a punch hole response");
+    };
+    if res.other_failure.is_empty() {
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::ID_NOT_EXIST)
+        );
+        return None;
+    }
+    assert!(res.socket_addr.is_empty(), "a refusal carries no address");
+    Some(res.other_failure)
+}
+
+/// Asks as `version` until the answer is a refusal (`refused`) or no longer one; the answer,
+/// and how long that took. Panics after the reload period and some more.
+async fn until_refused(server: &Hbbs, version: &str, refused: bool) -> (Option<String>, Duration) {
+    let start = Instant::now();
+    loop {
+        let answer = refusal(server, version).await;
+        if answer.is_some() == refused {
+            return (answer, start.elapsed());
+        }
+        if start.elapsed() > RELOAD + SLACK + SLACK {
+            panic!(
+                "version {version:?}: still refused = {} after {:?}",
+                !refused,
+                start.elapsed()
+            );
+        }
+        sleep(Duration::from_millis(200)).await;
+    }
+}
+
+/// The rules of design 2-5 for a text an installed app shows, as RustDesk 1.5.0 applies them.
+fn assert_apps_show_it_as_it_is(text: &str) {
+    // client.rs check_if_retry: without one of its stop words the app asks again on a timer
+    assert!(text.to_lowercase().contains("not allowed"), "{text}");
+    // what apps from 1.6.0 on know a version refusal by
+    assert!(text.contains("version not allowed"), "{text}");
+    // client.rs Client::start appends ": Please try later"
+    assert!(!text.starts_with("Failed"), "{text}");
+    // common.dart translates a first word that ends in _tip alone
+    let first = text.split(' ').next().unwrap_or_default();
+    assert!(!first.ends_with("_tip"), "{text}");
+    // lang.rs takes {…} for a placeholder and puts the app's name where RustDesk stands
+    assert!(!text.contains('{') && !text.contains('}'), "{text}");
+    assert!(!text.contains("RustDesk"), "{text}");
+    assert!(!text.contains("%MIN%"), "{text}");
+    // common.dart makes a link of https?://[^\s]+ : nothing but the URL may reach the next space
+    for (at, _) in text.match_indices("http") {
+        let rest = &text[at..];
+        if !rest.starts_with("http://") && !rest.starts_with("https://") {
+            continue;
+        }
+        let url = rest.split(char::is_whitespace).next().unwrap_or_default();
+        assert!(
+            url.chars()
+                .all(|c| c.is_ascii_alphanumeric() || ":/.-_~%?#=&".contains(c)),
+            "what follows the URL becomes part of the link: {url}"
+        );
+    }
+}
