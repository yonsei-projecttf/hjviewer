--- /dev/null
+++ b/src/hjv_min_controller.rs
@@ -0,0 +1,1368 @@
+//! HJViewer: the lowest app version a controller may ask for a connection with.
+//!
+//! Every app version sends its version in the punch hole request, the first thing a connection
+//! through this server starts with, and shows the text of a refusal instead of connecting. That
+//! is the only way to make the apps that are already installed update: they do not check for
+//! updates themselves. It is not an access control: the version is what the app says it is.
+//!
+//! The rule comes from the file named by `--hjv-min-controller-file` (HJV_MIN_CONTROLLER_FILE).
+//! Without that option nothing here runs or logs. The file is read again every 10 seconds, so a
+//! change needs no restart:
+//!
+//! ```text
+//! # a comment
+//! MIN=1.6.0
+//! FROM=2026-11-22T15:00:00Z
+//! TEXT=Update to %MIN% or later at https://rd.example.com/get/ to connect. (version not allowed)
+//! ```
+//!
+//! - `MIN`: `x.y.z`; controllers below it are refused. `MIN=` alone: no minimum.
+//! - `FROM`: the time the refusals start at, in UTC and in the one form the release tool writes,
+//!   `2026-11-22T15:00:00Z`. `FROM=` alone: at once.
+//! - `TEXT`: what a refused app shows, `%MIN%` standing for the minimum. `text_problem` has the
+//!   rules that keep the installed apps from mishandling it.
+//!
+//! While MIN names a version all three lines have to be there, each once, and every line ends
+//! with a line break, so that a file caught half written is never taken for a shorter rule. A
+//! key comes right before its `=`, as the tool writes it: hbbs and `hjv-release hbbs-conf
+//! --current` read the same files the same way.
+//!
+//! A file that cannot be used changes nothing: the rule of the last good one stays in force (at
+//! the start there is none) and the log says why, again every hour while the file stays so: the
+//! rule in force then is gone with the next start of hbbs. No file means no minimum.
+//!
+//! hbbs's own log lines never quote the file: TEXT may carry a download link meant only for apps
+//! that hold this server's key. At the trace level the WebSocket library logs every frame it
+//! sends, the refusals with their TEXT among them, so a log of that level holds the link.
+
+use chrono::{DateTime, NaiveDate, NaiveTime, SecondsFormat, Utc};
+use hbb_common::{
+    log,
+    rendezvous_proto::{PunchHoleResponse, RendezvousMessage},
+    tokio::{self, time::MissedTickBehavior},
+};
+use std::{
+    io::Read,
+    net::SocketAddr,
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc, RwLock,
+    },
+    time::{Duration, SystemTime},
+};
+
+const OPTION: &str = "hjv-min-controller-file";
+const RELOAD_SECS: u64 = 10;
+/// The looks at a file that cannot be used between two errors about it: an hour.
+const REPEAT_LOOKS: u32 = 360;
+const MAX_FILE_BYTES: u64 = 64 * 1024;
+const MAX_TEXT_CHARS: usize = 2000;
+/// No app version is this long ("1.6.0"); what is longer is not counted.
+const MAX_VERSION_BYTES: usize = 64;
+/// Apps from 1.6.0 on know a version refusal by this phrase. Its "not allowed" also keeps every
+/// older app from asking again on a timer (the client's check_if_retry).
+const REFUSAL_MARK: &str = "version not allowed";
+/// Refusals logged one by one between two looks at the file; the rest are only counted.
+const LOGGED_REFUSALS: u64 = 30;
+/// What the log shows of the ID and the version, both of which the controller chooses.
+const LOGGED_ID_CHARS: usize = 64;
+const LOGGED_VERSION_CHARS: usize = 32;
+
+/// The handle the rendezvous server keeps; clones share one rule.
+#[derive(Clone)]
+pub(crate) struct MinController(Option<Arc<Shared>>);
+
+struct Shared {
+    /// Written by the watcher only.
+    rule: RwLock<Arc<Rule>>,
+    logged: AtomicU64,
+    not_logged: AtomicU64,
+}
+
+// No Debug outside the tests: TEXT must not reach the log.
+#[cfg_attr(test, derive(Debug, PartialEq))]
+enum Rule {
+    Off,
+    On(Minimum),
+}
+
+#[cfg_attr(test, derive(Debug, PartialEq))]
+struct Minimum {
+    /// As written in the file, for the log.
+    version: String,
+    number: i64,
+    from: Option<DateTime<Utc>>,
+    /// TEXT with the minimum in place of %MIN%.
+    text: String,
+}
+
+impl MinController {
+    /// Reads the file the option names and starts reading it again every 10 seconds; without
+    /// the option, a handle that refuses nobody. `key_checked`: this server lets only
+    /// controllers with its key ask for a connection. Needs the tokio runtime.
+    pub(crate) fn start(key_checked: bool) -> Self {
+        let path = crate::common::get_arg(OPTION);
+        let path = path.trim();
+        if path.is_empty() {
+            return Self(None);
+        }
+        if !key_checked {
+            // TEXT may carry a link for the holders of the key; here anyone could ask for it
+            log::error!(
+                "min-controller file {}: this server checks no key (-k); no minimum is in force",
+                path
+            );
+            return Self(None);
+        }
+        let mut watcher = Watcher::new(PathBuf::from(path));
+        let shared = watcher.shared.clone();
+        let seen = read_file(&watcher.path);
+        watcher.look_and_log(seen);
+        tokio::spawn(watcher.run());
+        Self(Some(shared))
+    }
+
+    /// The answer to a punch hole request whose `version` is below the minimum in force, which
+    /// the controller's app shows as the reason; `None` when the request may go on.
+    pub(crate) fn refusal(
+        &self,
+        addr: SocketAddr,
+        id: &str,
+        version: &str,
+    ) -> Option<RendezvousMessage> {
+        let shared = self.0.as_ref()?;
+        let rule = shared.rule();
+        let Rule::On(minimum) = &*rule else {
+            return None;
+        };
+        // not Utc::now(), which panics on a clock set before 1970
+        if !minimum.refuses(version, SystemTime::now().into()) {
+            return None;
+        }
+        if shared.logs_this_refusal() {
+            log::info!(
+                "min-controller refused {} for {:?}: version {:?}",
+                addr,
+                head(id, LOGGED_ID_CHARS),
+                head(version, LOGGED_VERSION_CHARS)
+            );
+        }
+        let mut msg_out = RendezvousMessage::new();
+        msg_out.set_punch_hole_response(PunchHoleResponse {
+            other_failure: minimum.text.clone(),
+            ..Default::default()
+        });
+        Some(msg_out)
+    }
+}
+
+impl Shared {
+    fn rule(&self) -> Arc<Rule> {
+        // a poisoned lock still holds a whole rule: the writer only swaps the pointer
+        self.rule.read().unwrap_or_else(|e| e.into_inner()).clone()
+    }
+
+    fn set_rule(&self, rule: Arc<Rule>) {
+        *self.rule.write().unwrap_or_else(|e| e.into_inner()) = rule;
+    }
+
+    fn logs_this_refusal(&self) -> bool {
+        if self.logged.fetch_add(1, Ordering::Relaxed) < LOGGED_REFUSALS {
+            return true;
+        }
+        self.not_logged.fetch_add(1, Ordering::Relaxed);
+        false
+    }
+
+    /// Starts the next period of logged refusals and tells how many the last one left out.
+    fn next_log_period(&self) -> u64 {
+        self.logged.store(0, Ordering::Relaxed);
+        self.not_logged.swap(0, Ordering::Relaxed)
+    }
+}
+
+impl Minimum {
+    fn refuses(&self, version: &str, now: DateTime<Utc>) -> bool {
+        let started = match self.from {
+            Some(from) => now >= from,
+            None => true,
+        };
+        // a version that cannot be counted is 0, like an empty one
+        started && version_number(version).unwrap_or(0) < self.number
+    }
+}
+
+impl Rule {
+    fn describe(&self) -> String {
+        match self {
+            Rule::Off => "off".to_owned(),
+            Rule::On(minimum) => match minimum.from {
+                Some(from) => format!(
+                    "{} from {}",
+                    minimum.version,
+                    from.to_rfc3339_opts(SecondsFormat::AutoSi, true)
+                ),
+                None => format!("{} from now", minimum.version),
+            },
+        }
+    }
+}
+
+fn head(s: &str, chars: usize) -> String {
+    s.chars().take(chars).collect()
+}
+
+/// `hbb_common::get_version_number`, which is how the apps compare versions, made safe for what
+/// a stranger sends: `None` for an input that function overflows on (a panic in a debug build,
+/// a wrong number in a release build) and for one longer than any version.
+fn version_number(v: &str) -> Option<i64> {
+    if v.len() > MAX_VERSION_BYTES {
+        return None;
+    }
+    let mut parts = v.split('-');
+    let mut n: i64 = 0;
+    if let Some(dotted) = parts.next() {
+        let mut last = 0;
+        for x in dotted.split('.') {
+            last = x.parse::<i64>().unwrap_or(0);
+            n = n.checked_mul(1000)?.checked_add(last)?;
+        }
+        n = n.checked_sub(last)?.checked_add(last.checked_mul(10)?)?;
+    }
+    if let Some(patch) = parts.next() {
+        n = n.checked_add(patch.parse::<i64>().unwrap_or(0))?;
+    }
+    Some(n)
+}
+
+/// The number of a minimum written as exactly `x.y.z` without zeros in front, as the release
+/// tool, the apps and hjv-api write a version; `None` for anything else: `get_version_number`
+/// reads "1.6" as 1060, "v1.6.0" as 6000 and "1.5.100" as 1.6.0.
+fn parse_min_version(v: &str) -> Option<i64> {
+    let digits = |p: &str, most: usize| {
+        !p.is_empty()
+            && p.len() <= most
+            && p.bytes().all(|b| b.is_ascii_digit())
+            && (p == "0" || !p.starts_with('0'))
+    };
+    let mut parts = v.split('.');
+    let (x, y, z) = (parts.next()?, parts.next()?, parts.next()?);
+    if parts.next().is_some() || !digits(x, 3) || !digits(y, 3) || !digits(z, 2) {
+        return None;
+    }
+    version_number(v)
+}
+
+/// What is wrong with a refusal text, `None` if the apps show it as it is and stop there. The
+/// apps that are refused cannot be changed any more, so the text has to fit what they do with
+/// it (RustDesk 1.5.0's client.rs, lang.rs and flutter/lib/common.dart).
+fn text_problem(text: &str) -> Option<&'static str> {
+    if text.is_empty() {
+        return Some("is empty");
+    }
+    if text.chars().count() > MAX_TEXT_CHARS {
+        return Some("is longer than 2000 characters");
+    }
+    if text.chars().any(char::is_control) {
+        return Some("has a control character");
+    }
+    if !text.contains(REFUSAL_MARK) {
+        return Some(
+            "must contain \"version not allowed\": older apps ask again on a timer without \
+             \"not allowed\", and newer apps know the refusal by the whole phrase",
+        );
+    }
+    if text.starts_with("Failed") {
+        return Some("must not start with \"Failed\": the apps add \": Please try later\" to it");
+    }
+    if text.split(' ').next().is_some_and(|w| w.ends_with("_tip")) {
+        return Some("must not start with a word ending in \"_tip\": the apps translate it alone");
+    }
+    if text.contains(['{', '}']) {
+        return Some("must not have { or }: the apps take them for a translation placeholder");
+    }
+    if text.contains("RustDesk") {
+        return Some("must not name RustDesk: the apps put their own name there");
+    }
+    if has_placeholder(text) {
+        return Some("has a %NAME% left in it: only %MIN% is filled in");
+    }
+    if !urls_end_at_spaces(text) {
+        return Some(
+            "must have a space after each URL: the apps make a link of everything up to the \
+             next space",
+        );
+    }
+    None
+}
+
+/// Whether `text` has a word between two % signs, such as a misspelt %min%. Three letters or
+/// more: the two hex digits of a percent-encoded byte in a URL are none.
+fn has_placeholder(text: &str) -> bool {
+    let mut between: Vec<&str> = text.split('%').skip(1).collect();
+    // what follows the last % is not between two
+    between.pop();
+    between
+        .iter()
+        .any(|w| w.len() >= 3 && w.bytes().all(|b| b.is_ascii_alphabetic() || b == b'_'))
+}
+
+/// Whether each http(s) URL of `text` is followed by white space or the end. The apps link
+/// `https?://[^\s]+`, and a tap opens it without the `.,;!?` at its end: all of it up to the
+/// space has to be bytes of a URL, which those five are too.
+fn urls_end_at_spaces(text: &str) -> bool {
+    let mut rest = text;
+    loop {
+        let start = match (rest.find("http://"), rest.find("https://")) {
+            (Some(a), Some(b)) => a.min(b),
+            (Some(a), None) | (None, Some(a)) => a,
+            (None, None) => return true,
+        };
+        let url = &rest[start..];
+        let (url, after) = url.split_at(url.find(char::is_whitespace).unwrap_or(url.len()));
+        let is_url_byte = |b: u8| b.is_ascii_alphanumeric() || b"-._~:/?#@!$&*+,;=%".contains(&b);
+        if !url.bytes().all(is_url_byte) {
+            return false;
+        }
+        rest = after;
+    }
+}
+
+/// The rule a file's bytes ask for, or why they cannot be used, in words that are safe to log.
+fn parse(bytes: &[u8]) -> Result<Rule, String> {
+    let Ok(file) = std::str::from_utf8(bytes) else {
+        return Err("not UTF-8".to_owned());
+    };
+    let file = file.strip_prefix('\u{feff}').unwrap_or(file);
+    // a file caught half written must not pass for a shorter one, such as one with FROM= alone
+    if !file.is_empty() && !file.ends_with('\n') {
+        return Err("the last line has no line break (is it still being written?)".to_owned());
+    }
+    let (mut min, mut from, mut text) = (None, None, None);
+    for (i, line) in file.lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let n = i + 1;
+        let (key, value) = line.split_once('=').unwrap_or_default();
+        let slot = match key {
+            "MIN" => &mut min,
+            "FROM" => &mut from,
+            "TEXT" => &mut text,
+            // the release tool writes the key right before its "=", and reads no other line
+            _ if matches!(key.trim_end(), "MIN" | "FROM" | "TEXT") => {
+                return Err(format!("line {n} has a space before its ="));
+            }
+            _ => {
+                return Err(format!(
+                    "line {n} is neither a comment nor MIN=, FROM= or TEXT="
+                ))
+            }
+        };
+        if slot.is_some() {
+            return Err(format!("line {n} sets {key} a second time"));
+        }
+        *slot = Some((n, value.trim_start()));
+    }
+    let Some((min_line, min)) = min else {
+        return Err("no MIN= line (MIN= with nothing after it means no minimum)".to_owned());
+    };
+    if min.is_empty() {
+        return Ok(Rule::Off);
+    }
+    let Some(number) = parse_min_version(min) else {
+        return Err(format!("line {min_line}: MIN must be x.y.z, such as 1.6.0"));
+    };
+    let Some((from_line, from)) = from else {
+        return Err("no FROM= line (FROM= with nothing after it means at once)".to_owned());
+    };
+    let from = if from.is_empty() {
+        None
+    } else {
+        Some(parse_from(from).ok_or_else(|| {
+            format!("line {from_line}: FROM must be a UTC time written as 2026-11-22T15:00:00Z")
+        })?)
+    };
+    let Some((text_line, text)) = text else {
+        return Err("no TEXT= line".to_owned());
+    };
+    let text = text.replace("%MIN%", min);
+    if let Some(problem) = text_problem(&text) {
+        return Err(format!("line {text_line}: TEXT {problem}"));
+    }
+    Ok(Rule::On(Minimum {
+        version: min.to_owned(),
+        number,
+        from,
+        text,
+    }))
+}
+
+/// A time in the one form the release tool writes: `YYYY-MM-DDTHH:MM:SSZ`, years 0001-9999, no
+/// fraction, no leap second and no other offset than `Z`. hbbs reads what the tool reads, so the
+/// tool's `hbbs-conf --current` never stops at a file hbbs uses.
+fn parse_from(s: &str) -> Option<DateTime<Utc>> {
+    let b = s.as_bytes();
+    let form = b.len() == 20
+        && b[4] == b'-'
+        && b[7] == b'-'
+        && b[10] == b'T'
+        && b[13] == b':'
+        && b[16] == b':'
+        && b[19] == b'Z';
+    if !form {
+        return None;
+    }
+    let number = |at: usize, len: usize| {
+        let digits = b.get(at..at + len)?;
+        digits.iter().all(u8::is_ascii_digit).then(|| {
+            digits
+                .iter()
+                .fold(0u32, |n, d| n * 10 + u32::from(d - b'0'))
+        })
+    };
+    let year = i32::try_from(number(0, 4)?)
+        .ok()
+        .filter(|year| *year >= 1)?;
+    let date = NaiveDate::from_ymd_opt(year, number(5, 2)?, number(8, 2)?)?;
+    let time = NaiveTime::from_hms_opt(number(11, 2)?, number(14, 2)?, number(17, 2)?)?;
+    Some(date.and_time(time).and_utc())
+}
+
+/// What a look at the file finds.
+#[derive(PartialEq)]
+#[cfg_attr(test, derive(Debug))]
+enum Seen {
+    Missing,
+    /// There, but not readable as a rule file; why, in words that are safe to log.
+    Unusable(String),
+    Content(Vec<u8>),
+}
+
+fn read_file(path: &Path) -> Seen {
+    let failed = |err: std::io::Error| match err.kind() {
+        std::io::ErrorKind::NotFound => Seen::Missing,
+        _ => Seen::Unusable(format!("cannot be read: {err}")),
+    };
+    let meta = match std::fs::metadata(path) {
+        Ok(meta) => meta,
+        Err(err) => return failed(err),
+    };
+    // nothing that could block (a pipe) or never end (a device)
+    if !meta.is_file() {
+        return Seen::Unusable("not a regular file".to_owned());
+    }
+    let mut bytes = Vec::new();
+    let read = std::fs::File::open(path)
+        .and_then(|file| file.take(MAX_FILE_BYTES + 1).read_to_end(&mut bytes));
+    match read {
+        Ok(_) if bytes.len() as u64 > MAX_FILE_BYTES => {
+            Seen::Unusable("larger than 64 KiB".to_owned())
+        }
+        Ok(_) => Seen::Content(bytes),
+        Err(err) => failed(err),
+    }
+}
+
+/// Follows the file: every look that finds something new sets the rule and says so once, and a
+/// file that cannot be used is said again every hour while it stays.
+struct Watcher {
+    path: PathBuf,
+    last: Option<Seen>,
+    /// while `last` cannot be used: what was said of it, and the looks since
+    trouble: Option<(String, u32)>,
+    rule: Arc<Rule>,
+    shared: Arc<Shared>,
+}
+
+impl Watcher {
+    fn new(path: PathBuf) -> Self {
+        let rule = Arc::new(Rule::Off);
+        Self {
+            path,
+            last: None,
+            trouble: None,
+            rule: rule.clone(),
+            shared: Arc::new(Shared {
+                rule: RwLock::new(rule),
+                logged: AtomicU64::new(0),
+                not_logged: AtomicU64::new(0),
+            }),
+        }
+    }
+
+    /// Takes in what a look found; what to log about it, if it is news or a trouble that an hour
+    /// of looks has not seen put right.
+    fn look(&mut self, seen: Seen) -> Option<(log::Level, String)> {
+        if self.last.as_ref() == Some(&seen) {
+            // the rule in force may be one that the next start of hbbs drops: said again
+            let (line, looks) = self.trouble.as_mut()?;
+            *looks += 1;
+            if *looks < REPEAT_LOOKS {
+                return None;
+            }
+            *looks = 0;
+            return Some((log::Level::Error, line.clone()));
+        }
+        let first = self.last.is_none();
+        let path = self.path.display();
+        let found = match &seen {
+            Seen::Missing => Ok((Rule::Off, format!("min-controller off: no file {path}"))),
+            Seen::Unusable(why) => Err(why.clone()),
+            Seen::Content(bytes) => parse(bytes).map(|rule| {
+                let line = match &rule {
+                    Rule::Off => format!("min-controller off: MIN is empty in {path}"),
+                    Rule::On(_) => format!("min-controller {}", rule.describe()),
+                };
+                (rule, line)
+            }),
+        };
+        let event = match found {
+            Ok((rule, line)) => {
+                self.rule = Arc::new(rule);
+                self.shared.set_rule(self.rule.clone());
+                self.trouble = None;
+                // a file that was never there is the state without this option: no word of it
+                let level = match (&seen, first) {
+                    (Seen::Missing, true) => log::Level::Debug,
+                    _ => log::Level::Info,
+                };
+                (level, line)
+            }
+            Err(why) => {
+                let kept = match &*self.rule {
+                    Rule::Off => "no minimum is in force".to_owned(),
+                    Rule::On(_) => {
+                        format!("min-controller {} stays in force", self.rule.describe())
+                    }
+                };
+                let line = format!("min-controller file {path}: {why}; {kept}");
+                self.trouble = Some((line.clone(), 0));
+                (log::Level::Error, line)
+            }
+        };
+        self.last = Some(seen);
+        Some(event)
+    }
+
+    fn look_and_log(&mut self, seen: Seen) {
+        if let Some((level, line)) = self.look(seen) {
+            log::log!(level, "{}", line);
+        }
+    }
+
+    async fn run(mut self) {
+        let mut timer = tokio::time::interval(Duration::from_secs(RELOAD_SECS));
+        timer.set_missed_tick_behavior(MissedTickBehavior::Delay);
+        // the first tick is at once, and start() has just looked
+        timer.tick().await;
+        loop {
+            timer.tick().await;
+            let not_logged = self.shared.next_log_period();
+            if not_logged > 0 {
+                log::warn!(
+                    "min-controller refused {} more in the last {} seconds",
+                    not_logged,
+                    RELOAD_SECS
+                );
+            }
+            let path = self.path.clone();
+            let seen = match tokio::task::spawn_blocking(move || read_file(&path)).await {
+                Ok(seen) => seen,
+                // the runtime is shutting down
+                Err(err) if err.is_cancelled() => return,
+                Err(_) => Seen::Unusable("cannot be read".to_owned()),
+            };
+            self.look_and_log(seen);
+        }
+    }
+}
