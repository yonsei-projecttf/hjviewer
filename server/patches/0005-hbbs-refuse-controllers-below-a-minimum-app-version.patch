+#[test]
+fn an_outdated_controller_is_refused_before_the_peer_hears_of_it() {
+    let server = Hbbs::start("refuse", Told::Env, Some(conf("1.6.0", "", S1).as_bytes()));
+    let text = S1.replace("%MIN%", "1.6.0");
+    assert_apps_show_it_as_it_is(&text);
+    runtime().block_on(async {
+        let mut peer = registered_peer(&server).await;
+        for (i, version) in ["1.5.1", "1.5.0", "", "1.5.1+120", "1.4.3"]
+            .iter()
+            .enumerate()
+        {
+            let mut controller =
+                Client::connect(&server, &format!("198.51.100.20:{}", 50001 + i)).await;
+            controller
+                .send(punch_hole_request(PEER_ID, &server.key, version))
+                .await;
+            assert_eq!(
+                controller.expect_refused().await,
+                text,
+                "version {version:?}"
+            );
+            peer.expect_silence().await;
+        }
+        // whether the ID exists does not show
+        assert_eq!(refusal(&server, "1.5.1").await.as_deref(), Some(&text[..]));
+        // the minimum itself and anything newer go through as before
+        for (i, version) in ["1.6.0", "1.6.1", "1.10.0", "2.0.0"].iter().enumerate() {
+            let mut controller =
+                Client::connect(&server, &format!("198.51.100.30:{}", 50001 + i)).await;
+            controller
+                .send(punch_hole_request(PEER_ID, &server.key, version))
+                .await;
+            let rendezvous_message::Union::PunchHole(ph) = peer.recv().await else {
+                panic!("expected the punch hole for {version}");
+            };
+            assert!(ph.force_relay);
+            controller.expect_silence().await;
+        }
+        // the log says what is in force and who was refused, and nothing of TEXT and its link
+        let line = server
+            .wait_for_line(
+                "min-controller refused 198.51.100.20:50004 ",
+                Duration::from_secs(5),
+            )
+            .await;
+        assert!(line.contains("] INFO ["), "{line}");
+        assert!(
+            line.ends_with(r#"for "123456789": version "1.5.1+120""#),
+            "{line}"
+        );
+        let lines = server.wait_for_lines(1 + 6).await;
+        assert_eq!(
+            lines.len(),
+            1 + 6,
+            "what is in force and six refusals: {lines:?}"
+        );
+        assert!(lines[0].contains("] INFO ["), "{lines:?}");
+        assert!(
+            lines[0].ends_with("] min-controller 1.6.0 from now"),
+            "{lines:?}"
+        );
+        let log = server.log();
+        for secret in [LINK_CODE, "rd.example.com", "TestFlight", "업데이트"] {
+            assert!(!log.contains(secret), "{secret} in the log");
+        }
+    });
+}
