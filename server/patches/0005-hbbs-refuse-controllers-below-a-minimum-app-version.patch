+#[test]
+fn a_bad_file_at_the_start_leaves_hbbs_running_without_a_minimum() {
+    let bad: [(&str, Vec<u8>, &str); 9] = [
+        (
+            "bad-two-fields",
+            conf("1.6", "", S2).into(),
+            "line 2: MIN must be x.y.z, such as 1.6.0",
+        ),
+        (
+            "bad-word",
+            conf("latest", "", S2).into(),
+            "line 2: MIN must be x.y.z, such as 1.6.0",
+        ),
+        (
+            "bad-time",
+            conf("1.6.0", "2026-11-23", S2).into(),
+            "line 3: FROM must be a UTC time written as 2026-11-22T15:00:00Z",
+        ),
+        (
+            "bad-offset",
+            conf("1.6.0", "2026-11-23T00:00:00+09:00", S2).into(),
+            "line 3: FROM must be a UTC time written as 2026-11-22T15:00:00Z",
+        ),
+        (
+            "bad-text",
+            conf("1.6.0", "", "Update to %MIN%.").into(),
+            "line 4: TEXT must contain",
+        ),
+        (
+            "bad-placeholder",
+            conf("1.6.0", "", "Update to %min%. (version not allowed)").into(),
+            "line 4: TEXT has a %NAME% left in it",
+        ),
+        (
+            "bad-no-from",
+            b"MIN=1.6.0\nTEXT=x (version not allowed)\n".to_vec(),
+            "no FROM= line",
+        ),
+        (
+            "bad-cut",
+            b"MIN=1.6.0\nTEXT=x (version not allowed)\nFROM=".to_vec(),
+            "the last line has no line break",
+        ),
+        (
+            "bad-binary",
+            b"MIN=1.6.0\nFROM=\nTEXT=\xff\xfe (version not allowed)\n".to_vec(),
+            "not UTF-8",
+        ),
+    ];
+    let mut last = None;
+    for (name, file, why) in &bad {
+        let server = Hbbs::start(name, Told::Env, Some(file.as_slice()));
+        runtime().block_on(async {
+            let line = server.wait_for_line(why, Duration::from_secs(5)).await;
+            assert!(line.contains("] ERROR ["), "{line}");
+            assert!(line.contains("] min-controller file "), "{line}");
+            assert!(line.ends_with("; no minimum is in force"), "{line}");
+            assert_eq!(refusal(&server, "1.0.0").await, None, "{name}");
+            assert_eq!(refusal(&server, "").await, None, "{name}");
+        });
+        last = Some(server);
+    }
+    let server = last.expect("the last server");
+    runtime().block_on(async {
+        // hbbs has read the file again by now, and says the same trouble once
+        sleep(RELOAD + SLACK).await;
+        let lines = server.min_controller_lines();
+        assert_eq!(lines.len(), 1, "{lines:?}");
+        // the file put right takes effect without a restart
+        server.write_conf(&conf("1.6.0", "", S2));
+        let (_, took) = until_refused(&server, "1.5.1", true).await;
+        assert!(took < RELOAD + SLACK, "{took:?}");
+    });
+}
