+// HJViewer: the rule of hbbs's validate_relay_uuid. The uuid is a key of the waiting list and
+// goes into the log, and every client sends a v4 UUID.
+fn valid_relay_uuid(uuid: &str) -> bool {
+    uuid.len() <= 128
+        && uuid
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+}
