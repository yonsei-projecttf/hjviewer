+#[test]
+fn an_id_a_client_sends_goes_into_the_log_escaped_on_one_line() {
+    let server = Hbbs::start("logged-ids", &[]);
+    runtime().block_on(async {
+        const FORGED: &str = "\nFORGED ERROR line of its own";
+        // a punch hole request with the wrong key, which needs neither key nor ticket
+        let mut controller = Client::connect(&server, "198.51.100.50", Some(50050)).await;
+        let mut msg = punch_hole_request(&server);
+        msg.mut_punch_hole_request().licence_key = "not-the-key".to_owned();
+        msg.mut_punch_hole_request().id = format!("100000{FORGED}");
+        controller.send(msg).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::LICENSE_MISMATCH)
+        );
+        server
+            .wait_wrote(b"for peer \"100000\\nFORGED ERROR line of its own\" - invalid key")
+            .await;
+        // one longer than any ID is answered as no such ID, before anything logs it
+        let long_id = marker("long-punch-id", 254);
+        let mut msg = punch_hole_request(&server);
+        msg.mut_punch_hole_request().licence_key = "not-the-key".to_owned();
+        msg.mut_punch_hole_request().id = long_id.clone();
+        controller.send(msg).await;
+        let rendezvous_message::Union::PunchHoleResponse(res) = controller.recv().await else {
+            panic!("expected a punch hole response");
+        };
+        assert_eq!(
+            res.failure.enum_value(),
+            Ok(punch_hole_response::Failure::ID_NOT_EXIST)
+        );
+        // and so is a relay request for one, whose connection ends
+        let mut relay = Client::connect(&server, "198.51.100.51", Some(50051)).await;
+        let mut msg = RendezvousMessage::new();
+        msg.set_request_relay(RequestRelay {
+            id: marker("long-relay-id", 254),
+            uuid: "01890a5d-ac96-774b-bcce-b302099a8057".to_owned(),
+            licence_key: server.key.clone(),
+            ..Default::default()
+        });
+        relay.send(msg).await;
+        assert!(
+            relay.closed_unanswered().await,
+            "hbbs took the relay request"
+        );
+
+        // a registration, which only bounds the ID's length, and one with another uuid
+        let id = format!("100001{FORGED}");
+        let mut pc = Client::connect(&server, "203.0.113.50", Some(40050)).await;
+        assert_eq!(
+            register(&mut pc, &id, b"peer-uuid", &[7u8; 32]).await,
+            register_pk_response::Result::OK
+        );
+        let mut other = Client::connect(&server, "203.0.113.51", Some(40051)).await;
+        assert_eq!(
+            register(&mut other, &id, b"other-uuid", &[8u8; 32]).await,
+            register_pk_response::Result::UUID_MISMATCH
+        );
+        server
+            .wait_wrote(b"update_pk \"100001\\nFORGED ERROR line of its own\" ")
+            .await;
+        server
+            .wait_wrote(b"Peer \"100001\\nFORGED ERROR line of its own\" uuid mismatch")
+            .await;
+
+        // A real ID stays as it is, which the operator's checks grep for.
+        let mut real = Client::connect(&server, "203.0.113.52", Some(40052)).await;
+        assert_eq!(
+            register(&mut real, PEER_ID, b"real-uuid", &[9u8; 32]).await,
+            register_pk_response::Result::OK
+        );
+        server
+            .wait_wrote(format!("update_pk {PEER_ID} ").as_bytes())
+            .await;
+        let log = server.log();
+        assert!(
+            !log.contains("\nFORGED"),
+            "a line of the client's own:\n{log}"
+        );
+        for refused in ["long-punch-id", "long-relay-id"] {
+            assert!(!log.contains(refused), "hbbs logged {refused}");
+        }
+    });
