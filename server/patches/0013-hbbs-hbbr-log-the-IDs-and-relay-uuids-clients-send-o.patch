+/// HJViewer: a value a client sent, as a log line shows it: as it is when it is printable ASCII
+/// without spaces and at most 64 characters, as every real ID is, else quoted with Rust's escapes
+/// and cut at 64 characters. So no client can start a line of its own (journald makes each line
+/// an entry, which the operator's checks read) or make one of any length.
+#[allow(dead_code)]
+pub(crate) fn logged(value: &str) -> String {
+    const CHARS: usize = 64;
+    if !value.is_empty() && value.len() <= CHARS && value.bytes().all(|b| b.is_ascii_graphic()) {
+        value.to_owned()
+    } else {
+        format!("{:?}", value.chars().take(CHARS).collect::<String>())
+    }
+}
