+impl Hbbr {
+    /// Waits until hbbr's log, written asynchronously, holds `needle`; the log then.
+    async fn wait_logged(&self, needle: &str) -> String {
+        for _ in 0..50 {
+            let log = std::fs::read_to_string(self.dir.join("hbbr.log")).unwrap_or_default();
+            if log.contains(needle) {
+                return log;
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+        panic!("hbbr did not log {needle:?} within 5s");
+    }
+}
