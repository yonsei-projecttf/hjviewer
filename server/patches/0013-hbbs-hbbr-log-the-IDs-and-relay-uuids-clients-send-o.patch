+#[test]
+fn a_uuid_no_client_sends_is_refused_before_it_is_logged() {
+    let relay = Hbbr::start("uuid");
+    tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime")
+        .block_on(async {
+            // a line break, which would start a log line of the client's own, and a uuid
+            // longer than any
+            for uuid in [
+                "pair\nFORGED ERROR line of its own".to_owned(),
+                "u".repeat(129),
+            ] {
+                let mut ws = half(relay.port, uuid.clone()).await;
+                let got = timeout(Duration::from_secs(5), ws.next()).await;
+                assert!(
+                    matches!(
+                        got,
+                        Ok(None) | Ok(Some(Err(_))) | Ok(Some(Ok(WsMessage::Close(_))))
+                    ),
+                    "hbbr kept the connection of uuid {uuid:?}: {got:?}"
+                );
+                let log = relay
+                    .wait_logged(&format!("Invalid relay UUID (length {})", uuid.len()))
+                    .await;
+                assert!(!log.contains("FORGED"), "{log}");
+                assert!(!log.contains(&"u".repeat(129)), "{log}");
+            }
+            // what clients send still pairs
+            let uuid = "e4c181d0-41c7-4ae6-8ef0-36581b6b2b12".to_owned();
+            let (mut a, mut b) =
+                tokio::join!(half(relay.port, uuid.clone()), half(relay.port, uuid));
+            a.send(WsMessage::Binary(b"ping".to_vec().into()))
+                .await
+                .expect("send through the relay");
+            let got = timeout(Duration::from_secs(3), b.next()).await;
+            assert!(
+                matches!(&got, Ok(Some(Ok(WsMessage::Binary(p)))) if p.as_ref() == b"ping"),
+                "not relayed: {got:?}"
+            );
+        });
+}
