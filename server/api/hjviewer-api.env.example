# /etc/hjviewer/hjviewer-api.env: settings of hjviewer-api.service (hjv-api). None is secret; the
# secrets are systemd credentials (README.md). Unknown HJV_API_ names stop hjv-api at start, so a
# typo does not go unnoticed. After a change: sudo systemctl restart hjviewer-api

# The Yonsei SSO (D2: the same service registration as the WordPress plugin's login). Plain http
# is accepted only for 127.0.0.1, where the tests run their fake SSO.
HJV_API_SSO_TOKEN_URL=https://sso.example.ac.kr/oauth/token.do
HJV_API_SSO_USERINFO_URL=https://sso.example.ac.kr/api/findByApiUuid.do
HJV_API_SSO_CLIENT_ID=
# connecting may take 3 s, a whole login check 8 s (design v2 §9-2 step 9)
#HJV_API_SSO_CONNECT_TIMEOUT_MS=3000
#HJV_API_SSO_TIMEOUT_MS=8000

# hbbs's loopback console, which answers hjv-pk with patch 0004
#HJV_API_HBBS_CONSOLE=127.0.0.1:21115
# hbbs's public key: the text of its id_ed25519.pub, the key the apps are built with. hbbs signs
# its hjv-pk answers with it, so that no other program on the console's port can hand out device
# keys. Not secret. Without it logins work, but no PC is added to an account.
HJV_API_HBBS_PUBKEY=

# where /api/hjv/source sends people for the source code (AGPL section 13)
#HJV_API_SOURCE_URL=https://github.com/yonsei-projecttf/hjviewer

# Login limits, as <count>/<seconds>[,<count>/<seconds>]: failed logins per client address (an
# IPv6 address counts by its /64), per portal ID (every ID typed, on the list or not), and per
# portal ID from the PCs already in that account (one limit for all of them); successful logins per
# account and per client address; SSO calls of all accounts together, of which one account may
# take a quarter. Wrong passwords reach the SSO at most LIMIT_ID + LIMIT_BOUND times per ID: keep
# that sum, together with the WordPress plugin's limit for the same IDs, below the portal's lockout.
#HJV_API_LIMIT_IP=10/600
#HJV_API_LIMIT_ID=3/600,5/86400
#HJV_API_LIMIT_BOUND=3/600,5/86400
#HJV_API_LIMIT_OK_ID=10/3600,30/86400
#HJV_API_LIMIT_OK_IP=30/3600
#HJV_API_LIMIT_SSO=20/60
# With HJV_API_LOGIN=open every portal ID reaches the SSO, so a portal ID that is not on the
# allowlist (nobody registered it yet) has lower limits: its failed logins (instead of
# LIMIT_ID), and the SSO calls of all such IDs together (one window, besides LIMIT_SSO, of which
# one ID and one client address hold a quarter each; a first login that goes through gives its
# call back). They keep the login from becoming a way to try passwords on every Yonsei account or
# to lock it; when the second is full, first logins fail for a while and the five-minute check
# alarms (sso_new). The user decides these numbers; an ID imported ahead (allow import) is not
# held by them.
#HJV_API_LIMIT_NEW_ID=2/86400
#HJV_API_LIMIT_SSO_NEW=10/3600

# Keeping times in days: tokens unused / at most, accounts unused, devices not seen, login records
#HJV_API_TOKEN_IDLE_DAYS=90
#HJV_API_TOKEN_MAX_DAYS=365
#HJV_API_ACCOUNT_DAYS=365
#HJV_API_DEVICE_UNSEEN_DAYS=180
#HJV_API_EVENT_DAYS=183

# Sealed passwords: how far the app's clock may be off (seconds), and how long the very same login
# request, or signed account request that changes something, sent again gets the first answer
# (seconds)
#HJV_API_SEAL_MAX_SKEW=600
#HJV_API_RETRY_WINDOW=30

# Every failed login is answered this long after the request, give or take the jitter; longer
# while the SSO is slow, so that failures with and without an SSO call take as long
#HJV_API_FAILURE_DELAY_MS=2000
#HJV_API_FAILURE_JITTER_MS=500

# The deviceInfo.os values whose installed apps are added to the account at login (D10)
#HJV_API_BIND_OS=windows

# The second factor before the SSO call (D11, U1): off, and this version has nothing else
#HJV_API_SECOND_FACTOR=off

# Who may log in: open, everyone the Yonsei SSO accepts (the university's faculty and staff), a
# portal ID not on the allowlist being put on it at its first login; or list, only the IDs on the
# allowlist (imported, or registered by a login before), as at first, for an incident or a later
# decision. In either mode an entry the operator blocked (hjv-api admin block) keeps its account
# out. selfcheck and report say which mode runs.
#HJV_API_LOGIN=open

# Logins handled at the same time; more are refused at once
#HJV_API_MAX_LOGINS=64

# The university's address networks, comma-separated (such as 192.0.2.0/24,2001:db8::/32): a
# login from one of them shows as "on campus" on the account's other devices, from elsewhere as
# "off campus" (design v3 §1-1). Empty: not told apart. The address itself is never stored.
HJV_API_CAMPUS_NETS=

# The connections a device logged in to the same account may open on its PCs without the PC's
# password (U3): remote, file, camera, terminal. Port forwarding and RDP always ask for it.
#HJV_API_PASSWORDLESS_KINDS=remote,file,camera

# The super operators (최고운영자): portal IDs, comma-separated, whose accounts see in the app who
# uses the service and the PCs in accounts with their names and addresses, read-only (README.md,
# Admin overview); every look goes to the operator record and the journal. Write a real ID only
# into the server's own copy of this file (/etc/hjviewer/hjviewer-api.env), never into the
# repository: here only a test ID such as 2026000001 (the fake SSO's). Empty: nobody. It takes
# effect at the next restart; hjv-api admin operators shows whether each one has an account.
HJV_API_OPERATORS=
# In that view an account is active when one of its account keys or PCs was used within this many
# days (1 to 365)
#HJV_API_ACTIVE_DAYS=30

# Trust lists (design v3 §3-6, §5-3): the list key signs, for each bound PC that asks, the account
# keys that may open it without its password. HJV_API_LIST_KID is the number of the key in the
# credential hjviewer-api-list-key (1; 2 after a change of keys); HJV_API_TRUST_PUBKEYS must be the
# value the apps were built with (their HJV_TRUST_PUBKEYS, <kid>:<base64>,<kid>:<base64>): selfcheck
# compares the key in use with it and prints the fingerprints to compare with the build's summary.
# Not secret.
#HJV_API_LIST_KID=1
HJV_API_TRUST_PUBKEYS=
# How often a bound PC asks (seconds; the PCs hold it to 5-300, production 60-300) and how long a
# list lives when the PC cannot reach hjv-api (U4: a day; at most 259200, 72 hours, the apps' bound)
#HJV_API_TRUST_REFRESH=120
#HJV_API_TRUST_TTL=86400

# Wake-on-LAN through NAS relays (design v3 §8, relay/PROTOCOL.md §3.2): the command key signs each
# wake command, and a relay takes only commands signed by a key its build pins. HJV_API_COMMAND_KID
# is the number of the key in the credential hjviewer-api-command-key (1; 2 after a change of
# keys); HJV_API_COMMAND_PUBKEYS must be the value the relays were built with (their
# HJV_COMMAND_PUBKEY, <kid>:<base64>,<kid>:<base64>): selfcheck compares the key in use with it and
# prints the fingerprints to compare with the relay build's summary. Not secret.
#HJV_API_COMMAND_KID=1
HJV_API_COMMAND_PUBKEYS=
