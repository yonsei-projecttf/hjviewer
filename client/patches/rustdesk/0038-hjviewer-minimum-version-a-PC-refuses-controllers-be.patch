+    /// The deadline of the vectors' policy, from which on its minimums hold, and the second before.
+    const AFTER: u64 = GRACE as u64;
+    const BEFORE: u64 = GRACE as u64 - 1;
+    const L1: &str = "이 PC는 HJViewer 1.6.0 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요(지금 버전 1.5.1). (version not allowed)";
+    const L2: &str = "이 PC는 HJViewer 1.6.0 이상에서만 연결을 받습니다. iPhone의 TestFlight 앱에서 HJViewer를 업데이트한 뒤 다시 연결하세요. (version not allowed)";
+
+    /// A process on `os` that holds `policy`, as the server gave it signed with signing key 1.
+    fn holding(test: &str, os: Os, e2e: bool, policy: &str) -> (TempFile, Core) {
+        let file = TempFile::new(test, store::FILE);
+        let mut core = Core::open(pins(), file.0.clone(), os, e2e);
+        core.begin(Kind::Regular, 0).unwrap();
+        let reply = Reply {
+            status: 200,
+            date: None,
+            body: envelope(1, &SIGNING_1, policy, None).into_bytes(),
+        };
+        assert_eq!(
+            core.finish(Ok(reply), ISSUED as u64, 0, 0),
+            Outcome::Updated
+        );
+        (file, core)
+    }
+
+    fn login(version: &str, my_platform: &str) -> LoginRequest {
+        LoginRequest {
+            version: version.to_owned(),
+            my_platform: my_platform.to_owned(),
+            ..Default::default()
+        }
+    }
+
+    /// What the process answers a login with at the time `wall`, as `refuse_controller` asks it.
+    fn answer(core: &Core, version: &str, my_platform: &str, wall: u64) -> Option<String> {
+        let rule_of = |platform: &str| core.controller_rule(platform, wall);
+        refusal(&login(version, my_platform), rule_of, core.e2e, Host::Pc)
+    }
+
+    fn rule(min: &str, enforced: bool) -> Option<ControllerRule> {
+        Some(ControllerRule {
+            min: min.to_owned(),
+            min_number: hbb_common::get_version_number(min),
+            enforced,
+        })
+    }
+
+    /// `get_version_number` in numbers that cannot overflow: None where the result is beyond i64.
+    fn exact(version: &str) -> Option<i64> {
+        if version.len() > MAX_VERSION_BYTES {
+            return None;
+        }
+        let part = |x: &str| i128::from(x.parse::<i64>().unwrap_or(0));
+        let mut parts = version.split('-');
+        let (mut n, mut last) = (0i128, 0i128);
+        for x in parts.next().unwrap_or_default().split('.') {
+            last = part(x);
+            n = n.checked_mul(1000)?.checked_add(last)?;
+        }
+        let n = n
+            .checked_sub(last)?
+            .checked_add(last.checked_mul(10)?)?
+            .checked_add(parts.next().map_or(0, part))?;
+        i64::try_from(n).ok()
+    }
+
+    #[test]
+    fn versions_count_as_the_apps_count_them() {
+        // the numbers of the design's research (version-exchange, section 2)
+        for (version, number) in [
+            ("1.5.0", 1_005_000),
+            ("1.5.1", 1_005_010),
+            ("1.6.0", 1_006_000),
+            ("1.4.3", 1_004_030),
+            ("", 0),
+            ("1.5.1+123", 1_005_000),
+            ("1.5.1.123", 1_005_002_230),
+            ("1.5.1-2", 1_005_012),
+            ("1.5.1-ios", 1_005_010),
+            ("1.6", 1_060),
+            ("v1.6.0", 6_000),
+            ("1.5.1 ", 1_005_000),
+            ("1.5.100", 1_006_000),
+            ("1.10.0", 1_010_000),
+            ("1.9.9", 1_009_090),
+        ] {
+            assert_eq!(version_number(version), number, "{version:?}");
+            assert_eq!(hbb_common::get_version_number(version), number);
+        }
+        // whatever a stranger sends: the same number as the apps', or 0 where theirs overflows
+        let mut seed = 0x2545_f491_4f6c_dd1du64;
+        let mut next = move || {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            seed
+        };
+        let alphabet: Vec<char> = "0123456789......-+ v９".chars().collect();
+        let (mut counted_ones, mut overflowing) = (0, 0);
+        for _ in 0..20_000 {
+            let length = next() % 40;
+            let version: String = (0..length)
+                .map(|_| alphabet[(next() % alphabet.len() as u64) as usize])
+                .collect();
+            let expected = exact(&version);
+            assert_eq!(counted(&version), expected, "{version:?}");
+            match expected {
+                Some(number) => {
+                    assert_eq!(hbb_common::get_version_number(&version), number);
+                    assert!(number >= 0);
+                    counted_ones += 1;
+                }
+                None => {
+                    assert_eq!(version_number(&version), 0, "{version:?}");
+                    overflowing += 1;
+                }
+            }
+        }
+        assert!(
+            counted_ones > 1000 && overflowing > 1000,
+            "{counted_ones} {overflowing}"
+        );
+        // at the edges of what a number holds
+        for (version, number) in [
+            ("922337203685477580", Some(9_223_372_036_854_775_800)),
+            ("922337203685477581", None),
+            ("9223372036854775807", None),
+            ("9223372036854775808", Some(0)),
+            ("9223372036854775.80", Some(9_223_372_036_854_775_800)),
+            ("9223372036854775.81", None),
+            ("9223372036854776.0", None),
+            ("9.0.0.0.0.0.0", Some(9_000_000_000_000_000_000)),
+            ("10.0.0.0.0.0.0", None),
+            ("9.223.372.036.854.775.80", Some(9_223_372_036_854_775_800)),
+            ("9.223.372.036.854.775.81", None),
+            ("0-9223372036854775807", Some(i64::MAX)),
+            ("0.1-9223372036854775807", None),
+        ] {
+            assert_eq!(counted(version), number, "{version}");
+            assert_eq!(exact(version), number, "{version}");
+        }
+        // longer than any version: not counted, however small its number would be
+        let long = format!("1.6.0{}", " ".repeat(60));
+        assert_eq!((long.len(), counted(&long)), (65, None));
+        assert_eq!(counted(&long[..64]), Some(1_006_000));
+        assert_eq!(version_number(&"9".repeat(1_000_000)), 0);
+    }
+
+    /// `refusal` with the rule given: below `min_number`, while the rule blocks anyone at all.
+    #[test]
+    fn a_controller_below_the_rule_is_refused() {
+        let windows = |rule: Option<ControllerRule>, version: &str| {
+            refusal(&login(version, "Windows"), |_| rule, false, Host::Pc)
+        };
+        assert_eq!(windows(rule("1.6.0", true), "1.5.1").as_deref(), Some(L1));
+        // at the minimum and above it
+        for version in ["1.6.0", "1.6.1", "1.10.0", "2.0.0", "1.6.0-1", "1.6.0.0"] {
+            assert_eq!(windows(rule("1.6.0", true), version), None, "{version}");
+        }
+        // below it: also what does not count as a version at all
+        for version in [
+            "1.5.99",
+            "1.5.1",
+            "1.5.0",
+            "0.0.1",
+            "",
+            "1.6",
+            "v1.6.0",
+            "1.5.1 ",
+            "abc",
+            "99999999999999999999.0.0",
+            "10.0.0.0.0.0.0",
+        ] {
+            let text = windows(rule("1.6.0", true), version);
+            assert!(
+                text.is_some_and(|text| problem(&text).is_none()),
+                "{version:?}"
+            );
+        }
+        // a rule that blocks nobody (a grace period from 0.0.0) refuses nobody, nor no rule
+        assert_eq!(windows(rule("1.6.0", false), "1.5.1"), None);
+        assert_eq!(windows(rule("1.6.0", false), ""), None);
+        assert_eq!(windows(None, "1.5.1"), None);
+        assert_eq!(windows(None, ""), None);
+        // a minimum nobody is below
+        assert_eq!(windows(rule("0.0.0", true), ""), None);
+        // the text is the platform's
+        let of = |my_platform: &str, e2e| {
+            let rule_of = |_: &str| rule("1.6.0", true);
+            refusal(&login("1.5.1", my_platform), rule_of, e2e, Host::Pc)
+        };
+        assert_eq!(of("Unknown: iOS", false).as_deref(), Some(L2));
+        assert_eq!(
+            of("Android", false).as_deref(),
+            Some(
+                L1.replace(
+                    "1.5.1). ",
+                    "1.5.1). Play 스토어에서 설치했다면 Play 스토어에서 업데이트하세요. "
+                )
+                .as_str()
+            )
+        );
+        // a platform that is not checked gets no text, whatever rule were given with it
+        for other in ["Linux", "Mac OS", "", "Windows 11", "Unknown: FreeBSD"] {
+            assert_eq!(of(other, false), None, "{other:?}");
+        }
+        assert_eq!(of("Linux", true).as_deref(), Some(L1));
+        // a minimum that is no policy's `x.y.z` is no rule to refuse by
+        for min in ["1.6", "", "1.6.0 https://rd.example.com/", "{1.6.0}"] {
+            let odd = Some(ControllerRule {
+                min: min.to_owned(),
+                min_number: 1_006_000,
+                enforced: true,
+            });
+            assert_eq!(windows(odd, "1.5.1"), None, "{min:?}");
+        }
+    }
