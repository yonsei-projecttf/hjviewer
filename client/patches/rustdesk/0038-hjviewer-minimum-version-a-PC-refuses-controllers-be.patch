+//! The PC's side of the minimum version: a controller whose app is below the minimum of its
+//! platform is refused when it logs in.
+//!
+//! The connection asks here right after the ID whitelist, before it looks at the permissions, the
+//! connection window, the password or a login by account key, and again when switched sides come
+//! back. So this also holds a controller that came by IP address, past hbbs, and a newer app
+//! that could not get the policy and so did not hold itself back.
+//!
+//! The policy is the one this process holds: a process that takes connections asks the server by
+//! itself (`start_service_checks`). Without a policy, or without an entry for the controller's
+//! platform, nobody is refused, and platforms other than Windows, Android and iOS are not looked
+//! at. Before a minimum's deadline only a controller below the version its grace period starts
+//! at is refused, and of the two Android entries only what both block.
+//!
+//! A login that was refused makes the process ask the server again, within the limits of checks
+//! nobody waits for. The process asks by itself only every six hours, and a minimum that was set
+//! too high by mistake and taken back would refuse everyone until then, on a PC with nobody at it
+//! to start the service again.
+//!
+//! The version is what the controller says it is: this makes an honest app update, it is no
+//! access control.
+
+use super::{fetch::Kind, policy::Version, texts, verdict, ControllerRule};
+use base::message_proto::LoginRequest;
+use std::time::Duration;
+
+/// No app's version is this long; a longer one is not counted.
+const MAX_VERSION_BYTES: usize = 64;
+/// How much of what the controller sent a log line shows.
+const LOGGED_CHARS: usize = 32;
+const LOG_INTERVAL: Duration = Duration::from_secs(60);
+
+/// `hbb_common::get_version_number`, which is how the apps and hbbs compare versions, for what a
+/// stranger sent: None where that function overflows (a panic in a debug build, a wrong number in
+/// a release build) and for a text longer than any version.
+fn counted(version: &str) -> Option<i64> {
+    if version.len() > MAX_VERSION_BYTES {
+        return None;
+    }
+    let mut parts = version.split('-');
+    let mut n: i64 = 0;
+    if let Some(dotted) = parts.next() {
+        let mut last = 0;
+        for x in dotted.split('.') {
+            last = x.parse::<i64>().unwrap_or(0);
+            n = n.checked_mul(1000)?.checked_add(last)?;
+        }
+        n = n.checked_sub(last)?.checked_add(last.checked_mul(10)?)?;
+    }
+    if let Some(patch) = parts.next() {
+        n = n.checked_add(patch.parse::<i64>().unwrap_or(0))?;
+    }
+    Some(n)
+}
+
+/// A controller's version as a number. One that cannot be counted is 0 like an empty one, the
+/// oldest of all, as hbbs has it for punch hole requests.
+fn version_number(version: &str) -> i64 {
+    counted(version).unwrap_or(0)
+}
+
+/// The text that refuses the login `lr`, when the rule its platform is held to (`rule_of` that
+/// platform) blocks anyone and the login's version is below what it blocks now.
+fn refusal(
+    lr: &LoginRequest,
+    rule_of: impl FnOnce(&str) -> Option<ControllerRule>,
+    e2e: bool,
+    host: texts::Host,
+) -> Option<String> {
+    let rule = rule_of(&lr.my_platform)?;
+    if !rule.enforced || version_number(&lr.version) >= rule.min_number {
+        return None;
+    }
+    let platform = verdict::normalize_platform(&lr.my_platform, e2e)?;
+    // by its type only a policy's `x.y.z` gets into the text as the minimum
+    let min = Version::parse(&rule.min)?;
+    Some(texts::login_refusal(host, platform, &min, &lr.version))
+}
+
+fn head(text: &str) -> String {
+    text.chars().take(LOGGED_CHARS).collect()
+}
+
+/// The login hook of connection.rs: the text to refuse this login with, as a login error, when
+/// the controller's app is below the minimum of its platform; None lets the login go on as it
+/// always did, which is all a build that takes no part answers. A refusal also has the policy
+/// checked again.
+pub(crate) fn refuse_controller(lr: &LoginRequest) -> Option<String> {
+    let e2e = cfg!(feature = "hjv-e2e");
+    let text = refusal(lr, super::controller_rule, e2e, texts::Host::this())?;
+    super::request_check(Kind::Regular);
+    hbb_common::throttled_log!(
+        LOG_INTERVAL,
+        info,
+        "version policy: refused the login of a controller ({:?}, version {:?})",
+        head(&lr.my_platform),
+        head(&lr.version)
+    );
+    Some(text)
+}
+
