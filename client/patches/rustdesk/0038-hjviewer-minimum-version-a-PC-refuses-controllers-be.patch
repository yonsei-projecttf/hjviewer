@@ -0,0 +1,384 @@
+//! The texts this app sends to another app, which shows them as they come: what a PC answers the
+//! login of a controller whose app is below the minimum of its platform.
+//!
+//! That controller may be 1.5.1, whose code cannot be changed any more. It puts the text of a
+//! refused login in its "Login Error" box after its translation and its dialog had their way with
+//! it, so a text keeps to what that code leaves alone:
+//! - it ends with the mark that apps from 1.6.0 on know a refusal for the version by, and whose
+//!   "not allowed" keeps a session from connecting again by itself;
+//! - it does not start with "Failed" and its first word does not end in "_tip", both of which the
+//!   dialog takes apart, and it has no braces, which the translation takes for a placeholder;
+//! - it has no link, which the dialog would let the user open.
+//!
+//! The PC writes the numbers into the text. No particle that changes with the sound before it
+//! (을/를, 이/가, 은/는, 으로/로) follows a number.
+
+use super::{policy::Version, verdict::Platform};
+
+/// The end of every refusal for the version (`verdict::is_version_refusal`).
+const MARK: &str = "(version not allowed)";
+
+/// The device that refuses, as the text names it to the person at the controller.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Host {
+    Pc,
+    /// an Android device that shares its screen
+    Android,
+}
+
+impl Host {
+    pub(crate) fn this() -> Host {
+        if cfg!(target_os = "android") {
+            Host::Android
+        } else {
+            Host::Pc
+        }
+    }
+}
+
+/// A controller's version as a text may show it, `[0-9.]{1,16}`: the controller sent it, so
+/// anything else is left out.
+fn shown(version: &str) -> Option<&str> {
+    let plain = (1..=16).contains(&version.len())
+        && version.bytes().all(|b| b.is_ascii_digit() || b == b'.');
+    plain.then_some(version)
+}
+
+/// What a controller on `platform` reads when its login was refused because its `version` is
+/// below `min`: where to get the update of its platform, and for an Android app, which cannot
+/// say where it was installed from, both ways.
+pub(crate) fn login_refusal(
+    host: Host,
+    platform: Platform,
+    min: &Version,
+    version: &str,
+) -> String {
+    let host = match host {
+        Host::Pc => "이 PC는",
+        Host::Android => "연결하려는 기기는",
+    };
+    let min = min.as_str();
+    let how = match platform {
+        Platform::Ios => {
+            "iPhone의 TestFlight 앱에서 HJViewer를 업데이트한 뒤 다시 연결하세요.".to_owned()
+        }
+        Platform::Windows | Platform::Android => {
+            let now = shown(version)
+                .map(|version| format!("(지금 버전 {version})"))
+                .unwrap_or_default();
+            let play = match platform {
+                Platform::Android => " Play 스토어에서 설치했다면 Play 스토어에서 업데이트하세요.",
+                _ => "",
+            };
+            format!("이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요{now}.{play}")
+        }
+    };
+    format!("{host} HJViewer {min} 이상에서만 연결을 받습니다. {how} {MARK}")
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::{super::verdict, *};
+    use crate::client::{
+        check_if_retry, LOGIN_MSG_2FA_WRONG, LOGIN_MSG_NO_PASSWORD_ACCESS, LOGIN_MSG_OFFLINE,
+        LOGIN_MSG_PASSWORD_EMPTY, LOGIN_MSG_PASSWORD_WRONG, LOGIN_SCREEN_WAYLAND, REQUIRE_2FA,
+        SCRAP_X11_REQUIRED,
+    };
+
+    /// The design's examples of what hbbs answers (its TEXT, with the minimum filled in): with
+    /// the link of the migration door, and after that door was closed.
+    pub(crate) const S1: &str = "HJViewer를 1.6.0 이상으로 업데이트해야 연결할 수 있습니다. Play 스토어에서 설치했다면 Play 스토어에서, iPhone은 TestFlight 앱에서 업데이트하세요. 그 밖의 Windows·Android는 https://rd.example.com/api/hjv/get/0123456789abcdef0123456789abcdef/ 에서 새 버전을 받으세요. (version not allowed)";
+    pub(crate) const S2: &str = "HJViewer를 1.6.0 이상으로 업데이트해야 연결할 수 있습니다. 앱의 업데이트 화면을 쓰거나 관리자에게 새 버전을 받으세요. Play 스토어나 TestFlight로 설치했다면 그곳에서 업데이트하세요. (version not allowed)";
+
+    fn min(version: &str) -> Version {
+        Version::parse(version).unwrap()
+    }
+
+    /// Every text a PC can answer with for these versions: each host, each platform.
+    fn every_refusal(min_version: &str, version: &str) -> Vec<String> {
+        let mut texts = Vec::new();
+        for host in [Host::Pc, Host::Android] {
+            for platform in [Platform::Windows, Platform::Android, Platform::Ios] {
+                texts.push(login_refusal(host, platform, &min(min_version), version));
+            }
+        }
+        texts
+    }
+
+    /// Whether each http(s) address in `text` ends at a space: the dialog makes a link of
+    /// everything up to the next white space, less the `.,;!?` at its end.
+    fn links_end_at_spaces(text: &str) -> bool {
+        let mut rest = text;
+        loop {
+            let start = match (rest.find("http://"), rest.find("https://")) {
+                (Some(a), Some(b)) => a.min(b),
+                (Some(a), None) | (None, Some(a)) => a,
+                (None, None) => return true,
+            };
+            let link = &rest[start..];
+            let (link, after) = link.split_at(link.find(char::is_whitespace).unwrap_or(link.len()));
+            let link = link.trim_end_matches(['.', ',', ';', '!', '?']);
+            let of_a_link = |b: u8| b.is_ascii_alphanumeric() || b"-._~:/?#@!$&*+,;=%".contains(&b);
+            if !link.bytes().all(of_a_link) {
+                return false;
+            }
+            rest = after;
+        }
+    }
+
+    /// What an app that shows `text` as it comes would do to it, if anything: the rules of
+    /// 1.5.1's client.rs (check_if_retry, the "Failed" suffix, the login errors with a meaning of
+    /// their own), lang.rs (placeholders, the app's name) and flutter/lib/common.dart (the
+    /// dialog's "Failed" and "_tip" handling and its links).
+    pub(crate) fn problem(text: &str) -> Option<&'static str> {
+        if text.is_empty() || text.chars().count() > 2000 {
+            return Some("empty or too long");
+        }
+        if text.chars().any(char::is_control) {
+            return Some("a control character");
+        }
+        if !text.ends_with(MARK) || !verdict::is_version_refusal(text) {
+            return Some("no mark at the end");
+        }
+        if text.starts_with("Failed") {
+            return Some("starts with Failed");
+        }
+        if text
+            .split(' ')
+            .next()
+            .is_some_and(|word| word.ends_with("_tip"))
+        {
+            return Some("the first word ends in _tip");
+        }
+        if text.contains(['{', '}']) {
+            return Some("a brace");
+        }
+        if text.contains("RustDesk") {
+            return Some("names RustDesk");
+        }
+        if !links_end_at_spaces(text) {
+            return Some("a link that does not end at a space");
+        }
+        let special = [
+            LOGIN_MSG_PASSWORD_EMPTY,
+            LOGIN_MSG_PASSWORD_WRONG,
+            LOGIN_MSG_2FA_WRONG,
+            REQUIRE_2FA,
+            LOGIN_MSG_NO_PASSWORD_ACCESS,
+            LOGIN_MSG_OFFLINE,
+            LOGIN_SCREEN_WAYLAND,
+        ];
+        if special.contains(&text) || text.contains(SCRAP_X11_REQUIRED) {
+            return Some("a login error with a meaning of its own");
+        }
+        None
+    }
+
+    fn has_link(text: &str) -> bool {
+        text.contains("://") || text.contains("www.")
+    }
+
+    /// The texts of the design's table, to the letter.
+    #[test]
+    fn the_texts_of_the_design() {
+        let text = |platform, version| login_refusal(Host::Pc, platform, &min("1.6.0"), version);
+        assert_eq!(
+            text(Platform::Windows, "1.5.1"),
+            "이 PC는 HJViewer 1.6.0 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요(지금 버전 1.5.1). (version not allowed)"
+        );
+        assert_eq!(
+            text(Platform::Android, "1.5.1"),
+            "이 PC는 HJViewer 1.6.0 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요(지금 버전 1.5.1). Play 스토어에서 설치했다면 Play 스토어에서 업데이트하세요. (version not allowed)"
+        );
+        assert_eq!(
+            text(Platform::Ios, "1.5.1"),
+            "이 PC는 HJViewer 1.6.0 이상에서만 연결을 받습니다. iPhone의 TestFlight 앱에서 HJViewer를 업데이트한 뒤 다시 연결하세요. (version not allowed)"
+        );
+        // the numbers are the policy's and the controller's
+        assert_eq!(
+            login_refusal(Host::Pc, Platform::Windows, &min("2.10.3"), "1.6.12"),
+            "이 PC는 HJViewer 2.10.3 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요(지금 버전 1.6.12). (version not allowed)"
+        );
+        // an Android device that shares its screen is no PC
+        assert_eq!(
+            login_refusal(Host::Android, Platform::Windows, &min("1.6.0"), "1.5.1"),
+            "연결하려는 기기는 HJViewer 1.6.0 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요(지금 버전 1.5.1). (version not allowed)"
+        );
+        assert_eq!(
+            login_refusal(Host::Android, Platform::Ios, &min("1.6.0"), "1.5.1"),
+            "연결하려는 기기는 HJViewer 1.6.0 이상에서만 연결을 받습니다. iPhone의 TestFlight 앱에서 HJViewer를 업데이트한 뒤 다시 연결하세요. (version not allowed)"
+        );
+        let here = if cfg!(target_os = "android") {
+            Host::Android
+        } else {
+            Host::Pc
+        };
+        assert_eq!(Host::this(), here);
+    }
+
+    /// The controller sends its version: only digits and dots get into the text, and only so many.
+    #[test]
+    fn a_version_that_is_not_plain_is_left_out() {
+        let without = "이 PC는 HJViewer 1.6.0 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요. (version not allowed)";
+        let long = "1".repeat(17);
+        let huge = "9".repeat(100_000);
+        for odd in [
+            "",
+            " ",
+            "1.5.1 ",
+            " 1.5.1",
+            "v1.5.1",
+            "1.5.1-2",
+            "1.5.1+123",
+            "1,5,1",
+            "1.5.1\n",
+            "1.5.1\u{0}",
+            "１.５.１",
+            "{1.5.1}",
+            "1.5.1) https://rd.example.com/x (",
+            "<b>1.5.1</b>",
+            "Failed",
+            "RustDesk",
+            "not allowed",
+            long.as_str(),
+            huge.as_str(),
+        ] {
+            let text = login_refusal(Host::Pc, Platform::Windows, &min("1.6.0"), odd);
+            assert_eq!(
+                text,
+                without,
+                "{:?}",
+                odd.chars().take(40).collect::<String>()
+            );
+            let android = login_refusal(Host::Pc, Platform::Android, &min("1.6.0"), odd);
+            assert_eq!(
+                android,
+                without.replace(
+                    "연결하세요. (",
+                    "연결하세요. Play 스토어에서 설치했다면 Play 스토어에서 업데이트하세요. ("
+                )
+            );
+        }
+        for plain in [
+            "1.5.1",
+            "0",
+            "1",
+            "1.5",
+            "1.5.1.123",
+            "...",
+            "1234567890123456",
+        ] {
+            let text = login_refusal(Host::Pc, Platform::Windows, &min("1.6.0"), plain);
+            assert_eq!(
+                text,
+                without.replace(
+                    "연결하세요. (",
+                    &format!("연결하세요(지금 버전 {plain}). (")
+                ),
+                "{plain}"
+            );
+        }
+        // the iPhone's text shows no version, whatever came
+        let iphone = |version| login_refusal(Host::Pc, Platform::Ios, &min("1.6.0"), version);
+        assert_eq!(iphone("1.5.1"), iphone("<b>"));
+        assert!(!iphone("1.5.1").contains("1.5.1"));
+    }
+
+    /// Whatever the versions, a text is one that an app shows as it is and stops at.
+    #[test]
+    fn every_text_keeps_the_rules_of_the_apps_that_show_it() {
+        let long = "9".repeat(64);
+        let mut texts = vec![
+            verdict::R1.to_owned(),
+            verdict::R2.to_owned(),
+            S1.to_owned(),
+            S2.to_owned(),
+        ];
+        for min_version in [
+            "1.6.0",
+            "1.5.0",
+            "0.0.0",
+            "999.999.99",
+            "1.104.0",
+            "10.0.54",
+        ] {
+            for version in [
+                "1.5.1",
+                "",
+                "1.4.3",
+                "0.0.0.0.0.0.0.0",
+                "1.5.1-2",
+                "{0}",
+                "Failed_tip x",
+                "https://rd.example.com/",
+                "10054",
+                long.as_str(),
+            ] {
+                texts.extend(every_refusal(min_version, version));
+            }
+        }
+        assert_eq!(texts.len(), 4 + 6 * 10 * 6);
+        for text in &texts {
+            assert_eq!(problem(text), None, "{text}");
+            // a refused login is never tried again by itself, whatever its text
+            for retry_for_relay in [false, true] {
+                assert!(!check_if_retry(
+                    "error",
+                    "Login Error",
+                    text,
+                    retry_for_relay
+                ));
+            }
+            // nor is a connection that hbbs refused: "not allowed" stops it
+            assert!(!check_if_retry("error", "Connection Error", text, false));
+        }
+        // the texts of this app carry no link at all; only the server's own text may
+        for text in texts.iter().filter(|text| *text != S1) {
+            assert!(!has_link(text), "{text}");
+        }
+        assert!(has_link(S1));
+        // what an app from 1.6.0 on shows in their place stops a connection in every case
+        for text in [verdict::R1, verdict::R2] {
+            assert!(!check_if_retry("error", "Connection Error", text, true));
+        }
+    }
+
+    /// The rules above are the ones the apps trip over: each broken one is seen.
+    #[test]
+    fn a_text_that_breaks_a_rule_is_seen() {
+        let good = login_refusal(Host::Pc, Platform::Windows, &min("1.6.0"), "1.5.1");
+        assert_eq!(problem(&good), None);
+        let retried = |text: &str| check_if_retry("error", "Connection Error", text, false);
+        // without the words that stop it, a refused connection is tried again for ever
+        let unmarked = good.replace(" (version not allowed)", "");
+        assert!(problem(&unmarked).is_some());
+        assert!(retried(&unmarked));
+        let weak = good.replace("version not allowed", "version no longer allowed");
+        assert!(problem(&weak).is_some());
+        assert!(retried(&weak));
+        assert!(!retried(&good));
+        for bad in [
+            String::new(),
+            format!("Failed: {good}"),
+            format!("update_tip {good}"),
+            good.replace("1.6.0", "{1.6.0}"),
+            good.replace("HJViewer", "RustDesk"),
+            good.replace("연결하세요", "연결하세요\n"),
+            good.replace(
+                "받습니다.",
+                "받습니다. https://rd.example.com/get/에서 받으세요.",
+            ),
+            good.replace("(version not allowed)", "(version not allowed) "),
+            "Wrong Password".to_owned(),
+            format!("x11 expected {good}"),
+        ] {
+            assert!(problem(&bad).is_some(), "{bad}");
+        }
+        // a link is fine where a space ends it
+        let linked = good.replace(
+            "받습니다.",
+            "받습니다. https://rd.example.com/get/ 에서 받으세요.",
+        );
+        assert_eq!(problem(&linked), None);
+    }
+}
