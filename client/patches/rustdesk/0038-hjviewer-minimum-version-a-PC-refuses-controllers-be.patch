+    /// The vectors' policy: Windows, the APK and iOS at minimum 1.6.0 from GRACE on, Android from
+    /// Play at minimum 1.5.0.
+    #[test]
+    fn the_policy_this_process_holds_decides() {
+        let file = TempFile::new("refuse-none", store::FILE);
+        let empty = Core::open(pins(), file.0.clone(), Os::Windows, false);
+        // no policy yet: nobody is refused, whatever the version
+        for platform in ["Windows", "Android", "Unknown: iOS"] {
+            assert_eq!(answer(&empty, "1.5.1", platform, AFTER), None);
+            assert_eq!(answer(&empty, "", platform, u64::MAX), None);
+        }
+
+        let (_file, core) = holding("refuse", Os::Windows, false, &policy_text(1, 7));
+        assert_eq!(answer(&core, "1.5.1", "Windows", BEFORE), None);
+        assert_eq!(
+            answer(&core, "1.5.1", "Windows", AFTER).as_deref(),
+            Some(L1)
+        );
+        assert_eq!(
+            answer(&core, "1.5.1", "Windows", u64::MAX).as_deref(),
+            Some(L1)
+        );
+        assert_eq!(answer(&core, "1.5.1", "Unknown: iOS", BEFORE), None);
+        assert_eq!(
+            answer(&core, "1.5.1", "Unknown: iOS", AFTER).as_deref(),
+            Some(L2)
+        );
+        assert_eq!(answer(&core, "1.5.1", "iOS", AFTER).as_deref(), Some(L2));
+        for platform in ["Windows", "Unknown: iOS", "Android"] {
+            for version in ["1.6.0", "1.6.1", "2.0.0"] {
+                assert_eq!(answer(&core, version, platform, AFTER), None);
+            }
+        }
+        // an empty version is the oldest of all; before the deadline what is below the version
+        // the grace period starts at (1.5.0) is refused too
+        assert!(answer(&core, "", "Windows", AFTER).is_some());
+        assert!(answer(&core, "", "Windows", BEFORE).is_some());
+        assert_eq!(
+            answer(&core, "1.4.9", "Windows", BEFORE).as_deref(),
+            Some(L1.replace("1.5.1", "1.4.9").as_str())
+        );
+        // upstream's apps on other systems are not this policy's business
+        for other in [
+            "Linux",
+            "Mac OS",
+            "",
+            "Windows 11",
+            "windows.",
+            "Unknown: FreeBSD",
+        ] {
+            assert_eq!(answer(&core, "0.0.1", other, AFTER), None, "{other:?}");
+            assert_eq!(answer(&core, "", other, u64::MAX), None, "{other:?}");
+        }
+        // a device whose clock was set back is held to the day the policy was issued, no further
+        assert_eq!(answer(&core, "1.5.1", "Windows", 0), None);
+
+        // the E2E's Linux client stands in for a Windows controller, in an E2E build alone
+        let (_file, e2e) = holding("refuse-e2e", Os::Linux, true, &policy_text(1, 7));
+        assert_eq!(answer(&e2e, "1.5.0", "Linux", BEFORE), None);
+        assert_eq!(
+            answer(&e2e, "1.5.0", "Linux", AFTER).as_deref(),
+            Some(L1.replace("1.5.1", "1.5.0").as_str())
+        );
+        assert_eq!(answer(&e2e, "1.6.0", "Linux", AFTER), None);
+
+        // a policy without a deadline holds at once; one without the platform holds nobody
+        let at_once = policy_with(1, 8, |p| {
+            let platforms = p["platforms"].as_object_mut().unwrap();
+            let windows = platforms["windows"].as_object_mut().unwrap();
+            windows.remove("grace_until");
+            windows.remove("grace_min");
+            platforms.remove("ios");
+        });
+        let (_file, core) = holding("refuse-at-once", Os::Windows, false, &at_once);
+        assert_eq!(
+            answer(&core, "1.5.1", "Windows", ISSUED as u64).as_deref(),
+            Some(L1)
+        );
+        assert_eq!(answer(&core, "1.5.1", "Unknown: iOS", u64::MAX), None);
+    }
+
+    /// An Android controller does not say whether it came from Google Play: it is refused only
+    /// below what both Android entries block at the time, and its text names the lower minimum
+    /// and both ways to update.
+    #[test]
+    fn android_is_held_to_what_both_its_entries_block() {
+        let play_text = |min: &str, version: &str| {
+            format!("이 PC는 HJViewer {min} 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요(지금 버전 {version}). Play 스토어에서 설치했다면 Play 스토어에서 업데이트하세요. (version not allowed)")
+        };
+        // the APK at 1.6.0 from GRACE on (from 1.5.0 before it), Play at 1.5.0: 1.5.0, always
+        let (_file, core) = holding("refuse-android", Os::Windows, false, &policy_text(1, 7));
+        for wall in [BEFORE, AFTER] {
+            assert_eq!(answer(&core, "1.5.1", "Android", wall), None);
+            assert_eq!(answer(&core, "1.5.0", "Android", wall), None);
+            assert_eq!(
+                answer(&core, "1.4.9", "Android", wall),
+                Some(play_text("1.5.0", "1.4.9"))
+            );
+        }
+        // both at 1.6.0, Play's deadline a week later: from 1.5.0 on let in until that one
+        let later = AFTER + 7 * 86_400;
+        let both = policy_with(1, 8, |p| {
+            let play = &mut p["platforms"]["android_play"];
+            play["min"] = "1.6.0".into();
+            play["grace_until"] = "2026-11-23T15:00:00Z".into();
+            play["grace_min"] = "1.5.0".into();
+        });
+        let (_file, core) = holding("refuse-android-both", Os::Windows, false, &both);
+        assert_eq!(answer(&core, "1.5.1", "Android", AFTER), None);
+        assert_eq!(answer(&core, "1.5.1", "Android", later - 1), None);
+        assert_eq!(
+            answer(&core, "1.4.9", "Android", BEFORE),
+            Some(play_text("1.6.0", "1.4.9"))
+        );
+        assert_eq!(
+            answer(&core, "1.5.1", "Android", later),
+            Some(play_text("1.6.0", "1.5.1"))
+        );
+        // a Windows controller is not put off by Android's deadline
+        assert_eq!(
+            answer(&core, "1.5.1", "Windows", AFTER).as_deref(),
+            Some(L1)
+        );
+        // Play ahead of the APK, its own grace from 1.6.0: the APK's deadline decides
+        let play_ahead = policy_with(1, 8, |p| {
+            let play = &mut p["platforms"]["android_play"];
+            play["min"] = "1.6.1".into();
+            play["grace_until"] = "2026-11-23T15:00:00Z".into();
+            play["grace_min"] = "1.6.0".into();
+        });
+        let (_file, core) = holding("refuse-android-play", Os::Windows, false, &play_ahead);
+        assert_eq!(answer(&core, "1.6.0", "Android", later), None);
+        assert_eq!(answer(&core, "1.5.1", "Android", BEFORE), None);
+        assert_eq!(
+            answer(&core, "1.5.1", "Android", AFTER),
+            Some(play_text("1.6.0", "1.5.1"))
+        );
+        // the two cross: the APK at 1.6.1 with its deadline, Play at 1.6.0 at once. Until the
+        // deadline only what the APK's grace period blocks too is refused
+        let crossing = policy_with(1, 8, |p| {
+            p["platforms"]["android"]["min"] = "1.6.1".into();
+            p["platforms"]["android_play"]["min"] = "1.6.0".into();
+        });
+        let (_file, core) = holding("refuse-android-cross", Os::Windows, false, &crossing);
+        assert_eq!(answer(&core, "1.5.1", "Android", BEFORE), None);
+        assert_eq!(
+            answer(&core, "1.4.9", "Android", BEFORE),
+            Some(play_text("1.6.0", "1.4.9"))
+        );
+        assert_eq!(
+            answer(&core, "1.5.1", "Android", AFTER),
+            Some(play_text("1.6.0", "1.5.1"))
+        );
+        assert_eq!(answer(&core, "1.6.0", "Android", AFTER), None);
+        // one Android entry alone is the Android entry; none, and no Android controller is held
+        let only_file = policy_with(1, 8, |p| {
+            p["platforms"]
+                .as_object_mut()
+                .unwrap()
+                .remove("android_play");
+        });
+        let (_file, core) = holding("refuse-android-file", Os::Windows, false, &only_file);
+        assert_eq!(answer(&core, "1.5.1", "Android", BEFORE), None);
+        assert_eq!(
+            answer(&core, "1.5.1", "Android", AFTER),
+            Some(play_text("1.6.0", "1.5.1"))
+        );
+        let no_android = policy_with(1, 8, |p| {
+            let platforms = p["platforms"].as_object_mut().unwrap();
+            platforms.remove("android");
+            platforms.remove("android_play");
+        });
+        let (_file, core) = holding("refuse-android-none", Os::Windows, false, &no_android);
+        assert_eq!(answer(&core, "", "Android", u64::MAX), None);
+        assert_eq!(
+            answer(&core, "1.5.1", "Windows", AFTER).as_deref(),
+            Some(L1)
+        );
+    }
+
+    /// The controller chooses its version and its platform: neither can put anything of its own
+    /// into the answer, stop the process, or make the session try again by itself.
+    #[test]
+    fn nothing_a_controller_sends_gets_into_the_answer() {
+        let (_file, core) = holding("refuse-hostile", Os::Windows, false, &policy_text(1, 7));
+        let without = L1.replace("(지금 버전 1.5.1)", "");
+        let huge = "9".repeat(1_000_000);
+        let many = "9.".repeat(40);
+        for version in [
+            "1.5.1 https://localhost/update",
+            "1) 새 버전은 www.example 에서 받으세요. (",
+            "{1.5.1}",
+            "Failed",
+            "1.5.1\r\n(version allowed)",
+            "1.5.1\u{202e}",
+            "99999999999999999999",
+            many.as_str(),
+            huge.as_str(),
+        ] {
+            let text = answer(&core, version, "Windows", AFTER);
+            let sent: String = version.chars().take(40).collect();
+            assert_eq!(text.as_deref(), Some(without.as_str()), "{sent:?}");
+        }
+        // a platform is only ever one of three kinds of text
+        let odd_platforms = [
+            "WINDOWS",
+            " windows ",
+            "android",
+            "ANDROID",
+            "https://x/ iOS",
+            "{}ios",
+        ];
+        for platform in odd_platforms {
+            let text = answer(&core, "1.4.0", platform, AFTER).unwrap();
+            assert_eq!(problem(&text), None, "{platform:?}");
+            assert!(
+                !text.contains("https") && !text.contains('{'),
+                "{platform:?}"
+            );
+        }
+        // every answer is one a 1.5.1 app shows as it is, under a title it does not retry
+        for platform in ["Windows", "Android", "Unknown: iOS"] {
+            for version in ["1.4.9", "", "1.4.3", "{0}", "10054", "0.104.0"] {
+                let text = answer(&core, version, platform, AFTER).unwrap();
+                assert_eq!(problem(&text), None, "{text}");
+                for retry_for_relay in [false, true] {
+                    assert!(!check_if_retry(
+                        "error",
+                        "Login Error",
+                        &text,
+                        retry_for_relay
+                    ));
+                }
+            }
+        }
+    }
+
+    /// A session's interface that keeps the boxes it was asked to show.
+    #[derive(Clone, Default)]
+    struct Ui {
+        lc: Arc<RwLock<LoginConfigHandler>>,
+        boxes: Arc<Mutex<Vec<[String; 4]>>>,
+    }
+
+    #[async_trait]
+    impl Interface for Ui {
+        fn send(&self, _data: Data) {}
+        fn msgbox(&self, msgtype: &str, title: &str, text: &str, link: &str) {
+            self.boxes
+                .lock()
+                .unwrap()
+                .push([msgtype, title, text, link].map(str::to_owned));
+        }
+        fn handle_login_error(&self, err: &str) -> bool {
+            handle_login_error(self.lc.clone(), err, self)
+        }
+        fn handle_peer_info(&self, _pi: PeerInfo) {}
+        fn set_multiple_windows_session(&self, _sessions: Vec<WindowsSession>) {}
+        async fn handle_hash(&self, _pass: &str, _hash: Hash, _peer: &mut Stream) -> bool {
+            false
+        }
+        async fn handle_login_from_ui(
+            &self,
+            _os_username: String,
+            _os_password: String,
+            _password: String,
+            _remember: bool,
+            _peer: &mut Stream,
+        ) {
+        }
+        async fn handle_test_delay(&self, _t: TestDelay, _peer: &mut Stream) {}
+        fn get_lch(&self) -> Arc<RwLock<LoginConfigHandler>> {
+            self.lc.clone()
+        }
+    }
+
+    /// The box the controller's own code (client.rs, handle_login_error) shows for a login error.
+    fn box_for(err: &str) -> (bool, [String; 4]) {
+        let ui = Ui::default();
+        let go_on = ui.handle_login_error(err);
+        let mut boxes = ui.boxes.lock().unwrap().clone();
+        assert_eq!(boxes.len(), 1, "{err}");
+        (go_on, boxes.remove(0))
+    }
+
+    /// The login errors a PC always sent come to the controller's screen as they did.
+    #[test]
+    fn other_login_errors_are_left_as_they_are() {
+        let (again, wrong) = box_for(LOGIN_MSG_PASSWORD_WRONG);
+        assert!(again);
+        assert_eq!(wrong[..2], ["re-input-password", LOGIN_MSG_PASSWORD_WRONG]);
+        for err in [
+            LOGIN_MSG_OFFLINE,
+            "No permission of file transfer",
+            "Your ID is blocked by the peer",
+            "Connection not allowed",
+            "not allowed",
+            "version",
+            "",
+        ] {
+            assert_eq!(crate::hjviewer_update::on_login_refusal(err), err);
+            assert_eq!(crate::hjviewer_update::on_refusal(err), err);
+            let (go_on, shown) = box_for(err);
+            assert!(!go_on, "{err}");
+            assert_eq!(shown, ["error", "Login Error", err, ""], "{err}");
+        }
+    }
+
+    /// A build that takes no part refuses nobody and shows refusals as 1.5.1 does: the PC's text
+    /// under "Login Error", hbbs's as the connection's error, neither tried again.
+    #[test]
+    fn a_build_that_takes_no_part_changes_nothing() {
+        if crate::hjviewer_update::enabled() {
+            return;
+        }
+        for (version, my_platform) in [("1.5.1", "Windows"), ("", "Android"), ("0", "iOS")] {
+            let lr = LoginRequest {
+                version: version.to_owned(),
+                my_platform: my_platform.to_owned(),
+                ..Default::default()
+            };
+            assert_eq!(refuse_controller(&lr), None);
+        }
+        for text in [L1, L2, S1, S2, R1, R2] {
+            assert_eq!(crate::hjviewer_update::on_refusal(text), text);
+            assert!(!check_if_retry("error", "Connection Error", text, false));
+            let (go_on, shown) = box_for(text);
+            assert!(!go_on);
+            assert_eq!(shown, ["error", "Login Error", text, ""]);
+            assert!(!check_if_retry(&shown[0], &shown[1], &shown[2], true));
+        }
+    }
+
+    /// The way the hook of connection.rs goes, in a build that takes part (one compiled with
+    /// HJV_SERVER and the update keys; the policies here are signed with the tests' first key):
+    /// `refuse_controller` answers by the policy this process holds, read by the device's clock,
+    /// in the words of this device, and a login it refused, and no other, makes the process check
+    /// the policy. Any other build has nothing to ask here and the test ends at once, so it is
+    /// run in a build with the keys of `vectors`:
+    ///
+    ///     HJV_SERVER=hjv.test HJV_UPDATE_PUBKEY=<vectors::HJV_UPDATE_PUBKEY> \
+    ///         HJV_UPDATE_ROOT_PUBKEY=<vectors::HJV_UPDATE_ROOT_PUBKEY> \
+    ///         cargo test --lib hjviewer_update
+    #[test]
+    fn the_hook_goes_by_the_policy_this_process_holds() {
+        let Some(build) = crate::hjviewer_update::build() else {
+            return;
+        };
+        if !build.signing.contains(&(SIGNING_1.id, SIGNING_1.public())) {
+            return;
+        }
+        let file = TempFile::new("refuse-process", store::FILE);
+        // the vectors' policy for this build's server, issued long ago: Windows at the minimum
+        // 1.6.0 from `deadline` on; the time it came at, by the forward clock
+        let hold = |deadline: &str| {
+            let policy = policy_with(build.floor.epoch, build.floor.seq + 1, |p| {
+                p["server"] = build.server.as_str().into();
+                p["issued"] = "2020-01-01T00:00:00Z".into();
+                p["platforms"]["windows"]["grace_until"] = deadline.into();
+            });
+            let e2e = cfg!(feature = "hjv-e2e");
+            let mut core = Core::open(build.clone(), file.0.clone(), Os::Windows, e2e);
+            let mono = fetch::mono();
+            core.begin(Kind::Regular, mono).unwrap();
+            let reply = Reply {
+                status: 200,
+                date: None,
+                body: envelope(1, &SIGNING_1, &policy, None).into_bytes(),
+            };
+            assert_eq!(core.finish(Ok(reply), wall(), mono, 0), Outcome::Updated);
+            *CORE.lock().unwrap() = Some(core);
+            mono
+        };
+        fn held<R>(f: impl FnOnce(&mut Core) -> R) -> R {
+            f(CORE.lock().unwrap().as_mut().unwrap())
+        }
+        // Here the process's own check is due, and the minute between checks nobody waits for
+        // has not passed since the policy came. A login that is let in has nothing checked: no
+        // check is asked for, and the one that is due is left where it is.
+        let came = hold("2020-01-02T00:00:00Z");
+        held(|core| core.next_check = 0);
+        assert_eq!(refuse_controller(&login("1.6.0", "Windows")), None);
+        assert_eq!(held(|core| (core.checking, core.next_check)), (false, 0));
+        // A refused login has the policy checked again, as a check nobody waits for: the thread
+        // that was woken puts the check off to the end of that minute and asks no server.
+        assert!(refuse_controller(&login("1.5.1", "Windows")).is_some());
+        let woken = (0..1500).any(|_| {
+            std::thread::sleep(Duration::from_millis(20));
+            held(|core| core.next_check) != 0
+        });
+        assert!(woken, "the refused login did not have the policy checked");
+        assert_eq!(held(|core| core.next_check), came + fetch::REGULAR_GAP);
+        // a deadline that passed years ago by the device's clock; the policy's day of issue, the
+        // earliest the time is taken for, is the day before it, so the clock itself is read
+        hold("2020-01-02T00:00:00Z");
+        assert_eq!(
+            refuse_controller(&login("1.5.1", "Windows")).as_deref(),
+            Some(L1)
+        );
+        assert_eq!(refuse_controller(&login("1.6.0", "Windows")), None);
+        assert_eq!(refuse_controller(&login("1.5.1", "Mac OS")), None);
+        // a deadline this device's clock has not reached
+        hold("2099-01-01T00:00:00Z");
+        assert_eq!(refuse_controller(&login("1.5.1", "Windows")), None);
+    }
+
+    /// In a build that takes part the controller shows its own text in place of a refusal for the
+    /// version, R1 or R2, which a refused login's box then carries; that text too is one the
+    /// session stops at.
+    #[test]
+    fn what_the_controller_shows_in_place_of_a_refusal() {
+        let (_file, core) = holding("refuse-shown", Os::Windows, false, &policy_text(1, 7));
+        let (old, new) = (
+            hbb_common::get_version_number("1.5.1"),
+            hbb_common::get_version_number("1.6.1"),
+        );
+        for text in [L1, L2, S1, S2] {
+            // this app is below the minimum: its update screen takes over
+            assert_eq!(core.refusal(text, old, AFTER, 1), Some(R1));
+            // the policy was just checked and asks nothing of this app: the two disagree
+            assert_eq!(core.refusal(text, new, AFTER, 1), Some(R2));
+        }
+        for other in [
+            LOGIN_MSG_PASSWORD_WRONG,
+            LOGIN_MSG_OFFLINE,
+            "Connection not allowed",
+        ] {
+            assert_eq!(core.refusal(other, old, AFTER, 1), None);
+        }
+        for text in [R1, R2] {
+            assert_eq!(problem(text), None);
+            assert!(!text.contains("://") && !text.contains("www."));
+            for title in ["Login Error", "Connection Error"] {
+                for retry_for_relay in [false, true] {
+                    assert!(!check_if_retry("error", title, text, retry_for_relay));
+                }
+            }
+        }
+    }
+}
