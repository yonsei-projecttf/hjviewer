+#[test]
+fn the_trays_two_items_show_only_while_a_pc_without_a_login_is_refused() {
+    assert!(tray_menu(true, false, false));
+    assert!(!tray_menu(true, true, false)); // bound: [열기] alone
+    assert!(!tray_menu(false, false, false));
+    assert!(!tray_menu(true, false, true)); // a build without the login
+    assert_eq!(tray_item_words(true), ["로그인…", "이용 비밀번호 넣기…"]);
+    assert_eq!(
+        tray_item_words(false),
+        ["Log in…", "Enter access password…"]
+    );
+    // the links hjvGateLinkAction (hjviewer_access_texts.dart) opens something for
+    let prefix = crate::get_uri_prefix();
+    assert_eq!(tray_link(false), format!("{prefix}hjv-gate/login"));
+    assert_eq!(tray_link(true), format!("{prefix}hjv-gate/password"));
+    // the menu follows what the tray last got from the process that registers
+    TRAY_REFUSED.store(true, std::sync::atomic::Ordering::Relaxed);
+    assert_eq!(tray_now(), (true, true));
+    TRAY_REFUSED.store(false, std::sync::atomic::Ordering::Relaxed);
+    assert_eq!(tray_now(), (false, false));
+}
+
+#[test]
+fn the_trays_notice_tells_a_bound_pc_to_look_in_the_app() {
+    assert_eq!(
+        tray_notice(true, false),
+        "이 PC는 지금 연결을 받지 않습니다. 로그인하거나 이용 비밀번호를 넣으세요."
+    );
+    assert_eq!(
+        tray_notice(true, true),
+        "로그인했지만 서버가 이 PC를 받지 않고 있습니다. HJViewer를 열어 까닭을 확인하세요."
+    );
+    assert_eq!(
+        tray_notice(false, false),
+        "This PC is not accepting connections right now. Log in or enter the access password."
+    );
+    assert_eq!(
+        tray_notice(false, true),
+        "You are logged in, but the server is not accepting this PC. Open HJViewer to see why."
+    );
+}
+
+#[test]
+fn the_trays_notice_comes_after_a_minute_of_refusal_and_at_most_twice_a_day() {
+    const HOUR: u64 = 3600;
+    let mut notice = TrayNotice::default();
+    // refused from the start: told once after 60 s, not again while it lasts
+    assert!(!notice.due(true, 0));
+    assert!(!notice.due(true, 59));
+    assert!(notice.due(true, 60));
+    assert!(!notice.due(true, 61));
+    assert!(!notice.due(true, 13 * HOUR));
+    // a short refusal is not told
+    assert!(!notice.due(false, 13 * HOUR + 1));
+    assert!(!notice.due(true, 13 * HOUR + 2));
+    assert!(!notice.due(false, 13 * HOUR + 30));
+    // a new refusal that lasts is
+    assert!(!notice.due(true, 14 * HOUR));
+    assert!(notice.due(true, 14 * HOUR + 60));
+    // one within 12 hours of that waits for them, if it still lasts
+    assert!(!notice.due(false, 15 * HOUR));
+    assert!(!notice.due(true, 15 * HOUR + 1));
+    assert!(!notice.due(true, 20 * HOUR));
+    assert!(!notice.due(true, 26 * HOUR + 59));
+    assert!(notice.due(true, 26 * HOUR + 60));
+    assert!(!notice.due(true, 40 * HOUR));
+    // a PC hbbs takes is never told
+    let mut taken = TrayNotice::default();
+    assert!((0..100 * HOUR)
+        .step_by(30)
+        .all(|now| !taken.due(false, now)));
+}
+
