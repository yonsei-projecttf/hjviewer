-#[cfg(windows)]
+/// The tray's words follow the app's language as the tooltip's do: Korean or English.
+#[cfg(any(windows, test))]
+fn tray_korean() -> bool {
+    crate::client::translate("Cancel".to_owned()) == "취소"
+}
+
+/// The tray now (UX-G2), every second from its event loop: whether hbbs refuses this PC (TR1, the
+/// icon with the orange dot) and whether the menu has [로그인…] [이용 비밀번호 넣기…] (TR2).
+#[cfg(any(windows, test))]
+pub(crate) fn tray_now() -> (bool, bool) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let refused = TRAY_REFUSED.load(Relaxed);
+    let items = tray_menu(
+        refused,
+        TRAY_BOUND.load(Relaxed),
+        hbb_common::config::is_disable_account(),
+    );
+    (refused, items)
+}
+
+/// TR2: whether the tray's menu has [로그인…] and [이용 비밀번호 넣기…] after [열기]. Only while
+/// hbbs refuses a PC that no login bound, in a build that has the login: a bound PC keeps [열기]
+/// alone, as its home's P1 card says why and has the buttons.
+#[cfg(any(windows, test))]
+fn tray_menu(refused: bool, bound: bool, account_disabled: bool) -> bool {
+    refused && !bound && !account_disabled
+}
+
+/// TR2's two items, as the doc's 5-3 has them (not through translate, like the tooltip's word).
+#[cfg(any(windows, test))]
+pub(crate) fn tray_items() -> [&'static str; 2] {
+    tray_item_words(tray_korean())
+}
+
+#[cfg(any(windows, test))]
+fn tray_item_words(korean: bool) -> [&'static str; 2] {
+    if korean {
+        ["로그인…", "이용 비밀번호 넣기…"]
+    } else {
+        ["Log in…", "Enter access password…"]
+    }
+}
+
+/// The link an item opens the main window with (`password` for the second item): the window's
+/// hjvHandleGateLink (hjviewer_access.dart) opens the login, or P2 while P1 shows. It carries no
+/// value, so nothing in it can be wrong.
+#[cfg(any(windows, test))]
+pub(crate) fn tray_link(password: bool) -> String {
+    let what = if password { "password" } else { "login" };
+    format!("{}hjv-gate/{what}", crate::get_uri_prefix())
+}
+
+/// TR3: the Windows notice's text under the title HJViewer. A PC a login bound is not told to log
+/// in: hjv-api's sync decides about it, and the app's home says why.
+#[cfg(any(windows, test))]
+fn tray_notice(korean: bool, bound: bool) -> &'static str {
+    match (korean, bound) {
+        (true, false) => {
+            "이 PC는 지금 연결을 받지 않습니다. 로그인하거나 이용 비밀번호를 넣으세요."
+        }
+        (true, true) => {
+            "로그인했지만 서버가 이 PC를 받지 않고 있습니다. HJViewer를 열어 까닭을 확인하세요."
+        }
+        (false, false) => {
+            "This PC is not accepting connections right now. Log in or enter the access password."
+        }
+        (false, true) => {
+            "You are logged in, but the server is not accepting this PC. Open HJViewer to see why."
+        }
+    }
+}
+
+/// TR3 (decision D-18): the text of the Windows notice when it is due now (`now` in seconds since
+/// the tray came up), None otherwise.
+#[cfg(any(windows, test))]
+pub(crate) fn tray_notice_due(notice: &mut TrayNotice, now: u64) -> Option<&'static str> {
+    use std::sync::atomic::Ordering::Relaxed;
+    notice
+        .due(TRAY_REFUSED.load(Relaxed), now)
+        .then(|| tray_notice(tray_korean(), TRAY_BOUND.load(Relaxed)))
+}
+
+/// How long a refusal lasts before the tray tells (TR3): a logged-in PC's ticket can come a little
+/// after the tray, and a short refusal meanwhile is not worth a notice (U06's 60 seconds).
+#[cfg(any(windows, test))]
+const TRAY_NOTICE_AFTER: u64 = 60;
+/// The tray shows its notice at most once in this time (D-18).
+#[cfg(any(windows, test))]
+const TRAY_NOTICE_EVERY: u64 = 12 * 3600;
+
+/// When the tray shows its Windows notice (TR3, D-18): once a refusal has lasted
+/// [`TRAY_NOTICE_AFTER`] since the tray came up, and after that for each new refusal (hbbs took
+/// the PC, then refused it again) that lasts as long, but at most once in [`TRAY_NOTICE_EVERY`].
+/// A refusal that comes sooner after the last notice is told once that time is up, if it still
+/// lasts; one refusal is told only once however long it lasts. The tray process lives as long as
+/// the Windows login, so a PC that stays refused shows it once at each login.
+#[cfg(any(windows, test))]
+#[derive(Debug, Default)]
+pub(crate) struct TrayNotice {
+    /// Since when hbbs refuses this PC without a break, None while it takes it.
+    refused_since: Option<u64>,
+    /// Whether this refusal has had its notice.
+    told: bool,
+    /// When the last notice showed.
+    last: Option<u64>,
+}
+
+#[cfg(any(windows, test))]
+impl TrayNotice {
+    /// Whether to show the notice now, from whether hbbs refuses this PC now (`now` in seconds,
+    /// never going back). True at most once per refusal.
+    fn due(&mut self, refused: bool, now: u64) -> bool {
+        if !refused {
+            self.refused_since = None;
+            self.told = false;
+            return false;
+        }
+        let since = *self.refused_since.get_or_insert(now);
+        if self.told
+            || now.saturating_sub(since) < TRAY_NOTICE_AFTER
+            || self
+                .last
+                .is_some_and(|last| now.saturating_sub(last) < TRAY_NOTICE_EVERY)
+        {
+            return false;
+        }
+        self.told = true;
+        self.last = Some(now);
+        true
+    }
+}
+
+#[cfg(any(windows, test))]
 static TRAY_REFUSED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
-#[cfg(windows)]
+#[cfg(any(windows, test))]
 static TRAY_BOUND: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
 
