+
+/// HJViewer (UX-G2, the doc's TR1-TR3): while hbbs refuses this PC, the icon with the orange dot,
+/// [로그인…] [이용 비밀번호 넣기…] after [열기] on a PC no login bound, and a Windows notice when
+/// it is due. hjviewer_access decides all three; this applies them. Used on Windows only, but built
+/// wherever the tray is, so that a check on Linux compiles its tray and menu calls.
+#[cfg_attr(not(windows), allow(dead_code))]
+struct HjvTray {
+    log_in: tray_icon::menu::MenuItem,
+    password: tray_icon::menu::MenuItem,
+    icon: tray_icon::Icon,
+    warn: Option<tray_icon::Icon>,
+    /// What the tray shows now.
+    dot: bool,
+    items: bool,
+    started: std::time::Instant,
+    checked: Option<std::time::Instant>,
+    #[cfg(windows)]
+    notice: crate::hjviewer_access::TrayNotice,
+}
+
+#[cfg_attr(not(windows), allow(dead_code))]
+impl HjvTray {
+    fn new(icon: tray_icon::Icon, words: [&str; 2]) -> Self {
+        use tray_icon::menu::MenuItem;
+        #[cfg(windows)]
+        let warn = Self::icon_of(include_bytes!("../res/tray-icon-warn.ico"));
+        #[cfg(not(windows))]
+        let warn = None;
+        Self {
+            log_in: MenuItem::new(words[0], true, None),
+            password: MenuItem::new(words[1], true, None),
+            icon,
+            warn,
+            dot: false,
+            items: false,
+            started: std::time::Instant::now(),
+            checked: None,
+            #[cfg(windows)]
+            notice: Default::default(),
+        }
+    }
+
+    fn icon_of(bytes: &[u8]) -> Option<tray_icon::Icon> {
+        let image = match image::load_from_memory(bytes) {
+            Ok(image) => image.into_rgba8(),
+            Err(err) => {
+                log::error!("Failed to open the tray's warning icon: {}", err);
+                return None;
+            }
+        };
+        let (width, height) = image.dimensions();
+        tray_icon::Icon::from_rgba(image.into_raw(), width, height)
+            .map_err(|err| log::error!("Failed to open the tray's warning icon: {}", err))
+            .ok()
+    }
+
+    /// Every turn of the event loop, at most once a second.
+    #[cfg(windows)]
+    fn tick<F: Fn() + Send + 'static>(
+        &mut self,
+        tray: &Mutex<Option<tray_icon::TrayIcon>>,
+        menu: &tray_icon::menu::Menu,
+        open: F,
+    ) {
+        if self
+            .checked
+            .is_some_and(|checked| checked.elapsed() < Duration::from_secs(1))
+        {
+            return;
+        }
+        self.checked = Some(std::time::Instant::now());
+        let (refused, items) = crate::hjviewer_access::tray_now();
+        // no tray (hidden, or not built yet): no notice either
+        if !self.apply(tray, menu, refused, items) {
+            return;
+        }
+        let now = self.started.elapsed().as_secs();
+        if let Some(text) = crate::hjviewer_access::tray_notice_due(&mut self.notice, now) {
+            Self::notify(text, open);
+        }
+    }
+
+    /// Shows the dot and the two items as `refused` and `items` say; false while there is no tray.
+    fn apply(
+        &mut self,
+        tray: &Mutex<Option<tray_icon::TrayIcon>>,
+        menu: &tray_icon::menu::Menu,
+        refused: bool,
+        items: bool,
+    ) -> bool {
+        let tray = tray.lock().unwrap();
+        let Some(tray) = tray.as_ref() else {
+            return false;
+        };
+        if refused != self.dot {
+            let icon = match (&self.warn, refused) {
+                (Some(warn), true) => warn.clone(),
+                _ => self.icon.clone(),
+            };
+            if let Err(err) = tray.set_icon(Some(icon)) {
+                log::error!("Failed to change the tray icon: {}", err);
+            }
+            self.dot = refused;
+        }
+        if items != self.items {
+            let changed = if items {
+                menu.insert_items(&[&self.log_in, &self.password], 1)
+            } else {
+                menu.remove(&self.log_in)
+                    .and_then(|_| menu.remove(&self.password))
+            };
+            if let Err(err) = changed {
+                log::error!("Failed to change the tray menu: {}", err);
+            }
+            self.items = items;
+        }
+        true
+    }
+
+    /// Which of the two items `id` is: Some(true) for [이용 비밀번호 넣기…].
+    fn item(&self, id: &tray_icon::menu::MenuId) -> Option<bool> {
+        if id == self.password.id() {
+            Some(true)
+        } else if id == self.log_in.id() {
+            Some(false)
+        } else {
+            None
+        }
+    }
+
+    /// The two items open the main window with a link (hjviewer_access::tray_link), the same way
+    /// whether it is up or not: the runner hands the link to a window that is up.
+    #[cfg(windows)]
+    fn clicked(&self, id: &tray_icon::menu::MenuId) {
+        if let Some(password) = self.item(id) {
+            if let Err(err) = crate::run_me(vec![crate::hjviewer_access::tray_link(password)]) {
+                log::error!("Failed to open the main window from the tray: {}", err);
+            }
+        }
+    }
+
+    /// TR3 under the title HJViewer; clicking it opens the main window as [열기] does.
+    #[cfg(windows)]
+    fn notify<F: Fn() + Send + 'static>(text: &'static str, open: F) {
+        let title = crate::get_app_name();
+        log::info!("tray: notice that hbbs refuses this PC");
+        std::thread::spawn(move || {
+            let toast = tauri_winrt_notification::Toast::new(
+                tauri_winrt_notification::Toast::POWERSHELL_APP_ID,
+            );
+            if let Err(err) = toast
+                .title(&title)
+                .text1(text)
+                .sound(Some(tauri_winrt_notification::Sound::Default))
+                .duration(tauri_winrt_notification::Duration::Short)
+                .on_activated(move || {
+                    open();
+                    Ok(())
+                })
+                .show()
+            {
+                log::error!("Failed to show the tray's notice: {}", err);
+            }
+        });
+    }
+}
