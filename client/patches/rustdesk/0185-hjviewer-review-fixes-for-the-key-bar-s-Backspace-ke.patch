 Widget app(Widget child) =>
     MaterialApp(home: Scaffold(body: Center(child: child)));
@@ -178,6 +178,24 @@ void main() {
     semantics.dispose();
   });
 
+  testWidgets('an icon key on the phone\'s key bar is one button with its name',
+      (tester) async {
+    final semantics = tester.ensureSemantics();
+    // mobile/pages/remote_page.dart, KeyHelpTools.wrap: the bar's Backspace key among its
+    // neighbours, without a tooltip (it would take the long press)
+    await tester.pumpWidget(app(Wrap(children: [
