+      TextButton(
+          onPressed: () {},
+          child: hjvNamedKeyIcon(Icons.backspace_outlined,
+              label: '지우기', size: 14)),
+    ])));
+    expect(
+        tester.getSemantics(find.byType(TextButton).last),
+        containsSemantics(label: '지우기', isButton: true, hasTapAction: true));
+    semantics.dispose();
+  });
+
   test('the PC list tabs: filled when selected, outlined otherwise', () {
     const deviceGroupFill = IconData(0xe748, fontFamily: 'DeviceGroup');
     const deviceGroupOutline = IconData(0xe623, fontFamily: 'DeviceGroup');
