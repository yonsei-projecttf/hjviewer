@@ -1247,7 +1248,7 @@ class _KeyHelpToolsState extends State<KeyHelpTools> {
         : on
             ? p.primaryStrong
             : p.text;
-    final button = TextButton(
+    return TextButton(
         style: TextButton.styleFrom(
           // HJViewer: keys of at least 40 x 40 (U57)
           minimumSize: Size(40, 40),
@@ -1266,12 +1267,11 @@ class _KeyHelpToolsState extends State<KeyHelpTools> {
           side: BorderSide(color: on ? Colors.transparent : p.border),
         ),
         child: icon != null
-            ? Icon(icon, size: 14, color: fg)
+            // HJViewer: an icon key's name on the button itself (no tooltip,
+            // which would take the long press)
+            ? hjvNamedKeyIcon(icon, label: label, size: 14, color: fg)
             : Text(translate(text), style: TextStyle(color: fg, fontSize: 11)),
         onPressed: onPressed);
-    // HJViewer: an icon key's name, without a tooltip, which would take the
-    // long press
-    return label == null ? button : Semantics(label: label, child: button);
   }
 
   _updateRect() {
