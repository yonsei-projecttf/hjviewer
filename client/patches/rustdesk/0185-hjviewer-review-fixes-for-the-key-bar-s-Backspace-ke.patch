 flutter/lib/common/hjv_semantics.dart     |  8 ++++++++
 flutter/lib/mobile/pages/remote_page.dart | 10 +++++-----
 flutter/test/hjviewer_semantics_test.dart | 20 +++++++++++++++++++-
 3 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/flutter/lib/common/hjv_semantics.dart b/flutter/lib/common/hjv_semantics.dart
index 4b6fd24..98305b0 100644
--- a/flutter/lib/common/hjv_semantics.dart
+++ b/flutter/lib/common/hjv_semantics.dart
@@ -21,6 +21,14 @@ Widget hjvHeaderSemantics(Widget child) =>
 Widget hjvLiveRegion(Widget child) =>
     Semantics(container: true, liveRegion: true, child: child);
 
+/// The icon of a key that shows only an icon (the phone's key bar), named for screen readers. The
+/// name is the icon's semantic label, so that it lands on the button around it: a Semantics label
+/// wrapped around the button stays a node of its own, and the button is read as an unnamed
+/// "button". No tooltip, which would take the long press.
+Icon hjvNamedKeyIcon(IconData icon,
+        {required String? label, double? size, Color? color}) =>
+    Icon(icon, size: size, color: color, semanticLabel: label);
+
 /// The device group font's outlined twin of upstream's filled 'Accessible devices' icon
 /// (common.dart IconFont.deviceGroupOutline / deviceGroupFill, kept here without the bridge).
 const IconData _kDeviceGroupFill = IconData(0xe748, fontFamily: 'DeviceGroup');
