+/// MaterialApp's highContrastTheme and highContrastDarkTheme (main.dart): the theme with a thin
+/// border in the tertiary text colour around the fields, for iOS's Increase Contrast and
+/// Windows's high contrast, where the fill alone hardly sets a field off its background.
+ThemeData hjvHighContrast(ThemeData theme) {
+  final p = theme.brightness == Brightness.dark
+      ? HjvPalette.dark
+      : HjvPalette.light;
+  final border = OutlineInputBorder(
+    borderRadius: BorderRadius.circular(HjvRadius.md),
+    borderSide: BorderSide(color: p.textTertiary),
+  );
+  return theme.copyWith(
+      inputDecorationTheme: theme.inputDecorationTheme
+          .copyWith(border: border, enabledBorder: border));
+}
