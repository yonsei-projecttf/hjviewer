+/// U+2060 WORD JOINER: no line break on either side of it, and nothing drawn.
+const String kHjvWordJoiner = '\u2060';
+
+final _hangul = RegExp(r'[\u1100-\u11FF\u3130-\u318F\uAC00-\uD7A3]');
+
+/// Korean text that breaks lines only at spaces, as CSS's word-break: keep-all: Flutter breaks
+/// Hangul between any two syllables ('연세포/탈로'), so each word with Hangul in it gets a word
+/// joiner between its characters. Words without Hangul (URLs, IDs, English) and the spaces and
+/// line breaks stay as they are; a word longer than the line still breaks where it must. For
+/// shown text only: not for text that is compared, copied or sent on.
+String hjvKeepAll(String s) {
+  if (!_hangul.hasMatch(s)) return s;
+  return s.splitMapJoin(RegExp(r'\S+'),
+      onMatch: (m) {
+        final word = m[0]!;
+        return _hangul.hasMatch(word)
+            ? word.characters.join(kHjvWordJoiner)
+            : word;
+      },
+      onNonMatch: (space) => space);
+}
+
+/// A peer's online state as a dot that does not rest on colour alone: a filled dot in the
+/// success colour when online, a hollow ring in the tertiary text colour when offline.
+Widget hjvOnlineDot(BuildContext context, bool online, {double size = 6}) {
+  final p = HjvPalette.of(context);
+  return Container(
+    width: size,
+    height: size,
+    decoration: BoxDecoration(
+      shape: BoxShape.circle,
+      color: online ? p.success : null,
+      border: online ? null : Border.all(color: p.textTertiary, width: 1.2),
+    ),
+  );
+}
+
+/// What a screen reader says for a peer's card, in one go: its name, whether it is online, the
+/// platform, user@host and the note, the empty ones left out.
+String hjvPeerSemanticsLabel(
+        {required String title,
+        required String state,
+        String platform = '',
+        String name = '',
+        String note = ''}) =>
+    [title, state, platform, name, note]
+        .where((e) => e.trim().isNotEmpty)
+        .join(', ');
