diff --git a/flutter/test/hjviewer_style_test.dart b/flutter/test/hjviewer_style_test.dart
new file mode 100644
index 0000000..e5c881e
--- /dev/null
+++ b/flutter/test/hjviewer_style_test.dart
@@ -0,0 +1,136 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The app's look (common/hjv_style.dart): the palettes' contrast, Korean line breaks at spaces
+// only, and the peer cards' online dot and screen reader label. Plain Flutter, no bridge.
+
+double contrast(Color a, Color b) {
+  final la = a.computeLuminance();
+  final lb = b.computeLuminance();
+  final hi = la > lb ? la : lb;
+  final lo = la > lb ? lb : la;
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+const wj = kHjvWordJoiner;
+
+void main() {
+  for (final (name, p) in [
+    ('light', HjvPalette.light),
+    ('dark', HjvPalette.dark),
+  ]) {
+    test('$name: small text reaches 4.5:1 (WCAG AA) where it is drawn', () {
+      final grounds = {
+        'surface': p.surface,
+        'card': p.card,
+        'canvas': p.canvas,
+        'fill': p.fill,
+      };
+      final texts = {
+        'text': p.text,
+        'textSecondary': p.textSecondary,
+        'textTertiary': p.textTertiary,
+        'primaryStrong': p.primaryStrong,
+        'dangerText': p.dangerText,
+      };
+      for (final t in texts.entries) {
+        for (final g in grounds.entries) {
+          expect(contrast(t.value, g.value), greaterThanOrEqualTo(4.5),
+              reason: '${t.key} on ${g.key}');
+        }
+      }
+      // the text on the accent's soft tint (the selected side bar row, the ID's name)
+      expect(contrast(p.primaryStrong, p.primarySoft), greaterThanOrEqualTo(4.5));
+    });
+
+    test('$name: white on a filled button reaches 4.5:1, at rest and hovered', () {
+      expect(contrast(Colors.white, p.primaryFill), greaterThanOrEqualTo(4.5));
+      expect(contrast(Colors.white, p.primaryFillHover),
+          greaterThanOrEqualTo(4.5));
+      expect(contrast(Colors.white, p.dangerFill), greaterThanOrEqualTo(4.5));
+    });
+
+    test('$name: the hierarchy of the greys stays as it was', () {
+      expect(contrast(p.textSecondary, p.surface),
+          greaterThan(contrast(p.textTertiary, p.surface)));
+      expect(contrast(p.textTertiary, p.surface),
+          greaterThan(contrast(p.textDisabled, p.surface)));
+    });
+  }
+
+  group('hjvKeepAll', () {
+    test('joins the characters of each Korean word, the spaces stay breaks', () {
+      expect(hjvKeepAll('연세포탈로 로그인'),
+          '연$wj세$wj포$wj탈$wj로 로$wj그$wj인');
+      expect(hjvKeepAll('[아님]을 누르세요.'),
+          '[$wj아$wj님$wj]$wj을 누$wj르$wj세$wj요$wj.');
+    });
+
+    test('leaves words without Hangul, and text without it, as they are', () {
+      expect(hjvKeepAll('Log in with your Yonsei Portal account.'),
+          'Log in with your Yonsei Portal account.');
+      expect(hjvKeepAll('ID 123 456 789 확인'), 'ID 123 456 789 확$wj인');
+      expect(hjvKeepAll('https://example.com 에서'), 'https://example.com 에$wj서');
+      expect(hjvKeepAll(''), '');
+    });
+
+    test('keeps the spaces and line breaks, and takes nothing away', () {
+      const s = '이 PC를 연결받으려면\n연세포탈로  로그인하세요. (1.8.2)';
+      final out = hjvKeepAll(s);
+      expect(out.replaceAll(wj, ''), s);
+      expect(out.split('\n').length, 2);
+      expect(out.contains('  '), isTrue);
+      // a syllable of decomposed jamo stays one character
+      expect(hjvKeepAll('\u1112\u1161\u11AB글'), '\u1112\u1161\u11AB$wj글');
+    });
+  });
+
+  test('a peer card\'s screen reader label: the parts in order, the empty ones left out', () {
+    expect(
+        hjvPeerSemanticsLabel(
+            title: '연구실 PC',
+            state: '오프라인',
+            platform: 'Windows',
+            name: 'user@LAB-PC'),
+        '연구실 PC, 오프라인, Windows, user@LAB-PC');
+    expect(
+        hjvPeerSemanticsLabel(
+            title: '123 456 789',
+            state: 'Online',
+            platform: '',
+            name: ' ',
+            note: 'the printer room'),
+        '123 456 789, Online, the printer room');
+  });
+
