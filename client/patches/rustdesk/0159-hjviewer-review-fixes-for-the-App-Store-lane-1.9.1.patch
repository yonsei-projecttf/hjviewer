diff --git a/flutter/test/hjviewer_android_test.dart b/flutter/test/hjviewer_android_test.dart
index c335cde..5d8cf85 100644
--- a/flutter/test/hjviewer_android_test.dart
+++ b/flutter/test/hjviewer_android_test.dart
@@ -7,7 +7,8 @@ import 'package:flutter_hbb/common/hjv_style.dart';
 import 'package:flutter_hbb/common/hjviewer_android_rules.dart';
 import 'package:flutter_test/flutter_test.dart';
 
-// HJViewer's controller-only Android build and the phones' platform files, without the bridge.
+// HJViewer's controller-only Android build, the phones' platform files and the About links,
+// without the bridge.
 
 /// What a voice call does, in order.
 /// An Android colour resource of [file] (res/values*/...), as a Color.
@@ -148,6 +149,8 @@ void main() {
     for (final pod in ['MTBBarcodeScanner', 'qr_code_scanner', 'image_picker']) {
       expect(pbx, isNot(contains(pod)), reason: pod);
     }
+    // nor the Photos framework, which only the photo picker needed
+    expect(pbx, isNot(contains('Photos')));
     for (final file in [
       'Info.plist',
       'ko.lproj/InfoPlist.strings',
@@ -210,4 +213,44 @@ void main() {
     expect(plist, isNot(contains('<string>rustdesk</string>')));
     expect(plist, isNot(contains('com.carriez.rustdesk')));
   });
+
+  test('the About links open in the system browser (1.9.1)', () {
+    // never a web view inside the app; on the desktop and on phones
+    String part(String file, String from, String to) {
+      final text = File(file).readAsStringSync();
+      final start = text.indexOf(from);
+      expect(start, isNonNegative, reason: '$file: $from');
+      return text.substring(start, text.indexOf(to, start));
+    }
+
+    const external = r',\s*mode: LaunchMode\.externalApplication\)';
+    final policy = RegExp.escape(
+        'https://github.com/yonsei-projecttf/hjviewer/blob/main/docs/privacy.md');
+    final repo = RegExp.escape('https://github.com/yonsei-projecttf/hjviewer');
+    final desktop = part('lib/desktop/pages/desktop_setting_page.dart',
+        'class _AboutState', '\nclass ');
+    final phone = part('lib/mobile/pages/settings_page.dart',
+        'title: Text(translate("About"))', 'return settings;');
+    for (final about in [desktop, phone]) {
+      final opened = RegExp(r'launchUrl(String)?\(').allMatches(about).length;
+      expect(opened, greaterThan(1));
+      expect('mode: LaunchMode.externalApplication'.allMatches(about).length,
+          opened);
+      expect(RegExp("launchUrlString\\(\\s*'$policy'$external").hasMatch(about),
+          isTrue);
+    }
+    // the privacy policy, the website and the source code; the phone's source link is `url`
+    expect(
+        RegExp("launchUrlString\\('$repo'$external").allMatches(desktop).length,
+        2);
+    expect(RegExp('launchUrl\\(Uri\\.parse\\(url\\)$external').hasMatch(phone),
+        isTrue);
+    expect(
+        File('lib/mobile/pages/settings_page.dart').readAsStringSync(),
+        contains(
+            "const url = 'https://github.com/yonsei-projecttf/hjviewer';"));
+    // the policy's link in Korean, as the guideline for privacy policies names it
+    expect(File('../src/lang/ko.rs').readAsStringSync(),
+        contains('("Privacy Statement", "개인정보 처리방침"),'));
+  });
 }
