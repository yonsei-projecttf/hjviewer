diff --git a/flutter/lib/common/hjv_update.dart b/flutter/lib/common/hjv_update.dart
index 722515a..a396e5e 100644
--- a/flutter/lib/common/hjv_update.dart
+++ b/flutter/lib/common/hjv_update.dart
@@ -147,13 +147,21 @@ class HjvHost {
   /// update screen goes by: the core judges every iPhone by the same entry.
   Future<String> deviceValue() async {
     String? installer, os;
+    // first and on its own, so that a failing device info leaves no App Store install on
+    // TestFlight's way
+    if (isIOS) {
+      try {
+        iosInstaller = (await PackageInfo.fromPlatform()).installerStore ?? '';
+      } catch (e) {
+        debugPrint('hjv update: installer: $e');
+      }
+    }
     try {
       if (isAndroid) {
         os = androidVersion > 0 ? '$androidVersion' : null;
         installer = (await PackageInfo.fromPlatform()).installerStore ?? '';
       } else if (isIOS) {
         os = (await DeviceInfoPlugin().iosInfo).systemVersion;
-        iosInstaller = (await PackageInfo.fromPlatform()).installerStore ?? '';
       } else if (isWindows) {
         final info = await DeviceInfoPlugin().windowsInfo;
         os = '${info.majorVersion}.${info.minorVersion}.${info.buildNumber}';
diff --git a/flutter/lib/common/hjviewer_access_texts.dart b/flutter/lib/common/hjviewer_access_texts.dart
index 03bd6c4..d05b5dc 100644
--- a/flutter/lib/common/hjviewer_access_texts.dart
+++ b/flutter/lib/common/hjviewer_access_texts.dart
@@ -950,7 +950,8 @@ bool hjvAsksBeforeConnect(
 
 /// The scheme a pinned server build takes links in: hjviewer:// alone from 1.9.1 (D-13; 1.9.0
 /// also took rustdesk://, which upstream's app registers too); any other build takes what
-/// upstream does.
+/// upstream does, of what reaches it: from 1.9.1 the phones register hjviewer:// alone
+/// (AndroidManifest.xml, Info.plist).
 bool hjvLinkTakesScheme(String scheme, {required bool pinned}) =>
     !pinned || scheme == 'hjviewer';
 
