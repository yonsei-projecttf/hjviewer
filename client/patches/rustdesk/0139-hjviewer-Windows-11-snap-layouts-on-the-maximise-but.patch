new file mode 100644
index 0000000..b903aad
--- /dev/null
+++ b/flutter/test/hjv_caption_test.dart
@@ -0,0 +1,279 @@
+// HJViewer (U44): the box the title bar's maximise button tells Windows 11 about, the option that
+// turns the snap layouts off, and the channel to the runner (flutter/windows/runner/hjv_caption.cpp).
+// Pure: no bridge.
+import 'dart:io';
+
+import 'package:flutter/services.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_hbb/desktop/widgets/hjv_caption.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const _name = 'hjv/caption-test';
+
+/// The calls the runner got; [answer] is what setMaxButton returns, null for no runner at all.
+class _Runner {
+  _Runner() {
+    _messenger.setMockMethodCallHandler(channel, (call) async {
+      calls.add(call);
+      if (answer == null) throw MissingPluginException();
+      return call.method == 'setMaxButton' ? answer : null;
+    });
+  }
+
+  static TestDefaultBinaryMessenger get _messenger =>
+      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
+
+  final channel = const MethodChannel(_name);
+  final calls = <MethodCall>[];
+  bool? answer = true;
+
+  List<Object?> boxes() => calls
+      .where((c) => c.method == 'setMaxButton')
+      .map((c) => c.arguments)
+      .toList();
+
+  /// The runner tells Dart something, as hjv_caption.cpp's Send does.
+  Future<void> tell(String method, [Object? arguments]) async {
+    await _messenger.handlePlatformMessage(
+        _name,
+        const StandardMethodCodec()
+            .encodeMethodCall(MethodCall(method, arguments)),
+        (_) {});
+  }
+
+  void dispose() => _messenger.setMockMethodCallHandler(channel, null);
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  group('hjvSnapRect', () {
+    final box = Rect.fromLTWH(760, 0, 40, 27);
+
+    test('is the box in physical pixels, less the top resize band', () {
+      expect(hjvSnapRect(box, 1.0, 5), [760, 5, 800, 27]);
+      expect(hjvSnapRect(box, 1.25, 5), [950, 7, 1000, 34]);
+      expect(hjvSnapRect(box, 1.5, 5), [1140, 8, 1200, 41]);
+      expect(hjvSnapRect(box, 2.0, 5), [1520, 10, 1600, 54]);
+    });
+
+    test('reaches the top when the window has no band (maximised)', () {
+      expect(hjvSnapRect(box, 1.0, 0), [760, 0, 800, 27]);
+    });
+
+    test('measures the band from the view top, not from the button', () {
+      expect(hjvSnapRect(Rect.fromLTWH(760, 1, 40, 26), 1.0, 5),
+          [760, 5, 800, 27]);
+    });
+
+    test('rounds edges up, ignoring float noise above a whole pixel', () {
+      // 10 * 1.1 is 11.000000000000002
+      expect(
+          hjvSnapRect(Rect.fromLTWH(10, 0, 20, 10), 1.1, 0), [11, 0, 33, 11]);
+      expect(
+          hjvSnapRect(Rect.fromLTWH(10.5, 0, 20, 10), 1.0, 0), [11, 0, 31, 10]);
+    });
+
+    test('is null when nothing can be hit', () {
+      expect(hjvSnapRect(box, 1.0, 27), isNull);
+      expect(hjvSnapRect(box, 1.0, 40), isNull);
+      expect(hjvSnapRect(Rect.fromLTWH(760, 0, 0, 27), 1.0, 5), isNull);
+      expect(hjvSnapRect(box, 0, 5), isNull);
+      expect(
+          hjvSnapRect(const Rect.fromLTRB(0, 0, double.infinity, 27), 1.0, 5),
+          isNull);
+    });
+  });
+
+  test('the local option turns the snap layouts off, the default otherwise',
+      () {
+    expect(hjvSnapLayoutsOn('N'), isFalse);
+    expect(hjvSnapLayoutsOn('Y'), isTrue);
+    expect(hjvSnapLayoutsOn(''), kHjvSnapLayoutsDefault);
+    expect(hjvSnapLayoutsOn('n'), kHjvSnapLayoutsDefault);
+    expect(kHjvOptionSnapLayouts, 'hjv-snap-layouts');
+  });
+
+  test('the window menu has its own switch at the gate', () {
+    expect(kHjvWindowMenuDefault, isTrue);
+  });
+
+  test(
+      'neither the connection window nor the install window gets the menu or the snap layouts',
+      () {
+    // common.dart's DesktopType names, as desktopType?.name gives them
+    for (final process in [
+      'main',
+      'remote',
+      'fileTransfer',
+      'viewCamera',
+      'terminal',
+      'portForward'
+    ]) {
+      expect(hjvCaptionWindow(process, cmTabs: false), isTrue, reason: process);
+      expect(hjvCaptionWindow(process, cmTabs: true), isFalse, reason: process);
+    }
+    expect(hjvCaptionWindow('cm', cmTabs: true), isFalse);
+    expect(hjvCaptionWindow('cm', cmTabs: false), isFalse);
+    // the --install process sets no desktopType, and its InstallPage's tabs are DesktopTabType.main
+    expect(hjvCaptionWindow(null, cmTabs: false), isFalse);
+  });
+
+  test('the names hjvCaptionWindow reads are the ones main.dart sets', () {
+    final common = File('lib/common.dart').readAsStringSync();
+    final names = RegExp(r'enum DesktopType \{([^}]*)\}')
+        .firstMatch(common)!
+        .group(1)!
+        .split(',')
+        .map((n) => n.trim())
+        .where((n) => n.isNotEmpty)
+        .toSet();
+    expect(names, contains('cm'));
+    final main = File('lib/main.dart').readAsStringSync();
+    expect(main, contains('desktopType = DesktopType.cm;'));
+    // the install branch starts the install page without naming a desktopType
+    expect(
+        RegExp(r"args\.contains\('--install'\)\) \{\s*runInstallPage\(\);\s*\}")
+            .hasMatch(main),
+        isTrue);
+    expect(File('lib/desktop/pages/install_page.dart').readAsStringSync(),
+        isNot(contains('desktopType =')));
+  });
+
+  group('HjvCaption', () {
+    late _Runner runner;
+    late HjvCaption caption;
+    final owner = Object();
+
+    setUp(() {
+      runner = _Runner();
+      caption = HjvCaption(runner.channel);
+    });
+    tearDown(() => runner.dispose());
+
+    test('sends a box once, and null when its owner lets go', () async {
+      caption.update(owner, [760, 5, 800, 27], () {});
+      caption.update(owner, [760, 5, 800, 27], () {});
+      await pumpEventQueue();
+      expect(runner.boxes(), [
+        [760, 5, 800, 27]
+      ]);
+      caption.release(Object());
+      await pumpEventQueue();
+      expect(runner.boxes(), hasLength(1));
+      caption.release(owner);
+      await pumpEventQueue();
+      expect(runner.boxes(), [
+        [760, 5, 800, 27],
+        null
+      ]);
+    });
+
+    test('a button that cannot be clicked is not sent', () async {
+      caption.update(owner, [760, 5, 800, 27], () {});
+      caption.update(owner, [760, 5, 800, 27], null);
+      caption.update(owner, null, () {});
+      await pumpEventQueue();
+      expect(runner.boxes(), [
+        [760, 5, 800, 27],
+        null
+      ]);
+    });
+
+    test('stops when the runner refuses (Windows 10)', () async {
+      runner.answer = false;
+      caption.update(owner, [760, 5, 800, 27], () {});
+      await pumpEventQueue();
+      caption.update(owner, [740, 5, 780, 27], () {});
+      caption.release(owner);
+      await pumpEventQueue();
+      expect(runner.boxes(), hasLength(1));
+    });
+
+    test('stops when there is no runner half', () async {
+      runner.answer = null;
+      caption.update(owner, [760, 5, 800, 27], () {});
+      await pumpEventQueue();
+      caption.update(owner, [740, 5, 780, 27], () {});
+      await pumpEventQueue();
+      expect(runner.boxes(), hasLength(1));
+    });
+
+    test('follows what Windows says and runs the click', () async {
+      var clicks = 0;
+      caption.update(owner, [760, 5, 800, 27], () => clicks++);
+      await pumpEventQueue();
+      await runner.tell('maxButton', kHjvMaxHover);
+      expect(caption.state.value, kHjvMaxHover);
+      await runner.tell('maxButton', kHjvMaxPressed);
+      expect(caption.state.value, kHjvMaxPressed);
+      await runner.tell('maxButtonClick');
+      expect(clicks, 1);
+      await runner.tell('maxButton', kHjvMaxNone);
+      expect(caption.state.value, kHjvMaxNone);
+
+      caption.release(owner);
+      await pumpEventQueue();
+      await runner.tell('maxButton', kHjvMaxHover);
+      expect(caption.state.value, kHjvMaxNone);
+      await runner.tell('maxButtonClick');
+      expect(clicks, 1);
+    });
+
+    test('asks for the window menu, and does not throw without a runner',
+        () async {
+      await caption.showWindowMenu();
+      expect(runner.calls.map((c) => c.method), ['showWindowMenu']);
+      runner.answer = null;
+      await caption.showWindowMenu();
+    });
+  });
+
+  testWidgets('the button reports its box after layout and on resize',
+      (tester) async {
+    final runner = _Runner();
+    addTearDown(runner.dispose);
+    addTearDown(tester.view.reset);
+    final caption = HjvCaption(runner.channel);
+    tester.view.physicalSize = const Size(1600, 1200);
+    tester.view.devicePixelRatio = 2.0;
+    final seen = <int>[];
+    Widget app(VoidCallback? onTap) => Align(
+          alignment: Alignment.topRight,
+          child: HjvSnapMaxButton(
+            caption: caption,
+            onTap: onTap,
+            topBand: () => 5,
+            builder: (context, windows) {
+              seen.add(windows);
+              return const SizedBox(width: 40, height: 27);
+            },
+          ),
+        );
+
+    await tester.pumpWidget(app(() {}));
+    await tester.pump();
+    expect(runner.boxes().last, [1520, 10, 1600, 54]);
+
+    tester.view.physicalSize = const Size(1400, 1200);
+    await tester.pump();
+    await tester.pump();
+    expect(runner.boxes().last, [1320, 10, 1400, 54]);
+
+    await runner.tell('maxButton', kHjvMaxHover);
+    await tester.pump();
+    expect(seen.last, kHjvMaxHover);
+
+    await tester.pumpWidget(app(null));
+    await tester.pump();
+    expect(runner.boxes().last, isNull);
+
+    await tester.pumpWidget(app(() {}));
+    await tester.pump();
+    expect(runner.boxes().last, [1320, 10, 1400, 54]);
+
+    await tester.pumpWidget(const SizedBox());
+    await tester.pump();
+    expect(runner.boxes().last, isNull);
+  });
+}
