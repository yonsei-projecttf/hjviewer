@@ -0,0 +1,216 @@
+// HJViewer (U44): on Windows 11, Windows' snap layouts over the maximise button the title bar
+// draws, and Windows' window menu on a right-click of the bar. The native half is
+// flutter/windows/runner/hjv_caption.cpp; each window (the main one, each session window) is its
+// own engine with its own channel and its own copy of this file's state.
+import 'dart:math' as math;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/scheduler.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter/widgets.dart';
+
+/// A local option: 'N' leaves the maximise button to Flutter, as before 1.9; 'Y' gives it to
+/// Windows; anything else takes [kHjvSnapLayoutsDefault].
+const kHjvOptionSnapLayouts = 'hjv-snap-layouts';
+
+/// The Windows gate (decisions.md): a failed device check ships U44's snap half off by making
+/// this false. The window menu does not depend on it.
+const kHjvSnapLayoutsDefault = true;
+
+/// Whether Windows owns the maximise button, from the local option's value.
+bool hjvSnapLayoutsOn(String option) =>
+    option == 'Y' || (option != 'N' && kHjvSnapLayoutsDefault);
+
+/// The Windows gate (decisions.md) for the other half: a failed device check ships the window
+/// menu on a right-click of the title bar off by making this false. The snap layouts do not
+/// depend on it.
+const kHjvWindowMenuDefault = true;
+
+/// Whether a window's title bar may get Windows' window menu and its snap layouts (each half
+/// also behind its own switch above). [process] is the name of the process's DesktopType
+/// (common.dart's desktopType); it is null only in the --install process, whose InstallPage
+/// builds its tabs as DesktopTabType.main. [cmTabs]: the tab bar is the connection window's.
+/// Neither the connection window (fixed size, and a close that would skip its own question) nor
+/// the install window gets them.
+bool hjvCaptionWindow(String? process, {required bool cmTabs}) =>
+    process != null && process != 'cm' && !cmTabs;
+
+/// What Windows says about the pointer over the button while Windows owns it.
+const kHjvMaxNone = 0;
+const kHjvMaxHover = 1;
+const kHjvMaxPressed = 2;
+
+/// The box Windows hit-tests, in the view's physical pixels ([left, top, right, bottom]): [box]
+/// (logical, from the view's top-left) less the band from the view's top down to [topBand] where
+/// the window resizes; null when nothing is left. The edges round up: a physical pixel x is inside
+/// the logical box [l, r) exactly when ceil(l * ratio) <= x < ceil(r * ratio), so the button and
+/// its neighbours never share a pixel.
+List<int>? hjvSnapRect(Rect box, double devicePixelRatio, double topBand) {
+  if (!box.isFinite || devicePixelRatio <= 0 || topBand.isNaN) return null;
+  final top = math.max(box.top, topBand);
+  // less a hair, so that float noise above a whole pixel does not move an edge by one
+  int edge(double v) => (v * devicePixelRatio - 1e-6).ceil();
+  final edges = [edge(box.left), edge(top), edge(box.right), edge(box.bottom)];
+  return edges[0] < edges[2] && edges[1] < edges[3] ? edges : null;
+}
+
+class HjvCaption {
+  HjvCaption([MethodChannel? channel])
+      : _channel = channel ?? const MethodChannel('hjv/caption');
+
+  static final instance = HjvCaption();
+
+  final MethodChannel _channel;
+
+  /// [kHjvMaxNone], [kHjvMaxHover] or [kHjvMaxPressed].
+  final state = ValueNotifier<int>(kHjvMaxNone);
+
+  Object? _owner;
+  VoidCallback? _onClick;
+  List<int>? _sent;
+  bool _listening = false;
+  // Windows 10, or no native half: the button stays Flutter's.
+  bool _off = false;
+
+  /// The button [owner] is at [rect] ([hjvSnapRect]); Windows' click on it runs [onClick]. A null
+  /// [rect] or [onClick] (a button that cannot be clicked) gives the button back to Flutter.
+  void update(Object owner, List<int>? rect, VoidCallback? onClick) {
+    if (rect == null || onClick == null) {
+      release(owner);
+      return;
+    }
+    _owner = owner;
+    _onClick = onClick;
+    _send(rect);
+  }
+
+  /// [owner] is gone or cannot be clicked: the button is Flutter's again.
+  void release(Object owner) {
+    if (!identical(owner, _owner)) return;
+    _owner = null;
+    _onClick = null;
+    state.value = kHjvMaxNone;
+    _send(null);
+  }
+
+  Future<void> showWindowMenu() async {
+    try {
+      await _channel.invokeMethod<void>('showWindowMenu');
+    } catch (e) {
+      debugPrint('hjv caption: menu: $e');
+    }
+  }
+
+  Future<void> _send(List<int>? rect) async {
+    if (_off || listEquals(rect, _sent)) return;
+    _listen();
+    _sent = rect;
+    try {
+      final taken = await _channel.invokeMethod<bool>('setMaxButton', rect);
+      if (rect != null && taken != true) _off = true;
+    } on MissingPluginException {
+      _off = true;
+    } catch (e) {
+      debugPrint('hjv caption: $e');
+    }
+  }
+
+  void _listen() {
+    if (_listening) return;
+    _listening = true;
+    _channel.setMethodCallHandler((call) async {
+      if (call.method == 'maxButton') {
+        final value = call.arguments;
+        state.value = _owner != null && value is int ? value : kHjvMaxNone;
+      } else if (call.method == 'maxButtonClick') {
+        _onClick?.call();
+      }
+      return null;
+    });
+  }
+}
+
+/// Wraps the title bar's maximise button: after each layout it tells Windows where the button
+/// is, and [builder] gets what Windows says about the pointer while Windows owns it.
+class HjvSnapMaxButton extends StatefulWidget {
+  const HjvSnapMaxButton({
+    super.key,
+    required this.onTap,
+    required this.topBand,
+    required this.builder,
+    this.caption,
+  });
+
+  /// The button's own tap; null (a button that cannot be clicked) leaves it to Flutter.
+  final VoidCallback? onTap;
+
+  /// The height of the window's top resize band, read at each report.
+  final double Function() topBand;
+
+  final Widget Function(BuildContext context, int windows) builder;
+
+  /// For tests; [HjvCaption.instance] otherwise.
+  final HjvCaption? caption;
+
+  @override
+  State<HjvSnapMaxButton> createState() => _HjvSnapMaxButtonState();
+}
+
+class _HjvSnapMaxButtonState extends State<HjvSnapMaxButton>
+    with WidgetsBindingObserver {
+  final _box = GlobalKey();
+  var _scheduled = false;
+
+  HjvCaption get _caption => widget.caption ?? HjvCaption.instance;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+  }
+
+  @override
+  void didChangeMetrics() => _schedule();
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _caption.release(this);
+    super.dispose();
+  }
+
+  void _schedule() {
+    if (_scheduled) return;
+    _scheduled = true;
+    SchedulerBinding.instance.addPostFrameCallback((_) {
+      _scheduled = false;
+      _report();
+    });
+  }
+
+  void _report() {
+    if (!mounted) return;
+    final box = _box.currentContext?.findRenderObject();
+    if (box is! RenderBox || !box.attached || !box.hasSize) {
+      _caption.release(this);
+      return;
+    }
+    final rect = box.localToGlobal(Offset.zero) & box.size;
+    _caption.update(
+        this,
+        hjvSnapRect(rect, View.of(context).devicePixelRatio, widget.topBand()),
+        widget.onTap);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    _schedule();
+    return KeyedSubtree(
+      key: _box,
+      child: ValueListenableBuilder<int>(
+        valueListenable: _caption.state,
+        builder: (context, windows, _) => widget.builder(context, windows),
+      ),
+    );
+  }
+}
