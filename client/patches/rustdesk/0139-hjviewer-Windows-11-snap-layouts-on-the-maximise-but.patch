diff --git a/flutter/windows/runner/hjv_caption.cpp b/flutter/windows/runner/hjv_caption.cpp
new file mode 100644
index 0000000..88c8a37
--- /dev/null
+++ b/flutter/windows/runner/hjv_caption.cpp
@@ -0,0 +1,374 @@
+// HJViewer (U44). The Flutter view, a child window over the whole client area, answers
+// HTTRANSPARENT over the maximise button that Dart draws, so Windows asks the top-level window,
+// which answers HTMAXBUTTON: Windows 11 then shows its snap layouts there. Windows sends the
+// button's mouse messages to the top-level window as non-client ones; they are handled here and
+// told to Dart (hover, pressed, click), which keeps the look and runs its own maximise/restore.
+// The state lives in a window property on both windows and goes with the view (WM_NCDESTROY),
+// which Flutter destroys before its engine.
+#include "hjv_caption.h"
+
+#include <flutter/encodable_value.h>
+#include <flutter/method_channel.h>
+#include <flutter/standard_method_codec.h>
+#include <flutter_windows.h>
+#include <windows.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+#include <variant>
+
+namespace {
+
+constexpr char kChannel[] = "hjv/caption";
+constexpr wchar_t kProp[] = L"HJViewer.Caption";
+
+// What Dart draws (hjv_caption.dart: kHjvMaxNone, kHjvMaxHover, kHjvMaxPressed).
+constexpr int kStateNone = 0;
+constexpr int kStateHover = 1;
+constexpr int kStatePressed = 2;
+
+struct Caption {
+  HWND top = nullptr;
+  HWND view = nullptr;
+  WNDPROC view_proc = nullptr;
+  flutter::BinaryMessenger* messenger = nullptr;  // the engine's; it outlives the view
+  bool has_max = false;
+  RECT max = {0, 0, 0, 0};  // physical pixels, in the view's client coordinates
+  int state = kStateNone;
+  // Pressed on the button and not released yet: a release on the button is a click, as with
+  // Windows' own button, even after the pointer left it and came back while held.
+  bool armed = false;
+  bool tracking = false;
+};
+
+Caption* GetCaption(HWND hwnd) {
+  return static_cast<Caption*>(GetPropW(hwnd, kProp));
+}
+
+// Windows 11 is 10.0 with build 22000 or later. RtlGetVersion does not depend on the manifest.
+using RtlGetVersionFn = LONG __stdcall(OSVERSIONINFOW* info);
+
+bool IsWindows11() {
+  static int cached = -1;
+  if (cached < 0) {
+    cached = 0;
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    auto rtl_get_version =
+        ntdll != nullptr
+            ? reinterpret_cast<RtlGetVersionFn*>(GetProcAddress(ntdll, "RtlGetVersion"))
+            : nullptr;
+    OSVERSIONINFOW info = {};
+    info.dwOSVersionInfoSize = static_cast<DWORD>(sizeof(info));
+    if (rtl_get_version != nullptr && rtl_get_version(&info) == 0 &&
+        (info.dwMajorVersion > 10 ||
+         (info.dwMajorVersion == 10 && info.dwBuildNumber >= 22000))) {
+      cached = 1;
+    }
+  }
+  return cached == 1;
+}
+
+void Send(const Caption* caption, const char* method, flutter::EncodableValue value) {
+  if (caption->messenger == nullptr) {
+    return;
+  }
+  flutter::MethodChannel<> channel(caption->messenger, kChannel,
+                                   &flutter::StandardMethodCodec::GetInstance());
+  channel.InvokeMethod(method, std::make_unique<flutter::EncodableValue>(std::move(value)));
+}
+
+void SetState(Caption* caption, int state) {
+  if (caption->state == state) {
+    return;
+  }
+  caption->state = state;
+  Send(caption, "maxButton", flutter::EncodableValue(state));
+}
+
+// The thread's own (logical) state of the primary button, as of the message being handled.
+bool LeftButtonDown() {
+  return GetKeyState(VK_LBUTTON) < 0;
+}
+
+// GET_X_LPARAM/GET_Y_LPARAM of <windowsx.h>, written out: signed, for monitors left of or above
+// the primary one.
+POINT ScreenPoint(LPARAM lparam) {
+  POINT point;
+  point.x = static_cast<short>(LOWORD(lparam));
+  point.y = static_cast<short>(HIWORD(lparam));
+  return point;
+}
+
+bool OverMax(const Caption* caption, LPARAM lparam) {
+  if (!caption->has_max) {
+    return false;
+  }
+  // Full screen takes the caption style away (window_manager and desktop_multi_window alike).
+  // Without WS_THICKFRAME window_manager answers HTNOWHERE before this delegate, and without
+  // WS_MAXIMIZEBOX there is nothing to snap: the button stays Flutter's then.
+  const LONG_PTR style = GetWindowLongPtrW(caption->top, GWL_STYLE);
+  if ((style & WS_CAPTION) != WS_CAPTION || (style & WS_THICKFRAME) == 0 ||
+      (style & WS_MAXIMIZEBOX) == 0) {
+    return false;
+  }
+  POINT point = ScreenPoint(lparam);
+  if (!ScreenToClient(caption->view, &point)) {
+    return false;
+  }
+  return PtInRect(&caption->max, point) != FALSE;
+}
+
+void Forget(Caption* caption) {
+  RemovePropW(caption->top, kProp);
+  RemovePropW(caption->view, kProp);
+  delete caption;
+}
+
+LRESULT CALLBACK ViewProc(HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam) {
+  Caption* caption = GetCaption(hwnd);
+  if (caption == nullptr || caption->view_proc == nullptr) {
+    // Not reached: the property lives until WM_NCDESTROY, where the view's own procedure is put
+    // back. A Flutter view's own procedure is its class's.
+    return CallWindowProcW(reinterpret_cast<WNDPROC>(GetClassLongPtrW(hwnd, GCLP_WNDPROC)),
+                           hwnd, message, wparam, lparam);
+  }
+  const WNDPROC next = caption->view_proc;
+  if (message == WM_NCHITTEST && OverMax(caption, lparam)) {
+    return HTTRANSPARENT;  // Windows asks the top-level window next (TopLevelProc).
+  }
+  if (message == WM_NCDESTROY) {
+    SetWindowLongPtrW(hwnd, GWLP_WNDPROC, reinterpret_cast<LONG_PTR>(next));
+    Forget(caption);
+  }
+  return CallWindowProcW(next, hwnd, message, wparam, lparam);
+}
+
+// FlutterDesktopWindowProcCallback, for the top-level window of the view's engine.
+bool TopLevelProc(HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam,
+                  void* /* user_data */, LRESULT* out) {
+  if (message != WM_NCHITTEST && message != WM_NCMOUSEMOVE && message != WM_NCMOUSELEAVE &&
+      message != WM_NCLBUTTONDOWN && message != WM_NCLBUTTONDBLCLK &&
+      message != WM_NCLBUTTONUP) {
+    return false;
+  }
+  Caption* caption = GetCaption(hwnd);
+  if (caption == nullptr || !caption->has_max) {
+    return false;
+  }
+  const bool on_max = wparam == HTMAXBUTTON;
+  switch (message) {
+    case WM_NCHITTEST:
+      if (OverMax(caption, lparam)) {
+        *out = HTMAXBUTTON;
+        return true;
+      }
+      return false;
+    case WM_NCMOUSEMOVE:
+      if (caption->armed && !LeftButtonDown()) {
+        caption->armed = false;  // released where this window did not see it
+      }
+      if (on_max) {
+        if (!caption->tracking) {
+          TRACKMOUSEEVENT track = {};
+          track.cbSize = static_cast<DWORD>(sizeof(track));
+          track.dwFlags = TME_LEAVE | TME_NONCLIENT;
+          track.hwndTrack = hwnd;
+          caption->tracking = TrackMouseEvent(&track) != FALSE;
+        }
+        SetState(caption, caption->armed ? kStatePressed : kStateHover);
+      } else {
+        SetState(caption, kStateNone);
+      }
+      return false;  // DefWindowProc goes on: the snap layouts start there.
+    case WM_NCMOUSELEAVE:
+      caption->tracking = false;
+      if (caption->armed && !LeftButtonDown()) {
+        caption->armed = false;
+      }
+      SetState(caption, kStateNone);
+      return false;
+    case WM_NCLBUTTONDOWN:
+    case WM_NCLBUTTONDBLCLK:
+      if (!on_max) {
+        return false;
+      }
+      caption->armed = true;
+      SetState(caption, kStatePressed);
+      *out = 0;
+      return true;  // Not DefWindowProc: it would draw and track an old-style button.
+    case WM_NCLBUTTONUP: {
+      const bool armed = caption->armed;
+      caption->armed = false;
+      if (!on_max) {
+        return false;
+      }
+      SetState(caption, kStateHover);
+      if (armed) {
+        Send(caption, "maxButtonClick", flutter::EncodableValue());
+      }
+      *out = 0;
+      return true;
+    }
+    default:
+      return false;
+  }
+}
+
+// The box from Dart: [left, top, right, bottom], four ints, not empty.
+bool ParseBox(const flutter::EncodableValue* args, RECT* box) {
+  if (args == nullptr || !std::holds_alternative<flutter::EncodableList>(*args)) {
+    return false;
+  }
+  const flutter::EncodableList& list = std::get<flutter::EncodableList>(*args);
+  if (list.size() != 4) {
+    return false;
+  }
+  LONG edges[4] = {0, 0, 0, 0};
+  for (size_t i = 0; i < 4; ++i) {
+    if (!std::holds_alternative<int32_t>(list[i])) {
+      return false;
+    }
+    edges[i] = std::get<int32_t>(list[i]);
+  }
+  if (edges[0] >= edges[2] || edges[1] >= edges[3]) {
+    return false;
+  }
+  box->left = edges[0];
+  box->top = edges[1];
+  box->right = edges[2];
+  box->bottom = edges[3];
+  return true;
+}
+
+// The first box on Windows 11: the state goes on both windows and the view is subclassed.
+Caption* Install(HWND top, HWND view, flutter::BinaryMessenger* messenger) {
+  if (!IsWindow(view) || GetAncestor(view, GA_ROOT) != top) {
+    return nullptr;
+  }
+  Caption* caption = new Caption();
+  caption->top = top;
+  caption->view = view;
+  caption->messenger = messenger;
+  if (!SetPropW(top, kProp, caption) || !SetPropW(view, kProp, caption)) {
+    Forget(caption);
+    return nullptr;
+  }
+  caption->view_proc = reinterpret_cast<WNDPROC>(
+      SetWindowLongPtrW(view, GWLP_WNDPROC, reinterpret_cast<LONG_PTR>(&ViewProc)));
+  if (caption->view_proc == nullptr) {
+    Forget(caption);
+    return nullptr;
+  }
+  return caption;
+}
+
+void SetMaxButton(HWND top, HWND view, flutter::BinaryMessenger* messenger,
+                  const flutter::EncodableValue* args) {
+  RECT box = {0, 0, 0, 0};
+  const bool valid = IsWindows11() && ParseBox(args, &box);
+  Caption* caption = GetCaption(top);
+  if (caption == nullptr) {
+    if (!valid) {
+      return;
+    }
+    caption = Install(top, view, messenger);
+    if (caption == nullptr) {
+      return;
+    }
+  }
+  const bool same = valid && caption->has_max && caption->max.left == box.left &&
+                    caption->max.top == box.top && caption->max.right == box.right &&
+                    caption->max.bottom == box.bottom;
+  caption->has_max = valid;
+  caption->max = box;
+  if (!valid) {
+    // TopLevelProc skips messages while there is no box, a WM_NCMOUSELEAVE among them: the next
+    // box's first hover asks for one again (a repeated TrackMouseEvent is harmless).
+    caption->tracking = false;
+  }
+  if (!same) {
+    // The button moved (maximised, restored) or went: the pointer is no longer known to be on it.
+    caption->armed = false;
+    SetState(caption, kStateNone);
+  }
+}
+
+void EnableItem(HMENU menu, UINT item, bool enabled) {
+  EnableMenuItem(menu, item,
+                 static_cast<UINT>(MF_BYCOMMAND | (enabled ? MF_ENABLED : MF_GRAYED)));
+}
+
+// The window menu at the cursor, its items as Windows' own caption would set them.
+void ShowWindowMenu(HWND top) {
+  if (!IsWindow(top)) {
+    return;
+  }
+  HMENU menu = GetSystemMenu(top, FALSE);
+  if (menu == nullptr) {
+    return;
+  }
+  const LONG_PTR style = GetWindowLongPtrW(top, GWL_STYLE);
+  const bool zoomed = IsZoomed(top) != FALSE;
+  EnableItem(menu, SC_RESTORE, zoomed);
+  EnableItem(menu, SC_MOVE, !zoomed);
+  EnableItem(menu, SC_SIZE, !zoomed && (style & WS_THICKFRAME) != 0);
+  EnableItem(menu, SC_MINIMIZE, (style & WS_MINIMIZEBOX) != 0);
+  EnableItem(menu, SC_MAXIMIZE, !zoomed && (style & WS_MAXIMIZEBOX) != 0);
+  EnableItem(menu, SC_CLOSE, true);
+  SetMenuDefaultItem(menu, SC_CLOSE, FALSE);
+  POINT point = {0, 0};
+  if (!GetCursorPos(&point)) {
+    return;
+  }
+  const UINT align =
+      static_cast<UINT>(GetSystemMetrics(SM_MENUDROPALIGNMENT) != 0 ? TPM_RIGHTALIGN
+                                                                     : TPM_LEFTALIGN);
+  const BOOL command =
+      TrackPopupMenu(menu, static_cast<UINT>(align | TPM_RETURNCMD | TPM_RIGHTBUTTON),
+                     static_cast<int>(point.x), static_cast<int>(point.y), 0, top, nullptr);
+  if (command != 0) {
+    PostMessageW(top, WM_SYSCOMMAND, static_cast<WPARAM>(command), 0);
+  }
+}
+
+}  // namespace
+
+void HjvCaptionAttach(flutter::FlutterViewController* controller) {
+  if (controller == nullptr || controller->engine() == nullptr ||
+      controller->view() == nullptr) {
+    return;
+  }
+  HWND view = controller->view()->GetNativeWindow();
+  HWND top = view != nullptr ? GetAncestor(view, GA_ROOT) : nullptr;
+  flutter::BinaryMessenger* messenger = controller->engine()->messenger();
+  if (top == nullptr || top == view || messenger == nullptr) {
+    return;
+  }
+  // Each engine has its own delegate list, so every window registers the same function. It does
+  // nothing until a window has a Caption (GetCaption).
+  FlutterDesktopPluginRegistrarRegisterTopLevelWindowProcDelegate(
+      controller->engine()->GetRegistrarForPlugin("HjvCaption"), &TopLevelProc, nullptr);
+  // Like "bumpMouse" in flutter_window.cpp: the messenger keeps the handler after the channel
+  // object goes. The handler runs only while the engine (and so its view) lives.
+  flutter::MethodChannel<> channel(messenger, kChannel,
+                                   &flutter::StandardMethodCodec::GetInstance());
+  channel.SetMethodCallHandler(
+      [top, view, messenger](const flutter::MethodCall<>& call,
+                             std::unique_ptr<flutter::MethodResult<>> result) {
+        const std::string& method = call.method_name();
+        if (method == "setMaxButton") {
+          SetMaxButton(top, view, messenger, call.arguments());
+          const Caption* caption = GetCaption(top);
+          result->Success(flutter::EncodableValue(caption != nullptr && caption->has_max));
+        } else if (method == "showWindowMenu") {
+          // Answer first: TrackPopupMenu runs its own message loop, in which the engine's tasks
+          // go on, so Dart does not wait for the menu.
+          result->Success();
+          ShowWindowMenu(top);
+        } else {
+          result->NotImplemented();
+        }
+      });
+}
diff --git a/flutter/windows/runner/hjv_caption.h b/flutter/windows/runner/hjv_caption.h
new file mode 100644
index 0000000..064e85e
--- /dev/null
+++ b/flutter/windows/runner/hjv_caption.h
@@ -0,0 +1,16 @@
+#ifndef RUNNER_HJV_CAPTION_H_
+#define RUNNER_HJV_CAPTION_H_
+
+#include <flutter/flutter_view_controller.h>
+
+// HJViewer (U44): Windows 11's snap layouts over the maximise button that Dart draws, and the
+// window menu on a right-click of the drawn title bar (Dart side:
+// flutter/lib/desktop/widgets/hjv_caption.dart). Call once for each Flutter window after its view
+// is a child of the top-level window: the main window (FlutterWindow::OnCreate, after
+// SetChildContent) and each desktop_multi_window window (its created callback). It only registers
+// a top-level window delegate and the "hjv/caption" channel; the view is subclassed when Dart
+// first sends the button's box on Windows 11, so Windows 10 and the option that turns U44 off
