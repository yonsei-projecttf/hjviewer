+
+// HJViewer (U15): JobProgress.getStatus in the app's words: the state as a word ('일시 중지됨'
+// too, which upstream left out), "파일 1/3개" for upstream's English "1/3 files", the size (done
+// / total while it runs), joined by ' · ' (upstream's comma splices "완료되었습니다, 1/1 files").
+String _hjvJobStatus(JobProgress job) {
+  final t = HjvFileTexts(translate('Cancel') == '취소');
+  var handled = job.recvJobRes ? job.fileNum + 1 : job.fileNum;
+  if (handled >= job.fileCount || job.state == JobState.done) {
+    handled = job.fileCount;
+  }
+  final state = switch (job.state) {
+    JobState.done when job.err == 'cancel' => t.canceled,
+    JobState.done when job.err == 'skipped' => t.skipped,
+    JobState.done => t.done,
+    JobState.error => t.error,
+    JobState.paused => t.paused,
+    _ => '',
+  };
+  if (job.type == JobType.deleteFile) return state;
+  final total = job.totalSize > 0 ? hjvFileSize(job.totalSize.toDouble()) : '';
+  final finished = job.state == JobState.done ? job.totalSize : job.finishedSize;
+  final size = job.type == JobType.transfer &&
+          job.state == JobState.inProgress &&
+          finished > 0 &&
+          total.isNotEmpty
+      ? '${hjvFileSize(finished.toDouble())} / $total'
+      : total;
+  return hjvJobLine(
+      state: state,
+      files: job.fileCount > 0 ? t.files(handled, job.fileCount) : '',
+      size: size);
+}
