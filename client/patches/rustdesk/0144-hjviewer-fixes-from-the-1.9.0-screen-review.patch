     (small ? HjvText.bodySmall : HjvText.caption)
         .copyWith(color: color, fontFeatures: HjvText.tabular);
+
+/// A file's size in the file lists and the transfer cards (U15): upstream's readableFileSize
+/// (1024 steps, two decimals) without the zeros at the end: "240 KB", "1.2 MB", "812 B".
+String hjvFileSize(double size) {
+  const k = 1024.0, m = k * 1024, g = m * 1024;
+  final (value, unit) = size < k
+      ? (size, 'B')
+      : size < m
+          ? (size / k, 'KB')
+          : size < g
+              ? (size / m, 'MB')
+              : (size / g, 'GB');
+  final fixed = value.toStringAsFixed(2);
+  final trimmed =
+      fixed.contains('.') ? fixed.replaceFirst(RegExp(r'\.?0+$'), '') : fixed;
+  return '$trimmed $unit';
+}
+
+/// A file's date in the file lists (U15): to the minute, "2026-10-12 08:50".
+String hjvFileDate(DateTime t) {
+  String two(int n) => n.toString().padLeft(2, '0');
+  return '${t.year}-${two(t.month)}-${two(t.day)} ${two(t.hour)}:${two(t.minute)}';
+}
+
+/// The file transfer's own words (U15) where upstream's left English or a sentence in a line:
+/// Korean where translate() is Korean.
+class HjvFileTexts {
+  final bool korean;
+  const HjvFileTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  String files(int done, int count) =>
+      _t('파일 $done/$count개', '$done/$count files');
+  String get waiting => _t('대기 중', 'Waiting');
+  String get done => _t('완료', 'Done');
+  String get error => _t('오류', 'Error');
+  String get paused => _t('일시 중지됨', 'Paused');
+  String get canceled => _t('취소됨', 'Canceled');
+  String get skipped => _t('건너뜀', 'Skipped');
+  // the overwrite question and its action
+  String get overwriteAsk =>
+      _t('이 파일이 이미 있습니다. 덮어쓸까요?', 'This file already exists. Overwrite it?');
+  String get overwrite => _t('덮어쓰기', 'Overwrite');
+  // the phone's sheet while a job moves data
+  String get sending => _t('보내는 중', 'Sending');
+  String get receiving => _t('받는 중', 'Receiving');
+  // the phone's list head and selection
+  String items(int n) => _t('$n개 항목', n == 1 ? '1 item' : '$n items');
+  String selected(int n, {required bool remote}) => remote
+      ? _t('원격에서 $n개 선택됨', '$n selected on the remote')
+      : _t('로컬에서 $n개 선택됨', '$n selected locally');
+}
+
+/// A transfer card's line (U15): the state's word (none while it runs), the files and the size,
+/// one sentence-free line joined by ' · ': "완료 · 파일 1/1개 · 471 KB".
+String hjvJobLine(
+        {required String state, required String files, required String size}) =>
+    [state, files, size].where((s) => s.isNotEmpty).join(' · ');
