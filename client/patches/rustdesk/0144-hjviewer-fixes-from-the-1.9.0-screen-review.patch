+/// The permissions' tiles' width to height (GridView's childAspectRatio) for `count` tiles in
+/// `columns` across a grid of `width` x `height` (its 10 px side padding included): square, as
+/// upstream's, while their rows fit, else as flat as the rows need, down to [kHjvCmTileMin] high,
+/// so that the notes above the buttons never leave a working toggle half cut (a tile lower than
+/// [kHjvCmTileRoomy] keeps less padding around its icon). Where even that does not fit, square,
+/// and the grid scrolls.
+const double kHjvCmTileMin = 32;
+const double kHjvCmTileRoomy = 44;
+
+double hjvCmTileAspect(
+    {required double width,
+    required double height,
+    required int count,
+    int columns = 4,
+    double spacing = 10}) {
+  final tile = (width - 2 * spacing - (columns - 1) * spacing) / columns;
+  final rows = (count / columns).ceil();
+  if (tile <= 0 || rows == 0) return 1;
+  final fit = (height - (rows - 1) * spacing) / rows;
+  if (fit >= tile || fit < kHjvCmTileMin) return 1;
+  return tile / fit;
+}
+
 /// The mark line under the peer's name in the kind's fixed icon and colour: two lines at most, so
 /// that the words S10 and P6 tell the person to look for are never cut (English P4 needs about
 /// 205 px; the accept card's header leaves 174, a connected card's about 130).
