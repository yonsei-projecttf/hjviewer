+                  'Without one, keep a PC you use unattended switched on.'),
+            ]
+          ),
+        HjvReadyHow.policy => (
+            _t('절전 설정', 'Sleep settings'),
+            [
+              _t("이 PC의 절전은 학교·부서의 PC 관리 정책이 정합니다. PC 관리 담당에게 '전원 연결 시 절전 안 함'을 부탁하세요.",
+                  "Your organisation's PC policy sets this PC's sleep. Ask whoever manages your PCs for 'never sleep when plugged in'."),
+            ]
+          ),
+        HjvReadyHow.reinstall => (
+            _t('다시 설치', 'Install again'),
+            [
+              _t('HJViewer-install.exe를 다시 실행해 [수락하고 설치]를 누릅니다. ID, 비밀번호, 로그인은 그대로 남습니다.',
+                  'Run HJViewer-install.exe again and press [Accept and install]. The ID, the passwords and the login stay as they are.'),
+            ]
+          ),
+      };
+}
diff --git a/flutter/test/hjviewer_ready_test.dart b/flutter/test/hjviewer_ready_test.dart
new file mode 100644
index 0000000..ed18a60
--- /dev/null
+++ b/flutter/test/hjviewer_ready_test.dart
@@ -0,0 +1,372 @@
+import 'package:flutter_hbb/common/hjviewer_access_texts.dart';
+import 'package:flutter_hbb/common/hjviewer_ready_texts.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The remote readiness card's rows (TV-W4, design w3-w4 3-4) from the core's JSON and the
+// options, without the bridge.
+
+const ko = HjvReadyTexts(true);
+const en = HjvReadyTexts(false);
+
+/// A logged-in installed PC that is ready in every row, as the core and hjv-api give it.
+const _ready =
+    '{"v":1,"windows":true,"installed":true,"svc_auto":true,"svc_running":true,'
+    '"sleep":{"ac_standby_s":0,"ac_hibernate_s":0,"policy":false,"lid":false,"ac_lid":null,'
+    '"on_ac":true,"was":false,"fix":null},'
+    '"wake":{"wired":[{"name":"Example GbE","armed":true,"magic":"1","usb":false}],'
+    '"fast_startup":false}}';
+
+const _relay = HjvReadyWol(
+    ready: 'ok', reported: true, relayName: 'nas-1', relayOnline: true);
+
+HjvReadiness facts([String Function(String)? edit]) =>
+    HjvReadiness.parse(edit == null ? _ready : edit(_ready))!;
+
+HjvReadyContext ctx(
+        {bool installed = true,
+        bool loggedIn = true,
+        String? refusal,
+        int guestUntil = 0,
+        bool? passwordSet = true,
+        String method = '',
+        String approve = '',
+        String idleAllow = 'Y',
+        String idleMinutes = '',
+        HjvReadyWol? wol = _relay}) =>
+    HjvReadyContext(
+        installed: installed,
+        loggedIn: loggedIn,
+        refusal: refusal,
+        guestUntil: guestUntil,
+        guestUntilText: '18:00',
+        now: 1000,
+        passwordSet: passwordSet,
+        verificationMethod: method,
+        approveMode: approve,
+        idleAllow: idleAllow,
+        idleMinutes: idleMinutes,
+        wol: wol);
+
+HjvReadyRow row(HjvReadyItem item, HjvReadiness? r, HjvReadyContext c) =>
+    hjvReadyRows(ko, r, c).firstWhere((row) => row.item == item);
+
+void main() {
+  test('a ready PC has every row done', () {
+    final rows = hjvReadyRows(ko, facts(), ctx());
+    expect(rows.map((r) => r.item), HjvReadyItem.values);
+    expect(rows.every((r) => r.level == HjvReadyLevel.ok), isTrue);
+    expect(hjvReadyMissing(rows), 0);
+    expect(row(HjvReadyItem.nic, facts(), ctx()).text,
+        ko.wiredWakes('Example GbE'));
+    expect(row(HjvReadyItem.idle, facts(), ctx()).text, ko.idleOn(10));
+  });
+
+  test('a PC without the install has the install row only', () {
+    final rows = hjvReadyRows(ko, null, ctx(installed: false));
+    expect(rows.length, 1);
+    expect([
+      rows.single.level,
+      rows.single.actions
+    ], [
+      HjvReadyLevel.no,
+      [HjvReadyAction.install]
+    ]);
+  });
+
+  test('the service rows and facts the core could not read', () {
+    final notAuto = row(
+        HjvReadyItem.install,
+        facts((j) => j.replaceFirst('"svc_auto":true', '"svc_auto":false')),
+        ctx());
+    expect([
+      notAuto.level,
+      notAuto.text,
+      notAuto.actions
+    ], [
+      HjvReadyLevel.no,
+      ko.notAutoStart,
+      [HjvReadyAction.howReinstall]
+    ]);
+    // an older core gives "" (the 1.8.0 bridge): ○ where only it knows
+    expect(HjvReadiness.parse(''), isNull);
+    expect(HjvReadiness.parse('{"v":1,"windows":false}'), isNull);
+    final rows = hjvReadyRows(ko, null, ctx());
+    for (final item in [
+      HjvReadyItem.install,
+      HjvReadyItem.sleep,
+      HjvReadyItem.nic,
+      HjvReadyItem.fastStartup
+    ]) {
+      expect(
+          rows.firstWhere((r) => r.item == item).level, HjvReadyLevel.unknown);
+    }
+    expect(hjvReadyMissing(rows), 0);
+  });
+
+  test('the login row: a refusal, a guest ticket, no login', () {
+    final refused = row(HjvReadyItem.logIn, facts(), ctx(refusal: 'cause'));
+    expect([
+      refused.level,
+      refused.text,
+      refused.actions
+    ], [
+      HjvReadyLevel.no,
+      'cause',
+      [HjvReadyAction.refusal]
+    ]);
+    final guest = row(
+        HjvReadyItem.logIn, facts(), ctx(loggedIn: false, guestUntil: 2000));
+    expect((guest.level, guest.text),
+        (HjvReadyLevel.warn, ko.guestOnly('18:00', code: false)));
+    final none = hjvReadyRows(ko, facts(), ctx(loggedIn: false));
+    expect(none.first.level, HjvReadyLevel.ok);
+    expect(none[1].text, ko.notLoggedIn);
+    // the wake rows and the end lock need a login
+    expect(none.map((r) => r.item), [
+      HjvReadyItem.install,
+      HjvReadyItem.logIn,
+      HjvReadyItem.password,
+      HjvReadyItem.sleep,
+      HjvReadyItem.idle
+    ]);
+    // the home leaves the login out: its own notices take care of it
+    expect(hjvReadyMissing(none), 1);
+    expect(hjvReadyMissing(none, home: true), 0);
+  });
+
+  test(
+      'click approval is a ✗ even with a password, then one-time only, then none',
+      () {
+    final click = row(HjvReadyItem.password, facts(), ctx(approve: 'click'));
+    expect([
+      click.level,
+      click.text,
+      click.actions
+    ], [
+      HjvReadyLevel.no,
+      ko.clickOnly,
+      [HjvReadyAction.fixApprove]
+    ]);
+    final temp = row(
+        HjvReadyItem.password, facts(), ctx(method: 'use-temporary-password'));
+    expect([
+      temp.text,
+      temp.actions
+    ], [
+      ko.temporaryOnly,
+      [HjvReadyAction.fixMethod]
+    ]);
+    final none = row(HjvReadyItem.password, facts(), ctx(passwordSet: false));
+    expect([
+      none.text,
+      none.actions
+    ], [
+      ko.noPassword,
+      [HjvReadyAction.setPassword]
+    ]);
+    expect(row(HjvReadyItem.password, facts(), ctx(passwordSet: null)).level,
+        HjvReadyLevel.unknown);
+  });
+
+  test('sleep: ✗ alone, ⚠ with a relay that wakes it, a policy has no [절전 안 함]',
+      () {
+    String sleeping(String j) =>
+        j.replaceFirst('"ac_standby_s":0', '"ac_standby_s":1800');
+    final alone = row(HjvReadyItem.sleep, facts(sleeping),
+        ctx(wol: const HjvReadyWol(ready: 'ok', reported: true)));
+    expect([
+      alone.level,
+      alone.text,
+      alone.actions
+    ], [
+      HjvReadyLevel.no,
+      ko.sleeps(30),
+      [HjvReadyAction.sleepNever]
+    ]);
+    final wakes = row(HjvReadyItem.sleep, facts(sleeping), ctx());
+    expect(
+        (wakes.level, wakes.text), (HjvReadyLevel.warn, ko.sleepsButWakes(30)));
+    final policy = row(
+        HjvReadyItem.sleep,
+        facts(
+            (j) => sleeping(j).replaceFirst('"policy":false', '"policy":true')),
+        ctx());
+    expect([
+      policy.level,
+      policy.text,
+      policy.actions
+    ], [
+      HjvReadyLevel.warn,
+      ko.sleepPolicy,
+      [HjvReadyAction.howPolicy]
+    ]);
+    // a refused change reads as the policy's, as the toast said
+    final denied = row(
+        HjvReadyItem.sleep,
+        facts((j) => sleeping(j).replaceFirst('"fix":null', '"fix":"denied"')),
+        ctx());
+    expect(denied.actions.contains(HjvReadyAction.sleepNever), isFalse);
+  });
+
+  test('[되돌리기] only with values kept, and the lid and battery lines', () {
+    final kept = row(HjvReadyItem.sleep,
+        facts((j) => j.replaceFirst('"was":false', '"was":true')), ctx());
+    expect([
+      kept.level,
+      kept.actions
+    ], [
+      HjvReadyLevel.ok,
+      [HjvReadyAction.sleepUndo]
+    ]);
+    expect(row(HjvReadyItem.sleep, facts(), ctx()).actions, isEmpty);
+    final laptop = row(
+        HjvReadyItem.sleep,
+        facts((j) => j
+            .replaceFirst('"ac_standby_s":0', '"ac_standby_s":600')
+            .replaceFirst('"lid":false,"ac_lid":null', '"lid":true,"ac_lid":1')
+            .replaceFirst('"on_ac":true', '"on_ac":false')),
+        ctx(wol: const HjvReadyWol(ready: 'ok', reported: true)));
+    expect(laptop.text, ko.sleeps(10));
+    expect(laptop.notes, [ko.onBattery, ko.lidSleeps]);
+  });
+
+  test('the wired card, fast startup and the relay', () {
+    HjvReadyRow nic(String card) => row(
+        HjvReadyItem.nic,
+        facts((j) =>
+            j.replaceFirst(RegExp(r'"wired":\[.*\]'), '"wired":[$card]')),
+        ctx());
+    expect(nic('').text, ko.noWired);
+    expect(nic('{"name":"USB","armed":true,"magic":"1","usb":true}').text,
+        ko.usbOnly);
+    expect(nic('{"name":"A","armed":false,"magic":"1","usb":false}').text,
+        ko.notArmed);
+    expect(nic('{"name":"A","armed":true,"magic":"0","usb":false}').text,
+        ko.magicOff);
+    final unknown = nic('{"name":"A","armed":null,"magic":null,"usb":false}');
+    expect([
+      unknown.level,
+      unknown.text,
+      unknown.actions
+    ], [
+      HjvReadyLevel.warn,
+      ko.magicUnknown,
+      [HjvReadyAction.howNic]
+    ]);
+    final fast = row(
+        HjvReadyItem.fastStartup,
+        facts((j) =>
+            j.replaceFirst('"fast_startup":false', '"fast_startup":true')),
+        ctx());
+    expect([
+      fast.level,
+      fast.actions
+    ], [
+      HjvReadyLevel.warn,
+      [HjvReadyAction.howFastStartup]
+    ]);
+    HjvReadyRow relay(int status, Object? body) => row(
+        HjvReadyItem.relay, facts(), ctx(wol: HjvReadyWol.of(status, body)));
+    expect(
+        relay(200, {
+          'ready': 'ok',
+          'reported_at': 1,
+          'relay': {'name': 'nas-1', 'match': 'same_net', 'online': true}
+        }).text,
+        ko.relay('nas-1'));
+    expect(
+        relay(200, {
+          'ready': 'ok',
+          'reported_at': 1,
+          'relay': {'name': 'nas-1', 'online': false}
+        }).text,
+        ko.relayOffline('nas-1'));
+    expect(relay(200, {'ready': 'ok', 'reported_at': 1, 'relay': null}).text,
+        ko.noRelay);
+    expect(
+        relay(200, {'ready': 'unknown', 'reported_at': null, 'relay': null})
+            .text,
+        ko.relayNoReport);
+    // the server out of reach: ○, and no count anywhere
+    final failed = relay(502, null);
+    expect((failed.level, failed.text),
+        (HjvReadyLevel.unknown, ko.relayUnreachable));
+  });
+
+  test('idle disconnect: off is a ⚠ with [켜기 (30분)]', () {
+    final off = row(HjvReadyItem.idle, facts(), ctx(idleAllow: ''));
+    expect([
+      off.level,
+      off.actions
+    ], [
+      HjvReadyLevel.warn,
+      [HjvReadyAction.idleOn]
+    ]);
+    expect(row(HjvReadyItem.idle, facts(), ctx(idleMinutes: '45')).text,
+        ko.idleOn(45));
+    expect(en.turnOnIdle, 'Turn on (30 min)');
+  });
+
+  test('the header counts the ✗ of taking connections only', () {
+    final rows = hjvReadyRows(
+        ko,
+        facts((j) => j
+            .replaceFirst('"ac_standby_s":0', '"ac_standby_s":900')
+            .replaceFirst('"fast_startup":false', '"fast_startup":true')),
+        ctx(passwordSet: false, idleAllow: '', wol: HjvReadyWol.unreachable));
+    expect(hjvReadyMissing(rows), 2);
+    expect(ko.toCheck(2), '확인할 것이 2가지 있습니다.');
+    expect(en.toCheck(1), '1 thing to check.');
+  });
+
+  test('G4 on the home of a logged-in installed PC only, after P1, P2 and G2',
+      () {
+    HjvPcHome home(
+            {String state = 'ok',
+            int guestUntil = 0,
+            bool installed = true,
+            bool loggedIn = true,
+            int missing = 1}) =>
+        hjvPcHome(
+            state: state,
+            guestUntil: guestUntil,
+            now: 1000,
+            installedWindows: installed,
+            loggedIn: loggedIn,
+            readyMissing: missing);
+    expect(home(), HjvPcHome.ready);
+    expect(home(missing: 0), HjvPcHome.none);
+    expect(home(installed: false), HjvPcHome.none);
+    expect(home(loggedIn: false), HjvPcHome.logIn);
+    expect(home(guestUntil: 2000), HjvPcHome.guest);
+    expect(hjvPcHomeLogsIn(HjvPcHome.ready), isFalse);
+    const t = HjvAccessTexts(true);
+    expect(t.readyLeft(2), '원격 준비: 2가지가 남았습니다');
+    expect(
+        const HjvAccessTexts(false).checkReadiness, 'Check remote readiness');
+  });
+
+  test('every text has both languages, and the how-to windows their steps', () {
+    for (final how in HjvReadyHow.values) {
+      final (koTitle, koSteps) =
+          ko.how(how, card: 'A', contact: 'x@example.org');
+      final (enTitle, enSteps) =
+          en.how(how, card: 'A', contact: 'x@example.org');
+      expect(koTitle, isNot(enTitle));
+      expect(koSteps.length, enSteps.length);
+    }
+    expect(ko.how(HjvReadyHow.relay, contact: 'x@example.org').$2,
+        contains('HJViewer 관리자: x@example.org'));
+    expect(
+        ko.how(HjvReadyHow.relay).$2.any((s) => s.startsWith('HJViewer 관리자:')),
+        isFalse);
+    // a school PC policy is never "관리자" (vocab.md)
+    expect(ko.sleepPolicy.contains('관리자'), isFalse);
+    expect(ko.how(HjvReadyHow.policy).$2.single.contains('관리자'), isFalse);
+    expect(hjvReadyHowSection(HjvReadyHow.nic), '3-랜카드-설정-장치-관리자');
+    expect(hjvReadyHowSection(HjvReadyHow.reinstall), isNull);
+    for (final a in HjvReadyAction.values) {
+      expect(ko.action(a), isNot(en.action(a)));
+    }
+  });
+}
