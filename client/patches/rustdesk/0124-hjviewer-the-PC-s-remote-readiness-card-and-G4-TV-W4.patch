@@ -0,0 +1,151 @@
+//! The readiness facts and the sleep fix against a PC in memory.
+
+use super::*;
+use std::{cell::RefCell, collections::HashMap};
+
+const PLAN: u128 = 0x381b4222_f694_41f0_9685_ff5bb260df2e;
+const OTHER_PLAN: u128 = 0x8c5e7fda_e8bf_4a96_9a85_a6e23a8c635c;
+
+struct Fake {
+    plan: RefCell<u128>,
+    times: RefCell<HashMap<u128, (u32, u32)>>,
+    policy: bool,
+    /// the error setting the times gives
+    refuse: Option<u32>,
+    local: RefCell<HashMap<String, String>>,
+}
+
+impl Fake {
+    fn new(standby: u32, hibernate: u32) -> Self {
+        Fake {
+            plan: RefCell::new(PLAN),
+            times: RefCell::new(HashMap::from([(PLAN, (standby, hibernate))])),
+            policy: false,
+            refuse: None,
+            local: RefCell::default(),
+        }
+    }
+
+    fn times(&self) -> (u32, u32) {
+        self.times.borrow()[&PLAN]
+    }
+}
+
+impl Env for Fake {
+    fn installed(&self) -> bool {
+        true
+    }
+    fn service(&self) -> (Option<bool>, Option<bool>) {
+        (Some(true), Some(true))
+    }
+    fn plan(&self) -> Result<u128, u32> {
+        Ok(*self.plan.borrow())
+    }
+    fn sleep(&self, plan: u128) -> Result<(u32, u32), u32> {
+        self.times.borrow().get(&plan).copied().ok_or(2)
+    }
+    fn set_sleep(&self, plan: u128, standby: u32, hibernate: u32) -> Result<(), u32> {
+        if let Some(code) = self.refuse {
+            return Err(code);
+        }
+        self.times.borrow_mut().insert(plan, (standby, hibernate));
+        Ok(())
+    }
+    fn policy(&self) -> bool {
+        self.policy
+    }
+    fn lid(&self, _plan: Option<u128>) -> (Option<bool>, Option<u32>) {
+        (Some(true), Some(1))
+    }
+    fn on_ac(&self) -> Option<bool> {
+        Some(true)
+    }
+    fn wake(&self) -> Option<serde_json::Value> {
+        Some(serde_json::json!({"wired": [], "fast_startup": true}))
+    }
+    fn local(&self, key: &str) -> String {
+        self.local.borrow().get(key).cloned().unwrap_or_default()
+    }
+    fn set_local(&self, key: &str, value: &str) {
+        if value.is_empty() {
+            self.local.borrow_mut().remove(key);
+        } else {
+            self.local
+                .borrow_mut()
+                .insert(key.to_owned(), value.to_owned());
+        }
+    }
+}
+
+fn read(env: &Fake, wake: bool, fix: Option<&'static str>) -> serde_json::Value {
+    serde_json::from_str(&facts(env, wake, fix)).unwrap()
+}
+
+#[test]
+fn the_facts_have_the_cards_shape_and_the_home_leaves_the_cards_out() {
+    let env = Fake::new(1800, 0);
+    assert_eq!(
+        read(&env, true, None),
+        serde_json::json!({"v": 1, "windows": true, "installed": true, "svc_auto": true,
+            "svc_running": true,
+            "sleep": {"ac_standby_s": 1800, "ac_hibernate_s": 0, "policy": false, "lid": true,
+                      "ac_lid": 1, "on_ac": true, "was": false, "fix": null},
+            "wake": {"wired": [], "fast_startup": true}})
+    );
+    assert!(read(&env, false, None).get("wake").is_none());
+}
+
+#[test]
+fn never_sleep_keeps_the_old_times_and_undo_puts_them_back() {
+    let env = Fake::new(1800, 3600);
+    assert_eq!(fix(&env, "sleep-never"), "ok");
+    assert_eq!(env.times(), (0, 0));
+    let facts = read(&env, false, Some("ok"));
+    assert_eq!(
+        (&facts["sleep"]["was"], &facts["sleep"]["fix"]),
+        (&true.into(), &"ok".into())
+    );
+    // pressed again: the first press's times stay the ones to put back
+    assert_eq!(fix(&env, "sleep-never"), "ok");
+    assert_eq!(fix(&env, "sleep-undo"), "ok");
+    assert_eq!(env.times(), (1800, 3600));
+    assert_eq!(read(&env, false, None)["sleep"]["was"], false);
+    assert_eq!(fix(&env, "sleep-undo"), "failed");
+}
+
+#[test]
+fn undo_does_nothing_once_another_plan_is_current() {
+    let env = Fake::new(1800, 0);
+    assert_eq!(fix(&env, "sleep-never"), "ok");
+    env.times.borrow_mut().insert(OTHER_PLAN, (600, 0));
+    *env.plan.borrow_mut() = OTHER_PLAN;
+    assert_eq!(read(&env, false, None)["sleep"]["was"], false);
+    assert_eq!(fix(&env, "sleep-undo"), "failed");
+    assert_eq!(env.times.borrow()[&OTHER_PLAN], (600, 0));
+    // back on the first plan, [되돌리기] works again
+    *env.plan.borrow_mut() = PLAN;
+    assert_eq!(fix(&env, "sleep-undo"), "ok");
+    assert_eq!(env.times(), (1800, 0));
+}
+
+#[test]
+fn a_policy_or_a_refusal_changes_nothing() {
+    let env = Fake {
+        policy: true,
+        ..Fake::new(1800, 0)
+    };
+    assert_eq!(fix(&env, "sleep-never"), "policy");
+    assert_eq!(env.times(), (1800, 0));
+    let env = Fake {
+        refuse: Some(ACCESS_DENIED),
+        ..Fake::new(1800, 0)
+    };
+    assert_eq!(fix(&env, "sleep-never"), "denied");
+    assert_eq!(read(&env, false, None)["sleep"]["was"], false);
+    let env = Fake {
+        refuse: Some(87),
+        ..Fake::new(1800, 0)
+    };
+    assert_eq!(fix(&env, "sleep-never"), "failed");
+    assert_eq!(fix(&env, "something-else"), "failed");
+}
