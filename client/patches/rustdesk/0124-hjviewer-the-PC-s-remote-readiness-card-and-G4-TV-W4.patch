diff --git a/src/hjviewer_ready.rs b/src/hjviewer_ready.rs
new file mode 100644
index 0000000..990c868
--- /dev/null
+++ b/src/hjviewer_ready.rs
@@ -0,0 +1,378 @@
+//! TV-W4, the PC's remote readiness card (the hjviewer repository's docs/architecture.md 5-12):
+//! the facts the card in Settings → Account and the PC home's G4 read of this PC, and the one
+//! setting HJViewer changes, the current power plan's plugged-in sleep and hibernate times, only
+//! when the user presses [절전 안 함] (and back with [되돌리기]). The UI process reads and writes
+//! them as the Windows user logged in (no new path to the service); a policy or a user without
+//! the right keeps them as they are. Nothing here goes to a server.
+//!
+//! Keys, through hjviewer_account::get_common / set_common (account builds only):
+//! - `hjv-ready`: this PC's facts as one line of JSON (slow: the network cards; the app asks with
+//!   the async call), `{"v":1,"windows":false}` elsewhere;
+//! - `hjv-ready-home`: the same without `wake`, which the home reads at most once a minute;
+//! - `hjv-ready-fix` (set): `sleep-never` or `sleep-undo`; the result is the next read's
+//!   `sleep.fix` ("ok", "denied", "policy" or "failed").
+#![cfg_attr(not(windows), allow(dead_code))]
+
+use hbb_common::log;
+use serde_derive::Serialize;
+use std::sync::Mutex;
+
+const READY: &str = "hjv-ready";
+const READY_HOME: &str = "hjv-ready-home";
+const FIX: &str = "hjv-ready-fix";
+/// The plugged-in sleep values before [절전 안 함], in the Windows user's LocalConfig:
+/// "<plan GUID as 32 hex digits> <standby s> <hibernate s>".
+const SLEEP_WAS: &str = "hjv-ready-sleep-was";
+const ACCESS_DENIED: u32 = 5;
+
+/// The last [절전 안 함] or [되돌리기] of this process.
+static LAST_FIX: Mutex<Option<&'static str>> = Mutex::new(None);
+
+pub(crate) fn get_common(key: &str) -> Option<String> {
+    let wake = match key {
+        READY => true,
+        READY_HOME => false,
+        _ => return None,
+    };
+    #[cfg(windows)]
+    {
+        let fix = *LAST_FIX.lock().unwrap();
+        Some(facts(&os::Windows, wake, fix))
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = wake;
+        Some(r#"{"v":1,"windows":false}"#.to_owned())
+    }
+}
+
+pub(crate) fn set_common(key: &str, value: &str) -> bool {
+    if key != FIX {
+        return false;
+    }
+    #[cfg(windows)]
+    {
+        let result = fix(&os::Windows, value);
+        *LAST_FIX.lock().unwrap() = Some(result);
+    }
+    #[cfg(not(windows))]
+    let _ = value;
+    true
+}
+
+/// What the card reads of Windows, and the Windows user's own settings.
+trait Env {
+    fn installed(&self) -> bool;
+    /// whether the service starts with Windows, and whether it runs
+    fn service(&self) -> (Option<bool>, Option<bool>);
+    /// the current power plan
+    fn plan(&self) -> Result<u128, u32>;
+    /// the plan's plugged-in standby and hibernate times, in seconds (0: never)
+    fn sleep(&self, plan: u128) -> Result<(u32, u32), u32>;
+    /// sets both and makes the plan current again, so that Windows applies them
+    fn set_sleep(&self, plan: u128, standby: u32, hibernate: u32) -> Result<(), u32>;
+    /// whether a group policy sets the plugged-in sleep or hibernate time
+    fn policy(&self) -> bool;
+    /// whether there is a lid, and what closing it does on mains power (0 nothing, 1 sleep,
+    /// 2 hibernate, 3 shut down)
+    fn lid(&self, plan: Option<u128>) -> (Option<bool>, Option<u32>);
+    fn on_ac(&self) -> Option<bool>;
+    /// the wired cards and fast startup (hjviewer_wol's report), None when unread
+    fn wake(&self) -> Option<serde_json::Value>;
+    fn local(&self, key: &str) -> String;
+    fn set_local(&self, key: &str, value: &str);
+}
+
+#[derive(Serialize, Debug, PartialEq)]
+struct Facts {
+    v: u32,
+    windows: bool,
+    installed: bool,
+    svc_auto: Option<bool>,
+    svc_running: Option<bool>,
+    sleep: Sleep,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    wake: Option<serde_json::Value>,
+}
+
+#[derive(Serialize, Debug, PartialEq)]
+struct Sleep {
+    ac_standby_s: Option<u32>,
+    ac_hibernate_s: Option<u32>,
+    policy: bool,
+    lid: Option<bool>,
+    ac_lid: Option<u32>,
+    on_ac: Option<bool>,
+    /// whether [되돌리기] can put back values kept for the current plan
+    was: bool,
+    fix: Option<&'static str>,
+}
+
+fn facts(env: &impl Env, wake: bool, fix: Option<&'static str>) -> String {
+    let plan = env.plan().ok();
+    let times = plan.and_then(|plan| env.sleep(plan).ok());
+    let (svc_auto, svc_running) = env.service();
+    let (lid, ac_lid) = env.lid(plan);
+    let facts = Facts {
+        v: 1,
+        windows: true,
+        installed: env.installed(),
+        svc_auto,
+        svc_running,
+        sleep: Sleep {
+            ac_standby_s: times.map(|t| t.0),
+            ac_hibernate_s: times.map(|t| t.1),
+            policy: env.policy(),
+            lid,
+            ac_lid,
+            on_ac: env.on_ac(),
+            was: plan.is_some_and(|plan| kept(env).is_some_and(|k| k.0 == plan)),
+            fix,
+        },
+        wake: if wake { env.wake() } else { None },
+    };
+    serde_json::to_string(&facts).unwrap_or_default()
+}
+
+/// The values [절전 안 함] kept: the plan and its standby and hibernate times.
+fn kept(env: &impl Env) -> Option<(u128, u32, u32)> {
+    let was = env.local(SLEEP_WAS);
+    let mut parts = was.split(' ');
+    let plan = u128::from_str_radix(parts.next()?, 16).ok()?;
+    let standby = parts.next()?.parse().ok()?;
+    let hibernate = parts.next()?.parse().ok()?;
+    parts.next().is_none().then_some((plan, standby, hibernate))
+}
+
+fn failure(code: u32) -> &'static str {
+    if code == ACCESS_DENIED {
+        "denied"
+    } else {
+        "failed"
+    }
+}
+
+/// [절전 안 함] (`sleep-never`) or [되돌리기] (`sleep-undo`), as the user pressed it.
+fn fix(env: &impl Env, what: &str) -> &'static str {
+    let plan = match env.plan() {
+        Ok(plan) => plan,
+        Err(code) => return failure(code),
+    };
+    match what {
+        "sleep-never" => {
+            if env.policy() {
+                return "policy";
+            }
+            let (standby, hibernate) = match env.sleep(plan) {
+                Ok(times) => times,
+                Err(code) => return failure(code),
+            };
+            if (standby, hibernate) == (0, 0) {
+                return "ok";
+            }
+            // a second press keeps the values of the first, which the user had set
+            let before = env.local(SLEEP_WAS);
+            if kept(env).map(|k| k.0) != Some(plan) {
+                env.set_local(SLEEP_WAS, &format!("{plan:032x} {standby} {hibernate}"));
+            }
+            match env.set_sleep(plan, 0, 0) {
+                Ok(()) => {
+                    log::info!("hjv: readiness: sleep on mains power set to never by the user");
+                    "ok"
+                }
+                Err(code) => {
+                    env.set_local(SLEEP_WAS, &before);
+                    log::warn!("hjv: readiness: could not set sleep on mains power: {code}");
+                    failure(code)
+                }
+            }
+        }
+        "sleep-undo" => {
+            let Some((was_plan, standby, hibernate)) = kept(env) else {
+                return "failed";
+            };
+            // another plan is current now: its times are not the ones kept
+            if was_plan != plan {
+                return "failed";
+            }
+            match env.set_sleep(plan, standby, hibernate) {
+                Ok(()) => {
+                    env.set_local(SLEEP_WAS, "");
+                    log::info!("hjv: readiness: sleep on mains power put back by the user");
+                    "ok"
+                }
+                Err(code) => {
+                    log::warn!("hjv: readiness: could not put back sleep on mains power: {code}");
+                    failure(code)
+                }
+            }
+        }
+        _ => "failed",
+    }
+}
+
+#[cfg(windows)]
+mod os {
+    use super::Env;
+    use hbb_common::config::LocalConfig;
+    use windows::{
+        core::GUID,
+        Win32::{
+            Foundation::{LocalFree, ERROR_SUCCESS, HLOCAL},
+            System::Power::{
+                GetPwrCapabilities, GetSystemPowerStatus, PowerGetActiveScheme,
+                PowerReadACValueIndex, PowerSetActiveScheme, PowerWriteACValueIndex,
+                SYSTEM_POWER_CAPABILITIES, SYSTEM_POWER_STATUS,
+            },
+        },
+    };
+    use winreg::{enums::*, RegKey};
+
+    // winnt.h's power setting GUIDs (Win32_System_SystemServices is not among the crate's
+    // features)
+    const SLEEP_SUBGROUP: GUID = GUID::from_u128(0x238c9fa8_0aad_41ed_83f4_97be242c8f20);
+    const STANDBY_TIMEOUT: GUID = GUID::from_u128(0x29f6c1db_86da_48c5_9fdb_f2b67b1f44da);
+    const HIBERNATE_TIMEOUT: GUID = GUID::from_u128(0x9d7815a6_7ee4_497e_8888_515a05f02364);
+    const BUTTON_SUBGROUP: GUID = GUID::from_u128(0x4f971e89_eebd_4455_a8de_9e59040e7347);
+    const LIDCLOSE_ACTION: GUID = GUID::from_u128(0x5ca83367_6e45_459f_a27b_476b1d01c936);
+    const POLICY: &str = r"SOFTWARE\Policies\Microsoft\Power\PowerSettings";
+
+    pub(super) struct Windows;
+
+    fn read(plan: u128, subgroup: &GUID, setting: &GUID) -> Result<u32, u32> {
+        let plan = GUID::from_u128(plan);
+        let mut value = 0u32;
+        let e = unsafe {
+            PowerReadACValueIndex(
+                None,
+                Some(&plan as *const GUID),
+                Some(subgroup as *const GUID),
+                Some(setting as *const GUID),
+                &mut value,
+            )
+        };
+        if e == ERROR_SUCCESS {
+            Ok(value)
+        } else {
+            Err(e.0)
+        }
+    }
+
+    fn write(plan: &GUID, setting: &GUID, value: u32) -> Result<(), u32> {
+        let e = unsafe {
+            PowerWriteACValueIndex(
+                None,
+                plan as *const GUID,
+                Some(&SLEEP_SUBGROUP as *const GUID),
+                Some(setting as *const GUID),
+                value,
+            )
+        };
+        if e == ERROR_SUCCESS {
+            Ok(())
+        } else {
+            Err(e.0)
+        }
+    }
+
+    impl Env for Windows {
+        fn installed(&self) -> bool {
+            crate::platform::is_installed()
+        }
+
+        fn service(&self) -> (Option<bool>, Option<bool>) {
+            let path = format!(
+                r"SYSTEM\CurrentControlSet\Services\{}",
+                crate::get_app_name()
+            );
+            let start = RegKey::predef(HKEY_LOCAL_MACHINE)
+                .open_subkey_with_flags(path, KEY_READ)
+                .and_then(|key| key.get_value::<u32, _>("Start"))
+                .ok();
+            // 2: SERVICE_AUTO_START, which `sc create … start= auto` sets
+            (
+                start.map(|s| s == 2),
+                Some(crate::platform::is_self_service_running()),
+            )
+        }
+
+        fn plan(&self) -> Result<u128, u32> {
+            let mut plan: *mut GUID = std::ptr::null_mut();
+            let e = unsafe { PowerGetActiveScheme(None, &mut plan) };
+            if e != ERROR_SUCCESS {
+                return Err(e.0);
+            }
+            if plan.is_null() {
+                return Err(0);
+            }
+            let value = unsafe { *plan }.to_u128();
+            unsafe { LocalFree(Some(HLOCAL(plan.cast()))) };
+            Ok(value)
+        }
+
+        fn sleep(&self, plan: u128) -> Result<(u32, u32), u32> {
+            Ok((
+                read(plan, &SLEEP_SUBGROUP, &STANDBY_TIMEOUT)?,
+                read(plan, &SLEEP_SUBGROUP, &HIBERNATE_TIMEOUT)?,
+            ))
+        }
+
+        fn set_sleep(&self, plan: u128, standby: u32, hibernate: u32) -> Result<(), u32> {
+            let plan = GUID::from_u128(plan);
+            write(&plan, &STANDBY_TIMEOUT, standby)?;
+            write(&plan, &HIBERNATE_TIMEOUT, hibernate)?;
+            let e = unsafe { PowerSetActiveScheme(None, Some(&plan as *const GUID)) };
+            if e == ERROR_SUCCESS {
+                Ok(())
+            } else {
+                Err(e.0)
+            }
+        }
+
+        fn policy(&self) -> bool {
+            let hklm = RegKey::predef(HKEY_LOCAL_MACHINE);
+            [STANDBY_TIMEOUT, HIBERNATE_TIMEOUT].iter().any(|setting| {
+                let path = format!(r"{POLICY}\{{{setting:?}}}");
+                hklm.open_subkey_with_flags(path, KEY_READ)
+                    .and_then(|key| key.get_value::<u32, _>("ACSettingIndex"))
+                    .is_ok()
+            })
+        }
+
+        fn lid(&self, plan: Option<u128>) -> (Option<bool>, Option<u32>) {
+            let mut caps = SYSTEM_POWER_CAPABILITIES::default();
+            let lid = unsafe { GetPwrCapabilities(&mut caps) }.then_some(caps.LidPresent);
+            let action = match (lid, plan) {
+                (Some(true), Some(plan)) => read(plan, &BUTTON_SUBGROUP, &LIDCLOSE_ACTION).ok(),
+                _ => None,
+            };
+            (lid, action)
+        }
+
+        fn on_ac(&self) -> Option<bool> {
+            let mut status = SYSTEM_POWER_STATUS::default();
+            unsafe { GetSystemPowerStatus(&mut status) }.ok()?;
+            match status.ACLineStatus {
+                0 => Some(false),
+                1 => Some(true),
+                _ => None,
+            }
+        }
+
+        fn wake(&self) -> Option<serde_json::Value> {
+            let summary = crate::hjviewer_wol::report()?.local_summary();
+            serde_json::to_value(summary).ok()
+        }
+
+        fn local(&self, key: &str) -> String {
+            LocalConfig::get_option(key)
+        }
+
+        fn set_local(&self, key: &str, value: &str) {
+            LocalConfig::set_option(key.to_owned(), value.to_owned());
+        }
+    }
+}
