index 0000000..517aff2
--- /dev/null
+++ b/flutter/lib/common/hjviewer_ready.dart
@@ -0,0 +1,439 @@
+// HJViewer's remote readiness card (TV-W4, the hjviewer repository's docs/architecture.md 5-12):
+// in Settings → Account of a Windows PC that takes connections, what an unattended connection
+// needs, row by row with ✔ ⚠ ✗ ○ and [고치기] or [방법 보기]; and the PC home's G4 count (D-12).
+// The facts come from the core (main_get_common("hjv-ready"), src/hjviewer_ready.rs), the relay
+// from hjv-api's GET /api/hjv/devices/<this PC>/wol; the rows and texts are
+// hjviewer_ready_texts.dart. HJViewer changes only the plugged-in sleep, when the user presses
+// [절전 안 함] (D-11: fast startup gets [방법 보기] only); the password, approval and idle options
+// go behind the security settings' unlock, as their own screen does.
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_admin_contact.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjv_update_model.dart' show kHjvSourceRepo;
+import 'package:flutter_hbb/common/hjviewer_access.dart';
+import 'package:flutter_hbb/common/hjviewer_access_texts.dart'
+    show hjvUntilText;
+import 'package:flutter_hbb/common/hjviewer_account.dart';
+import 'package:flutter_hbb/common/hjviewer_ready_texts.dart';
+import 'package:flutter_hbb/common/widgets/dialog.dart';
+import 'package:flutter_hbb/common/widgets/login.dart';
+import 'package:flutter_hbb/consts.dart';
+import 'package:flutter_hbb/desktop/pages/desktop_home_page.dart'
+    show setPasswordDialog;
+import 'package:flutter_hbb/desktop/pages/desktop_setting_page.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:flutter_hbb/utils/multi_window_manager.dart';
+import 'package:get/get.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+HjvReadyTexts get _t => HjvReadyTexts(translate('Cancel') == '취소');
+
+/// The card's place: a Windows PC that takes connections (D17).
+bool hjvShowsReadyCard() => isWindows && !bind.isOutgoingOnly();
+
+/// G4's count (hjvReadyMissing for the home), which the card and the home's tick update.
+final hjvReadyHomeMissing = 0.obs;
+
+/// Settings → Account, where the card is (G2's text button, G4's [점검]).
+void hjvOpenReadiness() =>
+    DesktopSettingPage.switch2page(SettingsTabKey.account);
+
+/// hjv-api's last answer about this PC's wake and when it came; the home asks again at most
+/// every _kWolAge, the card on each read.
+HjvReadyWol? _wol;
+DateTime? _wolAt;
+const _kWolAge = Duration(minutes: 10);
+
+Future<HjvReadyWol> _askWol() async {
+  try {
+    final id = await bind.mainGetMyId();
+    final (code, body) = await hjvAccountGet('/api/hjv/devices/$id/wol');
+    _wol = HjvReadyWol.of(code, body);
+  } catch (e) {
+    debugPrint('hjv: readiness: $e');
+    _wol = HjvReadyWol.unreachable;
+  }
+  _wolAt = DateTime.now();
+  return _wol!;
+}
+
+Future<HjvReadiness?> _facts({required bool wake}) async {
+  try {
+    return HjvReadiness.parse(
+        await bind.mainGetCommon(key: wake ? 'hjv-ready' : 'hjv-ready-home'));
+  } catch (e) {
+    return null;
+  }
+}
+
+Future<bool?> _passwordSet() async {
+  try {
+    return await bind.mainGetCommon(key: 'permanent-password-set') == 'true';
+  } catch (e) {
+    return null;
+  }
+}
+
+String _option(String key) => bind.mainGetOptionSync(key: key);
+
+HjvReadyContext _context(
+    {required bool? passwordSet, required HjvReadyWol? wol}) {
+  final loggedIn = gFFI.userModel.isLogin;
+  final guest = hjvAccessGuestTicket();
+  final now = DateTime.now();
+  return HjvReadyContext(
+      installed: bind.mainIsInstalled(),
+      canInstall: !bind.isDisableInstallation(),
+      loggedIn: loggedIn,
+      refusal: loggedIn ? hjvPcRefusalCause()?.$1 : null,
+      guestUntil: guest.until,
+      guestByCode: guest.byCode,
+      guestUntilText: hjvUntilText(
+          DateTime.fromMillisecondsSinceEpoch(guest.until * 1000), now),
+      now: now.millisecondsSinceEpoch ~/ 1000,
+      passwordSet: passwordSet,
+      canSetPassword: !isChangePermanentPasswordDisabled(),
+      verificationMethod: _option(kOptionVerificationMethod),
+      approveMode: _option(kOptionApproveMode),
+      methodFixed: isOptionFixed(kOptionVerificationMethod),
+      approveFixed: isOptionFixed(kOptionApproveMode),
+      idleAllow: _option(kOptionAllowAutoDisconnect),
+      idleMinutes: _option(kOptionAutoDisconnectTimeout),
+      idleFixed: isOptionFixed(kOptionAllowAutoDisconnect) ||
+          isOptionFixed(kOptionAutoDisconnectTimeout),
+      wol: wol);
+}
+
+/// The home's G4 count, at most once a minute (the PC home's timer): a logged-in installed
+/// Windows PC only. The relay is asked only when sleeping would count (D14), from the card's
+/// last answer while it is fresh.
+Future<void> hjvReadyHomeTick() async {
+  if (!isWindows || !bind.mainIsInstalled() || !gFFI.userModel.isLogin) {
+    hjvReadyHomeMissing.value = 0;
+    return;
+  }
+  final facts = await _facts(wake: false);
+  final passwordSet = await _passwordSet();
+  int count(HjvReadyWol? wol) => hjvReadyMissing(
+      hjvReadyRows(_t, facts, _context(passwordSet: passwordSet, wol: wol)),
+      home: true);
+  var missing = count(_wol);
+  if (missing > 0 &&
+      facts?.sleepMinutes != null &&
+      (_wolAt == null || DateTime.now().difference(_wolAt!) > _kWolAge)) {
+    missing = count(await _askWol());
+  }
+  hjvReadyHomeMissing.value = missing;
+}
+
+class HjvReadyCard extends StatefulWidget {
+  const HjvReadyCard({super.key});
+
+  @override
+  State<HjvReadyCard> createState() => _HjvReadyCardState();
+}
+
+class _HjvReadyCardState extends State<HjvReadyCard>
+    with WidgetsBindingObserver {
+  HjvReadiness? _r;
+  bool? _passwordSetNow;
+  bool _loading = true;
+  DateTime? _checkedAt;
+  StreamSubscription<String>? _user;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    _load();
+    _user = gFFI.userModel.userName.listen((_) => _load());
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _user?.cancel();
+    super.dispose();
+  }
+
+  // the settings window back in front: read again, at most once a minute
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    final at = _checkedAt;
+    if (state == AppLifecycleState.resumed &&
+        !_loading &&
+        (at == null ||
+            DateTime.now().difference(at) > const Duration(minutes: 1))) {
+      _load();
+    }
+  }
+
+  Future<void> _load() async {
+    // the first read is under way from initState, where setState may not run
+    if (mounted && !_loading) setState(() => _loading = true);
+    final installed = bind.mainIsInstalled();
+    final facts = installed ? await _facts(wake: true) : null;
+    final passwordSet = installed ? await _passwordSet() : null;
+    if (installed && gFFI.userModel.isLogin) {
+      await _askWol();
+    }
+    if (!mounted) return;
+    setState(() {
+      _r = facts;
+      _passwordSetNow = passwordSet;
+      _loading = false;
+      _checkedAt = DateTime.now();
+    });
+    hjvReadyHomeMissing.value =
+        gFFI.userModel.isLogin ? hjvReadyMissing(_rows(), home: true) : 0;
+  }
+
+  List<HjvReadyRow> _rows() => hjvReadyRows(
+      _t,
+      _r,
+      _context(
+          passwordSet: _passwordSetNow,
+          wol: gFFI.userModel.isLogin ? _wol : null));
+
+  void _act(HjvReadyAction action) {
+    final t = _t;
+    switch (action) {
+      case HjvReadyAction.install:
+        () async {
+          await rustDeskWinManager.closeAllSubWindows();
+          bind.mainGotoInstall();
+        }();
+      case HjvReadyAction.logIn:
+        loginDialog().then((_) => _load());
+      case HjvReadyAction.refusal:
+        hjvPcRefusalCause()?.$3();
+      case HjvReadyAction.setPassword:
+        hjvUnlockThen(() => setPasswordDialog(notEmptyCallback: _load));
+      case HjvReadyAction.fixMethod:
+        _setOptions({kOptionVerificationMethod: ''});
+      case HjvReadyAction.fixApprove:
+        _setOptions({kOptionApproveMode: ''});
+      case HjvReadyAction.idleOn:
+        _setOptions({
+          kOptionAllowAutoDisconnect: 'Y',
+          kOptionAutoDisconnectTimeout: '$kHjvReadyIdleMinutes',
+        });
+      case HjvReadyAction.sleepNever:
+        gFFI.dialogManager.show<void>(
+            (setState, close, context) => hjvConfirmDialog(hjvAppTexts(),
+                    title: t.sleepAskTitle,
+                    text: t.sleepAsk,
+                    yes: t.change,
+                    no: t.cancel, onYes: () {
+                  close();
+                  _sleep('sleep-never', t.sleepChanged);
+                }, onNo: close),
+            backDismiss: true);
+      case HjvReadyAction.sleepUndo:
+        _sleep('sleep-undo', t.sleepUndone);
+      case HjvReadyAction.howReinstall:
+      case HjvReadyAction.howPolicy:
+      case HjvReadyAction.howNic:
+      case HjvReadyAction.howFastStartup:
+      case HjvReadyAction.howRelay:
+        final how = hjvReadyHowOf(action);
+        if (how != null) _howDialog(t, how, card: hjvReadyCardName(_r));
+    }
+  }
+
+  /// A security option, behind the same unlock as the security settings.
+  void _setOptions(Map<String, String> options) => hjvUnlockThen(() async {
+        for (final MapEntry(:key, :value) in options.entries) {
+          await bind.mainSetOption(key: key, value: value);
+        }
+        _load();
+      });
+
+  Future<void> _sleep(String what, String done) async {
+    try {
+      await bind.mainSetCommon(key: 'hjv-ready-fix', value: what);
+    } catch (e) {
+      debugPrint('hjv: readiness: $e');
+    }
+    await _load();
+    showToast(_r?.fix == 'ok' ? done : _t.sleepFailed);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final t = _t;
+    final p = HjvPalette.of(context);
+    final rows = _rows();
+    final missing = hjvReadyMissing(rows);
+    final at = _checkedAt;
+    String two(int n) => n.toString().padLeft(2, '0');
+    final header = missing == 0 ? t.allSet : t.toCheck(missing);
+    Widget group(HjvReadyGroup g, String label) {
+      final of = rows.where((r) => r.group == g).toList();
+      if (of.isEmpty) return const SizedBox.shrink();
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Semantics(
+              header: true,
+              child: Text(label,
+                  style: HjvText.bodySmall.copyWith(
+                      color: p.textTertiary, fontWeight: FontWeight.w600))),
+          for (final row in of) _row(context, t, row),
+        ],
+      ).marginOnly(top: 10);
+    }
+
+    return Container(
+      padding: const EdgeInsets.fromLTRB(12, 10, 8, 8),
+      decoration: hjvCardDecoration(context, radius: HjvRadius.md),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(t.title, style: HjvText.titleSmall.copyWith(color: p.text)),
+          Text(t.subtitle,
+              style: HjvText.bodySmall.copyWith(color: p.textSecondary)),
+          const SizedBox(height: 8),
+          if (_loading)
+            Row(children: [
+              SizedBox(
+                  width: 80,
+                  child: LinearProgressIndicator(semanticsLabel: t.checking)),
+              const SizedBox(width: 8),
+              Text(t.checking,
+                  style: TextStyle(fontSize: 13, color: p.textSecondary)),
+            ])
+          else
+            Row(children: [
+              Icon(
+                  missing == 0
+                      ? Icons.check_circle_rounded
+                      : Icons.warning_amber_rounded,
+                  size: 18,
+                  color: missing == 0 ? p.successText : p.warningText),
+              const SizedBox(width: 6),
+              Expanded(
+                  child: Text(header,
+                      style: TextStyle(
+                          fontSize: 13,
+                          fontWeight: FontWeight.w600,
+                          color: missing == 0 ? p.text : p.warningText))),
+            ]),
+          group(HjvReadyGroup.take, t.groupTake),
+          group(HjvReadyGroup.wake, t.groupWake),
+          group(HjvReadyGroup.end, t.groupEnd),
+          Row(children: [
+            Expanded(
+                child: Text(
+                    at == null
+                        ? ''
+                        : t.checkedAt('${two(at.hour)}:${two(at.minute)}'),
+                    style: HjvText.bodySmall.copyWith(color: p.textTertiary))),
+            TextButton(
+                onPressed: _loading ? null : _load, child: Text(t.checkAgain)),
+          ]).marginOnly(top: 6),
+        ],
+      ),
+    ).marginOnly(bottom: 8);
+  }
+
+  Widget _row(BuildContext context, HjvReadyTexts t, HjvReadyRow row) {
+    final p = HjvPalette.of(context);
+    final (icon, color) = switch (row.level) {
+      HjvReadyLevel.ok => (Icons.check_circle_rounded, p.successText),
+      HjvReadyLevel.warn => (Icons.warning_amber_rounded, p.warningText),
+      HjvReadyLevel.no => (Icons.cancel_rounded, p.dangerText),
+      HjvReadyLevel.unknown => (Icons.radio_button_unchecked, p.textTertiary),
+    };
+    final refusal = row.item == HjvReadyItem.logIn &&
+            row.actions.contains(HjvReadyAction.refusal)
+        ? hjvPcRefusalCause()?.$2
+        : null;
+    return Padding(
+      padding: const EdgeInsets.only(top: 6),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Semantics(
+                  label: t.level(row.level),
+                  child: Icon(icon, size: 18, color: color))
+              .marginOnly(top: 1),
+          const SizedBox(width: 8),
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(hjvKeepAll(row.text),
+                    style: TextStyle(fontSize: 13, color: p.text)),
+                for (final note in row.notes)
+                  Row(
+                    crossAxisAlignment: CrossAxisAlignment.start,
+                    children: [
+                      Icon(Icons.warning_amber_rounded,
+                              size: 14, color: p.warningText)
+                          .marginOnly(top: 2, right: 4),
+                      Expanded(
+                          child: Text(hjvKeepAll(note),
+                              style: TextStyle(
+                                  fontSize: 12, color: p.textSecondary))),
+                    ],
+                  ).marginOnly(top: 2),
+                if (row.actions.isNotEmpty)
+                  Wrap(spacing: 8, runSpacing: 6, children: [
+                    for (final action in row.actions)
+                      hjvButton(
+                          action == HjvReadyAction.refusal
+                              ? refusal ?? t.fix
+                              : t.action(action),
+                          () => _act(action),
+                          tone: HjvButtonTone.quiet),
+                  ]).marginOnly(top: 6),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+/// [방법 보기]: the steps, and [자세히] for docs/wol-pc-setup.md's section in the public
+/// repository where it has one.
+void _howDialog(HjvReadyTexts t, HjvReadyHow how, {String card = ''}) {
+  final (title, steps) = t.how(how, card: card, contact: hjvAdminContact());
+  final section = hjvReadyHowSection(how);
+  gFFI.dialogManager.show<void>(
+      (setState, close, context) => CustomAlertDialog(
+            title: Text(title),
+            contentBoxConstraints: HjvDialogWidth.box(HjvDialogWidth.md),
+            content: Column(
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                for (final step in steps)
+                  Text(hjvKeepAll(step)).marginOnly(bottom: 6),
+              ],
+            ),
+            actions: [
+              if (section != null)
+                hjvButton(t.more, () {
+                  launchUrl(
+                      Uri(
+                          scheme: 'https',
+                          host: kHjvSourceRepo.split('/').first,
+                          path:
+                              '/${kHjvSourceRepo.split('/').skip(1).join('/')}/blob/main/docs/wol-pc-setup.md',
+                          fragment: section),
+                      mode: LaunchMode.externalApplication);
+                }, tone: HjvButtonTone.quiet),
+              hjvButton(t.close, close),
+            ],
+            onSubmit: close,
+            onCancel: close,
+          ),
+      backDismiss: true);
+}
diff --git a/flutter/lib/common/hjviewer_ready_texts.dart b/flutter/lib/common/hjviewer_ready_texts.dart
new file mode 100644
index 0000000..31f00bf
--- /dev/null
+++ b/flutter/lib/common/hjviewer_ready_texts.dart
@@ -0,0 +1,726 @@
+// HJViewer's remote readiness card (TV-W4, the hjviewer repository's docs/architecture.md 5-12):
+// its texts in Korean and English, this PC's facts as the core reads them (src/hjviewer_ready.rs,
+// main_get_common("hjv-ready")), and the card's rows with their marks and buttons. Plain Dart
+// without the bridge, so that the tests and the preview draw the card from one JSON.
+//
+// The wired card rules (R5) follow hjv-api's (server/api/src/wolinfo.rs `readiness`): a change
+// there should change them here too, and the other way round.
+
+import 'dart:convert';
+
+import 'package:flutter_hbb/common/hjviewer_account_texts.dart'
+    show hjvAdminContactText;
+
+/// A row's mark: ✔ done, ⚠ advised (works unattended, with a risk or a limit), ✗ an unattended
+/// connection fails as it is, ○ not checked.
+enum HjvReadyLevel { ok, warn, no, unknown }
+
+/// The card's groups: taking connections (R1-R4, their ✗ count in the header and on the home),
+/// switching an off PC on (R5-R7, a logged-in PC only), when a session ends (R8, R9).
+enum HjvReadyGroup { take, wake, end }
+
+enum HjvReadyItem {
+  install,
+  logIn,
+  password,
+  sleep,
+  nic,
+  fastStartup,
+  relay,
+  idle,
+  endLock
+}
+
+/// What a row's button does. `refusal` is U06's button of a logged-in PC that the server does
+/// not take (hjvPcRefusalCause).
+enum HjvReadyAction {
+  install,
+  howReinstall,
+  logIn,
+  refusal,
+  setPassword,
+  fixMethod,
+  fixApprove,
+  sleepNever,
+  sleepUndo,
+  howPolicy,
+  howNic,
+  howFastStartup,
+  howRelay,
+  idleOn,
+}
+
+/// The [방법 보기] windows (docs/wol-pc-setup.md, shortened).
+enum HjvReadyHow { reinstall, policy, nic, fastStartup, relay }
+
+class HjvReadyRow {
+  final HjvReadyItem item;
+  final HjvReadyGroup group;
+  final HjvReadyLevel level;
+  final String text;
+
+  /// lines below the text, each a ⚠ of its own (the lid, the battery)
+  final List<String> notes;
+  final List<HjvReadyAction> actions;
+  const HjvReadyRow(this.item, this.group, this.level, this.text,
+      {this.notes = const [], this.actions = const []});
+}
+
+/// A wired card as the PC's own wake report has it (hjviewer_wol.rs `LocalCard`).
+class HjvReadyNic {
+  final String name;
+  final bool? armed;
+  final String? magic;
+  final bool usb;
+  const HjvReadyNic(this.name, {this.armed, this.magic, this.usb = false});
+}
+
+/// This PC's facts (`hjv-ready`); null fields are what Windows did not say.
+class HjvReadiness {
+  final bool installed;
+  final bool? svcAuto;
+  final bool? svcRunning;
+  final int? standbyS;
+  final int? hibernateS;
+  final bool policy;
+  final bool? lid;
+  final int? acLid;
+  final bool? onAc;
+
+  /// [되돌리기] can put back the times kept for the current plan
+  final bool was;
+
+  /// the last [절전 안 함] or [되돌리기]: ok, denied, policy, failed
+  final String? fix;
+
+  /// the wired cards, null when the report was not read (or not asked: the home's read)
+  final List<HjvReadyNic>? wired;
+  final bool? fastStartup;
+
+  const HjvReadiness(
+      {this.installed = true,
+      this.svcAuto,
+      this.svcRunning,
+      this.standbyS,
+      this.hibernateS,
+      this.policy = false,
+      this.lid,
+      this.acLid,
+      this.onAc,
+      this.was = false,
+      this.fix,
+      this.wired,
+      this.fastStartup});
+
+  /// The core's JSON; null for one that is not this PC's facts (an older core gives "", and a
+  /// PC that is not Windows `"windows":false`).
+  static HjvReadiness? parse(String json) {
+    Object? v;
+    try {
+      v = jsonDecode(json);
+    } catch (e) {
+      return null;
+    }
+    if (v is! Map || v['v'] != 1 || v['windows'] != true) return null;
+    bool? flag(Object? x) => x is bool ? x : null;
+    int? number(Object? x) => x is int ? x : null;
+    final sleep = v['sleep'] is Map ? v['sleep'] as Map : const {};
+    final wake = v['wake'] is Map ? v['wake'] as Map : null;
+    final cards = wake?['wired'];
+    return HjvReadiness(
+      installed: v['installed'] != false,
+      svcAuto: flag(v['svc_auto']),
+      svcRunning: flag(v['svc_running']),
+      standbyS: number(sleep['ac_standby_s']),
+      hibernateS: number(sleep['ac_hibernate_s']),
+      policy: sleep['policy'] == true,
+      lid: flag(sleep['lid']),
+      acLid: number(sleep['ac_lid']),
+      onAc: flag(sleep['on_ac']),
+      was: sleep['was'] == true,
+      fix: sleep['fix'] is String ? sleep['fix'] as String : null,
+      wired: cards is List
+          ? [
+              for (final c in cards)
+                if (c is Map)
+                  HjvReadyNic(c['name'] is String ? c['name'] as String : '',
+                      armed: flag(c['armed']),
+                      magic: c['magic'] is String ? c['magic'] as String : null,
+                      usb: c['usb'] == true)
+            ]
+          : null,
+      fastStartup: wake == null ? null : flag(wake['fast_startup']),
+    );
+  }
+
+  /// The plugged-in sleep in minutes (the sooner of sleep and hibernation), null when it never
+  /// sleeps by itself or Windows did not say.
+  int? get sleepMinutes {
+    final times = [standbyS, hibernateS].whereType<int>().where((s) => s > 0);
+    if (times.isEmpty) return null;
+    final s = times.reduce((a, b) => a < b ? a : b);
+    return (s + 59) ~/ 60;
+  }
+}
+
+/// What hjv-api said of this PC's wake (GET /api/hjv/devices/<ID>/wol): `failed` when it could
+/// not be asked.
+class HjvReadyWol {
+  final bool failed;
+  final String ready;
+  final bool reported;
+  final String? relayName;
+  final bool relayOnline;
+  const HjvReadyWol(
+      {this.failed = false,
+      this.ready = 'unknown',
+      this.reported = false,
+      this.relayName,
+      this.relayOnline = false});
+
+  static const HjvReadyWol unreachable = HjvReadyWol(failed: true);
+
+  /// The answer's status and body; a 404 (this PC is not the account's) has no report.
+  static HjvReadyWol of(int status, Object? body) {
+    if (status == 404) return const HjvReadyWol();
+    if (status != 200 || body is! Map) return unreachable;
+    final relay = body['relay'] is Map ? body['relay'] as Map : null;
+    return HjvReadyWol(
+        ready: body['ready'] is String ? body['ready'] as String : 'unknown',
+        reported: body['reported_at'] != null,
+        relayName: relay == null
+            ? null
+            : relay['name'] is String
+                ? relay['name'] as String
+                : '',
+        relayOnline: relay?['online'] == true);
+  }
+
+  /// A relay on its network that would wake it now (D14: sleeping is then a ⚠ only).
+  bool get wakes =>
+      !failed &&
+      relayName != null &&
+      relayOnline &&
+      (ready == 'ok' || ready == 'warn');
+}
+
+/// What the rows are made of besides this PC's facts.
+class HjvReadyContext {
+  final bool installed;
+  final bool canInstall;
+  final bool loggedIn;
+
+  /// U06's line of a logged-in PC that the server does not take, null without one
+  final String? refusal;
+
+  /// P2's or P3's ticket: until when (Unix seconds, 0 without one), whether a support code
+  /// brought it, and its end as the home shows it
+  final int guestUntil;
+  final bool guestByCode;
+  final String guestUntilText;
+  final int now;
+
+  /// whether a permanent password is set, null while it is asked
+  final bool? passwordSet;
+  final bool canSetPassword;
+  final String verificationMethod;
+  final String approveMode;
+  final bool methodFixed;
+  final bool approveFixed;
+
+  /// allow-auto-disconnect and auto-disconnect-timeout as the options have them
+  final String idleAllow;
+  final String idleMinutes;
+  final bool idleFixed;
+
+  /// hjv-api's answer; null while it is asked
+  final HjvReadyWol? wol;
+
+  const HjvReadyContext(
+      {this.installed = true,
+      this.canInstall = true,
+      this.loggedIn = false,
+      this.refusal,
+      this.guestUntil = 0,
+      this.guestByCode = false,
+      this.guestUntilText = '',
+      this.now = 0,
+      this.passwordSet,
+      this.canSetPassword = true,
+      this.verificationMethod = '',
+      this.approveMode = '',
+      this.methodFixed = false,
+      this.approveFixed = false,
+      this.idleAllow = '',
+      this.idleMinutes = '',
+      this.idleFixed = false,
+      this.wol});
+}
+
+/// The server_model.dart value that takes the one-time password only.
+const _kTemporaryOnly = 'use-temporary-password';
+
+/// The minutes upstream disconnects after when the option has none (connection.rs).
+const _kIdleDefault = 10;
+
+/// The minutes [켜기 (30분)] sets (D16).
+const kHjvReadyIdleMinutes = 30;
+
+/// The card's rows for `r` (null: the facts could not be read) in `c`. A PC where HJViewer is not
+/// installed gets R1 only (D17); R5-R7 and R9 need a login.
+List<HjvReadyRow> hjvReadyRows(
+    HjvReadyTexts t, HjvReadiness? r, HjvReadyContext c,
+    {String contact = ''}) {
+  final rows = <HjvReadyRow>[_install(t, r, c)];
+  if (!c.installed) return rows;
+  rows
+    ..add(_logIn(t, c))
+    ..add(_password(t, c))
+    ..add(_sleep(t, r, c));
+  if (c.loggedIn) {
+    rows
+      ..add(_nic(t, r))
+      ..add(_fastStartup(t, r))
+      ..add(_relay(t, c));
+  }
+  rows.add(_idle(t, c));
+  if (c.loggedIn) {
+    rows.add(HjvReadyRow(
+        HjvReadyItem.endLock, HjvReadyGroup.end, HjvReadyLevel.ok, t.endLock));
+  }
+  return rows;
+}
+
+/// The ✗ rows of taking connections: the card's header, and with `home` (G4, D-12) those the
+/// home counts, without the login, which the home's own notices take care of.
+int hjvReadyMissing(List<HjvReadyRow> rows, {bool home = false}) => rows
+    .where((r) =>
+        r.group == HjvReadyGroup.take &&
+        r.level == HjvReadyLevel.no &&
+        !(home && r.item == HjvReadyItem.logIn))
+    .length;
+
+HjvReadyRow _install(HjvReadyTexts t, HjvReadiness? r, HjvReadyContext c) {
+  HjvReadyRow row(HjvReadyLevel level, String text,
+          [List<HjvReadyAction> actions = const []]) =>
+      HjvReadyRow(HjvReadyItem.install, HjvReadyGroup.take, level, text,
+          actions: actions);
+  if (!c.installed) {
+    return row(HjvReadyLevel.no, t.notInstalled,
+        [if (c.canInstall) HjvReadyAction.install]);
+  }
+  if (r?.svcAuto == false) {
+    return row(HjvReadyLevel.no, t.notAutoStart, [HjvReadyAction.howReinstall]);
+  }
+  if (r?.svcRunning == false) {
+    return row(
+        HjvReadyLevel.no, t.serviceStopped, [HjvReadyAction.howReinstall]);
+  }
+  if (r?.svcAuto == true && r?.svcRunning == true) {
+    return row(HjvReadyLevel.ok, t.installed);
+  }
+  return row(HjvReadyLevel.unknown, t.notChecked);
+}
+
+HjvReadyRow _logIn(HjvReadyTexts t, HjvReadyContext c) {
+  HjvReadyRow row(HjvReadyLevel level, String text, HjvReadyAction? action) =>
+      HjvReadyRow(HjvReadyItem.logIn, HjvReadyGroup.take, level, text,
+          actions: [if (action != null) action]);
+  if (c.loggedIn) {
+    final refusal = c.refusal;
+    return refusal == null
+        ? row(HjvReadyLevel.ok, t.loggedIn, null)
+        : row(HjvReadyLevel.no, refusal, HjvReadyAction.refusal);
+  }
+  if (c.guestUntil > c.now) {
+    return row(
+        HjvReadyLevel.warn,
+        t.guestOnly(c.guestUntilText, code: c.guestByCode),
+        HjvReadyAction.logIn);
+  }
+  return row(HjvReadyLevel.no, t.notLoggedIn, HjvReadyAction.logIn);
+}
+
+HjvReadyRow _password(HjvReadyTexts t, HjvReadyContext c) {
+  HjvReadyRow row(HjvReadyLevel level, String text, HjvReadyAction? action) =>
+      HjvReadyRow(HjvReadyItem.password, HjvReadyGroup.take, level, text,
+          actions: [if (action != null) action]);
+  if (c.approveMode == 'click') {
+    return row(HjvReadyLevel.no, t.clickOnly,
+        c.approveFixed ? null : HjvReadyAction.fixApprove);
+  }
+  if (c.verificationMethod == _kTemporaryOnly) {
+    return row(HjvReadyLevel.no, t.temporaryOnly,
+        c.methodFixed ? null : HjvReadyAction.fixMethod);
+  }
+  final set = c.passwordSet;
+  if (set == null) return row(HjvReadyLevel.unknown, t.checking, null);
+  if (!set) {
+    return row(HjvReadyLevel.no, t.noPassword,
+        c.canSetPassword ? HjvReadyAction.setPassword : null);
+  }
+  return row(HjvReadyLevel.ok, t.passwordSet, null);
+}
+
+HjvReadyRow _sleep(HjvReadyTexts t, HjvReadiness? r, HjvReadyContext c) {
+  if (r == null || (r.standbyS == null && r.hibernateS == null)) {
+    return HjvReadyRow(HjvReadyItem.sleep, HjvReadyGroup.take,
+        HjvReadyLevel.unknown, t.notChecked);
+  }
+  final minutes = r.sleepMinutes;
+  final policy = r.policy || r.fix == 'denied' || r.fix == 'policy';
+  final undo = [if (r.was) HjvReadyAction.sleepUndo];
+  final battery = r.onAc == false;
+  final lid = switch (r.lid == true ? r.acLid : null) {
+    1 => t.lidSleeps,
+    2 => t.lidHibernates,
+    3 => t.lidShutsDown,
+    _ => null,
+  };
+  final (level, text, actions) = minutes == null
+      ? battery
+          ? (HjvReadyLevel.warn, t.onBattery, undo)
+          : (HjvReadyLevel.ok, t.neverSleeps, undo)
+      : policy
+          ? (
+              HjvReadyLevel.warn,
+              t.sleepPolicy,
+              [HjvReadyAction.howPolicy, ...undo]
+            )
+          : c.wol?.wakes == true
+              ? (
+                  HjvReadyLevel.warn,
+                  t.sleepsButWakes(minutes),
+                  [HjvReadyAction.sleepNever, ...undo]
+                )
+              : (
+                  HjvReadyLevel.no,
+                  t.sleeps(minutes),
+                  [HjvReadyAction.sleepNever, ...undo]
+                );
+  return HjvReadyRow(HjvReadyItem.sleep, HjvReadyGroup.take, level, text,
+      notes: [
+        if (battery && minutes != null) t.onBattery,
+        if (lid != null) lid,
+      ],
+      actions: actions);
+}
+
+HjvReadyRow _nic(HjvReadyTexts t, HjvReadiness? r) {
+  HjvReadyRow row(HjvReadyLevel level, String text, {bool how = true}) =>
+      HjvReadyRow(HjvReadyItem.nic, HjvReadyGroup.wake, level, text,
+          actions: [if (how) HjvReadyAction.howNic]);
+  final cards = r?.wired;
+  if (cards == null) {
+    return row(HjvReadyLevel.unknown, t.notChecked, how: false);
+  }
+  if (cards.isEmpty) return row(HjvReadyLevel.warn, t.noWired, how: false);
+  if (cards.every((c) => c.usb)) {
+    return row(HjvReadyLevel.warn, t.usbOnly, how: false);
+  }
+  if (cards.every((c) => c.armed == false)) {
+    return row(HjvReadyLevel.warn, t.notArmed);
+  }
+  if (cards.any((c) => c.magic == '0')) {
+    return row(HjvReadyLevel.warn, t.magicOff);
+  }
+  if (!cards.any((c) => c.magic == '1')) {
+    return row(HjvReadyLevel.warn, t.magicUnknown);
+  }
+  final card = cards.firstWhere((c) => c.magic == '1' && c.armed != false,
+      orElse: () => cards.first);
+  return row(HjvReadyLevel.ok, t.wiredWakes(card.name), how: false);
+}
+
+/// The wired card the NIC's [방법 보기] names: the first the report has.
+String hjvReadyCardName(HjvReadiness? r) {
+  final cards = r?.wired ?? const [];
+  return cards.isEmpty ? '' : cards.first.name;
+}
+
+HjvReadyRow _fastStartup(HjvReadyTexts t, HjvReadiness? r) =>
+    switch (r?.fastStartup) {
+      true => HjvReadyRow(HjvReadyItem.fastStartup, HjvReadyGroup.wake,
+          HjvReadyLevel.warn, t.fastStartupOn,
+          actions: const [HjvReadyAction.howFastStartup]),
+      false => HjvReadyRow(HjvReadyItem.fastStartup, HjvReadyGroup.wake,
+          HjvReadyLevel.ok, t.fastStartupOff),
+      null => HjvReadyRow(HjvReadyItem.fastStartup, HjvReadyGroup.wake,
+          HjvReadyLevel.unknown, t.notChecked),
+    };
+
+HjvReadyRow _relay(HjvReadyTexts t, HjvReadyContext c) {
+  HjvReadyRow row(HjvReadyLevel level, String text, {bool how = false}) =>
+      HjvReadyRow(HjvReadyItem.relay, HjvReadyGroup.wake, level, text,
+          actions: [if (how) HjvReadyAction.howRelay]);
+  final wol = c.wol;
+  if (wol == null) return row(HjvReadyLevel.unknown, t.checking);
+  if (wol.failed) return row(HjvReadyLevel.unknown, t.relayUnreachable);
+  if (!wol.reported) return row(HjvReadyLevel.warn, t.relayNoReport);
+  final name = wol.relayName;
+  if (name == null) return row(HjvReadyLevel.warn, t.noRelay, how: true);
+  if (!wol.relayOnline) {
+    return row(HjvReadyLevel.warn, t.relayOffline(name), how: true);
+  }
+  return row(HjvReadyLevel.ok, t.relay(name));
+}
+
+HjvReadyRow _idle(HjvReadyTexts t, HjvReadyContext c) {
+  if (c.idleAllow == 'Y') {
+    final minutes = int.tryParse(c.idleMinutes.trim()) ?? 0;
+    return HjvReadyRow(HjvReadyItem.idle, HjvReadyGroup.end, HjvReadyLevel.ok,
+        t.idleOn(minutes > 0 ? minutes : _kIdleDefault));
+  }
+  return HjvReadyRow(
+      HjvReadyItem.idle, HjvReadyGroup.end, HjvReadyLevel.warn, t.idleOff,
+      actions: [if (!c.idleFixed) HjvReadyAction.idleOn]);
+}
