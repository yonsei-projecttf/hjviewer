+      HjvReadyAction.howPolicy => HjvReadyHow.policy,
+      HjvReadyAction.howNic => HjvReadyHow.nic,
+      HjvReadyAction.howFastStartup => HjvReadyHow.fastStartup,
+      HjvReadyAction.howRelay => HjvReadyHow.relay,
+      _ => null,
+    };
