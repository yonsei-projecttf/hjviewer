+#[derive(Serialize, Debug, Clone, PartialEq)]
+pub(crate) struct LocalWake {
+    pub wired: Vec<LocalCard>,
+    pub fast_startup: Option<bool>,
+}
+
+#[derive(Serialize, Debug, Clone, PartialEq)]
+pub(crate) struct LocalCard {
+    pub name: String,
+    pub armed: Option<bool>,
+    pub magic: Option<String>,
+    pub usb: bool,
+}
+
+impl Report {
+    /// The readiness card's part of this report (its fields are this module's).
+    pub(crate) fn local_summary(&self) -> LocalWake {
+        LocalWake {
+            wired: self
+                .adapters
+                .iter()
+                .map(|a| LocalCard {
+                    name: a.desc.clone(),
+                    armed: a.armed,
+                    magic: a.wake.magic.clone(),
+                    usb: a.bus.as_deref() == Some("usb"),
+                })
+                .collect(),
+            fast_startup: self.power.fast_startup,
+        }
+    }
+}
