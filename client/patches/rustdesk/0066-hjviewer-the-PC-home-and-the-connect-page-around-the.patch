+bool hjvPcHomeLogsIn(HjvPcHome home) =>
+    home == HjvPcHome.refused || home == HjvPcHome.logIn;
+
+/// What the PC home says while P1 shows and nobody can connect with its ID: `tip` in place of
+/// desk_tip, and `idLine` on the ID's card (none on a logged-in PC, which has nothing to enter).
+typedef HjvPcBlocked = ({String tip, String? idLine});
+
+/// The PC home's words while P1 shows, null while the ID can be reached.
+HjvPcBlocked? hjvPcBlocked(HjvAccessTexts t, HjvPcHome home) => switch (home) {
+      HjvPcHome.refused => (tip: t.pcBlockedTip, idLine: t.pcBlockedId),
+      HjvPcHome.refusedLoggedIn => (tip: t.pcBlockedTip, idLine: null),
+      _ => null,
+    };
