diff --git a/flutter/lib/common/hjviewer_session_rules.dart b/flutter/lib/common/hjviewer_session_rules.dart
new file mode 100644
index 0000000..5bc1bcc
--- /dev/null
+++ b/flutter/lib/common/hjviewer_session_rules.dart
@@ -0,0 +1,276 @@
+// The phone and tablet session's own parts (W7): the gesture guide that opens by itself once per
+// mode at the first session, the switch between the remote screen and the same PC's file
+// transfer, and their texts in Korean and English. Plain Dart without the bridge, so that ci.sh
+// tests it with the web stand-in; hjviewer_session_switch.dart and the mobile pages wire it.
+
+// ---- the first gesture guide ----
+
+/// Local options (this device only): 'Y' once the guide of that mode was seen.
+const kHjvGestureSeenMouse = 'hjv-gesture-seen-mouse';
+const kHjvGestureSeenTouch = 'hjv-gesture-seen-touch';
+
+String hjvGestureSeenKey(bool touchMode) =>
+    touchMode ? kHjvGestureSeenTouch : kHjvGestureSeenMouse;
+
+/// Whether the guide opens by itself in this session (a second after the first image): on a
+/// phone or tablet, in a remote screen session to a peer that is not Android, with control
+/// (the mode button shows), while nothing else is in front (the soft keyboard, a dialog), once
+/// per session, and only while the mode in use was not seen on this device.
+bool hjvShouldShowGestureGuide(
+        {required bool touchMode,
+        required bool seenMouse,
+        required bool seenTouch,
+        required bool isMobile,
+        required bool defaultConn,
+        required bool peerAndroid,
+        required bool viewOnly,
+        required bool keyboard,
+        required bool softKeyboardOpen,
+        required bool dialogOpen,
+        required bool shownThisSession}) =>
+    isMobile &&
+    defaultConn &&
+    !peerAndroid &&
+    !viewOnly &&
+    keyboard &&
+    !softKeyboardOpen &&
+    !dialogOpen &&
+    !shownThisSession &&
+    !(touchMode ? seenTouch : seenMouse);
+
+/// The modes to mark seen when the panel closes: those shown while it was open (true = touch).
+Set<bool> hjvGestureModesSeen(List<bool> shownModes) => shownModes.toSet();
+
+/// One session's guide panel: opened by itself ([firstRun], with its title row) or by the mode
+/// button, the modes it showed, and what to mark seen when the user closes it. A panel still open
+/// when the session ends is not closed by the user, so nothing is marked and the next session
+/// shows it again.
+class HjvGestureGuideRun {
+  bool _firstRun = false;
+  bool _autoShown = false;
+  final _shown = <bool>[];
+
+  /// The open panel came by itself: it carries the title row and [알겠습니다].
+  bool get firstRun => _firstRun;
+
+  /// The guide already opened by itself in this session.
+  bool get autoShown => _autoShown;
+
+  void autoOpen(bool touchMode) {
+    _firstRun = true;
+    _autoShown = true;
+    _shown
+      ..clear()
+      ..add(touchMode);
+  }
+
+  void userOpen(bool touchMode) {
+    _firstRun = false;
+    _shown
+      ..clear()
+      ..add(touchMode);
+  }
+
+  /// The mode changed inside the open panel: the new mode shows too.
+  void modeChanged(bool touchMode) {
+    if (!_shown.contains(touchMode)) _shown.add(touchMode);
+  }
+
+  /// The user closed the panel ([알겠습니다], the ▼ button, the mode button).
+  Set<bool> close() {
+    final seen = hjvGestureModesSeen(_shown);
+    _shown.clear();
+    _firstRun = false;
+    return seen;
+  }
+}
+
+/// A gesture of the guide; the panel picks its icon.
+enum HjvGesture {
+  tap,
+  doubleTap,
+  twoFingerTap,
+  longPress,
+  dragPointer,
+  doubleTapDrag,
+  threeFingers,
+  twoFingerDrag,
+  pinch,
+  dragFinger,
+}
+
+class HjvGestureItem {
+  final HjvGesture gesture;
+
+  /// The hand's move and what it does on the PC.
+  final String move;
+  final String does;
+  const HjvGestureItem(this.gesture, this.move, this.does);
+}
+
+/// The guide's texts, as HJViewer's input does it (remote_input.dart): in mouse mode a tap clicks
+/// where the pointer is, two fingers tap a right click (0011), one finger moves the pointer; in
+/// touch mode a tap clicks where it lands. Three fingers scroll only on a peer that is not
+/// Android, which is also the only peer the guide opens for.
+class HjvGestureTexts {
+  final bool korean;
+  const HjvGestureTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  String title(bool touchMode) => touchMode
+      ? _t('터치 모드의 제스처', 'Gestures in touch mode')
+      : _t('마우스 모드의 제스처', 'Gestures in mouse mode');
+  String get body => _t('아래 막대의 모드 단추로 언제든 다시 볼 수 있습니다.',
+      'Open this again any time with the mode button on the bar below.');
+  String get gotIt => _t('알겠습니다', 'Got it');
+
+  List<HjvGestureItem> items(bool touchMode) {
+    final both = [
+      HjvGestureItem(HjvGesture.threeFingers,
+          _t('세 손가락 위아래', 'Three fingers up or down'), _t('스크롤', 'Scroll')),
+      HjvGestureItem(HjvGesture.twoFingerDrag,
+          _t('두 손가락 끌기', 'Drag two fingers'), _t('화면 옮기기', 'Move the view')),
+      HjvGestureItem(
+          HjvGesture.pinch, _t('두 손가락 벌리기·오므리기', 'Pinch'), _t('확대·축소', 'Zoom')),
+    ];
+    final doubleTap = HjvGestureItem(HjvGesture.doubleTap,
+        _t('두 번 탭', 'Double-tap'), _t('더블클릭', 'Double-click'));
+    final longPress = HjvGestureItem(HjvGesture.longPress,
+        _t('길게 누르기', 'Long press'), _t('오른쪽 클릭', 'Right click'));
+    if (touchMode) {
+      return [
+        HjvGestureItem(
+            HjvGesture.tap, _t('탭', 'Tap'), _t('그 자리 클릭', 'Click there')),
+        doubleTap,
+        longPress,
+        HjvGestureItem(HjvGesture.dragFinger, _t('한 손가락 끌기', 'Drag one finger'),
+            _t('끌어서 옮기기', 'Drag and drop')),
+        ...both,
+      ];
+    }
+    return [
+      HjvGestureItem(HjvGesture.tap, _t('탭', 'Tap'), _t('왼쪽 클릭', 'Left click')),
+      doubleTap,
+      HjvGestureItem(HjvGesture.twoFingerTap, _t('두 손가락 탭', 'Two-finger tap'),
+          _t('오른쪽 클릭', 'Right click')),
+      longPress,
+      HjvGestureItem(HjvGesture.dragPointer, _t('한 손가락 끌기', 'Drag one finger'),
+          _t('포인터 옮기기', 'Move the pointer')),
+      HjvGestureItem(
+          HjvGesture.doubleTapDrag,
+          _t('두 번 탭하고 끌기', 'Double-tap and drag'),
+          _t('끌어서 옮기기', 'Drag and drop')),
+      ...both,
+    ];
+  }
+}
+
+// ---- switching between the remote screen and the file transfer ----
+
+enum HjvSwitchTarget { files, remote }
+
+/// How long the page that closes may take before the switch is given up.
+const kHjvSwitchLimit = Duration(seconds: 10);
+
+/// A switch the page that closes opens once it is gone. The connection token (the session's
+/// password hash) is kept in memory only and never printed.
+class HjvPendingSwitch {
+  final HjvSwitchTarget to;
+  final String id;
+  final String? connToken;
+  final bool forceRelay;
+  final DateTime at;
+  const HjvPendingSwitch(this.to, this.id,
+      {this.connToken, this.forceRelay = false, required this.at});
+
+  @override
+  String toString() =>
+      'HjvPendingSwitch($to, $id, token ${connToken == null ? 'none' : 'set'})';
+}
+
+/// One pending switch, opened only after the page that closes is gone (the phone's sessions
+/// share one session ID, so a new session opened first would be closed by the old page's late
+/// close), and only within [kHjvSwitchLimit].
+class HjvSessionSwitch {
+  final DateTime Function() now;
+  HjvPendingSwitch? _pending;
+  HjvSessionSwitch({required this.now});
+
+  bool get pending => _pending != null;
+
+  /// A new request replaces the one before.
+  void request(HjvSwitchTarget to, String id,
+      {String? connToken, bool forceRelay = false}) {
+    _pending = HjvPendingSwitch(to, id,
+        connToken: connToken, forceRelay: forceRelay, at: now());
+  }
+
+  bool _late(HjvPendingSwitch p) => now().difference(p.at) > kHjvSwitchLimit;
+
+  /// The page of [id] finished closing: the switch to open, or null (none, another ID, past the
+  /// limit). Taking it clears it, so it opens once; a late one is dropped too.
+  HjvPendingSwitch? pageClosed(String id) {
+    final p = _pending;
+    if (p == null || p.id != id) return null;
+    _pending = null;
+    return _late(p) ? null : p;
+  }
+
+  /// The limit's timer: the switch given up (cleared) if it is still waiting past the limit.
+  HjvPendingSwitch? expire() {
+    final p = _pending;
+    if (p == null || !_late(p)) return null;
+    _pending = null;
+    return p;
+  }
+}
+
+/// The lines F1 adds below its text: the PC's own check again (not for a PC in the account's
+/// list), the access password again (an app without a login on a staff-only server: a new
+/// connection asks again, decision D-14), the voice call or recording that ends.
+List<String> hjvSwitchExtraLines(HjvSessionTexts t,
+        {required bool ownPc,
+        required bool guest,
+        required bool callOrRecording}) =>
+    [
+      if (!ownPc) t.pcMayAsk,
+      if (!ownPc && guest) t.guestAsks,
+      if (callOrRecording) t.callEnds,
+    ];
+
+class HjvSessionTexts {
+  final bool korean;
+  const HjvSessionTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  // F1, the remote screen's [파일 전송] in 더 보기
+  String get toFilesTitle => _t('파일 전송으로 바꿀까요?', 'Switch to file transfer?');
+  String get toFilesText => _t(
+      '원격 화면을 닫고 이 PC의 파일 전송을 엽니다. 파일 전송에서 [원격 화면으로]를 누르면 화면으로 돌아옵니다.',
+      'This closes the remote screen and opens file transfer with this PC. Tap [Remote screen] there to come back.');
+  String get pcMayAsk => _t(
+      'PC가 비밀번호나 수락을 다시 물을 수 있습니다. 일회용 비밀번호는 한 번 쓰면 바뀌므로, 그때는 PC 화면에 보이는 새 비밀번호가 필요합니다.',
+      'The PC may ask for its password or for acceptance again. A one-time password changes once it is used, so you would need the new one shown on the PC.');
+  String get guestAsks => _t('로그인하지 않았으므로 이용 비밀번호를 다시 넣어야 합니다.',
+      'You are not logged in, so you will enter the access password again.');
+  String get callEnds =>
+      _t('음성 통화와 녹화는 여기서 끝납니다.', 'The voice call and the recording end here.');
+
+  // the file transfer's [원격 화면으로] and F2
+  String get toRemoteLabel => _t('원격 화면으로 바꾸기', 'Switch to the remote screen');
+  String get toRemoteTitle =>
+      _t('원격 화면으로 바꿀까요?', 'Switch to the remote screen?');
+  String get toRemoteText =>
+      _t('진행 중인 전송이 멈춥니다.', 'Transfers in progress will stop.');
+
+  String get switchButton => _t('바꾸기', 'Switch');
+  String get cancel => _t('취소', 'Cancel');
+
+  // the limit passed before the page closed
+  String get filesFailed => _t('파일 전송을 열지 못했습니다. PC 목록에서 다시 열어 주세요.',
+      'Could not open file transfer. Open it again from the list of PCs.');
+  String get remoteFailed => _t('원격 화면을 열지 못했습니다. PC 목록에서 다시 열어 주세요.',
+      'Could not open the remote screen. Open it again from the list of PCs.');
+}
diff --git a/flutter/lib/common/hjviewer_session_switch.dart b/flutter/lib/common/hjviewer_session_switch.dart
new file mode 100644
index 0000000..5b0ea1e
--- /dev/null
+++ b/flutter/lib/common/hjviewer_session_switch.dart
@@ -0,0 +1,120 @@
+// W7 on the phone and tablet: switch a session between the remote screen and the same PC's file
+// transfer. The phone's pages share gFFI and one session ID, so the switch closes the page first
+// and opens the other one only after that page's close is done (hjvSessionPageClosed); the rules
+// and texts are in hjviewer_session_rules.dart.
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjviewer_access.dart';
+import 'package:flutter_hbb/common/hjviewer_session_rules.dart';
+import 'package:flutter_hbb/models/chat_model.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+
+HjvSessionTexts get _t => HjvSessionTexts(translate('Cancel') == '취소');
+
+final _switch = HjvSessionSwitch(now: DateTime.now);
+Timer? _limit;
+
+Widget _button(String label, VoidCallback onPressed,
+        {bool outline = false}) =>
+    Builder(
+        builder: (context) => TextButton(
+            style: TextButton.styleFrom(
+                foregroundColor:
+                    outline ? HjvPalette.of(context).textSecondary : null,
+                textStyle: TextStyle(
+                    fontFamily: kHjvFont,
+                    fontWeight: outline ? FontWeight.w600 : FontWeight.w700)),
+            onPressed: onPressed,
+            child: Text(label)));
+
+Future<bool> _confirm(String title, List<String> lines) async {
+  final t = _t;
+  final res = await gFFI.dialogManager.show<bool>(
+      (setState, close, context) => CustomAlertDialog(
+            title: Text(title),
+            content: Column(
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                for (final (i, line) in lines.indexed)
+                  Padding(
+                      padding: EdgeInsets.only(top: i == 0 ? 0 : 8),
+                      child: Text(line,
+                          style: i == 0
+                              ? null
+                              : TextStyle(
+                                  color:
+                                      HjvPalette.of(context).textSecondary))),
+              ],
+            ),
+            actions: [
+              _button(t.cancel, () => close(false), outline: true),
+              _button(t.switchButton, () => close(true)),
+            ],
+            onCancel: () => close(false),
+          ),
+      backDismiss: true);
+  return res == true;
+}
+
+bool _ownPc(String id) => gFFI.groupModel.peers.any((p) => p.id == id);
+
+/// 더 보기's [파일 전송] (to: files) and the file transfer's [원격 화면으로] (to: remote): F1 or F2,
+/// then close this page; the other one opens once it is gone.
+Future<void> hjvSwitchSession(
+    {required HjvSwitchTarget to,
+    required String id,
+    bool forceRelay = false,
+    bool transfersOpen = false}) async {
+  final t = _t;
+  if (to == HjvSwitchTarget.files) {
+    final loggedIn = gFFI.userModel.userName.value.isNotEmpty;
+    final lines = hjvSwitchExtraLines(t,
+        ownPc: _ownPc(id),
+        guest: !loggedIn && hjvAccessGateCloses() == true,
+        callOrRecording: gFFI.recordingModel.start ||
+            [VoiceCallStatus.waitingForResponse, VoiceCallStatus.connected]
+                .contains(gFFI.chatModel.voiceCallStatus.value));
+    if (!await _confirm(t.toFilesTitle, [t.toFilesText, ...lines])) return;
+  } else if (transfersOpen) {
+    if (!await _confirm(t.toRemoteTitle, [t.toRemoteText])) return;
+  }
+  // The token carries the session's password hash, so a permanent password typed by hand is not
+  // asked again (the desktop's connectWithToken in toolbar.dart).
+  String? token;
+  try {
+    token = bind.sessionGetConnToken(sessionId: gFFI.sessionId);
+  } catch (e) {
+    debugPrint('hjv: no connection token');
+  }
+  _switch.request(to, id, connToken: token, forceRelay: forceRelay);
+  _limit?.cancel();
+  _limit = Timer(kHjvSwitchLimit + const Duration(milliseconds: 100), () {
+    final p = _switch.expire();
+    if (p != null) {
+      showToast(p.to == HjvSwitchTarget.files ? t.filesFailed : t.remoteFailed);
+    }
+  });
+  closeConnection();
+}
+
+/// The end of a phone session page's dispose (remote_page.dart, file_manager_page.dart), after
+/// its gFFI.close(): opens the switch that page asked for, if any.
+void hjvSessionPageClosed(String id) {
+  final p = _switch.pageClosed(id);
+  if (p == null) return;
+  _limit?.cancel();
+  final context = globalKey.currentContext;
+  if (context == null) {
+    showToast(p.to == HjvSwitchTarget.files ? _t.filesFailed : _t.remoteFailed);
+    return;
+  }
+  connect(context, p.id,
+      isFileTransfer: p.to == HjvSwitchTarget.files,
+      connToken: p.connToken,
+      forceRelay: p.forceRelay);
+}
