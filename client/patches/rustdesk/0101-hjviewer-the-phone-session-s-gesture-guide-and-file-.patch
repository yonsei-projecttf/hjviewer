diff --git a/flutter/test/hjviewer_session_test.dart b/flutter/test/hjviewer_session_test.dart
new file mode 100644
index 0000000..54f9755
--- /dev/null
+++ b/flutter/test/hjviewer_session_test.dart
@@ -0,0 +1,207 @@
+import 'package:flutter_hbb/common/hjviewer_session_rules.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The phone session's first gesture guide and its switch between the remote screen and the file
+// transfer (W7), without the bridge.
+
+bool show(
+        {bool touchMode = false,
+        bool seenMouse = false,
+        bool seenTouch = false,
+        bool isMobile = true,
+        bool defaultConn = true,
+        bool peerAndroid = false,
+        bool viewOnly = false,
+        bool keyboard = true,
+        bool softKeyboardOpen = false,
+        bool dialogOpen = false,
+        bool shownThisSession = false}) =>
+    hjvShouldShowGestureGuide(
+        touchMode: touchMode,
+        seenMouse: seenMouse,
+        seenTouch: seenTouch,
+        isMobile: isMobile,
+        defaultConn: defaultConn,
+        peerAndroid: peerAndroid,
+        viewOnly: viewOnly,
+        keyboard: keyboard,
+        softKeyboardOpen: softKeyboardOpen,
+        dialogOpen: dialogOpen,
+        shownThisSession: shownThisSession);
+
+void main() {
+  group('the first gesture guide', () {
+    test('opens by itself only when every condition holds', () {
+      expect(show(), isTrue);
+      expect(show(isMobile: false), isFalse);
+      expect(show(defaultConn: false), isFalse);
+      expect(show(peerAndroid: true), isFalse);
+      expect(show(viewOnly: true), isFalse);
+      expect(show(keyboard: false), isFalse);
+      expect(show(softKeyboardOpen: true), isFalse);
+      expect(show(dialogOpen: true), isFalse);
+      expect(show(shownThisSession: true), isFalse);
+      expect(show(seenMouse: true), isFalse);
+      expect(show(touchMode: true, seenTouch: true), isFalse);
+    });
+
+    test('each mode is seen on its own', () {
+      expect(show(seenTouch: true), isTrue);
+      expect(show(touchMode: true, seenMouse: true), isTrue);
+      expect(hjvGestureSeenKey(false), 'hjv-gesture-seen-mouse');
+      expect(hjvGestureSeenKey(true), 'hjv-gesture-seen-touch');
+    });
+
+    test('closing marks the modes the panel showed', () {
+      final run = HjvGestureGuideRun()..autoOpen(false);
+      expect(run.firstRun, isTrue);
+      run.modeChanged(true);
+      expect(run.close(), {false, true});
+      expect(run.firstRun, isFalse);
+      expect(run.autoShown, isTrue);
+
+      final own = HjvGestureGuideRun()..userOpen(true);
+      expect(own.firstRun, isFalse);
+      expect(own.autoShown, isFalse);
+      expect(own.close(), {true});
+    });
+
+    test('a panel left open when the session ends marks nothing', () {
+      // the page is disposed without close(): a new session starts with a new run
+      final run = HjvGestureGuideRun()..autoOpen(true);
+      expect(run.autoShown, isTrue);
+      expect(HjvGestureGuideRun().close(), isEmpty);
+      expect(hjvGestureModesSeen([]), isEmpty);
+    });
+
+    test('lists what HJViewer does, in both languages', () {
+      for (final korean in [true, false]) {
+        final t = HjvGestureTexts(korean);
+        expect(t.items(false).length, 9);
+        expect(t.items(true).length, 7);
+        for (final touchMode in [false, true]) {
+          for (final e in t.items(touchMode)) {
+            expect(e.move, isNotEmpty);
+            expect(e.does, isNotEmpty);
+          }
+          expect(t.title(touchMode), isNotEmpty);
+        }
+      }
+      final ko = HjvGestureTexts(true);
+      final all = [
+        for (final m in [false, true])
+          for (final e in ko.items(m)) '${e.move} ${e.does}'
+      ].join('\n');
+      expect(all, isNot(contains('캔버스')));
+      expect(all, isNot(contains('찝어서')));
+      expect(
+          ko.items(false).map((e) => e.gesture),
+          containsAll([
+            HjvGesture.twoFingerTap,
+            HjvGesture.dragPointer,
+          ]));
+      expect(ko.items(true).map((e) => e.gesture),
+          isNot(contains(HjvGesture.twoFingerTap)));
+      expect(ko.gotIt, '알겠습니다');
+      expect(const HjvGestureTexts(false).gotIt, 'Got it');
+    });
+  });
+
+  group('the switch', () {
+    var clock = DateTime(2026, 10, 20, 9);
+    HjvSessionSwitch make() => HjvSessionSwitch(now: () => clock);
+
+    test('opens once, for the page that asked, within ten seconds', () {
+      clock = DateTime(2026, 10, 20, 9);
+      final s = make()
+        ..request(HjvSwitchTarget.files, '123456789', connToken: 'tok');
+      expect(s.pageClosed('987654321'), isNull);
+      clock = clock.add(const Duration(seconds: 3));
+      final p = s.pageClosed('123456789');
+      expect(p?.to, HjvSwitchTarget.files);
+      expect(p?.connToken, 'tok');
+      expect(s.pageClosed('123456789'), isNull);
+    });
+
+    test('a page that closes too late opens nothing', () {
+      clock = DateTime(2026, 10, 20, 9);
+      final s = make()..request(HjvSwitchTarget.remote, '1');
+      clock = clock.add(const Duration(seconds: 11));
+      expect(s.pageClosed('1'), isNull);
+      expect(s.pending, isFalse);
+
+      final t = make()..request(HjvSwitchTarget.remote, '1');
+      expect(t.expire(), isNull);
+      clock = clock.add(const Duration(seconds: 11));
+      expect(t.expire()?.id, '1');
+      expect(t.pending, isFalse);
+    });
+
+    test('a new request replaces the one before', () {
+      clock = DateTime(2026, 10, 20, 9);
+      final s = make()
+        ..request(HjvSwitchTarget.files, '1')
+        ..request(HjvSwitchTarget.remote, '2', forceRelay: true);
+      expect(s.pageClosed('1'), isNull);
+      final p = s.pageClosed('2');
+      expect(p?.to, HjvSwitchTarget.remote);
+      expect(p?.forceRelay, isTrue);
+    });
+
+    test('the token never shows in a print', () {
+      final p = HjvPendingSwitch(HjvSwitchTarget.files, '1',
+          connToken: 'secret-hash', at: DateTime(2026));
+      expect(p.toString(), isNot(contains('secret-hash')));
+    });
+  });
+
+  group("F1's lines", () {
+    const t = HjvSessionTexts(true);
+    test('an own PC adds nothing', () {
+      expect(
+          hjvSwitchExtraLines(t,
+              ownPc: true, guest: false, callOrRecording: false),
+          isEmpty);
+    });
+    test('another PC may ask again, a guest enters the access password again',
+        () {
+      expect(
+          hjvSwitchExtraLines(t,
+              ownPc: false, guest: false, callOrRecording: false),
+          [t.pcMayAsk]);
+      expect(
+          hjvSwitchExtraLines(t,
+              ownPc: false, guest: true, callOrRecording: false),
+          [t.pcMayAsk, t.guestAsks]);
+      expect(t.guestAsks, contains('이용 비밀번호'));
+    });
+    test('a voice call or recording ends', () {
+      expect(
+          hjvSwitchExtraLines(t,
+              ownPc: true, guest: false, callOrRecording: true),
+          [t.callEnds]);
+    });
+    test('both languages', () {
+      for (final k in [true, false]) {
+        final x = HjvSessionTexts(k);
+        for (final s in [
+          x.toFilesTitle,
+          x.toFilesText,
+          x.pcMayAsk,
+          x.guestAsks,
+          x.callEnds,
+          x.toRemoteLabel,
+          x.toRemoteTitle,
+          x.toRemoteText,
+          x.switchButton,
+          x.cancel,
+          x.filesFailed,
+          x.remoteFailed,
+        ]) {
+          expect(s, isNotEmpty);
+        }
+      }
+      expect(const HjvSessionTexts(false).switchButton, 'Switch');
+    });
+  });
+}
