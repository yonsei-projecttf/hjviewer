+IconData _hjvGestureIcon(HjvGesture g) {
+  switch (g) {
+    case HjvGesture.tap:
+      return GestureIcons.iconMobileTouch;
+    case HjvGesture.doubleTap:
+      return GestureIcons.iconGestureFdoubleTap;
+    case HjvGesture.twoFingerTap:
+      return GestureIcons.iconGestureFTap_;
+    case HjvGesture.longPress:
+      return GestureIcons.iconGesturePressHold;
+    case HjvGesture.dragPointer:
+    case HjvGesture.dragFinger:
+      return GestureIcons.iconGestureFSwipeRight;
+    case HjvGesture.doubleTapDrag:
+      return GestureIcons.iconGesturePress;
+    case HjvGesture.threeFingers:
+      return GestureIcons.iconGestureFThreeFingers;
+    case HjvGesture.twoFingerDrag:
+      return GestureIcons.iconGestureFDrag;
+    case HjvGesture.pinch:
+      return GestureIcons.iconGesturePinch;
+  }
