+  /// Why a transfer was refused (1.9.3: a download's file names, folders, links and overwrite
+  /// are checked on this device), in a few words beside '오류'; '' for any other error, which
+  /// stays the bare word. `err` is the job's error as the core or file_model.dart worded it.
+  String refused(String err) {
+    final e = err.toLowerCase();
+    // the messages that end in a name from the other side come first, by their start
+    if (e.startsWith('invalid file name') ||
+        e.startsWith('invalid download file name') ||
+        e.startsWith('invalid windows download file name')) {
+      return _t('저장할 수 없는 파일 이름', 'File name cannot be saved here');
+    }
+    if (e.startsWith('download directory contains a link')) {
+      return _t('받는 폴더에 링크가 있음', 'Destination holds a link');
+    }
+    if (e.startsWith('invalid download directory') ||
+        e.startsWith('failed to validate path component')) {
+      return _t('폴더 경로가 올바르지 않음', 'Folder path is not valid');
+    }
+    if (e == 'download overwrite requires confirmation') {
+      return _t('같은 이름의 파일이 이미 있음', 'A file of this name exists');
+    }
+    if (e == 'symlink path component is not allowed' ||
+        e == 'hard-linked download resume staging file is not allowed') {
+      return _t('받는 폴더에 링크가 있음', 'Destination holds a link');
+    }
+    if (e.startsWith('download resume')) {
+      return _t('이어받을 파일이 맞지 않음', 'Resume file does not match');
+    }
+    if (e == 'cannot replace an accepted download file list') {
+      return _t('원격에서 파일 목록을 바꿈', 'The remote changed the file list');
+    }
+    if (e == 'file name contains null bytes' ||
+        e == 'path traversal detected in file name' ||
+        e == 'absolute path detected in file name' ||
+        e == 'empty file name in multi-file transfer' ||
+        e == 'invalid file name component') {
+      return _t('저장할 수 없는 파일 이름', 'File name cannot be saved here');
+    }
+    if (e == 'download destination has no parent' ||
+        e == 'invalid download destination' ||
+        e == 'download file has no parent') {
+      return _t('폴더 경로가 올바르지 않음', 'Folder path is not valid');
+    }
+    return '';
+  }
   // the overwrite question and its action
   String get overwriteAsk =>
       _t('이 파일이 이미 있습니다. 덮어쓸까요?', 'This file already exists. Overwrite it?');
