diff --git a/flutter/lib/common/hjviewer_video_refresh.dart b/flutter/lib/common/hjviewer_video_refresh.dart
new file mode 100644
index 0000000..80ccada
--- /dev/null
+++ b/flutter/lib/common/hjviewer_video_refresh.dart
@@ -0,0 +1,58 @@
+// The phone and tablet session's one automatic video refresh (1.9.4): a few seconds after a
+// connection's first picture the app asks the PC for a new one, as the menu's 새로 고침 does, so a
+// first picture taken before the session's quality settled (blurry, "low resolution") does not
+// stay on a still screen. Plain Dart without the bridge, so that ci.sh tests it with the web
+// stand-in; the mobile remote page wires it.
+
+import 'dart:async';
+
+/// How long after a connection's first picture the refresh is asked for. The PC's video QoS
+/// (src/server/video_qos.rs) starts each viewer at INIT_FPS for a second, doubles the fps after
+/// every two clean delay replies (one a second), steps the bitrate ratio every 3 s and confirms
+/// congestion only after three bad replies; 6 s after the first picture has passed two ratio
+/// steps, the fps start-up and a start-up congestion episode on a good link.
+const kHjvAutoRefreshDelay = Duration(seconds: 6);
+
+typedef HjvStartTimer = Timer Function(
+    Duration delay, void Function() callback);
+
+/// One page's automatic refresh: armed by the first picture of each connection (a reconnect
+/// brings a new first picture and re-arms it), at most one timer pending, the refresh asked for
+/// at most once per connection, and not at all when, at its time, [ready] is false (page gone,
+/// session closed, a reconnect still waiting for its picture) or [videoRequests] moved since the
+/// first picture (the user switched display or used 새로 고침: the picture is already new).
+class HjvAutoRefresh {
+  HjvAutoRefresh(
+      {required this.ready,
+      required this.videoRequests,
+      required this.refresh,
+      this.delay = kHjvAutoRefreshDelay,
+      HjvStartTimer? startTimer})
+      : _startTimer = startTimer ?? Timer.new;
+
+  final bool Function() ready;
+  final int Function() videoRequests;
+  final void Function() refresh;
+  final Duration delay;
+  final HjvStartTimer _startTimer;
+  Timer? _timer;
+
+  /// A refresh is waiting for its time.
+  bool get pending => _timer != null;
+
+  /// The connection showed its first picture.
+  void onFirstImage() {
+    _timer?.cancel();
+    final armedAt = videoRequests();
+    _timer = _startTimer(delay, () {
+      _timer = null;
+      if (ready() && videoRequests() == armedAt) refresh();
+    });
+  }
+
+  /// The page goes away.
+  void cancel() {
+    _timer?.cancel();
+    _timer = null;
+  }
+}
