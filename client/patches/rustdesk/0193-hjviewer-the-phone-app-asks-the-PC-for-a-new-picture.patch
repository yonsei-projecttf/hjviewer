diff --git a/flutter/test/hjviewer_video_refresh_test.dart b/flutter/test/hjviewer_video_refresh_test.dart
new file mode 100644
index 0000000..79e5db7
--- /dev/null
+++ b/flutter/test/hjviewer_video_refresh_test.dart
@@ -0,0 +1,115 @@
+import 'dart:async';
+
+import 'package:flutter_hbb/common/hjviewer_video_refresh.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The phone session's one automatic video refresh after a connection's first picture (1.9.4),
+// without the bridge: the timers are recorded and fired by hand.
+
+class _FakeTimer implements Timer {
+  _FakeTimer(this.delay, this.callback);
+  final Duration delay;
+  final void Function() callback;
+  bool active = true;
+
+  void fire() {
+    if (!active) return;
+    active = false;
+    callback();
+  }
+
+  @override
+  void cancel() => active = false;
+  @override
+  bool get isActive => active;
+  @override
+  int get tick => 0;
+}
+
+class _Session {
+  bool ready = true;
+  int videoRequests = 0;
+  int refreshes = 0;
+  final timers = <_FakeTimer>[];
+
+  late final auto = HjvAutoRefresh(
+      ready: () => ready,
+      videoRequests: () => videoRequests,
+      refresh: () {
+        refreshes++;
+        videoRequests++; // as sessionRefreshVideo counts its own request
+      },
+      startTimer: (delay, callback) {
+        final t = _FakeTimer(delay, callback);
+        timers.add(t);
+        return t;
+      });
+
+  int get activeTimers => timers.where((t) => t.active).length;
+}
+
+void main() {
+  test('the delay lets the quality settle and stays within 3 to 10 seconds',
+      () {
+    expect(
+        kHjvAutoRefreshDelay, greaterThanOrEqualTo(const Duration(seconds: 3)));
+    expect(
+        kHjvAutoRefreshDelay, lessThanOrEqualTo(const Duration(seconds: 10)));
+    final s = _Session();
+    s.auto.onFirstImage();
+    expect(s.timers.single.delay, kHjvAutoRefreshDelay);
+  });
+
+  test('asks for one refresh after the first picture', () {
+    final s = _Session();
+    s.auto.onFirstImage();
+    expect(s.refreshes, 0);
+    expect(s.auto.pending, isTrue);
+    s.timers.single.fire();
+    expect(s.refreshes, 1);
+    expect(s.auto.pending, isFalse);
+  });
+
+  test('not after a display switch or 새로 고침 since the first picture', () {
+    final s = _Session();
+    s.auto.onFirstImage();
+    s.videoRequests++;
+    s.timers.single.fire();
+    expect(s.refreshes, 0);
+  });
+
+  test('not when the page, the session or the connection is not ready', () {
+    final s = _Session();
+    s.auto.onFirstImage();
+    s.ready = false;
+    s.timers.single.fire();
+    expect(s.refreshes, 0);
+  });
+
+  test(
+      'a reconnect re-arms with one timer, and its connection gets its own refresh',
+      () {
+    final s = _Session();
+    s.auto.onFirstImage();
+    // the reconnect's first picture before the first timer's time
+    s.auto.onFirstImage();
+    expect(s.activeTimers, 1);
+    for (final t in List.of(s.timers)) {
+      t.fire();
+    }
+    expect(s.refreshes, 1);
+    s.auto.onFirstImage(); // a later reconnect
+    s.timers.last.fire();
+    expect(s.refreshes, 2);
+  });
+
+  test('cancel leaves no timer', () {
+    final s = _Session();
+    s.auto.onFirstImage();
+    s.auto.cancel();
+    expect(s.activeTimers, 0);
+    expect(s.auto.pending, isFalse);
+    s.timers.single.fire();
+    expect(s.refreshes, 0);
+  });
+}
