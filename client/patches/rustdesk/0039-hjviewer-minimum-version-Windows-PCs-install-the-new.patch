+/// The security of the service's download folders, set when they are made: owned by SYSTEM,
+/// everything for SYSTEM and the administrators and for what is made inside, nothing for anyone
+/// else, and nothing inherited from the folder above.
+const PROTECTED: &str = "O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)";
+/// How long the started installer is watched for an early end.
+const LAUNCH_WAIT_MS: u32 = 120_000;
+/// The service looks at the policy by itself only after the process's first check of it, which
+/// comes half a minute after its start.
+const FIRST_LOOK: u64 = 45;
+/// For a whole package, on a slow line too.
+const DOWNLOAD_TIMEOUT: Duration = Duration::from_secs(30 * 60);
+
+#[link(name = "wtsapi32")]
+extern "system" {
+    /// wtsapi32.h. The lengths are in bytes, the timeout in seconds; with `wait` 0 the call
+    /// returns at once and the box stays up until it is answered or the time is over.
+    fn WTSSendMessageW(
+        server: *mut std::ffi::c_void,
+        session: u32,
+        title: *const u16,
+        title_bytes: u32,
+        message: *const u16,
+        message_bytes: u32,
+        style: u32,
+        timeout: u32,
+        response: *mut u32,
+        wait: i32,
+    ) -> i32;
+}
+
+fn wide(text: &OsStr) -> Vec<u16> {
+    text.encode_wide().chain(Some(0)).collect()
+}
+
+fn refused(why: &'static str) -> std::io::Error {
+    std::io::Error::other(why)
+}
+
+/// A folder Windows knows by an ID, for the user this process runs as. No environment variable
+/// is read: the service's SYSTEM gets the folder of the system profile.
+fn known_folder(id: &GUID) -> std::io::Result<PathBuf> {
+    let path = unsafe { SHGetKnownFolderPath(id, KF_FLAG_DEFAULT, None) }?;
+    let folder = OsString::from_wide(unsafe { path.as_wide() });
+    unsafe { CoTaskMemFree(Some(path.0 as *const _)) };
+    Ok(PathBuf::from(folder))
+}
+
+/// Whether SYSTEM or the administrators own what the handle is open on.
+fn owned_by_the_system(folder: &File) -> std::io::Result<bool> {
+    let (mut owner, mut descriptor) = (PSID::default(), PSECURITY_DESCRIPTOR::default());
+    let error = unsafe {
+        GetSecurityInfo(
+            HANDLE(folder.as_raw_handle() as _),
+            SE_FILE_OBJECT,
+            OWNER_SECURITY_INFORMATION,
+            Some(&mut owner),
+            None,
+            None,
+            None,
+            Some(&mut descriptor),
+        )
+    };
+    if error.0 != 0 {
+        return Err(std::io::Error::from_raw_os_error(error.0 as i32));
+    }
+    // the owner points into the descriptor, which is freed after the look at it
+    let ours = !owner.is_invalid()
+        && unsafe {
+            IsWellKnownSid(owner, WinLocalSystemSid).as_bool()
+                || IsWellKnownSid(owner, WinBuiltinAdministratorsSid).as_bool()
+        };
+    unsafe { LocalFree(Some(HLOCAL(descriptor.0))) };
+    Ok(ours)
+}
+
+/// A folder on the way to the download must be a folder itself, no link or junction to another
+/// place, and one this code makes (`ours`) must belong to SYSTEM or the administrators. The
+/// folder is looked at through a handle on itself, never through a link.
+fn check_folder(path: &Path, ours: bool) -> std::io::Result<()> {
+    let folder = OpenOptions::new()
+        .access_mode(READ_CONTROL.0 | FILE_READ_ATTRIBUTES.0)
+        .share_mode(FILE_SHARE_READ.0 | FILE_SHARE_WRITE.0 | FILE_SHARE_DELETE.0)
+        .custom_flags(FILE_FLAG_BACKUP_SEMANTICS.0 | FILE_FLAG_OPEN_REPARSE_POINT.0)
+        .open(path)?;
+    let attributes = folder.metadata()?.file_attributes();
+    if attributes & FILE_ATTRIBUTE_REPARSE_POINT.0 != 0 {
+        return Err(refused("a link is on the way to the download"));
+    }
+    if attributes & FILE_ATTRIBUTE_DIRECTORY.0 == 0 {
+        return Err(refused("no folder"));
+    }
+    if ours && !owned_by_the_system(&folder)? {
+        return Err(refused("the folder is someone else's"));
+    }
+    Ok(())
+}
+
+/// Makes a folder with the PROTECTED security from the start; false when the name was taken.
+fn make_protected(path: &Path) -> std::io::Result<bool> {
+    let mut descriptor = PSECURITY_DESCRIPTOR::default();
+    let text = wide(OsStr::new(PROTECTED));
+    unsafe {
+        ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            PCWSTR(text.as_ptr()),
+            SDDL_REVISION_1,
+            &mut descriptor,
+            None,
+        )
+    }?;
+    let security = SECURITY_ATTRIBUTES {
+        nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+        lpSecurityDescriptor: descriptor.0,
+        bInheritHandle: false.into(),
+    };
+    let name = wide(path.as_os_str());
+    let made = unsafe { CreateDirectoryW(PCWSTR(name.as_ptr()), Some(&security)) };
+    unsafe { LocalFree(Some(HLOCAL(descriptor.0))) };
+    match made {
+        Ok(()) => Ok(true),
+        Err(error) if error.code() == ERROR_ALREADY_EXISTS.to_hresult() => Ok(false),
+        Err(error) => Err(error.into()),
+    }
+}
+
+/// The folder all the service's downloads are under, checked on the way; `make` it if it is
+/// not there.
+fn download_root(make: bool) -> std::io::Result<PathBuf> {
+    let local = known_folder(&FOLDERID_LocalAppData)?;
+    // from the drive down to the known folder itself
+    for above in local.ancestors() {
+        check_folder(above, false)?;
+    }
+    let root = local.join(plan::FOLDER);
+    if make {
+        make_protected(&root)?;
+    }
+    check_folder(&root, true)?;
+    Ok(root)
+}
+
+/// Opens a file for reading so that, while the handle is held, others can read and run it but
+/// nobody can write, rename or delete it. A link in the file's place is refused.
+fn open_sealed(path: &Path) -> std::io::Result<File> {
+    let file = OpenOptions::new()
+        .read(true)
+        .share_mode(FILE_SHARE_READ.0)
+        .custom_flags(FILE_FLAG_OPEN_REPARSE_POINT.0)
+        .open(path)?;
+    let attributes = file.metadata()?.file_attributes();
+    if attributes & (FILE_ATTRIBUTE_REPARSE_POINT.0 | FILE_ATTRIBUTE_DIRECTORY.0) != 0 {
+        return Err(refused("no plain file"));
+    }
+    Ok(file)
+}
+
+/// The four numbers of the fixed part of a file's version resource (VS_FIXEDFILEINFO's file
+/// version, what Windows shows as "File version"); None for a file without one.
+fn file_version(path: &Path) -> Option<[u16; 4]> {
+    let name = wide(path.as_os_str());
+    let size = unsafe { GetFileVersionInfoSizeW(PCWSTR(name.as_ptr()), None) };
+    if size == 0 {
+        return None;
+    }
+    let mut data = vec![0u8; usize::try_from(size).ok()?];
+    unsafe { GetFileVersionInfoW(PCWSTR(name.as_ptr()), None, size, data.as_mut_ptr().cast()) }
+        .ok()?;
+    let root = wide(OsStr::new("\\"));
+    let (mut fixed, mut length) = (std::ptr::null_mut(), 0u32);
+    let found = unsafe {
+        VerQueryValueW(
+            data.as_ptr().cast(),
+            PCWSTR(root.as_ptr()),
+            &mut fixed,
+            &mut length,
+        )
+    };
+    let whole = usize::try_from(length).is_ok_and(|n| n >= std::mem::size_of::<VS_FIXEDFILEINFO>());
+    if !found.as_bool() || fixed.is_null() || !whole {
+        return None;
+    }
+    // a pointer into `data`, which lives until the end of this function
+    let fixed = unsafe { std::ptr::read_unaligned(fixed as *const VS_FIXEDFILEINFO) };
+    if fixed.dwSignature != 0xFEEF_04BD {
+        return None;
+    }
+    let (high, low) = (fixed.dwFileVersionMS, fixed.dwFileVersionLS);
+    Some([
+        (high >> 16) as u16,
+        high as u16,
+        (low >> 16) as u16,
+        low as u16,
+    ])
+}
