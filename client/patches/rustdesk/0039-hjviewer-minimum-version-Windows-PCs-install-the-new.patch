+    #[test]
+    fn the_file_an_app_runs_is_the_signed_package_under_the_apps_name() {
+        let temp = TempFile::new("run", "HJViewer-1.6.1.exe");
+        std::fs::create_dir_all(temp.dir()).unwrap();
+        let data = package_bytes();
+        let wanted = door::Plan {
+            platform: PackagePlatform::Windows,
+            version: Version::parse("1.6.1").unwrap(),
+            package: target(&data).package,
+        };
+        let open = |path: &Path| File::open(path);
+        let checked = |path: &Path, wanted: &door::Plan| open_checked(path, wanted, &open).err();
+        std::fs::write(&temp.0, &data).unwrap();
+        assert_eq!(checked(&temp.0, &wanted), None);
+        // changed since the download, by one byte or to another length
+        let mut changed = data.clone();
+        changed[9] ^= 1;
+        let others = [
+            changed,
+            data[1..].to_vec(),
+            [&data[..], b"x"].concat(),
+            Vec::new(),
+        ];
+        for other in others {
+            std::fs::write(&temp.0, &other).unwrap();
+            assert_eq!(checked(&temp.0, &wanted), Some(Failure::Verify));
+        }
+        // the right bytes under another name: not the file the download left
+        let other = temp.dir().join("HJViewer-1.6.1 (1).exe");
+        std::fs::write(&other, &data).unwrap();
+        assert_eq!(checked(&other, &wanted), Some(Failure::Verify));
+        // the policy names a later version by now: the file is of the old one
+        std::fs::write(&temp.0, &data).unwrap();
+        let later = door::Plan {
+            version: Version::parse("1.6.2").unwrap(),
+            ..wanted.clone()
+        };
+        assert_eq!(checked(&temp.0, &later), Some(Failure::Verify));
+        // an APK is nothing to run
+        let apk = door::Plan {
+            platform: PackagePlatform::Android,
+            ..wanted.clone()
+        };
+        assert_eq!(checked(&temp.0, &apk), Some(Failure::Verify));
+        // gone, or not to be opened
+        std::fs::remove_file(&temp.0).unwrap();
+        assert_eq!(checked(&temp.0, &wanted), Some(Failure::File));
+    }
