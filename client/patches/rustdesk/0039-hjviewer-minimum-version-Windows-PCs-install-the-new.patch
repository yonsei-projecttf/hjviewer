+/// The state as the screens get it. In the main window of an installed Windows PC the update
+/// is the service's, and the state says so (`install::overlay`):
+/// - `credential`: device, or unbound when hjv-api hands this PC nothing (it is on no account);
+/// - `job.phase`: idle, waiting (the service has not taken this window's `hjv-update-now` yet,
+///   or checks the policy first), downloading, verifying, notice (an install with sessions open
+///   starts at `job.until`), installing, or error;
+/// - `job.error`: a download's code, install (the installer did not start or did not finish),
+///   attempts (three installs did not take) or service (the service does not answer).
+fn shown(mut state: Value) -> Value {
