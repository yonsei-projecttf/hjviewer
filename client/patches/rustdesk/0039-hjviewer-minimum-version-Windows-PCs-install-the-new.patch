+    /// By itself the service installs only by a policy the server confirmed in the last half
+    /// hour: a policy that takes the rollout back stops every PC that still reaches the server.
+    #[test]
+    fn nothing_is_installed_by_a_policy_the_server_did_not_just_confirm() {
+        let data = package_bytes();
+        let pc = Fake::new("fresh", Some(entry(&data, |_| {})), due() + 1, &data);
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(1801);
+        pc.check.set(|facts| facts.checking = true);
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        // the PC could install now: the service asks, and waits for the answer
+        service.tick();
+        assert_eq!(pc.take(), ["idle", "check regular"]);
+        pc.pass(&mut service, 10);
+        assert_eq!(pc.take(), NOTHING);
+        // no answer (the check was held back, or failed): nothing is fetched. The checking
+        // thread tries again by its own rules; the service asks again six hours later
+        pc.facts.borrow_mut().as_mut().unwrap().checking = false;
+        pc.pass(&mut service, 21_600);
+        let did = pc.take();
+        assert!(did.len() > 1000 && did.iter().all(|did| did == "idle"));
+        pc.pass(&mut service, 1);
+        assert_eq!(pc.take(), ["idle", "check regular"]);
+        // the answer takes the rollout back: nothing is installed
+        let stopped = entry(&data, without_rollout);
+        *pc.facts.borrow_mut() = Some(facts(stopped, pc.wall.get() as i64));
+        pc.pass(&mut service, 3600);
+        assert_eq!(pc.take(), NOTHING);
+        assert_eq!(pc.folders.get(), 0);
+        // when a try of the checking thread confirms the policy, the service goes ahead by
+        // itself, without asking
+        let pc = Fake::new("fresh-a", Some(entry(&data, |_| {})), due() + 1, &data);
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(40_000);
+        pc.check.set(|_| {});
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        pc.pass(&mut service, 1800);
+        let did = pc.take();
+        assert_eq!(did[..2], ["idle", "check regular"]);
+        assert!(did[2..].iter().all(|did| did == "idle"));
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(3);
+        let (seconds, did) = pc.until_done(&mut service, 100);
+        assert!(seconds <= 20, "{seconds}");
+        assert_eq!(did[0], "idle");
+        assert_eq!(did.last(), Some(&launch_of(1, 1, &data)));
+        // a policy this process never had confirmed counts as old; one just confirmed installs
+        let pc = Fake::new("fresh-b", Some(entry(&data, |_| {})), due() + 1, &data);
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = None;
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        pc.pass(&mut service, 2);
+        let did = pc.take();
+        assert_eq!(did[..3], ["idle", "check regular", "idle"]);
+        assert_eq!(did.last(), Some(&launch_of(1, 1, &data)));
+        // exactly half an hour is new enough
+        let pc = Fake::new("fresh-c", Some(entry(&data, |_| {})), due() + 1, &data);
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(1800);
+        let mut service = Service::new(&pc, V160, 0);
