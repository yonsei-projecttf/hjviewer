+    /// Below the minimum, a day past its time: sessions hold the install up only until the
+    /// quiet hours, and then whoever is there is warned ten minutes ahead.
+    #[test]
+    fn an_overdue_install_does_not_wait_for_sessions_for_good() {
+        let data = package_bytes();
+        let below = entry(&data, without_rollout);
+        let pc = Fake::new("overdue", Some(below), forced() - 10, &data);
+        *pc.idle.borrow_mut() = vec![false];
+        pc.hour.set(3);
+        let mut service = Service::new(&pc, V151, 0);
+        pc.take();
+        // before its time nothing; for a day after it sessions are waited for, at night too
+        pc.pass(&mut service, 5);
+        assert_eq!(pc.take(), NOTHING);
+        pc.pass(&mut service, 86_400 - 60);
+        let did = pc.take();
+        assert!(did.len() > 1400 && did.iter().all(|did| did == "sessions"));
+        // a day gone: by day still waiting
+        pc.hour.set(14);
+        pc.pass(&mut service, 3600);
+        let did = pc.take();
+        assert!(did.len() > 50 && did.iter().all(|did| did == "sessions"));
+        assert_eq!(pc.phases(), ["idle"]);
+        // in the quiet hours: the server is asked (its last answer is old by now), then the
+        // download, the warning, ten minutes, the server asked again, the install
+        pc.hour.set(2);
+        let before = pc.wall.get();
+        let (_, did) = pc.until_tried(&mut service, 100);
+        assert_eq!(
+            did,
+            [
+                "sessions".to_owned(),
+                "check regular".to_owned(),
+                "sessions".to_owned(),
+                "stage 00000001".to_owned(),
+                "fetch".to_owned(),
+                "seal".to_owned(),
+                "sessions".to_owned(),
+                "notice 600".to_owned(),
+                "check now".to_owned(),
+                "save 1 installs".to_owned(),
+                launch_of(1, 1, &data),
+            ]
+        );
+        // the window was told when, and the installer started then and not before
+        let jobs = pc.jobs.borrow().clone();
+        let notice = jobs.iter().find(|job| job.phase == "notice").unwrap();
+        let started = pc.record().unwrap().installed_at;
+        assert_eq!(notice.until, started);
+        assert!(started >= before + 600 && pc.wall.get() == started);
+        assert_eq!(
+            pc.phases(),
+            ["downloading", "verifying", "notice", "installing"]
+        );
+    }
