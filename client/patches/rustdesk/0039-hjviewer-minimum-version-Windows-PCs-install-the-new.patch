+/// Has the service make the update now: a new value in its option NOW. The options are read
+/// from the service and sent back as a whole; the IPC calls start a runtime of their own, so
+/// they run on a thread of their own.
+fn ask_service() {
+    let signal = plan::signal(hbb_common::rand::random());
+    ASKED
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .sent(&signal, fetch::mono());
+    let sent = std::thread::Builder::new()
+        .name("hjv-update-now".to_owned())
+        .spawn(move || {
+            let mut options = crate::ipc::get_options();
+            options.insert(plan::NOW.to_owned(), signal);
+            crate::ui_interface::set_options(options);
+        });
+    if let Err(e) = sent {
+        log::error!("update: the service was not asked: {e}");
+    }
+    watch();
+    super::notify(None);
+}
+
+fn replace(from: &Path, to: &Path) -> std::io::Result<()> {
+    let (from, to) = (wide(from.as_os_str()), wide(to.as_os_str()));
+    // the Downloads folder may be on another drive than the temporary files
+    let flags = MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED | MOVEFILE_WRITE_THROUGH;
+    unsafe { MoveFileExW(PCWSTR(from.as_ptr()), PCWSTR(to.as_ptr()), flags) }?;
+    Ok(())
+}
+
+/// A checked download goes into the user's Downloads, in place of whatever has its name there.
+fn into_downloads(checked: PathBuf) -> Result<PathBuf, Failure> {
+    let placed = known_folder(&FOLDERID_Downloads)
+        .map_err(|_| Failure::File)
+        .and_then(|downloads| install::publish(&checked, &downloads, &replace));
+    if placed.is_err() {
+        install::discard(&checked);
+    }
+    placed
+}
+
+/// `hjv-update-download` in an app that is not installed: the package comes by the login into
+/// a new folder of the user's temporary files, is checked there, and is then put into the
+/// user's Downloads as `HJViewer-<version>.exe`, a file the user starts again later.
+fn download() {
+    let under_way = |core: &mut super::Core| core.job.phase == door::Phase::Downloading;
+    if super::with_core(under_way) != Some(false) {
+        return;
+    }
+    let temp = std::env::temp_dir().join(plan::FOLDER);
+    // what downloads that failed left
+    install::sweep(&temp);
+    let folder = temp.join(plan::folder_name(hbb_common::rand::random()));
+    match folder.to_str() {
+        Some(folder) => door::start_download(folder, into_downloads),
+        None => {
+            super::with_core(|core| core.job = failed(Failure::File));
+            super::notify(None);
+        }
+    }
+}
+
+fn failed(failure: Failure) -> door::Job {
+    door::Job {
+        phase: door::Phase::Error,
+        error: failure.code(),
+        ..Default::default()
+    }
+}
+
+/// Starts the checked file in place of this process, which ends. The new version's packer
+/// waits for this process to be gone before it unpacks (WAIT_PID), and the handle that the file
+/// was checked through is held until the new process exists.
+fn hand_over(file: &Path, sealed: File) -> Result<(), Failure> {
+    let mut command = std::process::Command::new(file);
+    // a path the packer would read as "install" or "quick support" gets an argument, which
+    // makes the packer pass it on and the app start as it does without one
+    if file.to_str().map_or(true, plan::packer_reads) {
+        command.arg("--noinstall");
+    }
+    command.env(plan::WAIT_PID, std::process::id().to_string());
+    let child = command.spawn().map_err(|e| {
+        log::error!("update: {} did not start: {e}", file.display());
+        Failure::File
+    })?;
+    unsafe { AllowSetForegroundWindow(child.id()) }.ok();
+    drop(sealed);
+    log::info!("update: {} takes over", file.display());
+    std::process::exit(0)
+}
+
+/// `hjv-update-run` in an app that is not installed: the downloaded file is read again, through
+/// a handle nobody can write past, and started only if it is still the signed package.
+fn run() {
+    let current = super::current();
+    let job = super::with_core(|core| {
+        let file = PathBuf::from(&core.job.file);
+        (core.job.phase, file, core.download_plan(current))
+    });
+    let started = match job {
+        // a download is still coming: its end says what there is to run
+        None | Some((door::Phase::Downloading, ..)) => return,
+        Some((door::Phase::Ready, file, Ok(wanted))) => {
+            install::open_checked(&file, &wanted, &open_sealed)
+                .and_then(|sealed| {
+                    let named = plan::file_version_holds(file_version(&file), &wanted.version);
+                    named.then_some(sealed).ok_or(Failure::Version)
+                })
+                .and_then(|sealed| hand_over(&file, sealed))
+        }
+        Some((door::Phase::Ready, _, Err(failure))) => Err(failure),
+        Some(_) => Err(Failure::Missing),
+    };
+    // a start that worked ended this process
+    if let Err(failure) = started {
+        log::warn!(
+            "update: the new version was not started ({})",
+            failure.code()
+        );
+        super::with_core(|core| core.job = failed(failure));
+        super::notify(None);
+    }
+}
+
+/// The main window's keys `hjv-update-now`, `hjv-update-download` and `hjv-update-run`.
+pub(super) fn command(key: &str) {
+    match plan::act(key, installed_here()) {
+        Act::AskService => ask_service(),
+        Act::Download => download(),
+        Act::Run => run(),
+        Act::Nothing => {}
+    }
+}
