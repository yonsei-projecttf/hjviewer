+            pc.phases(),
+            ["idle", "waiting", "downloading", "verifying", "installing"]
+        );
+        let started = pc.record().unwrap().installed_at;
+        assert_eq!(started, before + 1 + CHECK_WAIT);
+        // an answer that does not come is waited for forty seconds, and pressing again
+        // meanwhile neither starts a second update nor stops the first
+        let pc = Fake::new("now-b", Some(entry(&data, |_| {})), due() - 3 * DAY, &data);
