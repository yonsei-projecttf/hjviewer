+    #[test]
+    fn sessions_hold_an_install_up() {
+        for hour in 0..24 {
+            let quiet = (2..5).contains(&hour);
+            // no session: every install goes
+            for mode in [Mode::Idle, Mode::Overdue, Mode::Now] {
+                assert_eq!(sessions(mode, true, hour), Sessions::Go);
+            }
+            // a session: the rollout waits, at any hour
+            assert_eq!(sessions(Mode::Idle, false, hour), Sessions::Wait);
+            // an overdue install waits for the quiet hours and is announced then
+            let overdue = if quiet {
+                Sessions::Announce
+            } else {
+                Sessions::Wait
+            };
+            assert_eq!(sessions(Mode::Overdue, false, hour), overdue, "{hour}");
+            assert_eq!(sessions(Mode::Now, false, hour), Sessions::Go);
+        }
+        assert_eq!(sessions(Mode::Overdue, false, 24), Sessions::Wait);
+    }
