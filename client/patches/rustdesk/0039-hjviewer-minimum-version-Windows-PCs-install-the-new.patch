+    impl Machine for &Fake {
+        fn wall(&self) -> u64 {
+            self.wall.get()
+        }
+
+        fn mono(&self) -> u64 {
+            self.mono.get()
+        }
+
+        fn pause(&self, seconds: u64) {
+            self.wall.set(self.wall.get() + seconds);
+            self.mono.set(self.mono.get() + seconds);
+            if let Some(facts) = self.facts.borrow_mut().as_mut() {
+                facts.now += seconds as i64;
+                if let Some(age) = facts.confirmed.as_mut() {
+                    *age += seconds;
+                }
+            }
+        }
+
+        fn option(&self, name: &str) -> String {
+            self.options.borrow().get(name).cloned().unwrap_or_default()
+        }
+
+        fn set_option(&self, name: &str, value: &str) {
+            if name == JOB {
+                self.jobs
+                    .borrow_mut()
+                    .push(serde_json::from_str(value).unwrap());
+            }
+            self.options
+                .borrow_mut()
+                .insert(name.to_owned(), value.to_owned());
+        }
+
+        fn facts(&self) -> Option<Facts> {
+            self.facts.borrow().clone()
+        }
+
+        fn check(&self, now: bool) {
+            self.did(format!("check {}", if now { "now" } else { "regular" }));
+            if let Some(facts) = self.facts.borrow_mut().as_mut() {
+                self.check.get()(facts);
+            }
+        }
+
+        fn idle(&self) -> bool {
+            let mut idle = self.idle.borrow_mut();
+            let now = idle[0];
+            if idle.len() > 1 {
+                idle.remove(0);
+            }
+            self.did(if now { "idle" } else { "sessions" });
+            now
+        }
+
+        fn hour(&self) -> u32 {
+            self.hour.get()
+        }
+
+        fn device(&self) -> Option<(String, sign::SecretKey)> {
+            self.device
+                .get()
+                .then(|| (DEVICE_ID.to_owned(), secret_key(DEVICE_SEED)))
+        }
+
+        fn bound(&self) -> bool {
+            self.bound.get()
+        }
+
+        fn load(&self) -> Option<Record> {
+            self.record()
+        }
+
+        fn save(&self, record: Option<&Record>) -> bool {
+            let saved = self.saves.get() && write_record(&self.temp.0, record);
+            let what = match record {
+                Some(record) => format!("{} installs", record.installs),
+                None => "no record".to_owned(),
+            };
+            self.did(format!("save {what}{}", if saved { "" } else { " failed" }));
+            saved
+        }
+
+        fn sweep(&self) {
+            self.did("sweep");
+            sweep(&self.temp.dir().join(FOLDER));
+        }
+
+        fn stage(&self, name: &str) -> std::io::Result<(PathBuf, File)> {
+            if !self.stages.get() {
+                return Err(std::io::Error::other("a junction on the way"));
+            }
+            self.folders.set(self.folders.get() + 1);
+            let folder = plan::folder_name(self.folders.get().to_be_bytes());
+            let real = self.temp.dir().join(FOLDER).join(&folder);
+            std::fs::create_dir_all(self.temp.dir().join(FOLDER))?;
+            std::fs::create_dir(&real)?;
+            let real = real.join(name);
+            let file = std::fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&real)?;
+            let path = PathBuf::from(format!("{SYSTEM_FOLDER}\\{FOLDER}\\{folder}\\{name}"));
+            self.staged.borrow_mut().insert(path.clone(), real);
+            self.did(format!("stage {folder}"));
+            Ok((path, file))
+        }
+
+        fn fetch(&self, request: &DoorRequest) -> Result<(Option<u64>, Box<dyn Read>), Failure> {
+            self.did("fetch");
+            self.requests.borrow_mut().push(request.clone());
+            if let Some(hour) = self.hour_after_fetch.get() {
+                self.hour.set(hour);
+            }
+            let body = self.answer.borrow().clone()?;
+            Ok((self.length.get(), Box::new(std::io::Cursor::new(body))))
+        }
+
+        fn seal(&self, path: &Path, file: File) -> std::io::Result<File> {
+            drop(file);
+            self.did("seal");
+            let real = self.staged.borrow()[path].clone();
+            if self.swapped.get() {
+                let mut other = std::fs::read(&real)?;
+                other[0] ^= 0xff;
+                std::fs::write(&real, other)?;
+            }
+            File::open(real)
+        }
+
+        fn discard(&self, path: &Path) {
+            self.did("discard");
+            discard(&self.staged.borrow()[path]);
+        }
+
+        fn notice(&self, seconds: u64) {
+            self.did(format!("notice {seconds}"));
+            if let Some(change) = self.policy_at_notice.get() {
+                self.check.set(change);
+            }
+            if self.swapped_at_notice.get() {
+                for real in self.staged.borrow().values() {
+                    let mut other = std::fs::read(real).unwrap();
+                    other[0] ^= 0xff;
+                    std::fs::write(real, other).unwrap();
+                }
+            }
+        }
+
+        fn launch(&self, command: &str) -> std::io::Result<Started> {
+            // what would run: the bytes behind the path at this moment, and what the record
+            // on the disk says by now
+            let path = command.split('"').nth(1).unwrap();
+            let bytes = std::fs::read(&self.staged.borrow()[Path::new(path)]).unwrap();
+            let installs = self.record().map_or(0, |record| record.installs);
+            self.did(format!(
+                "launch {command} [{installs} written down, {}]",
+                sha(&bytes)
+            ));
+            match self.exit.get() {
+                Ok(code) => Ok(Box::new(move || code)),
+                Err(()) => Err(std::io::Error::other("no token")),
+            }
+        }
+
+        fn file_version(&self, _: &Path) -> Option<[u16; 4]> {
+            self.version.get()
+        }
+    }
+
+    /// The start of the installer from folder number `folder`, with `tries` on the record.
+    fn launch_of(folder: u32, tries: u32, data: &[u8]) -> String {
+        format!(
+            "launch \"{SYSTEM_FOLDER}\\{FOLDER}\\{}\\HJViewer-1.6.1.exe\" --update [{tries} written down, {}]",
+            plan::folder_name(folder.to_be_bytes()),
+            sha(data)
+        )
+    }
