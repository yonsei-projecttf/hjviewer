+            &entry(remove("auto_install_after")),
+            ISSUED,
+            number("1.5.1"),
+            SLOT,
+        );
+        let due = GRACE + 1000;
+        assert_eq!(decide(None, due, false), Plan::Nothing);
+        assert_eq!(decide(None, due, true), Plan::Nothing);
+        assert_eq!(decide(forced.as_ref(), due - 1, false), Plan::Later(due));
+        assert_eq!(
+            decide(forced.as_ref(), due, false),
