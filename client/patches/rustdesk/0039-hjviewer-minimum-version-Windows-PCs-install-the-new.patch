+    #[test]
+    fn a_download_that_fails_is_tried_again_later_and_is_no_install() {
+        let data = package_bytes();
+        let pc = Fake::new("retry", Some(entry(&data, |_| {})), due() + 1, &data);
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        *pc.answer.borrow_mut() = Err(Failure::Network);
+        let failures = [
+            (Failure::Network, Failure::Busy, 1800),
+            (Failure::Busy, Failure::Http, 7200),
+            (Failure::Http, Failure::Tls, 21_600),
+            (Failure::Tls, Failure::Missing, 21_600),
+        ];
+        let mut since = 1;
+        for (n, (failure, next, wait)) in (1u32..).zip(failures) {
+            let (seconds, did) = pc.until_tried(&mut service, 30_000);
+            assert_eq!(seconds, since, "{failure:?}");
+            // after each wait the server's last answer is old: it is asked again every time
+            let asked: &[&str] = if n == 1 {
+                &[]
+            } else {
+                &["idle", "check regular"]
+            };
+            assert_eq!(did[..asked.len()], *asked, "{failure:?}");
+            let folder = plan::folder_name(n.to_be_bytes());
+            assert_eq!(
+                did[asked.len()..],
+                [
+                    "idle".to_owned(),
+                    format!("stage {folder}"),
+                    "fetch".to_owned(),
+                    "discard".to_owned(),
+                    "save 0 installs".to_owned()
+                ]
+            );
+            assert_eq!(pc.job().error, failure.code());
+            *pc.answer.borrow_mut() = Err(next);
+            since = wait;
+        }
+        // the place could not be made (a junction on the way, another owner): the same
+        pc.stages.set(false);
+        let (seconds, did) = pc.until_tried(&mut service, 30_000);
+        assert_eq!(
+            (seconds, did),
+            (
+                21_600,
+                vec![
+                    "idle".to_owned(),
+                    "check regular".to_owned(),
+                    "idle".to_owned(),
+                    "save 0 installs".to_owned()
+                ]
+            )
+        );
+        assert_eq!(pc.job().error, "file");
+        assert_eq!(pc.record().unwrap().installs, 0);
+        // when it works, it is the first install
+        pc.stages.set(true);
+        *pc.answer.borrow_mut() = Ok(data.clone());
+        let (seconds, did) = pc.until_tried(&mut service, 30_000);
+        assert_eq!(seconds, 21_600);
+        assert_eq!(did.last(), Some(&launch_of(5, 1, &data)));
+    }
