+        // at the minimum, below the latest: the rollout's time, ring by ring
+        let at = |ring: u8, spread: i64| {
+            schedule(&entry(|_| {}), ISSUED, min, Slot { ring, spread }).unwrap()
+        };
+        assert_eq!(at(0, 0).due, Some(AFTER));
+        assert_eq!(at(0, 86_399).due, Some(AFTER + 86_399));
+        assert_eq!(at(1, 0).due, Some(AFTER + DAY));
+        assert_eq!(at(2, 1000).due, Some(AFTER + 2 * DAY + 1000));
+        assert_eq!(at(2, 1000).overdue, None);
+        let plan = at(1, 5);
+        assert_eq!(plan.target.version.as_str(), "1.6.1");
+        assert_eq!(plan.target.package.size, 26_214_400);
+        assert_eq!(hex::encode(plan.target.package.sha256), WINDOWS_SHA256);
+
+        // below the minimum: its deadline and the spread, without the ring
+        let forced = schedule(&entry(remove("auto_install_after")), ISSUED, old, SLOT).unwrap();
+        assert_eq!(forced.due, Some(GRACE + 1000));
+        assert_eq!(forced.overdue, Some(GRACE + 1000 + DAY));
+        // a minimum without a deadline counts from the policy's own time
+        let no_grace = |entry: &mut serde_json::Value| {
+            let entry = entry.as_object_mut().unwrap();
+            entry.remove("auto_install_after");
+            entry.remove("grace_until");
+            entry.remove("grace_min");
+        };
+        let at_once = schedule(&entry(no_grace), ISSUED, old, SLOT).unwrap();
+        assert_eq!(at_once.due, Some(ISSUED + 1000));
+        assert_eq!(at_once.overdue, Some(ISSUED + 1000 + DAY));
+        // below the version the grace period starts at (1.5.0) a PC is blocked already: from
+        // the policy's own time too, whatever the deadline
+        let blocked = schedule(
+            &entry(remove("auto_install_after")),
+            ISSUED,
+            number("1.4.9"),
+            SLOT,
+        );
+        let blocked = blocked.unwrap();
+        assert_eq!(blocked.due, Some(ISSUED + 1000));
+        assert_eq!(blocked.overdue, Some(ISSUED + 1000 + DAY));
+        let raise = |entry: &mut serde_json::Value| {
+            entry.as_object_mut().unwrap().remove("auto_install_after");
+            entry["min"] = "1.6.1".into();
+            entry["grace_min"] = "1.6.0".into();
+        };
+        // a raise with a grace period from 1.6.0: a PC at 1.6.0 at the deadline, at 1.5.1 at once
+        let in_grace = schedule(&entry(raise), ISSUED, min, SLOT).unwrap();
+        assert_eq!(in_grace.due, Some(GRACE + 1000));
+        let below = schedule(&entry(raise), ISSUED, old, SLOT).unwrap();
+        assert_eq!(below.due, Some(ISSUED + 1000));
+        assert_eq!(below.overdue, Some(ISSUED + 1000 + DAY));
+        // both: whichever comes first, and overdue by the minimum alone
+        let both = schedule(&entry(|_| {}), ISSUED, old, SLOT).unwrap();
+        assert_eq!(both.due, Some(AFTER + 2 * DAY + 1000));
+        assert_eq!(both.overdue, Some(GRACE + 1000 + DAY));
+        let late = |entry: &mut serde_json::Value| {
+            entry["auto_install_after"] = "2026-12-01T00:00:00Z".into();
+        };
+        let both = schedule(&entry(late), ISSUED, old, SLOT).unwrap();
+        assert_eq!(both.due, Some(GRACE + 1000));
+
+        // the emergency stop: no time in the policy, and the PC is not below the minimum
+        let stopped = schedule(&entry(remove("auto_install_after")), ISSUED, min, SLOT).unwrap();
+        assert_eq!((stopped.due, stopped.overdue), (None, None));
+        // nothing at or below the PC's own version is ever installed
+        assert_eq!(
+            schedule(&entry(|_| {}), ISSUED, number("1.6.1"), SLOT),
+            None
+        );
+        assert_eq!(
+            schedule(&entry(|_| {}), ISSUED, number("1.7.0"), SLOT),
+            None
+        );
+        // and nothing without a package
+        assert_eq!(schedule(&entry(remove("package")), ISSUED, old, SLOT), None);
+    }
