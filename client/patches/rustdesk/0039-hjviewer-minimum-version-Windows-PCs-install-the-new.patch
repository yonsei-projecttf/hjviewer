+    #[test]
+    fn the_main_window_waits_for_the_service_to_take_its_signal() {
+        let (mine, other) = (signal([7; 8]), signal([8; 8]));
+        let job = |phase: &str, error: &str, sig: &str| {
+            Shown {
+                phase: phase.to_owned(),
+                error: error.to_owned(),
+                cred: "unbound".to_owned(),
+                sig: sig.to_owned(),
+                ..Default::default()
+            }
+            .text()
+        };
+        // a window that sent its signal at second 100
+        let window = || {
+            let mut asked = Asked::new();
+            asked.sent(&mine, 100);
+            asked
+        };
+        let phase = |asked: &mut Asked, job: &str, mono: u64| {
+            let view = asked.view(job, mono);
+            (view.phase, view.error)
+        };
+        // not taken yet: twenty seconds of waiting, then the service does not answer
+        let not_taken = [
+            String::new(),
+            job("idle", "", ""),
+            job("idle", "", &other),
+            job("waiting", "", &other),
+            job("error", "network", &other),
+        ];
+        for job in not_taken {
+            let mut asked = window();
+            assert_eq!(phase(&mut asked, &job, 100), ("waiting", ""));
+            assert_eq!(phase(&mut asked, &job, 119), ("waiting", ""));
+            assert_eq!(phase(&mut asked, &job, 120), ("error", "service"));
+            assert_eq!(phase(&mut asked, &job, 100_000), ("error", "service"));
+        }
+        // a service in the middle of an update is not silent: it does what was asked for
+        for updating in ["downloading", "verifying", "notice", "installing"] {
+            for sig in ["", other.as_str()] {
+                let mut asked = window();
+                assert_eq!(
+                    phase(&mut asked, &job(updating, "", sig), 100),
+                    (updating, "")
+                );
+                assert_eq!(
+                    phase(&mut asked, &job(updating, "", sig), 5000),
+                    (updating, "")
+                );
+                // that over, the service has twenty seconds to take the signal
+                assert_eq!(
+                    phase(&mut asked, &job("idle", "", sig), 5019),
+                    ("waiting", "")
+                );
+                assert_eq!(
+                    phase(&mut asked, &job("idle", "", sig), 5020),
+                    ("error", "service")
+                );
+            }
+        }
+        // taken: what the service says, and from then on whichever signal it names, as after
+        // another window's signal or a new start of the service's process
+        let mut asked = window();
+        assert_eq!(
+            phase(&mut asked, &job("waiting", "", &mine), 101),
+            ("waiting", "")
+        );
+        assert_eq!(
+            phase(&mut asked, &job("error", "missing", &mine), 5000),
+            ("error", "missing")
+        );
+        assert_eq!(
+            phase(&mut asked, &job("error", "network", &other), 5000),
+            ("error", "network")
+        );
+        assert_eq!(phase(&mut asked, &job("idle", "", ""), 5000), ("idle", ""));
+        assert_eq!(phase(&mut asked, "", 5000), ("idle", ""));
+        // until the window asks again: the signal before this one is not this one
+        asked.sent(&other, 6000);
+        assert_eq!(
+            phase(&mut asked, &job("idle", "", &mine), 6019),
+            ("waiting", "")
+        );
+        assert_eq!(
+            phase(&mut asked, &job("idle", "", &mine), 6020),
+            ("error", "service")
+        );
+        assert_eq!(
+            phase(&mut asked, &job("idle", "", &other), 6021),
+            ("idle", "")
+        );
+        // a window whose signal was never taken asks again: the wait starts anew
+        let mut asked = window();
+        assert_eq!(
+            phase(&mut asked, &job("idle", "", ""), 500),
+            ("error", "service")
+        );
+        asked.sent(&other, 500);
+        assert_eq!(
+            phase(&mut asked, &job("idle", "", ""), 519),
+            ("waiting", "")
+        );
+        assert_eq!(
+            phase(&mut asked, &job("idle", "", &other), 5000),
+            ("idle", "")
+        );
+        // what the service knows of the PC shows while the window waits, too
+        let mut waiting = window();
+        assert_eq!(
+            waiting.view(&job("idle", "", &other), 103).credential,
+            "unbound"
+        );
+    }
