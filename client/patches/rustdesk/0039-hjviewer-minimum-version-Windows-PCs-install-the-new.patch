+/// The state the screens get, in the main window of an installed PC: the update there is the
+/// service's, so its phase stands for the job and its word for what this PC can show door 1.
+pub(crate) fn overlay(state: &mut Value, view: &plan::View) {
+    state["credential"] = view.credential.into();
+    state["job"] = json!({
+        "phase": view.phase,
+        "error": view.error,
+        "done": 0,
+        "total": 0,
+        "file": "",
+        "until": view.until,
+    });
+}
