+        signals.fetched_whole(130);
+        assert_eq!(signals.take(&signal([2; 8]), 200), Signal::TooSoon);
+        assert_eq!(signals.take(&signal([3; 8]), 729), Signal::TooSoon);
+        assert_eq!(signals.take(&signal([4; 8]), 730), Signal::Taken);
+        // one that fetched nothing leaves the next ten seconds away
+        assert_eq!(signals.take(&signal([5; 8]), 739), Signal::TooSoon);
+        assert_eq!(signals.take(&signal([6; 8]), 740), Signal::Taken);
+    }
