+    #[test]
+    fn the_record_file() {
+        let temp = TempFile::new("record", plan::RECORD_FILE);
+        assert_eq!(read_record(&temp.0), None);
+        let mut record = Record::of(&target(&package_bytes()));
+        record.install_started(1_794_000_000);
+        assert!(write_record(&temp.0, Some(&record)));
+        assert_eq!(read_record(&temp.0), Some(record.clone()));
+        // written anew over the old one, with nothing left beside it
+        record.install_started(1_794_100_000);
+        assert!(write_record(&temp.0, Some(&record)));
+        assert_eq!(read_record(&temp.0).unwrap().installs, 2);
+        assert_eq!(std::fs::read_dir(temp.dir()).unwrap().count(), 1);
+        // a file that is no record is none, and so is one far longer than a record is
+        std::fs::write(&temp.0, b"{}").unwrap();
+        assert_eq!(read_record(&temp.0), None);
+        let mut long = serde_json::to_vec(&record).unwrap();
+        long.resize(4096, b' ');
+        std::fs::write(&temp.0, &long).unwrap();
+        assert_eq!(read_record(&temp.0), Some(record.clone()));
+        long.push(b' ');
+        std::fs::write(&temp.0, &long).unwrap();
+        assert_eq!(read_record(&temp.0), None);
+        // removed, and removing what is not there is no failure
+        assert!(write_record(&temp.0, None));
+        assert!(!temp.0.exists());
+        assert!(write_record(&temp.0, None));
+        // a place that cannot be written
+        std::fs::write(temp.dir().join("file"), b"").unwrap();
+        let under_a_file = temp.dir().join("file").join("record");
+        assert!(!write_record(&under_a_file, Some(&record)));
+    }
