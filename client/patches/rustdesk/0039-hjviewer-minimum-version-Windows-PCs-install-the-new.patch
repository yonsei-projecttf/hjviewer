+        // the answer: the install, with the session open and without a look at it; the policy
+        // is asked for again before the start, and an answer that does not come is waited for
+        // forty seconds
+        pc.facts.borrow_mut().as_mut().unwrap().checking = false;
+        let before = pc.wall.get();
+        pc.pass(&mut service, 1);
