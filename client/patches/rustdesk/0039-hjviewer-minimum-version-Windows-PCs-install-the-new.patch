+    /// By itself the service starts the installer only by a policy the server confirmed in the
+    /// last half hour, also when the server does not answer right before the start: not by one it
+    /// confirmed 1700 s before the ten minutes of warning, nor by one it confirmed 1790 s before
+    /// an answer that takes longer than forty seconds. The next look asks the server again.
+    #[test]
+    fn a_policy_that_got_old_meanwhile_is_not_installed_by() {
+        let data = package_bytes();
+        let now = forced() + 2 * DAY;
+        let pc = Fake::new("old", Some(entry(&data, without_rollout)), now, &data);
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(1700);
+        // the server does not answer
+        pc.check.set(|_| {});
+        *pc.idle.borrow_mut() = vec![false];
+        pc.hour.set(3);
+        let mut service = Service::new(&pc, V151, 0);
+        pc.take();
+        service.tick();
+        assert_eq!(
+            pc.take(),
+            [
+                "sessions",
+                "stage 00000001",
+                "fetch",
+                "seal",
+                "sessions",
+                "notice 600",
+                "check now",
+                "discard"
+            ]
+        );
+        assert_eq!(pc.record(), None);
+        assert!(!pc.folder(1).exists());
+        // the half hour counts to the second: confirmed 1200 s before, the policy is 1800 s old
+        // once the warning is over and still installs; 1201 s is too old
+        for (age, installs) in [(1200, true), (1201, false)] {
+            let test = format!("old-{age}");
+            let pc = Fake::new(&test, Some(entry(&data, without_rollout)), now, &data);
+            pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(age);
+            pc.check.set(|_| {});
+            *pc.idle.borrow_mut() = vec![false];
+            pc.hour.set(3);
+            let mut service = Service::new(&pc, V151, 0);
+            pc.take();
+            service.tick();
+            let last = pc.take().pop();
+            let launch = launch_of(1, 1, &data);
+            let expected = if installs { launch.as_str() } else { "discard" };
+            assert_eq!(last.as_deref(), Some(expected), "{age}");
+        }
+        // nothing is fetched again until the server confirms the policy
+        pc.pass(&mut service, 3600);
+        let did = pc.take();
+        assert_eq!(did[..2], ["sessions", "check regular"]);
+        assert!(did[2..].iter().all(|did| did == "sessions"), "{did:?}");
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(0);
+        let (_, did) = pc.until_done(&mut service, 100);
+        assert_eq!(did.last(), Some(&launch_of(2, 1, &data)));
+        // an answer that takes longer than forty seconds
+        let pc = Fake::new("old-b", Some(entry(&data, |_| {})), due() + 1, &data);
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(1790);
+        pc.check.set(|facts| facts.checking = true);
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        service.tick();
+        assert_eq!(
+            pc.take(),
+            [
+                "idle",
+                "stage 00000001",
+                "fetch",
+                "seal",
+                "idle",
+                "check now",
+                "discard"
+            ]
+        );
+        assert_eq!(pc.record(), None);
+        let (seconds, did) = pc.until_done(&mut service, 100);
+        assert_eq!(seconds, 1);
+        assert_eq!(did, ["idle", "check regular"]);
+    }
+
+    /// Where sessions hold the install up, they are looked at again right before the start: a
+    /// session that came in while the service waited for the server's answer holds it up too.
+    #[test]
+    fn a_session_that_came_in_while_the_server_was_asked_holds_the_install_up() {
+        let data = package_bytes();
+        let pc = Fake::new("asked", Some(entry(&data, |_| {})), due() + 1, &data);
+        // the server takes its time to answer, and a session comes in meanwhile
+        pc.check.set(|facts| facts.checking = true);
+        *pc.idle.borrow_mut() = vec![true, true, false];
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        service.tick();
+        assert_eq!(
+            pc.take(),
+            [
+                "idle",
+                "stage 00000001",
+                "fetch",
+                "seal",
+                "idle",
+                "check now",
+                "sessions",
+                "discard",
+                "save 0 installs"
+            ]
+        );
+        assert!(!pc.folder(1).exists());
+        let record = pc.record().unwrap();
+        assert_eq!(record.installs, 0);
+        assert_eq!(record.not_before, pc.wall.get() + plan::BUSY_WAIT);
+        // half an hour later, with nobody there, it is installed
+        *pc.idle.borrow_mut() = vec![true];
+        pc.check.set(|facts| {
+            facts.checking = false;
+            facts.confirmed = Some(0);
+        });
+        let (seconds, did) = pc.until_tried(&mut service, 3600);
+        assert!((1800..=1820).contains(&seconds), "{seconds}");
+        assert_eq!(did.last(), Some(&launch_of(2, 1, &data)));
+        // the same for a PC a day overdue below the minimum, outside the quiet hours
+        let now = forced() + 2 * DAY;
+        let pc = Fake::new(
+            "asked-overdue",
+            Some(entry(&data, without_rollout)),
+            now,
+            &data,
+        );
+        pc.check.set(|facts| facts.checking = true);
+        *pc.idle.borrow_mut() = vec![true, true, false];
+        let mut service = Service::new(&pc, V151, 0);
+        pc.take();
+        service.tick();
+        let did = pc.take();
+        assert_eq!(
+            did[did.len() - 3..],
+            ["sessions", "discard", "save 0 installs"]
+        );
+        assert_eq!(
+            pc.record().unwrap().not_before,
+            pc.wall.get() + plan::BUSY_WAIT
+        );
+    }
+
+    /// The service installs only from a policy the PC may install from (MAY_INSTALL): not from
+    /// a declaration's base, nor from a policy below the build's floor.
+    #[test]
+    fn the_service_takes_only_a_policy_it_may_install_from() {
+        let file = TempFile::new("facts-may", super::super::store::FILE);
+        let mut core = super::super::Core::open(pins(), file.0.clone(), Os::Windows, false);
+        let answer = |body: String| {
+            Ok(Reply {
+                status: 200,
+                date: None,
+                body: body.into_bytes(),
+            })
+        };
+        core.begin(Kind::Regular, 0).unwrap();
+        core.finish(answer(signed_1(1, 7)), ISSUED as u64, 0, 0);
+        assert!(core.facts(ISSUED as u64, 0).entry.is_some());
+        // a declaration whose policy did not get through: the base is enforced, nothing installed
+        let root = root_part(&ROOT, &root_text(2, &[1]));
+        let alone = envelope(2, &SIGNING_1, &policy_text(2, 1), Some(&root));
+        core.begin(Kind::Immediate, 60).unwrap();
+        core.finish(answer(alone), ISSUED as u64, 60, 0);
+        let facts = core.facts(ISSUED as u64, 60);
+        assert_eq!((facts.entry, facts.issued), (None, 0));
+        // the epoch's policy: from it again
+        core.begin(Kind::Immediate, 120).unwrap();
+        core.finish(answer(declared(2, 1, &[1])), ISSUED as u64, 120, 0);
+        assert!(core.facts(ISSUED as u64, 120).entry.is_some());
+        // a build whose floor is above the policy held: nothing until one at the floor
+        let kept = core.take_unsaved().unwrap();
+        super::super::store::save(&pins(), &file.0, &kept).unwrap();
+        let later =
+            super::super::Core::open(pins_with_floor("2:2"), file.0.clone(), Os::Windows, false);
+        assert_eq!(later.facts(ISSUED as u64, 0).entry, None);
+    }
+}
diff --git a/src/hjviewer_update/install_plan.rs b/src/hjviewer_update/install_plan.rs
new file mode 100644
index 0000000..fefd96c
--- /dev/null
+++ b/src/hjviewer_update/install_plan.rs
@@ -0,0 +1,1477 @@
+//! What a Windows PC decides about a newer version, as plain rules: when an installed PC
+//! installs it (its ring and spread, a minimum's deadline, how long sessions hold it up), what it
+//! remembers of its attempts, how the file and the command are named, how often a person's "now"
+//! is taken, and what the main window is told. `install` acts on these rules and `win` makes the
+//! Windows calls; nothing here touches the system, so every rule is tested on any platform.
+// elsewhere only the tests use these
+#![cfg_attr(not(windows), allow(dead_code))]
+
+use super::{
+    door::Failure,
+    policy::{Entry, Package, Version},
+};
+use serde_derive::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::VecDeque;
+
+/// The Config2 options between the main window and the service of an installed PC: the window
+/// writes a new value into NOW to have the update made now, and the service says how far it is
+/// in JOB.
+pub(crate) const NOW: &str = "hjv-update-now";
+pub(crate) const JOB: &str = "hjv-update-job";
+/// The service's record of its attempts, in its config folder.
+pub(crate) const RECORD_FILE: &str = "HJViewer_update_install.json";
+/// The folder of the downloads, under the local application data of SYSTEM for the service and
+/// under the user's temporary files for an app that is not installed.
+pub(crate) const FOLDER: &str = "hjviewer-update";
+/// The packer of a new version waits for the process of this ID to end before it unpacks
+/// (libs/portable/src/hjv_guard.rs reads the same name).
+pub(crate) const WAIT_PID: &str = "HJV_WAIT_PID";
+
+pub(crate) const DAY: i64 = 86_400;
+const HOUR: u64 = 3600;
+const RING_CONTEXT: &[u8] = b"hjv-ring-v1";
+const RINGS: u8 = 3;
+/// A PC below the minimum waits this long after its time for a moment without sessions.
+const IDLE_WAIT: i64 = DAY;
+/// After that it installs with sessions open, but only in these hours of the PC's day, 02:00 to
+/// 05:00, and only after NOTICE seconds of warning.
+const QUIET_HOURS: std::ops::Range<u32> = 2..5;
+pub(crate) const NOTICE: u64 = 600;
+/// What the warning says (the design's W5, ahead of time).
+pub(crate) const NOTICE_TEXT: &str = "HJViewer가 10분 뒤에 닫히고 새 버전을 설치합니다. 진행 중인 원격 연결은 모두 끊기고, 설치가 끝나면 다시 연결할 수 있습니다.";
+/// The installer of one package is started at most this often, this far apart.
+pub(crate) const MAX_INSTALLS: u32 = 3;
+const INSTALL_GAP: u64 = 6 * HOUR;
+/// A download that failed for a reason that passes is tried again after half an hour, then two
+/// hours, then every six.
+const RETRY_AFTER: [u64; 3] = [HOUR / 2, 2 * HOUR, 6 * HOUR];
+/// A PC the server hands nothing to asks again after this long, or as soon as it is bound to an
+/// account (`Record::bound_since_refused`).
+const REFUSED_WAIT: u64 = 6 * HOUR;
+/// A package that was not the signed one is not fetched again for a day.
+const VERIFY_WAIT: u64 = 24 * HOUR;
+/// Sessions that were open when the file was ready put the next try off by this.
+pub(crate) const BUSY_WAIT: u64 = HOUR / 2;
+/// A person's "now" is taken at most every ten seconds, and at most every ten minutes after one
+/// that fetched a whole package.
+const SIGNAL_GAP: u64 = 10;
+const SIGNAL_WHOLE_GAP: u64 = 600;
+const SIGNALS_KEPT: usize = 8;
+/// The main window waits this long for the service to take its signal.
+const ANSWER_WAIT: u64 = 20;
+/// platform/windows.cc copies the command into a buffer of MAX_PATH wide characters.
+pub(crate) const MAX_COMMAND: usize = 260;
+const MAX_JOB: usize = 512;
+
+/// Where a PC stands in a rollout.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct Slot {
+    /// whole days after the policy's time: 0, 1 or 2
+    pub ring: u8,
+    /// seconds on top of that, less than a day
+    pub spread: i64,
+}
+
+/// The slot of a device ID: of H = SHA-256("hjv-ring-v1" NUL ID) the ring is H[0] mod 3 and the
+/// spread the 24-bit number H[1..4] (big-endian) scaled to a day.
+pub(crate) fn slot(device_id: &str) -> Slot {
+    let mut hasher = Sha256::new();
+    hasher.update(RING_CONTEXT);
+    hasher.update([0u8]);
+    hasher.update(device_id.as_bytes());
+    let h = hasher.finalize();
+    let number = i64::from(h[1]) << 16 | i64::from(h[2]) << 8 | i64::from(h[3]);
+    Slot {
+        ring: h[0] % RINGS,
+        spread: (number * DAY) >> 24,
+    }
+}
+
+/// What to install: the `latest` of the Windows entry and its package.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Target {
+    pub version: Version,
+    pub package: Package,
+}
+
+/// The times of a PC under a policy.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Schedule {
+    pub target: Target,
+    /// from when this PC installs by itself; None when the policy names no time for it
+    pub due: Option<i64>,
+    /// from when sessions no longer hold the install up for good
+    pub overdue: Option<i64>,
+}
+
+/// When a PC of version `current` and `slot` installs under the Windows `entry` of a policy
+/// issued at `issued`; None when the entry has no package above the PC's own version.
+/// - A rollout: `auto_install_after`, plus the ring's days, plus the spread.
+/// - A minimum the PC is below: the deadline when the PC is in the grace period before it (at or
+///   above `grace_min`), else the policy's `issued`, as such a PC is blocked already; plus the
+///   spread, without the ring.
+pub(crate) fn schedule(entry: &Entry, issued: i64, current: i64, slot: Slot) -> Option<Schedule> {
+    if entry.latest.number() <= current {
+        return None;
+    }
+    let package = entry.package.clone()?;
+    let rollout = entry.auto_install_after.map(|after| {
+        after
+            .saturating_add(i64::from(slot.ring) * DAY)
+            .saturating_add(slot.spread)
+    });
+    let forced = (current < entry.min.number()).then(|| {
+        let in_grace = entry
+            .grace_min
+            .as_ref()
+            .is_some_and(|grace_min| current >= grace_min.number());
+        let anchor = match entry.grace_until {
+            Some(until) if in_grace => until,
+            _ => issued,
+        };
+        anchor.saturating_add(slot.spread)
+    });
+    Some(Schedule {
+        target: Target {
+            version: entry.latest.clone(),
+            package,
+        },
+        due: match (rollout, forced) {
+            (Some(rollout), Some(forced)) => Some(rollout.min(forced)),
+            (rollout, forced) => rollout.or(forced),
+        },
+        overdue: forced.map(|at| at.saturating_add(IDLE_WAIT)),
+    })
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Mode {
+    /// in a moment without sessions
+    Idle,
+    /// below the minimum for a day past its time: with sessions open too, in the quiet hours
+    Overdue,
+    /// a person asked for it: at once
+    Now,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Plan {
+    /// no package above this PC's version
+    Nothing,
+    /// a newer package that the policy sets no time for: a person may ask for it
+    Unscheduled,
+    /// not before this time
+    Later(i64),
+    Install(Mode),
+}
+
+/// What to do at `now`, the policy's clock; `asked` when a person asked for the update now.
+pub(crate) fn decide(schedule: Option<&Schedule>, now: i64, asked: bool) -> Plan {
+    let Some(schedule) = schedule else {
+        return Plan::Nothing;
+    };
+    if asked {
+        return Plan::Install(Mode::Now);
+    }
+    match schedule.due {
+        None => Plan::Unscheduled,
+        Some(due) if now < due => Plan::Later(due),
+        Some(_) if schedule.overdue.is_some_and(|at| now >= at) => Plan::Install(Mode::Overdue),
+        Some(_) => Plan::Install(Mode::Idle),
+    }
+}
+
+/// Whether sessions hold an install up.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Sessions {
+    Go,
+    /// sessions are open and no longer hold it up: warn whoever is there, wait NOTICE, install
+    Announce,
+    Wait,
+}
+
+/// An install waits for a moment without sessions, with two exceptions: one a person asked for,
+/// and one that is overdue, in the quiet hours (`hour` of the PC's day).
+pub(crate) fn sessions(mode: Mode, idle: bool, hour: u32) -> Sessions {
+    match mode {
+        Mode::Now => Sessions::Go,
+        _ if idle => Sessions::Go,
+        Mode::Overdue if QUIET_HOURS.contains(&hour) => Sessions::Announce,
+        _ => Sessions::Wait,
+    }
+}
+
+/// Why the service does not try now.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Hold {
+    /// the installer of this package was started MAX_INSTALLS times and the PC is still on its
+    /// version: until another package comes or a person asks
+    Stopped,
+    /// not before this time, by the device's clock
+    Until(u64),
+}
+
+/// What the service remembers of the package it is installing, between its runs.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, Default)]
+pub(crate) struct Record {
+    #[serde(default)]
+    pub version: String,
+    /// the package's SHA-256 in hex: another package starts a new record
+    #[serde(default)]
+    pub sha256: String,
+    /// how often the new version's installer was started
+    #[serde(default)]
+    pub installs: u32,
+    /// when it last was, by the device's clock
+    #[serde(default)]
+    pub installed_at: u64,
+    /// downloads in a row that failed for a reason that passes
+    #[serde(default)]
+    pub retries: u32,
+    /// no download before this time
+    #[serde(default)]
+    pub not_before: u64,
+    /// why the last try ended, as the main window's code; empty when it did not fail
+    #[serde(default)]
+    pub error: String,
+}
+
+impl Record {
+    pub(crate) fn of(target: &Target) -> Record {
+        Record {
+            version: target.version.as_str().to_owned(),
+            sha256: hex::encode(target.package.sha256),
+            ..Default::default()
+        }
+    }
+
+    pub(crate) fn is_of(&self, target: &Target) -> bool {
+        self.version == target.version.as_str() && self.sha256 == hex::encode(target.package.sha256)
+    }
+
+    /// The record to go on with: the kept one if it is of this package, else a new one.
+    pub(crate) fn for_target(kept: Option<Record>, target: &Target) -> Record {
+        kept.filter(|kept| kept.is_of(target))
+            .unwrap_or_else(|| Record::of(target))
+    }
+
+    /// A record as it is read from the file; None for one that does not keep the form.
+    pub(crate) fn parse(text: &[u8]) -> Option<Record> {
+        let record: Record = serde_json::from_slice(text).ok()?;
+        let hex = |text: &str| text.bytes().all(|b| b.is_ascii_hexdigit());
+        let code = |text: &str| text.bytes().all(|b| b.is_ascii_lowercase());
+        let formed = Version::parse(&record.version).is_some()
+            && record.sha256.len() == 64
+            && hex(&record.sha256)
+            && record.error.len() <= 16
+            && code(&record.error);
+        formed.then_some(record)
+    }
+
+    /// A clock that was set back holds nothing up for longer than the waits are. True when the
+    /// record changed.
+    pub(crate) fn settle(&mut self, wall: u64) -> bool {
+        let installed_at = self.installed_at.min(wall);
+        let not_before = self.not_before.min(wall.saturating_add(VERIFY_WAIT));
+        let changed = (installed_at, not_before) != (self.installed_at, self.not_before);
+        (self.installed_at, self.not_before) = (installed_at, not_before);
+        changed
+    }
+
+    pub(crate) fn hold(&self, wall: u64) -> Option<Hold> {
+        if self.installs >= MAX_INSTALLS {
+            return Some(Hold::Stopped);
+        }
+        let after_install = match self.installs {
+            0 => 0,
+            _ => self.installed_at.saturating_add(INSTALL_GAP),
+        };
+        let until = after_install.max(self.not_before);
+        (wall < until).then_some(Hold::Until(until))
+    }
+
+    /// A download did not give the package. It is not counted as an install; it only puts the
+    /// next try off.
+    pub(crate) fn download_failed(&mut self, failure: Failure, wall: u64) {
+        let wait = match failure {
+            Failure::Verify | Failure::Version => VERIFY_WAIT,
+            Failure::Refused | Failure::Login => REFUSED_WAIT,
+            Failure::Network
+            | Failure::Tls
+            | Failure::Busy
+            | Failure::Http
+            | Failure::Missing
+            | Failure::File => {
+                let step = (self.retries as usize).min(RETRY_AFTER.len() - 1);
+                self.retries = self.retries.saturating_add(1);
+                RETRY_AFTER[step]
+            }
+        };
+        self.not_before = wall.saturating_add(wait);
+        self.error = failure.code().to_owned();
+    }
+
+    /// Nothing failed, but not now either (sessions were open when the file was ready).
+    pub(crate) fn put_off(&mut self, wall: u64, seconds: u64) {
+        self.not_before = wall.saturating_add(seconds);
+    }
+
+    /// The PC was bound to an account after the server refused it: that refusal holds nothing up
+    /// any more. True when the record changed.
+    pub(crate) fn bound_since_refused(&mut self) -> bool {
+        if self.error != Failure::Refused.code() {
+            return false;
+        }
+        self.error.clear();
+        self.not_before = 0;
+        true
+    }
+
+    /// The installer is about to be started: this is what counts, and it is written down before
+    /// the start, as the installer ends this process when it works.
+    pub(crate) fn install_started(&mut self, wall: u64) {
+        self.installs = self.installs.saturating_add(1);
+        self.installed_at = wall;
+        self.retries = 0;
+        self.not_before = 0;
+        self.error.clear();
+    }
+
+    /// The installer did not start, or this process outlived it.
+    pub(crate) fn install_failed(&mut self) {
+        self.error = "install".to_owned();
+    }
+
+    /// A person asked: the count and the waits start anew.
+    pub(crate) fn reset(&mut self) {
+        *self = Record {
+            version: std::mem::take(&mut self.version),
+            sha256: std::mem::take(&mut self.sha256),
+            ..Default::default()
+        };
+    }
+
+    /// Whether an installer that was started brought this PC to the record's version, for a
+    /// process of version `current`; None when none was started.
+    pub(crate) fn took(&self, current: i64) -> Option<bool> {
+        let version = Version::parse(&self.version)?;
+        (self.installs > 0).then(|| version.number() <= current)
+    }
+
+    /// What the main window shows of a record that holds the service back.
+    pub(crate) fn shown_error(&self) -> &str {
+        if self.installs >= MAX_INSTALLS {
+            "attempts"
+        } else {
+            &self.error
+        }
+    }
+}
+
+/// Whether the account module's state of this PC (option hjv-pwless-state) shows a binding to an
+/// account, which is what door 1 hands packages to devices by. Empty is no binding, `revoked`
+/// one that is gone, and `needs-relogin` a device key hjv-api no longer takes; any other state
+/// is of a binding, or says too little to tell, and the server's answer decides.
+pub(crate) fn bound(state: &str) -> bool {
+    !matches!(state, "" | "revoked" | "needs-relogin")
+}
+
+/// The time of a device's request, which hjv-api takes within ten minutes of its own clock: the
+/// device's clock and how far the server's was from it at the last answer.
+pub(crate) fn server_time(wall: u64, server_offset: Option<i64>) -> u64 {
+    let wall = i64::try_from(wall).unwrap_or(i64::MAX);
+    u64::try_from(wall.saturating_add(server_offset.unwrap_or(0))).unwrap_or(0)
+}
+
+/// Whether a package's own file version, the four numbers of its version resource's fixed part,
+/// is the version the policy names for it: a signed but older build named under a higher
+/// `latest` is not run (a downgrade by label). The Windows package is the packer, built with the
+/// app's version (scripts/set-client-version.sh) and 0 as its fourth number; the run number in
+/// `package.build` is the installed app's, so only the three numbers of the version count. A
+/// file without a version resource is no package.
+pub(crate) fn file_version_holds(found: Option<[u16; 4]>, version: &Version) -> bool {
+    let named: Vec<Option<u16>> = version
+        .as_str()
+        .split('.')
+        .map(|n| n.parse().ok())
+        .collect();
+    found.is_some_and(|found| {
+        named.len() == 3
+            && named
+                .iter()
+                .zip(found)
+                .all(|(named, found)| *named == Some(found))
+    })
+}
+
+/// The file a package is written to: the app's own name for the version.
+pub(crate) fn file_name(version: &Version) -> String {
+    format!("HJViewer-{}.exe", version.as_str())
+}
+
+/// The folder a download gets: eight hex digits of random bytes.
+pub(crate) fn folder_name(random: [u8; 4]) -> String {
+    hex::encode(random)
+}
+
+/// Whether the packer would act on the path it is started by: started without arguments, one
+/// that ends in `install.exe` opens the installer and one with `-qs-`, `-qs.exe` or `_qs.exe`
+/// anywhere runs as quick support (libs/portable/src/main.rs).
+pub(crate) fn packer_reads(path: &str) -> bool {
+    let path = path.to_lowercase();
+    path.ends_with("install.exe")
+        || ["-qs-", "-qs.exe", "_qs.exe"]
+            .iter()
+            .any(|mark| path.contains(mark))
+}
+
+/// `"<path>" --update`: what the service starts as SYSTEM. The path is quoted, so that no part
+/// of it is taken for a program or an argument, and must be a plain full path of a drive to an
+/// `.exe`; the command stays below MAX_COMMAND UTF-16 units. None for any other path.
+pub(crate) fn update_command(path: &str) -> Option<String> {
+    let bytes = path.as_bytes();
+    let rooted =
+        bytes.len() > 3 && bytes[0].is_ascii_alphabetic() && bytes[1] == b':' && bytes[2] == b'\\';
+    if !rooted {
+        return None;
+    }
+    let plain = !path
+        .chars()
+        .any(|c| c.is_control() || matches!(c, '"' | '/' | '<' | '>' | '|' | '?' | '*'))
+        && !path[2..].contains(':')
+        && !path.split('\\').any(|part| part == ".." || part == ".");
+    let command = format!("\"{path}\" --update");
+    let fits = command.encode_utf16().count() < MAX_COMMAND;
+    let runs = plain && fits && path.to_lowercase().ends_with(".exe");
+    (runs && !packer_reads(path)).then_some(command)
+}
+
+/// A value for NOW: sixteen hex digits of random bytes.
+pub(crate) fn signal(random: [u8; 8]) -> String {
+    hex::encode(random)
+}
+
+fn is_signal(value: &str) -> bool {
+    value.len() == 16
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+/// What the value of NOW means to the service.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Signal {
+    /// nothing new
+    None,
+    Taken,
+    /// a new one, too soon after the last: it is dropped
+    TooSoon,
+}
+
+/// The service's side of NOW. The main window sends its options as a whole, from a copy that
+/// may be a moment old, so a value can come back after a later one: a value counts once.
+#[derive(Debug, Default)]
+pub(crate) struct Signals {
+    seen: VecDeque<String>,
+    last: Option<u64>,
+    last_whole: Option<u64>,
+}
+
+impl Signals {
+    /// `found` is the option's value when the service starts: it was a signal to an earlier run.
+    pub(crate) fn start(found: &str) -> Signals {
+        let mut signals = Signals::default();
+        signals.remember(found);
+        signals
+    }
+
+    fn remember(&mut self, value: &str) {
+        if self.seen.len() >= SIGNALS_KEPT {
+            self.seen.pop_front();
+        }
+        self.seen.push_back(value.to_owned());
+    }
+
+    /// Looks at the option's value at `mono`, seconds on a clock that only runs forward.
+    pub(crate) fn take(&mut self, value: &str, mono: u64) -> Signal {
+        if !is_signal(value) || self.seen.iter().any(|seen| seen == value) {
+            return Signal::None;
+        }
+        self.remember(value);
+        let within =
+            |last: Option<u64>, gap: u64| last.is_some_and(|last| mono.saturating_sub(last) < gap);
+        if within(self.last, SIGNAL_GAP) || within(self.last_whole, SIGNAL_WHOLE_GAP) {
+            return Signal::TooSoon;
+        }
+        self.last = Some(mono);
+        Signal::Taken
+    }
+
+    /// A run that a signal started fetched the whole package.
+    pub(crate) fn fetched_whole(&mut self, mono: u64) {
+        self.last_whole = Some(mono);
+    }
+}
+
+/// How far the service is, as it writes it into JOB.
+/// - `phase`: idle, waiting (a person asked, and the policy is being checked first),
+///   downloading, verifying, notice (an install with sessions open was announced and starts at
+///   `until`), installing, or error with `error`;
+/// - `error`: a `door::Failure` code, `install` (the installer did not start or did not finish)
+///   or `attempts` (MAX_INSTALLS installs did not take);
+/// - `cred`: device, or unbound when hjv-api hands this PC nothing: it is not on an account;
+/// - `v`: the version it is about; `sig`: the last value of NOW it took.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, Default)]
+pub(crate) struct Shown {
+    #[serde(default)]
+    pub phase: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    pub error: String,
+    #[serde(default)]
+    pub cred: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    pub v: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    pub sig: String,
+    #[serde(default, skip_serializing_if = "is_zero")]
+    pub until: u64,
+}
+
+fn is_zero(number: &u64) -> bool {
+    *number == 0
+}
+
+impl Shown {
+    pub(crate) fn text(&self) -> String {
+        serde_json::to_string(self).unwrap_or_default()
+    }
+}
+
+const PHASES: [&str; 7] = [
+    "idle",
+    "waiting",
+    "downloading",
+    "verifying",
+    "notice",
+    "installing",
+    "error",
+];
+const ERRORS: [&str; 13] = [
+    "login", "network", "tls", "refused", "missing", "busy", "http", "verify", "file", "install",
+    "attempts", "service", "version",
+];
+
+fn word(text: &str, known: &[&'static str]) -> Option<&'static str> {
+    known.iter().copied().find(|known| *known == text)
+}
+
+/// What the main window of an installed PC shows of the service's update.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct View {
+    /// a phase of `Shown`, or waiting while the service has not taken this window's signal
+    pub phase: &'static str,
+    /// with the phase error: a code of `Shown`, or service when the service does not answer
+    pub error: &'static str,
+    /// device or unbound
+    pub credential: &'static str,
+    /// with the phase notice: when the install starts, Unix seconds
+    pub until: u64,
+}
+
+/// What the main window's keys do on Windows.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Act {
+    /// signal the service: on an installed PC the update is the service's
+    AskService,
+    /// fetch the package into the user's Downloads
+    Download,
+    /// start the fetched package in place of this app
+    Run,
+    Nothing,
+}
+
+/// `hjv-update-now` and `hjv-update-download` both ask the service of an installed PC; an app
+/// that is not installed downloads on `hjv-update-download` and starts the file on
+/// `hjv-update-run`.
+pub(crate) fn act(key: &str, installed: bool) -> Act {
+    match (key, installed) {
+        ("hjv-update-now" | "hjv-update-download", true) => Act::AskService,
+        ("hjv-update-download", false) => Act::Download,
+        ("hjv-update-run", false) => Act::Run,
+        _ => Act::Nothing,
+    }
+}
+
+/// A main window's side of NOW: the signal it sent and when, kept until the service names it.
+/// From then on the window shows what the service says, whichever signal that names.
+#[derive(Debug)]
+pub(crate) struct Asked(Option<(String, u64)>);
+
+impl Asked {
+    pub(crate) const fn new() -> Asked {
+        Asked(None)
+    }
+
+    /// The window wrote `signal` into NOW at `mono`, seconds on a clock that only runs forward.
+    pub(crate) fn sent(&mut self, signal: &str, mono: u64) {
+        self.0 = Some((signal.to_owned(), mono));
+    }
+
+    /// Reads JOB for the screen at `mono`. Whoever uses the PC can write that option, so only
+    /// the words this module knows come out of it. Until the service names this window's signal
+    /// the window waits for it, ANSWER_WAIT at most. A service in the middle of an update may
+    /// not look at signals for a while, and it does what the window asked for: its phase is
+    /// shown, and the wait begins when that is over.
+    pub(crate) fn view(&mut self, job: &str, mono: u64) -> View {
+        let shown = (job.len() <= MAX_JOB)
+            .then(|| serde_json::from_str::<Shown>(job).ok())
+            .flatten()
+            .unwrap_or_default();
+        if matches!(&self.0, Some((signal, _)) if *signal == shown.sig) {
+            self.0 = None;
+        }
+        let credential = match shown.cred.as_str() {
+            "unbound" => "unbound",
+            _ => "device",
+        };
+        let view = |phase, error, until| View {
+            phase,
+            error,
+            credential,
+            until,
+        };
+        let phase = word(&shown.phase, &PHASES).unwrap_or("idle");
+        let updating = matches!(phase, "downloading" | "verifying" | "notice" | "installing");
+        match &mut self.0 {
+            // the wait begins when the service has the time to look
+            Some((_, since)) if updating => *since = mono,
+            Some((_, since)) if mono.saturating_sub(*since) < ANSWER_WAIT => {
+                return view("waiting", "", 0)
+            }
+            Some(_) => return view("error", "service", 0),
+            None => {}
+        }
+        match phase {
+            "error" => view("error", word(&shown.error, &ERRORS).unwrap_or("http"), 0),
+            "notice" => view("notice", "", shown.until),
+            phase => view(phase, "", 0),
+        }
+    }
+}
