+    #[test]
+    fn a_signal_counts_once() {
+        let a = signal([1; 8]);
+        assert_eq!(a, "0101010101010101");
+        let (b, c, d) = (signal([2; 8]), signal([3; 8]), signal([4; 8]));
+        // what the option holds at the start was a signal to an earlier run
+        let mut signals = Signals::start(&a);
+        assert_eq!(signals.take(&a, 0), Signal::None);
+        assert_eq!(signals.take("", 0), Signal::None);
+        assert_eq!(signals.take(&b, 5), Signal::Taken);
+        assert_eq!(signals.take(&b, 6), Signal::None);
+        assert_eq!(signals.take(&b, 600), Signal::None);
+        // a copy of the options that is a moment old brings an earlier value back
+        assert_eq!(signals.take(&a, 700), Signal::None);
+        assert_eq!(signals.take(&b, 701), Signal::None);
+        // ten seconds between two
+        assert_eq!(signals.take(&c, 14), Signal::TooSoon);
+        assert_eq!(signals.take(&c, 15), Signal::None);
+        assert_eq!(signals.take(&d, 15), Signal::Taken);
+        // what is no signal
+        for junk in [
+            "now",
+            "0101010101010102 ",
+            "010101010101010G",
+            "0101",
+            "ABCDEF0123456789",
+        ] {
+            assert_eq!(signals.take(junk, 1000), Signal::None, "{junk:?}");
+        }
+        // only so many are remembered: the service looks every second, a copy is seconds old
+        let mut signals = Signals::start("");
+        for n in 0..20u8 {
+            assert_eq!(
+                signals.take(&signal([n; 8]), u64::from(n) * 10),
+                Signal::Taken
+            );
+        }
+        assert_eq!(signals.take(&signal([19; 8]), 1000), Signal::None);
+        assert_eq!(signals.take(&signal([12; 8]), 1000), Signal::None);
+        assert_eq!(signals.take(&signal([0; 8]), 1000), Signal::Taken);
+    }
