+//! HJViewer's guard of the packer. It acts in a build pinned to an hjviewer server (HJV_SERVER at
+//! build time, as src/hjviewer.rs); any other build unpacks as upstream does.
+//!
+//! The packer unpacks the app into a folder of the user and starts it from there. While an
+//! older HJViewer still runs from that folder (its window, or a connection manager it left),
+//! Windows keeps its files from being replaced. Upstream's packer goes on regardless and starts
+//! a mix of old and new files, or, under a name that ends in `install.exe`, the old version's
+//! installer. This one stops: it says why (the design's K1), unless it was started to install
+//! with nobody there, and ends with EXIT_IN_USE without starting anything.
+//!
+//! An app that updates itself (src/hjviewer_update/win.rs) starts the new packer and ends; the
+//! packer waits for that process to be gone before it touches the folder.
+
+/// The process ends with this when a file of the app could not be written: Windows'
+/// ERROR_SHARING_VIOLATION, "the file is being used by another process".
+pub const EXIT_IN_USE: i32 = 32;
+/// The ID of the process to wait for (WAIT_PID in src/hjviewer_update/install_plan.rs).
+const WAIT_PID: &str = "HJV_WAIT_PID";
+/// An app that ends takes a moment; one that does not end is found by its files. The windows
+/// it left for the connections it took (`--cm`) end when it is gone, a moment later.
+#[cfg(windows)]
+const WAIT_MS: u32 = 60_000;
+#[cfg(windows)]
+const HELPERS_MS: u64 = 2000;
+/// K1
+const IN_USE: &str = "HJViewer가 실행 중이라 새 버전을 풀 수 없습니다. 작업 표시줄 오른쪽 아래의 HJViewer 아이콘까지 모두 끝낸 뒤 이 파일을 다시 실행하세요.";
+
+fn pinned() -> bool {
+    option_env!("HJV_SERVER").is_some_and(|server| !server.is_empty())
+}
+
+/// The arguments of an install without a person: the service's update of an installed PC, and
+/// a script's install. A box there would be read by nobody and keep the process from ending.
+const UNATTENDED: [&str; 2] = ["--update", "--silent-install"];
+
+#[derive(Debug, PartialEq, Eq)]
+enum Unwritten {
+    /// as upstream: on to the next file
+    GoOn,
+    /// start nothing, and `tell` whoever started the packer why
+    Stop { tell: bool },
+}
+
+fn unwritten(pinned: bool, args: &[String]) -> Unwritten {
+    if pinned {
+        Unwritten::Stop {
+            tell: !args.iter().any(|arg| UNATTENDED.contains(&arg.as_str())),
+        }
+    } else {
+        Unwritten::GoOn
+    }
+}
+
+/// Takes the result of writing one of the app's files. A file that is not in place ends the
+/// packer here, before it records the folder as unpacked and before it starts anything.
+pub fn written(in_place: bool, args: &[String]) {
+    if in_place {
+        return;
+    }
+    if let Unwritten::Stop { tell } = unwritten(pinned(), args) {
+        eprintln!("a file of the app is in use: nothing is started");
+        if tell {
+            tell_in_use();
+        }
+        std::process::exit(EXIT_IN_USE);
+    }
+}
+
+#[cfg(windows)]
+fn tell_in_use() {
+    use winapi::um::winuser::{MessageBoxW, MB_ICONWARNING, MB_OK, MB_SETFOREGROUND, MB_TOPMOST};
+    let wide = |text: &str| -> Vec<u16> { text.encode_utf16().chain(Some(0)).collect() };
+    let (text, title) = (wide(IN_USE), wide("HJViewer"));
+    let style = MB_OK | MB_ICONWARNING | MB_SETFOREGROUND | MB_TOPMOST;
+    unsafe { MessageBoxW(std::ptr::null_mut(), text.as_ptr(), title.as_ptr(), style) };
+}
+
+#[cfg(not(windows))]
+fn tell_in_use() {
+    eprintln!("{IN_USE}");
+}
+
+fn process_id(value: Option<&str>) -> Option<u32> {
+    let value = value?;
+    let plain = !value.is_empty() && value.bytes().all(|b| b.is_ascii_digit());
+    plain
+        .then(|| value.parse().ok())
+        .flatten()
+        .filter(|id| *id > 0)
+}
+
+/// Waits for the app that started this packer to update itself, if one did, to be gone. The
+/// app the packer starts does not inherit the request.
+pub fn wait_for_old() {
+    if !pinned() {
+        return;
+    }
+    let Some(id) = process_id(std::env::var(WAIT_PID).ok().as_deref()) else {
+        return;
+    };
+    std::env::remove_var(WAIT_PID);
+    wait_for(id);
+}
+
+#[cfg(windows)]
+fn wait_for(id: u32) {
+    use std::ffi::c_void;
+    // kernel32, declared here: which of winapi's features this crate gets depends on its
+    // other dependencies
+    #[link(name = "kernel32")]
+    extern "system" {
+        fn OpenProcess(access: u32, inherit: i32, id: u32) -> *mut c_void;
+        fn WaitForSingleObject(handle: *mut c_void, milliseconds: u32) -> u32;
+        fn CloseHandle(handle: *mut c_void) -> i32;
+    }
+    const SYNCHRONIZE: u32 = 0x0010_0000;
+    unsafe {
+        // no such process: it is gone already
+        let process = OpenProcess(SYNCHRONIZE, 0, id);
+        if !process.is_null() {
+            WaitForSingleObject(process, WAIT_MS);
+            CloseHandle(process);
+        }
+    }
+    std::thread::sleep(std::time::Duration::from_millis(HELPERS_MS));
+}
+
+#[cfg(not(windows))]
+fn wait_for(_id: u32) {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::bin_reader::BinaryData;
+    use std::{fs, io::Write, path::PathBuf};
+
+    /// An entry as generate.py packs it: brotli data and the MD5 of the file in hex.
+    fn packed(path: &str, data: &[u8]) -> BinaryData {
+        let mut raw = Vec::new();
+        // the buffer size of bin_reader.rs
+        brotli::CompressorWriter::new(&mut raw, 4096, 5, 22)
+            .write_all(data)
+            .unwrap();
+        BinaryData {
+            md5_code: Box::leak(format!("{:x}", md5::compute(data)).into_boxed_str()).as_bytes(),
+            raw: Box::leak(raw.into_boxed_slice()),
+            path: path.to_owned(),
+        }
+    }
+
+    /// A folder of a test, removed when the test ends, however it ends.
+    struct TestDir(PathBuf);
+
+    impl Drop for TestDir {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    /// What the guard is given (P1 in bin_reader.rs): whether a file of the app is in place.
+    #[test]
+    fn a_write_says_whether_the_file_is_in_place() {
+        let dir = TestDir(std::env::temp_dir().join(format!("hjv-packer-{}", std::process::id())));
+        let _ = fs::remove_dir_all(&dir.0);
+        let dir = &dir.0;
+        let exe = packed("./app/HJViewer.exe", b"the new version");
+        // written, with the folders on the way
+        assert!(exe.write_to_file(dir));
+        let written = || fs::read(dir.join("app/HJViewer.exe")).unwrap();
+        assert_eq!(written(), b"the new version");
+        // there already: nothing to write
+        assert!(exe.write_to_file(dir));
+        // another version's file is replaced
+        fs::write(dir.join("app/HJViewer.exe"), b"the old version").unwrap();
+        assert!(exe.write_to_file(dir));
+        assert_eq!(written(), b"the new version");
+        // a file that cannot be replaced (here a folder stands in its place; on Windows a
+        // running app's file) is not in place
+        let held = packed("./held.dll", b"new");
+        fs::create_dir_all(dir.join("held.dll")).unwrap();
+        assert!(!held.write_to_file(dir));
+        // nor one whose folder cannot be made
+        let below = packed("./app/HJViewer.exe/data.bin", b"new");
+        assert!(!below.write_to_file(dir));
+    }
+
+    #[test]
+    fn a_file_that_is_not_in_place_stops_a_pinned_packer() {
+        let args = |args: &[&str]| -> Vec<String> { args.iter().map(|a| a.to_string()).collect() };
+        let (none, update) = (args(&[]), args(&["--update"]));
+        // started by a person, by a double click or with what an app hands over with: the
+        // reason is shown
+        for told in [&none, &args(&["--noinstall"]), &args(&["--install"])] {
+            assert_eq!(unwritten(true, told), Unwritten::Stop { tell: true });
+        }
+        // started by the service's update or a script's install: nothing is shown
+        for quiet in [&update, &args(&["--silent-install", "debug"])] {
+            assert_eq!(unwritten(true, quiet), Unwritten::Stop { tell: false });
+        }
+        // upstream's build goes on, as it always did
+        assert_eq!(unwritten(false, &none), Unwritten::GoOn);
+        assert_eq!(unwritten(false, &update), Unwritten::GoOn);
+        // a file in place is nothing to stop for, pinned or not
+        written(true, &none);
+        written(true, &update);
+    }
+
+    #[test]
+    fn the_process_to_wait_for() {
+        assert_eq!(process_id(Some("4321")), Some(4321));
+        assert_eq!(process_id(Some("4294967295")), Some(u32::MAX));
+        for none in [
+            None,
+            Some(""),
+            Some("0"),
+            Some("-1"),
+            Some("+5"),
+            Some(" 12"),
+            Some("12 "),
+            Some("0x10"),
+            Some("4294967296"),
+            Some("explorer"),
+        ] {
+            assert_eq!(process_id(none), None, "{none:?}");
+        }
+    }
+
+    /// A product text like the others: Korean, no link, nothing of upstream's name.
+    #[test]
+    fn the_text_of_the_box() {
+        assert!(IN_USE.starts_with("HJViewer"));
+        for unwanted in ["http", "www.", "RustDesk", "{", "}"] {
+            assert!(!IN_USE.contains(unwanted), "{unwanted}");
+        }
+        assert_eq!(EXIT_IN_USE, 32);
+    }
+}
