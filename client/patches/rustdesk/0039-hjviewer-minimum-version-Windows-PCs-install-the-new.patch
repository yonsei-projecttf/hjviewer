+    /// Whatever comes in place of the signed package, the installer is not started.
+    #[test]
+    fn only_the_signed_package_is_run() {
+        let data = package_bytes();
+        let size = data.len() as u64;
+        let mut changed = data.clone();
+        changed[75_000] ^= 1;
+        let mut long = data.clone();
+        long.push(0);
+        let cases: [(&str, Vec<u8>, Option<u64>); 7] = [
+            ("one byte changed", changed, Some(size)),
+            ("one byte long", long, None),
+            ("one byte short", data[..data.len() - 1].to_vec(), None),
+            (
+                "other bytes of the signed size",
+                vec![0; data.len()],
+                Some(size),
+            ),
+            ("nothing", Vec::new(), None),
+            // the answer states another length than the policy signed: nothing is read
+            ("another length", data.clone(), Some(size + 1)),
+            ("a page", b"<html>503</html>".to_vec(), Some(16)),
+        ];
+        for (name, sent, length) in cases {
+            let pc = Fake::new("signed", Some(entry(&data, |_| {})), due() + 1, &data);
+            *pc.answer.borrow_mut() = Ok(sent);
+            pc.length.set(length);
+            let mut service = Service::new(&pc, V160, 0);
+            pc.take();
+            service.tick();
+            assert_eq!(
+                pc.take(),
+                [
+                    "idle",
+                    "stage 00000001",
+                    "fetch",
+                    "discard",
+                    "save 0 installs"
+                ],
+                "{name}"
+            );
+            assert_eq!(
+                pc.phases(),
+                ["idle", "downloading", "error verify"],
+                "{name}"
+            );
+            assert!(!pc.folder(1).exists(), "{name}");
+            // and that package is left alone for a day
+            *pc.answer.borrow_mut() = Ok(data.clone());
+            pc.length.set(None);
+            let (seconds, did) = pc.until_tried(&mut service, 90_000);
+            assert_eq!(seconds, 86_400, "{name}");
+            assert_eq!(did.last(), Some(&launch_of(2, 1, &data)), "{name}");
+        }
+    }
