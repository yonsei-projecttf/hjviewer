+        assert!(write_record(&pc.temp.0, Some(&tried)));
+        *pc.idle.borrow_mut() = vec![false];
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        pc.pass(&mut service, 300);
+        assert!(pc.take().iter().all(|did| did == "sessions"));
+        *pc.idle.borrow_mut() = vec![true];
+        let (_, did) = pc.until_done(&mut service, 100);
+        assert_eq!(did.last(), Some(&launch_of(1, 3, &data)));
+        // the server first, which takes its time to answer
+        let pc = Fake::new("count-b", Some(entry(&data, |_| {})), due() + 1, &data);
+        assert!(write_record(&pc.temp.0, Some(&tried)));
+        pc.facts.borrow_mut().as_mut().unwrap().confirmed = Some(40_000);
+        pc.check.set(|facts| facts.checking = true);
+        let mut service = Service::new(&pc, V160, 0);
+        pc.take();
+        pc.pass(&mut service, 30);
+        assert_eq!(pc.take(), ["idle", "check regular"]);
+        {
+            let mut facts = pc.facts.borrow_mut();
+            let facts = facts.as_mut().unwrap();
+            (facts.checking, facts.confirmed) = (false, Some(1));
+        }
+        let (_, did) = pc.until_done(&mut service, 100);
+        assert_eq!(did.last(), Some(&launch_of(1, 3, &data)));
+        // and after the third nothing more
+        let (seconds, did) = pc.until_done(&mut service, 1000);
+        assert_eq!((seconds, did.len()), (600, 2));
+        pc.pass(&mut service, 2 * 86_400);
+        assert_eq!(pc.take(), NOTHING);
+        assert_eq!(pc.job().error, "attempts");
+    }
