+            decide(forced.as_ref(), due + DAY - 1, false),
+            Plan::Install(Mode::Idle)
+        );
+        assert_eq!(
+            decide(forced.as_ref(), due + DAY, false),
+            Plan::Install(Mode::Overdue)
+        );
+        // a rollout alone never goes ahead of sessions
+        let rollout = schedule(&entry(|_| {}), ISSUED, number("1.6.0"), SLOT);
+        let due = AFTER + 2 * DAY + 1000;
+        assert_eq!(decide(rollout.as_ref(), due - 1, false), Plan::Later(due));
+        assert_eq!(
+            decide(rollout.as_ref(), due, false),
+            Plan::Install(Mode::Idle)
+        );
+        assert_eq!(
+            decide(rollout.as_ref(), due + 400 * DAY, false),
+            Plan::Install(Mode::Idle)
+        );
+        // without a time: only when a person asks
+        let unscheduled = schedule(
+            &entry(remove("auto_install_after")),
+            ISSUED,
+            number("1.6.0"),
+            SLOT,
+        );
+        assert_eq!(
+            decide(unscheduled.as_ref(), due + 400 * DAY, false),
+            Plan::Unscheduled
+        );
+        // a person's "now" is before every time
+        for schedule in [&forced, &rollout, &unscheduled] {
+            assert_eq!(decide(schedule.as_ref(), 0, true), Plan::Install(Mode::Now));
+        }
