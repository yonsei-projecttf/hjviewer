+            ("1", 0, 71_030),
+            ("987654321", 1, 14_785),
+            ("100000000", 2, 49_493),
+            ("4", 2, 14_944),
+            ("", 1, 4102),
+            ("hjv-test-pc", 0, 83_143),
+        ] {
+            assert_eq!(slot(id), Slot { ring, spread }, "{id:?}");
+        }
+        // every ring gets its share, and no spread reaches a day
+        let mut rings = [0u32; 3];
+        let (mut least, mut most) = (DAY, 0);
+        for n in 0..3000 {
+            let slot = slot(&format!("{}", 100_000_000 + n * 7919));
+            rings[usize::from(slot.ring)] += 1;
+            assert!((0..DAY).contains(&slot.spread));
+            (least, most) = (least.min(slot.spread), most.max(slot.spread));
+        }
+        assert!(rings.iter().all(|n| (850..=1150).contains(n)), "{rings:?}");
+        assert!(least < DAY / 20 && most > DAY - DAY / 20);
+    }
