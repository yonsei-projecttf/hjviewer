+    #[test]
+    fn a_pc_installs_the_signed_package_when_its_time_has_come() {
+        let data = package_bytes();
+        let pc = Fake::new("time", Some(entry(&data, |_| {})), due() - 30, &data);
+        let mut service = Service::new(&pc, V160, 0);
+        assert_eq!(pc.take(), ["sweep"]);
+        // before its time nothing, whatever the PC is doing
+        pc.pass(&mut service, 25);
+        assert_eq!(pc.take(), NOTHING);
+        assert_eq!(pc.phases(), ["idle"]);
+        // its time: the sessions, the download into a new place, the file closed and read
+        // again, the sessions once more, the policy asked for again, the sessions right before
+        // the start, the try written down, the installer
+        pc.pass(&mut service, 25);
+        assert_eq!(
+            pc.take(),
+            [
+                "idle".to_owned(),
+                "stage 00000001".to_owned(),
+                "fetch".to_owned(),
+                "seal".to_owned(),
+                "idle".to_owned(),
+                "check now".to_owned(),
+                "idle".to_owned(),
+                "save 1 installs".to_owned(),
+                launch_of(1, 1, &data),
+            ]
+        );
+        assert_eq!(pc.phases(), ["downloading", "verifying", "installing"]);
+        let job = pc.job();
+        assert_eq!((job.v.as_str(), job.cred.as_str()), ("1.6.1", "device"));
+        // the request is the device's, signed over the server's time
+        let request = pc.requests.borrow()[0].clone();
+        assert_eq!(
+            request.url,
+            "https://rd.example.com/api/hjv/update/windows/1.6.1"
+        );
+        let t: u64 = request.headers[1].1.parse().unwrap();
+        assert!((due() as u64 - 7..due() as u64 + 13).contains(&t), "{t}");
+        let version = Version::parse("1.6.1").unwrap();
+        let signed = door::device_message(DEVICE_ID, t, PackagePlatform::Windows, &version);
+        let signature = sign::sign_detached(&signed, &secret_key(DEVICE_SEED)).to_bytes();
+        assert_eq!(
+            request.headers,
+            [
+                ("X-HJV-Device", DEVICE_ID.to_owned()),
+                ("X-HJV-Time", t.to_string()),
+                ("X-HJV-Sig", STANDARD.encode(signature)),
+            ]
+        );
+        // from here the new version's installer ends this process; nothing more is tried
+        pc.pass(&mut service, 500);
+        assert_eq!(pc.take(), NOTHING);
+        assert_eq!(pc.record().unwrap().installs, 1);
+    }
