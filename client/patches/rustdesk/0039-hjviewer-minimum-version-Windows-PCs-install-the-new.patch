+        assert_eq!(facts.server_offset, Some(-7));
+        assert_eq!((facts.confirmed, facts.checking), (Some(60), false));
+        // the policy's clock, not the device's: a device a year behind is at the policy's time
+        assert_eq!(core.facts(ISSUED as u64 - 31_536_000, 160).now, ISSUED);
