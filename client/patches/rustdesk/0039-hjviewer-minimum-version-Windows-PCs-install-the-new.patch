diff --git a/src/hjviewer_update/install.rs b/src/hjviewer_update/install.rs
new file mode 100644
index 0000000..20046e7
--- /dev/null
+++ b/src/hjviewer_update/install.rs
@@ -0,0 +1,2840 @@
+//! The update of an installed Windows PC by its service, with nobody at the PC, and the pieces
+//! an app that is not installed updates itself with.
+//!
+//! The service's process (`--server`, SYSTEM) looks every second at the option the main window
+//! signals through, and every twenty at the policy, the clock and its record:
+//! 1. `install_plan` says whether this PC installs now: its time in a rollout has come, it is
+//!    below a minimum whose deadline passed, or a person asked.
+//! 2. Unless a person asked, no session may come in or go out, and the server must have
+//!    confirmed the policy in the last half hour (a policy that withdraws the rollout stops every
+//!    PC that still reaches the server); the service asks it then.
+//! 3. The package comes from door 1 by the device key, into a new file in a new folder that
+//!    only SYSTEM and administrators reach. No file that was there before is ever used.
+//! 4. The file is closed, opened again so that nobody can write, rename or delete it, and read
+//!    through that handle: only the signed size and SHA-256 pass. The handle is held until the
+//!    installer runs.
+//! 5. The file's own version must be the one the policy names for it. The sessions are looked
+//!    at again, and the policy, which the server is asked for once more: the PC must still be
+//!    allowed to install from it (MAY_INSTALL of the trust rules), its package must still be this
+//!    one, and unless a person asked, its time must still have come, the server must have
+//!    confirmed it in the last half hour, and a session that came in while the server was asked
+//!    holds the install up as well. The try is written down; `"<file>" --update` starts as
+//!    SYSTEM, and the new version's own update replaces this process.
+//!
+//! Everything outside this process is behind `Machine`, which `win` implements with the Windows
+//! calls and the tests with a stand-in, so the order above is tested on any platform.
+// elsewhere only the tests use these
+#![cfg_attr(not(windows), allow(dead_code))]
+
+use super::{
+    door::{self, DoorRequest, Failure, PackagePlatform},
+    install_plan::{self as plan, Mode, Plan, Record, Schedule, Sessions, Shown, Signal, Target},
+    policy::{Entry, Package},
+};
+use hbb_common::{log, sodiumoxide::crypto::sign};
+use serde_json::{json, Value};
+use std::{
+    fs::File,
+    io::{Read, Seek, SeekFrom, Write},
+    path::{Path, PathBuf},
+};
+
+/// How long ago the server must have confirmed the policy for the service to install by it.
+const FRESH: u64 = 1800;
+/// How long the service waits for a check it asked for. Once the server has answered since, the
+/// service asks again whenever that answer is older than FRESH at a moment it could install.
+/// After a check that confirmed nothing it leaves the asking to the checking thread, which tries
+/// again by its own rules, goes ahead as soon as one of those tries confirms the policy, and asks
+/// again itself only after that thread's period.
+const CHECK_WAIT: u64 = 40;
+const CHECK_AGAIN: u64 = super::fetch::PERIOD;
+/// How often the service looks at the policy and the clock, and at sessions it waits for.
+const LOOK_EVERY: u64 = 20;
+const SESSIONS_EVERY: u64 = 60;
+/// A process that still runs this long after it started the installer was not replaced.
+const INSTALL_WAIT: u64 = 600;
+/// What a person's signal came to stays in JOB this long, unless something new happens.
+const ANSWER_STAYS: u64 = 600;
+const MAX_RECORD: u64 = 4096;
+
+/// What the service needs of the policy its process holds.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Facts {
+    pub server: String,
+    /// the Windows entry of the policy the PC may install from (MAY_INSTALL of the trust rules:
+    /// the held policy, of the PC's epoch, not below the build's floor, of a key that is not
+    /// revoked; then it is also the one the PC enforces); None while there is none
+    pub entry: Option<Entry>,
+    /// when that policy was issued
+    pub issued: i64,
+    /// the time the policy's deadlines are read by
+    pub now: i64,
+    /// the server's clock minus the device's at the last answer
+    pub server_offset: Option<i64>,
+    /// how many seconds ago the server last confirmed the policy to this process, if it did
+    pub confirmed: Option<u64>,
+    /// a check that was asked for has not ended
+    pub checking: bool,
+}
+
+impl super::Core {
+    pub(super) fn facts(&self, wall: u64, mono: u64) -> Facts {
+        Facts {
+            server: self.server().to_owned(),
+            entry: self.installable_entry().cloned(),
+            issued: self.installable().map_or(0, |policy| policy.issued),
+            now: self.now(wall),
+            server_offset: self.kept.server_offset,
+            confirmed: self.checked.map(|at| mono.saturating_sub(at)),
+            checking: self.checking,
+        }
+    }
+}
+
+/// How an installer that was started is waited for: its exit code, if it ended soon.
+pub(crate) type Started = Box<dyn FnOnce() -> Option<u32>>;
+
+/// What the service's update reaches outside its own rules.
+pub(crate) trait Machine {
+    /// The device's clock and one that only runs forward, in seconds.
+    fn wall(&self) -> u64;
+    fn mono(&self) -> u64;
+    fn pause(&self, seconds: u64);
+    /// A Config2 option of the service, which the main window reads and writes too.
+    fn option(&self, name: &str) -> String;
+    fn set_option(&self, name: &str, value: &str);
+    /// The policy this process holds; None in a build that takes no part.
+    fn facts(&self) -> Option<Facts>;
+    /// Asks for a check of the policy: `now` for one a person or an install waits for.
+    fn check(&self, now: bool);
+    /// No session comes in or goes out.
+    fn idle(&self) -> bool;
+    /// The hour of the day where the PC is.
+    fn hour(&self) -> u32;
+    /// The PC's ID and its device key.
+    fn device(&self) -> Option<(String, sign::SecretKey)>;
+    /// Whether the PC looks bound to an account: for what the main window says, and so that a
+    /// login after a refusal is acted on at once.
+    fn bound(&self) -> bool;
+    fn load(&self) -> Option<Record>;
+    /// Writes the record, or removes it; false when it is not on the disk as asked.
+    fn save(&self, record: Option<&Record>) -> bool;
+    /// Removes what earlier downloads left.
+    fn sweep(&self);
+    /// A new file of this name in a new folder that only SYSTEM and administrators reach, open
+    /// for writing; the path is the one the installer is started by.
+    fn stage(&self, name: &str) -> std::io::Result<(PathBuf, File)>;
+    /// Sends a request to door 1: the length the answer states and its body.
+    fn fetch(&self, request: &DoorRequest) -> Result<(Option<u64>, Box<dyn Read>), Failure>;
+    /// Ends the writing and opens the file for reading, so that nobody can write, rename or
+    /// delete it while the handle that comes back is held.
+    fn seal(&self, path: &Path, file: File) -> std::io::Result<File>;
+    /// Removes a staged file and its folder.
+    fn discard(&self, path: &Path);
+    /// Tells whoever is at the PC that HJViewer closes in `seconds`.
+    fn notice(&self, seconds: u64);
+    /// Starts a command as SYSTEM.
+    fn launch(&self, command: &str) -> std::io::Result<Started>;
+    /// The four numbers of a file's version resource (its fixed part), if it has one.
+    fn file_version(&self, path: &Path) -> Option<[u16; 4]>;
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Stage {
+    Watching,
+    /// a check of the policy was asked for at this time
+    Checking(u64),
+    /// the installer was started at this time
+    Installing(u64),
+}
+
+/// The service's update, one `tick` a second.
+pub(crate) struct Service<M: Machine> {
+    machine: M,
+    /// this build's version, as `get_version_number` counts it
+    current: i64,
+    record: Option<Record>,
+    signals: plan::Signals,
+    /// a person asked, and nothing was done about it yet
+    asked: bool,
+    stage: Stage,
+    /// what JOB says, and the text it says it in
+    shown: Shown,
+    written: String,
+    /// until when JOB keeps the answer to a person's signal
+    answer_until: u64,
+    next_look: u64,
+    /// when the service last asked for a check by itself
+    check_asked: Option<u64>,
+    noted: Option<(String, Plan)>,
+    /// whether the PC looked bound to an account at the last look
+    bound: bool,
+}
+
+fn keep(machine: &impl Machine, written: &str) {
+    // the main window sends its options as a whole and may have put an older text back
+    if machine.option(plan::JOB) != written {
+        machine.set_option(plan::JOB, written);
+    }
+}
+
+/// Whether the file behind `sealed` is the signed package, byte for byte.
+fn holds(sealed: &mut File, package: &Package) -> bool {
+    sealed.seek(SeekFrom::Start(0)).is_ok()
+        && door::receive(sealed, package, &mut std::io::sink(), &mut |_| {}).is_ok()
+}
+
+impl<M: Machine> Service<M> {
+    /// Takes up where the last process of the service left: an installer it started either
+    /// brought this version, or did not. `first_look` seconds pass before the service looks at
+    /// the policy by itself, so that the process's first check, made once the network is up,
+    /// comes first; a person's signal is taken at once.
+    pub(crate) fn new(machine: M, current: i64, first_look: u64) -> Service<M> {
+        let mut record = machine.load();
+        match record.as_mut().map(|record| (record.took(current), record)) {
+            Some((Some(true), done)) => {
+                log::info!("update: {} is installed", done.version);
+                machine.save(None);
+                record = None;
+            }
+            Some((Some(false), failed)) => {
+                log::warn!(
+                    "update: {} is not installed after {} of {} tries",
+                    failed.version,
+                    failed.installs,
+                    plan::MAX_INSTALLS
+                );
+                if failed.error.is_empty() {
+                    failed.install_failed();
+                    machine.save(Some(failed));
+                }
+            }
+            _ => {}
+        }
+        machine.sweep();
+        let signals = plan::Signals::start(&machine.option(plan::NOW));
+        let next_look = machine.mono().saturating_add(first_look);
+        let bound = machine.bound();
+        let mut service = Service {
+            machine,
+            current,
+            record,
+            signals,
+            asked: false,
+            stage: Stage::Watching,
+            shown: Shown::default(),
+            written: String::new(),
+            answer_until: 0,
+            next_look,
+            check_asked: None,
+            noted: None,
+            bound,
+        };
+        service.rest(None);
+        service
+    }
+
+    pub(crate) fn serve(mut self) -> ! {
+        loop {
+            self.tick();
+            self.machine.pause(1);
+        }
+    }
+
+    pub(crate) fn tick(&mut self) {
+        let mono = self.machine.mono();
+        let signal = self.machine.option(plan::NOW);
+        match self.signals.take(&signal, mono) {
+            Signal::None => {}
+            Signal::Taken => {
+                // the window waits until its signal is named
+                self.shown.sig = signal;
+                self.asked = true;
+                self.answer_until = 0;
+                self.machine.check(true);
+                if matches!(self.stage, Stage::Installing(_)) {
+                    self.write();
+                } else {
+                    self.stage = Stage::Checking(mono);
+                    self.say("waiting", "");
+                }
+            }
+            Signal::TooSoon => {
+                self.shown.sig = signal;
+                // one that is being acted on goes on; the window sees how far it is
+                if self.asked || matches!(self.stage, Stage::Installing(_)) {
+                    self.write();
+                } else {
+                    self.say("error", Failure::Busy.code());
+                    self.answer_stays();
+                }
+            }
+        }
+        match self.stage {
+            Stage::Installing(since) if mono.saturating_sub(since) < INSTALL_WAIT => {}
+            Stage::Installing(_) => self.not_installed(),
+            Stage::Checking(since) => {
+                let facts = self.machine.facts();
+                let ended = !facts.as_ref().is_some_and(|facts| facts.checking);
+                if ended || mono.saturating_sub(since) >= CHECK_WAIT {
+                    self.stage = Stage::Watching;
+                    self.look(facts);
+                }
+            }
+            Stage::Watching => {
+                if self.asked || mono >= self.next_look {
+                    self.look(self.machine.facts());
+                }
+            }
+        }
+        keep(&self.machine, &self.written);
+    }
+
+    /// Whether hjv-api hands this PC nothing, as far as the service knows: it said so, or the PC
+    /// is on no account.
+    fn unbound(&self) -> bool {
+        let refused = Failure::Refused.code();
+        self.record.as_ref().is_some_and(|r| r.error == refused) || !self.machine.bound()
+    }
+
+    fn write(&mut self) {
+        let cred = if self.unbound() { "unbound" } else { "device" };
+        self.shown.cred = cred.to_owned();
+        self.written = self.shown.text();
+        keep(&self.machine, &self.written);
+    }
+
+    fn say(&mut self, phase: &str, error: &str) {
+        self.shown.phase = phase.to_owned();
+        self.shown.error = error.to_owned();
+        self.shown.until = 0;
+        self.write();
+    }
+
+    /// Nothing is under way: the window sees why the last try for `target` ended, if it failed.
+    fn rest(&mut self, target: Option<&Target>) {
+        if self.machine.mono() < self.answer_until {
+            return self.write();
+        }
+        let record = self.record.as_ref().zip(target);
+        let error = record
+            .filter(|(record, target)| record.is_of(target))
+            .map(|(record, _)| record.shown_error().to_owned())
+            .unwrap_or_default();
+        self.shown.v = target.map_or(String::new(), |t| t.version.as_str().to_owned());
+        self.say(if error.is_empty() { "idle" } else { "error" }, &error);
+    }
+
+    /// A person's signal that nothing can be done about.
+    fn answer(&mut self, failure: Failure) {
+        self.asked = false;
+        self.say("error", failure.code());
+        self.answer_stays();
+    }
+
+    fn answer_stays(&mut self) {
+        self.answer_until = self.machine.mono().saturating_add(ANSWER_STAYS);
+    }
+
+    /// One line in the log whenever what is planned changes.
+    fn note(&mut self, schedule: Option<&Schedule>, decided: Plan) {
+        let said = schedule.map(|s| (s.target.version.as_str().to_owned(), decided));
+        if said == self.noted {
+            return;
+        }
+        match &said {
+            Some((version, Plan::Later(at))) => {
+                let at = chrono::DateTime::from_timestamp(*at, 0).map(|at| at.to_rfc3339());
+                let at = at.unwrap_or_default();
+                log::info!("update: {version} is installed by this PC itself from {at} on");
+            }
+            Some((version, Plan::Unscheduled)) => {
+                log::info!("update: {version} is there; it is installed when a person asks");
+            }
+            Some((version, Plan::Install(mode))) => {
+                log::info!("update: {version} is to be installed ({mode:?})");
+            }
+            Some((_, Plan::Nothing)) | None => {}
+        }
+        self.noted = said;
+    }
+
+    /// A refusal of hjv-api no longer holds the service back once a login bound the PC.
+    fn bound_since(&mut self) {
+        let was = std::mem::replace(&mut self.bound, self.machine.bound());
+        let newly = self.bound && !was;
+        let Some(record) = self.record.as_mut().filter(|_| newly) else {
+            return;
+        };
+        if record.bound_since_refused() {
+            log::info!(
+                "update: this PC is on an account now; {} is asked for again",
+                record.version
+            );
+            self.machine.save(Some(&*record));
+        }
+    }
+
+    fn look(&mut self, facts: Option<Facts>) {
+        let (wall, mono) = (self.machine.wall(), self.machine.mono());
+        self.next_look = mono.saturating_add(LOOK_EVERY);
+        self.bound_since();
+        let asked = self.asked;
+        let device = self.machine.device();
+        let schedule = facts
+            .as_ref()
+            .zip(device.as_ref())
+            .and_then(|(facts, (id, _))| {
+                let (entry, slot) = (facts.entry.as_ref()?, plan::slot(id));
+                plan::schedule(entry, facts.issued, self.current, slot)
+            });
+        let now = facts.as_ref().map_or(0, |facts| facts.now);
+        let decided = plan::decide(schedule.as_ref(), now, asked);
+        self.note(schedule.as_ref(), decided);
+        let (Some(facts), Some(schedule), Some(device), Plan::Install(mode)) =
+            (facts, schedule, device.as_ref(), decided)
+        else {
+            if !asked {
+                return self.rest(None);
+            }
+            return self.answer(match device {
+                Some(_) => Failure::Missing,
+                None => Failure::Refused,
+            });
+        };
+        let target = schedule.target;
+        let mut record = Record::for_target(self.record.take(), &target);
+        if asked {
+            record.reset();
+        } else {
+            record.settle(wall);
+            if record.hold(wall).is_some() {
+                self.record = Some(record);
+                return self.rest(Some(&target));
+            }
+        }
+        let idle = asked || self.machine.idle();
+        if plan::sessions(mode, idle, self.machine.hour()) == Sessions::Wait {
+            self.record = Some(record);
+            self.next_look = mono.saturating_add(SESSIONS_EVERY);
+            return self.rest(Some(&target));
+        }
+        // by itself the service installs only by a policy the server just confirmed, and asks
+        // the server only when it could install now
+        if !asked && !facts.confirmed.is_some_and(|age| age <= FRESH) {
+            self.record = Some(record);
+            let unanswered = |at: u64| {
+                let since = mono.saturating_sub(at);
+                since < CHECK_AGAIN && !facts.confirmed.is_some_and(|age| age <= since)
+            };
+            if !self.check_asked.is_some_and(unanswered) {
+                self.check_asked = Some(mono);
+                self.machine.check(false);
+                self.stage = Stage::Checking(mono);
+            }
+            return self.rest(Some(&target));
+        }
+        self.asked = false;
+        self.answer_until = 0;
+        self.run(&facts, device, target, mode, record);
+        if mode == Mode::Now && self.stage == Stage::Watching {
+            self.answer_stays();
+        }
+    }
+
+    /// One try: the download, the checks, the start of the installer.
+    fn run(
+        &mut self,
+        facts: &Facts,
+        device: &(String, sign::SecretKey),
+        target: Target,
+        mode: Mode,
+        mut record: Record,
+    ) {
+        let version = target.version.as_str().to_owned();
+        log::info!("update: fetching {version} ({mode:?})");
+        self.shown.v = version.clone();
+        self.say("downloading", "");
+        let staged = self.fetch(facts, device, &target);
+        let wall = self.machine.wall();
+        let whole = matches!(staged, Ok(_) | Err(Failure::Verify | Failure::Version));
+        if mode == Mode::Now && whole {
+            self.signals.fetched_whole(self.machine.mono());
+        }
+        let (path, mut sealed) = match staged {
+            Ok(staged) => staged,
+            Err(failure) => {
+                log::warn!("update: {version} did not come ({})", failure.code());
+                record.download_failed(failure, wall);
+                return self.rested(record, &target);
+            }
+        };
+        let idle = mode == Mode::Now || self.machine.idle();
+        match plan::sessions(mode, idle, self.machine.hour()) {
+            Sessions::Go => {}
+            Sessions::Announce => {
+                log::info!(
+                    "update: {version} installs in {} s, sessions or not",
+                    plan::NOTICE
+                );
+                self.shown.phase = "notice".to_owned();
+                self.shown.until = wall.saturating_add(plan::NOTICE);
+                self.write();
+                self.machine.notice(plan::NOTICE);
+                for _ in 0..plan::NOTICE {
+                    self.machine.pause(1);
+                    keep(&self.machine, &self.written);
+                }
+                // the handle was held all along; the file is read once more before it runs
+                if !holds(&mut sealed, &target.package) {
+                    return self.dropped(sealed, &path, record, &target, Failure::Verify);
+                }
+            }
+            Sessions::Wait => {
+                log::info!("update: a session started; {version} waits");
+                drop(sealed);
+                self.machine.discard(&path);
+                record.put_off(wall, plan::BUSY_WAIT);
+                return self.rested(record, &target);
+            }
+        }
+        // the policy once more, as the server serves it after the download and the warning: a
+        // declaration, a withdrawn package or a stopped rollout published meanwhile stops the
+        // install
+        self.ask_again();
+        let slot = plan::slot(&device.0);
+        let held = self.machine.facts();
+        let still = held.as_ref().is_some_and(|facts| {
+            let Some(entry) = facts.entry.as_ref() else {
+                return false;
+            };
+            let named =
+                entry.latest == target.version && entry.package.as_ref() == Some(&target.package);
+            // unless a person asked, the PC's time must still have come
+            let schedule = plan::schedule(entry, facts.issued, self.current, slot);
+            let decided = plan::decide(schedule.as_ref(), facts.now, false);
+            named && (mode == Mode::Now || matches!(decided, Plan::Install(_)))
+        });
+        // and, as in look(), by a policy the server confirmed in the last half hour: when it did
+        // not answer just now, the next look asks it again
+        let fresh = mode == Mode::Now
+            || held.is_some_and(|facts| facts.confirmed.is_some_and(|age| age <= FRESH));
+        if !still || !fresh {
+            let why = match still {
+                true => "the server did not confirm the policy just now",
+                false => "the policy no longer installs it now",
+            };
+            log::info!("update: {version} is not started: {why}");
+            drop(sealed);
+            self.machine.discard(&path);
+            self.record = Some(record);
+            return self.rest(Some(&target));
+        }
+        // where sessions hold the install up, they are looked at again right before the start:
+        // one that came in while the server was asked holds it up too
+        if mode != Mode::Now && idle && !self.machine.idle() {
+            log::info!("update: a session started; {version} waits");
+            drop(sealed);
+            self.machine.discard(&path);
+            record.put_off(self.machine.wall(), plan::BUSY_WAIT);
+            return self.rested(record, &target);
+        }
+        let Some(command) = path.to_str().and_then(plan::update_command) else {
+            log::error!("update: {} is no path to start", path.display());
+            return self.dropped(sealed, &path, record, &target, Failure::File);
+        };
+        let mut counted = record.clone();
+        counted.install_started(self.machine.wall());
+        // a try that cannot be written down is not made: it would never be counted
+        if !self.machine.save(Some(&counted)) {
+            log::error!("update: the try is not written down, {version} is not started");
+            return self.dropped(sealed, &path, record, &target, Failure::File);
+        }
+        record = counted;
+        log::info!("update: installing {version} (try {})", record.installs);
+        self.say("installing", "");
+        let started = self.machine.launch(&command);
+        // the running installer holds its file itself from here on
+        drop(sealed);
+        let failed = match started {
+            Ok(wait) => wait()
+                .filter(|code| *code != 0)
+                .map(|code| format!("it ended with {code}")),
+            Err(error) => Some(error.to_string()),
+        };
+        match failed {
+            None => {
+                self.record = Some(record);
+                self.stage = Stage::Installing(self.machine.mono());
+            }
+            Some(why) => {
+                log::error!("update: the installer of {version} did not run: {why}");
+                record.install_failed();
+                self.machine.discard(&path);
+                self.rested(record, &target);
+            }
+        }
+    }
+
+    /// A file that was fetched and is not run after all.
+    fn dropped(
+        &mut self,
+        sealed: File,
+        path: &Path,
+        mut record: Record,
+        target: &Target,
+        failure: Failure,
+    ) {
+        drop(sealed);
+        self.machine.discard(path);
+        record.download_failed(failure, self.machine.wall());
+        self.rested(record, target);
+    }
+
+    fn rested(&mut self, record: Record, target: &Target) {
+        if !self.machine.save(Some(&record)) {
+            hbb_common::throttled_log!(
+                std::time::Duration::from_secs(3600),
+                warn,
+                "update: the record of the tries is not written"
+            );
+        }
+        self.record = Some(record);
+        self.rest(Some(target));
+    }
+
+    /// The installer was started INSTALL_WAIT ago and this process is still here.
+    fn not_installed(&mut self) {
+        self.stage = Stage::Watching;
+        let Some(mut record) = self.record.take() else {
+            return;
+        };
+        log::error!(
+            "update: {} is not installed: this process outlived its installer",
+            record.version
+        );
+        record.install_failed();
+        self.machine.sweep();
+        self.machine.save(Some(&record));
+        let error = record.shown_error().to_owned();
+        self.record = Some(record);
+        self.say("error", &error);
+    }
+
+    /// The package in a new, protected file, checked through a handle nobody can write past.
+    fn fetch(
+        &mut self,
+        facts: &Facts,
+        (id, key): &(String, sign::SecretKey),
+        target: &Target,
+    ) -> Result<(PathBuf, File), Failure> {
+        let t = plan::server_time(self.machine.wall(), facts.server_offset);
+        let (windows, version) = (PackagePlatform::Windows, &target.version);
+        let request =
+            door::by_device(&facts.server, windows, version, id, t, key).ok_or(Failure::Refused)?;
+        let name = plan::file_name(version);
+        let (path, mut file) = self.machine.stage(&name).map_err(|error| {
+            log::error!("update: no protected place for the download: {error}");
+            Failure::File
+        })?;
+        let sealed = match self.receive(&request, &target.package, &mut file) {
+            Ok(()) => {
+                self.say("verifying", "");
+                self.machine.seal(&path, file).map_err(|error| {
+                    log::error!("update: the download cannot be opened again: {error}");
+                    Failure::File
+                })
+            }
+            Err(failure) => {
+                drop(file);
+                Err(failure)
+            }
+        };
+        let checked = sealed.and_then(|mut sealed| match holds(&mut sealed, &target.package) {
+            true => Ok(sealed),
+            false => Err(Failure::Verify),
+        });
+        // the signed file must also be the version it is named by
+        let checked = checked.and_then(|sealed| {
+            let found = self.machine.file_version(&path);
+            match plan::file_version_holds(found, &target.version) {
+                true => Ok(sealed),
+                false => {
+                    log::warn!(
+                        "update: the file of {} is version {found:?}",
+                        target.version.as_str()
+                    );
+                    Err(Failure::Version)
+                }
+            }
+        });
+        if checked.is_err() {
+            self.machine.discard(&path);
+        }
+        checked.map(|sealed| (path, sealed))
+    }
+
+    /// Asks the server for the policy and waits for the answer, CHECK_WAIT at most: the policy
+    /// read next is what the server serves by now, if it answered.
+    fn ask_again(&self) {
+        self.machine.check(true);
+        for _ in 0..CHECK_WAIT {
+            if !self.machine.facts().is_some_and(|facts| facts.checking) {
+                return;
+            }
+            self.machine.pause(1);
+            keep(&self.machine, &self.written);
+        }
+    }
+
+    fn receive(
+        &self,
+        request: &DoorRequest,
+        package: &Package,
+        file: &mut File,
+    ) -> Result<(), Failure> {
+        let (length, mut body) = self.machine.fetch(request)?;
+        if length.is_some_and(|length| length != package.size) {
+            return Err(Failure::Verify);
+        }
+        let mut alive = |_| keep(&self.machine, &self.written);
+        door::receive(&mut body, package, file, &mut alive)?;
+        file.sync_all().map_err(|_| Failure::File)
+    }
+}
+
+/// The service's record of its tries, from its file.
+pub(crate) fn read_record(path: &Path) -> Option<Record> {
+    if std::fs::metadata(path).ok()?.len() > MAX_RECORD {
+        return None;
+    }
+    Record::parse(&std::fs::read(path).ok()?)
+}
+
+/// Writes the record by a new file renamed over the old one, or removes it; false when the disk
+/// does not hold what was asked.
+pub(crate) fn write_record(path: &Path, record: Option<&Record>) -> bool {
+    let Some(record) = record else {
+        return match std::fs::remove_file(path) {
+            Ok(()) => true,
+            Err(error) => error.kind() == std::io::ErrorKind::NotFound,
+        };
+    };
+    let mut tmp = path.as_os_str().to_owned();
+    tmp.push(".tmp");
+    let tmp = PathBuf::from(tmp);
+    let write = || -> std::io::Result<()> {
+        if let Some(dir) = path.parent() {
+            std::fs::create_dir_all(dir)?;
+        }
+        std::fs::remove_file(&tmp).ok();
+        let mut file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&tmp)?;
+        file.write_all(&serde_json::to_vec(record).map_err(std::io::Error::other)?)?;
+        file.sync_all()?;
+        drop(file);
+        std::fs::rename(&tmp, path)
+    };
+    write().is_ok()
+}
+
+fn is_folder_name(name: &std::ffi::OsStr) -> bool {
+    name.to_str().is_some_and(|name| {
+        name.len() == 8
+            && name
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    })
+}
+
+fn is_package_name(name: &std::ffi::OsStr) -> bool {
+    name.to_str()
+        .is_some_and(|name| name.starts_with("HJViewer-") && name.ends_with(".exe"))
+}
+
+/// Removes what downloads left under `root`: the package files in the folders this module
+/// makes, and those folders. Nothing else is touched, no link is followed and no folder below
+/// is entered, so that a name planted there cannot send a removal elsewhere.
+pub(crate) fn sweep(root: &Path) {
+    let Ok(folders) = std::fs::read_dir(root) else {
+        return;
+    };
+    for folder in folders.flatten() {
+        // the entry's own kind: a link or junction is neither a folder nor a file here
+        let ours = folder.file_type().is_ok_and(|kind| kind.is_dir());
+        if !ours || !is_folder_name(&folder.file_name()) {
+            continue;
+        }
+        let Ok(files) = std::fs::read_dir(folder.path()) else {
+            continue;
+        };
+        for file in files.flatten() {
+            let ours = file.file_type().is_ok_and(|kind| kind.is_file());
+            if ours && is_package_name(&file.file_name()) {
+                std::fs::remove_file(file.path()).ok();
+            }
+        }
+        std::fs::remove_dir(folder.path()).ok();
+    }
+}
+
+/// Removes a staged file and the folder it had to itself.
+pub(crate) fn discard(path: &Path) {
+    std::fs::remove_file(path).ok();
+    if let Some(folder) = path.parent() {
+        std::fs::remove_dir(folder).ok();
+    }
+}
+
+/// For an app that is not installed: puts a checked download into `folder` under its own name,
+/// in place of whatever has that name there, by `replace`. A file a web page left under the name
+/// before is never the one that stays.
+pub(crate) fn publish(
+    checked: &Path,
+    folder: &Path,
+    replace: &dyn Fn(&Path, &Path) -> std::io::Result<()>,
+) -> Result<PathBuf, Failure> {
+    let to = folder.join(checked.file_name().ok_or(Failure::File)?);
+    replace(checked, &to).map_err(|error| {
+        log::warn!(
+            "update: the package is not in {}: {error}",
+            folder.display()
+        );
+        Failure::File
+    })?;
+    if let Some(folder) = checked.parent() {
+        std::fs::remove_dir(folder).ok();
+    }
+    Ok(to)
+}
+
+/// For an app that is not installed: opens the file a download left, to run it. It must have
+/// the name the app gives the Windows package of `wanted`, and be that package byte for byte,
+/// read through the handle `open` gives, which is held until the file runs.
+pub(crate) fn open_checked(
+    path: &Path,
+    wanted: &door::Plan,
+    open: &dyn Fn(&Path) -> std::io::Result<File>,
+) -> Result<File, Failure> {
+    let name = plan::file_name(&wanted.version);
+    let named = path.file_name().and_then(|name| name.to_str()) == Some(name.as_str());
+    if wanted.platform != PackagePlatform::Windows || !named {
+        return Err(Failure::Verify);
+    }
+    let mut file = open(path).map_err(|_| Failure::File)?;
+    match holds(&mut file, &wanted.package) {
+        true => Ok(file),
+        false => Err(Failure::Verify),
+    }
+}
