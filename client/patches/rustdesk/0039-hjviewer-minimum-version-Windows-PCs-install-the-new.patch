+    #[test]
+    fn a_sweep_removes_downloads_and_nothing_else() {
+        let temp = TempFile::new("sweep", "x");
+        let root = temp.dir().join(FOLDER);
+        let make = |folder: &str, file: &str| {
+            std::fs::create_dir_all(root.join(folder)).unwrap();
+            std::fs::write(root.join(folder).join(file), b"x").unwrap();
+        };
+        make("0ab100ff", "HJViewer-1.6.1.exe");
+        make("12345678", "HJViewer-1.6.0.exe");
+        make("12345678", "HJViewer-1.6.1.exe");
+        // not this module's: another name, another file, a folder below, a file in the root
+        make("Other", "HJViewer-1.6.1.exe");
+        make("0ab100fg", "HJViewer-1.6.1.exe");
+        make("abcdef01", "notes.txt");
+        make("abcdef02/deeper", "HJViewer-1.6.1.exe");
+        std::fs::write(root.join("deadbeef"), b"a file").unwrap();
+        // links named like a download's folder and file, to what is someone else's
+        let elsewhere = temp.dir().join("elsewhere");
+        std::fs::create_dir_all(&elsewhere).unwrap();
+        std::fs::write(elsewhere.join("HJViewer-9.9.9.exe"), b"theirs").unwrap();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::symlink;
+            symlink(&elsewhere, root.join("0000beef")).unwrap();
+            let link = root.join("abcdef01").join("HJViewer-0.0.1.exe");
+            symlink(elsewhere.join("HJViewer-9.9.9.exe"), link).unwrap();
+        }
+        sweep(&root);
+        assert!(!root.join("0ab100ff").exists());
+        assert!(!root.join("12345678").exists());
+        for kept in [
+            "Other/HJViewer-1.6.1.exe",
+            "0ab100fg/HJViewer-1.6.1.exe",
+            "abcdef01/notes.txt",
+            "abcdef02/deeper/HJViewer-1.6.1.exe",
+            "deadbeef",
+        ] {
+            assert!(root.join(kept).exists(), "{kept}");
+        }
+        let theirs = std::fs::read(elsewhere.join("HJViewer-9.9.9.exe")).unwrap();
+        assert_eq!(theirs, b"theirs");
+        // the links themselves are left as they are
+        #[cfg(unix)]
+        for link in ["0000beef", "abcdef01/HJViewer-0.0.1.exe"] {
+            assert!(root.join(link).symlink_metadata().is_ok(), "{link}");
+        }
+        // nothing left of ours, or no folder at all: nothing to do
+        sweep(&root);
+        sweep(&temp.dir().join("none"));
+        // one staged file goes with the folder it had to itself
+        make("0ab100ff", "HJViewer-1.6.1.exe");
+        discard(&root.join("0ab100ff").join("HJViewer-1.6.1.exe"));
+        assert!(!root.join("0ab100ff").exists());
+    }
