+    fn mono(&self) -> u64 {
+        fetch::mono()
+    }
+
+    fn pause(&self, seconds: u64) {
+        std::thread::sleep(Duration::from_secs(seconds));
+    }
+
+    fn option(&self, name: &str) -> String {
+        Config::get_option(name)
+    }
+
+    fn set_option(&self, name: &str, value: &str) {
+        Config::set_option(name.to_owned(), value.to_owned());
+    }
+
+    fn facts(&self) -> Option<Facts> {
+        super::with_core(|core| core.facts(super::wall(), fetch::mono()))
+    }
+
+    fn check(&self, now: bool) {
+        if now {
+            super::check_now();
+        } else {
+            super::request_check(Kind::Regular);
+        }
+    }
+
+    fn idle(&self) -> bool {
+        crate::updater::has_no_active_conns()
+    }
+
+    fn hour(&self) -> u32 {
+        chrono::Timelike::hour(&chrono::Local::now())
+    }
+
+    fn device(&self) -> Option<(String, sign::SecretKey)> {
+        let (secret, _) = Config::get_existing_key_pair()?;
+        Some((Config::get_id(), sign::SecretKey::from_slice(&secret)?))
+    }
+
+    fn bound(&self) -> bool {
+        // what the account module's service shows of the binding
+        plan::bound(&Config::get_option("hjv-pwless-state"))
+    }
+
+    fn load(&self) -> Option<Record> {
+        install::read_record(&Config::path(plan::RECORD_FILE))
+    }
+
+    fn save(&self, record: Option<&Record>) -> bool {
+        install::write_record(&Config::path(plan::RECORD_FILE), record)
+    }
+
+    fn sweep(&self) {
+        // only below a root that is there and is this code's own
+        if let Ok(root) = download_root(false) {
+            install::sweep(&root);
+        }
+    }
+
+    fn stage(&self, name: &str) -> std::io::Result<(PathBuf, File)> {
+        let folder = download_root(true)?.join(plan::folder_name(hbb_common::rand::random()));
+        if !make_protected(&folder)? {
+            return Err(refused("the new folder was there already"));
+        }
+        let staged = check_folder(&folder, true).and_then(|()| {
+            let path = folder.join(name);
+            let file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .share_mode(FILE_SHARE_READ.0)
+                .open(&path)?;
+            Ok((path, file))
+        });
+        if staged.is_err() {
+            std::fs::remove_dir(&folder).ok();
+        }
+        staged
+    }
+
+    fn fetch(&self, request: &DoorRequest) -> Result<(Option<u64>, Box<dyn Read>), Failure> {
+        let response = door::send(request, DOWNLOAD_TIMEOUT)?;
+        Ok((response.content_length(), Box::new(response)))
+    }
+
+    fn seal(&self, path: &Path, file: File) -> std::io::Result<File> {
+        drop(file);
+        open_sealed(path)
+    }
+
+    fn discard(&self, path: &Path) {
+        install::discard(path);
+    }
+
+    fn notice(&self, seconds: u64) {
+        let Some(session) = crate::platform::get_current_process_session_id() else {
+            return;
+        };
+        let title: Vec<u16> = crate::get_app_name().encode_utf16().collect();
+        let text: Vec<u16> = plan::NOTICE_TEXT.encode_utf16().collect();
+        let mut response = 0u32;
+        let shown = unsafe {
+            WTSSendMessageW(
+                std::ptr::null_mut(),
+                session,
+                title.as_ptr(),
+                (title.len() * 2) as u32,
+                text.as_ptr(),
+                (text.len() * 2) as u32,
+                (MB_OK | MB_ICONINFORMATION).0,
+                u32::try_from(seconds).unwrap_or(u32::MAX),
+                &mut response,
+                0,
+            )
+        };
+        if shown == 0 {
+            let error = std::io::Error::last_os_error();
+            log::warn!("update: the warning was not shown: {error}");
+        }
+    }
+
+    fn launch(&self, command: &str) -> std::io::Result<Started> {
+        let session = crate::platform::get_current_process_session_id()
+            .ok_or_else(|| refused("no session"))?;
+        let process = crate::platform::launch_privileged_process(session, command)
+            .map_err(std::io::Error::other)?;
+        if process.is_null() {
+            return Err(refused("the process was not made"));
+        }
+        let process = HANDLE(process as _);
+        Ok(Box::new(move || {
+            let ended = unsafe { WaitForSingleObject(process, LAUNCH_WAIT_MS) } == WAIT_OBJECT_0;
+            let mut code = 0u32;
+            let known = ended && unsafe { GetExitCodeProcess(process, &mut code) }.is_ok();
+            unsafe { CloseHandle(process) }.ok();
+            known.then_some(code)
+        }))
+    }
+
+    fn file_version(&self, path: &Path) -> Option<[u16; 4]> {
+        file_version(path)
+    }
+}
