+/// Starts the service's update, in the process the service itself started on an installed PC:
+/// `--server`, as SYSTEM. Any other process installs nothing.
+pub(super) fn start_service() {
+    static START: Once = Once::new();
+    let service =
+        crate::is_server() && crate::platform::is_installed() && crate::platform::is_root();
+    if !service {
+        return;
+    }
+    START.call_once(|| {
+        let spawned = std::thread::Builder::new()
+            .name("hjv-update-install".to_owned())
+            .spawn(|| install::Service::new(ThisPc, super::current(), FIRST_LOOK).serve());
+        match spawned {
+            Ok(_) => log::info!("update: this PC's service installs new versions"),
+            Err(e) => log::error!("update: the installing thread did not start: {e}"),
+        }
+    });
+}
+
+/// Whether this process is the installed HJViewer itself, not a copy that was only started on a
+/// PC that also has one installed: the update of the installed one is its service's.
+pub(super) fn installed_here() -> bool {
+    static HERE: OnceLock<bool> = OnceLock::new();
+    *HERE.get_or_init(|| {
+        crate::platform::is_installed() && crate::platform::is_cur_exe_the_installed()
+    })
+}
+
+/// The signal this window sent the service, until the service names it.
+static ASKED: Mutex<plan::Asked> = Mutex::new(plan::Asked::new());
+
+fn view() -> View {
+    let job = crate::ui_interface::get_option(plan::JOB);
+    let mut asked = ASKED.lock().unwrap_or_else(|e| e.into_inner());
+    asked.view(&job, fetch::mono())
+}
+
+/// Tells the screen when the service's update moves on. The service's options reach this
+/// process once a second.
+fn watch() {
+    static START: Once = Once::new();
+    START.call_once(|| {
+        let watching = || {
+            let mut last = view();
+            loop {
+                std::thread::sleep(Duration::from_secs(1));
+                let now = view();
+                if now != last {
+                    last = now;
+                    super::notify(None);
+                }
+            }
+        };
+        let spawned = std::thread::Builder::new()
+            .name("hjv-update-watch".to_owned())
+            .spawn(watching);
+        if let Err(e) = spawned {
+            log::error!("update: the watching thread did not start: {e}");
+        }
+    });
+}
+
+/// The state for the screens, where it is the main window of an installed PC.
+pub(super) fn overlay(state: &mut Value) {
+    if installed_here() && !crate::is_server() {
+        install::overlay(state, &view());
+        watch();
+    }
+}
