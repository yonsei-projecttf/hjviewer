+/// A bound PC registers with the access ticket of the lists of its binding (`access`,
+/// server/api/README.md); a list without one, as from an hjv-api without its ticket key, leaves
+/// the one it has.
+#[tokio::test(start_paused = true)]
+async fn a_bound_pc_takes_the_access_ticket_of_its_lists_and_keeps_it_past_one_without() {
+    let _ = hbb_common::sodiumoxide::init();
+    let readme: Answer = serde_json::from_str(
+        r#"{"server_time":1,"state":"active","refresh":120,"send_wol":false,
+            "access":{"ticket":"t1.x","use":"both","exp":2,"server_time":1}}"#,
+    )
+    .unwrap();
+    assert_eq!(readme.access.unwrap()["ticket"], "t1.x");
+
+    let pc = Fake::new("loop-access");
+    let login = unix_now() - 5;
+    let ticket = |t: &str| {
+        serde_json::json!({
+            "ticket": t, "use": "both", "exp": login + 259_200, "server_time": login,
+        })
+    };
+    pc.api().bound = Some((ID.to_owned(), login));
+    pc.api().access = Some(ticket("t1.first"));
+    let _asks = Syncer::spawn(pc.clone());
+    pc.set_option(BIND_REQ, &format!("{ID}.{login}"));
+    pc.set_option(KNOCK, "1");
+    until("the first ticket", || !pc.tickets().is_empty()).await;
+    pc.api().access = None;
+    pc.set_option(KNOCK, "2");
+    until("a list without one", || pc.requests() >= 2).await;
+    pc.api().access = Some(ticket("t1.second"));
+    pc.set_option(KNOCK, "3");
+    until("the second ticket", || {
+        pc.tickets().last() == Some(&Some(ticket("t1.second")))
+    })
+    .await;
+    assert_eq!(
+        pc.tickets(),
+        [Some(ticket("t1.first")), Some(ticket("t1.second"))]
+    );
+    cleanup(&["loop-access"]);
+}
