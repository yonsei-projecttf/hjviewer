+    assert!(login.renew_due(NOW, true));
+    // not a phone, which registers no PC; not what the app's own request brought (the App
+    // Review account's `ctl`), which waits for half its lifetime; not the login's `both`
+    assert!(!login.renew_due(NOW, false));
+    assert!(!Held::issued(&ctl, NOW).unwrap().renew_due(NOW, true));
+    let both = Held {
+        from_login: true,
+        ..held("both", NOW + 86_400, 86_400)
+    };
+    assert!(!both.renew_due(NOW, true));
