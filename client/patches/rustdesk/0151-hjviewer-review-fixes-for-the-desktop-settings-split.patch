+      'HjvDefaultOptionPlace.session',
+      'sessionRows()',
+      'scrollStyle(context)',
+      'trackpadSpeed(context)',
+      'case HjvAdvancedGroup.recording:',
+      'record(context)',
+      'case HjvAdvancedGroup.serviceUpdates:',
+      'service()',
+      'updateRows()',
+      'WaylandCard()',
+      'case HjvAdvancedGroup.security:',
+      'audio(context)',
+      'privacyModeImpl(context)',
+      '_Safety(',
