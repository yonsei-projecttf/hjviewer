 // 1.9.1: the desktop settings' split into the everyday tabs and 고급 설정
-// (common/hjviewer_settings_split.dart), plain Dart without the bridge.
+// (common/hjviewer_settings_split.dart), plain Dart without the bridge; the pages' source, as
+// the bridge keeps a widget test from building them.
+
+/// That each of [calls] is in [source], each first after the one before.
+void expectInOrder(String source, List<String> calls) {
+  final at = [for (final call in calls) source.indexOf(call)];
+  for (var i = 0; i < calls.length; i++) {
+    expect(at[i], isNonNegative, reason: calls[i]);
+    if (i > 0) expect(at[i], greaterThan(at[i - 1]), reason: calls[i]);
+  }
+}
 
 void main() {
+  final page =
+      File('lib/desktop/pages/desktop_setting_page.dart').readAsStringSync();
+  // the page's source from [from] to the next [to]
+  String part(String from, String to) {
+    final start = page.indexOf(from);
+    expect(start, isNonNegative, reason: from);
+    final end = page.indexOf(to, start + from.length);
+    expect(end, isNonNegative, reason: to);
+    return page.substring(start, end);
+  }
+
+  test('고급 설정 is a tab, the Network tab is not; "Change ID" opens 고급 설정', () {
+    final tabs = RegExp(r'^\s*(\w+),', multiLine: true)
+        .allMatches(part('enum SettingsTabKey {', '}'))
+        .map((m) => m[1])
+        .toList();
+    expect(tabs, [
+      'general',
+      'safety',
+      'display',
+      'account',
+      'printer',
+      'advanced',
+      'about'
+    ]);
+    final home =
+        File('lib/desktop/pages/desktop_home_page.dart').readAsStringSync();
+    final start = home.indexOf("translate('Change ID')");
+    expect(start, isNonNegative);
+    expect(home.substring(start, home.indexOf("translate('Settings')", start)),
+        contains('switch2page(SettingsTabKey.advanced)'));
+  });
+
+  test('the General, Security and Display tabs keep the everyday rows', () {
+    final general = part('class _GeneralState', 'mixin _GeneralRows');
+    expectInOrder(general, ['theme()', 'language()', 'other()']);
+    expect(
+        RegExp(r'kOption\w+')
+            .allMatches(
+                part('Widget other() {', 'List<Widget> connectionRows()'))
+            .map((m) => m[0])
+            .toList(),
+        [
+          'kOptionEnableConfirmClosingTabs',
+          'kOptionOpenNewConnInTabs',
+          'kOptionKeepAwakeDuringOutgoingSessions',
+        ]);
+    final security = part('class _SafetyState', 'Widget _advanced(');
+    expectInOrder(
+        security, ['password(context)', 'more(context)', 'hjvIncomingRow(']);
+    // the Security card: the automatic disconnect and the window rule
+    final more =
+        part('Widget more(BuildContext context) {', 'Widget moreAdvanced(');
+    expect(more, contains('...autoDisconnect(context)'));
+    expect('_OptionCheckBox('.allMatches(more).length, 1);
+    expect(more, contains("'allow-only-conn-window-open'"));
+    final display = part('class _DisplayState', 'mixin _DisplayRows');
+    expectInOrder(display, [
+      'viewStyle(context)',
+      'imageQuality(context)',
+      'otherDefaults(context)',
+    ]);
+    for (final call in [
+      'service()',
+      'hwcodec()',
+      'audio(context)',
+      'record(context)',
+      'WaylandCard()',
+      'scrollStyle(',
+      'codec(',
+      'customImageQuality(',
+      'trackpadSpeed(',
+      'privacyModeImpl(',
+      'permissions(',
+      'moreAdvanced(',
+      'numericOneTimePassword(',
+      'tfa()',
+      'changeId()',
+    ]) {
+      for (final (tab, source) in [
+        ('General', general),
+        ('Security', security),
+        ('Display', display),
+      ]) {
+        expect(source, isNot(contains(call)), reason: '$tab: $call');
+      }
+    }
+  });
+
   test('고급 설정 shows its groups in the decided order', () {
     expect(HjvAdvancedGroup.values, [
       HjvAdvancedGroup.connection,
       HjvAdvancedGroup.displayPerformance,
       HjvAdvancedGroup.sessionDefaults,
       HjvAdvancedGroup.recording,
