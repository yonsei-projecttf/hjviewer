+        part('Widget _advanced(BuildContext context) {', 'Widget tfa()'), [
+      "'Unlock Security Settings'",
+      'permissions(context)',
+      'moreAdvanced(context)',
+      'tfa()',
+      'changeId()',
     ]);
   });
 
