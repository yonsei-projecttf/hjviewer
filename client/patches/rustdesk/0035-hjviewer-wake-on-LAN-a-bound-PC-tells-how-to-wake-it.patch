+/// `--hjv-e2e-wol-report`: one sync of this PC's binding that carries `report` whole, signed and
+/// sent as the sync task's are. The answer's status, or why there is none.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) async fn send_wol_report(
+    report: &crate::hjviewer_wol::Report,
+) -> Result<u16, &'static str> {
+    if !enabled() {
+        return Err("not an account build");
+    }
+    let service = ThisPc::new();
+    let s = service.clone();
+    let (binding, off) = blocking(move || {
+        let pc = s.pc();
+        (pc.binding(), pc.off())
+    })
+    .await
+    .ok_or("task")?;
+    let binding = binding.ok_or("not bound")?;
+    let hash = crate::hjviewer_wol::report_hash(report);
+    let p = payload(
+        &binding,
+        crate::VERSION,
+        off,
+        &[],
+        Refused::default(),
+        &hash,
+        Some(report),
+    );
+    let (pc_id, sk, _) = service.device();
+    let key = sign::SecretKey::from_slice(&sk);
+    let exchanged = exchange(service, key, pc_id, p, 0).await;
+    exchanged.reply.map(|(status, _, _)| status)
+}
