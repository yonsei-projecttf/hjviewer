@@ -0,0 +1,657 @@
+//! Wake-on-LAN, the PC's part (design v3 8-2): what a bound, installed Windows PC tells hjv-api
+//! about waking it, inside its sync (hjviewer_account/pc.rs), and the ten minutes it stays awake
+//! after a resume. The PC reports facts; hjv-api judges them, and no app ever gets the MAC.
+//!
+//! A card goes in the report when default-net sees it with a MAC and an IPv4 address and its
+//! network class key says physical (NCF_PHYSICAL) 802.3 (*PhysicalMediaType 14). Its key is the
+//! one whose NetCfgInstanceId is the adapter's GUID, as a card no longer there leaves a key with
+//! the same description. That leaves out the kernel debug, Hyper-V, Bluetooth, VPN and WAN
+//! miniport adapters and Wi-Fi; a USB card stays, as `bus` "usb", which seldom wakes a PC.
+//!
+//! The matching, the report and its summary are pure, for the tests on every platform;
+//! collecting is Windows only and blocking (the registry, SendARP inside default-net, powrprof).
+// elsewhere only the tests and the E2E command build a report
+#![cfg_attr(not(windows), allow(dead_code))]
+
+use hbb_common::{log, tokio};
+use serde_derive::Serialize;
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    net::Ipv4Addr,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+/// The collector looks every LOOK, the first time LOOK after the service starts, and while the
+/// PC is bound collects once the last report is EVERY old.
+const LOOK: Duration = Duration::from_secs(60);
+const EVERY: Duration = Duration::from_secs(600);
+/// How long the PC stays awake after a resume: Windows sends a PC that woke with nobody at it
+/// back to sleep within minutes, before whoever woke it over the network has connected.
+#[cfg(any(windows, test))]
+const AWAKE: Duration = Duration::from_secs(600);
+const NCF_PHYSICAL: u32 = 0x4;
+/// NdisPhysicalMedium802_3
+const MEDIUM_802_3: u32 = 14;
+/// With these a report stays far below the sync's 16 KiB for the values registries have; one
+/// that would not fit, its values escaped twice on the way, the sync task holds back (pc.rs).
+const MAX_ADAPTERS: usize = 4;
+const MAX_ADDRESSES: usize = 4;
+const MAX_TEXT: usize = 64;
+
+/// An adapter as default-net sees it.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct Nic {
+    /// AdapterName: the GUID its class key has as NetCfgInstanceId
+    pub guid: String,
+    /// the adapter's description, which names it in Windows' list of wake-armed devices
+    pub desc: String,
+    pub mac: [u8; 6],
+    pub ipv4: Vec<(Ipv4Addr, u8)>,
+    pub gateway: Option<Ipv4Addr>,
+    pub gateway_mac: Option<[u8; 6]>,
+    /// bits per second
+    pub link: Option<u64>,
+}
+
+/// The values the report reads of one numbered network class key, as text (a DWORD in decimal).
+pub(crate) type ClassKey = BTreeMap<String, String>;
+
+/// What this PC reports, the sync's `wol` (design v3 8-2).
+#[derive(Serialize, Debug, Clone, PartialEq)]
+pub(crate) struct Report {
+    v: u32,
+    adapters: Vec<Adapter>,
+    power: Power,
+    /// left out of the summary, which would change at every collection otherwise
+    #[serde(skip_serializing_if = "Option::is_none")]
+    uptime_s: Option<u64>,
+}
+
+#[derive(Serialize, Debug, Clone, PartialEq)]
+struct Adapter {
+    mac: String,
+    ipv4: Vec<String>,
+    gateway: Option<String>,
+    gateway_mac: Option<String>,
+    desc: String,
+    bus: Option<String>,
+    link_mbps: Option<u64>,
+    driver: Driver,
+    wake: Wake,
+    /// the device may wake the PC (Device Manager's "Allow this device to wake the computer"),
+    /// None when Windows did not say
+    armed: Option<bool>,
+}
+
+#[derive(Serialize, Debug, Clone, PartialEq)]
+struct Driver {
+    provider: Option<String>,
+    version: Option<String>,
+    date: Option<String>,
+}
+
+/// The driver's wake keywords as the registry has them.
+#[derive(Serialize, Debug, Clone, PartialEq)]
+struct Wake {
+    magic: Option<String>,
+    pattern: Option<String>,
+    ms_magic: Option<String>,
+    s5: Option<String>,
+    shutdown_speed: Option<String>,
+    eee: Option<String>,
+    green: Option<String>,
+}
+
+/// The sleep states, the hibernation file, modern standby, fast startup and mains power, None
+/// where Windows did not say.
+#[derive(Serialize, Debug, Clone, Default, PartialEq)]
+pub(crate) struct Power {
+    pub s3: Option<bool>,
+    pub s4: Option<bool>,
+    pub s5: Option<bool>,
+    pub hiberfile: Option<bool>,
+    pub aoac: Option<bool>,
+    pub fast_startup: Option<bool>,
+    pub on_ac: Option<bool>,
+}
+
+/// The report of the adapters default-net sees (`nics`) by the network class keys, with the
+/// names of the devices armed to wake the PC (None: unknown), the power facts and the uptime.
+pub(crate) fn build(
+    nics: &[Nic],
+    class: &[ClassKey],
+    armed: Option<&[String]>,
+    power: Power,
+    uptime_s: Option<u64>,
+) -> Report {
+    Report {
+        v: 1,
+        adapters: nics
+            .iter()
+            .filter_map(|nic| wired(nic, class, armed))
+            .take(MAX_ADAPTERS)
+            .collect(),
+        power,
+        uptime_s,
+    }
+}
+
+/// `nic` as the report has it, if it is a physical wired card with an address.
+fn wired(nic: &Nic, class: &[ClassKey], armed: Option<&[String]>) -> Option<Adapter> {
+    if nic.mac == [0; 6] || nic.ipv4.is_empty() {
+        return None;
+    }
+    let key = class.iter().find(|key| {
+        key.get("NetCfgInstanceId")
+            .is_some_and(|guid| guid.eq_ignore_ascii_case(&nic.guid))
+    })?;
+    let number = |name: &str| key.get(name)?.trim().parse::<u32>().ok();
+    if number("Characteristics")? & NCF_PHYSICAL == 0
+        || number("*PhysicalMediaType")? != MEDIUM_802_3
+    {
+        return None;
+    }
+    let text = |name: &str| key.get(name).map(|v| clip(v));
+    Some(Adapter {
+        mac: mac_text(&nic.mac),
+        ipv4: nic
+            .ipv4
+            .iter()
+            .take(MAX_ADDRESSES)
+            .map(|(ip, prefix)| format!("{ip}/{prefix}"))
+            .collect(),
+        gateway: nic.gateway.map(|ip| ip.to_string()),
+        gateway_mac: nic
+            .gateway_mac
+            .filter(|mac| *mac != [0; 6])
+            .map(|mac| mac_text(&mac)),
+        desc: text("DriverDesc").unwrap_or_else(|| clip(&nic.desc)),
+        bus: key.get("MatchingDeviceId").and_then(|id| bus(id)),
+        link_mbps: nic
+            .link
+            .filter(|bps| *bps > 0 && *bps != u64::MAX)
+            .map(|bps| bps / 1_000_000),
+        driver: Driver {
+            provider: text("ProviderName"),
+            version: text("DriverVersion"),
+            date: text("DriverDate"),
+        },
+        wake: Wake {
+            magic: text("*WakeOnMagicPacket"),
+            pattern: text("*WakeOnPattern"),
+            ms_magic: text("*ModernStandbyWoLMagicPacket"),
+            s5: text("S5WakeOnLan"),
+            shutdown_speed: text("WolShutdownLinkSpeed"),
+            eee: text("*EEE"),
+            green: text("EnableGreenEthernet"),
+        },
+        armed: armed.map(|names| {
+            names
+                .iter()
+                .any(|name| name.eq_ignore_ascii_case(&nic.desc))
+        }),
+    })
+}
+
+/// The bus of a MatchingDeviceId's enumerator: `PCI\VEN_…` is "pci", `USB\VID_…` "usb".
+fn bus(id: &str) -> Option<String> {
+    let (enumerator, _) = id.split_once('\\')?;
+    (!enumerator.is_empty()
+        && enumerator.len() <= 16
+        && enumerator.bytes().all(|b| b.is_ascii_alphanumeric()))
+    .then(|| enumerator.to_ascii_lowercase())
+}
+
+fn mac_text(mac: &[u8; 6]) -> String {
+    mac.iter()
+        .map(|b| format!("{b:02x}"))
+        .collect::<Vec<_>>()
+        .join(":")
+}
+
+fn clip(text: &str) -> String {
+    text.chars().take(MAX_TEXT).collect()
+}
+
+/// The report's summary, the sync's `wol_hash`: SHA-256 in hex of its JSON without `uptime_s`.
+pub(crate) fn report_hash(report: &Report) -> String {
+    let lasting = Report {
+        uptime_s: None,
+        ..report.clone()
+    };
+    // strings, numbers and booleans always serialize
+    hex::encode(Sha256::digest(
+        serde_json::to_vec(&lasting).unwrap_or_default(),
+    ))
+}
+
+/// This PC's report, collected now: Windows only, and blocking. None elsewhere and when the
+/// network class keys cannot be read.
+pub(crate) fn report() -> Option<Report> {
+    #[cfg(windows)]
+    {
+        os::report()
+    }
+    #[cfg(not(windows))]
+    {
+        None
+    }
+}
+
+/// The latest report and its summary, as the collector keeps them.
+pub(crate) type Latest = Arc<Mutex<Option<(Report, String)>>>;
+
+/// What the sync task carries of this PC's report: the summary in every sync of its binding, and
+/// the whole report until a sync of that binding that carried it got a 200, and again when
+/// hjv-api asks for it (`send_wol`).
+#[derive(Default)]
+pub(crate) struct Carry {
+    latest: Latest,
+    /// the binding and the summary of the report hjv-api took
+    taken: Option<(String, String)>,
+    /// the last 200's send_wol
+    asked: bool,
+}
+
+impl Carry {
+    pub(crate) fn latest(&self) -> Latest {
+        self.latest.clone()
+    }
+
+    /// A sync of `binding`: its `wol_hash`, empty without a report, and the report if it goes.
+    pub(crate) fn part(&self, binding: &str) -> (String, Option<Report>) {
+        let latest = self.latest.lock().unwrap();
+        let Some((report, hash)) = latest.as_ref() else {
+            return (String::new(), None);
+        };
+        let taken = self
+            .taken
+            .as_ref()
+            .is_some_and(|(b, h)| b == binding && h == hash);
+        (hash.clone(), (self.asked || !taken).then(|| report.clone()))
+    }
+
+    /// The answer `status`, with hjv-api's `send_wol`, to a sync of `binding` that carried the
+    /// report with the summary `carried`.
+    pub(crate) fn answered(
+        &mut self,
+        binding: &str,
+        carried: Option<&str>,
+        status: u16,
+        send_wol: bool,
+    ) {
+        if status != 200 {
+            return;
+        }
+        if let Some(hash) = carried {
+            self.taken = Some((binding.to_owned(), hash.to_owned()));
+        }
+        self.asked = send_wol;
+    }
+}
+
+/// The sync task's collector. `bound_report` runs in spawn_blocking: None while the PC is not
+/// bound, which sends nothing, else its report if there is one.
+pub(crate) async fn collect<F>(latest: Latest, bound_report: F)
+where
+    F: Fn() -> Option<Option<Report>> + Clone + Send + 'static,
+{
+    let mut last: Option<tokio::time::Instant> = None;
+    loop {
+        tokio::time::sleep(LOOK).await;
+        if last.is_some_and(|t| t.elapsed() < EVERY) {
+            continue;
+        }
+        let collected = match tokio::task::spawn_blocking(bound_report.clone()).await {
+            Ok(None) => continue,
+            Ok(Some(collected)) => collected,
+            // collecting panicked: again when the next one is due
+            Err(_) => None,
+        };
+        last = Some(tokio::time::Instant::now());
+        let Some(report) = collected else {
+            continue;
+        };
+        let hash = report_hash(&report);
+        let mut latest = latest.lock().unwrap();
+        if latest.as_ref().map(|(_, h)| h) != Some(&hash) {
+            log::info!(
+                "hjv: wake-on-LAN report: {} wired card(s)",
+                report.adapters.len()
+            );
+        }
+        *latest = Some((report, hash));
+    }
+}
+
+/// When the hold of the PC's power ends.
+#[cfg(windows)]
+static HOLD: Mutex<Option<std::time::Instant>> = Mutex::new(None);
+
+/// After a resume: the PC does not go to sleep by itself for AWAKE, and a resume meanwhile
+/// extends that. Sleep that someone asks for (the power button, the lid, the Start menu) still
+/// goes ahead. Windows only.
+pub(crate) fn hold_awake() {
+    #[cfg(windows)]
+    if extend(&mut HOLD.lock().unwrap(), std::time::Instant::now()) {
+        // Windows ties the request to the thread that made it, so one thread holds it throughout
+        if let Err(err) = std::thread::Builder::new()
+            .name("hjv-awake".to_owned())
+            .spawn(os::hold)
+        {
+            HOLD.lock().unwrap().take();
+            log::warn!("hjv: could not stay awake after the resume: {err}");
+        }
+    }
+}
+
+/// A resume at `now` holds the power until AWAKE from then, or later if the hold runs longer
+/// already. Whether a holder has to start.
+#[cfg(any(windows, test))]
+fn extend(until: &mut Option<std::time::Instant>, now: std::time::Instant) -> bool {
+    let start = until.is_none();
+    let end = now + AWAKE;
+    *until = Some(until.map_or(end, |u| u.max(end)));
+    start
+}
+
+/// How long the hold still lasts at `now`; at its end it is over, and the next resume starts a
+/// new holder.
+#[cfg(any(windows, test))]
+fn remaining(until: &mut Option<std::time::Instant>, now: std::time::Instant) -> Option<Duration> {
+    match *until {
+        Some(end) if end > now => Some(end - now),
+        _ => {
+            *until = None;
+            None
+        }
+    }
+}
+
+/// An adapter as the report reads it.
+#[cfg(any(windows, test))]
+fn nic(iface: &default_net::Interface) -> Nic {
+    Nic {
+        guid: iface.name.clone(),
+        desc: iface.description.clone().unwrap_or_default(),
+        mac: iface.mac_addr.as_ref().map_or([0; 6], |mac| mac.octets()),
+        ipv4: iface
+            .ipv4
+            .iter()
+            .map(|net| (net.addr, net.prefix_len))
+            .collect(),
+        gateway: iface.gateway.as_ref().and_then(|g| match g.ip_addr {
+            std::net::IpAddr::V4(ip) => Some(ip),
+            std::net::IpAddr::V6(_) => None,
+        }),
+        gateway_mac: iface.gateway.as_ref().map(|g| g.mac_addr.octets()),
+        link: iface.transmit_speed,
+    }
+}
+
+#[cfg(windows)]
+mod os {
+    use super::{build, nic, remaining, ClassKey, Power, Report, HOLD};
+    use hbb_common::log;
+    use std::time::{Duration, Instant};
+    use windows::Win32::System::{
+        Power::{
+            DevicePowerClose, DevicePowerEnumDevices, DevicePowerOpen, GetPwrCapabilities,
+            GetSystemPowerStatus, SetThreadExecutionState, DEVICEPOWER_FILTER_DEVICES_PRESENT,
+            DEVICEPOWER_FILTER_HARDWARE, DEVICEPOWER_FILTER_WAKEENABLED, ES_CONTINUOUS,
+            ES_SYSTEM_REQUIRED, PDCAP_WAKE_FROM_S0_SUPPORTED, PDCAP_WAKE_FROM_S1_SUPPORTED,
+            PDCAP_WAKE_FROM_S2_SUPPORTED, PDCAP_WAKE_FROM_S3_SUPPORTED, SYSTEM_POWER_CAPABILITIES,
+            SYSTEM_POWER_STATUS,
+        },
+        SystemInformation::GetTickCount64,
+    };
+    use winreg::{enums::*, types::FromRegValue, RegKey, RegValue};
+
+    /// The network adapters' class key.
+    const NET_CLASS: &str =
+        r"SYSTEM\CurrentControlSet\Control\Class\{4d36e972-e325-11ce-bfc1-08002be10318}";
+    /// What the report reads of a class key.
+    const VALUES: [&str; 15] = [
+        "NetCfgInstanceId",
+        "Characteristics",
+        "*PhysicalMediaType",
+        "MatchingDeviceId",
+        "DriverDesc",
+        "ProviderName",
+        "DriverVersion",
+        "DriverDate",
+        "*WakeOnMagicPacket",
+        "*WakeOnPattern",
+        "*ModernStandbyWoLMagicPacket",
+        "S5WakeOnLan",
+        "WolShutdownLinkSpeed",
+        "*EEE",
+        "EnableGreenEthernet",
+    ];
+
+    pub(super) fn report() -> Option<Report> {
+        let class = match class_keys() {
+            Ok(class) => class,
+            Err(err) => {
+                hbb_common::throttled_log!(
+                    Duration::from_secs(3600),
+                    warn,
+                    "hjv: wake-on-LAN report: the network class keys: {err}"
+                );
+                return None;
+            }
+        };
+        let nics: Vec<_> = default_net::get_interfaces().iter().map(nic).collect();
+        let uptime = unsafe { GetTickCount64() } / 1000;
+        Some(build(
+            &nics,
+            &class,
+            armed().as_deref(),
+            power(),
+            Some(uptime),
+        ))
+    }
+
+    fn class_keys() -> std::io::Result<Vec<ClassKey>> {
+        let class =
+            RegKey::predef(HKEY_LOCAL_MACHINE).open_subkey_with_flags(NET_CLASS, KEY_READ)?;
+        let mut keys = Vec::new();
+        for name in class.enum_keys().flatten() {
+            // the adapters' keys are numbered; the others ("Properties") are not adapters
+            if name.len() != 4 || !name.bytes().all(|b| b.is_ascii_digit()) {
+                continue;
+            }
+            let Ok(key) = class.open_subkey_with_flags(&name, KEY_READ) else {
+                continue;
+            };
+            keys.push(
+                VALUES
+                    .iter()
+                    .filter_map(|v| Some((v.to_string(), text(&key.get_raw_value(v).ok()?)?)))
+                    .collect(),
+            );
+        }
+        Ok(keys)
+    }
+
+    fn text(value: &RegValue) -> Option<String> {
+        match value.vtype {
+            REG_SZ | REG_EXPAND_SZ => String::from_reg_value(value).ok(),
+            REG_DWORD => u32::from_reg_value(value).ok().map(|v| v.to_string()),
+            _ => None,
+        }
+    }
+
+    /// The present devices armed to wake the PC, by the names `powercfg /devicequery
+    /// wake_armed` lists: a network card's is its adapter description.
+    fn armed() -> Option<Vec<String>> {
+        let filter = DEVICEPOWER_FILTER_DEVICES_PRESENT
+            | DEVICEPOWER_FILTER_HARDWARE
+            | DEVICEPOWER_FILTER_WAKEENABLED;
+        let wakes = PDCAP_WAKE_FROM_S0_SUPPORTED
+            | PDCAP_WAKE_FROM_S1_SUPPORTED
+            | PDCAP_WAKE_FROM_S2_SUPPORTED
+            | PDCAP_WAKE_FROM_S3_SUPPORTED;
+        if !unsafe { DevicePowerOpen(None) } {
+            return None;
+        }
+        let mut names = Vec::new();
+        for index in 0..1024 {
+            let mut name = [0u16; 512];
+            let mut size = (name.len() * 2) as u32;
+            let found = unsafe {
+                DevicePowerEnumDevices(
+                    index,
+                    filter,
+                    wakes.0,
+                    Some(name.as_mut_ptr().cast()),
+                    &mut size,
+                )
+            };
+            if !found {
+                break;
+            }
+            let len = name.iter().position(|c| *c == 0).unwrap_or(name.len());
+            names.push(String::from_utf16_lossy(&name[..len]));
+        }
+        unsafe { DevicePowerClose() };
+        Some(names)
+    }
+
+    fn power() -> Power {
+        let mut caps = SYSTEM_POWER_CAPABILITIES::default();
+        let caps = unsafe { GetPwrCapabilities(&mut caps) }.then_some(caps);
+        let mut status = SYSTEM_POWER_STATUS::default();
+        let known = unsafe { GetSystemPowerStatus(&mut status) }.is_ok();
+        let on_ac = match status.ACLineStatus {
+            0 if known => Some(false),
+            1 if known => Some(true),
+            _ => None,
+        };
+        Power {
+            s3: caps.map(|c| c.SystemS3),
+            s4: caps.map(|c| c.SystemS4),
+            s5: caps.map(|c| c.SystemS5),
+            hiberfile: caps.map(|c| c.HiberFilePresent),
+            aoac: caps.map(|c| c.AoAc),
+            fast_startup: fast_startup(),
+            on_ac,
+        }
+    }
+
+    /// Fast startup, which turns a shutdown into a hibernation the network card does not wake
+    /// from: on where a policy requires it, else as the PC is set.
+    fn fast_startup() -> Option<bool> {
+        let hklm = RegKey::predef(HKEY_LOCAL_MACHINE);
+        let value = |path: &str| {
+            hklm.open_subkey_with_flags(path, KEY_READ)
+                .ok()?
+                .get_value::<u32, _>("HiberbootEnabled")
+                .ok()
+        };
+        if value(r"SOFTWARE\Policies\Microsoft\Windows\System") == Some(1) {
+            return Some(true);
+        }
+        value(r"SYSTEM\CurrentControlSet\Control\Session Manager\Power").map(|v| v == 1)
+    }
+
+    /// The holder: asks Windows to keep the system up (ES_SYSTEM_REQUIRED) while the hold lasts.
+    pub(super) fn hold() {
+        if unsafe { SetThreadExecutionState(ES_CONTINUOUS | ES_SYSTEM_REQUIRED) }.0 == 0 {
+            HOLD.lock().unwrap().take();
+            log::warn!("hjv: could not ask Windows to stay awake after the resume");
+            return;
+        }
+        log::info!("hjv: resumed: staying awake for ten minutes");
+        loop {
+            let left = remaining(&mut HOLD.lock().unwrap(), Instant::now());
+            match left {
+                Some(left) => std::thread::sleep(left.min(Duration::from_secs(60))),
+                None => break,
+            }
+        }
+        unsafe { SetThreadExecutionState(ES_CONTINUOUS) };
+    }
+}
+
+/// `--hjv-e2e-wol-report <mac> <ipv4/prefix> <gateway>` (design v3 8-10): one sync of this PC's
+/// binding that carries the report of one wired card with these values, signed and sent as the
+/// sync task's are. Whether hjv-api took it.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) fn e2e_report(mac: &str, ipv4: &str, gateway: &str) -> bool {
+    let Some(report) = wakeable(mac, ipv4, gateway) else {
+        eprintln!(
+            "hjv-e2e: usage: --hjv-e2e-wol-report <aa:bb:cc:dd:ee:ff> <a.b.c.d/prefix> <gateway>"
+        );
+        return false;
+    };
+    match e2e_send(report) {
+        Ok(200) => {
+            println!("hjv-e2e: wol report taken");
+            true
+        }
+        Ok(status) => {
+            eprintln!("hjv-e2e: wol report: status {status}");
+            false
+        }
+        Err(why) => {
+            eprintln!("hjv-e2e: wol report: {why}");
+            false
+        }
+    }
+}
+
+#[cfg(feature = "hjv-e2e")]
+#[tokio::main(flavor = "current_thread")]
+async fn e2e_send(report: Report) -> Result<u16, &'static str> {
+    crate::hjviewer_account::send_wol_report(&report).await
+}
+
+/// The report of a PC that can be woken, with one wired card of these values.
+#[cfg(any(feature = "hjv-e2e", test))]
+pub(crate) fn wakeable(mac: &str, ipv4: &str, gateway: &str) -> Option<Report> {
+    const GUID: &str = "{00000000-0000-0000-0000-00000000e2e0}";
+    const DESC: &str = "hjv-e2e wired card";
+    let octets: Vec<u8> = mac
+        .split(':')
+        .map(|b| u8::from_str_radix(b, 16).ok().filter(|_| b.len() == 2))
+        .collect::<Option<_>>()?;
+    let (ip, prefix) = ipv4.split_once('/')?;
+    let nic = Nic {
+        guid: GUID.to_owned(),
+        desc: DESC.to_owned(),
+        mac: octets.try_into().ok()?,
+        ipv4: vec![(ip.parse().ok()?, prefix.parse().ok().filter(|p| *p <= 32)?)],
+        gateway: Some(gateway.parse().ok()?),
+        gateway_mac: None,
+        link: Some(1_000_000_000),
+    };
+    let key: ClassKey = [
+        ("NetCfgInstanceId", GUID),
+        ("Characteristics", "4"),
+        ("*PhysicalMediaType", "14"),
+        ("MatchingDeviceId", r"PCI\HJV_E2E"),
+        ("DriverDesc", DESC),
+        ("*WakeOnMagicPacket", "1"),
+        ("*WakeOnPattern", "1"),
+        ("S5WakeOnLan", "1"),
+    ]
+    .into_iter()
+    .map(|(k, v)| (k.to_owned(), v.to_owned()))
+    .collect();
+    let power = Power {
+        s3: Some(true),
+        s4: Some(true),
+        s5: Some(true),
+        hiberfile: Some(true),
+        aoac: Some(false),
+        fast_startup: Some(false),
+        on_ac: Some(true),
+    };
+    Some(build(&[nic], &[key], Some(&[DESC.to_owned()]), power, None))
+}
