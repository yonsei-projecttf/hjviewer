+#[tokio::test(start_paused = true)]
+async fn only_a_bound_pc_tells_how_to_wake_it_whole_once_and_when_asked() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pc = Fake::new("loop-wol");
+    let login = unix_now() - 5;
+    {
+        let mut api = pc.api();
+        api.bound = Some((ID.to_owned(), login));
+        api.refresh = 5;
+    }
+    let report =
+        crate::hjviewer_wol::wakeable("00:00:5e:00:53:10", "192.0.2.67/24", "192.0.2.1").unwrap();
+    let hash = crate::hjviewer_wol::report_hash(&report);
+    *pc.wol.lock().unwrap() = Some(report.clone());
+    let _asks = Syncer::spawn(pc.clone());
+    // an unbound PC sends nothing, past the first collection, and its bind request no report
+    sleep(70).await;
+    assert_eq!(pc.requests(), 0);
+    pc.set_option(BIND_REQ, &format!("{ID}.{login}"));
+    until("bound", || pc.binding().as_deref() == Some(ID)).await;
+    let bind = pc.api().got[0].0.clone();
+    assert_eq!(bind["binding"], ID);
+    assert_eq!(bind["wol_hash"], "");
+    assert!(bind.get("wol").is_none());
+    // collected within a minute of the binding: a sync carries it whole, the next its summary
+    let took = until("the report", || {
+        pc.api()
+            .got
+            .last()
+            .is_some_and(|(p, _)| p.get("wol").is_some())
+    })
+    .await;
+    assert!(took < Duration::from_secs(70), "{took:?}");
+    let carried = pc.requests();
+    until("the next sync", || pc.requests() > carried).await;
+    let got = pc.api().got.clone();
+    assert_eq!(got[carried - 1].0["wol_hash"], hash.as_str());
+    assert_eq!(
+        got[carried - 1].0["wol"],
+        serde_json::to_value(&report).unwrap()
+    );
+    assert_eq!(got[carried].0["wol_hash"], hash.as_str());
+    assert!(got[carried].0.get("wol").is_none());
+    // hjv-api asks for it: the sync after that answer carries it again, and only that one
+    pc.api().send_wol = true;
+    let asked = pc.requests();
+    until("asked", || pc.requests() > asked).await;
+    pc.api().send_wol = false;
+    until("two more", || pc.requests() > asked + 2).await;
+    let got = pc.api().got.clone();
+    assert!(got[asked].0.get("wol").is_none());
+    assert!(got[asked + 1].0.get("wol").is_some());
+    assert!(got[asked + 2].0.get("wol").is_none());
+    // the one report after the binding went says nothing of it
+    pc.set_option(UNBIND_REQ, &format!("{ID}.{login}"));
+    until("unbound", || {
+        pc.api().got.last().is_some_and(|(p, _)| p["binding"] == "")
+    })
+    .await;
+    let (last, _) = pc.api().got.last().cloned().unwrap();
+    assert_eq!(last["wol_hash"], "");
+    assert!(last.get("wol").is_none());
+    cleanup(&["loop-wol"]);
+}
