+#[tokio::test(start_paused = true)]
+async fn a_report_too_large_for_a_sync_stays_on_the_pc() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pc = Fake::new("loop-wol-large");
+    let login = unix_now() - 5;
+    {
+        let mut api = pc.api();
+        api.bound = Some((ID.to_owned(), login));
+        api.refresh = 5;
+    }
+    bind_to(&pc.pc(), login);
+    // four cards whose registry values are all 64 control characters, seven bytes each in a sync
+    let text = "\u{1}".repeat(64);
+    let (nics, class): (Vec<_>, Vec<_>) = (1..=4u8)
+        .map(|i| {
+            let guid = format!("{{{i}}}");
+            let mut key = crate::hjviewer_wol::ClassKey::new();
+            for (name, value) in [
+                ("NetCfgInstanceId", guid.as_str()),
+                ("Characteristics", "4"),
+                ("*PhysicalMediaType", "14"),
+            ] {
+                key.insert(name.to_owned(), value.to_owned());
+            }
+            for name in [
+                "DriverDesc",
+                "ProviderName",
+                "DriverVersion",
+                "DriverDate",
+                "*WakeOnMagicPacket",
+                "*WakeOnPattern",
+                "*ModernStandbyWoLMagicPacket",
+                "S5WakeOnLan",
+                "WolShutdownLinkSpeed",
+                "*EEE",
+                "EnableGreenEthernet",
+            ] {
+                key.insert(name.to_owned(), text.clone());
+            }
+            let nic = crate::hjviewer_wol::Nic {
+                guid,
+                mac: [0, 0, 0x5e, 0, 0x53, i],
+                ipv4: vec![(std::net::Ipv4Addr::new(192, 0, 2, i), 24)],
+                ..Default::default()
+            };
+            (nic, key)
+        })
+        .unzip();
+    let report = crate::hjviewer_wol::build(&nics, &class, None, Default::default(), None);
+    let hash = crate::hjviewer_wol::report_hash(&report);
+    let whole = payload(ID, "", false, &[], Refused::default(), &hash, Some(&report));
+    assert!(!fits_a_sync(&whole));
+    *pc.wol.lock().unwrap() = Some(report);
+    let _asks = Syncer::spawn(pc.clone());
+    // collected a minute after the start: the syncs go on, with its summary alone
+    until("the summary", || {
+        pc.api()
+            .got
+            .last()
+            .is_some_and(|(p, _)| p["wol_hash"] == hash.as_str())
+    })
+    .await;
+    sleep(30).await;
+    assert!(pc.api().got.iter().all(|(p, _)| p.get("wol").is_none()));
+    cleanup(&["loop-wol-large"]);
+}
+
