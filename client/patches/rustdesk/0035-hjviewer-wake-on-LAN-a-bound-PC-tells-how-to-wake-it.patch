+#[test]
+fn a_resume_during_the_hold_extends_it() {
+    let start = std::time::Instant::now();
+    let mut until = None;
+    assert!(extend(&mut until, start));
+    assert_eq!(remaining(&mut until, start), Some(AWAKE));
+    // the holder that runs takes the later end
+    let resumed = start + Duration::from_secs(300);
+    assert!(!extend(&mut until, resumed));
+    assert_eq!(
+        remaining(&mut until, start + AWAKE),
+        Some(Duration::from_secs(300))
+    );
+    // over: the next resume starts a holder again
+    assert_eq!(remaining(&mut until, resumed + AWAKE), None);
+    assert!(extend(&mut until, resumed + AWAKE));
+}
