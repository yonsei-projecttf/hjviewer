+#[test]
+fn the_report_goes_whole_once_per_binding_and_when_hjv_api_asks() {
+    const BINDING: &str = "b0f1e2d3c4b5a69788796a5b4c3d2e1f";
+    const OTHER: &str = "0123456789abcdef0123456789abcdef";
+    let mut carry = Carry::default();
+    assert_eq!(carry.part(BINDING), (String::new(), None));
+    let report = this_pc(3600);
+    let hash = report_hash(&report);
+    *carry.latest().lock().unwrap() = Some((report.clone(), hash.clone()));
+    assert_eq!(carry.part(BINDING), (hash.clone(), Some(report.clone())));
+    // until a 200 took it
+    carry.answered(BINDING, Some(&hash), 500, false);
+    assert_eq!(carry.part(BINDING).1, Some(report.clone()));
+    carry.answered(BINDING, Some(&hash), 200, false);
+    assert_eq!(carry.part(BINDING), (hash.clone(), None));
+    // hjv-api asks in the answer to a sync without it: the next carries it, then not again
+    carry.answered(BINDING, None, 200, true);
+    assert_eq!(carry.part(BINDING).1, Some(report.clone()));
+    carry.answered(BINDING, Some(&hash), 200, false);
+    assert_eq!(carry.part(BINDING).1, None);
+    // another binding, or a report that changed
+    assert_eq!(carry.part(OTHER).1, Some(report));
+    let changed = wakeable("00:00:5e:00:53:11", "192.0.2.69/24", "192.0.2.1").unwrap();
+    *carry.latest().lock().unwrap() = Some((changed.clone(), report_hash(&changed)));
+    assert_eq!(carry.part(BINDING), (report_hash(&changed), Some(changed)));
+}
