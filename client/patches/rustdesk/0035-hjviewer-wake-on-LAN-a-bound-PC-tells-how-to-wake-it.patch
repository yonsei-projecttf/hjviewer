+fn the_e2e_command_reports_a_pc_that_can_be_woken() {
+    let report =
+        serde_json::to_value(wakeable("00:00:5e:00:53:10", "192.0.2.67/24", "192.0.2.1").unwrap())
+            .unwrap();
+    let card = &report["adapters"][0];
+    assert_eq!(report["adapters"].as_array().unwrap().len(), 1);
+    assert_eq!(
+        (&card["mac"], &card["ipv4"], &card["gateway"], &card["bus"]),
+        (
+            &"00:00:5e:00:53:10".into(),
+            &serde_json::json!(["192.0.2.67/24"]),
+            &"192.0.2.1".into(),
+            &"pci".into()
+        )
+    );
+    assert_eq!(
+        (&card["wake"]["magic"], &card["armed"]),
+        (&"1".into(), &true.into())
+    );
+    assert_eq!(report["power"], serde_json::to_value(power()).unwrap());
+    for (mac, ipv4, gateway) in [
+        ("00:00:5e:00:53", "192.0.2.67/24", "192.0.2.1"),
+        ("00-00-5e-00-53-10", "192.0.2.67/24", "192.0.2.1"),
+        ("00:00:5e:00:53:1", "192.0.2.67/24", "192.0.2.1"),
+        ("00:00:5e:00:53:10", "192.0.2.67", "192.0.2.1"),
+        ("00:00:5e:00:53:10", "192.0.2.67/33", "192.0.2.1"),
+        ("00:00:5e:00:53:10", "192.0.2.67/24", "gateway"),
+    ] {
+        assert_eq!(wakeable(mac, ipv4, gateway), None, "{mac} {ipv4} {gateway}");
+    }
