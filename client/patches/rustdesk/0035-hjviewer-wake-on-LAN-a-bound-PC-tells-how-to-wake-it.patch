+#[test]
+fn the_summary_leaves_the_uptime_out() {
+    let report = this_pc(3600);
+    let without_uptime = REPORT.replace(r#","uptime_s":3600"#, "");
+    assert_eq!(
+        report_hash(&report),
+        hex::encode(Sha256::digest(without_uptime.as_bytes()))
+    );
+    assert_eq!(report_hash(&this_pc(86_400)), report_hash(&report));
+    // a wake setting changed (in the registry the report reads) changes it
+    let mut class = class();
+    let wired = class
+        .iter_mut()
+        .find(|key| key["NetCfgInstanceId"] == WIRED);
+    wired
+        .unwrap()
+        .insert("*WakeOnMagicPacket".to_owned(), "0".to_owned());
+    let changed = build(&nics(), &class, Some(&armed()), power(), Some(3600));
+    assert_ne!(report_hash(&changed), report_hash(&report));
+}
