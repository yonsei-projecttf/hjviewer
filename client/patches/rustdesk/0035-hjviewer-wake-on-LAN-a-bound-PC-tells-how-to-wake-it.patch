+//! The report from a synthesized registry and adapter list shaped like a real PC's: its wired card
+//! beside the key of a card no longer there with the same description, the kernel debug adapter,
+//! WAN miniports, Bluetooth PAN, Hyper-V, a VPN tunnel and USB Wi-Fi. Every MAC, GUID and address
+//! is made up: MACs of 00:00:5e:00:53:00/24 and addresses of RFC 5737, as design v3 8-2 asks.
+
+use super::*;
+use sha2::{Digest, Sha256};
+use std::net::IpAddr;
+
+const WIRED: &str = "{0E0E0E0E-0000-4000-8000-000000000001}";
+const GHOST: &str = "{0E0E0E0E-0000-4000-8000-000000000002}";
+const KDNIC: &str = "{0E0E0E0E-0000-4000-8000-000000000003}";
+const WAN: &str = "{0E0E0E0E-0000-4000-8000-000000000004}";
+const WIFI: &str = "{0E0E0E0E-0000-4000-8000-000000000005}";
+const PAN: &str = "{0E0E0E0E-0000-4000-8000-000000000006}";
+const TUNNEL: &str = "{0E0E0E0E-0000-4000-8000-000000000007}";
+const HYPERV: &str = "{0E0E0E0E-0000-4000-8000-000000000008}";
+const LOOPBACK: &str = "{0E0E0E0E-0000-4000-8000-000000000009}";
+const USB_LAN: &str = "{0E0E0E0E-0000-4000-8000-00000000000A}";
+const CARD: &str = "Example PCIe GbE Controller";
+
+/// Design v3 8-2's example, which this PC's report is.
+const REPORT: &str = r#"{"v":1,"adapters":[{"mac":"00:00:5e:00:53:10","ipv4":["192.0.2.67/24"],"gateway":"192.0.2.1","gateway_mac":"00:00:5e:00:53:01","desc":"Example PCIe GbE Controller","bus":"pci","link_mbps":1000,"driver":{"provider":"Example","version":"1.0.0.0","date":"1-1-2024"},"wake":{"magic":"1","pattern":"1","ms_magic":null,"s5":"1","shutdown_speed":"0","eee":"0","green":"0"},"armed":true}],"power":{"s3":true,"s4":true,"s5":true,"hiberfile":true,"aoac":false,"fast_startup":false,"on_ac":true},"uptime_s":3600}"#;
+
+fn key(values: &[(&str, &str)]) -> ClassKey {
+    values
+        .iter()
+        .map(|(k, v)| (k.to_string(), v.to_string()))
+        .collect()
+}
+
+/// The network class keys.
+fn class() -> Vec<ClassKey> {
+    vec![
+        // virtual and hidden, yet 802.3
+        key(&[
+            ("NetCfgInstanceId", KDNIC),
+            ("Characteristics", "9"),
+            ("*PhysicalMediaType", "14"),
+            ("MatchingDeviceId", r"root\kdnic"),
+            ("DriverDesc", "Microsoft Kernel Debug Network Adapter"),
+        ]),
+        // a card no longer there, with the wired card's description and other settings
+        key(&[
+            ("NetCfgInstanceId", GHOST),
+            ("Characteristics", "4"),
+            ("*PhysicalMediaType", "14"),
+            (
+                "MatchingDeviceId",
+                r"PCI\VEN_0000&DEV_0000&SUBSYS_00000001&REV_01",
+            ),
+            ("DriverDesc", CARD),
+            ("*WakeOnMagicPacket", "1"),
+            ("*EEE", "1"),
+            ("EnableGreenEthernet", "1"),
+        ]),
+        key(&[
+            ("NetCfgInstanceId", WIRED),
+            ("Characteristics", "4"),
+            ("*PhysicalMediaType", "14"),
+            (
+                "MatchingDeviceId",
+                r"PCI\VEN_0000&DEV_0000&SUBSYS_00000000&REV_01",
+            ),
+            ("DriverDesc", CARD),
+            ("ProviderName", "Example"),
+            ("DriverVersion", "1.0.0.0"),
+            ("DriverDate", "1-1-2024"),
+            ("*WakeOnMagicPacket", "1"),
+            ("*WakeOnPattern", "1"),
+            ("S5WakeOnLan", "1"),
+            ("WolShutdownLinkSpeed", "0"),
+            ("*EEE", "0"),
+            ("EnableGreenEthernet", "0"),
+        ]),
+        key(&[
+            ("NetCfgInstanceId", WAN),
+            ("Characteristics", "9"),
+            ("*PhysicalMediaType", "0"),
+            ("MatchingDeviceId", "ms_ndiswanip"),
+            ("DriverDesc", "WAN Miniport (IP)"),
+        ]),
+        // physical, but 802.11
+        key(&[
+            ("NetCfgInstanceId", WIFI),
+            ("Characteristics", "132"),
+            ("*PhysicalMediaType", "9"),
+            ("MatchingDeviceId", r"USB\VID_0000&PID_0000"),
+            ("DriverDesc", "802.11n USB Wireless LAN Card"),
+        ]),
+        key(&[
+            ("NetCfgInstanceId", PAN),
+            ("Characteristics", "129"),
+            ("*PhysicalMediaType", "10"),
+            ("MatchingDeviceId", r"BTH\MS_BTHPAN"),
+            ("DriverDesc", "Bluetooth Device (Personal Area Network)"),
+        ]),
+        key(&[
+            ("NetCfgInstanceId", TUNNEL),
+            ("Characteristics", "1"),
+            ("*PhysicalMediaType", "0"),
+            ("MatchingDeviceId", "wintun"),
+            ("DriverDesc", "Wintun Userspace Tunnel"),
+        ]),
+        key(&[
+            ("NetCfgInstanceId", HYPERV),
+            ("Characteristics", "1"),
+            ("*PhysicalMediaType", "14"),
+            ("MatchingDeviceId", r"VMS_MP\HJV"),
+            ("DriverDesc", "Hyper-V Virtual Ethernet Adapter"),
+        ]),
+    ]
+}
+
+fn mac(last: u8) -> [u8; 6] {
+    [0x00, 0x00, 0x5e, 0x00, 0x53, last]
+}
+
+fn ip(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
+    Ipv4Addr::new(a, b, c, d)
+}
+
+fn nic(guid: &str, desc: &str, mac: [u8; 6], ipv4: (Ipv4Addr, u8)) -> Nic {
+    Nic {
+        guid: guid.to_owned(),
+        desc: desc.to_owned(),
+        mac,
+        ipv4: vec![ipv4],
+        ..Nic::default()
+    }
+}
+
+/// The adapters default-net sees.
+fn nics() -> Vec<Nic> {
+    vec![
+        nic(
+            TUNNEL,
+            "Tailscale Tunnel",
+            [0; 6],
+            (ip(198, 51, 100, 60), 32),
+        ),
+        Nic {
+            // GetAdaptersAddresses and the registry need not agree on case
+            guid: WIRED.to_ascii_lowercase(),
+            gateway: Some(ip(192, 0, 2, 1)),
+            gateway_mac: Some(mac(0x01)),
+            link: Some(1_000_000_000),
+            ..nic(WIRED, CARD, mac(0x10), (ip(192, 0, 2, 67), 24))
+        },
+        nic(
+            PAN,
+            "Bluetooth Device (Personal Area Network) #3",
+            mac(0x20),
+            (ip(198, 51, 100, 20), 16),
+        ),
+        Nic {
+            gateway: Some(ip(198, 51, 100, 1)),
+            ..nic(
+                WIFI,
+                "802.11n USB Wireless LAN Card",
+                mac(0x30),
+                (ip(198, 51, 100, 30), 24),
+            )
+        },
+        nic(
+            HYPERV,
+            "Hyper-V Virtual Ethernet Adapter",
+            mac(0x40),
+            (ip(203, 0, 113, 40), 20),
+        ),
+        nic(
+            KDNIC,
+            "Microsoft Kernel Debug Network Adapter",
+            mac(0x50),
+            (ip(203, 0, 113, 50), 24),
+        ),
+        nic(
+            LOOPBACK,
+            "Software Loopback Interface 1",
+            [0; 6],
+            (ip(127, 0, 0, 1), 8),
+        ),
+    ]
+}
+
+fn power() -> Power {
+    Power {
+        s3: Some(true),
+        s4: Some(true),
+        s5: Some(true),
+        hiberfile: Some(true),
+        aoac: Some(false),
+        fast_startup: Some(false),
+        on_ac: Some(true),
+    }
+}
+
+/// The devices armed to wake the PC as powercfg lists them: HID devices and the wired card.
+fn armed() -> Vec<String> {
+    [
+        "HID-compliant mouse (001)",
+        CARD,
+        "HID Keyboard Device (002)",
+    ]
+    .map(str::to_owned)
+    .to_vec()
+}
+
+fn this_pc(uptime_s: u64) -> Report {
+    build(&nics(), &class(), Some(&armed()), power(), Some(uptime_s))
+}
