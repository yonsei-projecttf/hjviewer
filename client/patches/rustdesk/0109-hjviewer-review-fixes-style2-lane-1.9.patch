index 0000000..5ed4167
--- /dev/null
+++ b/flutter/test/hjviewer_dialog_frame_test.dart
@@ -0,0 +1,79 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The app's own themes and the session's message box as common.dart builds them (U50, U51): a
+// desktop's buttons under MyTheme.lightTheme and darkTheme (hjv_theme.dart's hjvRestyle), and
+// msgboxIcon in the alert frame. These tests import common.dart, so they need the generated
+// bridge, which client-build.yml makes before its Dart tests; the pure parts are in
+// hjviewer_style_test.dart.
+
+void main() {
+  // the themes are built on first use, so the platform's density (Windows: compact) is the one
+  // a desktop's app starts with
+  testWidgets(
+      'a desktop\'s Elevated, Outlined and Text buttons are 36 high in both themes',
+      (tester) async {
+    expect(isDesktop, isTrue, reason: 'the tests run on a desktop host');
+    for (final (name, theme) in [
+      ('light', MyTheme.lightTheme),
+      ('dark', MyTheme.darkTheme),
+    ]) {
+      await tester.pumpWidget(MaterialApp(
+          theme: theme,
+          home: Scaffold(
+              body: Column(
+                  mainAxisSize: MainAxisSize.min,
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                ElevatedButton(onPressed: () {}, child: const Text('OK')),
+                OutlinedButton(onPressed: () {}, child: const Text('OK')),
+                TextButton(onPressed: () {}, child: const Text('OK')),
+              ]))));
+      for (final kind in [ElevatedButton, OutlinedButton, TextButton]) {
+        expect(tester.getSize(find.byType(kind)).height, 36,
+            reason: '$name $kind');
+      }
+      // the theme's own fields do not beat the 16 at the sides
+      for (final style in [
+        theme.elevatedButtonTheme.style,
+        theme.outlinedButtonTheme.style,
+        theme.textButtonTheme.style,
+      ]) {
+        expect(style?.padding?.resolve({}),
+            const EdgeInsets.symmetric(horizontal: 16),
+            reason: name);
+      }
+    }
+  }, variant: TargetPlatformVariant.only(TargetPlatform.windows));
+
+  testWidgets(
+      'a message box: its 22 px icon on the title\'s line, the text below at the full width',
+      (tester) async {
+    const long =
+        'The remote PC did not answer in time. Check that it is on and online, '
+        'then connect again.';
+    await tester.pumpWidget(MaterialApp(
+        home: Scaffold(
+            body: Align(
+                alignment: Alignment.topLeft,
+                child: SizedBox(
+                    width: 360,
+                    child: HjvAlertContent(
+                        icon: msgboxIcon('error'),
+                        title: 'Connection error',
+                        text: const Text(long)))))));
+    final icon = find.byIcon(Icons.error_outline_rounded);
+    expect(tester.widget<Icon>(icon).size, 22);
+    final row = find.ancestor(of: icon, matching: find.byType(Row));
+    expect(
+        find.descendant(of: row.first, matching: find.text('Connection error')),
+        findsOneWidget);
+    final frame = tester.getRect(find.byType(HjvAlertContent));
+    final text = tester.getRect(find.text(long));
+    expect(text.top, greaterThanOrEqualTo(tester.getRect(row.first).bottom));
+    expect(text.left, frame.left);
+    expect(text.width, greaterThan(frame.width - 22));
+  });
+}
