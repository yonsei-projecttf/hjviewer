+#[test]
+fn the_screens_learn_only_whether_a_targets_access_password_ticket_is_held() {
+    let says = |target: &str| guest::get_common(&format!("hjv-guest-held:{target}"));
+    let issued = json!({ "ticket": "t1.held", "exp": NOW + 43_200, "server_time": NOW });
+    assert!(keep_guest("held-target-1", &issued));
+    assert_eq!(says("held-target-1").as_deref(), Some("Y"));
+    // the session's ID with a relay mark is the same target; another is not
+    assert_eq!(says("held-target-1/r").as_deref(), Some("Y"));
+    assert_eq!(says("held-target-2").as_deref(), Some(""));
+    forget_guest("held-target-1");
+    assert_eq!(says("held-target-1").as_deref(), Some(""));
+    // one past its lifetime is not held
+    memory()
+        .guests
+        .insert("held-target-3".to_owned(), held("t1.old", 1, 1));
+    assert_eq!(says("held-target-3").as_deref(), Some(""));
+    forget_guest("held-target-3");
+}
