+/// main_get_common: `hjv-guest-result:<what>`, the last exchange's (none: ""), and
+/// `hjv-guest-held:<PC ID>`.
 pub(super) fn get_common(key: &str) -> Option<String> {
+    if let Some(to) = key.strip_prefix("hjv-guest-held:") {
+        return Some(if held(to) { "Y" } else { "" }.to_owned());
+    }
     let what = key.strip_prefix("hjv-guest-result:")?;
     let results = RESULTS.lock().unwrap_or_else(|e| e.into_inner());
     Some(results.get(what).cloned().unwrap_or_default())
 }
 
+/// Whether this process keeps a controller ticket for the PC `to` that still holds (A0).
+fn held(to: &str) -> bool {
+    let to = crate::ui_interface::handle_relay_id(to);
+    let now = super::unix_now();
+    super::memory()
+        .guests
+        .get(to)
+        .is_some_and(|held| held.valid(now))
+}
