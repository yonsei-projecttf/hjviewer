diff --git a/flutter/lib/common/hjviewer_access.dart b/flutter/lib/common/hjviewer_access.dart
index f71f44a..375019a 100644
--- a/flutter/lib/common/hjviewer_access.dart
+++ b/flutter/lib/common/hjviewer_access.dart
@@ -1254,3 +1254,151 @@ Future<void> _askGateMode() async {
     debugPrint('hjv: access mode: $e');
   }
 }
+
+// ---- before connecting (A0) ----
+
+/// connect() (common.dart), before it opens a session: on a staff-only server, to an app without
+/// a login that keeps no access password ticket for the PC `id`, A0, which is A1 before any
+/// refusal (the doc 5-3). [연결] takes that PC's ticket first, [로그인] the login; true when no
+/// session is to open ([취소]). A mode not known yet, and a session window's new connection (the
+/// main window opens it at once), open the session as before: a refusal brings A1.
+Future<bool> hjvAccessAskBeforeConnect(String id) async {
+  if (!_accountBuild || (isDesktop && desktopType != DesktopType.main)) {
+    return false;
+  }
+  unawaited(_askGateMode());
+  // the session's ID, as the core keeps the ticket by it (guest.rs set_common)
+  final target = await bind.mainHandleRelayId(id: id.replaceAll(' ', ''));
+  if (!hjvAsksBeforeConnect(
+      accountBuild: _accountBuild,
+      mode: _gateMode.value,
+      loggedIn: _loggedIn(),
+      held: _commonSync(hjvGuestHeldKey(target)) == 'Y')) {
+    return false;
+  }
+  return !await _askDialog(_t, target);
+}
+
+/// handleMsgBox (model.dart), before the PC's own password box: once a session, the note that
+/// the access password is done while this process keeps that PC's ticket (A0 took it in the main
+/// window, which a desktop session window cannot see but through the core).
+void hjvAccessBeforePcPassword(SessionID sessionId, String peerId) {
+  if (!_accountBuild) return;
+  final session = sessionId.toString();
+  if (_heldNoted.add(session) && _commonSync(hjvGuestHeldKey(peerId)) == 'Y') {
+    _noteOnce.add(session);
+  }
+}
+
+/// The sessions whose PC password box looked at the ticket A0 took.
+final _heldNoted = <String>{};
+
+/// A0: true to open the session (a ticket came, or the login), false for [취소].
+Future<bool> _askDialog(HjvAccessTexts t, String target) async {
+  final controller = TextEditingController();
+  String? error;
+  var busy = false;
+  var visible = false;
+  var retryAt = 0;
+  var closed = false;
+  final canLogIn = !bind.isDisableAccount();
+  // no soft keyboard on a desktop: its field is open at once; a phone's behind the link, so
+  // that the keyboard does not come up first
+  var open = isDesktop || isWebDesktop || !canLogIn;
+  var logIn = false;
+  final shown = gFFI.dialogManager.show<bool>((setState, close, context) {
+    void cancel() => close(false);
+
+    void toLogIn() {
+      logIn = true;
+      close(false);
+    }
+
+    bool canSend(String typed) =>
+        hjvAccessCanSend(typed, busy: busy, retryAt: retryAt, now: _unixNow());
+
+    Future<void> connect() async {
+      final password = hjvAccessPassword(controller.text);
+      if (!canSend(password)) return;
+      setState(() {
+        busy = true;
+        error = null;
+      });
+      final failure = await hjvTradeAccessPassword(t,
+          ask: () => bind.mainSetCommon(
+              key: kHjvGuestCtl, value: hjvGuestCtlValue(target, password)),
+          result: () =>
+              bind.mainGetCommonSync(key: hjvGuestResultKey(to: target)));
+      // [취소] while it was checked: no session; a ticket that came ends with the process
+      if (closed) return;
+      if (failure != null) {
+        setState(() {
+          busy = false;
+          error = failure;
+          retryAt = hjvRetryAt(
+              bind.mainGetCommonSync(key: hjvGuestResultKey(to: target)),
+              _unixNow());
+        });
+        _untilRetry(retryAt, setState, () => closed);
+        return;
+      }
+      close(true);
+    }
+
+    // Enter: [연결] with something typed, else [로그인]
+    void submit() {
+      if (open && controller.text.trim().isNotEmpty) {
+        unawaited(connect());
+      } else if (canLogIn && !busy) {
+        toLogIn();
+      }
+    }
+
+    return CustomAlertDialog(
+      title: HjvDialogTitle(Icons.lock_outline_rounded, t.askTitle),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(hjvKeepAll(t.askText), style: hjvDialogTextStyle(context)),
+          if (open) ...[
+            const SizedBox(height: 8),
+            _passwordField(t, controller,
+                visible: visible,
+                onToggle: () => setState(() => visible = !visible),
+                onSubmitted: submit,
+                error: hjvAccessErrorNow(t, error,
+                    retryAt: retryAt, now: _unixNow())),
+            if (busy) _checking(t),
+          ] else
+            TextButton(
+              // a 48 px target on a phone (U57), as A1's
+              style: TextButton.styleFrom(
+                  padding: const EdgeInsets.symmetric(horizontal: 12),
+                  minimumSize: const Size(48, 48),
+                  tapTargetSize: MaterialTapTargetSize.shrinkWrap),
+              onPressed: () => setState(() => open = true),
+              child: Text(t.havePassword),
+            ).marginOnly(top: 4),
+        ],
+      ),
+      actions: [
+        _button(t.cancel, cancel, outline: true),
+        if (canLogIn) _button(t.logIn, busy ? null : toLogIn, outline: open),
+        if (open) _sendButton(t.connect, controller, canSend, connect),
+      ],
+      onSubmit: submit,
+      onCancel: cancel,
+    );
+  });
+  final opens =
+      await shown.whenComplete(() => closed = true).catchError((Object e) {
+    // no A0 to show: the session opens as before, and a refusal brings A1
+    debugPrint('hjv: $e');
+    return true;
+  });
+  if (opens == true) return true;
+  if (!logIn) return false;
+  if (await loginDialog() == true) return true;
+  return _askDialog(t, target);
+}
