 }
+
+// ---- before connecting (A0) ----
+
+/// The main_get_common key that says whether this process keeps the access password's ticket for
+/// the PC `to` (its ID without spaces or relay mark): "Y" or "" (src/hjviewer_access/guest.rs),
+/// never the ticket.
+String hjvGuestHeldKey(String to) => 'hjv-guest-held:$to';
+
+/// Whether connect() asks A0 before the session opens: in an account build, on a server known to
+/// be staff-only (`mode`, hjvGateCloses), to an app without a login (`loggedIn`) that does not
+/// keep the access password's ticket for that PC (`held`). A mode not known yet asks nothing: the
+/// session opens, and a refusal brings A1.
+bool hjvAsksBeforeConnect(
+        {required bool accountBuild,
+        required String mode,
+        required bool loggedIn,
+        required bool held}) =>
+    accountBuild && hjvGateCloses(mode) == true && !loggedIn && !held;
