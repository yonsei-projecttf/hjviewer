diff --git a/src/hjviewer.rs b/src/hjviewer.rs
index 41f4b3f..a49292c 100644
--- a/src/hjviewer.rs
+++ b/src/hjviewer.rs
@@ -44,3 +44,12 @@ pub fn apply() {
     builtin.insert(keys::OPTION_HIDE_SERVER_SETTINGS.to_owned(), "Y".to_owned());
     builtin.insert(keys::OPTION_HIDE_WEBSOCKET_SETTINGS.to_owned(), "Y".to_owned());
 }
+
+/// hjviewer builds leave out RustDesk's printer driver adapter (closed source), so remote printing
+/// is offered only where one was installed by hand next to the executable.
+#[cfg(target_os = "windows")]
+pub fn printer_adapter_present() -> bool {
+    std::env::current_exe()
+        .map(|exe| exe.with_file_name("printer_driver_adapter.dll").exists())
+        .unwrap_or(false)
+}
