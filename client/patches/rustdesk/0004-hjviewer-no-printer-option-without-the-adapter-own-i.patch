 .../main/kotlin/com/carriez/flutter_hbb/MainService.kt   | 6 +++---
 flutter/lib/desktop/pages/install_page.dart              | 9 ++++-----
 src/flutter_ffi.rs                                       | 3 ++-
 src/hjviewer.rs                                          | 9 +++++++++
