@@ -30,6 +30,9 @@ const kMaxSoftKeyboardFillerBackspaces = 8;
 /// than what changed (pinyin, kana), so that only the converted text is sent.
 /// Hangul is sent while it is composed, as the remote side has no way to show
 /// an uncommitted syllable otherwise.
+///
+/// [initialFillerLength] (remote_page.dart passes the length of its filler)
+/// turns on dropping filler characters the keyboard put back before Hangul.
 SoftKeyboardEdit? iosSoftKeyboardEdit(String oldValue, TextEditingValue value,
     {int? initialFillerLength}) {
   final newValue = value.text;
@@ -42,11 +45,14 @@ SoftKeyboardEdit? iosSoftKeyboardEdit(String oldValue, TextEditingValue value,
     return null;
   }
   // The keyboard can also put back one filler character too many before a
-  // syllable (rustdesk PR #15201, "over-restored sentinel"). Only on a full,
-  // otherwise empty filler, so that a 1 the user typed is never dropped.
+  // syllable (rustdesk PR #15201, "over-restored sentinel"). Also on a filler
+  // that Backspaces shortened: on a device (1.9.3) Korean typed after
+  // deleting text already on the PC's line arrived as "1" and the syllable.
+  // Only while the field holds no typed text and only right before Hangul:
+  // a 1 typed alone, or after typed text, is sent, and typing a 1 and then
+  // Hangul means switching layouts, never one settled edit.
   if (initialFillerLength != null &&
       !value.isComposingRangeValid &&
-      oldFiller == initialFillerLength &&
       oldFiller == oldValue.length) {
     final newFiller = _fillerLength(newValue);
     final tail = newValue.substring(newFiller);
