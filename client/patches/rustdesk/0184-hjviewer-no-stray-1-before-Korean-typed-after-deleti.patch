+/// iosSoftKeyboardEdit's over-restored-sentinel guard in 1.9.3: a full,
+/// otherwise empty filler only.
+SoftKeyboardEdit? _guardBeforeFix(String oldValue, TextEditingValue value) {
+  const n = 1024;
+  final shortened = oldValue.length < n && !oldValue.contains(RegExp('[^1]'));
+  if (shortened) {
+    // What 1.9.3 did here: the plain diff, without the guard.
+    return iosSoftKeyboardEdit(oldValue, value);
+  }
+  return iosSoftKeyboardEdit(oldValue, value, initialFillerLength: n);
+}
+
 /// remote_page.dart `_handleIOSSoftKeyboardInput` before this change.
 SoftKeyboardEdit? _diffBeforeFix(String oldValue, TextEditingValue value) {
   final newValue = value.text;
