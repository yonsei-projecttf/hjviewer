@@ -0,0 +1,127 @@
+import 'package:flutter_hbb/common/hjviewer_access_texts.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The access screens' texts and choices (the hjviewer repository's docs/access-tickets.md 5-3),
+// without the bridge.
+
+const ko = HjvAccessTexts(true);
+const en = HjvAccessTexts(false);
+
+List<String> texts(HjvAccessTexts t) => [
+      t.ok,
+      t.cancel,
+      t.logIn,
+      t.refused,
+      t.connectWithPassword,
+      t.passwordTitle,
+      t.passwordHint,
+      t.refusedAgain,
+      t.pcTitle,
+      t.pcText,
+      t.pcPassword,
+      t.pcPasswordText,
+      t.keepLoggedIn,
+      for (final code in [
+        'denied',
+        'rate_limited',
+        'wrong_pc',
+        'clock',
+        'busy'
+      ])
+        t.failure(code),
+    ];
+
+void main() {
+  test('the texts are the contract\'s, in the app\'s language', () {
+    expect(ko.refused,
+        'HJViewer는 연세대학교 교직원용입니다. 연세포탈로 로그인하거나 이용 비밀번호를 넣으세요. (access not allowed)');
+    expect(en.refused,
+        'HJViewer is for Yonsei University staff. Log in with your Yonsei portal account, or enter the access password. (access not allowed)');
+    expect([ko.logIn, ko.connectWithPassword, ko.cancel],
+        ['로그인', '이용 비밀번호로 연결', '취소']);
+    expect([en.logIn, en.connectWithPassword, en.cancel],
+        ['Log in', 'Connect with the access password', 'Cancel']);
+    expect(ko.pcTitle, '이 PC는 아직 서버에 연결되지 않았습니다');
+    expect([ko.logIn, ko.pcPassword], ['로그인', '이용 비밀번호']);
+    expect(en.pcPassword, 'Access password');
+    // the refusals keep hbbs's mark, so that no app connects again by itself
+    for (final t in [ko, en]) {
+      expect(t.refused, endsWith('(access not allowed)'));
+      expect(t.refusedAgain, endsWith('(access not allowed)'));
+    }
+    final (kos, ens) = (texts(ko), texts(en));
+    for (var i = 0; i < kos.length; i++) {
+      expect(kos[i], isNot(ens[i]));
+      // translate() would take braces for placeholders; the name is never the guest's
+      for (final text in [kos[i], ens[i]]) {
+        expect(text, isNot(contains('{')));
+        expect(text, isNot(contains('손님')));
+        expect(text.toLowerCase(), isNot(contains('guest')));
+      }
+    }
+  });
+
+  test('why the access password brought no ticket', () {
+    expect(ko.failure('denied'), '이용 비밀번호가 맞지 않거나, 지금은 서버가 이용 비밀번호를 받지 않습니다.');
+    expect(ko.failure('rate_limited'), '시도가 너무 많습니다. 잠시 뒤 다시 해 주세요.');
+    expect(ko.failure('wrong_pc'), startsWith('이 PC의 키가 서버에 있는 것과 달라'));
+    expect(ko.failure('clock'), startsWith('기기의 날짜와 시간이 맞지 않습니다.'));
+    expect(en.failure('clock'),
+        startsWith("The device's date and time are wrong."));
+    // hjv-api busy or away, an answer of another form, no network: one text
+    for (final code in [
+      'busy',
+      'unavailable',
+      'bad_request',
+      'network',
+      'config',
+      'new'
+    ]) {
+      expect(ko.failure(code), '지금은 이용 비밀번호를 확인할 수 없습니다. 잠시 뒤 다시 해 주세요.',
+          reason: code);
+    }
+  });
+
+  test('an exchange asks the core and reads what it noted', () async {
+    final asked = <String>[];
+    Future<String?> trade(String result, {bool fails = false}) =>
+        hjvTradeAccessPassword(ko, ask: () async {
+          asked.add('ask');
+          if (fails) throw StateError('no bridge');
+        }, result: () {
+          asked.add('result');
+          return result;
+        });
+    expect(await trade('{"ok":true}'), isNull);
+    expect(asked, ['ask', 'result']);
+    expect(await trade('{"ok":false,"error":"denied"}'), ko.failure('denied'));
+    expect(await trade('{"error":"rate_limited","ok":false}'),
+        ko.failure('rate_limited'));
+    // nothing noted, or not the core's
+    expect(await trade(''), ko.failure('network'));
+    expect(await trade('<html>'), ko.failure('network'));
+    asked.clear();
+    expect(await trade('{"ok":true}', fails: true), ko.failure('network'));
+    expect(asked, ['ask']);
+  });
+
+  test('what the core gets (src/hjviewer_access/guest.rs)', () {
+    expect([kHjvGuestCtl, kHjvGuestPc], ['hjv-guest-ctl', 'hjv-guest-pc']);
+    expect(hjvGuestCtlValue('123456789', 'pass "word"'),
+        '{"to":"123456789","password":"pass \\"word\\""}');
+    expect(hjvGuestPcValue('pass word'), '{"password":"pass word"}');
+    expect(
+        hjvGuestResultKey(to: '123456789'), 'hjv-guest-result:ctl:123456789');
+    expect(hjvGuestResultKey(), 'hjv-guest-result:pc');
+    // a pasted password's spaces around it go, the ones inside stay
+    expect(hjvAccessPassword('  abcde fghjk\t'), 'abcde fghjk');
+  });
+
+  test('the PC home shows its notice only while hbbs refuses this PC', () {
+    expect(kHjvAccessPcState, 'hjv-access-pc');
+    expect(hjvShowsPcNotice('refused'), isTrue);
+    // taken, or a server that checks nothing, or a build that registers without tickets
+    expect(hjvShowsPcNotice('ok'), isFalse);
+    expect(hjvShowsPcNotice(''), isFalse);
+  });
+}
