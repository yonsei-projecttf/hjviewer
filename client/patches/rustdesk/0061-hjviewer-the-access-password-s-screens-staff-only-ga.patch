+// HJViewer's access screens (the hjviewer repository's docs/access-tickets.md 5-3): the dialog
+// after hbbs refused a session for access, the PC home's notice while hbbs refuses this PC's
+// registration, the PC's access password and the hint to keep an unattended PC logged in. The
+// access password goes to Rust (src/hjviewer_access/guest.rs), which trades it for one PC's
+// ticket and forgets it; the texts and the choices between them are in
+// hjviewer_access_texts.dart. Outside an account build every hook leaves its screen as it was,
+// and so does a server that checks nothing (MODE=off), which refuses nobody.
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjviewer_access_texts.dart';
+import 'package:flutter_hbb/common/widgets/dialog.dart';
+import 'package:flutter_hbb/common/widgets/login.dart';
+import 'package:flutter_hbb/consts.dart';
+import 'package:flutter_hbb/models/model.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:flutter_hbb/utils/multi_window_manager.dart';
+import 'package:get/get.dart';
+
+/// An account build (src/hjviewer_account), the only one that carries access tickets.
+final bool _accountBuild = !isWeb && _commonSync('hjv-account') == 'Y';
+
+String _commonSync(String key) {
+  try {
+    return bind.mainGetCommonSync(key: key);
+  } catch (e) {
+    return '';
+  }
+}
+
+/// The texts in the language of the app's own, as the account screens pick it.
+HjvAccessTexts get _t => HjvAccessTexts(translate('Cancel') == '취소');
+
+/// A button as dialogButton() draws it, for a text of these screens, which translate() must not
+/// see (as hjviewer_account.dart's).
+Widget _button(String label, VoidCallback? onPressed, {bool outline = false}) {
+  if (isDesktop || isWebDesktop) {
+    return outline
+        ? OutlinedButton(onPressed: onPressed, child: Text(label))
+        : ElevatedButton(
+            style: ElevatedButton.styleFrom(elevation: 0),
+            onPressed: onPressed,
+            child: Text(label));
+  }
+  return Builder(
+      builder: (context) => TextButton(
+          style: TextButton.styleFrom(
+              foregroundColor:
+                  outline ? HjvPalette.of(context).textSecondary : null,
+              textStyle: TextStyle(
+                  fontFamily: kHjvFont,
+                  fontWeight: outline ? FontWeight.w600 : FontWeight.w700)),
+          onPressed: onPressed,
+          child: Text(label)));
+}
+
+/// The access password's field: hidden as typed unless shown, the hint below it, and why the
+/// last try brought no ticket.
+Widget _passwordField(HjvAccessTexts t, TextEditingController controller,
+        {required bool visible,
+        required VoidCallback onToggle,
+        String? error}) =>
+    Builder(
+        builder: (context) => DialogTextField(
+              title: t.passwordTitle,
+              controller: controller,
+              obscureText: !visible,
+              prefixIcon: DialogTextField.kPasswordIcon,
+              suffixIcon: IconButton(
+                  icon: Icon(
+                      visible
+                          ? Icons.visibility_outlined
+                          : Icons.visibility_off_outlined,
+                      size: 20,
+                      color: HjvPalette.of(context).textTertiary),
+                  onPressed: onToggle),
+              helperText: t.passwordHint,
+              errorText: error,
+            ));
+
+// ---- the hooks ----
+
+/// main.dart, beside hjvInitAccount: the app's start and each return to the front have Rust look
+/// at the login's ticket now (hjv-access-refresh), not only when a connection needs it.
+void hjvInitAccess() {
+  if (!_accountBuild) return;
+  WidgetsBinding.instance.addObserver(_refresh);
+  _refresh.now();
+}
+
+/// handleMsgBox (model.dart): hbbs refused the session for access (msgbox `hjv-access-error`).
+/// An app without a login gets A1, which offers the login and the access password for this PC;
+/// a logged-in app, whose new ticket was refused too, A2 as an error box. True when the msgbox
+/// was this one.
+bool hjvAccessRefused(
+    SessionID sessionId,
+    String peerId,
+    String type,
+    String title,
+    OverlayDialogManager dialogManager,
+    ReconnectHandle reconnect) {
+  if (type != kHjvAccessMsgbox) return false;
+  final t = _t;
+  if (bind.mainGetLocalOption(key: 'access_token').isNotEmpty) {
+    msgBox(sessionId, type, title, t.refusedAgain, '', dialogManager);
+  } else {
+    _refusedDialog(t, sessionId, peerId, title, dialogManager, reconnect);
+  }
+  return true;
+}
+
+/// P1 (desktop_home_page.dart, the left pane, which is also the quick support window): while
+/// hbbs refuses this PC's registration, why, with [로그인] and [이용 비밀번호].
+List<Widget> hjvAccessPcNotice() =>
+    _accountBuild ? [const _HjvAccessPcNotice()] : [];
+
+/// G1 (desktop settings, the account card; the install page): an unattended PC needs the login,
+/// since the access password lasts only as long as the app runs.
+List<Widget> hjvAccessKeepLoggedIn({EdgeInsets margin = EdgeInsets.zero}) =>
+    _accountBuild && isDesktop && !bind.isOutgoingOnly()
+        ? [
+            Padding(
+                padding: margin,
+                child: Builder(
+                    builder: (context) => hjvNoteBlock(context,
+                        icon: Icons.info_outline_rounded,
+                        text: Text(_t.keepLoggedIn))))
+          ]
+        : [];
+
+// ---- a session refused (A1) ----
+
+void _refusedDialog(
+    HjvAccessTexts t,
+    SessionID sessionId,
+    String peerId,
+    String title,
+    OverlayDialogManager dialogManager,
+    ReconnectHandle reconnect) {
+  final controller = TextEditingController();
+  String? error;
+  var busy = false;
+  var visible = false;
+  // a port forward connects again for each local connection, which takes the new ticket
+  final forward = desktopType == DesktopType.portForward;
+  dialogManager.dismissAll();
+  dialogManager.show((setState, close, context) {
+    void cancel() {
+      close();
+      if (!forward) closeConnection();
+    }
+
+    void logIn() async {
+      close();
+      if (await loginDialog() != true) {
+        _refusedDialog(t, sessionId, peerId, title, dialogManager, reconnect);
+        return;
+      }
+      // a session window: the main window shows the login too
+      if (isDesktop && desktopType != DesktopType.main) {
+        rustDeskWinManager.call(WindowType.Main, kWindowRefreshCurrentUser, '');
+      }
+      if (!forward) reconnect(dialogManager, sessionId, false);
+    }
+
+    Future<void> connect() async {
+      final password = hjvAccessPassword(controller.text);
+      if (busy || password.isEmpty) return;
+      setState(() {
+        busy = true;
+        error = null;
+      });
+      final failure = await hjvTradeAccessPassword(t,
+          ask: () => bind.mainSetCommon(
+              key: kHjvGuestCtl, value: hjvGuestCtlValue(peerId, password)),
+          result: () =>
+              bind.mainGetCommonSync(key: hjvGuestResultKey(to: peerId)));
+      if (failure != null) {
+        setState(() {
+          busy = false;
+          error = failure;
+        });
+        return;
+      }
+      close();
+      if (!forward) reconnect(dialogManager, sessionId, false);
+    }
+
+    return CustomAlertDialog(
+      title: HjvDialogTitle(Icons.lock_outline_rounded, translate(title)),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(t.refused, style: hjvDialogTextStyle(context)),
+          const SizedBox(height: 8),
+          _passwordField(t, controller,
+              visible: visible,
+              onToggle: () => setState(() => visible = !visible),
+              error: error),
+          if (busy) const LinearProgressIndicator().marginOnly(top: 8),
+        ],
+      ),
+      actions: [
+        _button(t.cancel, busy ? null : cancel, outline: true),
+        if (!bind.isDisableAccount())
+          _button(t.logIn, busy ? null : logIn, outline: true),
+        _button(t.connectWithPassword, busy ? null : connect),
+      ],
+      onSubmit: connect,
+      onCancel: busy ? null : cancel,
+    );
+  });
+}
+
+// ---- this PC refused (P1, P2) ----
+
+class _HjvAccessPcNotice extends StatefulWidget {
+  const _HjvAccessPcNotice();
+
+  @override
+  State<_HjvAccessPcNotice> createState() => _HjvAccessPcNoticeState();
+}
+
+class _HjvAccessPcNoticeState extends State<_HjvAccessPcNotice> {
+  bool _refused = false;
+  Timer? _timer;
+
+  bool _read() =>
+      hjvShowsPcNotice(bind.mainGetOptionSync(key: kHjvAccessPcState));
+
+  @override
+  void initState() {
+    super.initState();
+    // the state of the process that registers, which the UI gets every second
+    _refused = _read();
+    _timer = Timer.periodic(const Duration(seconds: 1), (_) {
+      final refused = _read();
+      if (refused != _refused) setState(() => _refused = refused);
+    });
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!_refused) return const SizedBox.shrink();
+    final t = _t;
+    final p = HjvPalette.of(context);
+    final (back, fore) = hjvTint(context, p.warning);
+    // HJViewer: a card as the ID's and the password's, on the warning's tint
+    return Container(
+      margin: const EdgeInsets.fromLTRB(12, 0, 12, 8),
+      padding: const EdgeInsets.fromLTRB(12, 10, 12, 10),
+      decoration: BoxDecoration(
+        color: back,
+        borderRadius: BorderRadius.circular(HjvRadius.lg),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Row(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Icon(Icons.cloud_off_rounded, size: 16, color: fore)
+                  .marginOnly(top: 1, right: 6),
+              Expanded(
+                child: Text(t.pcTitle,
+                    style: TextStyle(
+                        fontSize: 13,
+                        fontWeight: FontWeight.w700,
+                        height: 1.35,
+                        color: p.text)),
+              ),
+            ],
+          ),
+          const SizedBox(height: 4),
+          Text(t.pcText,
+              style: TextStyle(
+                  fontSize: 12, height: 1.45, color: p.textSecondary)),
+          const SizedBox(height: 8),
+          Wrap(
+            spacing: 6,
+            runSpacing: 6,
+            children: [
+              if (!bind.isDisableAccount())
+                _button(t.logIn, () => loginDialog()),
+              _button(t.pcPassword, () => _pcPasswordDialog(t), outline: true),
+            ],
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+void _pcPasswordDialog(HjvAccessTexts t) {
+  final controller = TextEditingController();
+  String? error;
+  var busy = false;
+  var visible = false;
+  gFFI.dialogManager.show((setState, close, context) {
+    Future<void> submit() async {
+      final password = hjvAccessPassword(controller.text);
+      if (busy || password.isEmpty) return;
+      setState(() {
+        busy = true;
+        error = null;
+      });
+      final failure = await hjvTradeAccessPassword(t,
+          ask: () => bind.mainSetCommon(
+              key: kHjvGuestPc, value: hjvGuestPcValue(password)),
+          result: () => bind.mainGetCommonSync(key: hjvGuestResultKey()));
+      if (failure != null) {
+        setState(() {
+          busy = false;
+          error = failure;
+        });
+        return;
+      }
+      close();
+    }
+
+    return CustomAlertDialog(
+      title: HjvDialogTitle(Icons.key_rounded, t.pcPassword),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(t.pcPasswordText, style: hjvDialogTextStyle(context)),
+          const SizedBox(height: 8),
+          _passwordField(t, controller,
+              visible: visible,
+              onToggle: () => setState(() => visible = !visible),
+              error: error),
+          if (busy) const LinearProgressIndicator().marginOnly(top: 8),
+        ],
+      ),
+      actions: [
+        _button(t.cancel, busy ? null : close, outline: true),
+        _button(t.ok, busy ? null : submit),
+      ],
+      onSubmit: submit,
+      onCancel: busy ? null : close,
+    );
+  }).catchError((Object e) {
+    debugPrint('hjv: $e');
+    return null;
+  });
+}
+
+// ---- the login's ticket ----
+
+class _HjvAccessRefresh with WidgetsBindingObserver {
+  void now() {
+    unawaited(bind
+        .mainSetCommon(key: 'hjv-access-refresh', value: '')
+        .catchError((Object e) => debugPrint('hjv: $e')));
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) now();
+  }
+}
+
+final _refresh = _HjvAccessRefresh();
diff --git a/flutter/lib/common/hjviewer_access_texts.dart b/flutter/lib/common/hjviewer_access_texts.dart
new file mode 100644
index 0000000..ba0fa9d
--- /dev/null
+++ b/flutter/lib/common/hjviewer_access_texts.dart
@@ -0,0 +1,130 @@
+// The access screens' texts, in Korean and English, and the choices between them (the hjviewer
+// repository's docs/access-tickets.md 5-3): the session's dialog after hbbs refused a connection
+// for access (A1, A2), the PC home's notice while hbbs refuses this PC's registration (P1), the
+// PC's access password (P2), the hint to keep an unattended PC logged in (G1) and why the access
+// password brought no ticket (E1 to E5). Plain Dart without the bridge, so that ci.sh tests it
+// with the web stand-in; hjviewer_access.dart shows them.
+
+import 'dart:convert';
+
+/// The msgbox type of a refusal for access (src/hjviewer_access.rs MSGBOX_TYPE).
+const kHjvAccessMsgbox = 'hjv-access-error';
+
+/// The option of the process that registers (the service of an installed PC): "ok" or
+/// "refused", whether hbbs took this PC's last registration (src/hjviewer_access.rs PC_STATE).
+const kHjvAccessPcState = 'hjv-access-pc';
+
+/// main_set_common: the access password's ticket for one PC (src/hjviewer_access/guest.rs).
+const kHjvGuestCtl = 'hjv-guest-ctl';
+
+/// main_set_common: the access password's ticket of this PC.
+const kHjvGuestPc = 'hjv-guest-pc';
+
+/// What main_set_common gets for the ticket for the PC `to`.
+String hjvGuestCtlValue(String to, String password) =>
+    jsonEncode({'to': to, 'password': password});
+
+/// What main_set_common gets for this PC's ticket.
+String hjvGuestPcValue(String password) => jsonEncode({'password': password});
+
+/// The main_get_common key of the last exchange's result: for the PC `to`, else this PC's.
+String hjvGuestResultKey({String? to}) =>
+    to == null ? 'hjv-guest-result:pc' : 'hjv-guest-result:ctl:$to';
+
+/// What an exchange's result says: null when a ticket came, else hjv-api's code or the app's
+/// own ("network" for a result that is none).
+String? hjvGuestFailure(String result) {
+  try {
+    final value = jsonDecode(result);
+    if (value is Map) {
+      if (value['ok'] == true) return null;
+      final error = value['error'];
+      if (error is String && error.isNotEmpty) return error;
+    }
+  } catch (e) {
+    // no result: the core noted none
+  }
+  return 'network';
+}
+
+/// The access password as it is sent: without the spaces around it, which a pasted one brings
+/// and which deploy/guest-conf.py never takes into one.
+String hjvAccessPassword(String typed) => typed.trim();
+
+/// One exchange of the access password (A1, P2): `ask` hands it to the core, which answers once
+/// the exchange is over, and `result` reads what the core noted. Null when a ticket came, else
+/// the text that says why none did.
+Future<String?> hjvTradeAccessPassword(HjvAccessTexts t,
+    {required Future<void> Function() ask,
+    required String Function() result}) async {
+  try {
+    await ask();
+  } catch (e) {
+    return t.failure('network');
+  }
+  final failure = hjvGuestFailure(result());
+  return failure == null ? null : t.failure(failure);
+}
+
+/// Whether the PC home shows P1: while hbbs refuses this PC's registration. A server that checks
+/// nothing (MODE=off) never refuses, so the home stays as it was.
+bool hjvShowsPcNotice(String state) => state == 'refused';
+
+class HjvAccessTexts {
+  final bool korean;
+  const HjvAccessTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  String get ok => _t('확인', 'OK');
+  String get cancel => _t('취소', 'Cancel');
+  String get logIn => _t('로그인', 'Log in');
+
+  // A1: a controller without a login that hbbs refused
+  String get refused => _t(
+      'HJViewer는 연세대학교 교직원용입니다. 연세포탈로 로그인하거나 이용 비밀번호를 넣으세요. (access not allowed)',
+      'HJViewer is for Yonsei University staff. Log in with your Yonsei portal account, or enter the access password. (access not allowed)');
+  String get connectWithPassword =>
+      _t('이용 비밀번호로 연결', 'Connect with the access password');
+  String get passwordTitle => _t('이용 비밀번호', 'Access password');
+  String get passwordHint => _t('관리자가 알려 준 비밀번호입니다. PC의 일회용 비밀번호가 아닙니다.',
+      "The password your administrator gave you, not the PC's one-time password.");
+
+  // A2: a logged-in controller refused again with a new ticket
+  String get refusedAgain => _t(
+      '서버가 이 연결을 받지 않았습니다. 잠시 뒤 다시 시도하고, 계속되면 관리자에게 알려 주세요. (access not allowed)',
+      'The server did not accept this connection. Try again in a moment, and tell your administrator if it keeps happening. (access not allowed)');
+
+  // P1: this PC's registration refused
+  String get pcTitle => _t(
+      '이 PC는 아직 서버에 연결되지 않았습니다', 'This PC is not connected to the server yet');
+  String get pcText => _t('이 PC를 연결받으려면 연세포탈로 로그인하거나 이용 비밀번호를 넣으세요.',
+      'To accept connections on this PC, log in with your Yonsei portal account or enter the access password.');
+  String get pcPassword => _t('이용 비밀번호', 'Access password');
+
+  // P2: the PC's access password
+  String get pcPasswordText => _t(
+      '이용 비밀번호를 넣으면 이 PC가 최대 12시간 동안 연결을 받습니다. 끝나면 다시 넣어야 합니다.',
+      'With the access password, this PC accepts connections for up to 12 hours. After that, enter it again.');
+
+  // G1: the install page and the settings
+  String get keepLoggedIn => _t(
+      '사람이 없을 때도 이 PC에 연결하려면 연세포탈로 로그인해 두세요. 이용 비밀번호는 앱을 켤 때마다 넣어야 합니다.',
+      'To reach this PC when nobody is at it, keep it logged in with your Yonsei portal account. The access password has to be entered each time the app starts.');
+
+  /// E1 to E5: why the access password brought no ticket, by hjv-api's code or the app's own.
+  String failure(String code) => switch (code) {
+        'denied' => _t('이용 비밀번호가 맞지 않거나, 지금은 서버가 이용 비밀번호를 받지 않습니다.',
+            'The access password is wrong, or the server does not take the access password right now.'),
+        'rate_limited' => _t('시도가 너무 많습니다. 잠시 뒤 다시 해 주세요.',
+            'Too many tries. Please try again later.'),
+        'wrong_pc' => _t(
+            '이 PC의 키가 서버에 있는 것과 달라 이용 비밀번호로 연결받을 수 없습니다. 관리자에게 알려 주세요.',
+            "This PC's key differs from the one the server has, so it cannot accept connections with the access password. Please tell your administrator."),
+        'clock' => _t('기기의 날짜와 시간이 맞지 않습니다. 날짜와 시간을 자동으로 맞추게 한 뒤 다시 해 주세요.',
+            "The device's date and time are wrong. Set them to update automatically and try again."),
+        // busy, unavailable, bad_request, network, config
+        _ => _t('지금은 이용 비밀번호를 확인할 수 없습니다. 잠시 뒤 다시 해 주세요.',
+            'The access password cannot be checked right now. Please try again in a moment.'),
+      };
+}
