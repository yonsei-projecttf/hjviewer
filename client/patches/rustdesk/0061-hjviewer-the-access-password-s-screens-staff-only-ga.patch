diff --git a/src/hjviewer_access/guest.rs b/src/hjviewer_access/guest.rs
new file mode 100644
index 0000000..0188ea9
--- /dev/null
+++ b/src/hjviewer_access/guest.rs
@@ -0,0 +1,510 @@
+//! The access password (이용 비밀번호, the doc 3-5): someone who is not logged in types the
+//! password the operator set, and the app trades it for one ticket of one PC with
+//! `POST /api/hjv/guest`, then forgets it. A controller's ticket reaches the PC it connects to and
+//! stays in this process's memory for that target (`keep_guest`); a PC's registers this PC and
+//! goes, over the IPC, to the process that registers it (`Data::HjvGuestPc`), never to a file.
+//!
+//! The screens ask through main_set_common, which waits for the exchange, and read its result
+//! with main_get_common:
+//!   set "hjv-guest-ctl"  {"to":"<PC ID>","password":"…"}     the ticket for that PC
+//!   set "hjv-guest-pc"   {"password":"…"}                     the ticket of this PC
+//!   get "hjv-guest-result:ctl:<PC ID>" | "hjv-guest-result:pc"
+//!       {"ok":true} or {"ok":false,"error":"denied"|"rate_limited"|"busy"|"unavailable"|
+//!       "wrong_pc"|"clock"|"bad_request"|"network"|"config"}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+use super::{device, Held};
+use super::{keep_guest, keep_guest_pc, Device, MAX_ANSWER, SERVER};
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+use hbb_common::tokio;
+use hbb_common::{
+    base64::{
+        engine::general_purpose::{STANDARD, URL_SAFE_NO_PAD},
+        Engine as _,
+    },
+    log,
+    sodiumoxide::{
+        crypto::{box_, sealedbox, sign},
+        randombytes,
+        utils::memzero,
+    },
+};
+use serde_derive::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{collections::BTreeMap, io::Read, sync::Mutex, time::Duration};
+
+const GUEST_PATH: &str = "/api/hjv/guest";
+/// What a PC's device key signs with its request (server/api/src/guest.rs PC_CONTEXT).
+const PC_CONTEXT: &[u8] = b"hjv-guest-pc-v1";
+const SEALED_PREFIX: &str = "hjv-sealed-v1.";
+/// The seal's purpose: a login never takes such a seal, nor this path a login's.
+const PURPOSE: &str = "guest";
+/// hjv-api holds every refusal for about two seconds; a slow network gets the rest.
+const TIMEOUT: Duration = Duration::from_secs(20);
+/// hjv-api's limit (seal.rs).
+const MAX_PASSWORD: usize = 256;
+
+/// Why no ticket came: hjv-api's code (the doc 3-5), or the app's own.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Failure {
+    /// 401: a wrong password, or none taken now
+    Denied,
+    /// 429
+    TooOften,
+    /// 503: two hashes running
+    Busy,
+    /// 503: no ticket key, or hbbs's console not answering
+    Unavailable,
+    /// 403: hbbs holds another key for this PC
+    WrongPc,
+    /// 409: the seal's time is off, also after it was set by the server's
+    Clock,
+    /// 400, or an answer of another form
+    BadRequest,
+    /// no answer, or not hjv-api's
+    Network,
+    /// a build without the account settings, a password out of bounds, no device key
+    Config,
+}
+
+impl Failure {
+    fn code(self) -> &'static str {
+        match self {
+            Failure::Denied => "denied",
+            Failure::TooOften => "rate_limited",
+            Failure::Busy => "busy",
+            Failure::Unavailable => "unavailable",
+            Failure::WrongPc => "wrong_pc",
+            Failure::Clock => "clock",
+            Failure::BadRequest => "bad_request",
+            Failure::Network => "network",
+            Failure::Config => "config",
+        }
+    }
+
+    /// The failure of an answer of `status` whose body says `hjv`.
+    fn of(status: u16, hjv: &str) -> Failure {
+        match (status, hjv) {
+            (401, _) => Failure::Denied,
+            (429, _) => Failure::TooOften,
+            (403, "wrong_pc") => Failure::WrongPc,
+            (409, "clock") => Failure::Clock,
+            (503, "busy") => Failure::Busy,
+            (502..=504, _) => Failure::Unavailable,
+            (400, _) => Failure::BadRequest,
+            _ => Failure::Network,
+        }
+    }
+}
+
+/// The sealed payload (server/api/src/seal.rs, the doc 3-5).
+#[derive(Serialize)]
+struct Payload<'a> {
+    v: u32,
+    p: &'a str,
+    #[serde(rename = "use")]
+    use_: &'a str,
+    pw: &'a str,
+    t: u64,
+    n: &'a str,
+    id: &'a str,
+    kid: &'a str,
+}
+
+/// The `password` field of a request, and the SHA-256 of its sealed bytes.
+struct Sealed {
+    field: String,
+    hash: [u8; 32],
+}
+
+/// Seals `password` for a ticket of `use_` that reaches the PC `id`, at `t` by the server's
+/// clock, with the nonce `n`.
+fn seal(seal_pk: &[u8; 32], password: &str, use_: &str, id: &str, t: u64, n: &[u8]) -> Sealed {
+    let kid = crate::hjviewer_account::seal_kid(seal_pk);
+    let n = STANDARD.encode(n);
+    // strings and numbers always serialize
+    let mut payload = serde_json::to_vec(&Payload {
+        v: 1,
+        p: PURPOSE,
+        use_,
+        pw: password,
+        t,
+        n: &n,
+        id,
+        kid: &kid,
+    })
+    .unwrap_or_default();
+    let sealed = sealedbox::seal(&payload, &box_::PublicKey(*seal_pk));
+    memzero(&mut payload);
+    Sealed {
+        field: format!("{SEALED_PREFIX}{kid}.{}", URL_SAFE_NO_PAD.encode(&sealed)),
+        hash: Sha256::digest(&sealed).into(),
+    }
+}
+
+/// What a PC's device key signs: the context, its ID, its key as sent (standard base64) and the
+/// standard base64 of the sealed bytes' SHA-256, joined by NUL bytes.
+fn pc_message(id: &str, pk: &str, sealed_hash: &[u8]) -> Vec<u8> {
+    let hash = STANDARD.encode(sealed_hash);
+    [PC_CONTEXT, id.as_bytes(), pk.as_bytes(), hash.as_bytes()].join(&0u8)
+}
+
+/// The body of a controller's request for the PC `to`.
+fn ctl_body(to: &str, sealed: &Sealed) -> String {
+    json!({ "use": "ctl", "to": to, "password": sealed.field }).to_string()
+}
+
+/// The body of this PC's request, signed by its device key over the seal.
+fn pc_body(device: &Device, sealed: &Sealed) -> String {
+    let pk = STANDARD.encode(&device.pk);
+    let sig = sign::sign_detached(&pc_message(&device.id, &pk, &sealed.hash), &device.sk);
+    json!({
+        "use": "pc",
+        "id": device.id,
+        "pk": pk,
+        "sig": STANDARD.encode(sig.to_bytes()),
+        "password": sealed.field,
+    })
+    .to_string()
+}
+
+/// A ticket for `use_` (`ctl` for the PC `id`, `pc` for this PC `device`): the ticket object of
+/// the 200 answer, or why there is none. One request, and once more after a 409 `clock`, whose
+/// server time the account module learns as from any account answer. It blocks.
+fn exchange(
+    use_: &str,
+    id: &str,
+    password: &str,
+    device: Option<&Device>,
+) -> Result<Value, Failure> {
+    let server = SERVER
+        .filter(|server| !server.is_empty())
+        .ok_or(Failure::Config)?;
+    let seal_pk = crate::hjviewer_account::seal_pubkey().ok_or(Failure::Config)?;
+    if password.is_empty() || password.len() > MAX_PASSWORD {
+        return Err(Failure::Config);
+    }
+    let url = format!("https://{server}{GUEST_PATH}");
+    let mut again = true;
+    loop {
+        let _ = hbb_common::sodiumoxide::init();
+        let mut n = [0u8; 16];
+        randombytes::randombytes_into(&mut n);
+        let t = crate::hjviewer_account::server_time();
+        let sealed = seal(&seal_pk, password, use_, id, t, &n);
+        let body = match device {
+            Some(device) => pc_body(device, &sealed),
+            None => ctl_body(id, &sealed),
+        };
+        let (status, date, text) = post(&url, body)?;
+        crate::hjviewer_account::observe_account_response(
+            &url,
+            &json!({ "status_code": status, "headers": { "date": date }, "body": text })
+                .to_string(),
+        );
+        let answer = serde_json::from_str::<Value>(&text).map_err(|_| Failure::Network)?;
+        if status == 200 {
+            return Ok(answer);
+        }
+        let hjv = answer
+            .get("hjv")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        let failure = Failure::of(status, hjv);
+        if !(again && failure == Failure::Clock) {
+            return Err(failure);
+        }
+        again = false;
+    }
+}
+
+/// POSTs `body` to `url` with the certificate checked: the status, the Date header and at most
+/// MAX_ANSWER bytes of the body.
+fn post(url: &str, body: String) -> Result<(u16, String, String), Failure> {
+    let client =
+        crate::hbbs_http::create_http_client_with_url_strict(url).map_err(|_| Failure::Network)?;
+    let response = client
+        .post(url)
+        .header(reqwest::header::CONTENT_TYPE, "application/json")
+        .body(body)
+        .timeout(TIMEOUT)
+        .send()
+        .map_err(|_| Failure::Network)?;
+    // the client follows redirections: an answer from elsewhere is not hjv-api's
+    if url::Url::parse(url).ok().as_ref() != Some(response.url()) {
+        return Err(Failure::Network);
+    }
+    let status = response.status().as_u16();
+    let date = response
+        .headers()
+        .get(reqwest::header::DATE)
+        .and_then(|date| date.to_str().ok())
+        .unwrap_or_default()
+        .to_owned();
+    let mut text = Vec::new();
+    response
+        .take(MAX_ANSWER)
+        .read_to_end(&mut text)
+        .map_err(|_| Failure::Network)?;
+    Ok((status, date, String::from_utf8_lossy(&text).into_owned()))
+}
+
+/// The last result of each exchange, for the screens: "ctl:<PC ID>" and "pc".
+static RESULTS: Mutex<BTreeMap<String, String>> = Mutex::new(BTreeMap::new());
+
+fn note(key: String, result: Result<(), Failure>) {
+    let value = match result {
+        Ok(()) => json!({ "ok": true }),
+        Err(failure) => json!({ "ok": false, "error": failure.code() }),
+    };
+    RESULTS
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(key, value.to_string());
+}
+
+#[derive(Deserialize)]
+struct CtlAsk {
+    to: String,
+    password: String,
+}
+
+#[derive(Deserialize)]
+struct PcAsk {
+    password: String,
+}
+
+/// main_set_common: `hjv-guest-ctl` and `hjv-guest-pc`, each when its exchange is over; false
+/// for any other key.
+pub(super) fn set_common(key: &str, value: &str) -> bool {
+    match key {
+        "hjv-guest-ctl" => {
+            let Ok(CtlAsk { to, password }) = serde_json::from_str::<CtlAsk>(value) else {
+                return true;
+            };
+            // the session's ID, as Client::start has it (LoginConfigHandler::initialize)
+            let result = for_controller(crate::ui_interface::handle_relay_id(&to), &password);
+            memzero(&mut password.into_bytes());
+            note(format!("ctl:{to}"), result);
+            true
+        }
+        "hjv-guest-pc" => {
+            let Ok(PcAsk { password }) = serde_json::from_str::<PcAsk>(value) else {
+                return true;
+            };
+            let result = for_this_pc(&password);
+            memzero(&mut password.into_bytes());
+            note("pc".to_owned(), result);
+            true
+        }
+        _ => false,
+    }
+}
+
+/// main_get_common: `hjv-guest-result:<what>`, the last exchange's (none: "").
+pub(super) fn get_common(key: &str) -> Option<String> {
+    let what = key.strip_prefix("hjv-guest-result:")?;
+    let results = RESULTS.lock().unwrap_or_else(|e| e.into_inner());
+    Some(results.get(what).cloned().unwrap_or_default())
+}
+
+/// The ticket of a controller for the PC `to`, kept for it in this process's memory.
+pub(super) fn for_controller(to: &str, password: &str) -> Result<(), Failure> {
+    let answer = exchange("ctl", to, password, None)?;
+    if keep_guest(to, &answer) {
+        Ok(())
+    } else {
+        Err(Failure::BadRequest)
+    }
+}
+
+/// The ticket of this PC, handed to the process that registers it (this one when it is not
+/// installed): over the IPC, never through a file.
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub(super) fn for_this_pc(password: &str) -> Result<(), Failure> {
+    let device = device().ok_or(Failure::Config)?;
+    let answer = exchange("pc", &device.id, password, Some(&device))?;
+    if Held::issued(&answer, super::unix_now())
+        .filter(Held::registers)
+        .is_none()
+    {
+        return Err(Failure::BadRequest);
+    }
+    let value = answer.to_string();
+    // the IPC call starts a runtime of its own, so it runs off this thread, which may be on one
+    let sent = std::thread::spawn(move || send(value))
+        .join()
+        .unwrap_or(false);
+    if sent {
+        Ok(())
+    } else {
+        log::warn!("access tickets: the access password's PC ticket did not reach the service");
+        Err(Failure::Network)
+    }
+}
+
+#[cfg(any(target_os = "android", target_os = "ios"))]
+pub(super) fn for_this_pc(_password: &str) -> Result<(), Failure> {
+    // a phone registers no PC (Android builds are controller-only)
+    Err(Failure::Config)
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+#[tokio::main(flavor = "current_thread")]
+async fn send(value: String) -> bool {
+    let Ok(mut conn) = crate::ipc::connect(1000, "").await else {
+        return false;
+    };
+    conn.send(&crate::ipc::Data::HjvGuestPc(value))
+        .await
+        .is_ok()
+}
+
+/// The process that registers (ipc.rs): the ticket a screen got for this PC, in memory only; an
+/// empty value ends it.
+pub(super) fn from_ipc(value: &str) {
+    if value.is_empty() {
+        super::forget_guest_pc();
+        return;
+    }
+    match serde_json::from_str::<Value>(value) {
+        Ok(answer) if keep_guest_pc(&answer) => {}
+        _ => log::warn!("access tickets: an access password's PC ticket that is none"),
+    }
+}
+
+/// `HJV_E2E_ACCESS_PASSWORD` of the E2E's connect commands: the ticket for the PC `to` in this
+/// process, before the session starts. 0, or 6 when none came.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) fn e2e_controller(to: &str, password: &str) -> i32 {
+    match for_controller(to, password) {
+        Ok(()) => {
+            println!("hjv-e2e: guest ctl: ok");
+            0
+        }
+        Err(failure) => {
+            println!("hjv-e2e: guest ctl: {}", failure.code());
+            6
+        }
+    }
+}
+
+/// `--hjv-e2e-guest-pc <password>`: this PC's ticket, handed to the service. 0, or 6.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) fn e2e_pc(password: &str) -> i32 {
+    match for_this_pc(password) {
+        Ok(()) => {
+            println!("hjv-e2e: guest pc: ok");
+            0
+        }
+        Err(failure) => {
+            println!("hjv-e2e: guest pc: {}", failure.code());
+            6
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// server/api/README.md, The access password: the vectors' PC key (seed 0x02 repeated) and
+    /// the login seal vector's sealed hash, signed as hjv-api's tests and OpenSSL sign it.
+    const PK: &str = "gTl3Dqh9F19Wo1Rmw0x+zMuNipG07jeiXfYPW4/Js5Q=";
+    const SEALED_HASH: &str = "qIDSw48Gkb5KSslffq/QEWRaClx5ihVLTE5+jqOHQ6Q=";
+    const SIGNED_HEX: &str = "686a762d67756573742d70632d7631003132333435363738390067546c3344716839463139576f31526d7730782b7a4d754e69704730376a65695866595057342f4a7335513d0071494453773438476b62354b53736c6666712f5145575261436c78356968564c5445352b6a714f485136513d";
+    const SIG: &str =
+        "LCgw71tbHtZvAgBNOoElzNffv/sjmraHOBM/jvDp1fiGwvACfrVddPgq/FbR25j+KhE5fvd5rf2nT1KFbi0UDg==";
+
+    fn device() -> Device {
+        let _ = hbb_common::sodiumoxide::init();
+        let (pk, sk) = sign::keypair_from_seed(&sign::Seed([2; 32]));
+        Device {
+            id: "123456789".into(),
+            sk,
+            pk: pk.0.to_vec(),
+        }
+    }
+
+    #[test]
+    fn a_pcs_signature_is_hjv_apis() {
+        let device = device();
+        assert_eq!(STANDARD.encode(&device.pk), PK);
+        let hash = STANDARD.decode(SEALED_HASH).unwrap();
+        let message = pc_message(&device.id, PK, &hash);
+        assert_eq!(hex::encode(&message), SIGNED_HEX);
+        let sig = sign::sign_detached(&message, &device.sk);
+        assert_eq!(STANDARD.encode(sig.to_bytes()), SIG);
+        // the body carries exactly these members, the signature over its own seal
+        let sealed = Sealed {
+            field: "hjv-sealed-v1.k.s".into(),
+            hash: hash.try_into().unwrap(),
+        };
+        let body: Value = serde_json::from_str(&pc_body(&device, &sealed)).unwrap();
+        assert_eq!(
+            body,
+            json!({"use": "pc", "id": "123456789", "pk": PK, "sig": SIG,
+                   "password": "hjv-sealed-v1.k.s"})
+        );
+        let body: Value = serde_json::from_str(&ctl_body("222333444", &sealed)).unwrap();
+        assert_eq!(
+            body,
+            json!({"use": "ctl", "to": "222333444", "password": "hjv-sealed-v1.k.s"})
+        );
+    }
+
+    #[test]
+    fn the_seal_opens_to_the_access_passwords_payload() {
+        let _ = hbb_common::sodiumoxide::init();
+        let (pk, sk) = box_::gen_keypair();
+        let sealed = seal(
+            &pk.0,
+            "pass word",
+            "ctl",
+            "222333444",
+            1_760_000_000,
+            &[1; 16],
+        );
+        let kid = crate::hjviewer_account::seal_kid(&pk.0);
+        let rest = sealed
+            .field
+            .strip_prefix(&format!("{SEALED_PREFIX}{kid}."))
+            .unwrap();
+        let bytes = URL_SAFE_NO_PAD.decode(rest).unwrap();
+        assert_eq!(<[u8; 32]>::from(Sha256::digest(&bytes)), sealed.hash);
+        let opened = sealedbox::open(&bytes, &pk, &sk).unwrap();
+        let payload: Value = serde_json::from_slice(&opened).unwrap();
+        assert_eq!(
+            payload,
+            json!({"v": 1, "p": "guest", "use": "ctl", "pw": "pass word", "t": 1_760_000_000u64,
+                   "n": STANDARD.encode([1u8; 16]), "id": "222333444", "kid": kid})
+        );
+    }
+
+    #[test]
+    fn the_answers_of_hjv_api() {
+        assert_eq!(Failure::of(401, "denied"), Failure::Denied);
+        assert_eq!(Failure::of(429, "rate_limited"), Failure::TooOften);
+        assert_eq!(Failure::of(403, "wrong_pc"), Failure::WrongPc);
+        assert_eq!(Failure::of(403, ""), Failure::Network);
+        assert_eq!(Failure::of(409, "clock"), Failure::Clock);
+        assert_eq!(Failure::of(503, "busy"), Failure::Busy);
+        assert_eq!(Failure::of(503, "unavailable"), Failure::Unavailable);
+        assert_eq!(Failure::of(502, ""), Failure::Unavailable);
+        assert_eq!(Failure::of(400, "bad_request"), Failure::BadRequest);
+        // what the screens read
+        note("ctl:1".into(), Err(Failure::Denied));
+        assert_eq!(
+            get_common("hjv-guest-result:ctl:1").as_deref(),
+            Some(r#"{"error":"denied","ok":false}"#)
+        );
+        note("ctl:1".into(), Ok(()));
+        assert_eq!(
+            get_common("hjv-guest-result:ctl:1").as_deref(),
+            Some(r#"{"ok":true}"#)
+        );
+        assert_eq!(get_common("hjv-guest-result:pc").as_deref(), Some(""));
+        assert_eq!(get_common("hjv-access-state"), None);
+    }
+}
