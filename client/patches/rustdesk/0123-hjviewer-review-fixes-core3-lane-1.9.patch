diff --git a/flutter/lib/common/hjviewer_incoming_list.dart b/flutter/lib/common/hjviewer_incoming_list.dart
new file mode 100644
index 0000000..c520d04
--- /dev/null
+++ b/flutter/lib/common/hjviewer_incoming_list.dart
@@ -0,0 +1,261 @@
+// TV-W9: the body of the list '이 PC에 들어온 연결' (hjviewer_incoming.dart opens it in a dialog).
+// Plain Flutter without the bridge, so that its layout and keyboard can be tested.
+//
+// The list has a fixed height (an AlertDialog(scrollable: true) asks its content for its
+// intrinsic size, which a shrink-wrapping list cannot give). Each row takes the focus: Tab and the
+// arrows walk the rows and scroll the focused one into view, PageUp, PageDown, Home and End
+// scroll the list, and a focused row with a name the PC did not check shows the tip its tooltip
+// gives the mouse.
+
+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjviewer_incoming_rules.dart';
+
+/// The list's height at most; a shorter list is as high as its rows are estimated to be.
+const double kHjvIncomingListMax = 420;
+
+/// The estimated heights of a day's header and of a row (three lines), for a list shorter than
+/// kHjvIncomingListMax; a row that turns out taller only makes the list scroll.
+const double _kHeader = 34;
+const double _kRow = 80;
+
+/// The list's body: a bar while it is read (null), the error, the PC that does not record, no rows
+/// yet, or the rows under their days with the footer.
+class HjvIncomingListView extends StatelessWidget {
+  final HjvIncomingTexts t;
+
+  /// null while it is read
+  final HjvIncomingList? list;
+
+  /// the clock the days are told by (tests set it)
+  final DateTime? now;
+  const HjvIncomingListView(
+      {super.key, required this.t, required this.list, this.now});
+
+  @override
+  Widget build(BuildContext context) {
+    final p = HjvPalette.of(context);
+    final small = TextStyle(fontSize: 12, height: 1.4, color: p.textTertiary);
+    final list = this.list;
+    final Widget body;
+    if (list == null) {
+      body = LinearProgressIndicator(semanticsLabel: t.loading);
+    } else if (list.state == HjvIncomingState.error) {
+      body = HjvCallout(text: t.readFailed, tone: HjvTone.danger);
+    } else if (list.state == HjvIncomingState.off) {
+      body = HjvCallout(text: t.off);
+    } else if (list.rows.isEmpty) {
+      body = Text(t.empty, style: TextStyle(color: p.textSecondary));
+    } else {
+      final now = this.now ?? DateTime.now();
+      final items = <Widget>[];
+      var headers = 0;
+      for (final (day, rows) in hjvIncomingDays(list.rows)) {
+        headers++;
+        items.add(Padding(
+          padding: const EdgeInsets.only(top: 12, bottom: 4),
+          child: Semantics(
+            header: true,
+            child: Text(t.day(day, now),
+                style: TextStyle(
+                    fontSize: 13,
+                    fontWeight: FontWeight.w600,
+                    color: p.textTertiary)),
+          ),
+        ));
+        for (final row in rows) {
+          items.add(HjvIncomingTile(t: t, row: row, now: now));
+        }
+      }
+      final height = math.min(
+          kHjvIncomingListMax, headers * _kHeader + list.rows.length * _kRow);
+      body = SizedBox(height: height, child: _HjvIncomingScroll(items: items));
+    }
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        body,
+        if (list?.state == HjvIncomingState.ok)
+          Padding(
+            padding: const EdgeInsets.only(top: 12),
+            child: Text(t.footer, style: small),
+          ),
+      ],
+    );
+  }
+}
+
+/// The rows with a scrollbar; while a row has the focus the arrows walk the rows and PageUp,
+/// PageDown, Home and End scroll the list.
+class _HjvIncomingScroll extends StatefulWidget {
+  final List<Widget> items;
+  const _HjvIncomingScroll({required this.items});
+
+  @override
+  State<_HjvIncomingScroll> createState() => _HjvIncomingScrollState();
+}
+
+class _HjvIncomingScrollState extends State<_HjvIncomingScroll> {
+  final _controller = ScrollController();
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  KeyEventResult _onKey(FocusNode node, KeyEvent event) {
+    if (event is! KeyDownEvent && event is! KeyRepeatEvent) {
+      return KeyEventResult.ignored;
+    }
+    if (!_controller.hasClients) return KeyEventResult.ignored;
+    final position = _controller.position;
+    final page = position.viewportDimension * 0.9;
+    final double to;
+    final key = event.logicalKey;
+    // the arrows walk the rows as Tab does, which scrolls the focused one into view
+    if (key == LogicalKeyboardKey.arrowDown) {
+      FocusManager.instance.primaryFocus?.nextFocus();
+      return KeyEventResult.handled;
+    }
+    if (key == LogicalKeyboardKey.arrowUp) {
+      FocusManager.instance.primaryFocus?.previousFocus();
+      return KeyEventResult.handled;
+    }
+    if (key == LogicalKeyboardKey.pageDown) {
+      to = position.pixels + page;
+    } else if (key == LogicalKeyboardKey.pageUp) {
+      to = position.pixels - page;
+    } else if (key == LogicalKeyboardKey.home) {
+      to = position.minScrollExtent;
+    } else if (key == LogicalKeyboardKey.end) {
+      to = position.maxScrollExtent;
+    } else {
+      return KeyEventResult.ignored;
+    }
+    _controller
+        .jumpTo(to.clamp(position.minScrollExtent, position.maxScrollExtent));
+    return KeyEventResult.handled;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Focus(
+      canRequestFocus: false,
+      skipTraversal: true,
+      onKeyEvent: _onKey,
+      child: Scrollbar(
+        controller: _controller,
+        thumbVisibility: true,
+        child: ListView.builder(
+          controller: _controller,
+          // room for the scrollbar
+          padding: const EdgeInsets.only(right: 12),
+          itemCount: widget.items.length,
+          itemBuilder: (_, i) => widget.items[i],
+        ),
+      ),
+    );
+  }
+}
+
+/// One row: its three lines, spoken as one sentence; it takes the focus (a ring in the accent),
+/// and a focused row with a name the PC did not check shows the tip.
+class HjvIncomingTile extends StatefulWidget {
+  final HjvIncomingTexts t;
+  final HjvIncomingRow row;
+  final DateTime now;
+  const HjvIncomingTile(
+      {super.key, required this.t, required this.row, required this.now});
+
+  @override
+  State<HjvIncomingTile> createState() => _HjvIncomingTileState();
+}
+
+class _HjvIncomingTileState extends State<HjvIncomingTile>
+    with AutomaticKeepAliveClientMixin {
+  bool _focused = false;
+
+  /// A focused row stays built when PageDown or End scrolls it away, so that the keys still
+  /// reach the list.
+  @override
+  bool get wantKeepAlive => _focused;
+
+  void _onFocus(bool focused) {
+    setState(() => _focused = focused);
+    updateKeepAlive();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    super.build(context);
+    final t = widget.t;
+    final row = widget.row;
+    final p = HjvPalette.of(context);
+    final second = TextStyle(fontSize: 13, height: 1.4, color: p.textSecondary);
+    final verified = row.verified;
+    final tip = !verified && row.name.isNotEmpty ? t.unverifiedTip : null;
+    Widget third = Row(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        if (verified)
+          Padding(
+            padding: const EdgeInsets.only(top: 1, right: 4),
+            child:
+                Icon(Icons.verified_user_rounded, size: 15, color: p.primary),
+          ),
+        Expanded(child: Text(t.line3(row), style: second)),
+      ],
+    );
+    if (tip != null) third = Tooltip(message: tip, child: third);
+    final line2 = t.line2(row);
+    return MergeSemantics(
+      child: Focus(
+        onFocusChange: _onFocus,
+        child: Semantics(
+          label: t.spoken(row, widget.now),
+          hint: tip,
+          excludeSemantics: true,
+          child: Container(
+            width: double.infinity,
+            padding:
+                EdgeInsets.symmetric(vertical: 8, horizontal: _focused ? 6 : 0),
+            decoration: _focused
+                ? BoxDecoration(
+                    border: Border.all(color: p.primary, width: 2),
+                    borderRadius: BorderRadius.circular(6))
+                : BoxDecoration(
+                    border: Border(bottom: BorderSide(color: p.border))),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(t.line1(row),
+                    style: TextStyle(
+                        fontSize: 14,
+                        fontWeight: FontWeight.w600,
+                        color: p.text)),
+                if (line2.isNotEmpty)
+                  Padding(
+                    padding: const EdgeInsets.only(top: 2),
+                    child: Text(line2, style: second),
+                  ),
+                Padding(padding: const EdgeInsets.only(top: 2), child: third),
+                if (_focused && tip != null)
+                  Padding(
+                    padding: const EdgeInsets.only(top: 2),
+                    child: Text(tip,
+                        style: TextStyle(
+                            fontSize: 12, height: 1.4, color: p.textTertiary)),
+                  ),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
