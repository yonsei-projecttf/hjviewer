+/// What a start line keeps (design 6-1): a staff row keeps no name (S-05), a mark the list does
+/// not know is "", the device and the owner stay, and audit types 0-4 are the kinds by name.
+#[test]
+fn a_start_line_keeps_what_the_list_shows() {
+    let line = start_line(&a_start(crate::hjviewer_cm::STAFF, 0), RUN, 3, NOW);
+    assert_eq!(
+        (line.e.as_str(), line.r.as_str(), line.n, line.t),
+        ("s", RUN, 3, NOW)
+    );
+    assert_eq!((line.name.as_str(), line.ver.as_str()), ("", "staff"));
+    assert_eq!(line.sid, 42);
+    let line = start_line(&a_start(crate::hjviewer_cm::SAME_ACCOUNT, 0), RUN, 3, NOW);
+    assert_eq!(
+        (
+            line.name.as_str(),
+            line.dev.as_str(),
+            line.own.as_str(),
+            line.ver.as_str(),
+            line.auth.as_str()
+        ),
+        (
+            "kim's laptop",
+            "Office PC",
+            "홍*동",
+            "same-account",
+            "permanent"
+        )
+    );
+    let line = start_line(&a_start("something else", 0), RUN, 3, NOW);
+    assert_eq!(
+        (line.name.as_str(), line.ver.as_str()),
+        ("kim's laptop", "")
+    );
+    assert_eq!(
+        start_line(
+            &a_start(crate::hjviewer_cm::UNVERIFIED_NAME, 0),
+            RUN,
+            3,
+            NOW
+        )
+        .ver,
+        "unverified-name"
+    );
+    for (kind, name) in [
+        (0, "remote"),
+        (1, "file"),
+        (2, "forward"),
+        (3, "camera"),
+        (4, "terminal"),
+        (9, "remote"),
+    ] {
+        assert_eq!(start_line(&a_start("", kind), RUN, 3, NOW).kind, name);
+    }
+    let line = end_line(RUN, 3, NOW, "connection manager");
+    assert_eq!(
+        (line.e.as_str(), line.end.as_str(), line.id.as_str()),
+        ("e", "pc", "")
+    );
+}
