+/// out the old connection's Timeout, so the new start is before the old row's `lost` end. One row,
+/// ending as the connection that ended last.
+#[test]
+fn a_reconnect_before_the_lost_end_continues_its_row() {
+    let fold_with = |extra: Vec<String>| {
+        let mut lines = vec![
+            start(RUN, 1, NOW - 1000, "111", 7, "remote"),
+            end(RUN, 1, NOW - 900, "lost"),
+        ];
+        lines.extend(extra);
+        fold(&text(&lines), RUN, NOW)
+    };
+    // 10 s before the old row's Timeout end
+    let rows = fold_with(vec![
+        start(RUN, 2, NOW - 910, "111", 7, "remote"),
+        end(RUN, 2, NOW - 700, "peer"),
+    ]);
+    assert_eq!(rows.len(), 1);
+    assert_eq!(
+        (rows[0].t0, rows[0].t1, rows[0].end.as_str(), rows[0].re),
+        (NOW - 1000, Some(NOW - 700), "peer", 1)
+    );
+    // the new one ended first: the row keeps the old one's later end
+    let rows = fold_with(vec![
+        start(RUN, 2, NOW - 950, "111", 7, "remote"),
+        end(RUN, 2, NOW - 920, "pc"),
+    ]);
+    assert_eq!(rows.len(), 1);
+    assert_eq!(
+        (rows[0].t1, rows[0].end.as_str(), rows[0].re),
+        (Some(NOW - 900), "lost", 1)
+    );
+    // still open: the row is open
+    let rows = fold_with(vec![start(RUN, 2, NOW - 910, "111", 7, "remote")]);
+    assert_eq!(rows.len(), 1);
+    assert_eq!((rows[0].t1, rows[0].end.as_str()), (None, "open"));
+    // another session's start in that time is a row of its own
+    assert_eq!(
+        fold_with(vec![start(RUN, 2, NOW - 910, "111", 8, "remote")]).len(),
+        2
+    );
+}
+
+/// W9-D3's bound holds for rows that reconnect often: a row takes at most MAX_RE reconnects, and
+/// the kept rows at most KEEP_KEYS connections, so the compacted file stays bounded too.
+#[test]
+fn rows_that_reconnect_often_do_not_carry_the_file_past_its_bound() {
+    let mut lines = Vec::new();
+    let mut n = 0;
+    let rows_made = 50u64;
+    for row in 0..rows_made {
+        let t = NOW - 5_000_000 + row * 50_000;
+        // MAX_RE + 1 connections of one session, each lost and back within a second
+        for i in 0..=u64::from(MAX_RE) {
+            n += 1;
+            lines.push(start(RUN, n, t + i * 2, "111", 1 + row, "remote"));
+            lines.push(end(RUN, n, t + i * 2 + 1, "lost"));
+        }
+    }
+    let all = text(&lines);
+    let rows = fold(&all, RUN, NOW);
+    assert!(rows.iter().all(|r| r.re <= MAX_RE));
+    let keys: usize = rows.iter().map(|r| r.keys.len()).sum();
+    assert!(keys <= KEEP_KEYS, "{keys}");
+    assert_eq!(rows.len(), KEEP_KEYS / (MAX_RE as usize + 1));
+    // the newest first
+    assert_eq!(rows[0].sid, rows_made);
+    assert_eq!(compact(&all, RUN, NOW).lines().count(), 2 * keys);
+    // one more reconnect than MAX_RE starts a row of its own
+    let mut lines = Vec::new();
+    for i in 0..=u64::from(MAX_RE) + 1 {
+        lines.push(start(RUN, 1 + i, NOW - 10_000 + i * 2, "111", 7, "remote"));
+        lines.push(end(RUN, 1 + i, NOW - 10_000 + i * 2 + 1, "lost"));
+    }
+    let rows = fold(&text(&lines), RUN, NOW);
+    assert_eq!(rows.iter().map(|r| r.re).collect::<Vec<_>>(), [0, MAX_RE]);
+}
