+/// hjv_incoming_started's order: the account's proof, then the session's remembered one-time
+/// password, then the audit line's primary auth.
+#[test]
+fn how_it_got_in_takes_the_account_first() {
+    assert_eq!(auth_of(true, true, "otp"), "account");
+    assert_eq!(auth_of(false, true, "otp"), "recent");
+    assert_eq!(auth_of(false, false, "click"), "click");
+    assert_eq!(auth_of(false, false, ""), "");
+}
