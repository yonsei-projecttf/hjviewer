+/// The writer's schedule (design 3-3 step 3): it compacts when it starts, whether or not a line
+/// comes, then a day later or after COMPACT_LINES lines, or when the clock went back; between
+/// those it only appends.
+#[test]
+fn the_writer_compacts_at_its_start_and_then_daily() {
+    let path = temp_list("schedule");
+    let old = |id: &str| start(OLD, 9, NOW - KEEP_SECS - 86_400, id, 1, "remote") + "\n";
+    add(&path, old("old").as_bytes()).unwrap();
+    add(
+        &path,
+        (start(OLD, 1, NOW - 100, "new", 1, "remote") + "\n").as_bytes(),
+    )
+    .unwrap();
+    let mut writer = Writer::new(path.clone());
+    assert!(writer.due(NOW));
+    assert_eq!(writer.wait(NOW), Duration::from_secs(1));
+    // at the start, without a connection
+    writer.tidy(RUN, NOW);
+    assert_eq!(ids(&path), ["new"]);
+    assert!(!writer.due(NOW + 10));
+    assert_eq!(writer.wait(NOW), Duration::from_secs(WAKE_SECS));
+    assert_eq!(
+        writer.wait(NOW + COMPACT_SECS - 10),
+        Duration::from_secs(10)
+    );
+    // a line between: appended, nothing compacted
+    add(&path, old("old2").as_bytes()).unwrap();
+    let line = start_line(&a_start("", 0), RUN, 1, NOW + 10);
+    writer.append(&line, RUN, NOW + 10);
+    assert_eq!(ids(&path), ["123456789", "new", "old2"]);
+    assert_eq!(writer.lines, 1);
+    // a day later
+    assert!(writer.due(NOW + COMPACT_SECS));
+    writer.tidy(RUN, NOW + COMPACT_SECS);
+    assert_eq!(ids(&path), ["123456789", "new"]);
+    assert_eq!(writer.lines, 0);
+    // after COMPACT_LINES lines, and when the clock went back
+    writer.lines = COMPACT_LINES;
+    assert!(writer.due(NOW + COMPACT_SECS + 1));
+    writer.lines = 0;
+    assert!(writer.due(NOW));
+    std::fs::remove_dir_all(path.parent().unwrap()).ok();
+}
+
+/// One byte that is not UTF-8 costs only its line: the list still shows the others and the
+/// writer still compacts. A missing file is an empty list.
+#[test]
+fn a_damaged_byte_costs_only_its_line() {
+    let path = temp_list("damaged");
+    assert_eq!(read_list(&path), "");
+    let mut bytes = (start(OLD, 1, NOW - 100, "kept", 1, "remote") + "\n").into_bytes();
+    bytes
+        .extend_from_slice(b"{\"v\":1,\"e\":\"s\",\"r\":\"x\",\"n\":2,\"t\":1,\"name\":\"\xea\xb0");
+    bytes.push(b'\n');
+    bytes.extend_from_slice(
+        (start(OLD, 9, NOW - KEEP_SECS - 86_400, "old", 1, "remote") + "\n").as_bytes(),
+    );
+    std::fs::write(&path, &bytes).unwrap();
+    let rows = fold(&read_list(&path), RUN, NOW);
+    assert_eq!(
+        rows.iter().map(|r| r.id.as_str()).collect::<Vec<_>>(),
+        ["kept"]
+    );
+    let mut writer = Writer::new(path.clone());
+    writer.tidy(RUN, NOW);
+    assert_eq!(ids(&path), ["kept"]);
+    std::fs::remove_dir_all(path.parent().unwrap()).ok();
+}
