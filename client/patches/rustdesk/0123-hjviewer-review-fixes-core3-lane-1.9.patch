+fn ids(path: &Path) -> Vec<String> {
+    let mut ids: Vec<_> = read_list(path)
+        .lines()
+        .filter_map(parse)
+        .filter(|l| l.e == "s")
+        .map(|l| l.id)
+        .collect();
+    ids.sort();
+    ids
+}
