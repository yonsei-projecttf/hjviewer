+fn a_start<'a>(mark: &'a str, kind: u8) -> Start<'a> {
+    Start {
+        peer_id: "123456789",
+        name: "kim's laptop",
+        device: "Office PC",
+        owner: "홍*동",
+        mark,
+        auth: "permanent",
+        kind,
+        session_id: 42,
+    }
+}
