+++ b/flutter/lib/common/hjviewer_admin.dart
@@ -0,0 +1,462 @@
+// The operator's view on the screen (hjviewer_admin_texts.dart has its texts and choices): the
+// entry in Settings → Account of the account hjv-api names its operator, and the read-only screen
+// of the users and of the PCs logged in to an account, a dialog on a desktop and a page on a
+// phone. The overview goes out as the account screens' requests do (hjvAccountGet), signed with
+// the account key; hjv-api answers it for its operator only and records each answer. Outside an
+// account build the hooks of hjviewer_account.dart do not reach this file.
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjviewer_account.dart';
+import 'package:flutter_hbb/common/hjviewer_admin_texts.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:get/get.dart';
+import 'package:settings_ui/settings_ui.dart';
+
+/// The texts in the language of the account screens (hjviewer_account.dart).
+HjvAdminTexts get _t => HjvAdminTexts(translate('Cancel') == '취소');
+
+/// Counts the answers that may have changed the role; the entries read the role again then.
+final _roleAnswers = 0.obs;
+
+/// After an answer that may have changed the role (the key list, a 404 of the overview), which the
+/// account module took: the entries look at it again.
+void hjvAdminRoleChanged() => _roleAnswers.value++;
+
+/// Whether the entry shows, as its Obx asks: `role` reads the role the account module keeps, again
+/// after each hjvAdminRoleChanged.
+bool hjvAdminEntryShown(
+    {required bool loggedIn, required String Function() role}) {
+  // the entry's Obx reads the counter here, and so builds again after hjvAdminRoleChanged
+  _roleAnswers.value;
+  return hjvShowsAdminEntry(loggedIn: loggedIn, role: role());
+}
+
+String _role() {
+  try {
+    return bind.mainGetCommonSync(key: kHjvRoleKey);
+  } catch (e) {
+    return '';
+  }
+}
+
+bool _entryShown() =>
+    hjvAdminEntryShown(loggedIn: gFFI.userModel.isLogin, role: _role);
+
+/// D7's panel (desktop Settings → Account): the button to the operator's view.
+Widget hjvAdminButton() =>
+    HjvAdminEntry(texts: () => _t, shown: _entryShown, open: hjvOpenAdmin);
+
+/// D8's tiles (the phone's Settings → Account): the tile of the operator's view. It is an empty
+/// tile for everybody else, so it stands between two tiles, where settings_ui's iOS section draws
+/// no border of its own for it.
+AbstractSettingsTile hjvAdminTile() => CustomSettingsTile(
+    child: HjvAdminEntry(
+        texts: () => _t, shown: _entryShown, open: hjvOpenAdmin, tile: true));
+
+/// The entry to the operator's view while `shown` says so. `shown` runs inside an Obx: the Rx it
+/// reads (the login, the role's counter) bring the entry and take it away.
+class HjvAdminEntry extends StatelessWidget {
+  final HjvAdminTexts Function() texts;
+  final bool Function() shown;
+  final void Function(BuildContext context) open;
+
+  /// a tile of the phone's settings, else a button of the desktop's account card
+  final bool tile;
+  const HjvAdminEntry(
+      {super.key,
+      required this.texts,
+      required this.shown,
+      required this.open,
+      this.tile = false});
+
+  @override
+  Widget build(BuildContext context) {
+    return Obx(() {
+      if (!shown()) return const SizedBox.shrink();
+      final t = texts();
+      if (tile) {
+        return SettingsTile(
+            title: Text(t.title),
+            leading: const Icon(Icons.admin_panel_settings_outlined),
+            onPressed: open);
+      }
+      return OutlinedButton(
+              onPressed: () => open(context), child: Text(t.title))
+          .marginOnly(top: 8);
+    });
+  }
+}
+
+/// Opens the operator's view: a dialog on a desktop, a page on a phone. It closes, and says why,
+/// when hjv-api answers that the account is no operator (404, the entry goes with the role) or
+/// when the login ends (a 401, a logout from another device).
+void hjvOpenAdmin(BuildContext context) {
+  final t = _t;
+  final login = gFFI.userModel.userName;
+  if (isDesktop || isWebDesktop) {
+    var open = true;
+    gFFI.dialogManager
+        .show<void>((setState, close, context) {
+          // once: a second close would take the dialog's overlay entry out again, which throws
+          void shut() {
+            if (!open) return;
+            open = false;
+            close();
+          }
+
+          return hjvAdminDialog(t,
+              load: () => _overview(t),
+              login: login,
+              onClose: shut,
+              onGone: (toast) {
+                shut();
+                showToast(toast);
+              });
+        })
+        .whenComplete(() => open = false)
+        .catchError((Object e) => debugPrint('hjv: $e'));
+    return;
+  }
+  late final MaterialPageRoute<void> route;
+  route = MaterialPageRoute<void>(
+      builder: (page) => HjvAdminPage(
+          t: t,
+          load: () => _overview(t),
+          login: login,
+          onGone: (toast) {
+            // this page, also under a route that came on top of it meanwhile
+            final navigator = route.navigator;
+            if (navigator != null && route.isActive) {
+              route.isCurrent ? navigator.pop() : navigator.removeRoute(route);
+            }
+            showToast(toast);
+          }));
+  Navigator.of(context).push(route);
+}
+
+Future<HjvAdminAnswer> _overview(HjvAdminTexts t) =>
+    hjvAdminLoad(t, hjvAccountGet);
+
+/// `GET /api/hjv/admin/overview` with `get` (hjvAccountGet), as the screen reads it. The account
+/// module took the role from the answer before (a 404 ends it): after a 404 the entries look at
+/// it again, whether the view that asked is still open or not.
+Future<HjvAdminAnswer> hjvAdminLoad(
+    HjvAdminTexts t, Future<(int, Object?)> Function(String path) get) async {
+  try {
+    final (code, body) = await get(kHjvAdminPath);
+    if (code == 404) hjvAdminRoleChanged();
+    return hjvAdminAnswer(t, code, body);
+  } catch (e) {
+    return HjvAdminAnswer(error: hjvAdminFailure(t, e));
+  }
+}
+
+/// The desktop's dialog of the operator's view.
+CustomAlertDialog hjvAdminDialog(HjvAdminTexts t,
+        {required Future<HjvAdminAnswer> Function() load,
+        required VoidCallback onClose,
+        required void Function(String toast) onGone,
+        RxString? login,
+        HjvAdminClock local = hjvAdminLocal}) =>
+    CustomAlertDialog(
+      title: Text(t.title),
+      contentBoxConstraints: const BoxConstraints(maxWidth: 1100),
+      content: Builder(
+          // the dialog's IntrinsicWidth stops at a box of its own size, which the lists need
+          builder: (context) => SizedBox(
+              width: double.maxFinite,
+              height: (MediaQuery.of(context).size.height * 0.7)
+                  .clamp(320.0, 720.0),
+              child: HjvAdminView(
+                  t: t,
+                  load: load,
+                  onGone: onGone,
+                  login: login,
+                  local: local))),
+      actions: [
+        ElevatedButton(
+            style: ElevatedButton.styleFrom(elevation: 0),
+            onPressed: onClose,
+            child: Text(t.account.close)),
+      ],
+      onCancel: onClose,
+    );
+
+/// The phone's page of the operator's view.
+class HjvAdminPage extends StatelessWidget {
+  final HjvAdminTexts t;
+  final Future<HjvAdminAnswer> Function() load;
+  final void Function(String toast) onGone;
+  final RxString? login;
+  final HjvAdminClock local;
+  const HjvAdminPage(
+      {super.key,
+      required this.t,
+      required this.load,
+      required this.onGone,
+      this.login,
+      this.local = hjvAdminLocal});
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: Text(t.title)),
+      body: SafeArea(
+          child: HjvAdminView(
+                  t: t, load: load, onGone: onGone, login: login, local: local)
+              .paddingOnly(left: 12, right: 12, top: 8)),
+    );
+  }
+}
+
+/// The operator's view (read-only): what it shows and what hjv-api's record keeps of it, a
+/// search, [새로 고침], and the users and the PCs in two tabs, as a table where the screen is wide
+/// and as lines on a phone. `load` asks hjv-api. The view closes through `onGone`, with what to
+/// say, after a 404 or a 401 of it and when `login` ends: no list stays on the screen without the
+/// operator's login.
+class HjvAdminView extends StatefulWidget {
+  final HjvAdminTexts t;
+  final Future<HjvAdminAnswer> Function() load;
+  final void Function(String toast) onGone;
+
+  /// the login the view was opened in (gFFI.userModel.userName); its end closes the view
+  final RxString? login;
+  final HjvAdminClock local;
+  const HjvAdminView(
+      {super.key,
+      required this.t,
+      required this.load,
+      required this.onGone,
+      this.login,
+      this.local = hjvAdminLocal});
+
+  @override
+  State<HjvAdminView> createState() => _HjvAdminViewState();
+}
+
+/// Where the lists are a table, and the shares of its columns.
+const _kWide = 720.0;
+const _kUserFlex = [4, 2, 3, 2, 2];
+const _kPcFlex = [3, 3, 3, 2, 3, 2];
+
+/// The share of the view's height the part above the lists takes at most; a higher one (a phone
+/// on its side with the keyboard up, a big font) scrolls in it, and the lists keep the rest.
+const _kHead = 0.6;
+
+class _HjvAdminViewState extends State<HjvAdminView> {
+  HjvAdminOverview? _overview;
+  var _error = '';
+  var _loading = true;
+  var _query = '';
+  var _closed = false;
+  Worker? _loginWorker;
+
+  @override
+  void initState() {
+    super.initState();
+    final login = widget.login;
+    if (login != null) {
+      _loginWorker = ever<String>(login, (name) {
+        if (name.isEmpty) {
+          // inside the login's own notice (UserModel.reset): what closing throws stays here
+          try {
+            _close(widget.t.ended);
+          } catch (e) {
+            debugPrint('hjv: $e');
+          }
+        }
+      });
+    }
+    _fetch();
+  }
+
+  @override
+  void dispose() {
+    _loginWorker?.dispose();
+    super.dispose();
+  }
+
+  /// Once: the lists go from the screen, and the dialog or the page with them. A closed view asks
+  /// nothing more.
+  void _close(String toast) {
+    if (_closed) return;
+    _closed = true;
+    if (mounted) {
+      setState(() {
+        _overview = null;
+        _loading = false;
+        _error = '';
+      });
+    }
+    widget.onGone(toast);
+  }
+
+  void _refresh() {
+    if (_loading) return;
+    setState(() => _loading = true);
+    _fetch();
+  }
+
+  /// One request at a time: [새로 고침] waits for the one under way.
+  Future<void> _fetch() async {
+    HjvAdminAnswer answer;
+    try {
+      answer = await widget.load();
+    } catch (e) {
+      answer = HjvAdminAnswer(error: hjvAdminFailure(widget.t, e));
+    }
+    if (!mounted || _closed) return;
+    if (answer.closes.isNotEmpty) {
+      _close(answer.closes);
+      return;
+    }
+    setState(() {
+      _loading = false;
+      final overview = answer.overview;
+      if (overview != null) _overview = overview;
+      _error = overview == null ? answer.error : '';
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final t = widget.t;
+    final overview = _overview;
+    final now = overview?.at ?? DateTime.now();
+    final (users, pcs) = overview == null
+        ? (const <HjvAdminUser>[], const <HjvAdminPc>[])
+        : hjvAdminSearch(t, overview, _query);
+    return DefaultTabController(
+      length: 2,
+      child: LayoutBuilder(
+        builder: (context, box) => Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            ConstrainedBox(
+              constraints: BoxConstraints(maxHeight: box.maxHeight * _kHead),
+              child: SingleChildScrollView(
+                primary: false,
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.stretch,
+                  children: [
+                    Text('${t.onlyLoggedIn} ${t.ipNote} ${t.recorded}',
+                        style: Theme.of(context).textTheme.bodySmall),
+                    Row(children: [
+                      Expanded(
+                          child: TextField(
+                              decoration: InputDecoration(
+                                  hintText: t.search,
+                                  prefixIcon: const Icon(Icons.search),
+                                  isDense: true),
+                              onChanged: (query) =>
+                                  setState(() => _query = query))),
+                      IconButton(
+                          tooltip: t.refresh,
+                          onPressed: _loading || _closed ? null : _refresh,
+                          icon: const Icon(Icons.refresh)),
+                    ]).marginOnly(top: 8),
+                    if (_loading)
+                      const LinearProgressIndicator().marginOnly(top: 4),
+                    if (_error.isNotEmpty)
+                      Text(_error,
+                              style: TextStyle(
+                                  color: Theme.of(context).colorScheme.error))
+                          .marginOnly(top: 8),
+                    if (overview != null) ...[
+                      Text(hjvAdminSummary(t, overview,
+                              now: now, local: widget.local))
+                          .marginOnly(top: 8),
+                      TabBar(tabs: [
+                        Tab(
+                            text: t.usersTab(
+                                users.length, overview.users.length)),
+                        Tab(text: t.pcsTab(pcs.length, overview.pcs.length)),
+                      ]),
+                    ],
+                  ],
+                ),
+              ),
+            ),
+            if (overview != null)
+              Expanded(child: _lists(t, overview, users, pcs, now)),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _lists(HjvAdminTexts t, HjvAdminOverview o, List<HjvAdminUser> users,
+      List<HjvAdminPc> pcs, DateTime now) {
+    final local = widget.local;
+    Widget user(HjvAdminUser u) => ListTile(
+        contentPadding: EdgeInsets.zero,
+        leading: Icon(u.active ? Icons.person : Icons.person_outline),
+        title: Text(hjvAdminUserTitle(u)),
+        subtitle: Text(hjvAdminUserLine(t, u, now: now, local: local)));
+    Widget pc(HjvAdminPc p) => ListTile(
+        contentPadding: EdgeInsets.zero,
+        leading: const Icon(Icons.computer),
+        title: Text(hjvAdminPcTitle(p)),
+        subtitle:
+            Text(hjvAdminPcLines(t, p, now: now, local: local).join('\n')));
+    return LayoutBuilder(builder: (context, size) {
+      final wide = size.maxWidth >= _kWide;
+      return SelectionArea(
+        child: TabBarView(children: [
+          _list(
+              o.users.isEmpty ? t.noUsers : t.noMatch,
+              wide
+                  ? _table(_kUserFlex, t.userColumns, [
+                      for (final u in users)
+                        hjvAdminUserCells(t, u, now: now, local: local)
+                    ])
+                  : users.map(user).toList()),
+          _list(
+              o.pcs.isEmpty ? t.noPcs : t.noMatch,
+              wide
+                  ? _table(_kPcFlex, t.pcColumns, [
+                      for (final p in pcs)
+                        hjvAdminPcCells(t, p, now: now, local: local)
+                    ])
+                  : pcs.map(pc).toList()),
+        ]),
+      );
+    });
+  }
+
+  /// The rows of a list, or what an empty one says.
+  Widget _list(String empty, List<Widget> rows) {
+    if (rows.isEmpty) return Center(child: Text(empty));
+    return ListView.separated(
+      itemCount: rows.length,
+      itemBuilder: (context, i) => rows[i],
+      separatorBuilder: (context, i) => const Divider(height: 1),
+    );
+  }
+
+  /// A table's rows under its header; none without rows.
+  List<Widget> _table(
+          List<int> flex, List<String> header, List<List<String>> rows) =>
+      rows.isEmpty
+          ? []
+          : [
+              _row(flex, header, bold: true),
+              for (final cells in rows) _row(flex, cells),
+            ];
+
+  /// A row of the table: each cell its share of the width.
+  Widget _row(List<int> flex, List<String> cells, {bool bold = false}) => Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          for (var i = 0; i < cells.length; i++)
+            Expanded(
+                flex: i < flex.length ? flex[i] : 1,
+                child: Text(cells[i],
+                        style: bold
+                            ? const TextStyle(fontWeight: FontWeight.bold)
+                            : null)
+                    .marginOnly(right: 8)),
+        ],
+      ).paddingSymmetric(vertical: 6);
+}
