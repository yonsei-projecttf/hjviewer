+// The operator's view of HJViewer: the people who use it and the PCs logged in to an account, as
+// hjv-api's `GET /api/hjv/admin/overview` gives them to the account it names its operator (the
+// server's HJV_API_OPERATORS). It is read-only: nothing here acts on a user or a PC. The texts in
+// Korean and English, the reading of the answer, its order and the search; plain Dart without the
+// bridge, so that ci.sh tests it with the web stand-in. hjviewer_admin.dart shows it. No text
+// holds braces, which translate() would take for placeholders.
+
+import 'package:flutter_hbb/common/formatter/id_formatter.dart';
+import 'package:flutter_hbb/common/hjviewer_account_texts.dart';
+
+/// The overview: a signed account request, which hjv-api answers with the 404 of an unknown path
+/// for an account that is not its operator.
+const kHjvAdminPath = '/api/hjv/admin/overview';
+
+/// What the account module (src/hjviewer_account/api.rs) keeps of the role hjv-api gave the
+/// login, through main_get_common: "operator" or "".
+const kHjvRoleKey = 'hjv-role';
+
+/// How many days of use make a user active when hjv-api does not say (HJV_API_ACTIVE_DAYS).
+const kHjvActiveDays = 30;
+
+/// Whether Settings → Account offers the operator's view: while logged in, to the account hjv-api
+/// named its operator. It only picks what the screen shows; hjv-api checks the role itself on
+/// every request of the view.
+bool hjvShowsAdminEntry({required bool loggedIn, required String role}) =>
+    loggedIn && role == 'operator';
+
+/// Turns a time of the answer, UTC, into the time shown.
+typedef HjvAdminClock = DateTime Function(DateTime time);
+
+/// The device's own time zone.
+DateTime hjvAdminLocal(DateTime time) => time.toLocal();
+
+class HjvAdminTexts {
+  final bool korean;
+  const HjvAdminTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  /// The account screens' texts in the same language (닫기, the request errors).
+  HjvTexts get account => HjvTexts(korean);
+
+  String get title => _t('최고운영자: 사용자와 PC', 'Super operator: users and PCs');
+  String get onlyLoggedIn => _t(
+      '계정에 로그인한 PC만 보입니다. 아무도 로그인하지 않은 PC는 서버가 알지 못합니다.',
+      'Only PCs logged in to an account are listed: the server does not know a PC nobody logged in on.');
+  String get ipNote => _t('IP는 PC가 마지막으로 서버와 동기화할 때 서버가 본 주소입니다.',
+      "A PC's IP is the address the server saw at its last sync.");
+  String get recorded => _t('이 화면을 열거나 새로 고칠 때마다 운영자 기록에 남습니다.',
+      'Each opening and refresh of this screen goes into the operator record.');
+  String get search => _t('검색: 이름, ID, PC, IP', 'Search: name, ID, PC, IP');
+  String get refresh => _t('새로 고침', 'Refresh');
+  String usersTab(int shown, int all) => shown == all
+      ? _t('사용자 $all', 'Users $all')
+      : _t('사용자 $shown/$all', 'Users $shown/$all');
+  String pcsTab(int shown, int all) => shown == all
+      ? _t('PC $all', 'PCs $all')
+      : _t('PC $shown/$all', 'PCs $shown/$all');
+  String summary(int users, int active, int days, int pcs) => _t(
+      '사용자 $users명 · 활성 $active명(최근 $days일 사용) · PC $pcs대',
+      'Users: $users · active: $active (used in the last $days days) · PCs: $pcs');
+  String asOf(String time) => _t('$time 기준', 'as of $time');
+  String get active => _t('활성', 'active');
+  String get inactive => _t('비활성', 'inactive');
+  String lastUse(String time) => _t('마지막 사용 $time', 'last use $time');
+  String get notUsed => _t('사용 기록 없음', 'not used yet');
+  String devices(int n) => _t('로그인한 기기 $n대', 'logged-in devices: $n');
+  String pcs(int n) => _t('PC $n대', 'PCs: $n');
+  String owner(String who) => _t('계정 $who', 'account $who');
+  String get unknownOs => _t('OS 모름', 'OS unknown');
+  String get unknownVersion => _t('버전 모름', 'version unknown');
+  String lastSync(String time) => _t('마지막 동기화 $time', 'last sync $time');
+  String get notSynced => _t('동기화 기록 없음', 'not synced yet');
+  String get unknownIp => _t('IP 모름', 'IP unknown');
+  String pwless(String state) =>
+      _t('비밀번호 없는 연결: $state', 'password-less connections: $state');
+  String get pwlessOn => _t('켜짐', 'on');
+  String get pwlessOff => _t('PC에서 꺼 둠', 'turned off on the PC');
+  String get pwlessPaused => _t('관리자가 일시 중지함', 'paused by the administrator');
+  String get pwlessExpired => _t('서버와 맞추지 못함', 'not in step with the server');
+  String get pwlessListed =>
+      _t('PC가 아직 확인하지 않음', 'not confirmed by the PC yet');
+  String get pwlessRelogin => _t('다시 로그인 필요', 'needs a new login');
+  String get noUsers => _t('로그인한 사용자가 없습니다.', 'Nobody has logged in yet.');
+  String get noPcs =>
+      _t('계정에 로그인한 PC가 없습니다.', 'No PC is logged in to an account.');
+  String get noMatch => _t('찾는 항목이 없습니다.', 'Nothing matches.');
+  String get gone => _t('이 계정은 최고운영자가 아니어서 화면을 닫았습니다.',
+      'This account is not a super operator, so the screen closed.');
+  String get ended =>
+      _t('로그인이 풀려서 화면을 닫았습니다.', 'You were logged out, so the screen closed.');
+  String get unreadable => _t('서버의 답을 읽지 못했습니다. 앱을 업데이트해 주세요.',
+      "The server's answer could not be read. Please update the app.");
+  String get keyLocked => _t('이 기기의 보안 키를 지금 쓸 수 없습니다. 기기 잠금을 풀고 새로 고쳐 주세요.',
+      "This device's security key cannot be used right now. Unlock the device and refresh.");
+
+  /// The columns of the wide layout's tables.
+  List<String> get userColumns => [
+        _t('사용자', 'User'),
+        _t('상태', 'State'),
+        _t('마지막 사용', 'Last use'),
+        _t('로그인한 기기', 'Devices'),
+        _t('PC', 'PCs'),
+      ];
+  List<String> get pcColumns => [
+        'PC',
+        _t('계정', 'Account'),
+        _t('OS·버전', 'OS · version'),
+        _t('마지막 동기화', 'Last sync'),
+        'IP · LAN',
+        _t('비밀번호 없는 연결', 'Password-less'),
+      ];
+}
+
+String _text(Object? value) => value is String ? value : '';
+
+int _count(Object? value) => value is int && value > 0 ? value : 0;
+
+/// A time of the answer (RFC 3339); null for none or anything else.
+DateTime? hjvAdminTime(Object? value) =>
+    value is String ? DateTime.tryParse(value) : null;
+
+/// A user of the service: an account that logged in once and is still allowed to.
+class HjvAdminUser {
+  /// the portal ID
+  final String id;
+  final String name;
+
+  /// whether an account key or a PC of it was used in the last `active_days`
+  final bool active;
+  final DateTime? lastUse;
+
+  /// the account's logged-in devices, and the PCs logged in to it
+  final int keys;
+  final int pcs;
+  const HjvAdminUser(
+      {required this.id,
+      this.name = '',
+      this.active = false,
+      this.lastUse,
+      this.keys = 0,
+      this.pcs = 0});
+
+  /// null for an entry without its portal ID
+  static HjvAdminUser? fromJson(Object? json) {
+    if (json is! Map) return null;
+    final id = _text(json['id']);
+    if (id.isEmpty) return null;
+    return HjvAdminUser(
+        id: id,
+        name: _text(json['name']),
+        active: json['active'] == true,
+        lastUse: hjvAdminTime(json['last_use']),
+        keys: _count(json['keys']),
+        pcs: _count(json['pcs']));
+  }
+}
+
+/// A PC logged in to an account ("installed PCs": hjv-api knows no other).
+class HjvAdminPc {
+  /// its RustDesk ID
+  final String pc;
+
+  /// "" where the answer has null
+  final String host;
+  final String owner;
+  final String ownerName;
+  final String os;
+  final String version;
+  final DateTime? lastSync;
+
+  /// the client address hjv-api saw at the PC's last sync
+  final String ip;
+
+  /// IPv4/prefix of the PC's networks, from its wake report
+  final List<String> lan;
+
+  /// as hjv-api's `binding list` names it: active, off, disabled, expired, listed, needs-relogin
+  final String passwordless;
+  const HjvAdminPc(
+      {required this.pc,
+      this.host = '',
+      this.owner = '',
+      this.ownerName = '',
+      this.os = '',
+      this.version = '',
+      this.lastSync,
+      this.ip = '',
+      this.lan = const [],
+      this.passwordless = ''});
+
+  /// null for an entry without its PC ID
+  static HjvAdminPc? fromJson(Object? json) {
+    if (json is! Map) return null;
+    final pc = _text(json['pc']);
+    if (pc.isEmpty) return null;
+    final lan = json['lan'];
+    return HjvAdminPc(
+        pc: pc,
+        host: _text(json['host']),
+        owner: _text(json['owner']),
+        ownerName: _text(json['owner_name']),
+        os: _text(json['os']),
+        version: _text(json['version']),
+        lastSync: hjvAdminTime(json['last_sync']),
+        ip: _text(json['ip']),
+        lan: lan is List ? lan.whereType<String>().toList() : const [],
+        passwordless: _text(json['passwordless']));
+  }
+}
+
+/// Newest first, the ones without a time last.
+int _newestFirst(DateTime? a, DateTime? b) {
+  if (a == null || b == null) return a == null ? (b == null ? 0 : 1) : -1;
+  return b.compareTo(a);
+}
+
+/// The users as the screen lists them: the active ones first, then by last use, newest first.
+List<HjvAdminUser> hjvSortUsers(Iterable<HjvAdminUser> users) => users.toList()
+  ..sort((a, b) {
+    if (a.active != b.active) return a.active ? -1 : 1;
+    final use = _newestFirst(a.lastUse, b.lastUse);
+    return use != 0 ? use : a.id.compareTo(b.id);
+  });
+
+/// The PCs as the screen lists them: by owner, then by host name, the ones without one last.
+List<HjvAdminPc> hjvSortPcs(Iterable<HjvAdminPc> pcs) => pcs.toList()
+  ..sort((a, b) {
+    final owner = a.owner.compareTo(b.owner);
+    if (owner != 0) return owner;
+    if (a.host.isEmpty != b.host.isEmpty) return a.host.isEmpty ? 1 : -1;
+    final host = a.host.toLowerCase().compareTo(b.host.toLowerCase());
+    return host != 0 ? host : a.pc.compareTo(b.pc);
+  });
+
+/// Version 1 of the overview.
+class HjvAdminOverview {
+  /// when hjv-api answered
+  final DateTime? at;
+  final int activeDays;
+  final List<HjvAdminUser> users;
+  final List<HjvAdminPc> pcs;
+  const HjvAdminOverview(
+      {this.at,
+      this.activeDays = kHjvActiveDays,
+      this.users = const [],
+      this.pcs = const []});
+
+  /// null for anything but version 1 with both lists; the lists in the screen's order
+  static HjvAdminOverview? fromJson(Object? json) {
+    if (json is! Map || json['v'] != 1) return null;
+    final users = json['users'];
+    final pcs = json['pcs'];
+    if (users is! List || pcs is! List) return null;
+    final days = json['active_days'];
+    return HjvAdminOverview(
+        at: hjvAdminTime(json['at']),
+        activeDays: days is int && days > 0 ? days : kHjvActiveDays,
+        users: hjvSortUsers(
+            users.map(HjvAdminUser.fromJson).whereType<HjvAdminUser>()),
+        pcs: hjvSortPcs(pcs.map(HjvAdminPc.fromJson).whereType<HjvAdminPc>()));
+  }
+
+  int get activeUsers => users.where((u) => u.active).length;
+}
+
+/// What a request of the overview came back with: the overview, what failed, or why the view
+/// closes.
+class HjvAdminAnswer {
+  final HjvAdminOverview? overview;
+
+  /// The view closes with this said, its lists with it: the 404 of an account that is not
+  /// hjv-api's operator (any more), or the 401 of a login that ended (the request logged the app
+  /// out, hjvEndsLogin). "" while the view stays.
+  final String closes;
+  final String error;
+  const HjvAdminAnswer({this.overview, this.closes = '', this.error = ''});
+}
+
+HjvAdminAnswer hjvAdminAnswer(HjvAdminTexts t, int status, Object? body) {
+  if (status == 404) return HjvAdminAnswer(closes: t.gone);
+  if (status == 401) return HjvAdminAnswer(closes: t.ended);
+  if (status != 200) {
+    return HjvAdminAnswer(error: hjvRequestError(t.account, body));
+  }
+  final overview = HjvAdminOverview.fromJson(body);
+  return overview == null
+      ? HjvAdminAnswer(error: t.unreadable)
+      : HjvAdminAnswer(overview: overview);
+}
+
+/// What a request that never got an answer shows: the account key could not be used (a locked
+/// iPhone, hjvFailure), or the request failed.
+String hjvAdminFailure(HjvAdminTexts t, Object error) =>
+    error.toString().contains(kHjvKeyUnavailable)
+        ? t.keyLocked
+        : t.account.requestFailed;
+
+/// "10/14 09:30" in the device's time zone, with the year when it is not `now`'s.
+String hjvAdminWhen(DateTime time, DateTime now,
+    {HjvAdminClock local = hjvAdminLocal}) {
+  final shown = local(time);
+  return shown.year == local(now).year
+      ? hjvTime(shown)
+      : '${shown.year}/${hjvTime(shown)}';
+}
+
+/// "사용자 5명 · 활성 3명(최근 30일 사용) · PC 4대 · 10/14 09:30 기준"
+String hjvAdminSummary(HjvAdminTexts t, HjvAdminOverview o,
+    {required DateTime now, HjvAdminClock local = hjvAdminLocal}) {
+  final at = o.at;
+  final counts =
+      t.summary(o.users.length, o.activeUsers, o.activeDays, o.pcs.length);
+  return at == null
+      ? counts
+      : '$counts · ${t.asOf(hjvAdminWhen(at, now, local: local))}';
+}
+
+/// "홍길동 (2026000001)", or the portal ID alone.
+String hjvAdminUserTitle(HjvAdminUser u) =>
+    u.name.isEmpty || u.name == u.id ? u.id : '${u.name} (${u.id})';
+
+String hjvAdminUserState(HjvAdminTexts t, HjvAdminUser u) =>
+    u.active ? t.active : t.inactive;
+
+/// The user's last use, or that there is none.
+String hjvAdminLastUse(HjvAdminTexts t, HjvAdminUser u,
+    {required DateTime now, HjvAdminClock local = hjvAdminLocal}) {
+  final use = u.lastUse;
+  return use == null ? t.notUsed : hjvAdminWhen(use, now, local: local);
+}
+
+/// A user's line on a phone: "활성 · 마지막 사용 10/14 09:30 · 로그인한 기기 2대 · PC 1대".
+String hjvAdminUserLine(HjvAdminTexts t, HjvAdminUser u,
+    {required DateTime now, HjvAdminClock local = hjvAdminLocal}) {
+  final use = u.lastUse;
+  return [
+    hjvAdminUserState(t, u),
+    use == null ? t.notUsed : t.lastUse(hjvAdminWhen(use, now, local: local)),
+    t.devices(u.keys),
+    t.pcs(u.pcs),
+  ].join(' · ');
+}
+
+/// "연구실-PC · 123 456 789", or the ID alone.
+String hjvAdminPcTitle(HjvAdminPc p) =>
+    p.host.isEmpty ? formatID(p.pc) : '${p.host} · ${formatID(p.pc)}';
+
+/// "홍길동 (2026000001)", or the owner's portal ID alone.
+String hjvAdminOwner(HjvAdminPc p) =>
+    p.ownerName.isEmpty || p.ownerName == p.owner
+        ? p.owner
+        : '${p.ownerName} (${p.owner})';
+
+/// "Windows · HJViewer 1.6.0": hjv-api names the system by the app's platform word (`windows`),
+/// which the known ones show by their names.
+String hjvAdminSystem(HjvAdminTexts t, HjvAdminPc p) => [
+      p.os.isEmpty ? t.unknownOs : hjvAdminOsName(p.os),
+      p.version.isEmpty ? t.unknownVersion : 'HJViewer ${p.version}',
+    ].join(' · ');
+
+String hjvAdminOsName(String os) => switch (os) {
+      'windows' => 'Windows',
+      'macos' => 'macOS',
+      'linux' => 'Linux',
+      'android' => 'Android',
+      'ios' => 'iOS',
+      _ => os,
+    };
+
+/// The PC's last sync, or that there was none.
+String hjvAdminSync(HjvAdminTexts t, HjvAdminPc p,
+    {required DateTime now, HjvAdminClock local = hjvAdminLocal}) {
+  final sync = p.lastSync;
+  return sync == null ? t.notSynced : hjvAdminWhen(sync, now, local: local);
+}
+
+/// The PC's address at its last sync: "192.0.2.10", or that hjv-api has none.
+String hjvAdminIp(HjvAdminTexts t, HjvAdminPc p) =>
+    p.ip.isEmpty ? t.unknownIp : p.ip;
+
+/// "192.0.2.10/24, 198.51.100.7/24", or "" for none.
+String hjvAdminLan(HjvAdminPc p) => p.lan.join(', ');
+
+/// The password-less state as the screen says it; a state this app does not know, as it is.
+String hjvAdminPwless(HjvAdminTexts t, String state) => switch (state) {
+      'active' => t.pwlessOn,
+      'off' => t.pwlessOff,
+      'disabled' => t.pwlessPaused,
+      'expired' => t.pwlessExpired,
+      'listed' => t.pwlessListed,
+      'needs-relogin' => t.pwlessRelogin,
+      _ => state,
+    };
+
+/// A PC's lines on a phone, under its title: the owner, the system, the last sync and IP, the
+/// LAN addresses when there are any, and the password-less state.
+List<String> hjvAdminPcLines(HjvAdminTexts t, HjvAdminPc p,
+    {required DateTime now, HjvAdminClock local = hjvAdminLocal}) {
+  final sync = p.lastSync;
+  final lan = hjvAdminLan(p);
+  return [
+    t.owner(hjvAdminOwner(p)),
+    hjvAdminSystem(t, p),
+    [
+      sync == null
+          ? t.notSynced
+          : t.lastSync(hjvAdminWhen(sync, now, local: local)),
+      p.ip.isEmpty ? t.unknownIp : 'IP ${p.ip}',
+    ].join(' · '),
+    if (lan.isNotEmpty) 'LAN $lan',
+    t.pwless(hjvAdminPwless(t, p.passwordless)),
+  ];
+}
+
+/// A user's row of the wide table: the user, whether active, the last use, the logged-in devices
+/// and the PCs.
+List<String> hjvAdminUserCells(HjvAdminTexts t, HjvAdminUser u,
+        {required DateTime now, HjvAdminClock local = hjvAdminLocal}) =>
+    [
+      hjvAdminUserTitle(u),
+      hjvAdminUserState(t, u),
+      hjvAdminLastUse(t, u, now: now, local: local),
+      '${u.keys}',
+      '${u.pcs}',
+    ];
+
+/// A PC's row of the wide table: the host name over the PC's ID, the owner, the system, the last
+/// sync, the IP over the LAN addresses, and the password-less state.
+List<String> hjvAdminPcCells(HjvAdminTexts t, HjvAdminPc p,
+        {required DateTime now, HjvAdminClock local = hjvAdminLocal}) =>
+    [
+      p.host.isEmpty ? formatID(p.pc) : '${p.host}\n${formatID(p.pc)}',
+      hjvAdminOwner(p),
+      hjvAdminSystem(t, p),
+      hjvAdminSync(t, p, now: now, local: local),
+      [hjvAdminIp(t, p), hjvAdminLan(p)].where((s) => s.isNotEmpty).join('\n'),
+      hjvAdminPwless(t, p.passwordless),
+    ];
+
+List<String> _pcFields(HjvAdminTexts t, HjvAdminPc p) => [
+      p.pc,
+      p.host,
+      p.owner,
+      p.ownerName,
+      p.os,
+      p.version,
+      p.ip,
+      ...p.lan,
+      hjvAdminPwless(t, p.passwordless),
+    ];
+
+/// What a search keeps: the users and the PCs that have each word of `query` in what their row
+/// shows, in any case. A user's state (활성, 비활성) is a word that must be all of it, as 활성 is
+/// in 비활성 and active in inactive. A user's portal ID or name also finds the user's PCs; a PC's
+/// ID as the screen writes it (123 456 789) is words that are each in the ID.
+(List<HjvAdminUser>, List<HjvAdminPc>) hjvAdminSearch(
+    HjvAdminTexts t, HjvAdminOverview o, String query) {
+  final words = query
+      .toLowerCase()
+      .split(RegExp(r'\s+'))
+      .where((w) => w.isNotEmpty)
+      .toList();
+  if (words.isEmpty) return (o.users, o.pcs);
+  bool keeps(List<String> fields, {String state = ''}) {
+    final text = fields.join('\n').toLowerCase();
+    final whole = state.toLowerCase();
+    return words.every((w) => text.contains(w) || w == whole);
+  }
+
+  return (
+    o.users
+        .where((u) => keeps([u.id, u.name], state: hjvAdminUserState(t, u)))
+        .toList(),
+    o.pcs.where((p) => keeps(_pcFields(t, p))).toList(),
+  );
+}
