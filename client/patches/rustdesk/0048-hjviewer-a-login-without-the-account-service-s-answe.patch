+    expect(en.networkFailed,
+        'Could not reach the server. Check the network connection and try again.');
+  });
+
   group('this PC in Settings → Account (design v3 §1-2)', () {
     test('every state of the service has its line', () {
       const mine = HjvOwner.mine;
@@ -1284,6 +1294,8 @@ void main() {
         t.retry,
         t.logIn,
         t.requestFailed,
+        t.serviceNotAnswering(404),
+        t.networkFailed,
         t.addedTitle,
         t.alreadyTitle,
         t.notAddedTitle,
