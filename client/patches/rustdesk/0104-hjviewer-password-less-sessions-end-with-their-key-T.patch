+            .check(&proof, true, &p.nonce, id, kind, Some(&p.cached), at)
+            .map(|e| e.id);
+        let open = entry_allows(&p.cached.list, &proof.pk, kind, id).map(|e| e.id.clone());
+        assert_eq!(new, open, "{kind} {id}");
+    }
+}
