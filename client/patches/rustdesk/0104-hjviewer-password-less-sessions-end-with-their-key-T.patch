+    /// T1: the table of design w5 5-2.
+    #[test]
+    fn judge_follows_the_designs_table() {
+        let e = entry(KIND_REMOTE);
+        let at = |latest: Latest| judge(&latest, &e).map(|(cut, _)| cut);
+        // the key listed: the session stays
+        assert_eq!(at(Latest::List(listed())), None);
+        // the key gone from the same binding's list, or listed under another device's ID
+        assert_eq!(at(removed()), Some(Cut::LoginEnded));
+        let moved = list(
+            BINDING,
+            "active",
+            vec![key(&pk(), "111111111", &["remote"])],
+        );
+        assert_eq!(
+            judge(&Latest::List(moved), &e),
+            Some((Cut::LoginEnded, "its device ID no longer matches"))
+        );
+        // its kind no longer allowed (the terminal never was)
+        let no_remote = list(BINDING, "active", vec![key(&pk(), CTL_ID, &["file"])]);
+        assert_eq!(at(Latest::List(no_remote)), Some(Cut::PcStopped));
+        assert_eq!(
+            judge(&Latest::List(listed()), &entry(KIND_TERMINAL)).map(|(c, _)| c),
+            Some(Cut::PcStopped)
+        );
+        assert_eq!(judge(&Latest::List(listed()), &entry(KIND_FILE)), None);
+        // the administrator's switch, a blocked account, one off the allowlist (D-5)
+        let mut disabled = listed();
+        disabled.state = "disabled".to_owned();
+        assert_eq!(
+            judge(&Latest::List(disabled), &e),
+            Some((Cut::PcStopped, "password-less logins are paused (disabled)"))
+        );
+        // a signed revoked, and this PC's logout (D-6)
+        assert_eq!(at(Latest::Revoked), Some(Cut::PcStopped));
+        assert_eq!(
+            judge(&Latest::Unbound, &e),
+            Some((Cut::PcStopped, "this PC was logged out"))
+        );
+        // another binding: the key listed there keeps the session, else the PC stopped (D4)
+        let mut again = listed();
+        again.binding = OTHER.to_owned();
+        assert_eq!(at(Latest::List(again)), None);
+        assert_eq!(
+            judge(&Latest::List(list(OTHER, "active", vec![])), &e),
+            Some((Cut::PcStopped, "this PC is bound to another login now"))
+        );
+    }
+
+    /// T3: the same list twice marks once.
+    #[test]
+    fn the_same_list_twice_marks_once() {
+        let book = Mutex::new(Book::new());
+        let proven = admit_one(&book, 0);
+        assert_eq!(proven.cut(), None);
+        sweep(&book, Latest::List(listed()));
+        assert_eq!(proven.cut(), None);
+        sweep(&book, removed());
+        assert_eq!(proven.cut(), Some(Cut::LoginEnded));
+        // a later reason does not overwrite the first
+        sweep(&book, Latest::Revoked);
+        assert_eq!(proven.cut(), Some(Cut::LoginEnded));
+        assert_eq!(epoch(&book), 3);
+    }
+
+    /// T4: a dropped Proven leaves the book.
+    #[test]
+    fn a_dropped_session_leaves_the_book() {
+        let book = Mutex::new(Book::new());
+        let kept = admit_one(&book, 0);
+        let gone = admit_one(&book, 0);
+        assert_eq!(book.lock().unwrap().entries.len(), 2);
+        drop(gone);
+        sweep(&book, removed());
+        assert_eq!(book.lock().unwrap().entries.len(), 1);
+        assert_eq!(kept.cut(), Some(Cut::LoginEnded));
+    }
+
+    /// T5: a proof judged by the latest list is not judged again; one judged by an older one is.
+    #[test]
+    fn a_proof_judged_before_a_sweep_is_judged_again() {
+        let book = Mutex::new(Book::new());
+        sweep(&book, removed());
+        let now = admit_one(&book, epoch(&book));
+        assert_eq!(now.cut(), None);
+        let old = admit_one(&book, 0);
+        assert_eq!(old.cut(), Some(Cut::LoginEnded));
+    }
+
+    /// T6: the race, both ways: the proof's epoch, then the sweep of a list without its key, then
+    /// its admission; and the admission before the sweep.
+    #[test]
+    fn a_proof_cannot_slip_past_a_sweep() {
+        let book = Mutex::new(Book::new());
+        sweep(&book, Latest::List(listed()));
+        let seen = epoch(&book);
+        // ... the proof is judged by the list that has its key ...
+        sweep(&book, removed());
+        assert_eq!(admit_one(&book, seen).cut(), Some(Cut::LoginEnded));
+
+        let book = Mutex::new(Book::new());
+        sweep(&book, Latest::List(listed()));
+        let proven = admit_one(&book, epoch(&book));
+        assert_eq!(proven.cut(), None);
+        sweep(&book, removed());
+        assert_eq!(proven.cut(), Some(Cut::LoginEnded));
+    }
+
+    /// T10: the two close reasons, byte for byte as the Dart tests have them, keep any controller
+    /// from connecting again and keep to texts.rs's rules.
+    #[test]
+    fn the_close_reasons_stop_the_reconnect_and_keep_the_text_rules() {
+        assert_eq!(
+            Cut::LoginEnded.wire_text(),
+            "이 기기의 로그인이 끝나 연결을 끊었습니다. (login ended, not allowed)"
+        );
+        assert_eq!(
+            Cut::PcStopped.wire_text(),
+            "이 PC가 비밀번호 없는 연결을 더 받지 않아 연결을 끊었습니다. (password-less ended, not allowed)"
+        );
+        for cut in [Cut::LoginEnded, Cut::PcStopped] {
+            let text = cut.wire_text();
+            assert!(!crate::client::check_if_retry(
+                "error",
+                "Connection Error",
+                text,
+                false
+            ));
+            assert!(!text.starts_with("Failed"));
+            assert!(!text.split(' ').next().unwrap().ends_with("_tip"));
+            assert!(!text.contains('{') && !text.contains('}'));
+            assert!(!text.contains("http") && !text.contains("://"));
+            assert_eq!(Cut::from_u8(cut as u8), Some(cut));
+        }
+        assert_eq!(Cut::from_u8(0), None);
+    }
+}
