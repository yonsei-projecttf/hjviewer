@@ -0,0 +1,395 @@
+//! TV-W5: the password-less sessions this PC let in, each by the account key that proved it,
+//! held against every signed list the sync task keeps (docs/architecture.md 5-6, item 8). A
+//! session the latest list no longer lets in gets a mark, which its connection's one-second
+//! timer reads (`Connection::hjv_account_cut`). In memory only: the service's restart ends the
+//! sessions too, and nothing goes to the server or to disk.
+//!
+//! Only a signed answer moves the book: a kept `active` or `disabled` list, a signed `revoked`,
+//! and this PC's own logout (D-6). An expired list, a failed sync and an unsigned answer change
+//! nothing here, and neither does the PC's [끄기] (the sync goes on, so the lists still come).
+
+use super::super::{entry_allows, kind_name, Cut, Proven, Refusal, TrustList};
+use hbb_common::log;
+use std::sync::{
+    atomic::{AtomicU8, Ordering},
+    Arc, Mutex, Weak,
+};
+
+/// The sessions and what the sync task last learned.
+pub(in crate::hjviewer_account) struct Book {
+    /// one up at every sweep, so that a proof judged before a sweep is judged again (admit)
+    epoch: u64,
+    latest: Option<Latest>,
+    entries: Vec<Entry>,
+}
+
+impl Book {
+    pub(in crate::hjviewer_account) const fn new() -> Book {
+        Book {
+            epoch: 0,
+            latest: None,
+            entries: Vec::new(),
+        }
+    }
+}
+
+/// What the sync task learned last.
+#[derive(Debug, Clone)]
+pub(in crate::hjviewer_account) enum Latest {
+    /// a signed list of the binding, kept (active or disabled)
+    List(TrustList),
+    /// a signed revoked for this PC's binding: the binding is gone
+    Revoked,
+    /// this PC logged out (an unbind request that dropped the binding, D-6)
+    Unbound,
+}
+
+/// One session: what its proof showed when the PC let it in.
+struct Entry {
+    conn: i32,
+    /// the account key, its 32 bytes
+    pk: Vec<u8>,
+    kind: u8,
+    /// LoginRequest.my_id
+    my_id: String,
+    /// the binding whose list let it in
+    binding: String,
+    /// the list's device name
+    name: String,
+    /// the connection's mark; gone once the connection dropped its Proven
+    cut: Weak<AtomicU8>,
+}
+
+/// The book's epoch, which a proof reads before it reads the list it is judged by.
+pub(in crate::hjviewer_account) fn epoch(book: &Mutex<Book>) -> u64 {
+    book.lock().unwrap().epoch
+}
+
+/// Registers an accepted proof. When a sweep came since `seen` (the epoch read before the view
+/// the proof was judged by), judges it at once against the latest, so that a proof let in by an
+/// older list cannot slip past a newer one.
+#[allow(clippy::too_many_arguments)]
+pub(in crate::hjviewer_account) fn admit(
+    book: &Mutex<Book>,
+    seen: u64,
+    conn: i32,
+    pk: &[u8],
+    kind: u8,
+    my_id: &str,
+    binding: &str,
+    name: &str,
+) -> Proven {
+    let cut = Arc::new(AtomicU8::new(0));
+    let mut entry = Entry {
+        conn,
+        pk: pk.to_vec(),
+        kind,
+        my_id: my_id.to_owned(),
+        binding: binding.to_owned(),
+        name: name.to_owned(),
+        cut: Arc::downgrade(&cut),
+    };
+    let mut book = book.lock().unwrap();
+    book.entries.retain(|e| e.cut.strong_count() > 0);
+    if book.epoch != seen {
+        if let Some(latest) = &book.latest {
+            if mark(latest, &entry, &cut) {
+                if let Latest::List(list) = latest {
+                    entry.binding.clone_from(&list.binding);
+                }
+            }
+        }
+    }
+    book.entries.push(entry);
+    Proven { cut }
+}
+
+/// What the sync task just learned: the epoch one up, the latest, and a mark for every session
+/// it no longer lets in, with one log line each. A session already marked is left alone, so the
+/// same list again marks and logs nothing.
+pub(in crate::hjviewer_account) fn sweep(book: &Mutex<Book>, latest: Latest) {
+    let mut guard = book.lock().unwrap();
+    let book = &mut *guard;
+    book.epoch = book.epoch.wrapping_add(1);
+    book.entries.retain(|e| e.cut.strong_count() > 0);
+    for entry in &mut book.entries {
+        let Some(cut) = entry.cut.upgrade() else {
+            continue;
+        };
+        // a session another binding's list keeps is that binding's from now on (D4)
+        if mark(&latest, entry, &cut) {
+            if let Latest::List(list) = &latest {
+                entry.binding.clone_from(&list.binding);
+            }
+        }
+    }
+    book.latest = Some(latest);
+}
+
+/// Marks one session if `latest` no longer lets it in, and logs it (design w5 3-3). Whether
+/// `latest` still lets it in.
+fn mark(latest: &Latest, entry: &Entry, cut: &AtomicU8) -> bool {
+    let Some((why, reason)) = judge(latest, entry) else {
+        return true;
+    };
+    if cut
+        .compare_exchange(0, why as u8, Ordering::AcqRel, Ordering::Acquire)
+        .is_ok()
+    {
+        log::info!(
+            "hjv: same-account session #{} ({}) of {} from {} ended: {reason}",
+            entry.conn,
+            kind_name(entry.kind),
+            entry.name,
+            entry.my_id
+        );
+    }
+    false
+}
+
+/// What `latest` says of one session (design w5 D2-D4), with the log's reason; None: it stays.
+/// The rule is a new proof's (`entry_allows`); the signature and the nonce were checked when the
+/// session came in. The binding may change while the key stays listed (the same account logged
+/// in again on this PC): the session stays.
+fn judge(latest: &Latest, e: &Entry) -> Option<(Cut, &'static str)> {
+    let list = match latest {
+        Latest::Revoked => return Some((Cut::PcStopped, "this PC's binding was revoked")),
+        Latest::Unbound => return Some((Cut::PcStopped, "this PC was logged out")),
+        Latest::List(list) => list,
+    };
+    match list.state.as_str() {
+        "active" => {}
+        "disabled" => return Some((Cut::PcStopped, "password-less logins are paused (disabled)")),
+        _ => return Some((Cut::PcStopped, "this PC's binding was revoked")),
+    }
+    let same = list.binding == e.binding;
+    match entry_allows(list, &e.pk, e.kind, &e.my_id) {
+        Ok(_) => None,
+        Err(Refusal::KindNotAllowed) => Some((Cut::PcStopped, "its kind is no longer allowed")),
+        Err(_) if !same => Some((Cut::PcStopped, "this PC is bound to another login now")),
+        Err(Refusal::IdMismatch) => Some((Cut::LoginEnded, "its device ID no longer matches")),
+        Err(_) => Some((Cut::LoginEnded, "its key is no longer listed")),
+    }
+}
