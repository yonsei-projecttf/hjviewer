diff --git a/flutter/lib/common/hjv_text_scale.dart b/flutter/lib/common/hjv_text_scale.dart
new file mode 100644
index 0000000..c9c0b0d
--- /dev/null
+++ b/flutter/lib/common/hjv_text_scale.dart
@@ -0,0 +1,54 @@
+// HJViewer UX-K3 (U58): the system's text size, within bounds. A phone or tablet follows it from
+// 100 % up to 130 % (a larger or non-linear choice stops at 130 %, a smaller one stays at 100 %);
+// a desktop stays at 100 %, as it has the screen's scale already and fixed panes. The remote
+// screen, its key bar and the gesture guide, and the terminal stay at 100 % on a phone too: what
+// they draw follows the remote side's pixels, not the phone's text.
+// Plain Flutter without the bridge.
+
+import 'package:flutter/widgets.dart';
+
+/// The smallest text scale the app takes: the system's smaller text is not followed.
+const double kHjvTextScaleMin = 1.0;
+
+/// The largest on a phone or tablet.
+const double kHjvPhoneTextScaleMax = 1.3;
+
+/// The largest on a desktop (Windows): 1.0, the system's text size is not followed (T5).
+const double kHjvDesktopTextScaleMax = 1.0;
+
+/// The largest text scale on a phone ([phone]) or a desktop.
+double hjvTextScaleMax({required bool phone}) =>
+    phone ? kHjvPhoneTextScaleMax : kHjvDesktopTextScaleMax;
+
+/// The system's [scaler] within the app's bounds. On a desktop it is the linear 1.0.
+TextScaler hjvClampTextScaler(TextScaler scaler, {required bool phone}) =>
+    scaler.clamp(
+        minScaleFactor: kHjvTextScaleMin,
+        maxScaleFactor: hjvTextScaleMax(phone: phone));
+
+/// The app's builder (MaterialApp.builder): [child] under the system's text scale within the
+/// app's bounds (hjvClampTextScaler).
+Widget hjvTextScaleBuilder(BuildContext context, Widget? child,
+    {required bool phone}) {
+  final data = MediaQuery.of(context);
+  return MediaQuery(
+    data: data.copyWith(
+        textScaler: hjvClampTextScaler(data.textScaler, phone: phone)),
+    child: child ?? const SizedBox.shrink(),
+  );
+}
+
+/// [child] at the text scale 1.0: the phone's remote screen with its key bar and gesture guide,
+/// and its terminal. A dialog that such a screen opens is above it, in the app's scale.
+Widget hjvFixedTextScale({required Widget child}) =>
+    MediaQuery.withNoTextScaling(child: child);
+
+/// How many lines a title that is one line on a desktop may take on a phone, where the text
+/// can be 130 % (a dialog's title, a notice card's title).
+int hjvTitleMaxLines({required bool phone}) => phone ? 2 : 1;
+
+/// A menu row's box (desktop/widgets/popup_menu.dart): [height] on a desktop; on a phone at least
+/// [height], higher for a larger text.
+BoxConstraints hjvMenuRowConstraints(double height, {required bool phone}) =>
+    BoxConstraints(
+        minHeight: height, maxHeight: phone ? double.infinity : height);
