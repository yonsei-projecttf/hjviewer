diff --git a/flutter/test/hjviewer_text_scale_test.dart b/flutter/test/hjviewer_text_scale_test.dart
new file mode 100644
index 0000000..4ccb82c
--- /dev/null
+++ b/flutter/test/hjviewer_text_scale_test.dart
@@ -0,0 +1,134 @@
+// HJViewer UX-K3 (U58): the system's text size within the app's bounds (hjv_text_scale.dart).
+// Plain Flutter without the bridge.
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjv_text_scale.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// Android 14's non-linear font size: small text grows more than large text
+class _NonLinear extends TextScaler {
+  const _NonLinear();
+
+  @override
+  double scale(double fontSize) => fontSize < 20 ? fontSize * 2 : fontSize * 1.5;
+
+  @override
+  double get textScaleFactor => 2;
+}
+
+// the text scale a widget under the app's builder sees, for a system's [system]
+Future<TextScaler> _scalerUnder(WidgetTester tester, TextScaler system,
+    {required bool phone, bool fixed = false}) async {
+  late TextScaler seen;
+  final probe = Builder(builder: (context) {
+    seen = MediaQuery.textScalerOf(context);
+    return const SizedBox.shrink();
+  });
+  await tester.pumpWidget(MediaQuery(
+    data: MediaQueryData(textScaler: system),
+    child: Builder(
+        builder: (context) => hjvTextScaleBuilder(
+            context, fixed ? hjvFixedTextScale(child: probe) : probe,
+            phone: phone)),
+  ));
+  return seen;
+}
+
+void main() {
+  group('the system text size', () {
+    test('a phone follows it from 100 % to 130 %', () {
+      double at(double factor) =>
+          hjvClampTextScaler(TextScaler.linear(factor), phone: true).scale(10);
+      expect(at(1.15), closeTo(11.5, 1e-9));
+      expect(at(2.0), closeTo(13, 1e-9));
+      expect(at(0.85), 10);
+    });
+
+    test('a phone stops a non-linear size at 130 % of each size', () {
+      final scaler = hjvClampTextScaler(const _NonLinear(), phone: true);
+      expect(scaler.scale(14), closeTo(18.2, 1e-9));
+      expect(scaler.scale(24), closeTo(31.2, 1e-9));
+    });
+
+    test('a desktop stays at 100 %', () {
+      expect(hjvClampTextScaler(TextScaler.linear(1.5), phone: false).scale(14),
+          14);
+      expect(hjvClampTextScaler(const _NonLinear(), phone: false).scale(14), 14);
+    });
+
+    testWidgets('the app\'s builder gives a phone\'s screens 130 % of a system\'s 200 %',
+        (tester) async {
+      final phone =
+          await _scalerUnder(tester, TextScaler.linear(2), phone: true);
+      expect(phone.scale(14), closeTo(18.2, 1e-9));
+      final desktop =
+          await _scalerUnder(tester, TextScaler.linear(2), phone: false);
+      expect(desktop.scale(14), 14);
+    });
+
+    testWidgets('the remote screen\'s and the terminal\'s wrapper keeps 100 %',
+        (tester) async {
+      final fixed = await _scalerUnder(tester, TextScaler.linear(2),
+          phone: true, fixed: true);
+      expect(fixed.scale(14), 14);
+    });
+  });
+
+  group('room for the larger text', () {
+    test('a phone\'s menu row grows past its height, a desktop\'s does not', () {
+      expect(hjvMenuRowConstraints(20, phone: true),
+          const BoxConstraints(minHeight: 20));
+      expect(hjvMenuRowConstraints(20, phone: false),
+          const BoxConstraints(minHeight: 20, maxHeight: 20));
+    });
+
+    // a 320 px phone at the system's 200 %, through the app's builder as main.dart has it
+    Widget card(TargetPlatform platform) => MediaQuery(
+          data: const MediaQueryData(
+              size: Size(320, 640), textScaler: TextScaler.linear(2)),
+          child: MaterialApp(
+            theme: ThemeData(platform: platform),
+            builder: (context, child) => hjvTextScaleBuilder(context, child,
+                phone: platform != TargetPlatform.windows),
+            home: const Scaffold(
+              body: SizedBox(
+                width: 320,
+                child: HjvCallout(
+                  tone: HjvTone.warning,
+                  icon: Icons.info_outline_rounded,
+                  title: '로그인했지만 서버가 이 PC를 아직 받지 않고 있습니다',
+                  text: '잠시 뒤에 다시 확인합니다.',
+                  titleOneLine: true,
+                ),
+              ),
+            ),
+          ),
+        );
+
+    int titleLines(WidgetTester tester) {
+      final title = tester.renderObjectList<RenderParagraph>(find.byWidgetPredicate(
+              (w) => w is RichText && w.maxLines != null))
+          .first;
+      return title.getBoxesForSelection(TextSelection(
+              baseOffset: 0, extentOffset: title.text.toPlainText().length))
+          .map((b) => b.top)
+          .toSet()
+          .length;
+    }
+
+    testWidgets('a card\'s one-line title takes two lines at 130 % on a phone, no overflow',
+        (tester) async {
+      await tester.pumpWidget(card(TargetPlatform.android));
+      expect(tester.takeException(), isNull);
+      expect(titleLines(tester), 2);
+    });
+
+    testWidgets('and stays one line on a desktop', (tester) async {
+      await tester.pumpWidget(card(TargetPlatform.windows));
+      expect(tester.takeException(), isNull);
+      expect(titleLines(tester), 1);
+    });
+  });
+}
