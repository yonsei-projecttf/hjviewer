diff --git a/flutter/test/hjviewer_semantics_test.dart b/flutter/test/hjviewer_semantics_test.dart
new file mode 100644
index 0000000..57cfada
--- /dev/null
+++ b/flutter/test/hjviewer_semantics_test.dart
@@ -0,0 +1,127 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjv_semantics.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// UX-K2 (U59), what a screen reader hears (common/hjv_semantics.dart): the selected tab and side
+// bar row, a settings group's heading, the live notices (HjvCallout's liveRegion), and the PC
+// list tabs' filled and outlined icons. Plain Flutter, no bridge.
+
+Widget app(Widget child) =>
+    MaterialApp(home: Scaffold(body: Center(child: child)));
+
+void main() {
+  testWidgets('a tab says it is the selected one, the others that they are not',
+      (tester) async {
+    final semantics = tester.ensureSemantics();
+    Widget tab(String name, bool selected) => hjvSelectedSemantics(
+        selected: selected,
+        child: Tooltip(
+            message: name,
+            child: InkWell(onTap: () {}, child: const Icon(Icons.star))));
+    await tester.pumpWidget(app(Row(mainAxisSize: MainAxisSize.min, children: [
+      tab('Favorites', true),
+      tab('Recent sessions', false),
+    ])));
+    expect(
+        tester.getSemantics(find.byTooltip('Favorites')),
+        containsSemantics(
+            tooltip: 'Favorites',
+            isButton: true,
+            isSelected: true,
+            hasTapAction: true));
+    expect(
+        tester.getSemantics(find.byTooltip('Recent sessions')),
+        containsSemantics(
+            tooltip: 'Recent sessions',
+            isButton: true,
+            isSelected: false,
+            hasTapAction: true));
+    semantics.dispose();
+  });
+
+  testWidgets('a settings group title is a heading', (tester) async {
+    final semantics = tester.ensureSemantics();
+    await tester.pumpWidget(app(ListView(children: [
+      hjvHeaderSemantics(const Text('Security')),
+      const ListTile(title: Text('Row')),
+    ])));
+    expect(tester.getSemantics(find.text('Security')),
+        containsSemantics(label: 'Security', isHeader: true));
+    expect(tester.getSemantics(find.text('Row')),
+        containsSemantics(isHeader: false));
+    semantics.dispose();
+  });
+
+  testWidgets(
+      'a live notice reads its title, or its text without one; others are not live',
+      (tester) async {
+    final semantics = tester.ensureSemantics();
+    await tester
+        .pumpWidget(app(const Column(mainAxisSize: MainAxisSize.min, children: [
+      HjvCallout(
+          title: 'Not connected to the server',
+          text: 'Why',
+          titleOneLine: true,
+          tone: HjvTone.warning,
+          liveRegion: true),
+      HjvCallout(text: 'Stay logged in', liveRegion: true),
+    ])));
+    expect(
+        tester.getSemantics(find.text('Not connected to the server')),
+        containsSemantics(
+            label: 'Not connected to the server', isLiveRegion: true));
+    expect(tester.getSemantics(find.text('Why')),
+        containsSemantics(isLiveRegion: false));
+    expect(tester.getSemantics(find.text('Stay logged in')),
+        containsSemantics(label: 'Stay logged in', isLiveRegion: true));
+
+    await tester
+        .pumpWidget(app(const HjvCallout(title: 'Title', text: 'Text')));
+    expect(
+        find.byWidgetPredicate(
+            (w) => w is Semantics && w.properties.liveRegion == true),
+        findsNothing);
+    semantics.dispose();
+  });
+
+  testWidgets('a live status line reads its new text as one node',
+      (tester) async {
+    final semantics = tester.ensureSemantics();
+    final text = ValueNotifier('Connecting');
+    await tester.pumpWidget(app(ValueListenableBuilder<String>(
+        valueListenable: text,
+        builder: (_, value, __) =>
+            Row(mainAxisSize: MainAxisSize.min, children: [
+              const SizedBox(width: 8, height: 8),
+              hjvLiveRegion(Text(value)),
+            ]))));
+    text.value = 'Ready';
+    await tester.pump();
+    expect(tester.getSemantics(find.text('Ready')),
+        containsSemantics(label: 'Ready', isLiveRegion: true));
+    semantics.dispose();
+  });
+
+  test('the PC list tabs: filled when selected, outlined otherwise', () {
+    const deviceGroupFill = IconData(0xe748, fontFamily: 'DeviceGroup');
+    const deviceGroupOutline = IconData(0xe623, fontFamily: 'DeviceGroup');
+    const addressBook = IconData(0xe602, fontFamily: 'AddressBook');
+    for (final (filled, outlined) in [
+      (Icons.access_time_filled, Icons.access_time),
+      (Icons.star, Icons.star_border),
+      (Icons.explore, Icons.explore_outlined),
+      (deviceGroupFill, deviceGroupOutline),
+    ]) {
+      expect(hjvPeerTabIcon(filled, selected: true),
+          (icon: filled, underline: false));
+      expect(hjvPeerTabIcon(filled, selected: false),
+          (icon: outlined, underline: false));
+    }
+    // no outlined twin: the selected pill underlines its icon
+    expect(hjvPeerTabIcon(addressBook, selected: true),
+        (icon: addressBook, underline: true));
+    expect(hjvPeerTabIcon(addressBook, selected: false),
+        (icon: addressBook, underline: false));
+  });
