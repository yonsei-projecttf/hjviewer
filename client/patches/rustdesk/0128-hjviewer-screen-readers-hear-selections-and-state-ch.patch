index 0000000..4b6fd24
--- /dev/null
+++ b/flutter/lib/common/hjv_semantics.dart
@@ -0,0 +1,50 @@
+// HJViewer UX-K2 (U59): what a screen reader (Narrator, TalkBack, VoiceOver) hears of a choice
+// and of a change: which tab or side bar row is selected, where a group of settings starts, and a
+// status or notice that changes while nobody looks at it.
+// The dialogs' reading range is M2's (common.dart, OverlayDialogManager.show). Plain Flutter
+// without the bridge, so that ci.sh tests it with the web stand-in (test/hjviewer_semantics_test.dart).
+
+import 'package:flutter/material.dart';
+
+/// A tab or a side bar row that selects a page: one node that is a button and says whether it is
+/// the selected one ("selected" / "선택됨"). Its label, its tooltip and its tap come from `child`.
+Widget hjvSelectedSemantics({required bool selected, required Widget child}) =>
+    Semantics(container: true, button: true, selected: selected, child: child);
+
+/// The title of a group of settings (a heading, which screen readers jump between).
+Widget hjvHeaderSemantics(Widget child) =>
+    Semantics(container: true, header: true, child: child);
+
+/// A text that a screen reader reads again when it changes (a live region), without the user
+/// going to it: the PC's status line, the notice above the PC's ID. Flutter reports a live region
+/// only when its text changes, so writing the same text again every second reads nothing.
+Widget hjvLiveRegion(Widget child) =>
+    Semantics(container: true, liveRegion: true, child: child);
+
+/// The device group font's outlined twin of upstream's filled 'Accessible devices' icon
+/// (common.dart IconFont.deviceGroupOutline / deviceGroupFill, kept here without the bridge).
+const IconData _kDeviceGroupFill = IconData(0xe748, fontFamily: 'DeviceGroup');
+const IconData _kDeviceGroupOutline =
+    IconData(0xe623, fontFamily: 'DeviceGroup');
+
+/// A PC list tab's icon (peer_tab_model.dart's filled ones): the filled icon on the selected tab,
+/// its outlined twin on the others, so that the choice shows without its colour, as the settings
+/// side bar's. `underline`: the selected tab's icon has no twin (the address book's), and its
+/// pill draws a 2 px line under the icon instead.
+({IconData icon, bool underline}) hjvPeerTabIcon(IconData filled,
+    {required bool selected}) {
+  final IconData? outlined;
+  if (filled == Icons.access_time_filled) {
+    outlined = Icons.access_time;
+  } else if (filled == Icons.star) {
+    outlined = Icons.star_border;
+  } else if (filled == Icons.explore) {
+    outlined = Icons.explore_outlined;
+  } else if (filled == _kDeviceGroupFill) {
+    outlined = _kDeviceGroupOutline;
+  } else {
+    outlined = null;
+  }
+  if (selected) return (icon: filled, underline: outlined == null);
+  return (icon: outlined ?? filled, underline: false);
+}
