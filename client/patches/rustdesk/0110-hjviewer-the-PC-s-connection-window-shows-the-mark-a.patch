+
+// HJViewer (TV-W2): the mark line under the name in the kind's fixed icon and colour (nothing for
+// no mark or a kind this window does not know), "Recording" beside the time and the card's line
+// on how to stop it (hjviewer_cm_texts.dart).
+
+Widget _hjvMarkLine(BuildContext context, Client client) {
+  final view = hjvMarkView(client.hjvMarkKind, client.hjvMarkWho, hjvCmTexts());
+  if (view == null) return const SizedBox.shrink();
+  final p = HjvPalette.of(context);
+  final color = view.warning ? p.warningText : p.primaryStrong;
+  return Semantics(
+    label: view.text,
+    excludeSemantics: true,
+    child: Tooltip(
+      message: view.tooltip,
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Icon(
+              view.warning
+                  ? Icons.warning_amber_rounded
+                  : Icons.verified_user_rounded,
+              size: 14,
+              color: view.warning ? p.warningText : p.primary),
+          const SizedBox(width: 4),
+          Flexible(
+            child: Text(view.text,
+                maxLines: 1,
+                overflow: TextOverflow.ellipsis,
+                style: TextStyle(
+                    color: color, fontSize: 12, fontWeight: FontWeight.w600)),
+          ),
+        ],
+      ),
+    ),
+  ).marginOnly(bottom: 2);
+}
+
+Widget _hjvRecordingChip(BuildContext context) {
+  final t = hjvCmTexts();
+  final p = HjvPalette.of(context);
+  return Tooltip(
+    message: t.recordingTip,
+    child: Container(
+      padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 1),
+      decoration: BoxDecoration(
+          color: p.dangerSoft,
+          borderRadius: BorderRadius.circular(HjvRadius.sm)),
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Container(
+              width: 7,
+              height: 7,
+              decoration:
+                  BoxDecoration(color: p.danger, shape: BoxShape.circle)),
+          const SizedBox(width: 4),
+          Text(t.recording,
+              style: TextStyle(
+                  color: p.dangerText,
+                  fontSize: 12,
+                  fontWeight: FontWeight.w600)),
+        ],
+      ),
+    ),
+  );
+}
+
+Widget _hjvRecordingLine(BuildContext context) {
+  final canChange =
+      bind.mainGetBuildinOption(key: kOptionEnablePermChangeInAcceptWindow) !=
+          'N';
+  return HjvCallout(
+    text: hjvCmTexts().recordingLine(canChange: canChange),
+    tone: HjvTone.danger,
+    icon: Icons.fiber_manual_record_rounded,
+  ).marginOnly(left: 4.0, right: 4.0, top: 8.0);
+}
