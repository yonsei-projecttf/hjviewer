diff --git a/flutter/lib/common/hjviewer_cm_texts.dart b/flutter/lib/common/hjviewer_cm_texts.dart
new file mode 100644
index 0000000..5a28c3e
--- /dev/null
+++ b/flutter/lib/common/hjviewer_cm_texts.dart
@@ -0,0 +1,163 @@
+// The PC connection window's (CM's) HJViewer texts, in Korean and English, and the choices
+// between them (the hjviewer repository's docs/architecture.md 5-10, TV-W2): the mark line under
+// a peer's name, which the process that took the connection decides (IPC Login.hjv_mark) and
+// never the name the peer typed; the caution box on the accept card and in the PC's access
+// password (P2) and support code (P3) dialogs, with the HJViewer administrator's contact from the
+// signed version policy; and "Recording" while the peer's app reports that it records, with the
+// rule that brings the minimized window up. Plain Dart without the bridge, so that ci.sh tests it
+// with the web stand-in; hjv_admin_contact.dart, server_page.dart and hjviewer_access.dart show
+// them.
+
+import 'package:flutter_hbb/common/hjviewer_account_texts.dart'
+    show hjvAdminContactText;
+
+/// hjv_mark.kind: an accepted same-account proof (`who` is the signed list's masked owner).
+const kHjvMarkSameAccount = 'same-account';
+
+/// hjv_mark.kind: the PC that entered a support code checked its maker's login (TV-W6).
+const kHjvMarkStaff = 'staff';
+
+/// hjv_mark.kind: no proof, and the name imitates a mark (src/hjviewer_cm.rs).
+const kHjvMarkUnverifiedName = 'unverified-name';
+
+/// The longest the connection window stays down after it last came up for a connection's
+/// recording (D-8): a peer that switches recording on and off cannot keep raising it.
+const kHjvRaiseEveryMs = 60 * 1000;
+
+/// IPC Login.hjv_mark as the add_connection JSON carries it (`{"kind", "who"}`): read only from a
+/// map of strings; a 1.8.x core sends none and anything else reads as no mark.
+({String kind, String who}) hjvReadMark(Object? json) {
+  if (json is! Map) return (kind: '', who: '');
+  final kind = json['kind'];
+  final who = json['who'];
+  return (kind: kind is String ? kind : '', who: who is String ? who : '');
+}
+
+/// The add_connection JSON's `hjv_recording`: true only when it says so.
+bool hjvReadRecording(Object? json) => json == true;
+
+/// Where a caution box stands.
+enum HjvCautionPlace {
+  /// the connection window's accept card
+  accept,
+
+  /// P2, the PC's access password
+  pcPassword,
+
+  /// P3, the PC's support code
+  pcCode,
+}
+
+/// The mark line: its words, its tooltip and whether it warns (the icon and colour are fixed by
+/// the kind, in server_page.dart).
+class HjvMarkView {
+  final String text;
+  final String tooltip;
+  final bool warning;
+  const HjvMarkView(this.text, this.tooltip, {this.warning = false});
+}
+
+class HjvCmTexts {
+  final bool korean;
+  const HjvCmTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  // the mark line (critic 2-5)
+  String sameAccount(String who) => who.isEmpty
+      ? _t('같은 계정 확인됨', 'Same account, verified')
+      : _t('같은 계정 확인됨 · $who', 'Same account, verified · $who');
+  String get sameAccountTip => _t(
+      '이 기기가 이 PC에 로그인한 계정의 기기임을 서명으로 증명했습니다. 이름은 서버가 서명한 목록의 것입니다.',
+      'This device proved with a signature that it belongs to the account logged in on this PC. Its name comes from the list the server signed.');
+  String get unverifiedName => _t('확인되지 않은 이름', 'Unverified name');
+  String get unverifiedNameTip => _t(
+      "상대가 스스로 적은 이름입니다. '같은 계정' 같은 말이 들어 있어도 HJViewer가 확인한 것이 아닙니다.",
+      'The other side typed this name itself. Words such as "same account" in it were not checked by HJViewer.');
+
+  // the caution box (W2 3-2; P3's per critic 2-5, X-09)
+  String get cautionAccept => _t(
+      '모르는 사람의 연결은 받지 마세요. 학교를 사칭한 연락을 받고 이 창이 떴다면 [거부]를 누르고 관리자에게 알려 주세요.',
+      'Do not accept connections from people you do not know. If someone claiming to be the university asked you for this, click [Dismiss] and tell the administrator.');
+  String get cautionAcceptNoContact => _t(
+      '모르는 사람의 연결은 받지 마세요. 학교를 사칭한 연락을 받고 이 창이 떴다면 [거부]를 누르세요.',
+      'Do not accept connections from people you do not know. If someone claiming to be the university asked you for this, click [Dismiss].');
+  String get cautionPcPassword => _t(
+      '모르는 사람이 전화나 문자로 이 비밀번호를 넣으라고 했다면 넣지 마세요. 학교를 사칭한 연락이면 끊고 관리자에게 알려 주세요.',
+      'If someone you do not know asked you by phone or message to enter this password, do not. If they claimed to be the university, hang up and tell the administrator.');
+  String get cautionPcPasswordNoContact => _t(
+      '모르는 사람이 전화나 문자로 이 비밀번호를 넣으라고 했다면 넣지 마세요.',
+      'If someone you do not know asked you by phone or message to enter this password, do not.');
+  String get cautionPcCode => _t(
+      '직접 도움을 부탁하지 않았는데 이 코드를 넣으라는 연락을 받았다면 넣지 마세요. 학교를 사칭한 연락이면 끊고 관리자에게 알려 주세요.',
+      'If you did not ask for help yourself and someone contacted you to enter this code, do not. If they claimed to be the university, hang up and tell the administrator.');
+  String get cautionPcCodeNoContact => _t(
+      '직접 도움을 부탁하지 않았는데 이 코드를 넣으라는 연락을 받았다면 넣지 마세요.',
+      'If you did not ask for help yourself and someone contacted you to enter this code, do not.');
+  String get contactCopied => _t('연락처를 복사했습니다.', 'Contact copied.');
+
+  // recording (W2 3-3)
+  String get recording => _t('녹화 중', 'Recording');
+  String get recordingTip => _t(
+      '상대 앱이 알려 준 상태입니다. 상대가 다른 프로그램으로 녹화하면 여기에 보이지 않습니다.',
+      "This is what the other side's app reports. Recording with another program does not show here.");
+  String recordingLine({required bool canChange}) => canChange
+      ? _t("상대가 이 연결의 화면을 녹화하고 있습니다. 멈추게 하려면 권한에서 '세션 녹화 허용'을 끄세요.",
+          "The other side is recording this connection's screen. To stop it, turn off \"Enable recording session\" under Permissions.")
+      : _t('상대가 이 연결의 화면을 녹화하고 있습니다.',
+          "The other side is recording this connection's screen.");
+}
+
+/// The mark line for hjv_mark's kind and who; null (no line) for "" and for a kind this window
+/// does not draw, so that a newer service never draws a mark here by mistake. `staff` is drawn
+/// with TV-W6's words (P4).
+HjvMarkView? hjvMarkView(String kind, String who, HjvCmTexts t) =>
+    switch (kind) {
+      kHjvMarkSameAccount =>
+        HjvMarkView(t.sameAccount(who.trim()), t.sameAccountTip),
+      kHjvMarkUnverifiedName =>
+        HjvMarkView(t.unverifiedName, t.unverifiedNameTip, warning: true),
+      _ => null,
+    };
+
+/// The accept card's caution box (D5, D-7): while a connection waits for [수락] and nothing
+/// proved who it is; never on a connected or ended card.
+bool hjvShowCaution(
+        {required bool authorized,
+        required bool disconnected,
+        required String kind}) =>
+    !authorized &&
+    !disconnected &&
+    kind != kHjvMarkSameAccount &&
+    kind != kHjvMarkStaff;
+
+/// The caution box's text in `place`, with or without a contact to tell.
+String hjvCautionText(HjvCmTexts t,
+    {required HjvCautionPlace place, required String contact}) {
+  final has = contact.trim().isNotEmpty;
+  return switch (place) {
+    HjvCautionPlace.accept => has ? t.cautionAccept : t.cautionAcceptNoContact,
+    HjvCautionPlace.pcPassword =>
+      has ? t.cautionPcPassword : t.cautionPcPasswordNoContact,
+    HjvCautionPlace.pcCode => has ? t.cautionPcCode : t.cautionPcCodeNoContact,
+  };
+}
+
+/// The caution box's second line, "HJViewer 관리자: <contact>" (the About screen's words); null
+/// without a contact.
+String? hjvContactLine(HjvCmTexts t, String contact) {
+  final c = contact.trim();
+  return c.isEmpty ? null : hjvAdminContactText(c, korean: t.korean);
+}
+
+/// D-8: whether the minimized connection window comes up for a connection whose recording state
+/// went from `was` to `now`: only when recording starts, and once a minute per connection at
+/// most (`lastRaisedMs`: when it last came up for this connection, null if never).
+bool hjvShouldRaise(
+        {required bool was,
+        required bool now,
+        required int? lastRaisedMs,
+        required int nowMs}) =>
+    !was &&
+    now &&
+    (lastRaisedMs == null || nowMs - lastRaisedMs >= kHjvRaiseEveryMs);
