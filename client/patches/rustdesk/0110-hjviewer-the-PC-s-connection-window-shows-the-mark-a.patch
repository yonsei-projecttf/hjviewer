diff --git a/flutter/test/hjviewer_cm_test.dart b/flutter/test/hjviewer_cm_test.dart
new file mode 100644
index 0000000..e826c13
--- /dev/null
+++ b/flutter/test/hjviewer_cm_test.dart
@@ -0,0 +1,125 @@
+import 'package:flutter_hbb/common/hjviewer_cm_texts.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The PC connection window's marks, cautions and recording rule (the hjviewer repository's
+// docs/architecture.md 5-10, access-tickets.md 5-3), without the bridge. The caution texts are
+// the contract's words, letter for letter.
+
+const ko = HjvCmTexts(true);
+const en = HjvCmTexts(false);
+
+void main() {
+  test('the mark line comes from the kind, never from the name', () {
+    expect(hjvMarkView('same-account', '홍*동', ko)?.text, '같은 계정 확인됨 · 홍*동');
+    expect(hjvMarkView('same-account', '', ko)?.text, '같은 계정 확인됨');
+    expect(hjvMarkView('same-account', '홍*동', en)?.text,
+        'Same account, verified · 홍*동');
+    expect(hjvMarkView('same-account', '', en)?.text, 'Same account, verified');
+    expect(hjvMarkView('same-account', '', ko)?.warning, isFalse);
+    expect(hjvMarkView('unverified-name', '', ko)?.text, '확인되지 않은 이름');
+    expect(hjvMarkView('unverified-name', '', en)?.text, 'Unverified name');
+    expect(hjvMarkView('unverified-name', '', ko)?.warning, isTrue);
+    for (final kind in ['', 'same account', 'Same-Account', 'admin']) {
+      expect(hjvMarkView(kind, '홍*동', ko), isNull, reason: kind);
+    }
+  });
+
+  test('the caution box only on an accept card nothing proved', () {
+    for (final kind in ['', 'unverified-name', 'something-new']) {
+      expect(hjvShowCaution(authorized: false, disconnected: false, kind: kind),
+          isTrue,
+          reason: kind);
+    }
+    for (final kind in ['same-account', 'staff']) {
+      expect(hjvShowCaution(authorized: false, disconnected: false, kind: kind),
+          isFalse,
+          reason: kind);
+    }
+    expect(hjvShowCaution(authorized: true, disconnected: false, kind: ''),
+        isFalse);
+    expect(hjvShowCaution(authorized: false, disconnected: true, kind: ''),
+        isFalse);
+  });
+
+  test('the caution texts are the contract words', () {
+    String text(HjvCmTexts t, HjvCautionPlace place, String contact) =>
+        hjvCautionText(t, place: place, contact: contact);
+    const c = 'help@example.org';
+    expect(text(ko, HjvCautionPlace.accept, c),
+        '모르는 사람의 연결은 받지 마세요. 학교를 사칭한 연락을 받고 이 창이 떴다면 [거부]를 누르고 관리자에게 알려 주세요.');
+    expect(text(ko, HjvCautionPlace.accept, ' '),
+        '모르는 사람의 연결은 받지 마세요. 학교를 사칭한 연락을 받고 이 창이 떴다면 [거부]를 누르세요.');
+    expect(text(en, HjvCautionPlace.accept, c),
+        'Do not accept connections from people you do not know. If someone claiming to be the university asked you for this, click [Dismiss] and tell the administrator.');
+    expect(text(en, HjvCautionPlace.accept, ''),
+        'Do not accept connections from people you do not know. If someone claiming to be the university asked you for this, click [Dismiss].');
+    expect(text(ko, HjvCautionPlace.pcPassword, c),
+        '모르는 사람이 전화나 문자로 이 비밀번호를 넣으라고 했다면 넣지 마세요. 학교를 사칭한 연락이면 끊고 관리자에게 알려 주세요.');
+    expect(text(ko, HjvCautionPlace.pcPassword, ''),
+        '모르는 사람이 전화나 문자로 이 비밀번호를 넣으라고 했다면 넣지 마세요.');
+    expect(text(en, HjvCautionPlace.pcPassword, c),
+        'If someone you do not know asked you by phone or message to enter this password, do not. If they claimed to be the university, hang up and tell the administrator.');
+    expect(text(en, HjvCautionPlace.pcPassword, ''),
+        'If someone you do not know asked you by phone or message to enter this password, do not.');
+    expect(text(ko, HjvCautionPlace.pcCode, c),
+        '직접 도움을 부탁하지 않았는데 이 코드를 넣으라는 연락을 받았다면 넣지 마세요. 학교를 사칭한 연락이면 끊고 관리자에게 알려 주세요.');
+    expect(text(ko, HjvCautionPlace.pcCode, ''),
+        '직접 도움을 부탁하지 않았는데 이 코드를 넣으라는 연락을 받았다면 넣지 마세요.');
+    expect(text(en, HjvCautionPlace.pcCode, c),
+        'If you did not ask for help yourself and someone contacted you to enter this code, do not. If they claimed to be the university, hang up and tell the administrator.');
+    expect(text(en, HjvCautionPlace.pcCode, ''),
+        'If you did not ask for help yourself and someone contacted you to enter this code, do not.');
+  });
+
+  test('the contact line', () {
+    expect(hjvContactLine(ko, '  help@example.org '),
+        'HJViewer 관리자: help@example.org');
+    expect(hjvContactLine(en, 'help@example.org'),
+        'HJViewer administrator: help@example.org');
+    expect(hjvContactLine(ko, ''), isNull);
+    expect(hjvContactLine(ko, '  '), isNull);
+  });
+
+  test('the window comes up when recording starts, once a minute', () {
+    const t0 = 1000000;
+    expect(hjvShouldRaise(was: false, now: true, lastRaisedMs: null, nowMs: t0),
+        isTrue);
+    expect(hjvShouldRaise(was: true, now: true, lastRaisedMs: null, nowMs: t0),
+        isFalse);
+    expect(hjvShouldRaise(was: true, now: false, lastRaisedMs: null, nowMs: t0),
+        isFalse);
+    expect(
+        hjvShouldRaise(
+            was: false, now: true, lastRaisedMs: t0, nowMs: t0 + 59999),
+        isFalse);
+    expect(
+        hjvShouldRaise(
+            was: false, now: true, lastRaisedMs: t0, nowMs: t0 + 60000),
+        isTrue);
+  });
+
+  test('a core without the fields reads as no mark and no recording', () {
+    for (final json in [null, 'same-account', 3, [], <String, dynamic>{}]) {
+      final m = hjvReadMark(json);
+      expect((m.kind, m.who), ('', ''), reason: '$json');
+    }
+    final m = hjvReadMark({'kind': 'same-account', 'who': '홍*동'});
+    expect((m.kind, m.who), ('same-account', '홍*동'));
+    final odd = hjvReadMark({'kind': 1, 'who': null});
+    expect((odd.kind, odd.who), ('', ''));
+    expect(hjvReadRecording(true), isTrue);
+    for (final v in [null, false, 'true', 1]) {
+      expect(hjvReadRecording(v), isFalse, reason: '$v');
+    }
+  });
+
+  test('the recording texts', () {
+    expect(ko.recording, '녹화 중');
+    expect(en.recording, 'Recording');
+    expect(ko.recordingLine(canChange: true),
+        "상대가 이 연결의 화면을 녹화하고 있습니다. 멈추게 하려면 권한에서 '세션 녹화 허용'을 끄세요.");
+    expect(ko.recordingLine(canChange: false), '상대가 이 연결의 화면을 녹화하고 있습니다.');
+    expect(en.recordingLine(canChange: true),
+        'The other side is recording this connection\'s screen. To stop it, turn off "Enable recording session" under Permissions.');
+  });
+}
