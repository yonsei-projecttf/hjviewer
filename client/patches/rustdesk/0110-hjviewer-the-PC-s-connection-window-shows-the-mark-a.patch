@@ -0,0 +1,78 @@
+// Who "HJViewer 관리자" is, as the signed version policy names it (its `contact_ko`; the
+// hjviewer repository's docs/architecture.md 8-2), and the caution box that tells it (TV-W2, 5-10):
+// the connection window's accept card, the PC's access password (P2) and support code (P3). The
+// contact is never in the app: the core's main_get_common("hjv-admin-contact") gives the policy
+// this process trusts, or "" (src/hjviewer_update/mod.rs). The texts are hjviewer_cm_texts.dart.
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjviewer_cm_texts.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+
+/// The HJViewer administrator's contact line of the policy this process trusts; "" without one
+/// (or without a core that knows the key).
+String hjvAdminContact() {
+  try {
+    return bind.mainGetCommonSync(key: 'hjv-admin-contact').trim();
+  } catch (e) {
+    return '';
+  }
+}
+
+/// The connection window's texts in the language of the app's own, as the access screens pick it.
+HjvCmTexts hjvCmTexts() => HjvCmTexts(translate('Cancel') == '취소');
+
+/// A caution in the warning tone (HjvCallout): `text`, then, with a contact, "HJViewer 관리자:
+/// <contact>" in two lines at most, whole in its tooltip, copied on a long press; never a link.
+class HjvCautionBox extends StatelessWidget {
+  final HjvCmTexts t;
+  final HjvCautionPlace place;
+  final String contact;
+
+  const HjvCautionBox(
+      {super.key, required this.t, required this.place, required this.contact});
+
+  @override
+  Widget build(BuildContext context) {
+    final text = hjvCautionText(t, place: place, contact: contact);
+    final line = hjvContactLine(t, contact);
+    return Semantics(
+      container: true,
+      label: line == null ? text : '$text\n$line',
+      excludeSemantics: true,
+      child: HjvCallout.rich(
+        tone: HjvTone.warning,
+        icon: Icons.report_gmailerrorred_rounded,
+        body: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(hjvKeepAll(text), style: const TextStyle(fontSize: 12)),
+            if (line != null)
+              Padding(
+                padding: const EdgeInsets.only(top: 4),
+                child: Tooltip(
+                  message: line,
+                  child: GestureDetector(
+                    onLongPress: () {
+                      Clipboard.setData(ClipboardData(text: contact.trim()));
+                      showToast(t.contactCopied);
+                    },
+                    child: Text(line,
+                        maxLines: 2,
+                        overflow: TextOverflow.ellipsis,
+                        style: TextStyle(
+                            fontSize: 12,
+                            fontWeight: FontWeight.w600,
+                            color: HjvPalette.of(context).text)),
+                  ),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
