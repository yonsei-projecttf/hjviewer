+        let now = Instant::now();
+        super::remember_reported_relay("offered-relay.example", now);
+        let uuid = "e4c181d0-41c7-4ae6-8ef0-36581b6b2b12";
+        for relay_server in [
+            "wss://offered-relay.example/ws/relay",
+            "ws://offered-relay.example/ws/relay",
+            "wss://other-host.example/ws/relay",
+        ] {
+            let request = super::RequestRelay {
+                relay_server: relay_server.to_owned(),
+                uuid: uuid.to_owned(),
+                ..Default::default()
+            };
+            assert!(
+                mediator.check_relay_request(&request, now).is_err(),
+                "accepted {relay_server:?}"
+            );
+        }
+    }
