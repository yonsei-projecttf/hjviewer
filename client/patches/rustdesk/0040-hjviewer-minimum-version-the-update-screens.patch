+import 'dart:convert';
+
+import 'package:flutter_hbb/common/hjv_update_model.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The minimum app version as the screens show it: plain Dart, which ci.sh runs with the bridge's
+// web stand-in. The states are written as the Rust core writes them (src/hjviewer_update/mod.rs
+// state_json, and on an installed Windows PC install.rs overlay).
+
+int unix(DateTime t) => t.millisecondsSinceEpoch ~/ 1000;
+
+/// The device's time in these tests: Korea's, whatever the machine that runs them has.
+DateTime kst(int s) =>
+    DateTime.fromMillisecondsSinceEpoch(s * 1000, isUtc: true)
+        .add(const Duration(hours: 9));
+
+/// 2026-11-23 00:00 in Korea, the deadline a policy sets by default.
+final grace = unix(DateTime.utc(2026, 11, 22, 15));
+final issued = unix(DateTime.utc(2026, 11, 2, 0));
+final checked = unix(DateTime.utc(2026, 11, 2, 5, 3));
+
+HjvUpdateInfo state(String state,
+        {String channel = 'windows',
+        Map<String, Object?> more = const {},
+        Map<String, Object?> job = const {}}) =>
+    HjvUpdateInfo.fromMap({
+      'state': state,
+      'channel': channel,
+      'current': '1.6.0',
+      'min': '1.6.1',
+      'latest': '1.6.2',
+      'grace_until': state == 'grace' ? grace : 0,
+      'os_min': '',
+      'os_too_old': false,
+      'notes': '',
+      'source': '',
+      'contact': '',
+      'move_to_play': false,
+      'package': {'file': 'HJViewer-1.6.2-windows-x86_64.exe', 'size': 200},
+      'installed': false,
+      'installer': '',
+      'credential': 'token',
+      'policy_epoch': 1,
+      'policy_seq': 12,
+      'policy_issued': issued,
+      'checked_at': checked,
+      'tried_at': checked,
+      'checking': false,
+      ...more,
+      'job': {
+        'phase': 'idle',
+        'error': '',
+        'done': 0,
+        'total': 0,
+        'file': '',
+        ...job
+      },
+    });
+
+const windowsPc = HjvDevice(platform: HjvPlatform.windows, takesIncoming: true);
+const android = HjvDevice(platform: HjvPlatform.android, sdk: 34);
+const oldAndroid = HjvDevice(platform: HjvPlatform.android, sdk: 23);
+const iphone =
+    HjvDevice(platform: HjvPlatform.ios, iosExport: 'app-store-connect');
+const adHocIphone =
+    HjvDevice(platform: HjvPlatform.ios, iosExport: 'release-testing');
+
+HjvPanelModel panel(HjvUpdateInfo i, HjvDevice d,
+        {HjvSteps steps = const HjvSteps()}) =>
+    hjvPanelModel(i, d, steps: steps, local: kst);
+
+void main() {
+  group('the state', () {
+    test('an empty or broken answer is a build that takes no part', () {
+      for (final s in ['', 'null', '[]', '{', 'x', '"required"', '7']) {
+        final i = HjvUpdateInfo.fromJson(s);
+        expect(i.state, HjvState.disabled, reason: s);
+        expect(i.enabled, isFalse, reason: s);
+        expect(i.required, isFalse, reason: s);
+        expect(i.behind, isFalse, reason: s);
+      }
+    });
+
+    test('a state this app does not know blocks nothing', () {
+      for (final s in ['later', 'disabled', '', 'REQUIRED']) {
