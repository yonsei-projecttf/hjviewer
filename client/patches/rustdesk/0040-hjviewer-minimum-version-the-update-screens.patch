+
+void _closePeerCard() {
+  final card = _peerCard;
+  _peerCard = null;
+  if (card != null && card.mounted) card.remove();
+}
+
+/// Puts a card over the session, at the top, without taking the screen below it away from the
+/// user: the address on it is typed into the remote PC while it shows. False when the window has
+/// no overlay yet.
+bool _showPeerCard(Widget Function(VoidCallback close) card) {
+  final overlay = hjvHost.overlay;
+  if (overlay == null) return false;
+  _closePeerCard();
+  late final OverlayEntry entry;
+  void close() {
+    if (identical(_peerCard, entry)) _peerCard = null;
+    if (entry.mounted) entry.remove();
+  }
