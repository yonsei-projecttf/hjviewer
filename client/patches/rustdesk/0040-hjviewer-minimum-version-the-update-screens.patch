+class HjvButton {
+  final String label;
+  final HjvAction action;
+  const HjvButton(this.label, this.action);
+
+  @override
+  bool operator ==(Object other) =>
+      other is HjvButton && other.label == label && other.action == action;
+
+  @override
+  int get hashCode => Object.hash(label, action);
+
+  @override
+  String toString() => '[$label → ${action.name}]';
+}
+
+/// What the update screen shows: the texts from top to bottom and the buttons, the first one
+/// being what the screen is there for. [다시 확인] is always there besides.
+class HjvPanelModel {
+  final String title;
+  final List<String> body;
+  final String versions;
+  final List<String> hints;
+  final String status;
+
+  /// Something is under way: a bar shows `progress`, or runs while that is unknown.
+  final bool busy;
+  final double? progress;
+  final List<HjvButton> buttons;
+
+  /// The policy is being asked for: [다시 확인] waits.
+  final bool checking;
+
+  /// Below the buttons, small: whom to ask, the policy's notes, where the source is.
+  final List<String> notes;
+
+  const HjvPanelModel({
+    required this.title,
+    required this.body,
+    required this.versions,
+    this.hints = const [],
+    this.status = '',
+    this.busy = false,
+    this.progress,
+    this.buttons = const [],
+    this.checking = false,
+    this.notes = const [],
+  });
+
+  HjvAction? get primary => buttons.isEmpty ? null : buttons.first.action;
+}
+
+/// The system `os_min` asks for, as a person names it: Android's API level becomes its version.
+String hjvOsNeed(HjvPlatform platform, String osMin) {
+  const android = {
+    21: '5.0',
+    22: '5.1',
+    23: '6.0',
+    24: '7.0',
+    25: '7.1',
+    26: '8.0',
+    27: '8.1',
+    28: '9',
+    29: '10',
+    30: '11',
+    31: '12',
+    32: '12L',
+    33: '13',
+    34: '14',
+    35: '15',
+    36: '16',
+  };
+  switch (platform) {
+    case HjvPlatform.android:
+      final name = android[int.tryParse(osMin)];
+      return name == null ? 'Android API $osMin' : 'Android $name';
+    case HjvPlatform.ios:
+      return 'iOS $osMin';
+    case HjvPlatform.windows:
+      return 'Windows $osMin';
+    case HjvPlatform.other:
+      return osMin;
+  }
+}
+
+/// The update screen of one platform, state and step (design 2-5, 5-1 to 5-5).
+HjvPanelModel hjvPanelModel(HjvUpdateInfo i, HjvDevice d,
+    {HjvSteps steps = const HjvSteps(), HjvLocalTime local = hjvLocalTime}) {
+  HjvPanelModel make(
+          {List<String> hints = const [],
+          String status = '',
+          bool busy = false,
+          double? progress,
+          List<HjvButton> buttons = const [],
+          bool askAdmin = false}) =>
+      HjvPanelModel(
+        title: i.required ? HjvUpdateText.title : HjvUpdateText.newerTitle,
+        body: [
+          if (i.required)
+            HjvUpdateText.body(i.min)
+          else if (i.state == HjvState.grace) ...[
+            if (i.graceUntil > 0)
+              HjvUpdateText.graceLine(hjvDeadline(local(i.graceUntil))),
+            HjvUpdateText.updateTo(i.min),
+          ] else
+            HjvUpdateText.newerBody(i.latest),
+        ],
+        versions: HjvUpdateText.versions(i),
+        hints: [
+          ...hints,
+          if (i.required && d.takesIncoming) HjvUpdateText.incomingStillWorks,
+        ],
+        status: status,
+        busy: busy,
+        progress: progress,
+        buttons: buttons,
+        checking: i.checking,
+        notes: [
+          if (askAdmin)
+            HjvUpdateText.askAdmin(i.contact)
+          else if (i.osTooOld && i.contact.isNotEmpty)
+            i.contact,
+          if (i.notes.isNotEmpty) i.notes,
+          if (i.source.isNotEmpty) HjvUpdateText.source(i.source),
+        ],
+      );
+
+  const logIn = HjvButton(HjvUpdateText.logIn, HjvAction.logIn);
+  HjvPanelModel needsLogin(List<HjvButton> more) => make(
+      hints: [HjvUpdateText.needsLogin],
+      buttons: [logIn, ...more],
+      askAdmin: true);
+
+  /// A download or an install that failed: its reason and, unless asking again cannot help,
+  /// [다시 시도] with what started it.
+  HjvPanelModel failed(String code, HjvAction again, List<String> hints) {
+    final retry = HjvButton(HjvUpdateText.retry, again);
+    if (code == 'login') {
+      return needsLogin([if (i.credential == 'token') retry]);
+    }
+    final refused = code == 'refused';
+    return make(
+        hints: hints,
+        status: HjvUpdateText.failure(code),
+        buttons: [if (!refused) retry],
+        askAdmin: refused);
+  }
+
+  if (!i.behind) {
+    return HjvPanelModel(
+        title: HjvUpdateText.upToDate,
+        body: const [],
+        versions: HjvUpdateText.versions(i),
+        checking: i.checking);
+  }
+  if (i.osTooOld) {
+    return make(
+        hints: [HjvUpdateText.osTooOld(hjvOsNeed(d.platform, i.osMin))]);
+  }
+  switch (d.platform) {
+    case HjvPlatform.ios:
+      return d.testFlight
+          ? make(hints: [
+              HjvUpdateText.iosHint
+            ], buttons: const [
+              HjvButton(HjvUpdateText.iosButton, HjvAction.openTestFlight)
+            ])
+          : make(hints: [HjvUpdateText.iosNotTestFlight], askAdmin: true);
+    case HjvPlatform.android:
+      if (i.fromPlay) {
+        return make(hints: [
+          HjvUpdateText.playHint
+        ], buttons: const [
+          HjvButton(HjvUpdateText.playButton, HjvAction.openPlay)
+        ]);
+      }
+      if (!i.hasPackage) return make(hints: [HjvUpdateText.preparing]);
+      if (i.credential == 'none') return needsLogin(const []);
+      if (d.browserInstall) {
+        const hints = [HjvUpdateText.androidBrowserHint];
+        if (steps.linking) {
+          return make(
+              hints: hints, status: HjvUpdateText.linkAsking, busy: true);
+        }
+        return steps.linkError.isEmpty
+            ? make(hints: hints, buttons: const [
+                HjvButton(HjvUpdateText.androidButton, HjvAction.browser)
+              ])
+            : failed(steps.linkError, HjvAction.browser, hints);
+      }
+      const hints = [HjvUpdateText.androidHint];
+      const download =
+          HjvButton(HjvUpdateText.androidButton, HjvAction.download);
+      switch (i.phase) {
+        case HjvPhase.downloading:
+          return make(
+              hints: hints,
+              status: HjvUpdateText.downloading(i.progress),
+              busy: true,
+              progress: i.progress);
+        case HjvPhase.ready:
+          const open =
+              HjvButton(HjvUpdateText.openInstaller, HjvAction.install);
+          switch (steps.install) {
+            case HjvInstall.permission:
+              return make(
+                  hints: hints,
+                  status: HjvUpdateText.allowSource,
+                  buttons: const [
+                    HjvButton(
+                        HjvUpdateText.openSettings, HjvAction.installSettings),
+                    open
+                  ]);
+            case HjvInstall.mismatch:
+              return make(
+                  hints: hints,
+                  status: HjvUpdateText.errNotThisApp,
+                  buttons: const [
+                    HjvButton(HjvUpdateText.retry, HjvAction.download)
+                  ]);
+            case HjvInstall.failed:
+              return make(
+                  hints: hints,
+                  status: HjvUpdateText.installerFailed,
+                  buttons: const [
+                    HjvButton(HjvUpdateText.retry, HjvAction.install)
+                  ],
+                  askAdmin: true);
+            case HjvInstall.none:
+            case HjvInstall.opened:
+              return make(
+                  hints: hints,
+                  status: HjvUpdateText.androidInstaller,
+                  buttons: const [open]);
+          }
+        case HjvPhase.error:
+          return failed(i.error, HjvAction.download, hints);
+        default:
+          return make(hints: hints, buttons: const [download]);
+      }
+    case HjvPlatform.windows:
+      if (!i.hasPackage) return make(hints: [HjvUpdateText.preparing]);
+      if (i.installed) {
+        if (i.credential == 'unbound') {
+          return make(
+              hints: [HjvUpdateText.winUnbound],
+              buttons: const [logIn],
+              askAdmin: true);
+        }
+        final hints = [
+          if (i.required || i.autoInstall) HjvUpdateText.winInstalls,
+          HjvUpdateText.winNow,
+        ];
+        const now = HjvButton(HjvUpdateText.updateNow, HjvAction.updateNow);
+        switch (i.phase) {
+          case HjvPhase.waiting:
+            return make(
+                hints: hints, status: HjvUpdateText.waiting, busy: true);
+          case HjvPhase.downloading:
+            return make(
+                hints: hints,
+                status: HjvUpdateText.downloading(null),
+                busy: true);
+          case HjvPhase.verifying:
+            return make(
+                hints: hints, status: HjvUpdateText.verifying, busy: true);
+          case HjvPhase.installing:
+            return make(
+                hints: hints, status: HjvUpdateText.installing, busy: true);
+          case HjvPhase.notice:
+            return make(
+                hints: hints,
+                status: HjvUpdateText.closesAt(hjvClockTime(local(i.until))),
+                buttons: const [now]);
+          case HjvPhase.error:
+            return failed(i.error, HjvAction.updateNow, hints);
+          default:
+            return make(hints: hints, buttons: const [now]);
+        }
+      }
+      if (i.credential == 'none') return needsLogin(const []);
+      final hints = [HjvUpdateText.winPortable(i.latest)];
+      switch (i.phase) {
+        case HjvPhase.downloading:
+          return make(
+              hints: hints,
+              status: HjvUpdateText.downloading(i.progress),
+              busy: true,
+              progress: i.progress);
+        case HjvPhase.ready:
+          return make(
+              hints: hints,
+              status: HjvUpdateText.opensNow,
+              buttons: const [HjvButton(HjvUpdateText.runNow, HjvAction.run)]);
+        case HjvPhase.error:
+          return failed(i.error, HjvAction.download, hints);
+        default:
+          return make(hints: hints, buttons: const [
+            HjvButton(HjvUpdateText.update, HjvAction.download)
+          ]);
+      }
+    case HjvPlatform.other:
+      return make(askAdmin: true);
+  }
+}
+
+/// The line above the connection page while a newer version is out but nothing is blocked yet:
+/// the version, the deadline in the device's own time when there is one, and on an installed
+/// Windows PC that the service installs it.
+String hjvBannerText(HjvUpdateInfo i, {HjvLocalTime local = hjvLocalTime}) => [
+      HjvUpdateText.newer(i.latest),
+      if (i.state == HjvState.grace && i.graceUntil > 0)
+        HjvUpdateText.graceLine(hjvDeadline(local(i.graceUntil))),
+      if (i.installed && i.autoInstall) HjvUpdateText.installsItself,
+    ].join(' ');
+
+/// Settings → About: the versions, the policy they come from and when it was last checked.
+List<String> hjvAboutLines(HjvUpdateInfo i,
+        {HjvLocalTime local = hjvLocalTime}) =>
+    [
+      HjvUpdateText.versions(i),
+      i.policySeq > 0
+          ? HjvUpdateText.policy(
+              i.policyEpoch, i.policySeq, hjvStamp(local(i.policyIssued)))
+          : HjvUpdateText.noPolicy,
+      i.checkedAt > 0
+          ? HjvUpdateText.checked(hjvStamp(local(i.checkedAt)))
+          : HjvUpdateText.neverChecked,
+      if (i.source.isNotEmpty) HjvUpdateText.source(i.source),
+    ];
+
+/// What a check by hand found, in one line.
+String hjvCheckResult(HjvUpdateInfo i, int now) {
+  if (now - i.checkedAt > 60 || i.checkedAt - now > 60) {
+    return HjvUpdateText.checkFailed;
+  }
+  return switch (i.state) {
+    HjvState.required => HjvUpdateText.title,
+    HjvState.grace || HjvState.available => HjvUpdateText.newer(i.latest),
+    HjvState.ok => HjvUpdateText.upToDate,
+    _ => HjvUpdateText.noEntry,
+  };
+}
+
+/// Whether the policy was last asked for longer ago than `age`: never, or by a clock that has
+/// been set back since. An attempt that failed counts, so that a server that is down does not
+/// hold up every connection.
+bool hjvCheckDue(HjvUpdateInfo i, int now, Duration age) {
+  final last = max(i.checkedAt, i.triedAt);
+  return last <= 0 || (now - last).abs() > age.inSeconds;
+}
+
+/// The verdict a connection that is about to start goes by (design 3-1): the one the core
+/// holds; when the policy was last asked for over half an hour ago, the core is asked first and
+/// the connection waits for the answer, two seconds at most, then takes what the core holds.
+Future<HjvUpdateInfo> hjvStateForConnect({
+  required HjvUpdateInfo Function() read,
+  required Future<void> Function() checkNow,
+  required int Function() now,
+  required Future<void> Function(Duration) pause,
+}) async {
+  var info = read();
+  if (!info.enabled || !hjvCheckDue(info, now(), kHjvConnectAge)) return info;
+  try {
+    await checkNow();
+  } catch (_) {
+    return info;
+  }
+  for (var waited = Duration.zero;
+      waited < kHjvConnectWait;
+      waited += kHjvPoll) {
+    await pause(kHjvPoll);
+    info = read();
+    if (!info.checking) break;
+  }
+  return info;
+}
+
+final _version = RegExp(r'^[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}(-[0-9]{1,4})?$');
+
+/// A version as hbb_common::get_version_number counts it ("1.5.1" is 1005010), which is how the
+/// core and the PCs compare versions.
+int hjvVersionNumber(String v) {
+  final parts = v.split('-');
+  var n = 0;
+  var last = 0;
+  for (final x in parts.first.split('.')) {
+    last = int.tryParse(x) ?? 0;
+    n = n * 1000 + last;
+  }
+  n = n - last + last * 10;
+  if (parts.length > 1) n += int.tryParse(parts[1]) ?? 0;
+  return n;
+}
+
+/// What a controller is told about the PC it has just connected to.
+class HjvPeerNotice {
+  final String text;
+
+  /// The PC has no update screen of its own (below 1.6.0): the controller can make a link to
+  /// the new version for the PC's browser.
+  final bool offersLink;
+
+  /// The PC's app is installed there, so the link's file is the one that opens the installer.
+  final bool installed;
+
+  const HjvPeerNotice(
+      {required this.text, required this.offersLink, required this.installed});
+}
+
+/// Whether PeerInfo.platform_additions says the PC's app is installed there.
+bool hjvPeerInstalled(Object? additions) {
+  try {
+    final m = additions is String && additions.isNotEmpty
+        ? jsonDecode(additions)
+        : additions;
+    return m is Map && m['is_installed'] == true;
+  } catch (_) {
+    return false;
+  }
+}
+
+/// The notice for a Windows PC whose app is below the minimum of its platform (design 2-3): the
+/// connection goes on, the controller hears how the PC gets updated. Null for a PC that is up to
+/// date, for a version that is not one, and for every other platform: Android devices that are
+/// controlled stay on the last version that can be, and only Windows PCs get a package.
+HjvPeerNotice? hjvPeerNotice({
+  required String version,
+  required String platform,
+  required String min,
+  Object? additions,
+}) {
+  if (platform != 'Windows') return null;
+  if (!_version.hasMatch(version) || !_version.hasMatch(min)) return null;
+  final peer = hjvVersionNumber(version);
+  if (peer >= hjvVersionNumber(min)) return null;
+  final offersLink = peer < hjvVersionNumber(kHjvFirstUpdaterVersion);
+  final installed = hjvPeerInstalled(additions);
+  return HjvPeerNotice(
+      text: offersLink
+          ? HjvUpdateText.peerNeedsLink(version, min)
+          : installed
+              ? HjvUpdateText.peerUpdatesItself(version, min)
+              : HjvUpdateText.peerRunsNew(version, min),
+      offersLink: offersLink,
+      installed: installed);
+}
+
+/// A short link for the browser of a remote device: good for `expiresIn` seconds, `file` is the
+/// name the browser saves.
+class HjvLink {
+  final String url;
+  final String file;
+  final int expiresIn;
+  const HjvLink(this.url, this.file, this.expiresIn);
+
+  static const _codeLength = 9;
+
+  /// What a person types into the PC's browser, shown without "https://", which browsers add by
+  /// themselves (design 2-5 U1): "<server>/api/hjv/u/", then "K7M2-Q9XD" shown larger.
+  String get typed =>
+      url.substring('https://'.length, url.length - _codeLength);
+  String get code => url.substring(url.length - _codeLength);
+  int get minutes => max(1, expiresIn ~/ 60);
+}
+
+/// The answer to a link request: the link, or the code of why there is none.
+class HjvLinkAnswer {
+  final HjvLink? link;
+  final String error;
+  const HjvLinkAnswer.ok(HjvLink this.link) : error = '';
+  const HjvLinkAnswer.failed(this.error) : link = null;
+}
+
+final _shortLink = RegExp(
+    r'^https://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?/api/hjv/u/[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$');
+final _linkFile = RegExp(r'^[A-Za-z0-9._-]{1,100}$');
+
+/// The `link` or `link_error` of an "hjv-update" event; null for an event that answers no link
+/// request. The core has made the link from its own server name; all the same, only an https
+/// address of exactly a short link's form is shown or opened.
+HjvLinkAnswer? hjvLinkAnswer(Map evt) {
+  final link = evt['link'];
+  if (link is Map) {
+    final url = link['url'], file = link['file'], expires = link['expires_in'];
+    if (url is String &&
+        file is String &&
+        expires is int &&
+        _shortLink.hasMatch(url) &&
+        _linkFile.hasMatch(file) &&
+        expires >= 1 &&
+        expires <= 3600) {
+      return HjvLinkAnswer.ok(HjvLink(url, file, expires));
+    }
+    return const HjvLinkAnswer.failed('http');
+  }
+  final error = evt['link_error'];
+  if (error is String) return HjvLinkAnswer.failed(error);
+  return evt.containsKey('link') || evt.containsKey('link_error')
+      ? const HjvLinkAnswer.failed('http')
+      : null;
+}
+
+/// The same answer as the text that goes from the main window to the window that asked, and
+/// back from it.
+String? hjvLinkMessage(Map evt) =>
+    evt.containsKey('link') || evt.containsKey('link_error')
+        ? jsonEncode({
+            if (evt['link'] != null) 'link': evt['link'],
+            if (evt['link_error'] != null) 'link_error': evt['link_error'],
+          })
+        : null;
+
+HjvLinkAnswer hjvLinkFromMessage(Object? message) {
+  try {
+    final evt = message is String ? jsonDecode(message) : null;
+    final answer = evt is Map && evt.isNotEmpty ? hjvLinkAnswer(evt) : null;
+    return answer ?? const HjvLinkAnswer.failed('http');
+  } catch (_) {
+    return const HjvLinkAnswer.failed('http');
+  }
+}
+
+/// The value of "hjv-update-link".
+String hjvLinkRequest(String platform, bool installed) =>
+    jsonEncode({'platform': platform, 'installed': installed});
+
+/// The App Store page of TestFlight, for an iPhone on which TestFlight itself does not open.
+const kHjvTestFlightAppStore =
+    'https://apps.apple.com/app/testflight/id899247664';
+
+/// Tried in order on an iPhone. itms-beta:// is what TestFlight's invitations use; Apple does
+/// not document it, so it is never the only way.
+const hjvTestFlightLinks = ['itms-beta://', kHjvTestFlightAppStore];
+
+/// Tried in order on an Android app that came from Google Play: the Play Store app, then its
+/// web page.
+List<String> hjvPlayLinks(String package) => [
+      'market://details?id=$package',
+      'https://play.google.com/store/apps/details?id=$package',
+    ];
+
+/// Opens the first of `links` that `launch` takes; false when none opens.
+Future<bool> hjvOpenFirst(
+    List<String> links, Future<bool> Function(Uri) launch) async {
+  for (final link in links) {
+    final uri = Uri.tryParse(link);
+    if (uri == null) continue;
+    try {
+      if (await launch(uri)) return true;
+    } catch (_) {}
+  }
+  return false;
+}
+
+/// The value of "hjv-update-device": what only the screen knows of the device. `installer` is
+/// the store an Android app was installed by ("" for a file: null would leave the core without
+/// an entry to judge by), `os` the system that `os_min` is held against: Android's API level,
+/// the iOS version, the Windows version. Empty when there is nothing to tell.
+String hjvDeviceValue({String? installer, String? os}) {
+  final value = {
+    if (installer != null) 'installer': installer,
+    if (os != null && os.isNotEmpty) 'os': os,
+  };
+  return value.isEmpty ? '' : jsonEncode(value);
+}
