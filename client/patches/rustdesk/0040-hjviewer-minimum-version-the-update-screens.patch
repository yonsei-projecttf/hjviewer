+  if (main) hjvHost.showMain();
+  _show<void>(
+      (setState, close, context) =>
+          hjvBlockedDialog(info, onClose: close, onUpdate: () {
+            close();
+            // a session window has no update screen: the main window does
+            main ? hjvShowUpdate() : hjvHost.showMain();
+          }),
+      tag: _kBlockedTag);
+}
+
+void _closeBanner(HjvUpdateInfo info) {
+  if (info.state == HjvState.grace) {
+    _graceClosed.value = true;
+  } else {
+    _bannerClosed.value = info.latest;
+    hjvHost.setOption(_kBannerClosed, info.latest);
+  }
+}
+
+void _closeMove() {
+  _moveClosed.value = true;
+  hjvHost.setOption(_kMoveClosed, 'Y');
+}
+
+void _showMoveToPlay() {
+  final contact = hjvUpdate.value.contact;
+  _show<void>((setState, close, context) => CustomAlertDialog(
+        title: const Text(HjvUpdateText.moveTitle),
+        content: Text([
+          HjvUpdateText.moveSteps,
+          if (contact.isNotEmpty) contact,
+        ].join('\n\n')),
+        actions: [_button(HjvUpdateText.close, close)],
+        onCancel: close,
+      ));
+}
+
+/// What a button of the update screen does.
+Future<void> hjvRunAction(HjvAction action) async {
+  try {
+    switch (action) {
+      case HjvAction.recheck:
+        await hjvCheckByHand(opens: false);
+      case HjvAction.logIn:
+        hjvHost.logIn();
+      case HjvAction.openTestFlight:
+        if (!await hjvOpenFirst(hjvTestFlightLinks, hjvHost.launch)) {
+          hjvHost.toast(HjvUpdateText.iosFailed);
+        }
+      case HjvAction.openPlay:
+        final links = hjvPlayLinks(await hjvHost.packageName());
+        if (!await hjvOpenFirst(links, hjvHost.launch)) {
+          hjvHost.toast(HjvUpdateText.playFailed);
+        }
+      case HjvAction.download:
+        hjvSteps.value = const HjvSteps();
+        _installWhenReady = false;
+        await hjvHost.set(
+            'hjv-update-download', await hjvHost.downloadFolder());
+        // from here on the core's job is this download
+        _installWhenReady = hjvHost.device.platform == HjvPlatform.android;
+      case HjvAction.browser:
+        await _openInBrowser();
+      case HjvAction.install:
+        await _install(hjvUpdate.value.file);
+      case HjvAction.installSettings:
+        hjvHost.openInstallSettings();
+      case HjvAction.updateNow:
+        _confirmUpdateNow();
+      case HjvAction.run:
+        await hjvHost.set('hjv-update-run', '');
+    }
+  } catch (e) {
+    debugPrint('hjv update: ${action.name}: $e');
+  }
+  _refresh();
+}
+
+/// W5: installing closes the app and ends every session, so it asks first.
+void _confirmUpdateNow() {
+  _show<void>(
+      (setState, close, context) => CustomAlertDialog(
+            title: const Text(HjvUpdateText.updateNow),
+            content: const Text(HjvUpdateText.closesNow),
+            actions: [
+              _button(HjvUpdateText.close, close, outline: true),
+              _button(HjvUpdateText.updateNow, () {
+                close();
+                hjvHost
+                    .set('hjv-update-now', '')
+                    .catchError((Object e) => debugPrint('hjv update: $e'))
+                    .whenComplete(_refresh);
+              }),
+            ],
+            onCancel: close,
+          ),
+      tag: 'hjv-update-now');
+}
+
+/// Android: the checked APK goes to the system installer, which MainActivity starts after it
+/// has compared the file's package and certificate with this app's.
+Future<void> _install(String path) async {
+  if (path.isEmpty) return;
+  Object? answer;
+  try {
+    answer = await hjvHost.installApk(path);
+  } catch (e) {
+    debugPrint('hjv update: install: $e');
+  }
+  hjvSteps.value = HjvSteps(install: hjvInstallResult(answer));
+}
+
+/// Android below 7.0: the browser downloads the APK from a short link.
+Future<void> _openInBrowser() async {
+  if (hjvSteps.value.linking) return;
+  hjvSteps.value = const HjvSteps(linking: true);
+  final answer = await hjvAskLink('android', false);
+  hjvSteps.value = HjvSteps(linkError: answer.error);
+  final link = answer.link;
+  if (link != null && !await hjvOpenFirst([link.url], hjvHost.launch)) {
+    hjvHost.toast(HjvUpdateText.browserFailed);
+  }
+}
+
+/// Asks the core for a short link to the platform's package and waits for the answer. Any
+/// window may ask: the core answers the main window, whose hjvOnUpdateEvent passes the answer
+/// to the port registered here.
+Future<HjvLinkAnswer> hjvAskLink(String platform, bool installed) async {
+  final port = ReceivePort();
+  IsolateNameServer.removePortNameMapping(_kLinkPort);
+  if (!IsolateNameServer.registerPortWithName(port.sendPort, _kLinkPort)) {
+    port.close();
+    return const HjvLinkAnswer.failed('http');
+  }
+  try {
+    await hjvHost.set('hjv-update-link', hjvLinkRequest(platform, installed));
+    return hjvLinkFromMessage(await port.first.timeout(_kLinkWait));
+  } on TimeoutException {
+    return const HjvLinkAnswer.failed('network');
+  } catch (e) {
+    debugPrint('hjv update: link: $e');
+    return const HjvLinkAnswer.failed('http');
+  } finally {
+    if (IsolateNameServer.lookupPortByName(_kLinkPort) == port.sendPort) {
+      IsolateNameServer.removePortNameMapping(_kLinkPort);
+    }
+    port.close();
+  }
+}
+
+// ---- widgets ----
+
+/// The update screen's texts and buttons, top to bottom.
+class HjvUpdateBody extends StatelessWidget {
+  final HjvPanelModel model;
+  final void Function(HjvAction) onAction;
+  const HjvUpdateBody({Key? key, required this.model, required this.onAction})
