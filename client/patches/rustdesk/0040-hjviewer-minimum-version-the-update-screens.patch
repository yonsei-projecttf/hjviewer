+// HJViewer: the minimum app version as the screens show it. The Rust core (src/hjviewer_update)
+// fetches the signed version policy, judges this app by it and reports the JSON read here
+// (main_get_common "hjv-update-state", event "hjv-update"); this file turns that into what each
+// platform shows and offers. Plain Dart without the bridge, so that ci.sh tests it with the web
+// stand-in; hjv_update.dart holds the widgets and the calls. The texts are Korean only, as the
+// refusals of hbbs and of the PCs are, and never pass through translate().
+
+import 'dart:convert';
+import 'dart:math';
+
+/// The core's verdict on this app. `disabled` is a build that takes no part (an empty answer):
+/// its screens stay as they were in 1.5.1.
+enum HjvState { disabled, unknown, ok, available, grace, required }
+
+/// How far the update got: a download by this app (downloading, ready), the service of an
+/// installed Windows PC (waiting, downloading, verifying, notice, installing), or error.
+enum HjvPhase {
+  idle,
+  waiting,
+  downloading,
+  verifying,
+  notice,
+  ready,
+  installing,
+  error
+}
+
+enum HjvPlatform { windows, android, ios, other }
+
+/// How a TestFlight build is exported (client-build.yml IOS_EXPORT_METHOD, passed to the app as
+/// HJV_IOS_EXPORT); any other iOS build cannot be updated through TestFlight.
+const kHjvTestFlightExport = 'app-store-connect';
+
+/// The first Android that takes an APK from the app's own files (a content URI); older ones get
+/// the browser and a short link.
+const kHjvInAppInstallSdk = 24;
+
+/// The first version with an update screen of its own: an older PC needs a link to the new one.
+const kHjvFirstUpdaterVersion = '1.6.0';
+
+/// Before a connection the policy is asked for again when the last time is older than this, ...
+const kHjvConnectAge = Duration(minutes: 30);
+
+/// ... and the connection waits this long for the answer at most, looking this often.
+const kHjvConnectWait = Duration(seconds: 2);
+const kHjvPoll = Duration(milliseconds: 100);
+
+/// Coming back to the front asks again when the last time is older than this.
+const kHjvFrontAge = Duration(hours: 1);
+
+const kHjvSourceRepo = 'github.com/yonsei-projecttf/hjviewer';
+
+/// Turns a Unix time into the time shown: the device's own, since the deadlines are meant for
+/// the person in front of it.
+typedef HjvLocalTime = DateTime Function(int unix);
+
+DateTime hjvLocalTime(int unix) =>
+    DateTime.fromMillisecondsSinceEpoch(unix * 1000);
+
+String _two(int n) => n.toString().padLeft(2, '0');
