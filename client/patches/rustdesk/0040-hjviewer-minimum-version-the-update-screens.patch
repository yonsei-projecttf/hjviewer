diff --git a/flutter/lib/common/hjv_update.dart b/flutter/lib/common/hjv_update.dart
new file mode 100644
index 0000000..54a2f55
--- /dev/null
+++ b/flutter/lib/common/hjv_update.dart
@@ -0,0 +1,1047 @@
+// HJViewer: the screens of the minimum app version. An app below its platform's minimum stops
+// connecting out and shows how to update; hjv_update_model.dart holds the texts and what each
+// platform offers, this file the hooks into the app (D1-D9 below), the widgets and the calls
+// into the Rust core (src/hjviewer_update), which go through main_get_common and
+// main_set_common, so the generated bridge stays as it is:
+//   get "hjv-update-state"              the verdict as JSON; "" in a build that takes no part
+//   get "hjv-min-version-<platform>"    the minimum a peer of that platform is held to
+//   set "hjv-update-device"             what only the screen knows of the device (first of all)
+//   set "hjv-update-check"              "" for a check nobody waits for, "now" for one somebody does
+//   set "hjv-update-download" | "hjv-update-now" | "hjv-update-run" | "hjv-update-link"
+//   event "hjv-update"                  the state again, with a link request's answer
+// A build without the update keys answers "" and every hook leaves its screen as 1.5.1 has it.
+// Only outgoing connections are held back: the PC's ID and password, the settings, the
+// connection manager, the install page and sessions that run stay as they are.
+
+import 'dart:async';
+import 'dart:io';
+import 'dart:isolate';
+import 'dart:ui' show IsolateNameServer;
+
+import 'package:device_info_plus/device_info_plus.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/formatter/id_formatter.dart';
+import 'package:flutter_hbb/common/hjv_update_model.dart';
+import 'package:flutter_hbb/common/widgets/login.dart';
+import 'package:flutter_hbb/consts.dart';
+import 'package:flutter_hbb/models/model.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:flutter_hbb/utils/multi_window_manager.dart';
+import 'package:get/get.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:settings_ui/settings_ui.dart';
+import 'package:url_launcher/url_launcher.dart';
+import 'package:window_manager/window_manager.dart';
+
+const _kEvent = 'hjv-update';
+const _kState = 'hjv-update-state';
+const _kCheck = 'hjv-update-check';
+
+/// The name under which the window that asked for a short link waits for it. The core answers
+/// the main window only, and the windows of a desktop app are isolates of one process.
+const _kLinkPort = 'hjv-update-link';
+
+/// A link request is answered within the core's 20 seconds.
+const _kLinkWait = Duration(seconds: 30);
+
+/// A check by hand waits for the request's end, which the core gives 20 seconds.
+const _kCheckWait = Duration(seconds: 25);
+
+/// How long the notice about a PC stays when nobody touches it.
+const _kPeerNoticeFor = Duration(seconds: 60);
+
+/// The `latest` whose banner was closed, and "Y" once the note about Google Play was.
+const _kBannerClosed = 'hjv-update-banner-closed';
+const _kMoveClosed = 'hjv-update-move-closed';
+
+const _kBlockedTag = 'hjv-update-blocked';
+const _kPanelTag = 'hjv-update-panel';
+
+/// What these screens ask of the core and of the app around them, in one place. The tests put a
+/// stand-in of the core here.
+class HjvHost {
+  /// main_get_common, read at once: every window gets the core's own answer.
+  String get(String key) => bind.mainGetCommonSync(key: key);
+
+  Future<void> set(String key, String value) =>
+      bind.mainSetCommon(key: key, value: value);
+
+  HjvDevice get device => HjvDevice(
+        platform: isWindows
+            ? HjvPlatform.windows
+            : isAndroid
+                ? HjvPlatform.android
+                : isIOS
+                    ? HjvPlatform.ios
+                    : HjvPlatform.other,
+        sdk: isAndroid ? androidVersion : 0,
+        iosExport: const String.fromEnvironment('HJV_IOS_EXPORT'),
+        takesIncoming: isDesktop && !bind.isOutgoingOnly(),
+      );
+
+  /// The main window of a desktop app, or the phone app: where the update screen is.
+  bool get isMain => !isDesktop || desktopType == DesktopType.main;
+
+  int now() => DateTime.now().millisecondsSinceEpoch ~/ 1000;
+
+  Future<void> pause(Duration time) => Future.delayed(time);
+
+  OverlayDialogManager get dialogs => gFFI.dialogManager;
+
+  OverlayState? get overlay => globalKey.currentState?.overlay;
+
+  void toast(String text) =>
+      showToast(text, timeout: const Duration(seconds: 5));
+
+  void logIn() => loginDialog();
+
+  /// Calls `then` with the login's name whenever it changes.
+  void listenLogin(void Function(String name) then) =>
+      gFFI.userModel.userName.listen(then);
+
+  /// Whether the app is in front: Android 10 and later start no activity, the installer
+  /// included, for an app in the background. Unknown counts as in front.
+  bool get inFront {
+    final state = WidgetsBinding.instance.lifecycleState;
+    return state == null || state == AppLifecycleState.resumed;
+  }
+
+  /// Outside the app: an https link opened inside it would not reach TestFlight, the Play Store
+  /// or the browser's downloads. Not canLaunchUrl first: iOS answers that for itms-beta only
+  /// when Info.plist lists the scheme, and opening needs no such entry.
+  Future<bool> launch(Uri uri) =>
+      launchUrl(uri, mode: LaunchMode.externalApplication);
+
+  Future<void> copy(String text) =>
+      Clipboard.setData(ClipboardData(text: text));
+
+  /// Raises the main window, where a link or a command line may have started with it hidden.
+  void showMain() {
+    if (!isDesktop) return;
+    if (isMain) {
+      windowOnTop(null);
+    } else {
+      rustDeskWinManager.call(WindowType.Main, kWindowMainWindowOnTop, '');
+    }
+  }
+
+  /// The value of "hjv-update-device".
+  Future<String> deviceValue() async {
+    String? installer, os;
+    try {
+      if (isAndroid) {
+        os = androidVersion > 0 ? '$androidVersion' : null;
+        installer = (await PackageInfo.fromPlatform()).installerStore ?? '';
+      } else if (isIOS) {
+        os = (await DeviceInfoPlugin().iosInfo).systemVersion;
+      } else if (isWindows) {
+        final info = await DeviceInfoPlugin().windowsInfo;
+        os = '${info.majorVersion}.${info.minorVersion}.${info.buildNumber}';
+      }
+    } catch (e) {
+      debugPrint('hjv update: device: $e');
+    }
+    return hjvDeviceValue(installer: installer, os: os);
+  }
+
+  Future<String> packageName() async =>
+      (await PackageInfo.fromPlatform()).packageName;
+
+  /// Where the core puts a download: the app's cache on Android, which the installer reads
+  /// through the app's FileProvider. Windows has its own places and reads no value.
+  Future<String> downloadFolder() async =>
+      isAndroid ? '${(await getTemporaryDirectory()).path}/updates' : '';
+
+  /// Android: what earlier downloads left in the app's cache. The job that made them ended
+  /// with the run of the app that asked for them.
+  Future<void> clearDownloads() async {
+    if (!isAndroid) return;
+    try {
+      final folder = Directory(await downloadFolder());
+      if (await folder.exists()) await folder.delete(recursive: true);
+    } catch (e) {
+      debugPrint('hjv update: cache: $e');
+    }
+  }
+
+  /// MainActivity "hjv_install_apk" (see hjvInstallResult).
+  Future<Object?> installApk(String path) async =>
+      await platformFFI.invokeMethod('hjv_install_apk', path);
+
+  void openInstallSettings() => AndroidPermissionManager.startAction(
+      'android.settings.MANAGE_UNKNOWN_APP_SOURCES');
+
+  String option(String key) => bind.getLocalFlutterOption(k: key);
+
+  void setOption(String key, String value) =>
+      bind.setLocalFlutterOption(k: key, v: value);
+}
+
+HjvHost hjvHost = HjvHost();
+
+/// The verdict as the main window or the phone app last heard it. The other windows of a
+/// desktop app have their own Dart state and read the core when they need it (hjvReadState).
+final hjvUpdate = HjvUpdateInfo.none.obs;
+
+/// The steps of an update that this screen runs itself.
+final hjvSteps = const HjvSteps().obs;
+
+/// The banner's `latest` that was closed, for good; a banner with a deadline only for this run.
+final _bannerClosed = ''.obs;
+final _graceClosed = false.obs;
+final _moveClosed = false.obs;
+
+bool? _takesPart;
+var _installWhenReady = false;
+var _checkingByHand = false;
+final _connecting = <String>{};
+final _peersTold = <String>{};
+OverlayEntry? _peerCard;
+
+/// Whether this build takes part: a build pinned to a server, with its update keys. False
+/// while the core cannot be asked yet.
+bool hjvEnabled() {
+  final known = _takesPart;
+  if (known != null) return known;
+  try {
+    return _takesPart = hjvHost.get(_kState).isNotEmpty;
+  } catch (_) {
+    return false;
+  }
+}
+
+/// For a test: another host, and nothing remembered of the one before.
+void hjvUseHost(HjvHost host) {
+  hjvHost = host;
+  _takesPart = null;
+  _installWhenReady = false;
+  _checkingByHand = false;
+  _connecting.clear();
+  _peersTold.clear();
+  _closePeerCard();
+  hjvUpdate.value = HjvUpdateInfo.none;
+  hjvSteps.value = const HjvSteps();
+  _bannerClosed.value = '';
+  _graceClosed.value = false;
+  _moveClosed.value = false;
+}
+
+/// The core's verdict, read at once.
+HjvUpdateInfo hjvReadState() {
+  try {
+    return HjvUpdateInfo.fromJson(hjvHost.get(_kState));
+  } catch (_) {
+    return HjvUpdateInfo.none;
+  }
+}
+
+/// Takes a state of the core. Android: the download this screen asked for goes on to the
+/// system installer as soon as its file is there and the app is in front; one that ends in the
+/// background waits for hjvCameToFront.
+void _took(HjvUpdateInfo info) {
+  hjvUpdate.value = info;
+  if (_installWhenReady &&
+      info.phase != HjvPhase.downloading &&
+      hjvHost.inFront) {
+    _installWhenReady = false;
+    if (info.phase == HjvPhase.ready) unawaited(_install(info.file));
+  }
+}
+
+void _refresh() => _took(hjvReadState());
+
+void _ask(String key, String value) {
+  hjvHost
+      .set(key, value)
+      .catchError((Object e) => debugPrint('hjv update: $key: $e'));
+}
+
+/// Shows a dialog, in place of an earlier one of the same tag; a dialog that cannot be shown
+/// yet (no overlay) is left out.
+Future<T?> _show<T>(DialogBuilder builder, {String? tag}) async {
+  try {
+    final dialogs = hjvHost.dialogs;
+    if (tag != null) dialogs.dismissByTag(tag);
+    return await dialogs.show<T>(builder, tag: tag);
+  } catch (e) {
+    debugPrint('hjv update: $e');
+    return null;
+  }
+}
+
+/// A button as dialogButton() draws it, for a text of these screens, which translate() must not
+/// see.
+Widget _button(String label, VoidCallback? onPressed, {bool outline = false}) {
+  if (isDesktop || isWebDesktop) {
+    return outline
+        ? OutlinedButton(onPressed: onPressed, child: Text(label))
+        : ElevatedButton(
+            style: ElevatedButton.styleFrom(elevation: 0),
+            onPressed: onPressed,
+            child: Text(label));
+  }
+  return TextButton(onPressed: onPressed, child: Text(label));
+}
+
+// ---- the hooks ----
+
+/// D1, D2 (main.dart, beside hjvInitAccount; the main window and the phone app, not the
+/// connection manager, the install page or a session window): tells the core the device, has it
+/// check the policy, which it then does every six hours by itself, and checks again when the
+/// app comes back to the front after an hour and right after a login.
+void hjvInitUpdate() {
+  if (!hjvEnabled()) return;
+  // the app starts whatever happens here
+  try {
+    _refresh();
+    _bannerClosed.value = hjvHost.option(_kBannerClosed);
+    _moveClosed.value = hjvHost.option(_kMoveClosed) == 'Y';
+    platformFFI.registerEventHandler(
+        _kEvent, _kEvent, (evt) async => hjvOnUpdateEvent(evt),
+        replace: true);
+    WidgetsBinding.instance.addObserver(_front);
+    if (isDesktop) windowManager.addListener(_front);
+    hjvHost.listenLogin(hjvOnLogin);
+    unawaited(hjvStart());
+  } catch (e) {
+    debugPrint('hjv update: init: $e');
+  }
+}
+
+/// D3, D4 (the connection pages): the outgoing side of the home page, the ID field and the
+/// device lists. An app that must update gets the update screen in its place; a newer version
+/// that is not required yet is a line above it. A build that takes no part gets the page itself.
+Widget hjvGate(Widget child) => hjvEnabled() ? Obx(() => _gate(child)) : child;
+
+Widget _gate(Widget child) {
+  final info = hjvUpdate.value;
+  if (!info.enabled) return child;
+  final device = hjvHost.device;
+  final banner = switch (info.state) {
+    HjvState.available => _bannerClosed.value != info.latest,
+    HjvState.grace => !_graceClosed.value,
+    _ => false,
+  };
+  // only an Android app that came from a file has this entry
+  final move =
+      info.moveToPlay && info.channel == 'android' && !_moveClosed.value;
+  return Column(children: [
+    if (move)
+      _HjvStrip(
+          text: HjvUpdateText.moveToPlay,
+          action: HjvUpdateText.moveHow,
+          onAction: _showMoveToPlay,
+          onClose: _closeMove),
+    if (banner)
+      _HjvStrip(
+          text: hjvBannerText(info),
+          action: HjvUpdateText.update,
+          onAction: hjvShowUpdate,
+          onClose: () => _closeBanner(info)),
+    Expanded(
+        child: info.required
+            ? HjvUpdatePage(
+                model: hjvPanelModel(info, device, steps: hjvSteps.value),
+                onAction: hjvRunAction)
+            : child),
+  ]);
+}
+
+/// D5-D7 (connect() in common.dart, newSession and newTerminal in multi_window_manager.dart):
+/// every way to start an outgoing session asks this first, also links, command lines and the
+/// session windows. True when the session must not start: the app has to update, and the user
+/// is told so in the window they acted in. The verdict is the core's; when the policy was last
+/// asked for over half an hour ago, the answer to a new request is waited for, two seconds at
+/// most. Any other start for the same PC during that wait is dropped, so that a second click
+/// does not open the session twice.
+Future<bool> hjvBlockConnect(String id) async {
+  if (!hjvEnabled()) return false;
+  if (!_connecting.add(id)) return true;
+  try {
+    final info = await hjvStateForConnect(
+        read: hjvReadState,
+        checkNow: () => hjvHost.set(_kCheck, 'now'),
+        now: hjvHost.now,
+        pause: hjvHost.pause);
+    _took(info);
+    if (!info.required) return false;
+    try {
+      _showBlocked(info);
+    } catch (e) {
+      debugPrint('hjv update: blocked: $e');
+    }
+    return true;
+  } finally {
+    _connecting.remove(id);
+  }
+}
+
+/// D6, D7: what a session that did not start answers.
+MultiWindowCallResult hjvNoWindow() =>
+    MultiWindowCallResult(kInvalidWindowId, null);
+
+/// D8 (handlePeerInfo in model.dart): a controller that has connected to a Windows PC below the
+/// minimum hears how that PC gets updated; the connection goes on (design 2-3). Not a dialog:
+/// the session's message boxes close every dialog.
+void hjvOnPeerInfo(
+    String peerId, Map<String, dynamic> evt, ConnType? connType) {
+  if (connType != ConnType.defaultConn || !hjvEnabled()) return;
+  // the session goes on whatever happens here
+  try {
+    final version = evt['version'], platform = evt['platform'];
+    if (version is! String || platform != kPeerPlatformWindows) return;
+    final notice = hjvPeerNotice(
+        version: version,
+        platform: kPeerPlatformWindows,
+        min: hjvHost.get('hjv-min-version-windows'),
+        additions: evt['platform_additions']);
+    if (notice == null || _peersTold.contains('$peerId@$version')) return;
+    final copies = hjvHost.device.platform != HjvPlatform.ios;
+    final shown = _showPeerCard((close) => HjvPeerCard(
+        peer: formatID(peerId),
+        notice: notice,
+        copies: copies,
+        askLink: () => hjvAskLink('windows', notice.installed),
+        copy: hjvHost.copy,
+        onClose: close));
+    if (shown) _peersTold.add('$peerId@$version');
+  } catch (e) {
+    debugPrint('hjv update: peer: $e');
+  }
+}
+
+/// D9 (createDialogContent in common.dart): in a build that takes part, dialogs show the texts
+/// of servers and peers without making their addresses into links (design 2-1): the way to an
+/// update is the app's own screen, by the signed policy.
+bool hjvLinksOff() => hjvEnabled();
+
+/// Settings → About on the desktop: the versions, the policy, [업데이트 확인].
+List<Widget> hjvAboutRows() => hjvEnabled() ? [const HjvAbout()] : [];
+
+/// Settings → About on a phone.
+List<AbstractSettingsTile> hjvAboutTiles() => hjvEnabled()
+    ? [
+        // the lines as the description: an iPhone's tile has its value in the title's row
+        CustomSettingsTile(
+            child: Obx(() => SettingsTile(
+                  title: Text(hjvUpdate.value.checking
+                      ? HjvUpdateText.checking
+                      : HjvUpdateText.check),
+                  description: Text(hjvAboutLines(hjvUpdate.value).join('\n')),
+                  leading: const Icon(Icons.system_update),
+                  onPressed: (_) => hjvCheckByHand(),
+                ))),
+      ]
+    : [];
+
+// ---- checks ----
+
+/// The start: the device first, since an Android app has no entry to be judged by until the
+/// core knows where it was installed from, then the check.
+Future<void> hjvStart() async {
+  try {
+    // a download of an earlier run of the screens may still go on in the core
+    final phase = hjvReadState().phase;
+    if (phase != HjvPhase.downloading && phase != HjvPhase.ready) {
+      await hjvHost.clearDownloads();
+    }
+    final device = await hjvHost.deviceValue();
+    if (device.isNotEmpty) await hjvHost.set('hjv-update-device', device);
+    await hjvHost.set(_kCheck, '');
+  } catch (e) {
+    debugPrint('hjv update: start: $e');
+  }
+  _refresh();
+}
+
+/// The app came back to the front (a phone app resumed, the main window focused).
+void hjvCameToFront() {
+  final info = hjvReadState();
+  _took(info);
+  if (hjvCheckDue(info, hjvHost.now(), kHjvFrontAge)) _ask(_kCheck, '');
+  // back from the system's settings, where the app was allowed to install
+  if (hjvSteps.value.install == HjvInstall.permission &&
+      info.phase == HjvPhase.ready) {
+    unawaited(_install(info.file));
+  }
+}
+
+class _HjvFront extends WindowListener with WidgetsBindingObserver {
+  // a desktop window tells its focus (peers_view.dart)
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed && !isDesktop) hjvCameToFront();
+  }
+
+  @override
+  void onWindowFocus() => hjvCameToFront();
+
+  // on Windows a restored window reports a blur, not a focus (peers_view.dart)
+  @override
+  void onWindowRestore() => hjvCameToFront();
+}
+
+final _front = _HjvFront();
+
+/// The login's name changed: a login is followed by a check at once, and either way the state
+/// says anew what this app can show the server.
+void hjvOnLogin(String name) {
+  _refresh();
+  if (name.isNotEmpty) _ask(_kCheck, 'now');
+}
+
+/// The core's "hjv-update" event, which the main window or the phone app gets: the state, and
+/// the answer to a link request, which goes on to the window that asked.
+void hjvOnUpdateEvent(Map<String, dynamic> evt) {
+  final answer = hjvLinkMessage(evt);
+  if (answer != null) {
+    IsolateNameServer.lookupPortByName(_kLinkPort)?.send(answer);
+  }
+  _took(HjvUpdateInfo.fromMap(evt));
+}
+
+/// Has the core check now and waits for the end of that request.
+Future<HjvUpdateInfo> hjvCheckNow() async {
+  try {
+    await hjvHost.set(_kCheck, 'now');
+  } catch (e) {
+    debugPrint('hjv update: check: $e');
+  }
+  var info = hjvReadState();
+  _took(info);
+  for (var waited = Duration.zero;
+      info.checking && waited < _kCheckWait;
+      waited += kHjvPoll) {
+    await hjvHost.pause(kHjvPoll);
+    info = hjvReadState();
+  }
+  _took(info);
+  return info;
+}
+
+/// [업데이트 확인] and [다시 확인]: checks and says what came of it; from the settings, a
+/// newer version opens the update screen.
+Future<void> hjvCheckByHand({bool opens = true}) async {
+  if (_checkingByHand) return;
+  _checkingByHand = true;
+  try {
+    final info = await hjvCheckNow();
+    if (opens && info.behind && !info.required) {
+      hjvShowUpdate();
+    } else {
+      hjvHost.toast(hjvCheckResult(info, hjvHost.now()));
+    }
+  } finally {
+    _checkingByHand = false;
+  }
+}
+
+// ---- the update screen ----
+
+/// The update screen as a dialog, where the connection page is not replaced by it: from the
+/// banner, from Settings → About and from a connection that was held back.
+void hjvShowUpdate() {
+  _refresh();
+  _show<void>(
+      (setState, close, context) => CustomAlertDialog(
+            content: Obx(() => HjvUpdateBody(
+                model: hjvPanelModel(hjvUpdate.value, hjvHost.device,
+                    steps: hjvSteps.value),
+                onAction: hjvRunAction)),
+            actions: [_button(HjvUpdateText.close, close, outline: true)],
+            onCancel: close,
+          ),
+      tag: _kPanelTag);
+}
+
+/// B1: a connection that did not start.
+CustomAlertDialog hjvBlockedDialog(HjvUpdateInfo info,
+        {required VoidCallback onClose, required VoidCallback onUpdate}) =>
+    CustomAlertDialog(
+      title: const Text(HjvUpdateText.blockedTitle),
+      content: Text(HjvUpdateText.blockedBody(info.min)),
+      actions: [
+        _button(HjvUpdateText.close, onClose, outline: true),
+        _button(HjvUpdateText.update, onUpdate),
+      ],
+      onCancel: onClose,
