+  static const noEntry = '이 기기에 맞는 업데이트 정보가 아직 없습니다.';
+  static const checkFailed = '업데이트를 확인하지 못했습니다. 인터넷 연결을 확인하고 다시 시도하세요.';
+  static String policy(int epoch, int seq, String issued) =>
+      '업데이트 정책: 세대 $epoch · 순번 $seq · 발행 $issued';
+  static const noPolicy = '업데이트 정책: 아직 받지 못했습니다';
+  static String checked(String at) => '마지막 확인: $at';
+  static const neverChecked = '마지막 확인: 없음';
+  static String source(String tag) =>
+      '소스 코드(GNU AGPL-3.0): $kHjvSourceRepo 저장소의 태그 $tag';
+
+  /// Why a download, a link or the service's install did not get through (the core's codes).
+  static String failure(String code) => switch (code) {
+        'tls' => errTls,
+        'verify' => errVerify,
+        'version' => errNotThisApp,
+        'busy' => errBusy,
+        'refused' => errRefused,
+        'file' => errFile,
+        'missing' => preparing,
+        'login' => needsLogin,
+        'install' => installFailed,
+        'attempts' => attempts,
+        'service' => serviceSilent,
+        _ => errDownload,
+      };
+}
+
+/// What a button of the update screen does.
+enum HjvAction {
+  recheck,
+  logIn,
+  openTestFlight,
+  openPlay,
+
+  /// Has the core fetch the package: into the app's cache on Android, into the user's Downloads
+  /// in a Windows app that is not installed.
+  download,
+
+  /// Android below 7.0: asks for a short link and opens it in the browser.
+  browser,
+
+  /// Android: hands the checked APK to the system installer.
+  install,
+  installSettings,
+
+  /// Windows, installed: after a confirmation, has the service install now.
+  updateNow,
+
+  /// Windows, not installed: starts the downloaded file in place of this app.
+  run,
+}
