+++ b/flutter/test/hjv_update_gate_test.dart
@@ -0,0 +1,1335 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_update.dart';
+import 'package:flutter_hbb/common/hjv_update_model.dart';
+import 'package:flutter_hbb/models/model.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:window_manager/window_manager.dart';
+
+// The screens of the minimum app version against a stand-in of the Rust core, which answers
+// "hjv-update-state" and takes the "hjv-update-…" requests as src/hjviewer_update does. These
+// tests import common.dart, so they need the generated bridge, which client-build.yml makes
+// before its Dart tests; ci.sh runs hjv_update_test.dart.
+
+const checkedAt = 1793581200;
+const pc = HjvDevice(platform: HjvPlatform.windows, takesIncoming: true);
+const android = HjvDevice(platform: HjvPlatform.android, sdk: 34);
+const oldAndroid = HjvDevice(platform: HjvPlatform.android, sdk: 23);
+const iphone =
+    HjvDevice(platform: HjvPlatform.ios, iosExport: 'app-store-connect');
+
+/// The state as the core writes it.
+Map<String, Object?> core(String state,
+        {String channel = 'windows',
+        Map<String, Object?> more = const {},
+        Map<String, Object?> job = const {}}) =>
+    {
+      'state': state,
+      'channel': channel,
+      'current': '1.6.0',
+      'min': '1.6.1',
+      'latest': '1.6.2',
+      'grace_until': state == 'grace' ? 1795014000 : 0,
+      'os_min': '',
+      'os_too_old': false,
+      'notes': '',
+      'source': '',
+      'contact': '',
+      'move_to_play': false,
+      'package': {'file': 'HJViewer-1.6.2-windows-x86_64.exe', 'size': 200},
+      'installed': false,
+      'installer': '',
+      'credential': 'token',
+      'policy_epoch': 1,
+      'policy_seq': 12,
+      'policy_issued': 1793577600,
+      'checked_at': checkedAt,
+      'tried_at': checkedAt,
+      'checking': false,
+      ...more,
+      'job': {
+        'phase': 'idle',
+        'error': '',
+        'done': 0,
+        'total': 0,
+        'file': '',
+        ...job
+      },
+    };
+
+class FakeHost extends HjvHost {
+  FakeHost(this.state, {this.dev = pc, this.main = true});
+
+  /// The core's state; null is a build that takes no part, which answers "".
+  Map<String, Object?>? state;
+  HjvDevice dev;
+  bool main;
+  int clock = checkedAt + 60;
+
+  /// What the core was asked, in order, as "key=value".
+  final asked = <String>[];
+
+  /// What a request does to the core.
+  void Function(String key, String value)? onSet;
+  Future<void> Function()? onPause;
+  String minWindows = '1.6.1';
+  String deviceJson = '';
+  final toasts = <String>[];
+  final launched = <String>[];
+  Set<String> opens = {};
+  final copied = <String>[];
+  final installs = <String>[];
+  Object? installAnswer = 'ok';
+  final options = <String, String>{};
+  final manager = OverlayDialogManager();
+  int reads = 0, logins = 0, shownMain = 0, settingsOpened = 0;
+
+  /// The core tells the main window that its state changed.
+  void push([Map<String, Object?> extra = const {}]) =>
+      hjvOnUpdateEvent({...?state, ...extra, 'name': 'hjv-update'});
+
+  @override
+  String get(String key) {
+    reads++;
+    final now = state;
+    if (now == null) return '';
+    return key == 'hjv-update-state'
+        ? jsonEncode(now)
+        : key == 'hjv-min-version-windows'
+            ? minWindows
+            : '';
+  }
+
+  @override
+  Future<void> set(String key, String value) async {
+    asked.add('$key=$value');
+    onSet?.call(key, value);
+  }
+
+  @override
+  HjvDevice get device => dev;
+  @override
+  bool get isMain => main;
+  @override
+  int now() => clock;
+  @override
+  Future<void> pause(Duration time) async => await onPause?.call();
+  @override
+  OverlayDialogManager get dialogs => manager;
+  @override
+  OverlayState? get overlay => globalKey.currentState?.overlay;
+  @override
+  void toast(String text) => toasts.add(text);
+  @override
+  void logIn() => logins++;
+
+  /// What a change of the login's name calls.
+  void Function(String name)? loginListener;
+  @override
+  void listenLogin(void Function(String name) then) => loginListener = then;
+
+  /// Whether the app is in front (Android starts no installer for an app in the background).
+  bool front = true;
+  @override
+  bool get inFront => front;
+  @override
+  Future<bool> launch(Uri uri) async {
+    launched.add('$uri');
+    return opens.contains('$uri');
+  }
+
+  @override
+  Future<void> copy(String text) async => copied.add(text);
+  @override
+  void showMain() => shownMain++;
+  @override
+  Future<String> deviceValue() async => deviceJson;
+  int cleared = 0;
+  @override
+  Future<void> clearDownloads() async => cleared++;
+  @override
+  Future<String> packageName() async => 'com.example.hjv';
+  @override
+  Future<String> downloadFolder() async =>
+      dev.platform == HjvPlatform.android ? '/cache/updates' : '';
+  @override
+  Future<Object?> installApk(String path) async {
+    installs.add(path);
+    return installAnswer;
+  }
+
+  @override
+  void openInstallSettings() => settingsOpened++;
+  @override
+  String option(String key) => options[key] ?? '';
+  @override
+  void setOption(String key, String value) => options[key] = value;
+}
+
+FakeHost use(Map<String, Object?>? state,
+    {HjvDevice device = pc, bool main = true}) {
+  final host = FakeHost(state, dev: device, main: main);
+  hjvUseHost(host);
+  if (state != null) host.push();
+  return host;
+}
+
+Widget app(Widget home) =>
+    MaterialApp(navigatorKey: globalKey, home: Scaffold(body: home));
+
+/// CustomAlertDialog asks for the focus in a zero timer on each build: let the last one run.
+Future<void> settle(WidgetTester tester) async {
+  await tester.pumpAndSettle();
+  await tester.pump(const Duration(milliseconds: 10));
+}
+
+Finder inDialog(Finder what) =>
+    find.descendant(of: find.byType(CustomAlertDialog), matching: what);
+
+const page = Text('connection page');
+const linkText = 'see https://rd.example.com/a now';
+
+void main() {
+  tearDown(() => hjvUseHost(HjvHost()));
+
+  group('a build that takes no part', () {
+    testWidgets(
+        'keeps the connection page, the links and the connections as 1.5.1',
+        (tester) async {
+      final host = use(null);
