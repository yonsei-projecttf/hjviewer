+/// What the core knows: the verdict for this app, the versions, the policy it came from and how
+/// far an update got. Texts of the policy (`notes`, `contact`, `source`) are shown as plain
+/// text, never as links.
+class HjvUpdateInfo {
+  final HjvState state;
+
+  /// The policy's entry this app is judged by: windows, android, android_play, ios, or "".
+  final String channel;
+  final String current;
+  final String min;
+  final String latest;
+
+  /// Unix seconds until which an app below `min` still connects; 0 for none.
+  final int graceUntil;
+  final String osMin;
+
+  /// The device's system cannot run `latest`.
+  final bool osTooOld;
+  final String notes;
+  final String contact;
+  final String source;
+  final bool moveToPlay;
+
+  /// The entry has a package that the app or the PC's service can fetch.
+  final bool hasPackage;
+
+  /// Windows: this is the installed app, which its service updates.
+  final bool installed;
+
+  /// Windows, installed: the service installs `latest` by itself. Until the core says so, the
+  /// screens do not promise it.
+  final bool autoInstall;
+
+  /// What can be shown at door 1: token (a login), none, and on an installed Windows PC device
+  /// or unbound (the PC is on no account).
+  final String credential;
+  final int policyEpoch;
+  final int policySeq;
+  final int policyIssued;
+
+  /// The last answer with a policy, and the last attempt of this run; Unix seconds, 0 for none.
+  final int checkedAt;
+  final int triedAt;
+
+  /// A check was asked for and has not ended.
+  final bool checking;
+  final HjvPhase phase;
+
+  /// With the phase error: why.
+  final String error;
+  final int done;
+  final int total;
+
+  /// With the phase ready: the checked file.
+  final String file;
+
+  /// With the phase notice: when the install starts, Unix seconds.
+  final int until;
+
+  const HjvUpdateInfo({
+    this.state = HjvState.disabled,
+    this.channel = '',
+    this.current = '',
+    this.min = '',
+    this.latest = '',
+    this.graceUntil = 0,
+    this.osMin = '',
+    this.osTooOld = false,
+    this.notes = '',
+    this.contact = '',
+    this.source = '',
+    this.moveToPlay = false,
+    this.hasPackage = false,
+    this.installed = false,
+    this.autoInstall = false,
+    this.credential = '',
+    this.policyEpoch = 0,
+    this.policySeq = 0,
+    this.policyIssued = 0,
+    this.checkedAt = 0,
+    this.triedAt = 0,
+    this.checking = false,
+    this.phase = HjvPhase.idle,
+    this.error = '',
+    this.done = 0,
+    this.total = 0,
+    this.file = '',
+    this.until = 0,
+  });
+
+  static const none = HjvUpdateInfo();
+
+  bool get enabled => state != HjvState.disabled;
+  bool get required => state == HjvState.required;
+
+  /// A newer version exists for this app: there is something to show.
+  bool get behind =>
+      state == HjvState.available ||
+      state == HjvState.grace ||
+      state == HjvState.required;
+
+  bool get fromPlay => channel == 'android_play';
+
+  /// Download progress from 0 to 1; null while the size is unknown.
+  double? get progress => total > 0 ? (done / total).clamp(0.0, 1.0) : null;
+
+  factory HjvUpdateInfo.fromMap(Map m) {
+    T pick<T extends Enum>(List<T> values, Object? name, T fallback) {
+      for (final v in values) {
+        // "disabled" is this side's word for no answer, never the core's
+        if (v.name == name && v != HjvState.disabled) return v;
+      }
+      return fallback;
+    }
+
+    int number(Object? v) => v is int
+        ? v
+        : v is double
+            ? v.toInt()
+            : int.tryParse('${v ?? ''}') ?? 0;
+    String text(Object? v) => v is String ? v : '';
+    final job = m['job'] is Map ? m['job'] as Map : const {};
+    return HjvUpdateInfo(
+      state: pick(HjvState.values, m['state'], HjvState.unknown),
+      channel: text(m['channel']),
+      current: text(m['current']),
+      min: text(m['min']),
+      latest: text(m['latest']),
+      graceUntil: number(m['grace_until']),
+      osMin: text(m['os_min']),
+      osTooOld: m['os_too_old'] == true,
+      notes: text(m['notes']),
+      contact: text(m['contact']),
+      source: text(m['source']),
+      moveToPlay: m['move_to_play'] == true,
+      hasPackage: m['package'] is Map,
+      installed: m['installed'] == true,
+      autoInstall: m['auto_install'] == true,
+      credential: text(m['credential']),
+      policyEpoch: number(m['policy_epoch']),
+      policySeq: number(m['policy_seq']),
+      policyIssued: number(m['policy_issued']),
+      checkedAt: number(m['checked_at']),
+      triedAt: number(m['tried_at']),
+      checking: m['checking'] == true,
+      phase: pick(HjvPhase.values, job['phase'], HjvPhase.idle),
+      error: text(job['error']),
+      done: number(job['done']),
+      total: number(job['total']),
+      file: text(job['file']),
+      until: number(job['until']),
+    );
+  }
+
+  /// An empty answer is a build that takes no part. An answer that cannot be read is treated
+  /// the same: it never blocks.
+  factory HjvUpdateInfo.fromJson(String s) {
+    if (s.isEmpty) return none;
+    try {
+      final m = jsonDecode(s);
+      return m is Map ? HjvUpdateInfo.fromMap(m) : none;
+    } catch (_) {
+      return none;
+    }
+  }
+}
