+      expect(hjvDeviceValue(os: '17.5.1'), '{"os":"17.5.1"}');
+      expect(hjvDeviceValue(os: '10.0.19045'), '{"os":"10.0.19045"}');
+      expect(hjvDeviceValue(), '');
+      expect(hjvDeviceValue(os: ''), '');
+    });
+  });
