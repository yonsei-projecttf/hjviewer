+      expect(find.text('connection page'), findsOneWidget);
+      // the page itself, as 1.5.1 builds it
+      expect(tester.widget<Scaffold>(find.byType(Scaffold)).body, same(page));
+
+      expect(await hjvBlockConnect('123456789'), isFalse);
+      hjvOnPeerInfo('123456789', {'version': '1.5.1', 'platform': 'Windows'},
+          ConnType.defaultConn);
+      await tester.pump();
+      expect(find.textContaining('업데이트'), findsNothing);
+      expect(hjvAboutRows(), isEmpty);
+      expect(hjvAboutTiles(), isEmpty);
+      // nothing was asked of the core but whether it takes part, once
+      expect(host.asked, isEmpty);
+      expect(host.reads, 1);
+
+      final content = createDialogContent(linkText) as SelectableText;
+      final link = content.textSpan!.children!
+          .whereType<TextSpan>()
+          .singleWhere((span) => span.recognizer != null);
+      expect(link.text, 'https://rd.example.com/a');
+    });
+
+    testWidgets('a core that cannot be asked yet is asked again later',
+        (tester) async {
+      // "" is the answer of a build, which does not change; an error is not an answer
+      final host = _NotYet();
+      hjvUseHost(host);
+      expect(hjvEnabled(), isFalse);
+      expect(hjvLinksOff(), isFalse);
+      expect(await hjvBlockConnect('1'), isFalse);
+      expect(hjvReadState().state, HjvState.disabled);
+      expect(host.asked, isEmpty);
+      host.ready = true;
+      expect(hjvEnabled(), isTrue);
+      expect(await hjvBlockConnect('1'), isTrue);
+    });
+  });
+
+  group('the connection page', () {
+    testWidgets('stays as it is while the app is up to date', (tester) async {
+      final host = use(core('ok'));
+      await tester.pumpWidget(app(hjvGate(page)));
+      expect(find.text('connection page'), findsOneWidget);
+      expect(find.textContaining('새 버전'), findsNothing);
+      host.state = core('unknown', channel: '');
+      host.push();
+      await tester.pump();
+      expect(find.text('connection page'), findsOneWidget);
+      expect(find.textContaining('업데이트'), findsNothing);
+    });
+
+    testWidgets('gets a line for a newer version, which can be closed for good',
+        (tester) async {
+      tester.view.physicalSize = const Size(360, 640);
+      tester.view.devicePixelRatio = 1;
+      addTearDown(tester.view.reset);
+      final host = use(core('available'));
+      await tester.pumpWidget(app(hjvGate(page)));
+      expect(find.text('connection page'), findsOneWidget);
+      expect(find.text('새 버전이 나왔습니다(1.6.2).'), findsOneWidget);
+      expect(tester.takeException(), isNull);
+
+      // [업데이트] opens the update screen over the page
+      await tester.tap(find.text('업데이트'));
+      await settle(tester);
+      expect(inDialog(find.text('HJViewer를 새 버전(1.6.2)으로 업데이트할 수 있습니다.')),
+          findsOneWidget);
+      expect(inDialog(find.text('현재 1.6.0 · 최소 1.6.1 · 최신 1.6.2')),
+          findsOneWidget);
+      await tester.tap(inDialog(find.text('닫기')));
+      await settle(tester);
+      expect(find.byType(CustomAlertDialog), findsNothing);
+
+      await tester.tap(find.byIcon(Icons.close));
+      await tester.pump();
+      expect(find.text('새 버전이 나왔습니다(1.6.2).'), findsNothing);
+      expect(find.text('connection page'), findsOneWidget);
+      expect(host.options['hjv-update-banner-closed'], '1.6.2');
+      // the next version shows again
+      host.state = core('available', more: {'latest': '1.6.3'});
+      host.push();
