+/// The notice about a PC whose app is below the minimum (C1a, C1b), and for a PC without an
+/// update screen the short link to the new version (U1), typed or pasted into the PC's browser.
+class HjvPeerCard extends StatefulWidget {
+  /// The PC's ID as the app shows it: a window may hold sessions to several PCs.
+  final String peer;
+  final HjvPeerNotice notice;
+
+  /// Whether the link also goes to the clipboard: an iPhone's does not reach the remote PC.
+  final bool copies;
+  final Future<HjvLinkAnswer> Function() askLink;
+  final Future<void> Function(String text) copy;
+  final VoidCallback onClose;
+
+  const HjvPeerCard(
+      {Key? key,
+      required this.peer,
+      required this.notice,
+      required this.copies,
+      required this.askLink,
+      required this.copy,
+      required this.onClose})
+      : super(key: key);
+
+  @override
+  State<HjvPeerCard> createState() => _HjvPeerCardState();
+}
+
+class _HjvPeerCardState extends State<HjvPeerCard> {
+  Timer? _timer;
+  var _asking = false;
+  HjvLinkAnswer? _answer;
+
+  @override
+  void initState() {
+    super.initState();
+    _closeAfter(_kPeerNoticeFor);
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  void _closeAfter(Duration time) {
+    _timer?.cancel();
+    _timer = Timer(time, widget.onClose);
+  }
+
+  Future<void> _ask() async {
+    if (_asking) return;
+    _timer?.cancel();
+    setState(() {
+      _asking = true;
+      _answer = null;
+    });
+    final answer = await widget.askLink();
+    final link = answer.link;
+    if (link != null && widget.copies) {
+      try {
+        await widget.copy(link.url);
+      } catch (e) {
+        debugPrint('hjv update: copy: $e');
+      }
+    }
+    if (!mounted) return;
+    setState(() {
+      _asking = false;
+      _answer = answer;
+    });
+    // a link that has run out is of no use on the screen
+    _closeAfter(
+        link == null ? _kPeerNoticeFor : Duration(seconds: link.expiresIn));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final answer = _answer;
+    final link = answer?.link;
+    const gap = SizedBox(height: 8);
+    final lines = <Widget>[
+      Text(HjvUpdateText.peerRemote(widget.peer),
+          style: theme.textTheme.bodySmall),
+      gap,
+      if (link != null) ...[
+        Text(HjvUpdateText.linkEnter(link.minutes)),
+        gap,
+        Wrap(crossAxisAlignment: WrapCrossAlignment.end, children: [
+          Text(link.typed, style: const TextStyle(fontSize: 18)),
+          Text(link.code,
+              style: const TextStyle(
+                  fontSize: 24,
+                  fontWeight: FontWeight.bold,
+                  letterSpacing: 1.5)),
+        ]),
+        gap,
+        if (widget.copies)
+          Text(HjvUpdateText.linkCopied, style: theme.textTheme.bodySmall),
+        Text(HjvUpdateText.linkThen),
+      ] else if (answer != null)
+        Text(answer.error == 'login'
+            ? HjvUpdateText.linkNeedsLogin
+            : HjvUpdateText.linkFailed)
+      else ...[
+        Text(widget.notice.text),
+        if (_asking) ...[
+          gap,
+          const Text(HjvUpdateText.linkAsking),
+          gap,
+          const LinearProgressIndicator(),
+        ],
+      ],
+    ];
+    final again = answer != null && link == null && answer.error != 'login';
+    return Material(
+      elevation: 6,
+      color: theme.dialogBackgroundColor,
+      borderRadius: BorderRadius.circular(8),
+      child: ConstrainedBox(
+        constraints: const BoxConstraints(maxWidth: 440),
+        child: Padding(
+          padding: const EdgeInsets.fromLTRB(14, 10, 8, 4),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              ...lines,
+              Row(mainAxisAlignment: MainAxisAlignment.end, children: [
+                if (widget.notice.offersLink && answer == null && !_asking)
+                  TextButton(
+                      onPressed: _ask,
+                      child: const Text(HjvUpdateText.linkButton)),
+                if (again)
+                  TextButton(
+                      onPressed: _ask, child: const Text(HjvUpdateText.retry)),
+                TextButton(
+                    onPressed: widget.onClose,
+                    child: const Text(HjvUpdateText.close)),
+              ]),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
