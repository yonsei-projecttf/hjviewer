+/// What only the screen knows of the device it runs on.
+class HjvDevice {
+  final HjvPlatform platform;
+
+  /// Android's API level; 0 elsewhere and while unknown.
+  final int sdk;
+
+  /// iOS: how the build was exported (HJV_IOS_EXPORT).
+  final String iosExport;
+
+  /// This app takes connections from other devices (a PC), so they go on while it is blocked.
+  final bool takesIncoming;
+
+  const HjvDevice({
+    this.platform = HjvPlatform.other,
+    this.sdk = 0,
+    this.iosExport = '',
+    this.takesIncoming = false,
+  });
+
+  bool get testFlight => iosExport == kHjvTestFlightExport;
+
+  /// Android before 7.0 takes no APK from the app's own files.
+  bool get browserInstall => sdk > 0 && sdk < kHjvInAppInstallSdk;
+}
+
+/// What the system installer answered when the app handed it the checked APK (Android).
+enum HjvInstall { none, opened, permission, mismatch, failed }
+
+/// The answer of MainActivity's "hjv_install_apk": "ok" when Android was asked to start the
+/// installer, "permission" when the app may not install packages yet, "mismatch" when the file
+/// is not this app's (another package or another certificate; the file is gone then). Anything
+/// else, and a build without the call, failed.
+HjvInstall hjvInstallResult(Object? answer) => switch (answer) {
+      'ok' => HjvInstall.opened,
+      'permission' => HjvInstall.permission,
+      'mismatch' => HjvInstall.mismatch,
+      _ => HjvInstall.failed,
+    };
+
+/// The steps of an update that the screen runs itself, which the core's state does not hold.
+class HjvSteps {
+  final HjvInstall install;
+
+  /// Android below 7.0: a short link for the browser is being asked for, ...
+  final bool linking;
+
+  /// ... or did not come, for this reason.
+  final String linkError;
+
+  const HjvSteps({
+    this.install = HjvInstall.none,
+    this.linking = false,
+    this.linkError = '',
+  });
+}
