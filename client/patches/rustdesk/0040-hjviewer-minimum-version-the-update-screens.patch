+              state('ok', more: {'checked_at': 0, 'tried_at': 0}), 5, age),
+          isTrue);
+      // an attempt that failed counts: a server that is down is not asked at every connection
+      final failed = state('ok', more: {'tried_at': checked + 7200});
+      expect(hjvCheckDue(failed, checked + 7200 + 60, age), isFalse);
+      expect(kHjvConnectAge, const Duration(minutes: 30));
+      expect(kHjvFrontAge, const Duration(hours: 1));
+    });
+
+    /// A core that answers a check after `answerAfter` looks at its state.
+    Future<(HjvUpdateInfo, int, int)> connect(HjvUpdateInfo held, int now,
+        {int? answerAfter, HjvUpdateInfo? answer, bool refuses = false}) async {
+      var asked = 0, pauses = 0;
+      var checking = false;
+      final got = await hjvStateForConnect(
+          read: () {
+            if (checking && answerAfter != null && pauses >= answerAfter) {
+              checking = false;
+              held = answer ?? held;
+            }
+            return HjvUpdateInfo.fromMap({
+              'state': held.state.name,
+              'checked_at': held.checkedAt,
+              'tried_at': held.triedAt,
+              'checking': checking
+            });
+          },
+          checkNow: () async {
+            asked++;
+            if (refuses) throw StateError('no core');
+            checking = true;
+          },
+          now: () => now,
+          pause: (time) async {
+            expect(time, const Duration(milliseconds: 100));
+            pauses++;
+          });
+      return (got, asked, pauses);
+    }
+
+    test('a connection goes by the held verdict while it is fresh', () async {
+      final (got, asked, pauses) = await connect(state('ok'), checked + 60);
+      expect([got.state, asked, pauses], [HjvState.ok, 0, 0]);
+      final blocked = (await connect(state('required'), checked + 60)).$1;
+      expect(blocked.required, isTrue);
+    });
+
+    test('a connection waits for a new answer when the last one is old',
+        () async {
+      final later = checked + 1801;
+      final fresh = state('required', more: {'checked_at': later});
+      final (got, asked, pauses) =
+          await connect(state('ok'), later, answerAfter: 3, answer: fresh);
+      expect([got.required, asked, pauses], [true, 1, 3]);
+      // an old "required" is asked about again too, and may be gone
+      final freed = await connect(state('required'), later,
+          answerAfter: 1, answer: state('ok', more: {'checked_at': later}));
+      expect(freed.$1.required, isFalse);
+    });
+
+    test('the wait ends after two seconds, with the verdict held then',
+        () async {
+      final (got, asked, pauses) =
+          await connect(state('ok'), checked + 1801, answerAfter: null);
+      expect(
+          [got.state, got.checking, asked, pauses], [HjvState.ok, true, 1, 20]);
+      final (still, _, waited) =
+          await connect(state('required'), checked + 1801, answerAfter: null);
+      expect([still.required, waited], [true, 20]);
+    });
+
+    test('a core that cannot be asked, and a build that takes no part',
+        () async {
+      final (got, asked, pauses) =
+          await connect(state('ok'), checked + 1801, refuses: true);
+      expect([got.state, asked, pauses], [HjvState.ok, 1, 0]);
+      var touched = 0;
+      final none = await hjvStateForConnect(
+          read: () => HjvUpdateInfo.none,
+          checkNow: () async => touched++,
+          now: () => 0,
+          pause: (_) async => touched++);
+      expect([none.state, touched], [HjvState.disabled, 0]);
+    });
+
+    test('the device is told before the first check', () {
+      expect(hjvDeviceValue(installer: 'com.android.vending', os: '34'),
+          '{"installer":"com.android.vending","os":"34"}');
+      // an app installed from a file says so: silence would leave it without an entry
