+class HjvLoginNotice {
+  final String title;
+  final List<String> lines;
+
+  /// [이 PC 빼기]: this login added the PC, and `this-device/undo` can take it out again.
+  final bool undo;
+
+  /// The PC has no permanent password: a line with [지금 정하기].
+  final bool askPassword;
+  const HjvLoginNotice(this.title, this.lines,
+      {this.undo = false, this.askPassword = false});
+}
+
+/// The notice after a login on a Windows PC, or null for none. `status` and `undo` are
+/// `GET /api/hjv/this-device`'s (status null when it could not be asked), `boundByLogin` whether
+/// the login's answer bound this PC (`hjv-pc-bound`), `state` the service's state after the wait.
+HjvLoginNotice? hjvLoginNotice(HjvTexts t,
+    {required bool installed,
+    required String? status,
+    required bool undo,
+    required bool boundByLogin,
+    required HjvPcState state,
+    required bool passwordSet}) {
+  if (!installed) return HjvLoginNotice(t.notAddedTitle, [t.notInstalled]);
+  switch (status) {
+    case 'other_account':
+      return HjvLoginNotice(t.notAddedTitle, [t.otherAccount]);
+    case 'check_failed':
+    case 'not_eligible':
+      return HjvLoginNotice(t.notOnTitle, [t.checkFailed]);
+    case 'added':
+    case 'already':
+      break;
+    case null:
+      if (!boundByLogin) return null;
+      break;
+    default:
+      return null;
+  }
+  if (state.kind == HjvPcKind.bindFailed) {
+    return HjvLoginNotice(t.notOnTitle, [t.checkFailed]);
+  }
+  final lines = switch (state.kind) {
+    HjvPcKind.active => [t.canConnect, t.howToTurnOff],
+    HjvPcKind.disabled => [t.adminTurnsOn, t.howToTurnOff],
+    _ => [t.onShortly],
+  };
+  return HjvLoginNotice(
+      status == 'already' ? t.alreadyTitle : t.addedTitle, lines,
+      undo: status == 'added' && undo, askPassword: !passwordSet);
+}
