+    expect(hjvEndsLogin(401, sent: kept, kept: kept), isTrue);
+    // the account settings asked before the login stored its token: none, or the last login's
+    expect(hjvEndsLogin(401, sent: 'Bearer ', kept: kept), isFalse);
