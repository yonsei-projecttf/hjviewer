+        },
+        {'name': 'no ckid'},
+      ],
+      'ended': [
+        {
+          'ckid': 13,
+          'name': 'iPhone',
+          'app_name': 'iPhone99,1',
+          'platform': 'ios',
+          'app_ver': '1.6.0',
+          'net': 'off-campus',
+          'created': oct20,
+          'last_login': oct20,
+          'last_used': oct21,
+          'last_used_pc': '연구실-PC',
+          'use': [],
+          'current': false,
+          'new': true,
+          'ended': oct21 + 3600,
+          'left': 'logout',
+        },
+        {
+          'ckid': 10,
+          'name': 'Windows PC',
+          'app_name': '집-PC',
+          'platform': 'windows',
