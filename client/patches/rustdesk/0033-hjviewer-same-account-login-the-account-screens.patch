+/// What the service shows once it took a login's bind request: on, or paused by the
+/// administrator. Anything else, the screen waits for (kHjvTurnOnWait).
+bool hjvTurnedOn(HjvPcState state) =>
+    state.kind == HjvPcKind.active || state.kind == HjvPcKind.disabled;
