+/// The logged-in devices of the account (design v3 §1-7): a row per device with
+/// [로그아웃시키기], and opened, a line per PC it connected to without a password (U6); below,
+/// the devices whose login ended in the last 30 days and how (U1-b).
+class HjvKeysList extends StatelessWidget {
+  final HjvTexts t;
+  final List<HjvKey> keys;
+  final List<HjvKey> ended;
+  final void Function(HjvKey key) onLogOut;
+  final HjvClock local;
+  const HjvKeysList(
+      {super.key,
+      required this.t,
+      required this.keys,
+      this.ended = const [],
+      required this.onLogOut,
+      this.local = hjvLocal});
+
+  Widget _row(HjvKey k, {required bool loggedIn}) => ExpansionTile(
+        controlAffinity: ListTileControlAffinity.leading,
+        tilePadding: EdgeInsets.zero,
+        title: Text(hjvKeyTitle(t, k)),
+        subtitle: Text(hjvKeyLine(t, k, local: local)),
+        trailing: k.current || !loggedIn
+            ? null
+            : TextButton(
+                onPressed: () => onLogOut(k), child: Text(t.logOutDevice)),
+        expandedCrossAxisAlignment: CrossAxisAlignment.start,
+        childrenPadding: const EdgeInsets.only(left: 40, bottom: 8),
+        children: k.uses.isEmpty
+            ? [Text(t.noUse)]
+            : k.uses.map((u) => Text(hjvUseLine(t, u, local: local))).toList(),
+      );
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        ...keys.map((k) => _row(k, loggedIn: true)),
+        if (ended.isNotEmpty)
+          Text(t.endedDevices,
+                  style: const TextStyle(fontWeight: FontWeight.bold))
+              .marginOnly(top: 12, bottom: 4),
+        ...ended.map((k) => _row(k, loggedIn: false)),
+      ],
