+
+void main() {
+  test('times read as on the screens', () {
+    expect(hjvTime(DateTime(2026, 10, 5, 9, 7)), '10/5 09:07');
+    expect(hjvDay(DateTime(2026, 10, 20, 23, 59)), '10/20');
+    final at = DateTime(2026, 10, 20, 12);
+    expect(hjvRefreshDue(null, at), isTrue);
+    expect(hjvRefreshDue(at, at.add(const Duration(seconds: 29))), isFalse);
+    expect(hjvRefreshDue(at, at.add(const Duration(seconds: 30))), isTrue);
