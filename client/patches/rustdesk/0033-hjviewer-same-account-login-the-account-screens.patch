+// ---- this PC (hjv-pwless-state, design v3 §4-5) ----
+
+enum HjvPcKind {
+  none,
+  active,
+  off,
+  disabled,
+  expired,
+  revoked,
+  listed,
+  needsRelogin,
+  unsynced,
+  bindFailed,
+}
+
+/// The service's hjv-pwless-state: "" while the PC has no binding, `active <keys> <last list>`,
+/// `off`, `disabled`, `expired <last list>`, `revoked`, `listed`, `needs-relogin` or `error <code>
+/// <last list>`; `<last list>` is the PC's clock at the last sync that brought a list, 0 for none.
+class HjvPcState {
+  final HjvPcKind kind;
+  final int keys;
+  final int lastList;
+  final String code;
+  const HjvPcState(this.kind,
+      {this.keys = 0, this.lastList = 0, this.code = ''});
+
+  factory HjvPcState.parse(String state) {
+    final parts = state.trim().split(' ');
+    int at(int i) => i < parts.length ? int.tryParse(parts[i]) ?? 0 : 0;
+    switch (parts.first) {
+      case 'active':
+        return HjvPcState(HjvPcKind.active, keys: at(1), lastList: at(2));
+      case 'off':
+        return const HjvPcState(HjvPcKind.off);
+      case 'disabled':
+        return const HjvPcState(HjvPcKind.disabled);
+      case 'expired':
+        return HjvPcState(HjvPcKind.expired, lastList: at(1));
+      case 'revoked':
+        return const HjvPcState(HjvPcKind.revoked);
+      case 'listed':
+        return const HjvPcState(HjvPcKind.listed);
+      case 'needs-relogin':
+        return const HjvPcState(HjvPcKind.needsRelogin);
+      case 'error':
+        final code = parts.length > 1 ? parts[1] : '';
+        // a bind request hjv-api did not confirm; the others are failed syncs of a bound PC
+        return HjvPcState(
+            code.startsWith('bind-')
+                ? HjvPcKind.bindFailed
+                : HjvPcKind.unsynced,
+            lastList: at(2),
+            code: code);
+      default:
+        return const HjvPcState(HjvPcKind.none);
+    }
+  }
+}
+
+/// Whose PC this is, for the user of these screens.
+enum HjvOwner { mine, other, unknown }
+
+/// From `GET /api/hjv/this-device` of the login (`status`, null when it could not be asked), and
+/// else from whether this user's login bound the PC (`hjv-pc-bound`).
+HjvOwner hjvOwner(
+    {required bool loggedIn, String? status, required bool boundByMe}) {
+  if (!loggedIn) return HjvOwner.unknown;
+  switch (status) {
+    case 'added':
+    case 'already':
+      return HjvOwner.mine;
+    case 'other_account':
+      return HjvOwner.other;
+    case null:
+      return boundByMe ? HjvOwner.mine : HjvOwner.unknown;
+    default:
+      return HjvOwner.unknown;
+  }
+}
+
+/// What a button of this PC's line does: [끄기] switches password-less connections off here,
+/// [다시 켜기] and [다시 로그인] open the login dialog, [다시 추가] logs out and opens it.
+enum HjvPcAction { none, turnOff, turnOn, addAgain, logInAgain }
+
+class HjvPcLine {
+  final String text;
+  final HjvPcAction action;
+  const HjvPcLine(this.text, this.action);
+}
+
+String hjvActionLabel(HjvTexts t, HjvPcAction action) {
+  switch (action) {
+    case HjvPcAction.turnOff:
+      return t.turnOff;
+    case HjvPcAction.turnOn:
+      return t.turnOnAgain;
+    case HjvPcAction.addAgain:
+      return t.addAgain;
+    case HjvPcAction.logInAgain:
+      return t.logInAgain;
+    case HjvPcAction.none:
+      return '';
+  }
+}
+
+/// This PC's line in Settings → Account (design v3 §1-2), or null when the PC has nothing to show
+/// there. Anyone at the PC may switch it off; it comes on again only with a login on it.
+HjvPcLine? hjvPcLine(HjvTexts t, HjvPcState state, HjvOwner owner,
+    {HjvClock local = hjvLocal}) {
+  String line(String what) {
+    final who = switch (owner) {
+      HjvOwner.mine => '${t.mine} · ',
+      HjvOwner.other => '${t.otherOwner} · ',
+      HjvOwner.unknown => '',
+    };
+    return '${t.pcPrefix}$who$what';
+  }
+
+  switch (state.kind) {
+    case HjvPcKind.none:
+      return owner == HjvOwner.other
+          ? HjvPcLine('${t.pcPrefix}${t.otherOwner}', HjvPcAction.none)
+          : null;
+    case HjvPcKind.active:
+      return HjvPcLine(
+          line(owner == HjvOwner.mine ? t.onWithKeys(state.keys) : t.pwlessOn),
+          HjvPcAction.turnOff);
+    case HjvPcKind.off:
+      return HjvPcLine(line(t.offHere), HjvPcAction.turnOn);
+    case HjvPcKind.disabled:
+      return HjvPcLine(line(t.paused), HjvPcAction.none);
+    case HjvPcKind.expired:
+    case HjvPcKind.unsynced:
+      return HjvPcLine(
+          '${t.pcPrefix}${state.lastList > 0 ? t.unsyncedSince(hjvTime(local(state.lastList))) : t.unsynced}',
+          HjvPcAction.turnOff);
+    case HjvPcKind.needsRelogin:
+      return HjvPcLine('${t.pcPrefix}${t.keyChanged}', HjvPcAction.logInAgain);
+    case HjvPcKind.revoked:
+      return HjvPcLine(
+          '${t.pcPrefix}${t.removedElsewhere}', HjvPcAction.addAgain);
+    case HjvPcKind.listed:
+      return HjvPcLine(
+          '${t.pcPrefix}${t.loginHereAgain}', HjvPcAction.addAgain);
+    case HjvPcKind.bindFailed:
+      return HjvPcLine('${t.pcPrefix}${t.notConfirmed}', HjvPcAction.addAgain);
+  }
+}
