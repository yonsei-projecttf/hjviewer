+
+Future<(List<HjvKey>, List<HjvKey>)>? _keysInFlight;
+
+/// `GET /api/hjv/keys`: the account's logged-in devices (at most 20, one page), and those whose
+/// login ended in the last 30 days.
+Future<(List<HjvKey>, List<HjvKey>)> _getKeys() => _keysInFlight ??= () async {
+      try {
+        final (code, body) =
+            await _request('GET', '/api/hjv/keys?current=1&pageSize=100');
+        if (code != 200) throw _HjvError(hjvRequestError(_t, body));
+        return (hjvKeys(body), hjvEndedKeys(body));
+      } finally {
+        _keysInFlight = null;
+      }
+    }();
+
+/// What a request about a logged-in device did, in a dialog: the text says what a logout does
+/// not end (U1-d) and is too long for a toast.
+void _tell(HjvTexts t, String text) =>
+    unawaited(_show<void>((setState, close, context) => CustomAlertDialog(
+          content: Text(text),
+          actions: [_button(t.ok, close)],
+          onSubmit: close,
+          onCancel: close,
+        )));
+
+/// A request about a logged-in device: a dialog tells how it went, unless it was a confirmation
+/// (`done` null) that went through or found the key gone (404).
+Future<void> _keyRequest(HjvTexts t, String method, String path,
+    {String Function(Object? body)? done}) async {
+  try {
+    final (code, body) = await _request(method, path);
+    if (code == 200 || code == 404) {
+      if (done != null) {
+        code == 200 ? _tell(t, done(body)) : showToast(t.alreadyOut);
+      }
+    } else {
+      showToast(hjvRequestError(t, body));
+    }
+  } catch (e) {
+    showToast(hjvFailure(t, e));
+  }
+}
+
+void _showLoggedInDevices() {
+  final t = _t;
+  _show<void>((setState, close, context) => CustomAlertDialog(
+        title: Text(t.loggedInDevices),
+        contentBoxConstraints:
+            const BoxConstraints(minWidth: 360, maxWidth: 560),
+        content: _HjvKeysPanel(t: t),
+        actions: [_button(t.close, close)],
+        onCancel: close,
+      ));
+}
+
+/// The logged-in devices dialog's content: the list, fetched again after each logout.
+class _HjvKeysPanel extends StatefulWidget {
+  final HjvTexts t;
+  const _HjvKeysPanel({required this.t});
+
+  @override
+  State<_HjvKeysPanel> createState() => _HjvKeysPanelState();
+}
+
+class _HjvKeysPanelState extends State<_HjvKeysPanel> {
+  (List<HjvKey>, List<HjvKey>)? _keys;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  Future<void> _load() async {
+    try {
+      final keys = await _getKeys();
+      if (mounted) setState(() => _keys = keys);
+    } catch (e) {
+      final text = e is _HjvError ? e.text : hjvFailure(widget.t, e);
+      if (mounted) setState(() => _error = text);
+    }
+  }
+
+  void _reload() {
+    if (!mounted) return;
+    setState(() {
+      _keys = null;
+      _error = null;
+    });
+    _load();
+  }
+
+  void _ask(
+      {String? title,
+      required String text,
+      required String yes,
+      required Future<void> Function() action}) {
+    _show<void>((setState, close, context) => hjvConfirmDialog(widget.t,
+            title: title, text: text, yes: yes, onYes: () async {
+          close();
+          await action();
+          _reload();
+        }, onNo: close));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final t = widget.t;
+    final both = _keys;
+    if (both == null) {
+      return _error == null
+          ? const LinearProgressIndicator()
+          : Text(_error ?? '');
+    }
+    final (keys, ended) = both;
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.end,
+      children: [
+        HjvKeysList(
+            t: t,
+            keys: keys,
+            ended: ended,
+            onLogOut: (k) => _ask(
+                title: hjvDeviceName(k),
+                text: t.logOutDeviceAsk,
+                yes: t.logOutDevice,
+                action: () => _keyRequest(
+                    t, 'DELETE', '/api/hjv/keys/${k.ckid}',
+                    done: (_) => t.loggedOutDevice))),
+        if (keys.any((k) => !k.current))
+          _button(
+                  t.logOutOthers,
+                  () => _ask(
+                      text: t.logOutOthersAsk,
+                      yes: t.logOutOthers,
+                      action: () =>
+                          _keyRequest(t, 'POST', '/api/hjv/keys/revoke-others',
+                              done: (body) {
+                            final n = body is Map ? body['revoked'] : null;
+                            return t.loggedOutOthers(n is int ? n : 0);
+                          })),
+                  outline: true)
+              .marginOnly(top: 8),
+      ],
+    );
+  }
+}
+
+void _removeFromList(HjvTexts t, Peer peer) {
+  final name = peer.alias.isNotEmpty
+      ? peer.alias
+      : peer.hostname.isNotEmpty
+          ? peer.hostname
+          : formatID(peer.id);
+  _show<void>((setState, close, context) => hjvConfirmDialog(t,
+          title: name, text: t.removeAsk, yes: t.remove, onYes: () async {
+        close();
+        try {
+          final (code, body) =
+              await _request('DELETE', '/api/hjv/devices/${peer.id}');
+          showToast(code == 200
+              ? t.removed
+              : code == 404
+                  ? t.notInList
+                  : hjvRequestError(t, body));
+        } catch (e) {
+          showToast(hjvFailure(t, e));
+        }
+        gFFI.groupModel.pull();
+      }, onNo: close));
+}
+
+Widget _banner(BuildContext context, String text, {VoidCallback? retry}) {
+  final error = retry != null;
+  return Container(
+    color: error ? MyTheme.color(context).errorBannerBg : null,
+    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
+    child: Row(
+      children: [
+        Icon(error ? Icons.info : Icons.info_outline,
+                color: error ? const Color.fromARGB(255, 249, 81, 81) : null,
+                size: 20)
+            .marginOnly(right: 6),
+        Expanded(child: SelectableText(text)),
+        if (retry != null) TextButton(onPressed: retry, child: Text(_t.retry)),
+      ],
+    ),
+  ).marginOnly(bottom: 12);
+}
