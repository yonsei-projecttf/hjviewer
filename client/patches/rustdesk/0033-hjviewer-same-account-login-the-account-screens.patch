+/// The request that `http_request` refuses while the account key cannot be used (H13): its
+/// answer reads this instead of a response.
+const kHjvKeyUnavailable = 'hjv: account key unavailable';
+
+/// What hjv-api's answer says went wrong: its own text, or a general one.
+String hjvRequestError(HjvTexts t, Object? body) {
+  final error = body is Map ? body['error'] : null;
+  return error is String && error.isNotEmpty ? error : t.requestFailed;
+}
+
+/// What a request that never got an answer shows.
+String hjvFailure(HjvTexts t, Object error) =>
+    error.toString().contains(kHjvKeyUnavailable)
+        ? t.keyLocked
+        : t.requestFailed;
