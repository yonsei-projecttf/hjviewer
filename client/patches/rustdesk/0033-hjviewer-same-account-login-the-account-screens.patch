+// ---- notices when the app starts or comes back ----
+
+var _reloginShown = false;
+
+/// The login was dropped because this device has no account key for it (a restored iPhone,
+/// design v3 §1-1): told once, the flag cleared when the notice was closed.
+void _announceRelogin() {
+  if (_reloginShown || _commonSync('hjv-relogin') != 'Y') return;
+  _reloginShown = true;
+  final t = _t;
+  gFFI.dialogManager
+      .show<void>((setState, close, context) => CustomAlertDialog(
+            title: Text(t.reloginTitle),
+            content: Text(t.reloginBody),
+            actions: [
+              _button(t.close, close, outline: true),
+              _button(t.logIn, () {
+                close();
+                loginDialog();
+              }),
+            ],
+            onCancel: close,
+          ))
+      .then((_) => bind.mainSetCommon(key: 'hjv-relogin', value: ''))
+      .catchError((Object e) => debugPrint('hjv: $e'))
+      .whenComplete(() => _reloginShown = false);
+}
+
+/// The keys this app answered or is showing the new-device notice of.
+final _answered = <int>{};
+var _announcing = false;
+
+Future<void> _announceNewDevices() async {
+  if (_announcing || !gFFI.userModel.isLogin) return;
+  _announcing = true;
+  try {
+    final t = _t;
+    final (keys, ended) = await _getKeys();
+    final own = keys.where((k) => k.current).firstOrNull?.ckid;
+    for (final k in hjvNewDevices(keys, _answered, ended)) {
+      _answered.add(k.ckid);
+      await _show<void>((setState, close, context) => hjvNewDeviceDialog(t, k,
+              beforeThis: own != null && k.ckid < own, onMine: () {
+            close();
+            _keyRequest(t, 'POST', '/api/hjv/keys/${k.ckid}/ack');
+          }, onNotMine: () {
+            close();
+            _keyRequest(t, 'POST', '/api/hjv/keys/${k.ckid}/not-mine',
+                done: (body) => body is Map && body['revoked'] == false
+                    ? t.notMineEndedDone
+                    : t.notMineDone);
+          }));
+    }
+  } catch (e) {
+    debugPrint('hjv: new devices: $e');
+  } finally {
+    _announcing = false;
+  }
+}
+
+class _HjvForeground with WidgetsBindingObserver {
+  DateTime? _last;
+
+  void start() {
+    _last = DateTime.now();
+    _announceRelogin();
+    unawaited(_announceNewDevices());
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state != AppLifecycleState.resumed) return;
+    final now = DateTime.now();
+    if (!hjvRefreshDue(_last, now)) return;
+    _last = now;
+    _announceRelogin();
+    if (!gFFI.userModel.isLogin) return;
+    if (gFFI.userModel.networkError.isNotEmpty) {
+      gFFI.userModel.refreshCurrentUser();
+    } else {
+      gFFI.groupModel.pull(force: true, quiet: true);
+    }
+    unawaited(_announceNewDevices());
+  }
+}
