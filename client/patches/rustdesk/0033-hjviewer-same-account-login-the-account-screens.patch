+/// The notice of a device of the account that nobody answered yet (design v3 §1-1, U1-a, U1-c):
+/// it waits for an answer, also for a device that logged in before this one (`beforeThis`) or
+/// whose login ended since.
+CustomAlertDialog hjvNewDeviceDialog(HjvTexts t, HjvKey key,
+        {required VoidCallback onMine,
+        required VoidCallback onNotMine,
+        bool beforeThis = false,
+        HjvClock local = hjvLocal}) =>
+    CustomAlertDialog(
+      title: Text(hjvNewDeviceTitle(t, key, beforeThis: beforeThis)),
+      content: Text(hjvNewDeviceText(t, key, local: local)),
+      actions: [
+        _button(key.ended == null ? t.notMine : t.notMineEnded, onNotMine,
+            outline: true),
+        _button(t.itsMine, onMine),
+      ],
