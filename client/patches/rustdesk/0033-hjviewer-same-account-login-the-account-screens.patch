+class HjvKey {
+  final int ckid;
+
+  /// the server's name of the device; `appName` is the device's own
+  final String name;
+  final String appName;
+
+  /// windows, ios, android, …: an iPhone's own name is its model code, which `name` already reads
+  final String platform;
+  final String appVer;
+
+  /// on-campus, off-campus or ""
+  final String net;
+  final int lastLogin;
+  final int? lastUsed;
+  final String? lastUsedPc;
+  final List<HjvKeyUse> uses;
+  final bool current;
+  final bool isNew;
+
+  /// when its login ended (null while it is logged in), how (`logout`, `removed`, `expired`,
+  /// `replaced`, `evicted`, `admin`) and, for `removed`, the device that logged it out (U1-b)
+  final int? ended;
+  final String left;
+  final HjvKey? leftBy;
+  const HjvKey(
+      {required this.ckid,
+      this.name = '',
+      this.appName = '',
+      this.platform = '',
+      this.appVer = '',
+      this.net = '',
+      this.lastLogin = 0,
+      this.lastUsed,
+      this.lastUsedPc,
+      this.uses = const [],
+      this.current = false,
+      this.isNew = false,
+      this.ended,
+      this.left = '',
+      this.leftBy});
+
+  static HjvKey? fromJson(Object? json) {
+    if (json is! Map) return null;
+    final ckid = json['ckid'];
+    if (ckid is! int) return null;
+    String text(String key) => json[key] is String ? json[key] as String : '';
+    int number(Object? v) => v is int ? v : 0;
+    final uses = json['use'] is List
+        ? (json['use'] as List)
+            .whereType<Map>()
+            .map((u) => HjvKeyUse(
+                u['pc_id'] is String ? u['pc_id'] as String : '',
+                u['pc'] is String ? u['pc'] as String : '',
+                number(u['last']),
+                number(u['n30'])))
+            .toList()
+        : <HjvKeyUse>[];
+    return HjvKey(
+        ckid: ckid,
+        name: text('name'),
+        appName: text('app_name'),
+        platform: text('platform'),
+        appVer: text('app_ver'),
+        net: text('net'),
+        lastLogin: number(json['last_login']),
+        lastUsed: json['last_used'] is int ? json['last_used'] as int : null,
+        lastUsedPc: json['last_used_pc'] is String
+            ? json['last_used_pc'] as String
+            : null,
+        uses: uses,
+        current: json['current'] == true,
+        isNew: json['new'] == true,
+        ended: json['ended'] is int ? json['ended'] as int : null,
+        left: text('left'),
+        leftBy: HjvKey.fromJson(json['left_by']));
+  }
+}
+
+/// The keys of `{"total":n,"data":[…]}`.
+List<HjvKey> hjvKeys(Object? body) {
+  final data = body is Map ? body['data'] : null;
+  if (data is! List) return [];
+  return data.map(HjvKey.fromJson).whereType<HjvKey>().toList();
+}
+
+/// The keys of the same answer's `"ended":[…]`, those that ended in the last 30 days (U1-b).
+List<HjvKey> hjvEndedKeys(Object? body) {
+  final data = body is Map ? body['ended'] : null;
+  if (data is! List) return [];
+  return data
+      .map(HjvKey.fromJson)
+      .whereType<HjvKey>()
+      .where((k) => k.ended != null)
+      .toList();
+}
+
+/// The server's name of a device and, in parentheses, the name the device gave itself (§1-1);
+/// an iPhone's is its model code, the server's name already says it.
+String hjvDeviceName(HjvKey k) {
+  final name = k.name.isEmpty ? k.appName : k.name;
+  return k.appName.isNotEmpty && k.appName != name && k.platform != 'ios'
+      ? '$name (${k.appName})'
+      : name;
+}
+
+String hjvKeyTitle(HjvTexts t, HjvKey k) =>
+    k.current ? '${hjvDeviceName(k)} · ${t.thisDevice}' : hjvDeviceName(k);
+
+String _net(HjvTexts t, String net) => switch (net) {
+      'on-campus' => t.onCampus,
+      'off-campus' => t.offCampus,
+      _ => '',
+    };
+
+/// How a key ended, "10/20 15:10 스스로 로그아웃", or "" while it is logged in.
+String hjvLeft(HjvTexts t, HjvKey k, {HjvClock local = hjvLocal}) {
+  final ended = k.ended;
+  if (ended == null) return '';
+  final by = k.leftBy;
+  return t.leftAt(
+      k.left, hjvTime(local(ended)), by == null ? '' : hjvDeviceName(by));
+}
+
+/// "로그인 10/20 14:03(학외) · 1.6.0 · 마지막 비밀번호 없는 연결 10/21 연구실-PC", and for a key that
+/// ended, how it ended.
+String hjvKeyLine(HjvTexts t, HjvKey k, {HjvClock local = hjvLocal}) {
+  final parts = [
+    t.loggedInAt(hjvTime(local(k.lastLogin)), _net(t, k.net)),
+    if (k.appVer.isNotEmpty) k.appVer,
+    if (k.lastUsed != null)
+      t.lastUse(hjvDay(local(k.lastUsed!)), k.lastUsedPc ?? ''),
+    if (k.ended != null) hjvLeft(t, k, local: local),
+  ];
+  return parts.join(' · ');
+}
+
+/// A line of the opened row (U6): "연구실-PC · 마지막 10/21 14:03 · 30일 동안 12번".
+String hjvUseLine(HjvTexts t, HjvKeyUse u, {HjvClock local = hjvLocal}) =>
+    t.useLine(u.pc.isEmpty ? u.pcId : u.pc, hjvTime(local(u.last)), u.n30);
+
+/// The keys the new-device notice is for (design v3 §1-1, U1-a, U1-c): the server's `new`, every
+/// key of the account but this device's, logged in or `ended`, whatever order they were made in,
+/// until a device answered it; not this device's, and not answered here yet.
+List<HjvKey> hjvNewDevices(List<HjvKey> keys, Set<int> answered,
+        [List<HjvKey> ended = const []]) =>
+    [...keys, ...ended]
+        .where((k) => k.isNew && !k.current && !answered.contains(k.ckid))
+        .toList();
+
+/// The notice's title: a device that logged in after this one, one that logged in before it
+/// (which this device had not answered), or one whose login ended before anyone answered.
+String hjvNewDeviceTitle(HjvTexts t, HjvKey k, {bool beforeThis = false}) =>
+    k.ended != null
+        ? t.endedDeviceTitle
+        : beforeThis
+            ? t.earlierDeviceTitle
+            : t.newDeviceTitle;
+
+/// "iPhone 14 Pro · 10/20 14:03 · 학외 네트워크 · HJViewer 1.6.0. 이 기기로 …": the login's time and
+/// network, and what the device said of itself (its name in parentheses); for a key that ended,
+/// how and its last password-less connection.
+String hjvNewDeviceText(HjvTexts t, HjvKey k, {HjvClock local = hjvLocal}) {
+  final net = switch (k.net) {
+    'on-campus' => t.onCampusNet,
+    'off-campus' => t.offCampusNet,
+    _ => '',
+  };
+  final seen = [
+    hjvDeviceName(k),
+    hjvTime(local(k.lastLogin)),
+    if (net.isNotEmpty) net,
+    if (k.appVer.isNotEmpty) 'HJViewer ${k.appVer}',
+  ].join(' · ');
+  if (k.ended == null) return '$seen. ${t.newDeviceNote}';
+  final how = [
+    hjvLeft(t, k, local: local),
+    if (k.lastUsed != null)
+      t.lastUse(hjvDay(local(k.lastUsed!)), k.lastUsedPc ?? ''),
+  ].join(' · ');
+  return '$seen. $how. ${t.endedDeviceNote}';
+}
+
+// ---- the accessible devices tab (design v3 §1-1, §1-3) ----
+
+/// The banner over the kept cards while the server fails: the server's own text when it gave one
+/// (a clock off by more than ten minutes), else what a failed request means.
+String hjvServerBanner(HjvTexts t,
+    {required String error, required bool fromServer}) {
+  if (fromServer && error.isNotEmpty) return error;
+  if (error.contains(kHjvKeyUnavailable)) return t.keyLocked;
+  return t.serverDown;
+}
+
+/// Whether the empty tab tells how a PC gets there: the list came (`pulled`: a fetch since the
+/// login or the app's start ended), without an error, and is empty.
+bool hjvShowsEmptyHint(
+        {required bool pulled,
+        required bool loading,
+        required bool empty,
+        required String networkError,
+        required String loadError}) =>
+    pulled && !loading && empty && networkError.isEmpty && loadError.isEmpty;
+
+/// Whether an accessible device's card offers "내 목록에서 빼기": the account's PCs in an account
+/// build, while logged in.
+bool hjvShowsDeviceMenu({required bool accountBuild, required bool loggedIn}) =>
+    accountBuild && loggedIn;
