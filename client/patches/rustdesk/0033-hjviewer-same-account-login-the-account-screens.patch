+
+// The account screens' texts and choices (design v3 §7-5), without the bridge.
+
+const ko = HjvTexts(true);
+const en = HjvTexts(false);
+
+int unix(DateTime t) => t.millisecondsSinceEpoch ~/ 1000;
+DateTime utc(int s) =>
+    DateTime.fromMillisecondsSinceEpoch(s * 1000, isUtc: true);
+final oct20 = unix(DateTime.utc(2026, 10, 20, 14, 3));
+final oct21 = unix(DateTime.utc(2026, 10, 21, 14, 3));
+
+(String, HjvPcAction)? pcLine(String state, HjvOwner owner, {HjvTexts t = ko}) {
+  final line = hjvPcLine(t, HjvPcState.parse(state), owner, local: utc);
+  return line == null ? null : (line.text, line.action);
+}
+
+HjvLoginNotice? notice(
+        {bool installed = true,
+        String? status = 'added',
+        bool undo = true,
+        bool bound = true,
+        String state = 'active 3 1',
+        bool passwordSet = true}) =>
+    hjvLoginNotice(ko,
+        installed: installed,
+        status: status,
+        undo: undo,
+        boundByLogin: bound,
+        state: HjvPcState.parse(state),
+        passwordSet: passwordSet);
+
+/// `GET /api/hjv/keys` as hjv-api answers it (server/api/src/keys.rs key_json).
+Map<String, Object?> keysAnswer() => {
+      'total': 3,
+      'data': [
+        {
+          'ckid': 14,
+          'name': 'Windows PC',
