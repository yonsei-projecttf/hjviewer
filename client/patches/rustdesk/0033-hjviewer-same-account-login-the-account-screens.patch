@@ -0,0 +1,233 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjviewer_account.dart';
+import 'package:flutter_hbb/common/hjviewer_account_texts.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The account screens' widgets (design v3 §7-5); they import common.dart, so these tests need the
+// generated bridge, which client-build.yml makes before its Dart tests.
+
+const ko = HjvTexts(true);
+
+int unix(DateTime t) => t.millisecondsSinceEpoch ~/ 1000;
+DateTime utc(int s) =>
+    DateTime.fromMillisecondsSinceEpoch(s * 1000, isUtc: true);
+final oct20 = unix(DateTime.utc(2026, 10, 20, 14, 3));
+final oct21 = unix(DateTime.utc(2026, 10, 21, 14, 3));
+
+/// CustomAlertDialog asks for the focus in a zero timer on each build: let the last one run.
+Future<void> settle(WidgetTester tester) async {
+  await tester.pumpAndSettle();
+  await tester.pump(const Duration(milliseconds: 10));
+}
+
+Future<void> show(WidgetTester tester, Widget child) async {
+  await tester.pumpWidget(
+      MaterialApp(home: Scaffold(body: SingleChildScrollView(child: child))));
+  await tester.pump();
+}
+
+void main() {
+  testWidgets(
+      'the logged-in devices: an opened row shows the PCs it opened, and other devices log out',
+      (tester) async {
+    final out = <int>[];
+    final keys = [
+      HjvKey(
+          ckid: 12,
+          name: 'iPhone 14 Pro',
+          appName: 'iPhone15,2',
+          platform: 'ios',
+          appVer: '1.6.0',
+          net: 'off-campus',
+          lastLogin: oct20,
+          lastUsed: oct21,
+          lastUsedPc: '연구실-PC',
+          uses: [HjvKeyUse('123456789', '연구실-PC', oct21, 12)]),
+      HjvKey(
+          ckid: 11,
+          name: 'Windows PC',
+          appName: '연구실-PC',
+          platform: 'windows',
+          appVer: '1.6.0',
+          lastLogin: oct20,
+          current: true),
+    ];
+    await show(
+        tester,
+        HjvKeysList(
+            t: ko, keys: keys, onLogOut: (k) => out.add(k.ckid), local: utc));
+
+    expect(find.text('iPhone 14 Pro'), findsOneWidget);
+    expect(
+        find.text('로그인 10/20 14:03(학외) · 1.6.0 · 마지막 비밀번호 없는 연결 10/21 연구실-PC'),
+        findsOneWidget);
+    expect(find.text('Windows PC (연구실-PC) · 이 기기'), findsOneWidget);
+    // the device in use has no [로그아웃시키기]
+    expect(find.text('로그아웃시키기'), findsOneWidget);
+    expect(find.text('연구실-PC · 마지막 10/21 14:03 · 30일 동안 12번'), findsNothing);
+
+    await tester.tap(find.text('iPhone 14 Pro'));
+    await tester.pumpAndSettle();
+    expect(find.text('연구실-PC · 마지막 10/21 14:03 · 30일 동안 12번'), findsOneWidget);
+
+    await tester.tap(find.text('Windows PC (연구실-PC) · 이 기기'));
+    await tester.pumpAndSettle();
+    expect(find.text('최근 30일 동안 비밀번호 없이 연결한 PC가 없습니다.'), findsOneWidget);
+
+    await tester.tap(find.text('로그아웃시키기'));
+    await tester.pump();
+    expect(out, [12]);
+  });
+
+  testWidgets(
+      'the devices whose login ended stay listed for 30 days, without [로그아웃시키기] (U1-b)',
+      (tester) async {
+    final keys = [
+      HjvKey(ckid: 11, name: 'Windows PC', lastLogin: oct20, current: true),
+    ];
+    final ended = [
+      HjvKey(
+          ckid: 12,
+          name: 'iPhone 14 Pro',
+          platform: 'ios',
+          lastLogin: oct20,
+          ended: oct21,
+          left: 'removed',
+          leftBy: const HjvKey(ckid: 11, name: 'Windows PC')),
+    ];
+    await show(
+        tester,
+        HjvKeysList(
+            t: ko, keys: keys, ended: ended, onLogOut: (_) {}, local: utc));
+    expect(find.text('최근 30일 동안 로그아웃된 기기'), findsOneWidget);
+    expect(find.text('로그인 10/20 14:03 · 10/21 14:03 Windows PC에서 로그아웃시킴'),
+        findsOneWidget);
+    expect(find.text('로그아웃시키기'), findsNothing);
+  });
+
+  testWidgets(
+      'this PC: [다시 켜기] only when switched off here, and each button asks for its action',
+      (tester) async {
+    final actions = <HjvPcAction>[];
+    var setPassword = 0;
+    Widget lines(String state, {bool? passwordSet, bool canSet = true}) =>
+        HjvPcLines(
+            key: UniqueKey(),
+            t: ko,
+            line: hjvPcLine(ko, HjvPcState.parse(state), HjvOwner.mine,
+                local: utc)!,
+            passwordSet: passwordSet,
+            canSetPassword: canSet,
+            onAction: actions.add,
+            onSetPassword: () => setPassword++);
+
+    await show(tester, lines('off', passwordSet: false));
+    expect(find.text('이 PC: 내 기기 · 이 PC에서 꺼 둠'), findsOneWidget);
+    await tester.tap(find.text('다시 켜기'));
+    expect(actions, [HjvPcAction.turnOn]);
+    expect(find.text('PC 비밀번호: 없음'), findsOneWidget);
+    await tester.tap(find.text('정하기'));
+    expect(setPassword, 1);
+
+    await show(tester, lines('active 3 $oct20', passwordSet: true));
+    expect(find.text('이 PC: 내 기기 · 비밀번호 없이 연결 켜짐(내 기기 3대)'), findsOneWidget);
+    expect(find.text('다시 켜기'), findsNothing);
+    await tester.tap(find.text('끄기'));
+    expect(actions, [HjvPcAction.turnOn, HjvPcAction.turnOff]);
+    expect(find.text('PC 비밀번호: 정해 둠'), findsOneWidget);
+    expect(find.text('정하기'), findsNothing);
+
+    await show(tester, lines('disabled', passwordSet: false, canSet: false));
+    expect(find.text('이 PC: 내 기기 · 관리자가 일시 중지함'), findsOneWidget);
+    expect(find.byType(OutlinedButton), findsNothing);
+
+    // while the PC password is being asked, no line for it
+    await show(tester, lines('revoked'));
+    expect(find.text('PC 비밀번호: 없음'), findsNothing);
+    await tester.tap(find.text('다시 추가'));
+    expect(actions.last, HjvPcAction.addAgain);
+  });
+
+  testWidgets('the notice after a login offers [이 PC 빼기] and [지금 정하기]',
+      (tester) async {
+    var ok = 0, undo = 0, password = 0;
+    final notice = hjvLoginNotice(ko,
+        installed: true,
+        status: 'added',
+        undo: true,
+        boundByLogin: true,
+        state: HjvPcState.parse('active 2 1'),
+        passwordSet: false)!;
+    await show(
+        tester,
+        hjvLoginNoticeDialog(ko, notice,
+            onOk: () => ok++,
+            onUndo: () => undo++,
+            onSetPassword: () => password++));
+    expect(find.text('이 PC를 내 기기 목록에 추가했습니다'), findsOneWidget);
+    expect(find.text('비밀번호 없는 연결이 안 될 때(서버 점검, 끄기, 로그아웃) 쓸 PC 비밀번호를 정해 두세요.'),
+        findsOneWidget);
+    await tester.tap(find.text('지금 정하기'));
+    await tester.tap(find.text('이 PC 빼기'));
+    await tester.tap(find.text('확인'));
+    expect((ok, undo, password), (1, 1, 1));
+
+    await show(tester, hjvLoginNoticeDialog(ko, notice, onOk: () => ok++));
+    expect(find.text('이 PC 빼기'), findsNothing);
+    expect(find.text('지금 정하기'), findsNothing);
+    await settle(tester);
+  });
+
+  testWidgets('the new-device notice is answered with its two buttons',
+      (tester) async {
+    final answers = <String>[];
+    final key = HjvKey(
+        ckid: 12,
+        name: 'iPhone 14 Pro',
+        appName: 'iPhone15,2',
+        platform: 'ios',
+        appVer: '1.6.0',
+        net: 'off-campus',
+        lastLogin: oct20,
+        isNew: true);
+    await show(
+        tester,
+        hjvNewDeviceDialog(ko, key,
+            onMine: () => answers.add('mine'),
+            onNotMine: () => answers.add('not mine'),
+            local: utc));
+    expect(find.text('새 기기에서 로그인했습니다'), findsOneWidget);
+    expect(
+        find.text('iPhone 14 Pro · 10/20 14:03 · 학외 네트워크 · HJViewer 1.6.0. '
+            '이 기기로 내 PC에 비밀번호 없이 연결할 수 있습니다. 내가 로그인한 것이 아니면 [아님]을 누르세요.'),
+        findsOneWidget);
+    await tester.tap(find.text('아님: 로그아웃시키기'));
+    await tester.tap(find.text('내 기기 맞음'));
+    expect(answers, ['not mine', 'mine']);
+    await settle(tester);
+  });
+
+  testWidgets(
+      'the notice of a device that logged out before an answer still asks (U1-a)',
+      (tester) async {
+    final answers = <String>[];
+    final key = HjvKey(
+        ckid: 12,
+        name: 'iPhone 14 Pro',
+        platform: 'ios',
+        lastLogin: oct20,
+        isNew: true,
+        ended: oct21,
+        left: 'logout');
+    await show(
+        tester,
+        hjvNewDeviceDialog(ko, key,
+            onMine: () => answers.add('mine'),
+            onNotMine: () => answers.add('not mine'),
+            local: utc));
+    expect(find.text('로그인했던 기기를 확인해 주세요'), findsOneWidget);
+    await tester.tap(find.text('아님'));
+    expect(answers, ['not mine']);
+    await settle(tester);
+  });
+}
