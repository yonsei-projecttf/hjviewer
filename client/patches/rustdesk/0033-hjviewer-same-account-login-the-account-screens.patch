+// HJViewer's account screens (design v3 §1, §6-2 D1-D10): what the login and logout dialogs, the
+// accessible devices tab, its cards' menu and Settings → Account show in an account build, the
+// logged-in devices and the notices about new devices and dropped logins. Account requests go
+// through Rust's http_request, which signs them with the account key (H13); the texts and the
+// choices between them are in hjviewer_account_texts.dart. Outside an account build every hook
+// leaves its screen as it was.
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/formatter/id_formatter.dart';
+import 'package:flutter_hbb/common/hjviewer_account_texts.dart';
+import 'package:flutter_hbb/common/widgets/dialog.dart';
+import 'package:flutter_hbb/common/widgets/login.dart';
+import 'package:flutter_hbb/consts.dart';
+import 'package:flutter_hbb/desktop/pages/desktop_home_page.dart';
+import 'package:flutter_hbb/desktop/widgets/popup_menu.dart';
+import 'package:flutter_hbb/desktop/widgets/tabbar_widget.dart';
+import 'package:flutter_hbb/models/peer_model.dart';
+import 'package:flutter_hbb/models/peer_tab_model.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:flutter_hbb/utils/http_service.dart' as http;
+import 'package:get/get.dart';
+import 'package:settings_ui/settings_ui.dart';
+
+/// The service's state of this PC (Config2, design v3 §4-5), which the UI gets every second.
+const _kPcState = 'hjv-pwless-state';
+
+/// The service's request to switch password-less connections off on this PC (design v3 §2-3).
+const _kPcOff = 'hjv-pwless-off';
+
+/// Set once the first login took the app to the accessible devices tab.
+const _kDevicesTabShown = 'hjv-devices-tab-shown';
+
+String _commonSync(String key) {
+  try {
+    return bind.mainGetCommonSync(key: key);
+  } catch (e) {
+    return '';
+  }
+}
+
+/// An account build (design v3 §6-5): HJV_SERVER, HJV_LOGIN_SEAL_PUBKEY and HJV_TRUST_PUBKEYS.
+final bool _accountBuild = !isWeb && _commonSync('hjv-account') == 'Y';
+
+/// The texts in the language of the app's own: Korean when translate() gives its Korean words,
+/// which follows the app's language setting, else the system's, and English where the UI cannot
+/// show Korean (src/lang.rs).
+HjvTexts get _t => HjvTexts(translate('Cancel') == '취소');
+
+class _HjvError implements Exception {
+  final String text;
+  _HjvError(this.text);
+
+  @override
+  String toString() => text;
+}
+
+/// A request to hjv-api, with the login's token: the status and the decoded body. A 401 ends the
+/// login as the device list's does (the key was logged out from another device), unless a login
+/// replaced the token meanwhile (hjvEndsLogin).
+Future<(int, Object?)> _request(String method, String path) async {
+  final url = Uri.parse('${await bind.mainGetApiServer()}$path');
+  final headers = getHttpHeaders();
+  final resp = switch (method) {
+    'POST' => await http.post(url, headers: headers),
+    'DELETE' => await http.delete(url, headers: headers),
+    _ => await http.get(url, headers: headers),
+  };
+  Object? body;
+  try {
+    body = jsonDecode(decode_http_response(resp));
+  } catch (e) {
+    body = null;
+  }
+  if (hjvEndsLogin(resp.statusCode,
+      sent: headers['Authorization'],
+      kept: getHttpHeaders()['Authorization'])) {
+    await gFFI.userModel.reset(resetOther: true);
+  }
+  return (resp.statusCode, body);
+}
+
+/// Shows a dialog; a dialog that cannot be shown yet (no overlay) is left out.
+Future<T?> _show<T>(DialogBuilder builder) =>
+    gFFI.dialogManager.show<T>(builder).catchError((Object e) {
+      debugPrint('hjv: $e');
+      return null;
+    });
+
+/// A button as dialogButton() draws it, for a text of these screens, which translate() must not
+/// see.
+Widget _button(String label, VoidCallback? onPressed, {bool outline = false}) {
+  if (isDesktop || isWebDesktop) {
+    return outline
+        ? OutlinedButton(onPressed: onPressed, child: Text(label))
+        : ElevatedButton(
+            style: ElevatedButton.styleFrom(elevation: 0),
+            onPressed: onPressed,
+            child: Text(label));
+  }
+  return TextButton(onPressed: onPressed, child: Text(label));
+}
+
+// ---- the hooks ----
+
+/// D1 (login.dart): the login dialog's first field takes the Yonsei portal ID.
+String hjvUsernameTitle() => _accountBuild
+    ? _t.usernameTitle
+    : translate(DialogTextField.kUsernameTitle);
+
+/// D2 (login.dart, after the login dialog closed): after a login, the first one takes the app to
+/// the accessible devices tab, and a Windows PC tells what the login did with it (design v3 §1-1,
+/// §1-2). Returns at once; the notice comes when the service has taken the login.
+void hjvAfterLogin(bool? res) {
+  if (!_accountBuild || res != true || !gFFI.userModel.isLogin) return;
+  _showDevicesTabOnce();
+  if (isWindows) unawaited(_announceThisPc());
+}
+
+/// D3 (login.dart): the logout dialog's text.
+String hjvLogoutTip(String tip) => _accountBuild
+    ? hjvLogoutText(_t, tip, boundHere: _commonSync('hjv-pc-bound') == 'Y')
+    : tip;
+
+/// D5 (peer_card.dart, the accessible devices' menu): "내 목록에서 빼기".
+Future<List<MenuEntryBase<String>>> hjvDeviceMenuItems(
+    BuildContext context, Peer peer, EdgeInsets? padding) async {
+  if (!hjvShowsDeviceMenu(
+      accountBuild: _accountBuild, loggedIn: gFFI.userModel.isLogin)) {
+    return [];
+  }
+  final t = _t;
+  return [
+    MenuEntryDivider(),
+    MenuEntryButton<String>(
+      childBuilder: (TextStyle? style) =>
+          Text(t.removeFromList, style: style?.copyWith(color: Colors.red)),
+      proc: () => _removeFromList(t, peer),
+      padding: padding,
+      dismissOnClicked: true,
+    ),
+  ];
+}
+
+/// D6 (toolbar.dart, the settings): hjv-api keeps no notes of sessions.
+bool hjvHidesNotes() => _accountBuild;
+
+/// D7 (desktop settings, the account card): this PC, its PC password, the logged-in devices.
+List<Widget> hjvAccountRows() =>
+    _accountBuild ? [const _HjvAccountPanel()] : [];
+
+/// D8 (mobile settings, the account section): the logged-in devices.
+List<AbstractSettingsTile> hjvAccountTiles() => _accountBuild
+    ? [
+        CustomSettingsTile(
+            child: Obx(() => SettingsTile(
+                  title: Text(_t.loggedInDevices),
+                  leading: const Icon(Icons.devices),
+                  enabled: gFFI.userModel.isLogin,
+                  onPressed: (_) => _showLoggedInDevices(),
+                ))),
+      ]
+    : [];
+
+/// D9 (my_group.dart): while hjv-api fails, the cards the app kept stay on screen (design v3 §1-3).
+bool hjvKeepCachedCards() => _accountBuild;
+
+/// D9: above the cards, why the server cannot be used, with [재시도], or, when the account has no
+/// PC yet, how one gets there.
+List<Widget> hjvNetworkBanner(BuildContext context) {
+  if (!_accountBuild) return [];
+  final user = gFFI.userModel;
+  final group = gFFI.groupModel;
+  final error = user.networkError.value;
+  if (error.isNotEmpty) {
+    return [
+      _banner(
+          context,
+          hjvServerBanner(_t,
+              error: error, fromServer: user.networkErrorFromServer.value),
+          retry: user.refreshCurrentUser)
+    ];
+  }
+  if (hjvShowsEmptyHint(
+      pulled: group.initialized,
+      loading: group.groupLoading.value,
+      empty: group.peers.isEmpty,
+      networkError: error,
+      loadError: group.groupLoadError.value)) {
+    return [_banner(context, _t.emptyList)];
+  }
+  return [];
+}
+
+/// D10 (main.dart, the main window and the phone app): coming back to the front, at most every 30
+/// seconds, fetches the device list again quietly and looks for new devices of the account; a
+/// login dropped for want of its account key is told (design v3 §1-1, §1-3).
+void hjvInitAccount() {
+  if (!_accountBuild) return;
+  WidgetsBinding.instance.addObserver(_foreground);
+  gFFI.userModel.userName.listen((name) {
+    if (name.isEmpty) _announceRelogin();
+  });
+  WidgetsBinding.instance.addPostFrameCallback((_) => _foreground.start());
+}
+
+// ---- after a login ----
+
+void _showDevicesTabOnce() {
+  if (bind.getLocalFlutterOption(k: _kDevicesTabShown) == 'Y') return;
+  bind.setLocalFlutterOption(k: _kDevicesTabShown, v: 'Y');
+  final group = PeerTabIndex.group.index;
+  final tabs = gFFI.peerTabModel;
+  if (isOptionFixed(kOptionPeerTabIndex) ||
+      !tabs.visibleEnabledOrderedIndexs.contains(group)) {
+    return;
+  }
+  tabs.setCurrentTab(group);
+  bind.setLocalFlutterOption(k: kOptionPeerTabIndex, v: group.toString());
+  if (isMobile) {
+    final bar = navigationBarKey.currentWidget;
+    if (bar is BottomNavigationBar && !bind.isIncomingOnly()) {
+      bar.onTap?.call(0);
+    }
+  } else if (isDesktop) {
+    try {
+      Get.find<DesktopTabController>().jumpToByKey(kTabLabelHomePage);
+    } catch (e) {
+      debugPrint('hjv: no main tabs: $e');
+    }
+  }
+}
+
+HjvPcState _pcState() =>
+    HjvPcState.parse(bind.mainGetOptionSync(key: _kPcState));
+
+Future<bool> _permanentPasswordSet() async {
+  try {
+    return await bind.mainGetCommon(key: 'permanent-password-set') == 'true';
+  } catch (e) {
+    return false;
+  }
+}
+
+Future<(String?, bool)>? _thisDeviceInFlight;
+
+/// `GET /api/hjv/this-device`: what the login did with this device, and whether [이 PC 빼기] can
+/// undo it; the status is null when the request failed.
+Future<(String?, bool)> _thisDevice() => _thisDeviceInFlight ??= () async {
+      try {
+        final (code, body) = await _request('GET', '/api/hjv/this-device');
+        if (code != 200 || body is! Map) return (null, false);
+        final status = body['status'];
+        return (status is String ? status : null, body['undo'] == true);
+      } catch (e) {
+        debugPrint('hjv: this-device: $e');
+        return (null, false);
+      } finally {
+        _thisDeviceInFlight = null;
+      }
+    }();
+
+/// The notice on a Windows PC after a login (design v3 §1-2, §4-4): once the login is in the list,
+/// it waits up to ten seconds for the service to turn the PC on.
+Future<void> _announceThisPc() async {
+  final t = _t;
+  final installed = bind.mainIsInstalled();
+  final (status, undo) = installed ? await _thisDevice() : (null, false);
+  final bound = _commonSync('hjv-pc-bound') == 'Y';
+  var state = _pcState();
+  if (installed &&
+      (status == 'added' || status == 'already' || (status == null && bound))) {
+    final until = DateTime.now().add(kHjvTurnOnWait);
+    while (!hjvTurnedOn(state) && DateTime.now().isBefore(until)) {
+      await Future.delayed(const Duration(milliseconds: 500));
+      state = _pcState();
+    }
+  }
+  final canSet = installed && !isChangePermanentPasswordDisabled();
+  final notice = hjvLoginNotice(t,
+      installed: installed,
+      status: status,
+      undo: undo,
+      boundByLogin: bound,
+      state: state,
+      passwordSet: !canSet || await _permanentPasswordSet());
+  if (notice == null) return;
+  _show<void>((setState, close, context) => hjvLoginNoticeDialog(t, notice,
+      onOk: close,
+      onUndo: notice.undo
+          ? () {
+              close();
+              _undoThisPc(t);
+            }
+          : null,
+      onSetPassword: notice.askPassword
+          ? () {
+              close();
+              _setPcPassword();
+            }
+          : null));
+}
+
+/// [이 PC 빼기]: this login's adding is undone; the Rust hook stops the PC taking proofs at once.
+Future<void> _undoThisPc(HjvTexts t) async {
+  try {
+    final (code, body) = await _request('POST', '/api/hjv/this-device/undo');
+    final map = body is Map ? body : const {};
+    if (code == 200 && map['status'] == 'removed') {
+      showToast(t.removedThisPc);
+    } else {
+      final message = map['message'];
+      showToast(code == 200 && message is String && message.isNotEmpty
+          ? message
+          : hjvRequestError(t, body));
+    }
+  } catch (e) {
+    showToast(hjvFailure(t, e));
+  }
+}
+
+/// The security settings' permanent password dialog, behind the same Windows administrator check
+/// (or unlock PIN) as the locked settings of an installed PC.
+void _setPcPassword({VoidCallback? done}) {
+  void open() => setPasswordDialog(notEmptyCallback: done);
+  if (!bind.mainIsInstalled()) {
+    open();
+    return;
+  }
+  final pin = bind.mainGetUnlockPin();
+  if (pin.isEmpty || isUnlockPinDisabled()) {
+    callMainCheckSuperUserPermission().then((ok) {
+      if (ok) open();
+    });
+  } else {
+    checkUnlockPinDialog(pin, open);
+  }
+}
+
+// ---- this PC in the settings ----
+
+Future<void> _pcAction(HjvTexts t, HjvPcAction action) async {
+  switch (action) {
+    case HjvPcAction.turnOff:
+      _show<void>((setState, close, context) =>
+          hjvConfirmDialog(t, text: t.turnOffAsk, yes: t.turnOff, onYes: () {
+            close();
+            bind.mainSetOption(key: _kPcOff, value: 'Y');
+            showToast(t.turnedOff);
+          }, onNo: close));
+    case HjvPcAction.turnOn:
+    case HjvPcAction.logInAgain:
+      loginDialog();
+    case HjvPcAction.addAgain:
+      if (gFFI.userModel.isLogin) await gFFI.userModel.logOut();
+      loginDialog();
+    case HjvPcAction.none:
+      break;
+  }
+}
+
+class _HjvAccountPanel extends StatefulWidget {
+  const _HjvAccountPanel();
+
+  @override
+  State<_HjvAccountPanel> createState() => _HjvAccountPanelState();
+}
+
+class _HjvAccountPanelState extends State<_HjvAccountPanel> {
+  /// a desktop where HJViewer is installed: its service may hold this PC's binding
+  final bool _pc = isDesktop && bind.mainIsInstalled();
+  String _state = '';
+  String? _status;
+  bool? _passwordSet;
+  Timer? _timer;
+  StreamSubscription<String>? _user;
+
+  @override
+  void initState() {
+    super.initState();
+    if (!_pc) return;
+    _state = bind.mainGetOptionSync(key: _kPcState);
+    _timer = Timer.periodic(const Duration(seconds: 1), (_) {
+      final state = bind.mainGetOptionSync(key: _kPcState);
+      if (state != _state) setState(() => _state = state);
+    });
+    _loadStatus();
+    _loadPassword();
+    _user = gFFI.userModel.userName.listen((_) => _loadStatus());
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    _user?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _loadStatus() async {
+    final (status, _) =
+        gFFI.userModel.isLogin ? await _thisDevice() : (null, false);
+    if (mounted) setState(() => _status = status);
+  }
+
+  Future<void> _loadPassword() async {
+    final set = await _permanentPasswordSet();
+    if (mounted) setState(() => _passwordSet = set);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Obx(() {
+      final t = _t;
+      final loggedIn = gFFI.userModel.isLogin;
+      final line = _pc
+          ? hjvPcLine(
+              t,
+              HjvPcState.parse(_state),
+              hjvOwner(
+                  loggedIn: loggedIn,
