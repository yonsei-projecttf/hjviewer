diff --git a/flutter/lib/models/soft_keyboard_log.dart b/flutter/lib/models/soft_keyboard_log.dart
new file mode 100644
index 0000000..1443f14
--- /dev/null
+++ b/flutter/lib/models/soft_keyboard_log.dart
@@ -0,0 +1,76 @@
+import 'dart:collection';
+import 'dart:convert';
+
+import 'package:flutter/services.dart';
+
+import 'soft_keyboard_input.dart';
+
+/// The hidden field's value in short: the filler ('1') as F and its length,
+/// the last [maxTail] characters typed after it, the selection and the
+/// composing range.
+String describeSoftKeyboardValue(TextEditingValue value, {int maxTail = 24}) {
+  final text = value.text;
+  var filler = 0;
+  while (filler < text.length && text.codeUnitAt(filler) == 0x31) {
+    ++filler;
+  }
+  final tail = text.substring(filler).runes.toList();
+  final shown = tail.length > maxTail
+      ? '…${String.fromCharCodes(tail.sublist(tail.length - maxTail))}'
+      : String.fromCharCodes(tail);
+  final selection = value.selection;
+  final sel = !selection.isValid
+      ? '-'
+      : selection.isCollapsed
+          ? '${selection.baseOffset}'
+          : '${selection.baseOffset}-${selection.extentOffset}';
+  final composing = value.isComposingRangeValid
+      ? '${value.composing.start}-${value.composing.end}'
+      : '-';
+  return 'F$filler ${jsonEncode(shown)} sel $sel comp $composing';
+}
+
+/// An opt-in record of the hidden iOS field: each change, and the edit sent
+/// for it, to see what a keyboard does on a device. In memory only and only
+/// while on; it holds what was typed.
+class SoftKeyboardLog {
+  SoftKeyboardLog({this.capacity = 60});
+
+  final int capacity;
+  final _lines = Queue<String>();
+  final _clock = Stopwatch();
+
+  bool get on => _clock.isRunning;
+
+  String get text => _lines.join('\n');
+
+  void start() {
+    _lines.clear();
+    _clock
+      ..reset()
+      ..start();
+  }
+
+  void stop() {
+    _clock.stop();
+    _lines.clear();
+  }
+
+  void value(TextEditingValue value) =>
+      _add('v ${describeSoftKeyboardValue(value)}');
+
+  void edit(SoftKeyboardEdit? edit, {bool hotkey = false}) => _add(edit == null
+      ? '> wait'
+      : '> ${edit.backspaces} BS ${jsonEncode(edit.text)}'
+          '${hotkey ? ' (key-bar hotkey)' : ''}');
+
+  void note(String note) => _add('> $note');
+
+  void _add(String line) {
+    if (!on) return;
+    _lines.addLast('${_clock.elapsedMilliseconds.toString().padLeft(6)} $line');
+    while (_lines.length > capacity) {
+      _lines.removeFirst();
+    }
+  }
+}
diff --git a/flutter/test/soft_keyboard_log_test.dart b/flutter/test/soft_keyboard_log_test.dart
new file mode 100644
index 0000000..c135682
--- /dev/null
+++ b/flutter/test/soft_keyboard_log_test.dart
@@ -0,0 +1,37 @@
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/models/soft_keyboard_log.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  final filler = '1' * 1024;
+
+  test('a field value in short', () {
+    expect(
+        describeSoftKeyboardValue(TextEditingValue(
+            text: '$filler하',
+            selection: const TextSelection.collapsed(offset: 1025),
+            composing: const TextRange(start: 1024, end: 1025))),
+        'F1024 "하" sel 1025 comp 1024-1025');
+    expect(
+        describeSoftKeyboardValue(TextEditingValue(text: '${filler}abcdef\n'),
+            maxTail: 3),
+        r'F1024 "…ef\n" sel - comp -');
+  });
+
+  test('records only while on and keeps the last lines', () {
+    final log = SoftKeyboardLog(capacity: 2);
+    log.value(TextEditingValue(text: filler));
+    expect(log.text, isEmpty);
+    log.start();
+    log.value(TextEditingValue(text: '${filler}a'));
+    log.edit((backspaces: 1, text: '한'), hotkey: true);
+    log.edit(null);
+    final lines = log.text.split('\n');
+    expect(lines, hasLength(2));
+    expect(lines[0], endsWith('> 1 BS "한" (key-bar hotkey)'));
+    expect(lines[1], endsWith('> wait'));
+    log.stop();
+    expect(log.on, isFalse);
+    expect(log.text, isEmpty);
+  });
+}
