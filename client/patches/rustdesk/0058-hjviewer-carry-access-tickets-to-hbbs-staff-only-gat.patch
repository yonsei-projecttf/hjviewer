+#[test]
+fn a_desktop_apps_ticket_request_carries_its_id_and_key_signed_for_this_login() {
+    let (pk, sk) = sign::keypair_from_seed(&sign::Seed([2; 32]));
+    let device = Device {
+        id: ID.into(),
+        sk,
+        pk: pk.0.to_vec(),
+    };
+    let body: Value = serde_json::from_str(&request_body("hjv_token", Some(&device))).unwrap();
+    assert_eq!(body["id"], ID);
+    assert_eq!(body["pk"], PK);
+    let sig = STANDARD.decode(body["sig"].as_str().unwrap()).unwrap();
+    let mut signed = b"hjv-ticket-dev-v1\0123456789\0".to_vec();
+    signed.extend_from_slice(PK.as_bytes());
+    signed.push(0);
+    signed.extend_from_slice(STANDARD.encode(Sha256::digest(b"hjv_token")).as_bytes());
+    let sig = sign::Signature::from_bytes(&sig).unwrap();
+    assert!(sign::verify_detached(&sig, &signed, &pk));
+    // signed for another login's token, it says nothing
+    let other = device_message(ID, PK, "hjv_other");
+    assert!(!sign::verify_detached(&sig, &other, &pk));
+    // a phone asks for a controller's ticket
+    assert_eq!(request_body("hjv_token", None), "{}");
+}
