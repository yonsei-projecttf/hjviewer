+#[test]
+fn a_refusal_for_access_is_told_apart_and_the_session_does_not_reconnect_by_itself() {
+    // hbbs's built-in TEXT, at the punch hole and in the relay request's error
+    let text = "HJViewer는 연세대학교 교직원용입니다. 연세포탈로 로그인하거나 이용 비밀번호를 넣어야 연결할 수 있습니다. HJViewer is for Yonsei University staff: sign in with a Yonsei portal account or enter the access password to connect. (access not allowed)";
+    assert!(is_refusal(text));
+    assert!(is_refusal(&format!(
+        "Failed to connect via relay server: {text}: Please try later"
+    )));
+    assert!(is_refusal("Access Not Allowed"));
+    assert!(!is_refusal(
+        "이 버전으로는 연결할 수 없다는 답을 받았습니다. 업데이트를 확인하고 있습니다. (version not allowed)"
+    ));
+    assert!(!is_refusal("Remote desktop is offline"));
+    for shown in [A1, A2] {
+        assert!(shown.ends_with("(access not allowed)") && is_refusal(shown));
+        for kind in [MSGBOX_TYPE, "error"] {
+            assert!(!crate::client::check_if_retry(
+                kind,
+                "Connection Error",
+                shown,
+                false
+            ));
+        }
+    }
+}
