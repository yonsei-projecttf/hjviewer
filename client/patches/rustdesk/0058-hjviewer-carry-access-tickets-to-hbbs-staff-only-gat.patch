+//! The registration's wire format against the shared vectors (hjviewer repository:
+//! server/api/tests/vectors/access-tickets.json, its `register_pk` "ticket" and "no-field"; SHA-256
+//! 7b9fa3fda31c72fbfc8fc8d147e32b6d34135fa41c0488d0bd6e529b6063f9eb), and which ticket goes where
+//! and when.
+
+use super::*;
+use hbb_common::{
+    protobuf::{reflect::FileDescriptor, Message as _, UnknownValueRef},
+    rendezvous_proto::{RegisterPk, RendezvousMessage},
+};
+
+const ID: &str = "123456789";
+const UUID: &str = "vector-uuid-0001";
+/// The vectors' PC key (seed 0x02 repeated).
+const PK: &str = "gTl3Dqh9F19Wo1Rmw0x+zMuNipG07jeiXfYPW4/Js5Q=";
+/// The vectors' `staff-both` ticket of that PC.
+const TICKET: &str = "t1.1.eyJ2IjoxLCJ3aG8iOiJzdGFmZiIsInVzZSI6ImJvdGgiLCJzdWIiOiI1OTg4OTFmMWExNDM4OWNlIiwiaWQiOiIxMjM0NTY3ODkiLCJwayI6ImdUbDNEcWg5RjE5V28xUm13MHgrek11TmlwRzA3amVpWGZZUFc0L0pzNVE9IiwidG8iOltdLCJpYXQiOjE3NjAwMDAwMDAsImV4cCI6MTc2MDA4NjQwMH0.W9LkK1OuUfFYwPrHIq4t-4-mEpw__XbTb4cv6RpioTFmhVcLf8EJq3oAc6Y6uCvv2zPaOJ8GD5xgtWvdD7fzBQ";
+const REGISTER_PK_HEX: &str = "";
+/// The same without the ticket: an app before 1.8.0.
+const NO_FIELD_HEX: &str = "0a093132333435363738391210766563746f722d757569642d303030311a208139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394";
+/// The vectors' `now`.
+const NOW: u64 = 1_760_003_600;
+
+fn register_pk(ticket: &str) -> RegisterPk {
+    RegisterPk {
+        id: ID.into(),
+        uuid: UUID.as_bytes().to_vec().into(),
+        pk: STANDARD.decode(PK).unwrap().into(),
+        hjv_ticket: ticket.into(),
+        ..Default::default()
+    }
+}
+
+fn held(t: &str, until: u64, life: u64) -> Held {
+    Held {
+        t: t.into(),
+        until,
+        life,
+    }
+}
+
+#[test]
+fn a_registration_carries_its_ticket_in_field_1001_as_the_vectors_have_it() {
+    let rpk = register_pk(TICKET);
+    assert_eq!(hex::encode(rpk.write_to_bytes().unwrap()), REGISTER_PK_HEX);
+    let mut msg = RendezvousMessage::new();
+    msg.set_register_pk(rpk);
+    assert_eq!(
+        hex::encode(msg.write_to_bytes().unwrap()),
+        format!("7a8203{REGISTER_PK_HEX}")
+    );
+}
+
+#[test]
+fn a_registration_without_a_ticket_is_byte_for_byte_an_older_apps() {
+    let mut msg = RendezvousMessage::new();
+    msg.set_register_pk(register_pk(""));
+    assert_eq!(
+        hex::encode(msg.write_to_bytes().unwrap()),
+        format!("7a3f{NO_FIELD_HEX}")
+    );
+}
+
+#[test]
+fn a_server_without_field_1001_reads_the_registration_and_keeps_the_ticket_unknown() {
+    // the rendezvous proto as upstream's hbbs (and 0006, which reads the ticket so) has it
+    let mut file = hbb_common::rendezvous_proto::file_descriptor()
+        .proto()
+        .clone();
+    for message in file.message_type.iter_mut() {
+        message.field.retain(|f| f.number() < 1000);
+    }
+    let old = FileDescriptor::new_dynamic(file, &[]).unwrap();
+    let old_rpk = old.message_by_package_relative_name("RegisterPk").unwrap();
+    let parsed = old_rpk
+        .parse_from_bytes(&hex::decode(REGISTER_PK_HEX).unwrap())
+        .unwrap();
+    let field = |name: &str| old_rpk.field_by_name(name).unwrap();
+    assert_eq!(
+        field("id").get_singular_field_or_default(&*parsed).to_str(),
+        Some(ID)
+    );
+    assert_eq!(
+        field("pk")
+            .get_singular_field_or_default(&*parsed)
+            .to_bytes(),
+        Some(&STANDARD.decode(PK).unwrap()[..])
+    );
+    let unknown = parsed.special_fields_dyn().unknown_fields().get(1001);
+    assert!(
+        matches!(unknown, Some(UnknownValueRef::LengthDelimited(t)) if t == TICKET.as_bytes()),
+        "{unknown:?}"
+    );
+}
+
+#[test]
+fn a_ticket_is_held_by_this_devices_clock_and_renewed_past_half_its_lifetime() {
+    // hjv-api's clock an hour ahead of this device's
+    let issued = json!({ "ticket": TICKET, "exp": NOW + 86_400, "server_time": NOW });
+    let device_now = NOW - 3600;
+    let ticket = Held::issued(&issued, device_now).unwrap();
+    assert_eq!(ticket, held(TICKET, device_now + 86_400, 86_400));
+    assert!(ticket.valid(device_now + 86_399) && !ticket.valid(device_now + 86_400));
+    assert!(!ticket.renew_due(device_now + 43_199) && ticket.renew_due(device_now + 43_200));
+
+    for not_a_ticket in [
+        json!({ "exp": NOW + 60, "server_time": NOW }),
+        json!({ "ticket": "", "exp": NOW + 60, "server_time": NOW }),
+        json!({ "ticket": 7, "exp": NOW + 60, "server_time": NOW }),
+        json!({ "ticket": TICKET, "server_time": NOW }),
+        json!({ "ticket": TICKET, "exp": NOW + 60 }),
+        json!({ "ticket": TICKET, "exp": NOW, "server_time": NOW }),
+        json!({ "ticket": "t".repeat(MAX_TICKET + 1), "exp": NOW + 60, "server_time": NOW }),
+        json!(TICKET),
+    ] {
+        assert_eq!(Held::issued(&not_a_ticket, NOW), None, "{not_a_ticket}");
+    }
+    // a lifetime past what hbbs takes is not believed
+    let long = json!({ "ticket": TICKET, "exp": NOW + 30 * 86_400, "server_time": NOW });
+    assert_eq!(Held::issued(&long, NOW).unwrap().until, NOW + MAX_LIFE);
+}
