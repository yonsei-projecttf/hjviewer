+#[cfg(test)]
+mod access_ticket_tests {
+    use super::*;
+    use hbb_common::tcp::FramedStream;
+
+    /// A stand-in server on loopback: it takes one message, answers `answer` if there is one, and
+    /// tells what it took.
+    async fn server(
+        answer: Option<RendezvousMessage>,
+    ) -> (String, oneshot::Receiver<RequestRelay>) {
+        let listener = hbb_common::tcp::new_listener("127.0.0.1:0", false)
+            .await
+            .unwrap();
+        let host = listener.local_addr().unwrap().to_string();
+        let (tx, rx) = oneshot::channel();
+        tokio::spawn(async move {
+            let (stream, addr) = listener.accept().await.unwrap();
+            let mut s = FramedStream::from(stream, addr);
+            let bytes = s.next().await.unwrap().unwrap();
+            if let Some(answer) = answer {
+                s.send(&answer).await.unwrap();
+            }
+            let Some(rendezvous_message::Union::RequestRelay(rr)) =
+                RendezvousMessage::parse_from_bytes(&bytes).unwrap().union
+            else {
+                panic!("expected a RequestRelay");
+            };
+            tx.send(rr).ok();
+        });
+        (host, rx)
+    }
+
+    #[tokio::test]
+    async fn the_access_ticket_goes_to_hbbs_in_the_relay_request_and_not_to_hbbr() {
+        const REFUSAL: &str = "HJViewer is for Yonsei University staff. (access not allowed)";
+        let mut refused = RendezvousMessage::new();
+        refused.set_relay_response(RelayResponse {
+            refuse_reason: REFUSAL.to_owned(),
+            ..Default::default()
+        });
+        let (hbbs, taken) = server(Some(refused)).await;
+        let err = Client::request_relay(
+            "123456789",
+            "relay.invalid".to_owned(),
+            &hbbs,
+            false,
+            "",
+            "t1.ticket",
+            ConnType::DEFAULT_CONN,
+            "",
+        )
+        .await
+        .err()
+        .unwrap();
+        assert_eq!(taken.await.unwrap().token, "t1.ticket");
+        assert!(
+            crate::hjviewer_access::is_refusal(&err.to_string()),
+            "{err}"
+        );
+
+        let (hbbr, taken) = server(None).await;
+        let _relay = Client::create_relay(
+            "123456789",
+            "uuid".to_owned(),
+            hbbr,
+            "key",
+            ConnType::DEFAULT_CONN,
+            true,
+        )
+        .await
+        .unwrap();
+        assert!(taken.await.unwrap().token.is_empty());
+    }
+}
