+#[test]
+fn a_pc_registers_again_with_a_new_ticket_after_a_refusal_or_past_half_the_old_ones_life() {
+    let sent = |t: &str| Sent {
+        t: t.into(),
+        half: NOW + 100,
+    };
+    let next = held("next", NOW + 259_200, 259_200);
+    // before the first registration the mediator registers by itself
+    assert_eq!(reregister(None, Some(&next), true, NOW), Next::Wait);
+    // nothing new to send
+    assert_eq!(
+        reregister(Some(&sent("next")), Some(&next), true, NOW),
+        Next::Wait
+    );
+    assert_eq!(reregister(Some(&sent("")), None, true, NOW), Next::Wait);
+    // the new ticket goes at once after a refusal, or after a registration without one
+    assert_eq!(
+        reregister(Some(&sent("old")), Some(&next), true, NOW),
+        Next::Register
+    );
+    assert_eq!(
+        reregister(Some(&sent("")), Some(&next), false, NOW),
+        Next::Register
+    );
+    // a ticket hbbs took waits for half its lifetime
+    assert_eq!(
+        reregister(Some(&sent("old")), Some(&next), false, NOW + 99),
+        Next::Wait
+    );
+    assert_eq!(
+        reregister(Some(&sent("old")), Some(&next), false, NOW + 100),
+        Next::Register
+    );
+    // without any ticket left, hbbs would keep the registration it took: connect again
+    for refused in [false, true] {
+        assert_eq!(
+            reregister(Some(&sent("old")), None, refused, NOW),
+            Next::Restart
+        );
+    }
+}
