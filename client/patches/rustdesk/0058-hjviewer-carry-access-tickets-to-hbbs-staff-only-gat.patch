+//! Access tickets: from 1.8.0 on, HJViewer is for Yonsei University staff (docs/access-tickets.md
+//! of the hjviewer repository, "the doc" below). hjv-api signs short-lived tickets for a login,
+//! for a bound PC and for whoever entered the access password, and hbbs (server patch 0006)
+//! checks them offline at the punch hole request, the relay request and the registration. The app
+//! never reads a ticket: it carries the string hjv-api gave it, and knows when to ask for the next
+//! one by the `exp` and `server_time` that hjv-api sends beside it.
+//!
+//! - A controller sends the ticket for its target in PunchHoleRequest.token and RequestRelay.token
+//!   to hbbs (`controller_token`, from Client::start, so that every reconnection and every local
+//!   connection of a port forward takes the current one): the access password's ticket for that
+//!   target, else the login's. After a refusal for access a logged-in app asks for a new ticket
+//!   once and tries again (`renewed`); a refusal that stays reaches the screens as a msgbox of
+//!   type `hjv-access-error` with the app's own text (`refusal_text`).
+//! - A PC sends its ticket in RegisterPk.hjv_ticket (`registration_ticket`): a bound PC's from its
+//!   sync's answer (in the service), the access password's PC ticket, or the login's ticket of an
+//!   app that is not installed. It registers again at once when a new ticket comes after a
+//!   refusal, and when the one it registered with is past half its lifetime; one that has no
+//!   ticket left connects again (`registration_tick`). Whether hbbs took the registration is in
+//!   the option `hjv-access-pc` of the process that registers (the service of an installed PC).
+//! - The login's ticket comes with the login's answer (`hjv.ticket`) and from
+//!   `POST /api/hjv/ticket`, which a thread asks again once the ticket is past half its lifetime,
+//!   and stays in LocalConfig until the logout. The access password's tickets stay in this
+//!   process's memory only.
+//!
+//! A build that is not an account build carries nothing: its token is what it was and its
+//! RegisterPk is byte for byte 1.7.0's. So is an app without a ticket, which a server that checks
+//! nothing (MODE=off, or hbbs before 0006) takes as before.
+
+// Only the Flutter screens ask for the screens' keys, and a phone registers no PC.
+#![cfg_attr(
+    any(target_os = "android", target_os = "ios", not(feature = "flutter")),
+    allow(dead_code)
+)]
+
+use hbb_common::{
+    base64::{engine::general_purpose::STANDARD, Engine as _},
+    config::{Config, LocalConfig},
+    log,
+    sodiumoxide::crypto::sign,
+    tokio,
+};
+use serde_derive::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    io::Read,
+    sync::{Condvar, Mutex, MutexGuard, Once, OnceLock},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+#[cfg(test)]
+mod tests;
+
+/// How hbbs marks a refusal for access (the doc, 5-1). Its "not allowed" also keeps an app of any
+/// version from connecting again by itself (check_if_retry).
+const MARK: &str = "access not allowed";
+/// What the app shows in place of a refusal for access (the doc, 5-3), its own texts as for a
+/// refusal for the version: A1 to an app without a login, A2 to a logged-in app whose new ticket
+/// was refused too. Both end with the mark.
+const A1: &str = "HJViewer는 연세대학교 교직원용입니다. 연세포탈로 로그인하거나 이용 비밀번호를 넣으세요. (access not allowed)";
+const A2: &str = "서버가 이 연결을 받지 않았습니다. 잠시 뒤 다시 시도하고, 계속되면 관리자에게 알려 주세요. (access not allowed)";
+/// The msgbox type of a refusal for access, where the session's dialog offers the login and the
+/// access password. Screens without that dialog show it as the error box it contains in its name.
+pub(crate) const MSGBOX_TYPE: &str = "hjv-access-error";
+
+/// LocalConfig: the login's ticket (`Held` as JSON).
+const ACCOUNT_TICKET: &str = "hjv-access-ticket";
+/// The option (Config2) of the process that registers: "ok" or "refused", whether hbbs took its
+/// last RegisterPk (RegisterPkResponse OK or NOT_DEPLOYED).
+const PC_STATE: &str = "hjv-access-pc";
+/// In the service's config folder, next to the trust list: a bound PC's ticket (`Held` as JSON).
+const BOUND_FILE: &str = "HJViewer_ticket.json";
+
+const TICKET_PATH: &str = "/api/hjv/ticket";
+/// What the device key signs in a desktop app's ticket request.
+const DEVICE_CONTEXT: &[u8] = b"hjv-ticket-dev-v1";
+const SERVER: Option<&str> = option_env!("HJV_SERVER");
+/// Longer than anything hjv-api makes (hbbs takes 1024 bytes at most), so not kept.
+const MAX_TICKET: usize = 4096;
+const MAX_ANSWER: u64 = 8192;
+/// hbbs refuses a ticket that lives longer (the doc, 2-3).
+const MAX_LIFE: u64 = 7 * 86_400;
+
+/// The renewing thread's request, the one before a connection that has no ticket that holds, and
+/// the one after a refusal.
+const FETCH_TIMEOUT: Duration = Duration::from_secs(20);
+const BEFORE_CONNECT_TIMEOUT: Duration = Duration::from_secs(5);
+const RENEW_TIMEOUT: Duration = Duration::from_secs(10);
+/// All requests together go out at most every FETCH_GAP; after failures in a row, every RETRY_MIN
+/// seconds doubling up to RETRY_MAX.
+const FETCH_GAP: Duration = Duration::from_secs(10);
+const RETRY_MIN: u64 = 30;
+const RETRY_MAX: u64 = 1800;
+/// The renewing thread looks at the login at least this often (seconds).
+const IDLE: u64 = 600;
+/// A sync brings a bound PC a new ticket every couple of minutes; its file copy, which only serves
+/// a restart while hjv-api is away, is written again once a new one outlives it by this much.
+const KEEP_STEP: u64 = 3600;
+
+/// A ticket as the app holds it.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq)]
+struct Held {
+    /// the ticket, as hjv-api gave it
+    t: String,
+    /// when it ends, by this device's clock
+    until: u64,
+    /// how long it had to live when it came
+    life: u64,
+}
+
+impl Held {
+    /// What an answer of hjv-api carries for a ticket, `{"ticket":"t1.…","exp":<time>,
+    /// "server_time":<time>}`, received at `now` by this device's clock. None for anything else
+    /// and for a ticket that has already ended.
+    fn issued(value: &Value, now: u64) -> Option<Held> {
+        let t = value.get("ticket")?.as_str()?;
+        let exp = value.get("exp")?.as_u64()?;
+        let server_time = value.get("server_time")?.as_u64()?;
+        if t.is_empty() || t.len() > MAX_TICKET || exp <= server_time {
+            return None;
+        }
+        let life = (exp - server_time).min(MAX_LIFE);
+        Some(Held {
+            t: t.to_owned(),
+            until: now.saturating_add(life),
+            life,
+        })
+    }
+
+    fn valid(&self, now: u64) -> bool {
+        now < self.until
+    }
+
+    /// Halfway through its lifetime, when the next one is due.
+    fn half(&self) -> u64 {
+        self.until.saturating_sub(self.life / 2)
+    }
+
+    fn renew_due(&self, now: u64) -> bool {
+        now >= self.half()
+    }
+}
+
+/// What the PC's last RegisterPk carried, and when that ticket is halfway through its lifetime.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Sent {
+    t: String,
+    half: u64,
+}
+
+/// This process's tickets besides the login's.
+struct Memory {
+    /// the access password's controller tickets, by target ID
+    guests: BTreeMap<String, Held>,
+    /// the access password's ticket for this PC
+    guest_pc: Option<Held>,
+    /// a bound PC's ticket (the service), with a copy in BOUND_FILE
+    bound: Option<Held>,
+    /// when the file copy ends (0: no copy)
+    bound_kept: u64,
+    sent: Option<Sent>,
+}
+
+static MEMORY: Mutex<Memory> = Mutex::new(Memory {
+    guests: BTreeMap::new(),
+    guest_pc: None,
+    bound: None,
+    bound_kept: 0,
+    sent: None,
+});
+
+fn memory() -> MutexGuard<'static, Memory> {
+    MEMORY.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// An account build (hjviewer_account::enabled), the only one that has tickets.
+fn active() -> bool {
+    static ACTIVE: OnceLock<bool> = OnceLock::new();
+    *ACTIVE.get_or_init(crate::hjviewer_account::enabled)
+}
+
+fn logged_in() -> bool {
+    !LocalConfig::get_option("access_token").is_empty()
+}
+
+fn account() -> Option<Held> {
+    serde_json::from_str(&LocalConfig::get_option(ACCOUNT_TICKET)).ok()
+}
+
+/// The login's ticket while there is a login.
+fn login_ticket() -> Option<Held> {
+    logged_in().then(account).flatten()
+}
+
+fn keep_account(held: Option<&Held>) {
+    let value = held
+        .and_then(|held| serde_json::to_string(held).ok())
+        .unwrap_or_default();
+    if LocalConfig::get_option(ACCOUNT_TICKET) != value {
+        LocalConfig::set_option(ACCOUNT_TICKET.to_owned(), value);
+    }
+}
+
+fn unix_now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+/// The ticket a controller sends for a target: the access password's for that target, else the
+/// login's (`account`, only while there is a login), each only while it holds; empty without one.
+fn controller_choice(guest: Option<&Held>, account: Option<&Held>, now: u64) -> String {
+    guest
+        .filter(|held| held.valid(now))
+        .or_else(|| account.filter(|held| held.valid(now)))
+        .map(|held| held.t.clone())
+        .unwrap_or_default()
+}
+
+/// The ticket a PC registers with: a bound PC's, else the access password's, else the login's
+/// (`account`, only while there is a login: an app that is not installed), the first that holds.
+fn pc_choice<'a>(
+    bound: Option<&'a Held>,
+    guest: Option<&'a Held>,
+    account: Option<&'a Held>,
+    now: u64,
+) -> Option<&'a Held> {
+    [bound, guest, account]
+        .into_iter()
+        .flatten()
+        .find(|held| held.valid(now))
+}
+
+/// What a registered PC does about its registration now (the doc, 4-4).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Next {
+    Wait,
+    /// RegisterPk again on the connection it has, with `next`
+    Register,
+    /// connect again, and register without a ticket
+    Restart,
+}
+
+/// `Register` when the PC has another ticket than the one it registered with, and hbbs refused
+/// that one, or it carried none, or it is past half its lifetime (hbbs keeps a registration it
+/// took only until its ticket ends). `Restart` when the PC registered with a ticket and has none
+/// left (a logout, the binding gone, the ticket over): a RegisterPk without one would not end the
+/// registration hbbs took.
+fn reregister(sent: Option<&Sent>, next: Option<&Held>, refused: bool, now: u64) -> Next {
+    let Some(sent) = sent else {
+        return Next::Wait;
+    };
+    match next {
+        None if !sent.t.is_empty() => Next::Restart,
+        Some(next) if next.t != sent.t && (refused || sent.t.is_empty() || now >= sent.half) => {
+            Next::Register
+        }
+        _ => Next::Wait,
+    }
+}
+
+/// Client::start: the token a connection to `peer` carries to hbbs. An account build sends the
+/// access ticket for `peer` in place of `token`, which it leaves empty anyway
+/// (hjviewer::rendezvous_token). A logged-in app without a ticket that holds asks for one first,
+/// for BEFORE_CONNECT_TIMEOUT at most.
+pub(crate) async fn controller_token(peer: &str, token: &str) -> String {
+    if !active() {
+        return token.to_owned();
+    }
+    if logged_in() {
+        if !account().is_some_and(|held| held.valid(unix_now())) {
+            let _ = off_thread(BEFORE_CONNECT_TIMEOUT, || fetch(BEFORE_CONNECT_TIMEOUT)).await;
+        }
+        kick();
+    }
+    let guest = memory().guests.get(peer).cloned();
+    controller_choice(guest.as_ref(), login_ticket().as_ref(), unix_now())
+}
+
+/// Client::start, after the first try failed with `error`: the token of a second try for a
+/// logged-in app that hbbs refused for access, with the login's new ticket (the doc, 5-3); None for
+/// any other failure and when no other ticket than `used` came.
+pub(crate) async fn renewed(error: &str, used: &str) -> Option<String> {
+    if !active() || !is_refusal(error) || !logged_in() {
+        return None;
+    }
+    let _ = off_thread(RENEW_TIMEOUT, || fetch(RENEW_TIMEOUT)).await;
+    let next = login_ticket().filter(|held| held.valid(unix_now()))?.t;
+    (next != used).then_some(next)
+}
+
+/// Whether a connection's error is hbbs's refusal for access, of a punch hole request or of a
+/// relay request, as it came or inside the connection's own text.
+pub(crate) fn is_refusal(error: &str) -> bool {
+    error.to_lowercase().contains(MARK)
+}
+
+/// Interface::on_establish_connection_error: the app's own text in place of a refusal for access;
+/// None for any other error and in a build that is not an account build.
+pub(crate) fn refusal_text(error: &str) -> Option<&'static str> {
+    (active() && is_refusal(error)).then(|| if logged_in() { A2 } else { A1 })
+}
+
+/// RegisterPk.hjv_ticket (rendezvous_mediator): the ticket this PC registers with, noted as the one
+/// it registered with; empty without one and in a build that is not an account build.
+#[cfg(not(target_os = "ios"))]
+pub(crate) fn registration_ticket() -> String {
+    if !active() {
+        return String::new();
+    }
+    let now = unix_now();
+    let account = login_ticket();
+    if logged_in() {
+        kick();
+    }
+    let mut memory = memory();
+    let sent = match pc_choice(
+        memory.bound.as_ref(),
+        memory.guest_pc.as_ref(),
+        account.as_ref(),
+        now,
+    ) {
+        Some(held) => Sent {
+            t: held.t.clone(),
+            half: held.half(),
+        },
+        None => Sent {
+            t: String::new(),
+            half: 0,
+        },
+    };
+    let t = sent.t.clone();
+    memory.sent = Some(sent);
+    t
+}
+
+/// rendezvous_mediator, every second, with `refused` when hbbs refused the last RegisterPk: whether
+/// to send RegisterPk again now (`reregister`). For a `Restart` it starts the rendezvous connection
+/// again itself.
+#[cfg(not(target_os = "ios"))]
+pub(crate) fn registration_tick(refused: bool) -> bool {
+    if !active() {
+        return false;
+    }
+    let now = unix_now();
+    let account = login_ticket();
+    let mut memory = memory();
+    let next = pc_choice(
+        memory.bound.as_ref(),
+        memory.guest_pc.as_ref(),
+        account.as_ref(),
+        now,
+    );
+    match reregister(memory.sent.as_ref(), next, refused, now) {
+        Next::Register => true,
+        Next::Restart => {
+            memory.sent = None;
+            crate::RendezvousMediator::restart();
+            false
+        }
+        Next::Wait => false,
+    }
+}
+
+/// The answer to a RegisterPk (rendezvous_mediator): whether hbbs took it, for the screens.
+#[cfg(not(target_os = "ios"))]
+pub(crate) fn registration_answered(taken: bool) {
+    if !active() {
+        return;
+    }
+    let state = if taken { "ok" } else { "refused" };
+    if Config::get_option(PC_STATE) != state {
+        Config::set_option(PC_STATE.to_owned(), state.to_owned());
+    }
+}
+
+/// The answer to a login with its token (hjviewer_account): its `hjv.ticket` is the login's ticket
+/// in place of any earlier one. Without one, the renewing thread or the next connection asks.
+pub(crate) fn login_answered(issued: Option<&Value>) {
+    if !active() {
+        return;
+    }
+    keep_account(
+        issued
+            .and_then(|value| Held::issued(value, unix_now()))
+            .as_ref(),
+    );
+    kick();
+}
+
+/// The end of a login (hjviewer_account): the login's ticket goes with it.
+pub(crate) fn logged_out() {
+    if active() {
+        keep_account(None);
+    }
+}
+
+/// The service's start (hjviewer_account::start_pc_sync): the ticket a bound PC kept, so that it
+/// registers with it before its first sync is answered. A PC that is not bound keeps none.
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub(crate) fn restore_bound(bound: bool) {
+    if !active() {
+        return;
+    }
+    let path = Config::path(BOUND_FILE);
+    if !bound {
+        std::fs::remove_file(&path).ok();
+        return;
+    }
+    let kept = std::fs::read(&path)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice::<Held>(&bytes).ok());
+    let mut memory = memory();
+    memory.bound_kept = kept.as_ref().map_or(0, |held| held.until);
+    memory.bound = kept;
+}
+
+/// A sync's answer (hjviewer_account): the ticket of a 200 answer that kept a list of this PC's
+/// binding, in place of the one the PC has; None when that answer had none or the binding went.
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub(crate) fn bound_answered(issued: Option<&Value>) {
+    if !active() {
+        return;
+    }
+    let held = issued.and_then(|value| Held::issued(value, unix_now()));
+    let write = {
+        let mut memory = memory();
+        memory.bound = held.clone();
+        let write = match &held {
+            Some(held) => held.until >= memory.bound_kept.saturating_add(KEEP_STEP),
+            None => memory.bound_kept != 0,
+        };
+        if write {
+            memory.bound_kept = held.as_ref().map_or(0, |held| held.until);
+        }
+        write
+    };
+    if write {
+        keep_bound_file(held.as_ref());
+    }
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+fn keep_bound_file(held: Option<&Held>) {
+    let path = Config::path(BOUND_FILE);
+    let result = match held {
+        Some(held) => crate::hjviewer_account::write_private(
+            &path,
+            &serde_json::to_vec(held).unwrap_or_default(),
+        ),
+        None => match std::fs::remove_file(&path) {
+            Err(err) if err.kind() != std::io::ErrorKind::NotFound => Err(err),
+            _ => Ok(()),
+        },
+    };
+    if let Err(err) = result {
+        hbb_common::throttled_log!(
+            Duration::from_secs(3600),
+            warn,
+            "access tickets: the bound PC's ticket file: {err}"
+        );
+    }
+}
+
+/// The access password's controller ticket for `target` (wave 2: the answer of
+/// `POST /api/hjv/guest`), in this process's memory only, where the session windows of this
+/// process find it too. False for an answer without one.
+#[allow(dead_code)]
+pub(crate) fn keep_guest(target: &str, issued: &Value) -> bool {
+    let now = unix_now();
+    let Some(held) = Held::issued(issued, now) else {
+        return false;
+    };
+    let mut memory = memory();
+    memory.guests.retain(|_, held| held.valid(now));
+    memory.guests.insert(target.to_owned(), held);
+    true
+}
+
+#[allow(dead_code)]
+pub(crate) fn forget_guest(target: &str) {
+    memory().guests.remove(target);
+}
+
+/// The access password's ticket for this PC (wave 2: from `POST /api/hjv/guest`, or over the IPC
+/// in the service of an installed PC), in memory only: it ends with the process or its lifetime.
+#[allow(dead_code)]
+pub(crate) fn keep_guest_pc(issued: &Value) -> bool {
+    let Some(held) = Held::issued(issued, unix_now()) else {
+        return false;
+    };
+    memory().guest_pc = Some(held);
+    true
+}
+
+#[allow(dead_code)]
+pub(crate) fn forget_guest_pc() {
+    memory().guest_pc = None;
+}
+
+/// main_get_common: `hjv-access-state`, `{"ticket":<the login has a ticket that holds>,
+/// "until":<when it ends, Unix seconds by this device's clock, 0 without one>}`; None for any
+/// other key and in a build that is not an account build.
+pub(crate) fn get_common(key: &str) -> Option<String> {
+    if key != "hjv-access-state" || !active() {
+        return None;
+    }
+    let held = login_ticket();
+    let now = unix_now();
+    Some(
+        json!({
+            "ticket": held.as_ref().is_some_and(|held| held.valid(now)),
+            "until": held.as_ref().map_or(0, |held| held.until),
+        })
+        .to_string(),
+    )
+}
+
+/// main_set_common: `hjv-access-refresh` (the app's start, its return to the foreground) has the
+/// renewing thread look at the login's ticket now. True when the key was this module's.
+pub(crate) fn set_common(key: &str, _value: &str) -> bool {
+    if key != "hjv-access-refresh" || !active() {
+        return false;
+    }
+    kick();
+    true
+}
+
+/// Runs blocking `f` (a request) on a thread of its own and waits for it, `limit` at most, without
+/// blocking the caller's runtime; None when it did not end in time or the thread did not start.
+async fn off_thread<T: Send + 'static>(
+    limit: Duration,
+    f: impl FnOnce() -> T + Send + 'static,
+) -> Option<T> {
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    std::thread::Builder::new()
+        .name("hjv-access-fetch".to_owned())
+        .spawn(move || {
+            tx.send(f()).ok();
+        })
+        .ok()?;
+    tokio::time::timeout(limit, rx).await.ok()?.ok()
+}
+
+/// The limits that all requests for the login's ticket share.
+struct Limiter {
+    last: Option<Instant>,
+    failures: u32,
+}
+
+impl Limiter {
+    /// How long until the next request may go.
+    fn wait(&self, now: Instant) -> Duration {
+        let gap = if self.failures == 0 {
+            FETCH_GAP
+        } else {
+            let doubled = RETRY_MIN.saturating_mul(1 << self.failures.saturating_sub(1).min(10));
+            Duration::from_secs(doubled.min(RETRY_MAX))
+        };
+        self.last.map_or(Duration::ZERO, |last| {
+            gap.saturating_sub(now.saturating_duration_since(last))
+        })
+    }
+}
+
+static LIMITER: Mutex<Limiter> = Mutex::new(Limiter {
+    last: None,
+    failures: 0,
+});
+
+/// One request for the login's ticket within the limits, one at a time; on failure, the wait until
+/// the next may go. It blocks.
+fn fetch(timeout: Duration) -> Result<(), Duration> {
+    let mut limiter = LIMITER.lock().unwrap_or_else(|e| e.into_inner());
+    let wait = limiter.wait(Instant::now());
+    if !wait.is_zero() {
+        return Err(wait);
+    }
+    limiter.last = Some(Instant::now());
+    match request(timeout) {
+        Ok((held, token)) => {
+            limiter.failures = 0;
+            // a logout or another login while the request was out keeps no ticket of it
+            if LocalConfig::get_option("access_token") == token {
+                keep_account(Some(&held));
+            }
+            Ok(())
+        }
+        Err(why) => {
+            limiter.failures = limiter.failures.saturating_add(1);
+            hbb_common::throttled_log!(
+                Duration::from_secs(600),
+                warn,
+                "access tickets: no ticket for the login: {why}"
+            );
+            Err(limiter.wait(Instant::now()))
+        }
+    }
+}
+
+/// `POST /api/hjv/ticket` by the login, as door 1 sends its requests: the ticket of the 200 answer
+/// with the token it was asked by, or why there is none.
+fn request(timeout: Duration) -> Result<(Held, String), &'static str> {
+    let server = SERVER.filter(|server| !server.is_empty()).ok_or("config")?;
+    let token = LocalConfig::get_option("access_token");
+    if token.is_empty() {
+        return Err("login");
+    }
+    let body = request_body(&token, device().as_ref());
+    let response = crate::hjviewer_update::send_by_login(server, true, TICKET_PATH, &body, timeout)
+        .map_err(|failure| failure.code())?;
+    let mut answer = Vec::new();
+    response
+        .take(MAX_ANSWER)
+        .read_to_end(&mut answer)
+        .map_err(|_| "network")?;
+    let value = serde_json::from_slice::<Value>(&answer).map_err(|_| "answer")?;
+    let held = Held::issued(&value, unix_now()).ok_or("answer")?;
+    Ok((held, token))
+}
+
+/// This desktop app's ID and its device key, the one hbbs has for the ID.
+struct Device {
+    id: String,
+    sk: sign::SecretKey,
+    pk: Vec<u8>,
+}
+
+fn device() -> Option<Device> {
+    if cfg!(any(target_os = "android", target_os = "ios")) {
+        return None;
+    }
+    let (sk, pk) = Config::get_existing_key_pair()?;
+    let _ = hbb_common::sodiumoxide::init();
+    Some(Device {
+        id: Config::get_id(),
+        sk: sign::SecretKey::from_slice(&sk)?,
+        pk,
+    })
+}
+
+/// The body of a ticket request. A phone sends `{}` and gets a controller's ticket. A desktop app
+/// sends its ID and device key, signed by that key together with this login's token, and gets a
+/// ticket that registers it too (`both`):
+///
+/// ```text
+/// {"id":"<device ID>","pk":"<standard base64 of the device key>","sig":"<standard base64>"}
+/// sig: the device key's Ed25519 signature over
+///      "hjv-ticket-dev-v1" NUL id NUL pk NUL base64(SHA-256(token))
+/// ```
+fn request_body(token: &str, device: Option<&Device>) -> String {
+    let Some(device) = device else {
+        return "{}".to_owned();
+    };
+    let pk = STANDARD.encode(&device.pk);
+    let sig = sign::sign_detached(&device_message(&device.id, &pk, token), &device.sk);
+    json!({ "id": device.id, "pk": pk, "sig": STANDARD.encode(sig.to_bytes()) }).to_string()
+}
+
+fn device_message(id: &str, pk: &str, token: &str) -> Vec<u8> {
+    let token = STANDARD.encode(Sha256::digest(token.as_bytes()));
+    [
+        DEVICE_CONTEXT,
+        id.as_bytes(),
+        pk.as_bytes(),
+        token.as_bytes(),
+    ]
+    .join(&0u8)
+}
+
+static KICKED: Mutex<bool> = Mutex::new(false);
+static WAKE: Condvar = Condvar::new();
+
+/// Wakes the renewing thread, which starts the first time.
+fn kick() {
+    static START: Once = Once::new();
+    START.call_once(|| {
+        let started = std::thread::Builder::new()
+            .name("hjv-access".to_owned())
+            .spawn(worker);
+        if let Err(err) = started {
+            log::error!("access tickets: the renewing thread did not start: {err}");
+        }
+    });
+    *KICKED.lock().unwrap_or_else(|e| e.into_inner()) = true;
+    WAKE.notify_one();
+}
+
+fn worker() {
+    loop {
+        let wait = renew();
+        let kicked = KICKED.lock().unwrap_or_else(|e| e.into_inner());
+        let mut kicked = if *kicked {
+            kicked
+        } else {
+            WAKE.wait_timeout(kicked, wait)
+                .map_or_else(|e| e.into_inner().0, |(kicked, _)| kicked)
+        };
+        *kicked = false;
+    }
+}
+
+/// One turn of the renewing thread: the login's next ticket once the one it has is past half its
+/// lifetime, or when it has none; how long the thread sleeps after it.
+fn renew() -> Duration {
+    if !logged_in() {
+        return Duration::from_secs(IDLE);
+    }
+    let now = unix_now();
+    if let Some(held) = account().filter(|held| !held.renew_due(now)) {
+        return Duration::from_secs(held.half().saturating_sub(now).clamp(1, IDLE));
+    }
+    match fetch(FETCH_TIMEOUT) {
+        Ok(()) => Duration::ZERO,
+        Err(wait) => wait.max(Duration::from_secs(1)),
+    }
+}
+
+/// `--hjv-e2e-ticket`: what this app holds, never the ticket itself: the first bytes of its hash
+/// tell tickets apart.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) fn e2e_state() -> String {
+    let held = login_ticket();
+    let now = unix_now();
+    json!({
+        "login": logged_in(),
+        "ticket": held.as_ref().map(|held| hex::encode(&Sha256::digest(held.t.as_bytes())[..8])),
+        "valid": held.as_ref().is_some_and(|held| held.valid(now)),
+        "left": held.as_ref().map_or(0, |held| held.until.saturating_sub(now)),
+        "life": held.as_ref().map_or(0, |held| held.life),
+    })
+    .to_string()
+}
+
+/// `--hjv-e2e-ticket refresh`: one request for the login's ticket now, past the limits.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) fn e2e_fetch() -> Result<(), &'static str> {
+    let (held, token) = request(FETCH_TIMEOUT)?;
+    if LocalConfig::get_option("access_token") == token {
+        keep_account(Some(&held));
+    }
+    Ok(())
+}
