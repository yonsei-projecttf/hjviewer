+
+// HJViewer: a toolbar button's colours: an icon in the secondary text colour on the card with
+// the hover colour under it, primarySoft/primary while it is on, and the danger colour for the
+// buttons upstream paints red (close, a call being set up, recording). A button that is on
+// darkens a little under the pointer.
+({Color bg, Color fg}) _hjvToolbarButtonColors(
+    BuildContext context, Color color,
+    {required bool hover, required bool active}) {
+  final p = HjvPalette.of(context);
+  if (color == _ToolbarTheme.redColor) {
+    final tint = hjvTint(context, p.danger).$1;
+    return (
+      bg: active
+          ? (hover ? Color.alphaBlend(p.danger.withOpacity(0.08), tint) : tint)
+          : (hover ? tint : Colors.transparent),
+      fg: p.danger
+    );
+  }
+  if (active) {
+    return (
+      bg: hover
+          ? Color.alphaBlend(p.primary.withOpacity(0.08), p.primarySoft)
+          : p.primarySoft,
+      fg: p.primary
+    );
+  }
+  return (
+    bg: hover ? p.hover : Colors.transparent,
+    fg: hover ? p.text : p.textSecondary
+  );
+}
