+// HJViewer: the bar is rounded like the handle, on the side facing away from the docked edge.
+BorderRadius _hjvToolbarBorderRadius(_ToolbarEdge edge) {
+  const r = Radius.circular(HjvRadius.lg);
+  switch (edge) {
+    case _ToolbarEdge.top:
+      return const BorderRadius.vertical(bottom: r);
+    case _ToolbarEdge.bottom:
