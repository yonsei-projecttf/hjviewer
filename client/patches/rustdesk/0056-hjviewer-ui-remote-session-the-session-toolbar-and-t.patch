+  // HJViewer: globalMonitorsWidget in the palette: each display a small outlined screen, the
+  // current one filled with the primary colour. Upstream's stays as it is, unused.
+  Widget _hjvGlobalMonitorsWidget(
+      BuildContext context, SimpleWrapper<double> width) {
+    final p = HjvPalette.of(context);
+    getMonitors() {
+      final pi = ffi.ffiModel.pi;
+      RxInt display = CurrentDisplayState.find(id);
+      final rect = ffi.ffiModel.globalDisplaysRect();
+      if (rect == null) {
+        return Offstage();
+      }
+
+      final scale = _ToolbarTheme.buttonSize / rect.height * 0.75;
+      final height = rect.height * scale;
+      final startY = (_ToolbarTheme.buttonSize - height) * 0.5;
+      final startX = startY;
+
+      final children = <Widget>[];
+      for (var i = 0; i < pi.displays.length; i++) {
+        final d = pi.displays[i];
+        double s = d.scale;
+        int dWidth = d.width.toDouble() ~/ s;
+        int dHeight = d.height.toDouble() ~/ s;
+        final fontSize = (dWidth * scale < dHeight * scale
+                ? dWidth * scale
+                : dHeight * scale) *
+            0.6;
+        final current = display.value == i;
+        children.add(Positioned(
+          left: (d.x - rect.left) * scale + startX,
+          top: (d.y - rect.top) * scale + startY,
+          width: dWidth * scale,
+          height: dHeight * scale,
+          child: Container(
+            // a hairline apart from the display next to it
+            margin: const EdgeInsets.all(1),
+            decoration: BoxDecoration(
+              color: current ? p.primary : p.card,
+              border: Border.all(color: current ? p.primary : p.textTertiary),
+              borderRadius: BorderRadius.circular(3),
+            ),
+            child: Center(
+                child: Text(
+              '${i + 1}',
+              style: TextStyle(
+                color: current ? Colors.white : p.textSecondary,
+                fontSize: fontSize,
+                height: 1,
+                fontWeight: FontWeight.bold,
+              ),
+            )),
+          ),
+        ));
+      }
+      width.value = rect.width * scale + startX * 2;
+      return SizedBox(
+        width: width.value,
+        height: height + startY * 2,
+        child: Stack(
+          children: children,
+        ),
+      );
+    }
+
+    return Stack(
+      alignment: Alignment.center,
+      children: [
+        SizedBox(height: _ToolbarTheme.buttonSize),
+        getMonitors(),
+      ],
+    );
+  }
