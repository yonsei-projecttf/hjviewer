diff --git a/flutter/test/hjviewer_suggestions_test.dart b/flutter/test/hjviewer_suggestions_test.dart
new file mode 100644
index 0000000..338b906
--- /dev/null
+++ b/flutter/test/hjviewer_suggestions_test.dart
@@ -0,0 +1,39 @@
+import 'package:flutter_hbb/common/hjviewer_account_texts.dart';
+import 'package:flutter_hbb/common/hjv_suggestions.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('a suggestion with an alias shows the spaced ID at its end', () {
+    final t = hjvSuggestionTexts(
+        id: '123456789', alias: 'Lab PC', username: 'user', hostname: 'LAB-PC');
+    expect(t.title, 'Lab PC');
+    expect(t.sub, 'user@LAB-PC');
+    expect(t.id, '123 456 789');
+  });
+
+  test('a suggestion without an alias is titled by the spaced ID only', () {
+    final t = hjvSuggestionTexts(
+        id: '123456789', alias: '', username: '', hostname: '');
+    expect(t.title, '123 456 789');
+    expect(t.sub, '');
