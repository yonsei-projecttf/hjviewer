+// HJViewer: the ID suggestions under the remote ID field (desktop and phone) in the app's look,
+// drawn like its menus: a card with a thin border, the large menu radius and the theme's menu
+// shadow, and each suggestion a small PC row with the cards' soft tile. AutocompletePeerTile and
+// the upstream panel stay as they are; the connection pages switch to this.
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjv_suggestions.dart';
