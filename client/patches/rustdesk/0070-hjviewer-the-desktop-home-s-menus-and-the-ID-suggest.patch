@@ -0,0 +1,31 @@
+// HJViewer: the sizes and texts of the ID suggestions under the remote ID field
+// (widgets/hjv_autocomplete.dart draws them). Plain Dart without the bridge, so that ci.sh tests
+// it with the web stand-in.
+
+import 'package:flutter_hbb/common/formatter/id_formatter.dart';
+
+/// The height of one suggestion and the panel's inner padding.
+const double kHjvSuggestionHeight = 48;
+const double kHjvSuggestionPadding = 4;
+
+/// The panel's height for `count` suggestions: up to four in full, more scroll under a half row.
+double hjvSuggestionsHeight(int count) {
+  if (count <= 0) return 0;
+  final rows = count > 4 ? 4.5 : count.toDouble();
+  return rows * kHjvSuggestionHeight + kHjvSuggestionPadding * 2;
+}
+
+/// A suggestion's texts: the title (the alias, else the ID with its spaces), the line under it
+/// (user@host, may be empty) and, beside an alias, the ID with its spaces at the row's end.
+({String title, String sub, String? id}) hjvSuggestionTexts(
+    {required String id,
+    required String alias,
+    required String username,
+    required String hostname}) {
+  final sub =
+      '$username${username.isNotEmpty && hostname.isNotEmpty ? '@' : ''}$hostname';
+  final spaced = formatID(id);
+  return alias.isEmpty
+      ? (title: spaced, sub: sub, id: null)
+      : (title: alias, sub: sub, id: spaced);
+}
