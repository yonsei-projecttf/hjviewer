+/// The panel the connection pages' optionsViewBuilder returns, as wide as the field.
+class HjvAutocompleteOptions extends StatelessWidget {
+  final Iterable<Peer> options;
+  final AutocompleteOnSelected<Peer> onSelected;
+  final bool loading;
+  final double width;
+
+  const HjvAutocompleteOptions({
+    Key? key,
+    required this.options,
+    required this.onSelected,
+    required this.loading,
+    required this.width,
+  }) : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    final p = HjvPalette.of(context);
+    final menu = Theme.of(context).popupMenuTheme;
+    final peers = options.toList(growable: false);
+    return Align(
+      alignment: Alignment.topLeft,
+      child: Padding(
+        padding: const EdgeInsets.only(top: 4),
+        child: Material(
+          color: p.card,
+          elevation: menu.elevation ?? 8,
+          shadowColor: menu.shadowColor,
+          surfaceTintColor: Colors.transparent,
+          shape: RoundedRectangleBorder(
+            borderRadius: BorderRadius.circular(12),
+            side: BorderSide(color: p.border),
+          ),
+          clipBehavior: Clip.antiAlias,
+          child: SizedBox(
+            width: width,
+            height: loading ? 80 : hjvSuggestionsHeight(peers.length),
+            child: loading
+                ? const Center(
+                    child: SizedBox(
+                        width: 20,
+                        height: 20,
+                        child: CircularProgressIndicator(strokeWidth: 2)))
+                : ListView(
+                    padding: const EdgeInsets.all(kHjvSuggestionPadding),
+                    children: peers
+                        .map((peer) => HjvSuggestionRow(
+                            peer: peer, onSelect: () => onSelected(peer)))
+                        .toList(),
+                  ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// One suggestion: the soft tile, the name with the online dot, user@host, the ID at the end.
+class HjvSuggestionRow extends StatelessWidget {
+  final Peer peer;
+  final VoidCallback onSelect;
+
+  const HjvSuggestionRow({Key? key, required this.peer, required this.onSelect})
+      : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    final p = HjvPalette.of(context);
+    final texts = hjvSuggestionTexts(
+        id: peer.id,
+        alias: peer.alias,
+        username: peer.username,
+        hostname: peer.hostname);
+    final (background, foreground) =
+        hjvTint(context, str2color('${peer.id}${peer.platform}'));
+    const tile = 32.0;
+    final colors = peer.tags
+        .take(25)
+        .map((e) => gFFI.abModel.getCurrentAbTagColor(e))
+        .toList();
+    final row = InkWell(
+      onTap: onSelect,
+      borderRadius: BorderRadius.circular(HjvRadius.sm),
+      hoverColor: p.hover,
+      child: Container(
+        height: kHjvSuggestionHeight,
+        padding: const EdgeInsets.symmetric(horizontal: 8),
+        child: Row(
+          children: [
+            Container(
+              width: tile,
+              height: tile,
+              alignment: Alignment.center,
+              decoration: BoxDecoration(
+                  color: background,
+                  borderRadius: BorderRadius.circular(tile * 0.28)),
+              child: hjvPlatformIcon(peer.platform, tile * 0.55, foreground),
+            ),
+            const SizedBox(width: 10),
+            Expanded(
+              child: Column(
+                mainAxisAlignment: MainAxisAlignment.center,
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Row(children: [
+                    getOnline(6, peer.online),
+                    Expanded(
+                      child: Text(
+                        texts.title,
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: HjvText.titleSmall.copyWith(
+                            color: p.text,
+                            fontFeatures:
+                                texts.id == null ? HjvText.tabular : null),
+                      ),
+                    ),
+                  ]),
+                  if (texts.sub.isNotEmpty)
+                    Text(
+                      texts.sub,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style:
+                          HjvText.bodySmall.copyWith(color: p.textSecondary),
+                    ),
+                ],
+              ),
+            ),
+            if (texts.id != null)
+              Padding(
+                padding: const EdgeInsets.only(left: 8),
+                child: Text(
+                  texts.id!,
+                  maxLines: 1,
+                  style: HjvText.bodySmall.copyWith(
+                      color: p.textSecondary, fontFeatures: HjvText.tabular),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+    return Tooltip(
+      message: !(isDesktop || isWebDesktop) || peer.tags.isEmpty
+          ? ''
+          : '${translate('Tags')}: ${peer.tags.join(', ')}',
+      child: Stack(children: [
+        row,
+        if (colors.isNotEmpty)
+          Positioned(
+            top: 6,
+            right: 8,
+            child: CustomPaint(painter: TagPainter(radius: 3, colors: colors)),
+          ),
+      ]),
+    );
+  }
+}
