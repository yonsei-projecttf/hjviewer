diff --git a/flutter/lib/models/soft_keyboard_input.dart b/flutter/lib/models/soft_keyboard_input.dart
index 6fa48fb..6ee559f 100644
--- a/flutter/lib/models/soft_keyboard_input.dart
+++ b/flutter/lib/models/soft_keyboard_input.dart
@@ -92,6 +92,22 @@ bool _isHighSurrogate(int codeUnit) => codeUnit >= 0xD800 && codeUnit <= 0xDBFF;
 bool softKeyboardFillerRunsLow(TextEditingValue value, {int minimum = 512}) =>
     !value.isComposingRangeValid && _fillerLength(value.text) < minimum;
 
+/// Whether the caret of the hidden iOS field has to go back to the end: the
+/// caret or the selection ends before the end (two keys pressed at once, the
+/// space-bar trackpad), where typing would replay filler characters.
+///
+/// A selection that ends at the end and lies in the typed text is the Korean
+/// keyboard's own. On a device (2026-10-15 log) it composes and deletes by
+/// selecting the jamo or syllable before the caret and replacing it, with no
+/// composing range; moving the caret in between broke that edit: the vowels
+/// of 한글입력 were lost, and a deleted jamo came back on every Backspace.
+bool softKeyboardCaretNeedsMoving(TextEditingValue value) {
+  final selection = value.selection;
+  if (value.isComposingRangeValid || !selection.isValid) return false;
+  if (selection.end != value.text.length) return true;
+  return !selection.isCollapsed && selection.start < _fillerLength(value.text);
+}
+
 /// The number of filler characters ('1', see remote_page.dart `initText`) the
 /// field starts with.
 int _fillerLength(String value) {
diff --git a/flutter/test/soft_keyboard_input_test.dart b/flutter/test/soft_keyboard_input_test.dart
index e945fa2..a21c8cf 100644
--- a/flutter/test/soft_keyboard_input_test.dart
+++ b/flutter/test/soft_keyboard_input_test.dart
@@ -115,6 +115,53 @@ void main() {
           (backspaces: 0, text: '11한'));
     });
 
+    test('the keyboard\'s own selection before the caret stays', () {
+      // A device log (2026-10-15): Backspace after 한글입력, which had lost
+      // its vowels, selected the last jamo, then deleted it, with no
+      // composing range. Moving the caret in between (sel 1032) made the
+      // keyboard put the jamo back on every later Backspace.
+      TextEditingValue at(String tail, int base,
+              [int? extent]) =>
+          TextEditingValue(
+              text: '$filler$tail',
+              selection: TextSelection(
+                  baseOffset: filler.length + base,
+                  extentOffset: filler.length + (extent ?? base)));
+      expect(softKeyboardCaretNeedsMoving(at('ㅎㄴㄱㄹㅇㅂㄹㄱ', 7, 8)), isFalse);
+      expect(softKeyboardCaretNeedsMoving(at('하', 0, 1)), isFalse);
+      expect(softKeyboardCaretNeedsMoving(at('하', 1)), isFalse);
+      // The trackpad or two keys at once: a caret or a selection that ends
+      // before the end, or reaches into the filler, still goes back.
+      expect(softKeyboardCaretNeedsMoving(at('하나', 1)), isTrue);
+      expect(softKeyboardCaretNeedsMoving(at('하나', 0, 1)), isTrue);
+      expect(softKeyboardCaretNeedsMoving(at('하', -3, 1)), isTrue);
+      expect(softKeyboardCaretNeedsMoving(at('', -5)), isTrue);
+      // Nothing while composing, or without a selection.
+      expect(
+          softKeyboardCaretNeedsMoving(value('하', composingFrom: 0).copyWith(
+              selection: TextSelection.collapsed(offset: filler.length))),
+          isFalse);
+      expect(softKeyboardCaretNeedsMoving(TextEditingValue(text: filler)),
+          isFalse);
+
+      // The settled edits of select-and-replace: composing 한 and deleting
+      // it jamo by jamo reach the remote side as it was typed.
+      final remote = _Remote(filler, shipped)
+        ..type('ㅎ')
+        ..apply(at('하', 1))
+        ..apply(at('한', 1))
+        ..apply(at('한ㄱ', 2))
+        ..apply(at('한그', 2))
+        ..apply(at('한글', 2));
+      expect(remote.text, '한글');
+      remote
+        ..apply(at('한그', 2))
+        ..apply(at('한ㄱ', 2))
+        ..apply(at('한', 1));
+      expect(remote.text, '한');
+      expect(remote.deletedBeforeStart, 0);
+    });
+
     test('Backspace on a committed syllable and on an empty field', () {
       expect(iosSoftKeyboardEdit('$filler한 ', value('한')),
           (backspaces: 1, text: ''));
