+/// E2 with hjv-api's wait: when a try may come again (Unix seconds by this device's clock, `now`
+/// the same), 0 for any other result and for a wait it did not say.
+int hjvRetryAt(String result, int now) {
+  if (hjvGuestFailure(result) != 'rate_limited') return 0;
+  final wait = hjvGuestNumber(result, 'retry_after');
+  return wait > 0 && wait <= _maxWait ? now + wait : 0;
+}
+
+/// Whether the access password's dialog (A1, P2) can send what is typed: something, while no
+/// exchange runs, and not before hjv-api takes a try again (`retryAt`, hjvRetryAt).
+bool hjvAccessCanSend(String typed,
+        {required bool busy, required int retryAt, required int now}) =>
+    !busy && hjvAccessPassword(typed).isNotEmpty && now >= retryAt;
+
+/// The error that dialog shows now: during E2's wait the time left, none once it is over, else
+/// the last try's.
+String? hjvAccessErrorNow(HjvAccessTexts t, String? error,
+        {required int retryAt, required int now}) =>
+    retryAt == 0
+        ? error
+        : now < retryAt
+            ? t.failure('rate_limited', wait: retryAt - now)
+            : null;
+
 /// Whether the PC home shows P1: while hbbs refuses this PC's registration. A server that checks
 /// nothing (MODE=off) never refuses, so the home stays as it was.
 bool hjvShowsPcNotice(String state) => state == 'refused';
