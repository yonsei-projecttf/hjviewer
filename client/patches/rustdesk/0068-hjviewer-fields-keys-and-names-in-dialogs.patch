+void _untilRetry(int retryAt, StateSetter setState, bool Function() closed) {
+  if (retryAt <= _unixNow()) return;
+  Timer.periodic(const Duration(seconds: 30), (timer) {
+    if (closed()) {
+      timer.cancel();
+      return;
+    }
