+    const now = 1760040000;
+    // something typed, no exchange running
+    expect(hjvAccessCanSend('pw', busy: false, retryAt: 0, now: now), isTrue);
+    expect(hjvAccessCanSend('  ', busy: false, retryAt: 0, now: now), isFalse);
+    expect(hjvAccessCanSend('pw', busy: true, retryAt: 0, now: now), isFalse);
+    // E2 with hjv-api's wait: off until it is over, the error naming the time left
+    final retryAt = hjvRetryAt(
+        '{"error":"rate_limited","ok":false,"retry_after":600}', now);
+    expect(retryAt, now + 600);
+    expect(hjvAccessCanSend('pw', busy: false, retryAt: retryAt, now: now + 60),
+        isFalse);
+    expect(hjvAccessErrorNow(ko, 'E2', retryAt: retryAt, now: now + 60),
+        '시도가 너무 많습니다. 약 9분 뒤 다시 해 주세요.');
+    expect(hjvAccessCanSend('pw', busy: false, retryAt: retryAt, now: retryAt),
+        isTrue);
+    expect(hjvAccessErrorNow(ko, 'E2', retryAt: retryAt, now: retryAt), isNull);
+    // no wait said, past two days, or another failure: no wait, the last error as it came
