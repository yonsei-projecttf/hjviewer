--- /dev/null
+++ b/src/hjviewer_cm.rs
@@ -0,0 +1,170 @@
+//! What the connection manager may say about who connects (TV-W2; docs/architecture.md 5-10). The
+//! process that takes the connection decides the mark and hands it to the `--cm` process in IPC
+//! `Login.hjv_mark`, apart from the name, so a name the peer typed can never draw a mark. The
+//! window draws a mark only for a kind it knows.
+
+use serde_derive::{Deserialize, Serialize};
+use unicode_normalization::UnicodeNormalization;
+
+/// A connection's mark: `kind` is "" (none), `same-account` (an accepted same-account proof; `who`
+/// is the signed list's masked owner), `staff` (TV-W6) or `unverified-name` (no proof, and the
+/// name imitates a mark); `who` is "" for every kind but `same-account`.
+#[derive(Debug, Default, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct HjvMark {
+    #[serde(default)]
+    pub kind: String,
+    #[serde(default)]
+    pub who: String,
+}
+
+pub const SAME_ACCOUNT: &str = "same-account";
+pub const UNVERIFIED_NAME: &str = "unverified-name";
+
+impl HjvMark {
+    pub fn same_account(who: &str) -> Self {
+        Self {
+            kind: SAME_ACCOUNT.to_owned(),
+            who: who.to_owned(),
+        }
+    }
+}
+
+/// The words of the marks the window draws, as `imitates_mark` folds them.
+const MARK_WORDS: [&str; 7] = [
+    "같은계정",
+    "sameaccount",
+    "확인됨",
+    "verified",
+    "교직원",
+    "staff",
+    "로그인확인",
+];
+
+/// For a login without an accepted proof: the name to show and its mark. Pinned builds strip
+/// control, bidi and zero-width characters from the shown name (logs keep the name as it came)
+/// and mark a name that imitates a mark; other builds pass the name as upstream does.
+pub fn unproven(name: &str) -> (String, HjvMark) {
+    unproven_in(crate::hjviewer::pinned(), name)
+}
+
+fn unproven_in(pinned: bool, name: &str) -> (String, HjvMark) {
+    if !pinned {
+        return (name.to_owned(), HjvMark::default());
+    }
+    let mut mark = HjvMark::default();
+    if imitates_mark(name) {
+        mark.kind = UNVERIFIED_NAME.to_owned();
+    }
+    (shown_name(name), mark)
+}
+
+/// Whether a name holds one of the marks' words once NFKC-normalized, lowercased and left with
+/// its letters and digits only (no white space, punctuation, symbols, format or control
+/// characters): "Same-Account", full-width "ｓａｍｅ" and "같\u{200B}은 계정" all do. Look-alike
+/// letters of other scripts (a Cyrillic "а") do not.
+fn imitates_mark(name: &str) -> bool {
+    let folded: String = name
+        .nfkc()
+        .flat_map(char::to_lowercase)
+        .filter(|c| c.is_alphanumeric())
+        .collect();
+    MARK_WORDS.iter().any(|word| folded.contains(word))
+}
+
+/// The name without control characters (Cc), zero-width characters and marks (U+200B-200F,
+/// U+FEFF) and bidi embeddings, overrides and isolates (U+202A-202E, U+2066-2069).
+fn shown_name(name: &str) -> String {
+    name.chars()
+        .filter(|&c| {
+            !(c.is_control()
+                || ('\u{200B}'..='\u{200F}').contains(&c)
+                || ('\u{202A}'..='\u{202E}').contains(&c)
+                || ('\u{2066}'..='\u{2069}').contains(&c)
+                || c == '\u{FEFF}')
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn names_that_imitate_a_mark() {
+        for name in ["홍길동", "DESKTOP-7Q2", "iPhone 14 Pro", "계정", "같은", "account", "연세대 PC"] {
+            assert!(!imitates_mark(name), "{name}");
+        }
+        for name in [
+            "iPhone 14 Pro · 같은 계정(홍*동)",
+            "Same-Account",
+            "SAME ACCOUNT",
+            "ｓａｍｅ ａｃｃｏｕｎｔ",
+            "같\u{200B}은 계정",
+            "같은\u{00A0}계정",
+            "확인됨",
+            "VERIFIED",
+            "연세대 교직원",
+            "Yonsei Staff",
+            "연세대 교직원(로그인 확인)",
+            "로그인 확인",
+        ] {
+            assert!(imitates_mark(name), "{name}");
+        }
+        // the decomposed (NFD) form composes again
+        let nfd: String = "같은 계정".nfd().collect();
+        assert_ne!(nfd, "같은 계정");
+        assert!(imitates_mark(&nfd));
+    }
+
+    #[test]
+    fn the_shown_name_loses_invisible_characters() {
+        assert_eq!(shown_name("\u{202E}abc\u{200B}d\u{7}"), "abcd");
+        assert_eq!(shown_name("a\u{2066}b\u{2069}\u{FEFF}c\u{200F}\n"), "abc");
+        assert_eq!(shown_name("홍길동의 PC 😀"), "홍길동의 PC 😀");
+    }
+
+    #[test]
+    fn unproven_names_in_pinned_and_other_builds() {
+        let odd = "\u{202E}Same account";
+        assert_eq!(unproven_in(false, odd), (odd.to_owned(), HjvMark::default()));
+        let (name, mark) = unproven_in(true, odd);
+        assert_eq!(name, "Same account");
+        assert_eq!(mark.kind, UNVERIFIED_NAME);
+        assert_eq!(mark.who, "");
+        assert_eq!(
+            unproven_in(true, "DESKTOP-7Q2"),
+            ("DESKTOP-7Q2".to_owned(), HjvMark::default())
+        );
+        // the tests build no pinned build
+        assert_eq!(unproven(odd), unproven_in(crate::hjviewer::pinned(), odd));
+    }
+
+    #[test]
+    fn marks_read_from_json() {
+        let mark: HjvMark = serde_json::from_str("{}").unwrap();
+        assert_eq!(mark, HjvMark::default());
+        let mark: HjvMark = serde_json::from_str(r#"{"kind":"later-kind","who":"x"}"#).unwrap();
+        assert_eq!(mark.kind, "later-kind");
+        assert_eq!(
+            serde_json::to_value(HjvMark::same_account("홍*동")).unwrap(),
+            serde_json::json!({"kind": "same-account", "who": "홍*동"})
+        );
+    }
+
+    #[test]
+    fn a_login_without_a_mark_reads_as_none() {
+        let mut login = serde_json::json!({"t": "Login", "c": {
+            "id": 1, "is_file_transfer": false, "is_view_camera": false, "is_terminal": false,
+            "peer_id": "123456789", "name": "PC", "avatar": "", "authorized": false,
+            "port_forward": "", "keyboard": true, "clipboard": true, "audio": true, "file": true,
+            "file_transfer_enabled": true, "restart": true, "recording": true,
+            "block_input": true, "privacy_mode": true, "from_switch": false}});
+        let read = |login: &serde_json::Value| match serde_json::from_value(login.clone()) {
+            Ok(crate::ipc::Data::Login { hjv_mark, .. }) => hjv_mark,
+            _ => panic!("not a login"),
+        };
+        assert_eq!(read(&login), HjvMark::default());
+        login["c"]["hjv_mark"] = serde_json::json!({"kind": "same-account", "who": "홍*동"});
+        assert_eq!(read(&login), HjvMark::same_account("홍*동"));
+    }
+}
