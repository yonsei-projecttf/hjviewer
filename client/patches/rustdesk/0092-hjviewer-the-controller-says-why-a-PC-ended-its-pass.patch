+/// The marks a 1.9.0 PC puts in the close reason of a password-less connection it ended (TV-W5,
+/// src/hjviewer_account/pc/sessions.rs): the device's login ended, or the PC takes no more
+/// password-less connections. "not allowed" also stops the reconnect of any controller.
+const hjvCutMarkLogin = 'login ended, not allowed';
+const hjvCutMarkPc = 'password-less ended, not allowed';
+
+/// A session's message box text (handleMsgBox): a close reason with a TV-W5 mark becomes this
+/// app's own words for it, the whole of it, so that a PC cannot show anything else with the
+/// mark; null for any other text, which shows as it came.
+String? hjvSessionCutText(HjvTexts t, String text) {
+  if (text.contains(hjvCutMarkPc)) return t.sessionCutPc;
+  if (text.contains(hjvCutMarkLogin)) return t.sessionCutLogin;
+  return null;
+}
