+#[test]
+fn a_change_that_fails_halfway_keeps_undo() {
+    let env = Fake::new(1800, 3600);
+    env.refuse_hibernate.set(Some(87));
+    assert_eq!(fix(&env, "sleep-never"), "failed");
+    // the standby time is 0 now: [되돌리기] stays, with the times from before
+    assert_eq!(env.times(), (0, 3600));
+    assert_eq!(read(&env, false, None)["sleep"]["was"], true);
+    env.refuse_hibernate.set(None);
+    assert_eq!(fix(&env, "sleep-undo"), "ok");
+    assert_eq!(env.times(), (1800, 3600));
+    assert_eq!(read(&env, false, None)["sleep"]["was"], false);
+}
