+/// GUID, which Group Policy's power.admx writes, and the braced form as well.
+fn policy_keys(setting: u128) -> [String; 2] {
+    let guid = format!(
+        "{:08X}-{:04X}-{:04X}-{:04X}-{:012X}",
+        setting >> 96,
+        (setting >> 80) & 0xffff,
+        (setting >> 64) & 0xffff,
+        (setting >> 48) & 0xffff,
+        setting & 0xffff_ffff_ffff
+    );
+    [format!(r"{POLICY}\{guid}"), format!(r"{POLICY}\{{{guid}}}")]
+}
