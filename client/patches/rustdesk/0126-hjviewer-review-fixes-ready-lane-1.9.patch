+#[test]
+fn the_policy_keys_are_the_bare_guid_that_group_policy_writes_and_the_braced_one() {
+    let base = r"SOFTWARE\Policies\Microsoft\Power\PowerSettings";
+    assert_eq!(
+        policy_keys(STANDBY_TIMEOUT),
+        [
+            format!(r"{base}\29F6C1DB-86DA-48C5-9FDB-F2B67B1F44DA"),
+            format!(r"{base}\{{29F6C1DB-86DA-48C5-9FDB-F2B67B1F44DA}}"),
+        ]
+    );
+    assert_eq!(
+        policy_keys(HIBERNATE_TIMEOUT)[0],
+        format!(r"{base}\9D7815A6-7EE4-497E-8888-515A05F02364")
+    );
