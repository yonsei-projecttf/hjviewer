diff --git a/src/client/hjv_end_lock.rs b/src/client/hjv_end_lock.rs
new file mode 100644
index 0000000..fc55f48
--- /dev/null
+++ b/src/client/hjv_end_lock.rs
@@ -0,0 +1,222 @@
+//! TV-W3 at the controller (docs/architecture.md 5-11): the own PC's end-of-session lock mode
+//! (automatic / always / never, kept per PC) and its 'hide the screen when connecting' switch.
+//! A child module of `client`, called from LoginConfigHandler and io_loop by one line each; the
+//! PC decides the lock (src/server/connection/hjv_end_lock.rs). A build not pinned to the
+//! hjviewer server sends nothing new and re-enables privacy mode as upstream does.
+
+use base::message_proto::{
+    option_message::{BoolOption, HjvEndLock},
+    OptionMessage,
+};
+use hbb_common::config::PeerConfig;
+
+/// PeerConfig option: "auto", "always" or "never"; empty = the own PC's default (automatic).
+pub(super) const OPTION: &str = "hjv-end-lock";
+/// PeerConfig option: "Y" = privacy mode after the first image of each own-PC session.
+pub(super) const HIDE: &str = "hjv-hide-on-connect";
+/// `sessionToggleOption` value prefix: choose and keep a mode (`hjv-end-lock:<mode>`).
+const CHOOSE: &str = "hjv-end-lock:";
+/// `sessionToggleOption` value: "do not lock on this close", sent but not kept (critic X-19, the
+/// phone's switch to the same PC's file transfer).
+const ONCE_NEVER: &str = "hjv-end-lock-once:never";
+/// upstream's switch, for a PC that does not know the automatic lock
+const UPSTREAM: &str = "lock-after-session-end";
+
+fn mode(v: &str) -> Option<HjvEndLock> {
+    match v {
+        "auto" => Some(HjvEndLock::HJV_END_LOCK_AUTO),
+        "always" => Some(HjvEndLock::HJV_END_LOCK_ALWAYS),
+        "never" => Some(HjvEndLock::HJV_END_LOCK_NEVER),
+        _ => None,
+    }
+}
+
+fn bool_option(yes: bool) -> BoolOption {
+    if yes {
+        BoolOption::Yes
+    } else {
+        BoolOption::No
+    }
+}
+
+/// LoginConfigHandler::toggle_option's first branch. true: handled here, `option` is filled and
+/// the caller saves `config` and sends the message as for upstream's switches. The upstream
+/// field goes along (`Yes` only for always), so that a 1.8.x PC knows always and never, and the
+/// upstream flag stays true only for always (should_auto_login). Upstream's own switch drops the
+/// kept mode, so that the last choice counts, and goes on as upstream.
+pub(super) fn toggle(name: &str, config: &mut PeerConfig, option: &mut OptionMessage) -> bool {
+    if name == UPSTREAM {
+        config.options.remove(OPTION);
+        return false;
+    }
+    if name == ONCE_NEVER {
+        option.hjv_end_lock = HjvEndLock::HJV_END_LOCK_NEVER.into();
+        option.lock_after_session_end = BoolOption::No.into();
+        return true;
+    }
+    let Some(v) = name.strip_prefix(CHOOSE) else {
+        return false;
+    };
+    // an unknown value is the default again (automatic)
+    let m = match mode(v) {
+        Some(m) => {
+            config.options.insert(OPTION.to_owned(), v.to_owned());
+            m
+        }
+        None => {
+            config.options.remove(OPTION);
+            HjvEndLock::HJV_END_LOCK_AUTO
+        }
+    };
+    let always = m == HjvEndLock::HJV_END_LOCK_ALWAYS;
+    config.lock_after_session_end.v = always;
+    option.hjv_end_lock = m.into();
+    option.lock_after_session_end = bool_option(always).into();
+    true
+}
+
+/// get_option_message: the kept mode goes with the login of a remote screen session.
+pub(super) fn login_option(config: &PeerConfig, msg: &mut OptionMessage) {
+    if let Some(m) = login_mode(crate::hjviewer::pinned(), config) {
+        msg.hjv_end_lock = m.into();
+    }
+}
+
+fn login_mode(pinned: bool, config: &PeerConfig) -> Option<HjvEndLock> {
+    if !pinned {
+        return None;
+    }
+    config.options.get(OPTION).and_then(|v| mode(v))
+}
+
+/// io_loop's privacy mode after the first image. Pinned: only an own-PC session (the PC sent
+/// `hjv_end_lock` in its platform additions) whose switch is on; upstream's "it was on when the
+/// last session ended" is no reason on any PC (decision D-10). Unpinned: upstream's value.
+pub(super) fn hide_on_connect(own: bool, stored: &str, upstream: bool) -> bool {
+    hide(crate::hjviewer::pinned(), own, stored, upstream)
+}
+
+fn hide(pinned: bool, own: bool, stored: &str, upstream: bool) -> bool {
+    if !pinned {
+        return upstream;
+    }
+    own && stored == "Y"
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn run(name: &str, config: &mut PeerConfig) -> (bool, OptionMessage) {
+        let mut option = OptionMessage::default();
+        let handled = toggle(name, config, &mut option);
+        (handled, option)
+    }
+
+    fn sent(o: &OptionMessage) -> (Result<HjvEndLock, i32>, Result<BoolOption, i32>) {
+        (o.hjv_end_lock.enum_value(), o.lock_after_session_end.enum_value())
+    }
+
+    #[test]
+    fn choosing_a_mode_keeps_it_and_sends_both_fields() {
+        let mut c = PeerConfig::default();
+        let (h, o) = run("hjv-end-lock:never", &mut c);
+        assert!(h);
+        assert_eq!(
+            sent(&o),
+            (Ok(HjvEndLock::HJV_END_LOCK_NEVER), Ok(BoolOption::No))
+        );
+        assert_eq!(c.options.get(OPTION).map(|s| s.as_str()), Some("never"));
+        assert!(!c.lock_after_session_end.v);
+
+        let (h, o) = run("hjv-end-lock:always", &mut c);
+        assert!(h);
+        assert_eq!(
+            sent(&o),
+            (Ok(HjvEndLock::HJV_END_LOCK_ALWAYS), Ok(BoolOption::Yes))
+        );
+        assert_eq!(c.options.get(OPTION).map(|s| s.as_str()), Some("always"));
+        assert!(c.lock_after_session_end.v);
+
+        let (h, o) = run("hjv-end-lock:auto", &mut c);
+        assert!(h);
+        assert_eq!(
+            sent(&o),
+            (Ok(HjvEndLock::HJV_END_LOCK_AUTO), Ok(BoolOption::No))
+        );
+        assert_eq!(c.options.get(OPTION).map(|s| s.as_str()), Some("auto"));
+        assert!(!c.lock_after_session_end.v);
+    }
+
+    #[test]
+    fn an_unknown_mode_is_the_default_again() {
+        let mut c = PeerConfig::default();
+        run("hjv-end-lock:always", &mut c);
+        let (h, o) = run("hjv-end-lock:", &mut c);
+        assert!(h);
+        assert_eq!(
+            sent(&o),
+            (Ok(HjvEndLock::HJV_END_LOCK_AUTO), Ok(BoolOption::No))
+        );
+        assert!(c.options.get(OPTION).is_none());
+        assert!(!c.lock_after_session_end.v);
+    }
+
+    #[test]
+    fn the_switch_close_sends_never_and_keeps_nothing() {
+        let mut c = PeerConfig::default();
+        run("hjv-end-lock:always", &mut c);
+        let (h, o) = run("hjv-end-lock-once:never", &mut c);
+        assert!(h);
+        assert_eq!(
+            sent(&o),
+            (Ok(HjvEndLock::HJV_END_LOCK_NEVER), Ok(BoolOption::No))
+        );
+        assert_eq!(c.options.get(OPTION).map(|s| s.as_str()), Some("always"));
+        assert!(c.lock_after_session_end.v);
+    }
+
+    #[test]
+    fn upstreams_switch_drops_the_kept_mode_and_goes_on() {
+        let mut c = PeerConfig::default();
+        run("hjv-end-lock:never", &mut c);
+        let (h, o) = run("lock-after-session-end", &mut c);
+        assert!(!h);
+        assert!(c.options.get(OPTION).is_none());
+        assert_eq!(sent(&o), (Ok(HjvEndLock::HJV_END_LOCK_UNSET), Ok(BoolOption::NotSet)));
+    }
+
+    #[test]
+    fn other_switches_are_not_handled_here() {
+        let mut c = PeerConfig::default();
+        let before = c.options.clone();
+        for name in ["privacy-mode", "view-only", "hjv-end-lockX", "hjv-hide-on-connect"] {
+            let (h, o) = run(name, &mut c);
+            assert!(!h, "{name}");
+            assert_eq!(o, OptionMessage::default());
+        }
+        assert_eq!(c.options, before);
+    }
+
+    #[test]
+    fn the_login_carries_a_kept_mode_only_when_pinned() {
+        let mut c = PeerConfig::default();
+        assert_eq!(login_mode(true, &c), None);
+        c.options.insert(OPTION.to_owned(), "never".to_owned());
+        assert_eq!(login_mode(true, &c), Some(HjvEndLock::HJV_END_LOCK_NEVER));
+        assert_eq!(login_mode(false, &c), None);
+        c.options.insert(OPTION.to_owned(), "".to_owned());
+        assert_eq!(login_mode(true, &c), None);
+    }
+
+    #[test]
+    fn hiding_on_connect_is_the_own_pcs_switch_when_pinned() {
+        // pinned: the switch of an own-PC session only; the last state counts nowhere
+        assert!(hide(true, true, "Y", false));
+        assert!(!hide(true, true, "", true));
+        assert!(!hide(true, false, "Y", true));
+        // unpinned: upstream's last state
+        assert!(hide(false, false, "", true));
+        assert!(!hide(false, true, "Y", false));
+    }
+}
