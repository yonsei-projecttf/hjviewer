diff --git a/flutter/lib/common/hjviewer_end_lock.dart b/flutter/lib/common/hjviewer_end_lock.dart
new file mode 100644
index 0000000..6011e45
--- /dev/null
+++ b/flutter/lib/common/hjviewer_end_lock.dart
@@ -0,0 +1,116 @@
+// TV-W3 at the controller (docs/architecture.md 5-11): the own PC's end-of-session lock mode, the
+// close button's lock mark, the 'hide the screen when connecting' switch and their texts in
+// Korean and English. Plain Dart without the bridge, so that ci.sh tests it with the web
+// stand-in; hjviewer_end_lock_ui.dart wires it into the session screens.
+
+/// PeerConfig option of an own PC: 'auto', 'always' or 'never'; empty = automatic.
+const kHjvEndLockOption = 'hjv-end-lock';
+
+/// PeerConfig option of an own PC: 'Y' = privacy mode after the first image of each session.
+const kHjvHideOnConnectOption = 'hjv-hide-on-connect';
+
+/// sessionToggleOption value: choose and keep a mode ('hjv-end-lock:<mode>').
+String hjvEndLockToggle(HjvEndLockMode mode) => 'hjv-end-lock:${mode.name}';
+
+/// sessionToggleOption value: "do not lock on this close", not kept; the phone's switch to the
+/// same PC's file transfer sends it just before it closes the remote screen (critic X-19).
+const kHjvEndLockOnceNever = 'hjv-end-lock-once:never';
+
+/// upstream's switch for a PC that does not know the automatic lock
+const kHjvUpstreamEndLockOption = 'lock-after-session-end';
+
+/// The PC's platform additions key: the PC knows the automatic lock and the session is an own
+/// PC's (a same-account proof let it in); `locked` = the PC was locked at the session's start.
+const kHjvEndLockAddition = 'hjv_end_lock';
+
+enum HjvEndLockMode { auto, always, never }
+
+bool hjvIsOwnSession(Map<String, dynamic> platformAdditions) =>
+    platformAdditions[kHjvEndLockAddition] is Map;
+
+bool hjvStartLocked(Map<String, dynamic> platformAdditions) {
+  final v = platformAdditions[kHjvEndLockAddition];
+  return v is Map && v['locked'] == true;
+}
+
+/// The mode in force: an own PC's kept value (empty or unknown = automatic); any other PC (or a
+/// PC older than 1.9) has upstream's switch only, which is always or never.
+HjvEndLockMode hjvEndLockMode(String stored,
+    {required bool own, required bool upstream}) {
+  if (!own) return upstream ? HjvEndLockMode.always : HjvEndLockMode.never;
+  for (final m in HjvEndLockMode.values) {
+    if (m.name == stored) return m;
+  }
+  return HjvEndLockMode.auto;
+}
+
+/// Whether the close button carries the lock (design w3 D10): only when the PC will lock for
+/// sure, that is always, or automatic and the PC said it was locked at the start; never without
+/// keyboard permission or in view-only mode, where the PC locks nothing.
+bool hjvEndLocks(
+        {required HjvEndLockMode mode,
+        required bool locked,
+        required bool keyboard,
+        required bool viewOnly}) =>
+    !viewOnly &&
+    keyboard &&
+    (mode == HjvEndLockMode.always ||
+        (mode == HjvEndLockMode.auto && locked));
+
+/// A 'Privacy mode' box that the switch's own attempt after the first image caused: a failure
+/// to turn it on (not one to turn it off, not the PC ending it), in an own-PC session whose
+/// switch is on, when the user did not turn privacy mode on by hand in the last ten seconds.
+/// It shows as a toast once per session instead (design w3 D9); a failure by hand stays a box.
+bool hjvHideFailQuiet(
+    {required String type,
+    required String text,
+    required bool own,
+    required bool hideOnConnect,
+    required Duration sinceByHand}) {
+  if (type != 'custom-error' || !own || !hideOnConnect) return false;
+  if (sinceByHand < const Duration(seconds: 10)) return false;
+  return !(text == 'Peer exit' ||
+      text == 'Turned off' ||
+      text.startsWith('Failed to turn off'));
+}
+
+class HjvEndLockTexts {
+  final bool korean;
+  const HjvEndLockTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  // T3-1, the own PC's submenu (desktop) and group (phone)
+  String get title =>
+      _t('끝나면 이 PC 잠그기', 'Lock this PC when the session ends');
+  // T3-2 to T3-4
+  String get auto => _t('자동 (연결할 때 잠겨 있었으면)',
+      'Automatic (if it was locked when I connected)');
+  String get always => _t('늘', 'Always');
+  String get never => _t('안 함', 'Never');
+  String mode(HjvEndLockMode m) => switch (m) {
+        HjvEndLockMode.auto => auto,
+        HjvEndLockMode.always => always,
+        HjvEndLockMode.never => never,
+      };
+
+  // T3-5, the close button with the lock: its tooltip and accessibility name, after the
+  // button's own name (desktop 닫기, phone 연결 끊기)
+  String closeLocks(String button) => _t('$button · 끝나면 PC를 잠급니다',
+      '$button · the PC locks when the session ends');
+  // T3-6, the line the phone's close confirmation adds
+  String get closeLine =>
+      _t('연결을 끝내면 PC를 잠급니다.', 'The PC locks when you end the session.');
+
+  // T3-7 and its tooltip T3-8
+  String get hide => _t('연결할 때 화면 가리기', 'Hide the screen when connecting');
+  String get hideTip => _t(
+      '이 PC에 연결할 때마다 PC 쪽 화면을 검게 가리고 PC 앞의 마우스와 키보드를 막습니다. 세션이 끝나면 풀립니다.',
+      "Each time you connect, this PC's own screen goes black and its mouse and keyboard are blocked until the session ends.");
+  // T3-9, once per session when the switch could not turn it on
+  String get hideFailed =>
+      _t('이 PC에서는 화면 가리기를 켜지 못했습니다.', "Could not hide this PC's screen.");
+  // T3-10, T3-7's tooltip when the PC does not allow privacy mode
+  String get hideDenied =>
+      _t('이 PC가 화면 가리기를 허락하지 않습니다.', 'This PC does not allow hiding its screen.');
+}
diff --git a/flutter/lib/common/hjviewer_end_lock_ui.dart b/flutter/lib/common/hjviewer_end_lock_ui.dart
new file mode 100644
index 0000000..6a61f6c
--- /dev/null
+++ b/flutter/lib/common/hjviewer_end_lock_ui.dart
@@ -0,0 +1,160 @@
+// TV-W3 in the session screens (docs/architecture.md 5-11): the own PC's lock mode menu, the
+// 'hide the screen when connecting' switch, the close button's lock mark and the phone's close
+// line. The rules and texts are in hjviewer_end_lock.dart; toolbar.dart, remote_toolbar.dart,
+// the phone's remote_page.dart, dialog.dart's clientClose and model.dart call in here.
+
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjviewer_end_lock.dart';
+import 'package:flutter_hbb/common/widgets/toolbar.dart';
+import 'package:flutter_hbb/models/model.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:get/get.dart';
+
+HjvEndLockTexts get hjvEndLockTexts =>
+    HjvEndLockTexts(translate('Cancel') == '취소');
+
+// A change of a lock choice in this app, so that the close buttons draw the mark again.
+final _changes = 0.obs;
+
+// The kept mode per session and PC (the phone's sessions share one session ID).
+final _stored = <String, String>{};
+
+String _key(FFI ffi, String id) => '${ffi.sessionId} $id';
+
+/// For an Obx around a close button: it draws again when a lock choice changes.
+void hjvEndLockWatch() => _changes.value;
+
+/// After upstream's own switch changed (a PC that does not know the automatic lock).
+void hjvEndLockChanged() => _changes.value++;
+
+bool _ownSession(FFI ffi) =>
+    ffi.connType == ConnType.defaultConn &&
+    !ffi.ffiModel.isPeerAndroid &&
+    hjvIsOwnSession(ffi.ffiModel.pi.platformAdditions);
+
+HjvEndLockMode _mode(FFI ffi, String id) {
+  final own = hjvIsOwnSession(ffi.ffiModel.pi.platformAdditions);
+  final stored = own
+      ? _stored.putIfAbsent(_key(ffi, id),
+          () => bind.mainGetPeerOptionSync(id: id, key: kHjvEndLockOption))
+      : '';
+  final upstream = !own &&
+      bind.sessionGetToggleOptionSync(
+          sessionId: ffi.sessionId, arg: kHjvUpstreamEndLockOption);
+  return hjvEndLockMode(stored, own: own, upstream: upstream);
+}
+
+/// Whether ending this session now locks the PC for sure (the close button's lock mark).
+bool hjvEndLockLocksNow(FFI ffi, String id) {
+  final m = ffi.ffiModel;
+  if (ffi.connType != ConnType.defaultConn || m.isPeerAndroid) return false;
+  return hjvEndLocks(
+      mode: _mode(ffi, id),
+      locked: hjvStartLocked(m.pi.platformAdditions),
+      keyboard: m.keyboard,
+      viewOnly: m.viewOnly);
+}
+
+/// The own PC's three modes (T3-1 to T3-4); empty for any other session, which keeps upstream's
+/// switch. Greyed in view-only mode and without keyboard permission.
+List<TRadioMenu<String>> hjvEndLockRadios(FFI ffi, String id) {
+  if (!_ownSession(ffi)) return [];
+  final t = hjvEndLockTexts;
+  final m = ffi.ffiModel;
+  final group = _mode(ffi, id).name;
+  final enabled = !m.viewOnly && m.keyboard;
+  onChanged(String? v) async {
+    if (v == null) return;
+    final mode = HjvEndLockMode.values.firstWhere((e) => e.name == v,
+        orElse: () => HjvEndLockMode.auto);
+    _stored[_key(ffi, id)] = mode.name;
+    await bind.sessionToggleOption(
+        sessionId: ffi.sessionId, value: hjvEndLockToggle(mode));
+    hjvEndLockChanged();
+  }
+
+  return [
+    for (final mode in HjvEndLockMode.values)
+      TRadioMenu<String>(
+          child: Text(t.mode(mode)),
+          value: mode.name,
+          groupValue: group,
+          onChanged: enabled ? onChanged : null),
+  ];
+}
+
+/// T3-7 for an own PC whose privacy mode menu shows: kept per PC, it does not change this
+/// session (the privacy mode switch next to it does). Greyed with T3-10 when the PC does not
+/// allow privacy mode.
+TToggleMenu? hjvHideOnConnectToggle(FFI ffi, String id) {
+  final m = ffi.ffiModel;
+  if (!_ownSession(ffi) || !m.pi.features.privacyMode || !m.keyboard) {
+    return null;
+  }
+  final t = hjvEndLockTexts;
+  final allowed = m.permissions['privacy_mode'] != false;
+  return TToggleMenu(
+      value: bind.mainGetPeerOptionSync(id: id, key: kHjvHideOnConnectOption) ==
+          'Y',
+      onChanged: allowed
+          ? (v) {
+              if (v == null) return;
+              bind.sessionPeerOption(
+                  sessionId: ffi.sessionId,
+                  name: kHjvHideOnConnectOption,
+                  value: v ? 'Y' : '');
+            }
+          : null,
+      child: Tooltip(
+          message: allowed ? t.hideTip : t.hideDenied, child: Text(t.hide)));
+}
+
+/// The lock drawn on the close icon's lower right: 10 px, the button's red, a ring in the
+/// card colour.
+Widget hjvEndLockBadge(BuildContext context, Widget icon) {
+  final p = HjvPalette.of(context);
+  return Stack(clipBehavior: Clip.none, children: [
+    icon,
+    Positioned(
+        right: 0,
+        bottom: 0,
+        child: ExcludeSemantics(
+            child: Container(
+                decoration: BoxDecoration(color: p.card, shape: BoxShape.circle),
+                padding: const EdgeInsets.all(1),
+                child:
+                    Icon(Icons.lock_rounded, size: 10, color: p.danger)))),
+  ]);
+}
+
+/// clientClose's text on the phone: T3-6 after it when ending the session locks the PC.
+String hjvEndLockCloseText(FFI ffi, String text) {
+  if (!hjvEndLockLocksNow(ffi, ffi.id)) return text;
+  return '${translate(text)}\n\n${hjvEndLockTexts.closeLine}';
+}
+
+final _toasted = Expando<bool>();
+
+/// model.dart's handleMsgBox, before its 'Privacy mode' box: true when the box is not shown,
+/// because the switch's own attempt failed (T3-9 once per session instead, design w3 D9).
+bool hjvEndLockQuiet(FFI? ffi, String peerId, String type, String text) {
+  if (ffi == null) return false;
+  final pi = ffi.ffiModel.pi;
+  if (!hjvHideFailQuiet(
+      type: type,
+      text: text,
+      own: _ownSession(ffi),
+      hideOnConnect:
+          bind.mainGetPeerOptionSync(id: peerId, key: kHjvHideOnConnectOption) ==
+              'Y',
+      sinceByHand: DateTime.now().difference(togglePrivacyModeTime))) {
+    return false;
+  }
+  if (_toasted[pi] != true) {
+    _toasted[pi] = true;
+    showToast(hjvEndLockTexts.hideFailed);
+  }
+  return true;
+}
