diff --git a/flutter/test/hjviewer_end_lock_test.dart b/flutter/test/hjviewer_end_lock_test.dart
new file mode 100644
index 0000000..8e8dcc5
--- /dev/null
+++ b/flutter/test/hjviewer_end_lock_test.dart
@@ -0,0 +1,100 @@
+import 'package:flutter_hbb/common/hjviewer_end_lock.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The controller's end-of-session lock (TV-W3): the mode in force, the close button's lock mark,
+// the quiet failure of 'hide the screen when connecting' and the texts, without the bridge.
+
+void main() {
+  const own = {
+    'hjv_end_lock': {'v': 1, 'locked': true}
+  };
+  const ownUnlocked = {
+    'hjv_end_lock': {'v': 1, 'locked': false}
+  };
+
+  test('an own session is one whose PC sent hjv_end_lock', () {
+    expect(hjvIsOwnSession(own), isTrue);
+    expect(hjvIsOwnSession({}), isFalse);
+    expect(hjvIsOwnSession({'hjv_end_lock': true}), isFalse);
+    expect(hjvStartLocked(own), isTrue);
+    expect(hjvStartLocked(ownUnlocked), isFalse);
+    expect(hjvStartLocked({}), isFalse);
+  });
+
+  test('an own PC is automatic by default; other PCs have upstream switch', () {
+    HjvEndLockMode m(String s, {bool own = true, bool upstream = false}) =>
+        hjvEndLockMode(s, own: own, upstream: upstream);
+    expect(m(''), HjvEndLockMode.auto);
+    expect(m('auto'), HjvEndLockMode.auto);
+    expect(m('always'), HjvEndLockMode.always);
+    expect(m('never'), HjvEndLockMode.never);
+    expect(m('later'), HjvEndLockMode.auto);
+    expect(m('', upstream: true), HjvEndLockMode.auto);
+    expect(m('always', own: false), HjvEndLockMode.never);
+    expect(m('', own: false, upstream: true), HjvEndLockMode.always);
+    expect(hjvEndLockToggle(HjvEndLockMode.never), 'hjv-end-lock:never');
+  });
+
+  test('the close button carries the lock only when the PC locks for sure', () {
+    bool locks(HjvEndLockMode mode,
+            {bool locked = true, bool keyboard = true, bool viewOnly = false}) =>
+        hjvEndLocks(
+            mode: mode, locked: locked, keyboard: keyboard, viewOnly: viewOnly);
+    expect(locks(HjvEndLockMode.always, locked: false), isTrue);
+    expect(locks(HjvEndLockMode.auto), isTrue);
+    expect(locks(HjvEndLockMode.auto, locked: false), isFalse);
+    expect(locks(HjvEndLockMode.never), isFalse);
+    for (final mode in HjvEndLockMode.values) {
+      expect(locks(mode, keyboard: false), isFalse);
+      expect(locks(mode, viewOnly: true), isFalse);
+    }
+  });
+
+  test('only the switch attempt failing to turn privacy mode on is quiet', () {
+    bool quiet(String text,
+            {String type = 'custom-error',
+            bool own = true,
+            bool hide = true,
+            int byHand = 60}) =>
+        hjvHideFailQuiet(
+            type: type,
+            text: text,
+            own: own,
+            hideOnConnect: hide,
+            sinceByHand: Duration(seconds: byHand));
+    for (final text in ['Failed', 'Peer denied', 'Unsupported', 'No display']) {
+      expect(quiet(text), isTrue, reason: text);
+    }
+    for (final text in ['Peer exit', 'Turned off', 'Failed to turn off']) {
+      expect(quiet(text), isFalse, reason: text);
+    }
+    expect(quiet('Enter privacy mode', type: 'custom-nocancel'), isFalse);
+    expect(quiet('Failed', own: false), isFalse);
+    expect(quiet('Failed', hide: false), isFalse);
+    expect(quiet('Failed', byHand: 3), isFalse);
+  });
+
+  test('the texts come in Korean and English', () {
+    const ko = HjvEndLockTexts(true);
+    const en = HjvEndLockTexts(false);
+    expect(ko.title, '끝나면 이 PC 잠그기');
+    expect(en.title, 'Lock this PC when the session ends');
+    expect(ko.mode(HjvEndLockMode.auto), '자동 (연결할 때 잠겨 있었으면)');
+    expect(en.mode(HjvEndLockMode.never), 'Never');
+    expect(ko.closeLocks('닫기'), '닫기 · 끝나면 PC를 잠급니다');
+    expect(en.closeLocks('Close'), 'Close · the PC locks when the session ends');
+    expect(ko.closeLine, '연결을 끝내면 PC를 잠급니다.');
+    final pairs = [
+      (ko.always, en.always),
+      (ko.hide, en.hide),
+      (ko.hideTip, en.hideTip),
+      (ko.hideFailed, en.hideFailed),
+      (ko.hideDenied, en.hideDenied),
+    ];
+    for (final (k, e) in pairs) {
+      expect(k, isNot(e));
+      expect(k, isNotEmpty);
+      expect(e, isNotEmpty);
+    }
+  });
+}
