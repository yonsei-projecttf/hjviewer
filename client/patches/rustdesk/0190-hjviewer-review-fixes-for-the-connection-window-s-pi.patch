diff --git a/src/ipc.rs b/src/ipc.rs
index b6d3dcf..67f3c4f 100644
--- a/src/ipc.rs
+++ b/src/ipc.rs
@@ -701,7 +701,51 @@ pub(crate) async fn start_with_listener(postfix: &str, mut incoming: Incoming) {
 #[cfg(windows)]
 #[inline]
 fn is_windows_protected_ipc(postfix: &str) -> bool {
-    ipc_auth::is_windows_main_or_service_ipc(postfix) || postfix == ipc_windows::CM_POSTFIX
+    ipc_auth::is_windows_main_or_service_ipc(postfix) || is_cm_postfix(postfix)
+}
+
+/// The connection window's pipe: the window (`--cm`) serves it, the `--server` hands it each
+/// incoming connection, and the main window sends it theme and language changes.
+const CM_POSTFIX: &str = "_cm";
+
+/// The postfix of the connection window's pipe for this process.
+///
+/// Windows pipe names are one namespace for every session, so a window left open in another
+/// session (fast user switching, a disconnected remote desktop session) would hold a single name
+/// and the `--server` of this session, which refuses it, could show no connection until that
+/// window is closed. Every process of the window's session (the window, the `--server` that
+/// starts it there, its clipboard and privacy mode, the main window) therefore uses the name of
+/// its own session. Linux and macOS keep `_cm`: their socket lives in a directory per user.
+pub(crate) fn cm_postfix() -> String {
+    #[cfg(windows)]
+    {
+        cm_postfix_for_session(crate::platform::windows::get_current_process_session_id())
+    }
+    #[cfg(not(windows))]
+    {
+        CM_POSTFIX.to_owned()
+    }
+}
+
+/// `_cm_s<session>`, or `_cm` when the session is unknown (both sides fall back alike).
+#[cfg(any(windows, test))]
+fn cm_postfix_for_session(session: Option<u32>) -> String {
+    match session {
+        Some(session) => format!("{CM_POSTFIX}_s{session}"),
+        None => CM_POSTFIX.to_owned(),
+    }
+}
+
+/// Whether `postfix` names a connection window's pipe, of any session.
+#[cfg(any(windows, test))]
+fn is_cm_postfix(postfix: &str) -> bool {
+    match postfix.strip_prefix(CM_POSTFIX) {
+        Some("") => true,
+        Some(rest) => rest.strip_prefix("_s").map_or(false, |session| {
+            !session.is_empty() && session.bytes().all(|b| b.is_ascii_digit())
+        }),
+        None => false,
+    }
 }
 
 pub async fn new_listener(postfix: &str) -> ResultType<Incoming> {
@@ -2328,12 +2372,29 @@ mod test {
         assert!(!is_endpoint_missing(&refused.unwrap_err()));
     }
 
+    #[test]
+    fn test_cm_postfix_names_the_session() {
+        assert_eq!(cm_postfix_for_session(Some(1)), "_cm_s1");
+        assert_eq!(cm_postfix_for_session(Some(0)), "_cm_s0");
+        assert_eq!(cm_postfix_for_session(None), "_cm");
+        assert!(is_cm_postfix(&cm_postfix_for_session(Some(4294967295))));
+        assert!(is_cm_postfix("_cm"));
+        assert!(is_cm_postfix(&cm_postfix()));
+        for other in ["", "_service", "_cm_s", "_cm_", "_cm_sx", "_cm_s1_", "_cmd", "_cm_1", "cm_s1"] {
+            assert!(!is_cm_postfix(other), "{other}");
+        }
+        #[cfg(not(windows))]
+        assert_eq!(cm_postfix(), "_cm");
+    }
+
     #[cfg(windows)]
     #[test]
     fn test_windows_protected_ipc_includes_connection_window() {
         assert!(is_windows_protected_ipc(""));
         assert!(is_windows_protected_ipc(crate::POSTFIX_SERVICE));
         assert!(is_windows_protected_ipc("_cm"));
+        assert!(is_windows_protected_ipc(&cm_postfix()));
+        assert!(is_windows_protected_ipc("_cm_s2"));
         assert!(!is_windows_protected_ipc("_portable_service"));
         assert!(!is_windows_protected_ipc("_pa"));
         assert!(!is_windows_protected_ipc("_whiteboard"));
