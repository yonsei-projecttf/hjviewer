+          t.deleteAccountIntro,
+          t.deleteAccountPcs,
+          t.deleteAccountDevices,
+          t.deleteAccountData,
+          t.deleteAccountKept,
+          t.deleteAccountFresh,
+          t.deleteAccountGate,
+          t.deleteAccountGateMaybe,
+          t.deleteAccountWord,
+          t.deleteAccountBusy,
+          t.deleteAccountUnsupported,
+          t.accountDeletedText,
+        ]) {
+          expect(text.trim(), isNotEmpty);
+          expect(text, isNot(contains('{')));
+          expect(text, isNot(contains('}')));
+        }
+      }
+    });
+  });
