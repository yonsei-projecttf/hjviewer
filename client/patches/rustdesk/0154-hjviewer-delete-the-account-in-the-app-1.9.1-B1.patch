+/// Whether the deletion's confirmation has its word (1.9.1, B1): '삭제' on a Korean screen,
+/// 'delete' in any case on an English one, the spaces around it aside. A word a Korean input
+/// method is still composing is in the field's text already.
+bool hjvDeleteConfirmed(HjvTexts t, String typed) {
+  final word = typed.trim();
+  return t.korean
+      ? word == t.deleteAccountWord
+      : word.toLowerCase() == t.deleteAccountWord;
+}
+
+/// The deletion's paragraph about the account's PCs on a staff-only server, as L2 has its line:
+/// sure, while the server's mode is not known (null), or none on a server open to everyone.
+String? hjvDeleteAccountGateNote(HjvTexts t, {required bool? gateCloses}) =>
+    switch (gateCloses) {
+      true => t.deleteAccountGate,
+      null => t.deleteAccountGateMaybe,
+      false => null,
+    };
+
+/// What the confirmation's error line says after hjv-api's answer to the deletion; null when it
+/// deleted the account (also an overlapping request's answer, with nothing left to count). A 404
+/// comes from an hjv-api without the path. The caller takes a 401 as the end of the login.
+String? hjvDeleteAccountError(HjvTexts t, int status, Object? body) {
+  if (status == 200) {
+    return body is Map && body['deleted'] == true ? null : t.requestFailed;
+  }
+  return status == 404 ? t.deleteAccountUnsupported : hjvRequestError(t, body);
+}
