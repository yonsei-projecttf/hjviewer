+// ---- deleting the account (1.9.1, B1) ----
+
+/// hjv-api's deletion of the login's account (server/api/src/account.rs), signed by H13 as the
+/// other self-service requests; its fixed body keeps a stray POST from deleting anything.
+const _kDeleteAccountPath = '/api/hjv/account/delete';
+const _kDeleteAccountBody = '{"confirm":"delete-account"}';
+
+/// While the deletion waits for its answer, a 401 that ends the login (its own or another
+/// request's) only notes it here (hjvLoginEnded).
+var _accountDeleting = false;
+var _endedDuringDelete = false;
+
+/// The desktop account card's [계정 삭제]: a quiet button with the danger colour's icon and words;
+/// the filled danger button is the confirmation's.
+Widget _deleteAccountButton(BuildContext context, HjvTexts t) {
+  final p = HjvPalette.of(context);
+  return OutlinedButton.icon(
+      style: OutlinedButton.styleFrom(foregroundColor: p.dangerText),
+      onPressed: _askDeleteAccount,
+      icon: Icon(Icons.person_remove_outlined, size: 18, color: p.danger),
+      label: Text(t.deleteAccount));
+}
+
+/// [계정 삭제]'s confirmation: what goes and what stays, then the word to type in before
+/// [계정 삭제] sends the request. While it waits, neither [취소], a back press nor Esc closes it.
+void _askDeleteAccount() {
+  final t = _t;
+  final gate = hjvDeleteAccountGateNote(t, gateCloses: hjvAccessGateCloses());
+  final word = TextEditingController();
+  var busy = false;
+  var closed = false;
+  String? error;
+  void Function([dynamic])? closeDialog;
+  final dialog = gFFI.dialogManager.show<void>((setState, close, context) {
+    closeDialog = close;
+    final p = HjvPalette.of(context);
+    final failure = error;
+
+    Future<void> submit() async {
+      if (busy || !hjvDeleteConfirmed(t, word.text)) return;
+      setState(() {
+        busy = true;
+        error = null;
+      });
+      final failed = await _deleteAccount(t, close);
+      if (failed != null && !closed) {
+        setState(() {
+          busy = false;
+          error = failed;
+        });
+      }
+    }
+
+    return CustomAlertDialog(
+      title: HjvDialogTitle(Icons.warning_amber_rounded, t.deleteAccountTitle,
+          danger: true),
+      contentBoxConstraints: HjvDialogWidth.box(HjvDialogWidth.md),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Text(hjvKeepAll(t.deleteAccountIntro)),
+          for (final item in [
+            t.deleteAccountPcs,
+            t.deleteAccountDevices,
+            t.deleteAccountData,
+            t.deleteAccountKept,
+          ])
+            Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
+              const ExcludeSemantics(child: Text('•')),
+              const SizedBox(width: 8),
+              Expanded(child: Text(hjvKeepAll(item))),
+            ]).marginOnly(top: 4),
+          Text(hjvKeepAll(t.deleteAccountFresh)).marginOnly(top: 8),
+          if (gate != null) Text(hjvKeepAll(gate)).marginOnly(top: 8),
+          ExcludeSemantics(child: Text(hjvKeepAll(t.deleteAccountType)))
+              .marginOnly(top: 12),
+          Semantics(
+            label: t.deleteAccountType,
+            child: TextField(
+              controller: word,
+              enabled: !busy,
+              // a phone shows the text first; a press on the field brings the keyboard
+              autofocus: isDesktop,
+              autocorrect: false,
+              enableSuggestions: false,
+              textInputAction: TextInputAction.done,
+              decoration: InputDecoration(hintText: t.deleteAccountWord),
+              onSubmitted: (_) => submit(),
+            ),
+          ).marginOnly(top: 8),
+          if (failure != null)
+            Semantics(
+              liveRegion: true,
+              child: Text(hjvKeepAll(failure),
+                  style: TextStyle(color: p.dangerText)),
+            ).marginOnly(top: 8),
+          if (busy)
+            Row(children: [
+              Expanded(
+                  child: LinearProgressIndicator(
+                      semanticsLabel: t.deleteAccountBusy.replaceAll('…', ''))),
+              const SizedBox(width: 8),
+              ExcludeSemantics(
+                  child: Text(t.deleteAccountBusy,
+                      style: HjvText.caption.copyWith(color: p.textSecondary))),
+            ]).marginOnly(top: 12),
+        ],
+      ),
+      actions: [
+        _button(t.cancel, busy ? null : close, outline: true),
+        ValueListenableBuilder<TextEditingValue>(
+            valueListenable: word,
+            builder: (_, value, __) => _button(t.deleteAccount,
+                !busy && hjvDeleteConfirmed(t, value.text) ? submit : null,
+                danger: true)),
+      ],
+      onSubmit: submit,
+      onCancel: busy ? null : close,
+    );
+  }, onBack: () {
+    if (!busy) closeDialog?.call();
+  });
+  unawaited(dialog.whenComplete(() => closed = true).catchError((Object e) {
+    debugPrint('hjv: $e');
+  }));
+}
+
+/// The deletion's request; null once the confirmation closed. On hjv-api's 200 Rust (H14) has
+/// logged this device out already: the screens follow without L4, and the result takes the
+/// confirmation's place. A 401 that ended the login meanwhile closes it for L4. Else the
+/// confirmation stays with the text this returns, and the word typed in.
+Future<String?> _deleteAccount(
+    HjvTexts t, void Function([dynamic]) close) async {
+  _accountDeleting = true;
+  _endedDuringDelete = false;
+  try {
+    String? failure;
+    try {
+      final (code, body) = await _request('POST', _kDeleteAccountPath,
+          json: _kDeleteAccountBody);
+      failure = hjvDeleteAccountError(t, code, body);
+    } catch (e) {
+      // the server may have deleted the account and only the answer got lost: another try
+      // gets the 401 of the token it ended, and so L4
+      failure = hjvFailure(t, e);
+    }
+    if (failure == null) {
+      await gFFI.userModel.reset(resetOther: true, hjvLoggedOut: true);
+      _loginEnded = false;
+      close();
+      _showAccountDeleted(t);
+      return null;
+    }
+    if (_endedDuringDelete) {
+      close();
+      _loginEnded = true;
+      _announceRelogin();
+      return null;
+    }
+    return failure;
+  } finally {
+    _accountDeleting = false;
+    _endedDuringDelete = false;
+  }
+}
+
+void _showAccountDeleted(HjvTexts t) =>
+    unawaited(_show<void>((setState, close, context) => CustomAlertDialog(
+          contentBoxConstraints: HjvDialogWidth.box(HjvDialogWidth.md),
+          title: Text(t.accountDeletedTitle),
+          content: Text(hjvKeepAll(t.accountDeletedText)),
+          actions: [_button(t.ok, close)],
+          onSubmit: close,
+          onCancel: close,
+        )));
+
 /// A card's PC as its dialogs name it.
 String _nameOf(Peer peer) => peer.alias.isNotEmpty
     ? peer.alias
@@ -1643,6 +1838,11 @@ void hjvLoginEnded() {
   if (!_accountBuild || bind.mainGetLocalOption(key: 'access_token').isEmpty) {
     return;
   }
+  // the account's deletion tells it once its own answer is in, not over its dialog
+  if (_accountDeleting) {
+    _endedDuringDelete = true;
+    return;
+  }
   _loginEnded = true;
 }
 
