 // iOS read alike. Plain Flutter without the bridge.
 
 import 'package:flutter/material.dart';
+import 'package:flutter/semantics.dart';
 
 /// The typeface every text uses, bundled in assets/fonts (Regular 400, SemiBold 600, Bold 700).
 const String kHjvFont = 'Pretendard';
@@ -195,3 +196,89 @@ BoxDecoration hjvCardDecoration(BuildContext context,
     hsl.withSaturation((hsl.saturation * 0.85).clamp(0.0, 1.0)).withLightness(0.42).toColor(),
   );
 }
+
+/// How long a toast stays: `least` (3 seconds) and about 70 ms a character more, at most 8 seconds
+/// (or `least` when that is longer), so that a sentence of the gate can be read to its end.
+Duration hjvToastTime(String text,
+    {Duration least = const Duration(seconds: 3)}) {
+  final ms = least.inMilliseconds + 70 * text.runes.length;
+  final most = least.inMilliseconds > 8000 ? least.inMilliseconds : 8000;
+  return Duration(milliseconds: ms < most ? ms : most);
+}
+
+/// A toast in the theme's snack bar look (hjv_theme.dart's snackBarTheme): opaque, the inverse
+/// colours, the app's typeface at 14, the medium radius, at most 480 wide, kept above the
+/// keyboard and the system bars. It takes no taps.
+class HjvToast extends StatelessWidget {
+  final String text;
+  final Alignment alignment;
+  const HjvToast(this.text,
+      {super.key, this.alignment = const Alignment(0.0, 0.8)});
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final dark = theme.brightness == Brightness.dark;
+    final bar = theme.snackBarTheme;
+    final media = MediaQuery.maybeOf(context);
+    final insets = media?.viewInsets.bottom ?? 0;
+    final padding = media?.viewPadding ?? EdgeInsets.zero;
+    return IgnorePointer(
+      child: Padding(
+        padding: EdgeInsets.fromLTRB(16, padding.top, 16,
+            insets > padding.bottom ? insets : padding.bottom),
+        child: Align(
+          alignment: alignment,
+          child: ConstrainedBox(
+            constraints: const BoxConstraints(maxWidth: 480),
+            child: Material(
+              type: MaterialType.transparency,
+              child: Container(
+                padding:
+                    const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
+                decoration: BoxDecoration(
+                  color: bar.backgroundColor ??
+                      (dark ? const Color(0xFFE6E9EE) : const Color(0xFF2B313B)),
+                  borderRadius: BorderRadius.circular(HjvRadius.md),
+                ),
+                child: Text(
+                  text,
+                  textAlign: TextAlign.center,
+                  style: TextStyle(
+                      fontFamily: kHjvFont,
+                      fontSize: 14,
+                      fontWeight: FontWeight.w500,
+                      height: 1.4,
+                      decoration: TextDecoration.none,
+                      color: bar.contentTextStyle?.color ??
+                          (dark ? const Color(0xFF191F28) : Colors.white)),
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+OverlayEntry? _toast;
+
+/// common.dart's showToast: `text` as an HjvToast on `overlay` for hjvToastTime, read out to a
+/// screen reader; a new toast takes the place of the one before.
+void hjvShowToast(OverlayState overlay, String text,
+    {Duration least = const Duration(seconds: 3),
+    Alignment alignment = const Alignment(0.0, 0.8)}) {
+  _toast?.remove();
+  final entry = OverlayEntry(
+      builder: (context) => HjvToast(text, alignment: alignment));
+  _toast = entry;
+  overlay.insert(entry);
+  SemanticsService.announce(
+      text, Directionality.maybeOf(overlay.context) ?? TextDirection.ltr);
+  Future.delayed(hjvToastTime(text, least: least), () {
+    if (_toast != entry) return;
+    entry.remove();
+    _toast = null;
+  });
+}
