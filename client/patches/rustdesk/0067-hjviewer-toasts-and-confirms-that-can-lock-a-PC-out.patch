diff --git a/flutter/test/hjviewer_toast_test.dart b/flutter/test/hjviewer_toast_test.dart
new file mode 100644
index 0000000..ef9a599
--- /dev/null
+++ b/flutter/test/hjviewer_toast_test.dart
@@ -0,0 +1,62 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The toast of the app's look (common/hjv_style.dart, which common.dart's showToast shows), plain
+// Flutter without the bridge.
+
+void main() {
+  test('a toast stays 3 seconds and about 70 ms a character more, up to 8', () {
+    expect(hjvToastTime(''), const Duration(seconds: 3));
+    expect(hjvToastTime('복사되었습니다'), const Duration(milliseconds: 3490));
+    // A1's toast: long enough to read to its end
+    const a1 = '이용 비밀번호를 확인했습니다. PC가 비밀번호를 물으면 그 PC의 비밀번호를 넣으세요.';
+    expect(hjvToastTime(a1).inMilliseconds, inInclusiveRange(5500, 7000));
+    expect(hjvToastTime('가' * 200), const Duration(seconds: 8));
+    // a caller's longer time is the least
+    expect(hjvToastTime('', least: const Duration(seconds: 5)),
+        const Duration(seconds: 5));
+    expect(hjvToastTime('가' * 200, least: const Duration(seconds: 10)),
+        const Duration(seconds: 10));
+  });
+
+  testWidgets('the toast: the app typeface on the snack bar colours, then gone',
+      (tester) async {
+    final navigator = GlobalKey<NavigatorState>();
+    await tester.pumpWidget(MaterialApp(
+        navigatorKey: navigator,
+        theme: ThemeData(
+            snackBarTheme: const SnackBarThemeData(
+                backgroundColor: Color(0xFF2B313B),
+                contentTextStyle: TextStyle(color: Colors.white))),
+        home: const Scaffold(body: SizedBox.expand())));
+    final overlay = navigator.currentState!.overlay!;
+
+    hjvShowToast(overlay, '첫째');
+    await tester.pump();
+    hjvShowToast(overlay, '이 PC는 18:30까지 연결을 받습니다.');
+    await tester.pump();
+    // a new toast takes the place of the one before
+    expect(find.text('첫째'), findsNothing);
+    final text = tester.widget<Text>(find.text('이 PC는 18:30까지 연결을 받습니다.'));
+    expect(text.style?.fontFamily, kHjvFont);
+    expect(text.style?.fontSize, 14);
+    expect(text.style?.color, Colors.white);
+    final box = tester.widget<Container>(find.ancestor(
+        of: find.text('이 PC는 18:30까지 연결을 받습니다.'),
+        matching: find.byType(Container)));
+    expect((box.decoration as BoxDecoration).color, const Color(0xFF2B313B));
+    expect(tester.getSize(find.byWidget(box)).width, lessThanOrEqualTo(480));
+    // the toast takes no taps
+    expect(
+        find.descendant(
+            of: find.byType(HjvToast), matching: find.byType(IgnorePointer)),
+        findsWidgets);
+
+    // the first toast's time ending does not take the second away
+    await tester.pump(hjvToastTime('첫째'));
+    expect(find.text('이 PC는 18:30까지 연결을 받습니다.'), findsOneWidget);
+    await tester.pump(hjvToastTime('이 PC는 18:30까지 연결을 받습니다.'));
+    expect(find.byType(HjvToast), findsNothing);
+  });
+}
