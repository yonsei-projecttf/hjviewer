index 0000000..41f4b3f
--- /dev/null
+++ b/src/hjviewer.rs
@@ -0,0 +1,46 @@
+use base::config::keys;
+use hbb_common::config;
+
+const APP_NAME: &str = "HJViewer";
+const SERVER: Option<&str> = option_env!("HJV_SERVER");
+const SERVER_KEY: Option<&str> = option_env!("HJV_SERVER_KEY");
+
+/// Pins the build to the hjviewer server named by `HJV_SERVER` / `HJV_SERVER_KEY` at build time;
+/// a build without `HJV_SERVER` behaves as upstream.
+///
+/// Signaling and relay go over WebSocket, `wss://<server>/ws/{id,relay}` on 443, the one port
+/// firewalls reliably let out, while WebRTC still connects peers directly wherever their networks
+/// allow it.
+pub fn apply() {
+    let Some(server) = SERVER.filter(|s| !s.is_empty()) else {
+        return;
+    };
+    *config::APP_NAME.write().unwrap() = APP_NAME.to_owned();
+    {
+        let mut settings = config::OVERWRITE_SETTINGS.write().unwrap();
+        for (k, v) in [
+            (keys::OPTION_CUSTOM_RENDEZVOUS_SERVER, server.to_owned()),
+            (keys::OPTION_RELAY_SERVER, server.to_owned()),
+            // check_ws picks wss:// only for an https API server
+            (keys::OPTION_API_SERVER, format!("https://{server}")),
+            (keys::OPTION_KEY, SERVER_KEY.unwrap_or_default().to_owned()),
+            (keys::OPTION_ALLOW_WEBSOCKET, "Y".to_owned()),
+            (keys::OPTION_ALLOW_AUTO_UPDATE, "N".to_owned()),
+        ] {
+            settings.insert(k.to_owned(), v);
+        }
+    }
+    // upstream defaults WebRTC on only for its public servers
+    config::DEFAULT_LOCAL_SETTINGS
+        .write()
+        .unwrap()
+        .insert(keys::OPTION_ENABLE_WEBRTC.to_owned(), "Y".to_owned());
+    // update checks follow upstream's releases, not this build's
+    config::OVERWRITE_LOCAL_SETTINGS
+        .write()
+        .unwrap()
+        .insert(keys::OPTION_ENABLE_CHECK_UPDATE.to_owned(), "N".to_owned());
+    let mut builtin = config::BUILTIN_SETTINGS.write().unwrap();
+    builtin.insert(keys::OPTION_HIDE_SERVER_SETTINGS.to_owned(), "Y".to_owned());
+    builtin.insert(keys::OPTION_HIDE_WEBSOCKET_SETTINGS.to_owned(), "Y".to_owned());
+}
