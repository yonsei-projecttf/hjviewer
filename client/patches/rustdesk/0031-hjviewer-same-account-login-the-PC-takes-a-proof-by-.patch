+#[test]
+fn use_counts_go_on_by_utc_day() {
+    let _ = hbb_common::sodiumoxide::init();
+    // NOW is 2025-10-09 08:53:20 UTC
+    let pc = bound("use", NOW);
+    pc.note_use(ACCOUNT_PK, NOW + 10);
+    pc.note_use(ACCOUNT_PK, NOW + 20);
+    let today = |pc: &Pc<MemStore>, at| -> Vec<(String, u64, u64)> {
+        pc.used(at)
+            .into_iter()
+            .map(|u| (u.day, u.last, u.n))
+            .collect()
+    };
+    assert_eq!(
+        today(&pc, NOW + 30),
+        [("2025-10-09".to_owned(), NOW + 20, 2)]
+    );
+    // the service starts again: the day's count goes on from the key
+    let pc = Pc {
+        store: pc.store,
+        trust: pc.trust,
+    };
+    pc.note_use(ACCOUNT_PK, NOW + 40);
+    assert_eq!(
+        today(&pc, NOW + 50),
+        [("2025-10-09".to_owned(), NOW + 40, 3)]
+    );
+    // past midnight UTC a new line; reports carry today and yesterday only
+    let tomorrow = NOW + 86_400;
+    pc.note_use(ACCOUNT_PK, tomorrow);
+    assert_eq!(
+        today(&pc, tomorrow),
+        [
+            ("2025-10-09".to_owned(), NOW + 40, 3),
+            ("2025-10-10".to_owned(), tomorrow, 1)
+        ]
+    );
+    assert_eq!(
+        today(&pc, tomorrow + 86_400),
+        [("2025-10-10".to_owned(), tomorrow, 1)]
+    );
+    cleanup(&["use"]);
+}
