+#[test]
+fn a_proof_asks_for_a_sync_only_when_one_could_let_it_in() {
+    let _ = hbb_common::sodiumoxide::init();
+    let (pk, nonce) = (pc_pk(), [5; 32]);
+    let proof = |key: &AccountKey, key_serial| {
+        conn_proof(key, PC_ID, &pk, &nonce, CTL_ID, KIND_REMOTE, key_serial).unwrap()
+    };
+    let wants = |pc: &Pc<MemStore>, proof: &HjvKeyProof, now| {
+        let login = KeyLogin {
+            pc_id: PC_ID,
+            pc_pk: &pk,
+            secured: true,
+            nonce: &nonce,
+            proof,
+            my_id: CTL_ID,
+            kind: KIND_REMOTE,
+        };
+        let view = pc.view();
+        wants_sync(&view, &decide(&view, &login, now), now, proof.key_serial)
+    };
+    let newcomer = AccountKey::from_seed(&[7; 32]).unwrap();
+    // the list (serial 10) decides a key it has, and a key no newer than itself
+    let pc = bound("wants", NOW);
+    assert!(!wants(&pc, &proof(&owner(), 10), NOW + 60));
+    assert!(!wants(&pc, &proof(&newcomer, 10), NOW + 60));
+    // a device that logged in after it, or a list that expired, asks once
+    assert!(wants(&pc, &proof(&newcomer, 11), NOW + 60));
+    assert!(wants(&pc, &proof(&owner(), 10), NOW + 6 + 86_400));
+    // a proof that is broken or signed for another connection asks nothing
+    let mut broken = proof(&newcomer, 11);
+    let mut signature = broken.signature.to_vec();
+    signature[0] ^= 1;
+    broken.signature = signature.into();
+    assert!(!wants(&pc, &broken, NOW + 6 + 86_400));
+    // nor can a sync turn on a PC switched off here, an unbound one, or a paused account's
+    assert!(pc.switch_off(None, NOW + 60));
+    assert!(!wants(&pc, &proof(&newcomer, 11), NOW + 6 + 86_400));
+    assert!(!wants(
+        &fresh_pc("wants-none"),
+        &proof(&newcomer, 11),
+        NOW + 60
+    ));
+    let paused = fresh_pc("wants-paused");
+    let disabled = Signed::new(ID, "n1", NOW + 5, NOW).state("disabled");
+    assert!(matches!(
+        reply(
+            &paused,
+            Mode::Bind(request(ID, NOW)),
+            "n1",
+            200,
+            &disabled.answer(),
+            NOW + 6
+        ),
+        Answered::Kept { .. }
+    ));
+    assert!(!wants(&paused, &proof(&owner(), 10), NOW + 60));
+    cleanup(&["wants", "wants-none", "wants-paused"]);
+}
