+#[test]
+fn requests_and_timing() {
+    assert_eq!(
+        Request::parse(&format!("{ID}.1760000000")),
+        Some(request(ID, 1_760_000_000))
+    );
+    for bad in [
+        String::new(),
+        ID.to_owned(),
+        format!("{ID}."),
+        format!("{}.1", ID.to_uppercase()),
+        format!("{}.1", &ID[1..]),
+        format!("{ID}.-1"),
+    ] {
+        assert_eq!(Request::parse(&bad), None, "{bad}");
+    }
+    // failures back off from 30 s to 10 min, never past either
+    for failures in [0, 1, 2, 5, 6, 7, 40, u32::MAX] {
+        for jitter in [0, u32::MAX / 2, u32::MAX] {
+            let wait = backoff(failures, jitter);
+            assert!(
+                wait >= Duration::from_secs(RETRY_MIN) && wait <= Duration::from_secs(RETRY_MAX),
+                "{failures} {jitter} {wait:?}"
+            );
+        }
+    }
+    assert_eq!(backoff(1, 0), Duration::from_secs(30));
+    assert_eq!(backoff(3, 0), Duration::from_secs(96));
+    assert_eq!(backoff(3, u32::MAX), Duration::from_secs(144));
+    assert_eq!(backoff(9, 0), Duration::from_secs(480));
+    assert_eq!(backoff(9, u32::MAX), Duration::from_secs(600));
+    // a tick of the 1 s loop that saw the clock move by more than 30 s: the PC slept
+    assert!(!jumped(0, NOW));
+    assert!(!jumped(NOW, NOW + 1));
+    assert!(!jumped(NOW, NOW + 30));
+    assert!(jumped(NOW, NOW + 31));
+    assert!(jumped(NOW, NOW - 31));
+}
