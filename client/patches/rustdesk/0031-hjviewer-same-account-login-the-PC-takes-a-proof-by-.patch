+#[test]
+fn the_list_and_its_metadata_go_together() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pc = bound("cache", NOW);
+    let cached = pc.cached().unwrap();
+    assert_eq!(
+        (cached.list.binding.as_str(), cached.received),
+        (ID, NOW + 6)
+    );
+    // bytes that are not the ones the key's hash names do not count, nor bytes without a hash
+    let mut bytes = std::fs::read(&pc.trust).unwrap();
+    bytes[10] ^= 1;
+    std::fs::write(&pc.trust, &bytes).unwrap();
+    assert!(pc.cached().is_none());
+    assert_eq!(
+        proof_from(&pc, KIND_REMOTE, &[5; 32], NOW + 60).unwrap_err(),
+        Refusal::NoList
+    );
+    let pc = bound("cache2", NOW);
+    pc.store.remove(LIST_HASH);
+    assert!(pc.cached().is_none());
+    // a list of another binding is no list for this one
+    let pc = bound("cache3", NOW);
+    pc.store.set(BINDING, OTHER);
+    assert!(pc.view().cached.is_none());
+    assert_eq!(
+        proof_from(&pc, KIND_REMOTE, &[5; 32], NOW + 60).unwrap_err(),
+        Refusal::NoList
+    );
+    cleanup(&["cache", "cache2", "cache3"]);
+}
