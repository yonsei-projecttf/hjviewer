+    if wants_sync(&view, &outcome, now, login.proof.key_serial) {
+        let strict = view.cached.as_ref().is_some_and(|c| c.list.strict);
+        let fresh = refresh_now(asks).await;
+        view = read_view(pc).await;
+        outcome = decide(&view, login, unix_now());
+        if strict && !fresh && outcome.is_ok() {
+            outcome = Err(Refusal::Expired);
+        }
+    }
+    let entry = outcome?;
+    let owner = view.cached.map(|c| c.list.owner).unwrap_or_default();
+    let (pc, pk) = (pc.clone(), entry.pk.clone());
+    tokio::task::spawn_blocking(move || pc.note_use(&pk, unix_now()));
+    Ok((entry, owner))
+}
+
+/// After the permanent password and the channel: the binding and Off, then the proof against the
+/// list of that binding.
+fn decide(view: &View, login: &KeyLogin, now: u64) -> Result<KeyEntry, Refusal> {
+    if view.binding.is_none() {
+        return Err(Refusal::NotBound);
+    }
+    if view.off {
+        return Err(Refusal::Off);
+    }
+    check_key_login(login, view.cached.as_ref(), now)
