+    let asks = Syncer::spawn(pc.clone());
+    // a phone of the account logs in just after a periodic sync (every 5 s, as in the E2E): its
+    // first proof, with a key serial past the list's, gets a sync of its own and is let in
+    until("a periodic sync", || pc.requests() == 2).await;
+    sleep(1).await;
+    pc.api().newcomer = true;
+    let newcomer = AccountKey::from_seed(&NEWCOMER_SEED).unwrap();
+    let accepted = take(&pc, &asks, &newcomer, 11, NEWCOMER_ID, KIND_REMOTE).await;
+    assert!(accepted.is_ok_and(|a| a.name.starts_with("Galaxy S24 · ")));
+    assert_eq!(pc.requests(), 3);
+    // a kind its list does not allow is refused without a sync; the next report counts both
+    let terminal = take(&pc, &asks, &newcomer, 11, NEWCOMER_ID, KIND_TERMINAL).await;
+    assert_eq!(terminal.err(), Some(Refusal::KindNotAllowed));
+    assert_eq!(pc.requests(), 3);
+    let pk = STANDARD.encode(newcomer.public_key());
+    until("reported", || {
+        pc.api().got.last().is_some_and(|(p, _)| {
+            p["refused"]["kind"] == 1
+                && p["used"]
+                    .as_array()
+                    .is_some_and(|used| used.iter().any(|u| u["pk"] == pk && u["n"] == 1))
+        })
+    })
+    .await;
+    // a strict list (an incident): a proof goes in only after a sync, even with a listed key, so
+    // not while hjv-api does not answer
