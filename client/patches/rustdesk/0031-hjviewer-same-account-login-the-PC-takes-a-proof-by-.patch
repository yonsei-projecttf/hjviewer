+/// A proof's ask (refresh_now) and its answer, unbounded.
+async fn ask(asks: &Asks) -> bool {
+    let (ask, answer) = oneshot::channel();
+    asks.send(ask).unwrap();
+    answer.await.unwrap()
+}
+
+/// A proof of `key` (key serial `ks`) from the controller `ctl` for `kind`, as this PC takes it
+/// with the sync task's inbox `asks`.
+async fn take(
+    pc: &Fake,
+    asks: &Asks,
+    key: &AccountKey,
+    ks: u64,
+    ctl: &str,
+    kind: u8,
+) -> Result<Accepted, Refusal> {
+    let (pk, nonce) = (pc_pk(), [5; 32]);
+    let proof = conn_proof(key, PC_ID, &pk, &nonce, ctl, kind, ks).unwrap();
+    let login = KeyLogin {
+        pc_id: PC_ID,
+        pc_pk: &pk,
+        secured: true,
+        nonce: &nonce,
+        proof: &proof,
+        my_id: ctl,
+        kind,
+    };
+    key_login_with(&pc.pc(), Some(asks), pc.refused(), true, &login).await
+}
