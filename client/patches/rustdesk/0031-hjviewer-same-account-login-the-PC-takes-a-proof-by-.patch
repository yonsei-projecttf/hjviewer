+#[test]
+fn an_answer_changes_only_what_a_signed_list_says() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pc = bound("answers", NOW);
+    let mode = || Mode::Bound(ID.to_owned());
+    let fresh = Signed::new(ID, "n2", NOW + 120, NOW).answer();
+    assert_eq!(
+        reply(&pc, mode(), "n2", 200, &fresh, NOW + 121),
+        Answered::Kept {
+            state: "active".to_owned(),
+            keys: 1,
+            refresh: 120
+        }
+    );
+    assert_eq!(pc.view().cached.unwrap().received, NOW + 121);
+    // unsigned answers, errors and lists for another request change nothing
+    for (status, answer, expected) in [
+        (200, Answer::default(), Answered::Unsigned),
+        (404, Answer::default(), Answered::Unsigned),
+        (401, Answer::default(), Answered::NeedsRelogin),
+        (500, Answer::default(), Answered::Failed("http")),
+        (
+            400,
+            Answer {
+                error: "clock".to_owned(),
+                ..Answer::default()
+            },
+            Answered::Failed("clock"),
+        ),
+        (200, fresh, Answered::Failed("list")),
+    ] {
+        assert_eq!(
+            reply(&pc, mode(), "n3", status, &answer, NOW + 200),
+            expected
+        );
+        assert_eq!(pc.binding().as_deref(), Some(ID));
+        assert_eq!(pc.view().cached.unwrap().received, NOW + 121);
+    }
+    // hjv-api's revoked list for this binding (no keys, no owner, no login) takes it and the
+    // list away; the one report after it changes nothing
+    let revoked = Signed::new(ID, "n4", NOW + 300, NOW)
+        .state("revoked")
+        .bare()
+        .answer();
+    assert_eq!(
+        reply(&pc, mode(), "n4", 200, &revoked, NOW + 301),
+        Answered::Revoked
+    );
+    assert_eq!(pc.binding(), None);
+    assert!(pc.cached().is_none() && !pc.trust.exists());
+    assert_eq!(pc.number(KID_FLOOR), Some(1));
+    assert_eq!(
+        display(&pc.view(), Some(&Answered::Revoked), 0, NOW),
+        "revoked"
+    );
+    assert_eq!(
+        reply(&pc, Mode::Unbound, "n5", 404, &Answer::default(), NOW + 302),
+        Answered::Unsigned
+    );
+    cleanup(&["answers"]);
+}
