+/// The accepted key's list entry and the list's masked owner.
+async fn check_proof<S: Store + Clone + Send + 'static>(
+    pc: &Pc<S>,
+    asks: Option<&Asks>,
+    permanent_ok: bool,
+    login: &KeyLogin<'_>,
+) -> Result<(KeyEntry, String), Refusal> {
+    if !permanent_ok {
+        return Err(Refusal::TemporaryOnly);
+    }
+    if !login.secured {
+        return Err(Refusal::NotSecured);
+    }
+    let mut view = read_view(pc).await;
+    let now = unix_now();
