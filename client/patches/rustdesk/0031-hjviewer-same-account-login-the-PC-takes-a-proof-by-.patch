+fn the_sync_request_is_the_vectors() {
+    let _ = hbb_common::sodiumoxide::init();
+    let mut uses = Vec::new();
+    for at in SYNC_ACCEPTED {
+        count_use(&mut uses, ACCOUNT_PK, at);
+    }
+    let p = payload(
+        ID,
+        "1.6.0",
+        false,
+        &used_report(&uses, T),
+        Refused::default(),
+    );
+    assert_eq!(p, SYNC_P);
+    assert_eq!(
+        pc_sync_envelope(&device_key(&PC_SEED), PC_ID, T, &SYNC_N_BYTES, &p),
+        SYNC_BODY
+    );
+    // every refusal counts under one of the design's seven names
+    let mut refused = Refused::default();
+    for refusal in [
+        Refusal::TemporaryOnly,
+        Refusal::NotActive,
+        Refusal::NotBound,
+        Refusal::IdMismatch,
+        Refusal::NoList,
+    ] {
+        refused.add(refusal);
+    }
+    let p = payload("", "1.6.0", false, &[], refused);
+    assert!(p.contains(
+        r#""refused":{"unknown_key":0,"kind":0,"temporary_only":1,"not_secured":0,"bad_sig":1,"expired":1,"off":2}"#
+    ));
+    // a report hjv-api took leaves what came meanwhile
+    let mut now = refused;
+    now.add(Refusal::Off);
+    now.take(&refused);
+    let mut off = Refused::default();
+    off.add(Refusal::Off);
+    assert_eq!(now, off);
+}
