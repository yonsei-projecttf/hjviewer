+#[test]
+fn the_linux_file_is_the_key() {
+    use std::os::unix::fs::PermissionsExt;
+    let file = BindingFile(dir("file").join(BINDING_FILE));
+    // only create makes the file
+    assert!(!file.set(BINDING, ID) && !file.exists());
+    assert!(file.create() && file.exists());
+    assert!(file.set(BINDING, ID) && file.set(OFF, "5"));
+    assert_eq!(file.get(BINDING).as_deref(), Some(ID));
+    file.remove(OFF);
+    assert_eq!(file.get(OFF), None);
+    let mode = std::fs::metadata(&file.0).unwrap().permissions().mode();
+    assert_eq!(mode & 0o777, 0o600);
+    // the same rules on the file as on the key
+    let pc = Pc {
+        store: file,
+        trust: dir("file2").join(TRUST_FILE),
+    };
+    assert!(pc.switch_off(None, NOW));
+    std::fs::remove_file(&pc.store.0).unwrap();
+    assert!(!pc.switch_off(None, NOW) && !pc.store.exists());
+    cleanup(&["file", "file2"]);
+}
