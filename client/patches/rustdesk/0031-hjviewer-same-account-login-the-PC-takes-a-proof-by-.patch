+        Ok(()) => log::info!("hjv: this PC's binding is forgotten"),
+        Err(err) => log::error!("hjv: could not forget this PC's binding: {err}"),
+    }
+}
+
+/// HKLM\SOFTWARE\HJViewer\Account, where a Windows PC keeps its binding.
+#[cfg(any(windows, test))]
+const ACCOUNT_KEY: &str = "SOFTWARE\\HJViewer\\Account";
+
+/// What `--uninstall` adds to the uninstaller's batch, which runs elevated once the service has
+/// stopped: the Start menu's "Uninstall" runs `--uninstall` unelevated, so forget_pc_binding()
+/// gets access denied there, and a PC installed again would take the earlier owner's proofs.
+#[cfg(windows)]
+pub(crate) fn uninstall_command() -> String {
+    uninstall_line(enabled())
+}
+
+#[cfg(any(windows, test))]
+fn uninstall_line(enabled: bool) -> String {
+    if !enabled {
+        return String::new();
+    }
+    format!("\nreg delete \"HKLM\\{ACCOUNT_KEY}\" /f\n")
+}
+
+/// A bind or unbind request: `<binding ID>.<login_at>`, the binding (32 lowercase hex) and the
+/// server's time of the login that made it, as the login's answer gave them.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Request {
+    binding: String,
+    login_at: u64,
+}
+
+impl Request {
+    fn parse(value: &str) -> Option<Request> {
+        let (binding, login_at) = value.trim().split_once('.')?;
+        if binding.len() != 32
+            || !binding
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        {
+            return None;
+        }
+        Some(Request {
+            binding: binding.to_owned(),
+            login_at: login_at.parse().ok()?,
+        })
+    }
+}
+
+/// Where the service keeps its binding. `create` alone makes the key (the file); `set` writes
+/// into an existing one and reports false otherwise.
+trait Store {
+    fn exists(&self) -> bool;
+    fn create(&self) -> bool;
+    fn get(&self, name: &str) -> Option<String>;
+    fn set(&self, name: &str, value: &str) -> bool;
+    fn remove(&self, name: &str);
+}
+
+#[cfg(windows)]
+mod registry {
+    use winreg::{enums::*, RegKey};
+
+    const KEY: &str = super::ACCOUNT_KEY;
+
+    /// HKLM\SOFTWARE\HJViewer\Account, with the default rights of HKLM\SOFTWARE: SYSTEM and
+    /// administrators write it, users read it.
+    #[derive(Clone)]
+    pub(super) struct Registry;
+
+    fn open(rights: u32) -> std::io::Result<RegKey> {
+        RegKey::predef(HKEY_LOCAL_MACHINE).open_subkey_with_flags(KEY, rights)
+    }
+
+    impl super::Store for Registry {
+        fn exists(&self) -> bool {
+            open(KEY_READ).is_ok()
+        }
+
+        fn create(&self) -> bool {
+            RegKey::predef(HKEY_LOCAL_MACHINE)
+                .create_subkey_with_flags(KEY, KEY_READ | KEY_WRITE)
+                .is_ok()
+        }
+
+        fn get(&self, name: &str) -> Option<String> {
+            open(KEY_READ).ok()?.get_value(name).ok()
+        }
+
+        fn set(&self, name: &str, value: &str) -> bool {
+            open(KEY_WRITE)
+                .and_then(|key| key.set_value(name, &value))
+                .is_ok()
+        }
+
+        fn remove(&self, name: &str) {
+            if let Ok(key) = open(KEY_WRITE) {
+                // a value that is not there is fine
+                key.delete_value(name).ok();
+            }
+        }
+    }
+
+    pub(super) fn forget() -> std::io::Result<()> {
+        match RegKey::predef(HKEY_LOCAL_MACHINE).delete_subkey_all(KEY) {
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            result => result,
+        }
+    }
+}
+
+#[cfg(windows)]
+type Platform = registry::Registry;
+#[cfg(not(windows))]
+type Platform = BindingFile;
+
+/// The service's 0600 file HJViewer_binding, with the same values as JSON.
+#[cfg(not(windows))]
+#[derive(Clone)]
+struct BindingFile(PathBuf);
+
+#[cfg(not(windows))]
+impl BindingFile {
+    fn values(&self) -> Option<BTreeMap<String, String>> {
+        let bytes = std::fs::read(&self.0).ok()?;
+        Some(serde_json::from_slice(&bytes).unwrap_or_default())
+    }
+
+    fn write(&self, values: &BTreeMap<String, String>) -> bool {
+        serde_json::to_vec(values).is_ok_and(|bytes| write_private(&self.0, &bytes).is_ok())
+    }
+}
+
+#[cfg(not(windows))]
+impl Store for BindingFile {
+    fn exists(&self) -> bool {
+        self.0.exists()
+    }
+
+    fn create(&self) -> bool {
+        let _one = FILE_LOCK.lock().unwrap();
+        self.exists() || self.write(&BTreeMap::new())
+    }
+
+    fn get(&self, name: &str) -> Option<String> {
+        self.values()?.remove(name)
+    }
+
+    fn set(&self, name: &str, value: &str) -> bool {
+        let _one = FILE_LOCK.lock().unwrap();
+        let Some(mut values) = self.values() else {
+            return false;
+        };
+        values.insert(name.to_owned(), value.to_owned());
+        self.write(&values)
+    }
+
+    fn remove(&self, name: &str) {
+        let _one = FILE_LOCK.lock().unwrap();
+        if let Some(mut values) = self.values() {
+            if values.remove(name).is_some() {
+                self.write(&values);
+            }
+        }
+    }
+}
+
+/// Replaces `path` at once, by a new file renamed over it; on Unix only its owner reads it (the
+/// service's config folder keeps other users out on Windows).
+fn write_private(path: &Path, data: &[u8]) -> std::io::Result<()> {
+    use std::io::Write;
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let mut tmp = path.as_os_str().to_owned();
+    tmp.push(".tmp");
+    let tmp = PathBuf::from(tmp);
+    // a leftover from a write that did not finish
+    std::fs::remove_file(&tmp).ok();
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    let mut file = options.open(&tmp)?;
+    file.write_all(data)?;
+    file.sync_all()?;
+    drop(file);
+    std::fs::rename(&tmp, path)
+}
+
+/// What a decision reads: the binding, Off, and the cached list if it is of that binding.
+#[derive(Default)]
+struct View {
+    binding: Option<String>,
+    off: bool,
+    cached: Option<Cached>,
+}
+
+async fn read_view<S: Store + Clone + Send + 'static>(pc: &Pc<S>) -> View {
+    let pc = pc.clone();
+    blocking(move || pc.view()).await.unwrap_or_default()
+}
+
+/// The binding as the service keeps it, and the cached list.
+#[derive(Clone)]
+struct Pc<S> {
+    store: S,
+    trust: PathBuf,
+}
+
+impl Pc<Platform> {
+    fn platform() -> Self {
+        Pc {
+            #[cfg(windows)]
+            store: registry::Registry,
+            #[cfg(not(windows))]
+            store: BindingFile(Config::path(BINDING_FILE)),
+            trust: Config::path(TRUST_FILE),
+        }
+    }
+}
+
+impl<S: Store> Pc<S> {
+    fn binding(&self) -> Option<String> {
+        self.store.get(BINDING).filter(|b| !b.is_empty())
+    }
+
+    fn number(&self, name: &str) -> Option<u64> {
+        self.store.get(name)?.trim().parse().ok()
+    }
+
+    fn off(&self) -> bool {
+        self.store.get(OFF).is_some()
+    }
+
+    fn view(&self) -> View {
+        let binding = self.binding();
+        let cached = self
+            .cached()
+            .filter(|c| Some(&c.list.binding) == binding.as_ref());
+        View {
+            off: self.off(),
+            binding,
+            cached,
+        }
+    }
+
+    /// The cached list, if its bytes still have the hash the key keeps.
+    fn cached(&self) -> Option<Cached> {
+        let hash = self.store.get(LIST_HASH)?;
+        let received = self.number(RECV)?;
+        let bytes = std::fs::read(&self.trust).ok()?;
+        if hex::encode(Sha256::digest(&bytes)) != hash {
+            return None;
+        }
+        let list = serde_json::from_slice(&bytes).ok()?;
+        Some(Cached { list, received })
+    }
+
+    /// Keeps a list just accepted: its bytes in the file, then their hash, the receipt time by
+    /// the PC's clock and the key number floor in the existing key. False when the key is gone.
+    fn keep_list(&self, bytes: &[u8], list: &TrustList, now: u64) -> bool {
+        if let Err(err) = write_private(&self.trust, bytes) {
+            hbb_common::throttled_log!(
+                Duration::from_secs(600),
+                warn,
+                "hjv: could not keep the trust list: {err}"
+            );
+            return false;
+        }
+        self.store
+            .set(LIST_HASH, &hex::encode(Sha256::digest(bytes)))
+            && self.store.set(RECV, &now.to_string())
+            && self.raise_floor(list.kid)
+    }
+
+    /// Lists under a lower key number than one the PC took are refused from then on.
+    fn raise_floor(&self, kid: u32) -> bool {
+        let floor = self.number(KID_FLOOR).unwrap_or(0).max(u64::from(kid));
+        self.store.set(KID_FLOOR, &floor.to_string())
+    }
+
+    /// Drops the binding with its Off and its list.
+    fn drop_binding(&self) {
+        for name in [BINDING, AT, OWNER, LOGIN_AT, OFF, LIST_HASH, RECV] {
+            self.store.remove(name);
+        }
+        std::fs::remove_file(&self.trust).ok();
+    }
+
+    /// A signed list answering a bind request for `req.binding` (verify_list matched the two):
+    /// writes the binding, with the list's login as LoginAt, only for an account that is active
+    /// or paused, a login on this PC at most FRESH_LOGIN before the list, and one later than the
+    /// last release of this binding here. The same binding gets the newer LoginAt, and a login
+    /// later than Off clears Off. The one place that makes the key.
+    fn bind(
+        &self,
+        req: &Request,
+        list: &TrustList,
+        bytes: &[u8],
+        now: u64,
+    ) -> Result<(), &'static str> {
+        if !matches!(list.state.as_str(), "active" | "disabled") {
+            return Err("bind-mismatch");
+        }
+        if list.iat.saturating_sub(list.login_at) > FRESH_LOGIN {
+            return Err("bind-stale");
+        }
+        if self.store.get(UNBOUND_BINDING).as_deref() == Some(req.binding.as_str())
+            && list.login_at <= self.number(UNBOUND_LOGIN_AT).unwrap_or(0)
+        {
+            return Err("bind-released");
+        }
+        if self.binding().as_deref() == Some(req.binding.as_str()) {
+            if self.off() && list.login_at > self.number(OFF).unwrap_or(0) {
+                self.store.remove(OFF);
+            }
+        } else {
+            if !self.store.exists() && !self.store.create() {
+                return Err("store");
+            }
+            // another binding goes before its Off: a write cut short leaves no binding on
+            self.store.remove(BINDING);
+            self.store.remove(OFF);
+            self.store.set(AT, &now.to_string());
+        }
+        self.store.set(OWNER, &list.owner);
+        self.store.set(LOGIN_AT, &list.login_at.to_string());
+        if !self.keep_list(bytes, list, now) || !self.store.set(BINDING, &req.binding) {
+            return Err("store");
+        }
+        Ok(())
+    }
+
+    /// An unbind request (any local user may put one, as with Off): drops the binding it names if
+    /// this PC has it, or undoes the bind request in hand for it (`pending`: a login undone before
+    /// its bind came through, the one case that makes the key), and remembers the release as
+    /// UnboundBinding and UnboundLoginAt, the latest login it ends, so that this binding comes
+    /// back only with a later login (bind). A request doing neither changes nothing.
+    ///
+    /// The request's `login_at` counts up to what this PC knows of that binding's logins: the
+    /// `iat` of its last list of it and, for the bind request in hand, that request's login up to
+    /// PENDING_AHEAD past hjv-api's clock (`now`), or UNLISTED_AHEAD past it without either; so a
+    /// made-up time cannot hold off the owner's next login. Another binding's record gives way to
+    /// an undone bind request only once it no longer guards the ten minutes after its login, so
+    /// that a made-up bind request undone at once cannot wipe it. Whether this PC's binding went.
+    fn unbind(&self, req: &Request, pending: Option<&Request>, now: u64) -> bool {
+        let here = self.binding().as_deref() == Some(req.binding.as_str());
+        let waiting = pending.filter(|p| p.binding == req.binding);
+        if !here && waiting.is_none() {
+            return false;
+        }
+        let listed = self
+            .cached()
+            .filter(|c| c.list.binding == req.binding)
+            .map(|c| c.list.iat);
+        let known = match (listed, waiting) {
+            (listed, Some(p)) => Some(
+                listed
+                    .unwrap_or(0)
+                    .max(p.login_at.min(now.saturating_add(PENDING_AHEAD))),
+            ),
+            (listed, None) => listed,
+        };
+        let mut at = req
+            .login_at
+            .min(known.unwrap_or(now.saturating_add(UNLISTED_AHEAD)));
+        if here {
+            at = at.max(self.number(LOGIN_AT).unwrap_or(0));
+            self.drop_binding();
+        }
+        let recorded = self.number(UNBOUND_LOGIN_AT).unwrap_or(0);
+        match self.store.get(UNBOUND_BINDING) {
+            Some(b) if b == req.binding => at = at.max(recorded),
+            Some(_) if !here && recorded.saturating_add(FRESH_LOGIN + PENDING_AHEAD) >= now => {
+                return false
+            }
+            _ => {}
+        }
+        if waiting.is_some() && !self.store.exists() {
+            self.store.create();
+        }
+        // the time first: a record never names a binding with another binding's time
+        self.store.set(UNBOUND_LOGIN_AT, &at.to_string());
+        self.store.set(UNBOUND_BINDING, &req.binding);
+        here
+    }
+
+    /// The off switch (any local user): Off = the binding's latest login this PC knows of, its
+    /// LoginAt or the bind request in hand for it (`pending`, up to PENDING_AHEAD past hjv-api's
+    /// clock `now`), which only a later login on this PC clears (bind). Whether there was a
+    /// binding to switch off.
+    fn switch_off(&self, pending: Option<&Request>, now: u64) -> bool {
+        let Some(binding) = self.binding() else {
+            return false;
+        };
+        let in_hand = pending
+            .filter(|p| p.binding == binding)
+            .map_or(0, |p| p.login_at.min(now.saturating_add(PENDING_AHEAD)));
+        let off = self.number(LOGIN_AT).unwrap_or(0).max(in_hand);
+        self.store.set(OFF, &off.to_string())
+    }
+
+    /// A signed `revoked` for this PC's binding: drops the binding with its list.
+    fn revoke(&self, list: &TrustList) -> bool {
+        if self.binding().as_deref() != Some(list.binding.as_str()) {
+            return false;
+        }
+        self.drop_binding();
+        self.raise_floor(list.kid);
+        true
+    }
+
+    fn uses(&self) -> Vec<UseEntry> {
+        self.store
+            .get(USE)
+            .and_then(|v| serde_json::from_str(&v).ok())
+            .unwrap_or_default()
+    }
+
+    /// Counts a proof of `pk` accepted at `now` in Use, which keeps today's and yesterday's lines
+    /// (UTC) so that a day's count goes on after a restart.
+    fn note_use(&self, pk: &str, now: u64) {
+        let _one = USE_LOCK.lock().unwrap();
+        let mut entries = self.uses();
+        count_use(&mut entries, pk, now);
+        if let Ok(value) = serde_json::to_string(&used_report(&entries, now)) {
+            self.store.set(USE, &value);
+        }
+    }
+
+    /// The sync's `used`: today's and yesterday's counts.
+    fn used(&self, now: u64) -> Vec<UseEntry> {
+        used_report(&self.uses(), now)
+    }
+}
+
+/// The names of the sync report's `refused` (design 3-6), each Refusal's `report_name`.
+const REFUSED_NAMES: [&str; 7] = [
+    "unknown_key",
+    "kind",
+    "temporary_only",
+    "not_secured",
+    "bad_sig",
+    "expired",
+    "off",
+];
+
+/// Refused proofs by reason since the last report hjv-api took (the sync's `refused`).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct Refused([u64; 7]);
+
+impl Refused {
+    fn add(&mut self, refusal: Refusal) {
+        if let Some(i) = REFUSED_NAMES
+            .iter()
+            .position(|n| *n == refusal.report_name())
+        {
+            self.0[i] = self.0[i].saturating_add(1);
+        }
+    }
+
+    /// Takes off what a report delivered; what came during the request stays for the next.
+    fn take(&mut self, sent: &Refused) {
+        for (n, s) in self.0.iter_mut().zip(sent.0) {
+            *n = n.saturating_sub(s);
+        }
+    }
+}
+
+impl serde::Serialize for Refused {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        use serde::ser::SerializeMap;
+        let mut map = serializer.serialize_map(Some(REFUSED_NAMES.len()))?;
+        for (name, n) in REFUSED_NAMES.iter().zip(self.0) {
+            map.serialize_entry(name, &n)?;
+        }
+        map.end()
+    }
+}
+
+#[derive(Serialize)]
+struct Payload<'a> {
+    v: u32,
+    binding: &'a str,
+    ver: &'a str,
+    off: bool,
+    used: &'a [UseEntry],
+    refused: Refused,
+    wol_hash: &'a str,
+}
+
+/// The sync's `p` (design 3-6).
+fn payload(binding: &str, ver: &str, off: bool, used: &[UseEntry], refused: Refused) -> String {
+    // strings, numbers and booleans always serialize
+    serde_json::to_string(&Payload {
+        v: 1,
+        binding,
+        ver,
+        off,
+        used,
+        refused,
+        wol_hash: "",
+    })
+    .unwrap_or_default()
+}
+
+/// What the PC reads of a sync answer; hjv-api's unsigned `state` and `refresh` change nothing.
+#[derive(Deserialize, Default)]
+#[serde(default)]
+struct Answer {
+    server_time: u64,
+    error: String,
+    list: Option<SignedList>,
+}
+
+/// What a sync carries as `binding`, and so what its answer may do.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Mode {
+    /// this PC's binding: keep a new list, drop the binding on a signed revoked
+    Bound(String),
+    /// a bind request: write the binding when the list confirms it (Pc::bind)
+    Bind(Request),
+    /// the one report after the binding went, which nothing in the answer changes
+    Unbound,
+}
+
+impl Mode {
+    fn binding(&self) -> &str {
+        match self {
+            Mode::Bound(binding) => binding,
+            Mode::Bind(req) => &req.binding,
+            Mode::Unbound => "",
+        }
+    }
+}
+
+/// What a sync answer did.
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Answered {
+    /// a signed active or disabled list of the binding, kept
+    Kept {
+        state: String,
+        keys: usize,
+        refresh: u64,
+    },
+    /// a signed revoked for this PC's binding, which is gone
+    Revoked,
+    /// an answer without a list for this binding (listed, unbound): nothing changes here
+    Unsigned,
+    /// 401: hjv-api does not take this PC's device key (reinstalled, its settings reset)
+    NeedsRelogin,
+    /// a bind request the list did not confirm
+    BindRefused(&'static str),
+    /// the binding this request carried went while it was out (an unbind, the uninstaller)
+    Superseded,
+    /// nothing to go by: the network, the server, a list that fails the checks
+    Failed(&'static str),
+}
+
+/// What a sync answer (`status`, `answer`) to the request `n` in `mode` does here. Only a signed
+/// list changes anything, and a revoked one only for this PC's binding.
+#[allow(clippy::too_many_arguments)]
+fn apply<S: Store>(
+    pc: &Pc<S>,
+    pinned: &[(u32, [u8; 32])],
+    me: (&str, &[u8]),
+    mode: &Mode,
+    n: &str,
+    status: u16,
+    answer: &Answer,
+    now: u64,
+) -> Answered {
+    let unconfirmed = |code| match mode {
+        Mode::Bind(_) => Answered::BindRefused(code),
+        _ => Answered::Unsigned,
+    };
+    match status {
+        200 => {}
+        401 => return Answered::NeedsRelogin,
+        404 => return unconfirmed("bind-mismatch"),
+        400 if answer.error == "clock" => return Answered::Failed("clock"),
+        _ => return Answered::Failed("http"),
+    }
+    let Some(signed) = &answer.list else {
+        return unconfirmed("bind-mismatch");
+    };
+    let local = Local {
+        pc_id: me.0,
+        pc_pk: me.1,
+        binding: mode.binding(),
+        request_nonce: n,
+        kid_floor: pc
+            .number(KID_FLOOR)
+            .map_or(0, |k| u32::try_from(k).unwrap_or(u32::MAX)),
+    };
+    let list = match verify_list(pinned, signed.kid, &signed.l, &signed.s, &local) {
+        Ok(list) => list,
+        Err(refusal) => {
+            hbb_common::throttled_log!(
+                Duration::from_secs(600),
+                warn,
+                "hjv: trust list refused: {refusal:?}"
+            );
+            return Answered::Failed("list");
+        }
+    };
+    let Ok(bytes) = STANDARD.decode(&signed.l) else {
+        return Answered::Failed("list");
+    };
+    if let Mode::Bound(binding) = mode {
+        if pc.binding().as_deref() != Some(binding.as_str()) {
+            return Answered::Superseded;
+        }
+    }
+    if list.state == "revoked" {
+        return if pc.revoke(&list) {
+            Answered::Revoked
+        } else {
+            unconfirmed("bind-revoked")
+        };
+    }
+    let kept = Answered::Kept {
+        state: list.state.clone(),
+        keys: list.keys.len(),
+        refresh: list.refresh,
+    };
+    match mode {
+        Mode::Unbound => Answered::Unsigned,
+        Mode::Bind(req) => match pc.bind(req, &list, &bytes, now) {
+            Ok(()) => kept,
+            Err(code) => Answered::BindRefused(code),
+        },
+        Mode::Bound(_) => {
+            if pc.keep_list(&bytes, &list, now) {
+                kept
+            } else {
+                Answered::Failed("store")
+            }
+        }
+    }
+}
+
+/// hjv-pwless-state, what the account settings show about this PC: `active <keys> <last list>`,
+/// `off`, `disabled`, `expired`, `revoked`, `listed`, `needs-relogin` or `error <code> <last
+/// list>` (`<last list>`: the PC's clock at the last sync that brought a list, 0 for none), and
+/// empty while there is no binding.
+fn display(view: &View, last: Option<&Answered>, last_ok: u64, now: u64) -> String {
+    let error = |code: &str| format!("error {code} {last_ok}");
+    if view.binding.is_none() {
+        return match last {
+            Some(Answered::Revoked) => "revoked".to_owned(),
+            Some(Answered::NeedsRelogin) => "needs-relogin".to_owned(),
+            Some(Answered::BindRefused(code)) => error(code),
+            _ => String::new(),
+        };
+    }
+    if view.off {
+        return "off".to_owned();
+    }
+    match last {
+        Some(Answered::NeedsRelogin) => return "needs-relogin".to_owned(),
+        Some(Answered::Unsigned) => return "listed".to_owned(),
+        Some(Answered::BindRefused(code)) => return error(code),
+        _ => {}
+    }
+    match view.cached.as_ref().filter(|c| valid_at(c, now)) {
+        Some(c) if c.list.state == "disabled" => "disabled".to_owned(),
+        Some(c) if c.list.state == "active" => match last {
+            Some(Answered::Failed(code)) => error(code),
+            _ => format!("active {} {last_ok}", c.list.keys.len()),
+        },
+        _ => "expired".to_owned(),
+    }
+}
+
+/// What the last answer said, from the state the service showed before it started again
+/// (LastState): what hjv-api said lasts until it says something else.
+fn restored(state: &str) -> Option<Answered> {
+    match state {
+        "revoked" => Some(Answered::Revoked),
+        "needs-relogin" => Some(Answered::NeedsRelogin),
+        "listed" => Some(Answered::Unsigned),
+        _ => None,
+    }
+}
+
+/// The wait after `failures` failed syncs in a row: RETRY_MIN doubling up to RETRY_MAX, spread by
+/// up to ±20% as sync_interval does, and held to those bounds.
+fn backoff(failures: u32, jitter: u32) -> Duration {
+    let doubled = RETRY_MIN.saturating_mul(1 << failures.saturating_sub(1).min(6));
+    let base = doubled.min(RETRY_MAX) * 1000;
+    let permille = 800 + u64::from(jitter) * 400 / u64::from(u32::MAX);
+    Duration::from_millis((base * permille / 1000).clamp(RETRY_MIN * 1000, RETRY_MAX * 1000))
+}
+
+/// Whether the wall clock moved by more than RESUME_JUMP between two ticks: the PC slept (or
+/// someone set its clock).
+fn jumped(before: u64, now: u64) -> bool {
+    before != 0
+        && (now > before.saturating_add(RESUME_JUMP) || now.saturating_add(RESUME_JUMP) < before)
+}
+
+fn unix_now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+/// hjv-api's clock as this PC knows it: its own and the offset the last answer showed.
+fn server_time(offset: i64) -> u64 {
+    (unix_now() as i64).saturating_add(offset).max(0) as u64
+}
+
+fn random_u32() -> u32 {
+    randombytes::randombytes(4)
+        .try_into()
+        .map_or(0, u32::from_le_bytes)
+}
+
+async fn blocking<T: Send + 'static>(f: impl FnOnce() -> T + Send + 'static) -> Option<T> {
+    tokio::task::spawn_blocking(f).await.ok()
+}
+
+type Posted = Pin<Box<dyn Future<Output = Result<(u16, Answer), &'static str>> + Send>>;
+
+/// What the sync task reaches outside itself: the service's options (Config2), where it keeps
+/// the binding, this PC's ID and device key, the pinned list keys, and hjv-api.
+trait Service: Clone + Send + Sync + 'static {
+    type Store: Store;
+    fn option(&self, name: &str) -> String;
+    fn set_option(&self, name: &str, value: &str);
+    fn pc(&self) -> Pc<Self::Store>;
+    /// this PC's ID and device key pair (secret, public)
+    fn device(&self) -> (String, Vec<u8>, Vec<u8>);
+    fn pinned(&self) -> Vec<(u32, [u8; 32])>;
+    /// the proofs refused since the last report hjv-api took (the sync's `refused`)
+    fn refused(&self) -> &Mutex<Refused>;
+    /// Sends a sync request's body to /api/hjv/pc/sync: the answer's status and body, or why
+    /// there is none.
+    fn post(&self, body: String) -> Posted;
+}
+
+/// This service process: Config2, HKLM (the 0600 file elsewhere), and hjv-api through one strict
+/// client, made at the first request and kept, so that a sync for a proof needs no new TLS probe.
+#[derive(Clone)]
+struct ThisPc {
+    url: Option<String>,
+    client: Arc<Mutex<Option<reqwest::Client>>>,
+}
+
+impl ThisPc {
+    fn new() -> ThisPc {
+        let api = crate::common::get_api_server(
+            Config::get_option("api-server"),
+            Config::get_option("custom-rendezvous-server"),
+        );
+        ThisPc {
+            url: api
+                .starts_with("https://")
+                .then(|| format!("{api}/api/hjv/pc/sync")),
+            client: Arc::default(),
+        }
+    }
+}
+
+impl Service for ThisPc {
+    type Store = Platform;
+
+    fn option(&self, name: &str) -> String {
+        Config::get_option(name)
+    }
+
+    fn set_option(&self, name: &str, value: &str) {
+        Config::set_option(name.to_owned(), value.to_owned());
+    }
+
+    fn pc(&self) -> Pc<Platform> {
+        Pc::platform()
+    }
+
+    fn device(&self) -> (String, Vec<u8>, Vec<u8>) {
+        let (sk, pk) = Config::get_key_pair();
+        (Config::get_id(), sk, pk)
+    }
+
+    fn pinned(&self) -> Vec<(u32, [u8; 32])> {
+        trust_pubkeys()
+    }
+
+    fn refused(&self) -> &Mutex<Refused> {
+        &REFUSED
+    }
+
+    fn post(&self, body: String) -> Posted {
+        let (url, client) = (self.url.clone(), self.client.clone());
+        Box::pin(async move {
+            let url = url.ok_or("config")?;
+            let mut held = client.lock().unwrap().take();
+            let reply = post(&mut held, &url, body).await;
+            // a client that did not get through probes the server again next time
+            if !matches!(reply, Err("network")) {
+                *client.lock().unwrap() = held;
+            }
+            reply
+        })
+    }
+}
+
+async fn post(
+    client: &mut Option<reqwest::Client>,
+    url: &str,
+    body: String,
+) -> Result<(u16, Answer), &'static str> {
+    if client.is_none() {
+        // its first request probes the server, which a network that drops packets would hold
+        *client = match timeout(
+            HTTP_TIMEOUT,
+            crate::hbbs_http::create_http_client_async_with_url_strict(url),
+        )
+        .await
+        {
+            Ok(Ok(made)) => Some(made),
+            Ok(Err(_)) => return Err("config"),
+            Err(_) => return Err("network"),
+        };
+    }
+    let Some(made) = client.as_ref() else {
+        return Err("config");
+    };
+    let mut response = made
+        .post(url)
+        .header(reqwest::header::CONTENT_TYPE, "application/json")
+        .body(body)
+        .timeout(HTTP_TIMEOUT)
+        .send()
+        .await
+        .map_err(|_| "network")?;
+    let status = response.status().as_u16();
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| "network")? {
+        if bytes.len() + chunk.len() > MAX_ANSWER {
+            return Err("http");
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    match serde_json::from_slice(&bytes) {
+        Ok(answer) => Ok((status, answer)),
+        // a 200 is hjv-api's own answer; other statuses may come from a proxy in front of it
+        Err(_) if status == 200 => Err("http"),
+        Err(_) => Ok((status, Answer::default())),
+    }
+}
+
+/// What a sync's request brought back: hjv-api's clock if it showed it, and its answer with the
+/// request's `n`, or why there is none.
+struct Exchanged {
+    offset: Option<i64>,
+    reply: Result<(u16, Answer, String), &'static str>,
+}
+
+/// One sync request: the payload, signed with the device key in the envelope, sent once more
+/// right away with hjv-api's clock after a `clock` answer.
+async fn exchange<S: Service>(
+    service: S,
+    key: Option<sign::SecretKey>,
+    pc_id: String,
+    p: String,
+    mut offset: i64,
+) -> Exchanged {
+    let Some(key) = key else {
+        return Exchanged {
+            offset: None,
+            reply: Err("key"),
+        };
+    };
+    let mut learned = None;
+    let mut reply = Err("clock");
+    for _ in 0..2 {
+        let n: [u8; 16] = randombytes::randombytes(16).try_into().unwrap_or([0; 16]);
+        let body = pc_sync_envelope(&key, &pc_id, server_time(offset), &n, &p);
+        let (status, answer) = match service.post(body).await {
+            Ok(answered) => answered,
+            Err(code) => {
+                reply = Err(code);
+                break;
+            }
+        };
+        if SANE_TIME.contains(&answer.server_time) {
+            offset = answer.server_time as i64 - unix_now() as i64;
+            learned = Some(offset);
+        }
+        let clock = status == 400 && answer.error == "clock";
+        reply = Ok((status, answer, URL_SAFE_NO_PAD.encode(n)));
+        if !clock {
+            break;
+        }
+    }
+    Exchanged {
+        offset: learned,
+        reply,
+    }
+}
+
+/// The sync whose request is out, with what its answer is checked against.
+struct Flight {
+    mode: Mode,
+    pc_id: String,
+    pk: Vec<u8>,
+    refused: Refused,
+}
+
+/// The sync task: one per service process. Its loop takes the UI's requests every second and the
+/// proofs' asks as they come; a sync's request runs in a task of its own, one at a time.
+struct Syncer<S: Service> {
+    service: S,
+    /// server_time minus the PC's clock, from the last answer with one
+    offset: i64,
+    refresh: u64,
+    failures: u32,
+    /// when the next sync is due; None while there is nothing to send
+    next: Option<Instant>,
+    /// when the last sync ended, and whether it brought a list
+    done: Option<Instant>,
+    listed: bool,
+    flight: Option<Flight>,
+    /// a sync wanted while one was out, from its end: at once (false) or GAP after it (true)
+    again: Option<bool>,
+    /// proofs waiting for a sync's result, and whether they want one of their own
+    waiting: Vec<oneshot::Sender<bool>>,
+    asked: bool,
+    /// when the last sync proofs waited for ended
+    asked_done: Option<Instant>,
+    /// the bind request in hand, as the option has it, and when to try it again
+    pending: Option<(Request, String)>,
+    retry: Option<Instant>,
+    /// the one report after the binding went
+    report_unbound: bool,
+    knock: String,
+    wall: u64,
+    last: Option<Answered>,
+    last_ok: u64,
+    shown: String,
+    logged: Option<(String, usize)>,
+}
+
+impl<S: Service> Syncer<S> {
+    /// Starts the task; its inbox takes the proofs' asks.
+    fn spawn(service: S) -> Asks {
+        let (asks, inbox) = mpsc::unbounded_channel();
+        let syncer = Syncer {
+            service,
+            offset: 0,
+            refresh: 120,
+            failures: 0,
+            next: None,
+            done: None,
+            listed: false,
+            flight: None,
+            again: None,
+            waiting: Vec::new(),
+            asked: false,
+            asked_done: None,
+            pending: None,
+            retry: None,
+            report_unbound: false,
+            knock: String::new(),
+            wall: 0,
+            last: None,
+            last_ok: 0,
+            shown: String::new(),
+            logged: None,
+        };
+        tokio::spawn(syncer.run(inbox));
+        asks
+    }
+
+    async fn run(mut self, mut asks: mpsc::UnboundedReceiver<oneshot::Sender<bool>>) {
+        self.knock = self.service.option(KNOCK);
+        self.wall = unix_now();
+        let s = self.service.clone();
+        let start = blocking(move || {
+            let pc = s.pc();
+            let view = pc.view();
+            (
+                view.binding.is_some(),
+                view.cached.map(|c| c.received),
+                pc.store.get(LAST_STATE),
+            )
+        })
+        .await;
+        if let Some((bound, received, state)) = start {
+            if bound {
+                self.next = Some(Instant::now());
+            }
+            self.last_ok = received.unwrap_or(0);
+            self.last = state.as_deref().and_then(restored);
+        }
+        self.show().await;
+        let mut tick = interval(TICK);
+        tick.set_missed_tick_behavior(MissedTickBehavior::Delay);
+        let mut request: Option<JoinHandle<Exchanged>> = None;
+        loop {
+            tokio::select! {
+                _ = tick.tick() => self.tick().await,
+                Some(ask) = asks.recv() => self.ask(ask),
+                exchanged = async {
+                    match request.as_mut() {
+                        Some(request) => request.await,
+                        None => std::future::pending().await,
+                    }
+                } => {
+                    request = None;
+                    self.land(exchanged).await;
+                }
+            }
+            if request.is_none() {
+                request = self.launch().await;
+            }
+        }
+    }
+
+    async fn tick(&mut self) {
+        let now = unix_now();
+        if jumped(self.wall, now) {
+            self.soon(false);
+        }
+        self.wall = now;
+        // the unbind goes first, and counts as undoing the bind request in hand: one seen now
+        // (a login and its logout found together), or one the logout took out of the options
+        // while hjv-api had it
+        let bind = self.service.option(BIND_REQ);
+        let seen = Request::parse(&bind);
+        if let Some(req) = &seen {
+            if self.pending.as_ref().map(|(r, _)| r) != Some(req) {
+                self.pending = Some((req.clone(), bind.clone()));
+                self.retry = None;
+            }
+        }
+        let unbind = self.service.option(UNBIND_REQ);
+        if !unbind.is_empty() {
+            self.clear(UNBIND_REQ, &unbind);
+            if let Some(req) = Request::parse(&unbind) {
+                self.unbind(req).await;
+            }
+        }
+        if seen.is_none() {
+            self.pending = None;
+            if !bind.is_empty() {
+                self.clear(BIND_REQ, &bind);
+            }
+        }
+        let off = self.service.option(OFF_REQ);
+        if !off.is_empty() {
+            self.clear(OFF_REQ, &off);
+            if off == "Y" {
+                self.switch_off().await;
+            }
+        }
+        let knock = self.service.option(KNOCK);
+        if knock != self.knock {
+            self.knock = knock;
+            self.soon(true);
+        }
+        // the UI writes Config2's options as a whole and may have dropped it
+        if self.service.option(STATE) != self.shown {
+            self.service.set_option(STATE, &self.shown);
+        }
+    }
+
+    /// A proof wants a sync now: the result of the one in flight, or of the one proofs waited for
+    /// if it ended within GAP, or one of its own. A sync no proof waited for, such as the periodic
+    /// one, may predate the key of a device that logged in just now.
+    fn ask(&mut self, ask: oneshot::Sender<bool>) {
+        if self.flight.is_none() && self.asked_done.is_some_and(|t| t.elapsed() < GAP) {
+            ask.send(self.listed).ok();
+            return;
+        }
+        self.waiting.push(ask);
+        self.asked |= self.flight.is_none();
+    }
+
+    /// A sync as soon as may be: now, or GAP after the last one when `gap`.
+    fn soon(&mut self, gap: bool) {
+        if self.flight.is_some() {
+            self.again = Some(self.again.map_or(gap, |again| again && gap));
+            return;
+        }
+        let mut at = Instant::now();
+        if gap {
+            if let Some(done) = self.done {
+                at = at.max(done + GAP);
+            }
+        }
+        self.next = Some(self.next.map_or(at, |next| next.min(at)));
+    }
+
+    /// What to sync now, if anything: for proofs, the sync that is due, or a bind request. Bind
+    /// requests, which any local user may write, never hold off the sync that is due.
+    async fn due(&mut self) -> Option<Mode> {
+        let now = Instant::now();
+        if self.asked {
+            self.asked = false;
+            let s = self.service.clone();
+            match blocking(move || s.pc().binding()).await.flatten() {
+                Some(binding) => return Some(Mode::Bound(binding)),
+                None => {
+                    for waiting in self.waiting.drain(..) {
+                        waiting.send(false).ok();
+                    }
+                }
+            }
+        }
+        if self.next.is_some_and(|t| now >= t) {
+            let s = self.service.clone();
+            match blocking(move || s.pc().binding()).await.flatten() {
+                Some(binding) => return Some(Mode::Bound(binding)),
+                None if self.report_unbound => return Some(Mode::Unbound),
+                None => self.next = None,
+            }
+        }
+        if let Some((req, raw)) = self.pending.clone() {
+            if !self.retry.is_some_and(|t| now < t) {
+                let (s, r) = (self.service.clone(), req.clone());
+                let done = blocking(move || {
+                    let pc = s.pc();
+                    pc.binding().as_deref() == Some(r.binding.as_str())
+                        && pc.number(LOGIN_AT).is_some_and(|l| l >= r.login_at)
+                })
+                .await;
+                if done != Some(true) {
+                    hbb_common::throttled_log!(Duration::from_secs(60), info, "hjv: bind request");
+                    return Some(Mode::Bind(req));
+                }
+                self.clear(BIND_REQ, &raw);
+                self.pending = None;
+            }
+        }
+        None
+    }
+
+    /// Sends the sync that is due, if one is.
+    async fn launch(&mut self) -> Option<JoinHandle<Exchanged>> {
+        let mode = self.due().await?;
+        let (pc_id, sk, pk) = self.service.device();
+        let (s, binding) = (self.service.clone(), mode.binding().to_owned());
+        let (off, used) = blocking(move || {
+            let pc = s.pc();
+            let off = pc.off() && pc.binding().as_deref() == Some(binding.as_str());
+            (off, pc.used(unix_now()))
+        })
+        .await
+        .unwrap_or_default();
+        let refused = *self.service.refused().lock().unwrap();
+        let p = payload(mode.binding(), crate::VERSION, off, &used, refused);
+        let request = exchange(
+            self.service.clone(),
+            sign::SecretKey::from_slice(&sk),
+            pc_id.clone(),
+            p,
+            self.offset,
+        );
+        // what was due goes with this request, what comes up while it is out (soon) is due after;
+        // a bind request leaves the periodic sync where it was
+        if !matches!(mode, Mode::Bind(_)) {
+            self.next = None;
+        }
+        self.flight = Some(Flight {
+            mode,
+            pc_id,
+            pk,
+            refused,
+        });
+        Some(tokio::spawn(request))
+    }
+
+    /// The answer to the request in flight.
+    async fn land(&mut self, exchanged: Result<Exchanged, JoinError>) {
+        let Some(flight) = self.flight.take() else {
+            return;
+        };
+        let answered = match exchanged {
+            Err(_) => Answered::Failed("task"),
+            Ok(Exchanged { offset, reply }) => {
+                if let Some(offset) = offset {
+                    self.offset = offset;
+                }
+                match reply {
+                    Err(code) => Answered::Failed(code),
+                    Ok((status, answer, n)) => {
+                        if status == 200 {
+                            self.service.refused().lock().unwrap().take(&flight.refused);
+                        }
+                        // a bind request withdrawn while it was out (a logout, a newer login)
+                        // binds nothing, whatever records the unbind could leave
+                        let withdrawn = matches!(&flight.mode, Mode::Bind(req)
+                            if self.pending.as_ref().map(|(r, _)| r) != Some(req));
+                        if withdrawn {
+                            self.after(&flight.mode, Answered::Superseded).await;
+                            return;
+                        }
+                        let s = self.service.clone();
+                        let (mode, pc_id, pk) =
+                            (flight.mode.clone(), flight.pc_id.clone(), flight.pk.clone());
+                        blocking(move || {
+                            apply(
+                                &s.pc(),
+                                &s.pinned(),
+                                (&pc_id, &pk),
+                                &mode,
+                                &n,
+                                status,
+                                &answer,
+                                unix_now(),
+                            )
+                        })
+                        .await
+                        .unwrap_or(Answered::Failed("store"))
+                    }
+                }
+            }
+        };
+        self.after(&flight.mode, answered).await;
+    }
+
+    async fn after(&mut self, mode: &Mode, answered: Answered) {
+        let now = unix_now();
+        self.done = Some(Instant::now());
+        self.listed = matches!(answered, Answered::Kept { .. });
+        match &answered {
+            Answered::Kept {
+                state,
+                keys,
+                refresh,
+            } => {
+                self.refresh = *refresh;
+                self.failures = 0;
+                self.last_ok = now;
+                if self.logged.as_ref() != Some(&(state.clone(), *keys)) {
+                    log::info!("hjv: trust list {state}, {keys} key(s)");
+                    self.logged = Some((state.clone(), *keys));
+                }
+            }
+            Answered::Failed(code) => {
+                self.failures = self.failures.saturating_add(1);
+                hbb_common::throttled_log!(
+                    Duration::from_secs(600),
+                    warn,
+                    "hjv: sync failed: {code}"
+                );
+            }
+            Answered::Revoked => {
+                self.failures = 0;
+                self.logged = None;
+                self.report_unbound = true;
+                log::info!("hjv: trust list revoked: this PC's binding is gone");
+            }
+            Answered::NeedsRelogin => {
+                self.failures = 0;
+                hbb_common::throttled_log!(
+                    Duration::from_secs(600),
+                    warn,
+                    "hjv: hjv-api does not take this PC's device key; log in on it again"
+                );
+            }
+            Answered::BindRefused(code) => {
+                self.failures = 0;
+                hbb_common::throttled_log!(
+                    Duration::from_secs(60),
+                    info,
+                    "hjv: bind request refused: {code}"
+                );
+            }
+            Answered::Unsigned | Answered::Superseded => self.failures = 0,
+        }
+        let wait = match answered {
+            Answered::Failed(_) => backoff(self.failures, random_u32()),
+            _ => sync_interval(self.refresh, random_u32()),
+        };
+        let planned = Instant::now() + wait;
+        self.next = match mode {
+            Mode::Bind(_) => Some(self.next.map_or(planned, |next| next.min(planned))),
+            _ => Some(planned),
+        };
+        if let Some(gap) = self.again.take() {
+            self.soon(gap);
+        }
+        match mode {
+            Mode::Unbound => {
+                if !matches!(answered, Answered::Failed(_)) {
+                    self.report_unbound = false;
+                }
+            }
+            // a bind request withdrawn while it was out (a logout) shows nothing
+            Mode::Bind(req) => {
+                if self.pending.as_ref().is_some_and(|(r, _)| r == req) {
+                    if let Answered::Failed(_) = answered {
+                        // kept for another try, with the syncs' back-off
+                        self.retry = Some(planned);
+                    } else if let Some((_, raw)) = self.pending.take() {
+                        self.clear(BIND_REQ, &raw);
+                    }
+                    // nor does a refused one for the binding this PC goes on with
+                    // (a stale request of it put back)
+                    let s = self.service.clone();
+                    let goes_on = matches!(answered, Answered::BindRefused(_))
+                        && blocking(move || s.pc().binding()).await.flatten().as_ref()
+                            == Some(&req.binding);
+                    if !goes_on {
+                        self.last = Some(answered.clone());
+                    }
+                }
+            }
+            Mode::Bound(_) => {
+                if answered != Answered::Superseded {
+                    self.last = Some(answered.clone());
+                }
+            }
+        }
+        if answered == Answered::Revoked {
+            self.soon(true);
+        }
+        if !self.waiting.is_empty() {
+            self.asked_done = Some(Instant::now());
+        }
+        for waiting in self.waiting.drain(..) {
+            waiting.send(self.listed).ok();
+        }
+        self.show().await;
+    }
+
+    async fn unbind(&mut self, req: Request) {
+        let s = self.service.clone();
+        let pending = self.pending.as_ref().map(|(r, _)| r.clone());
+        let now = server_time(self.offset);
+        let dropped =
+            blocking(move || s.pc().unbind(&req, pending.as_ref(), now)).await == Some(true);
+        if dropped {
+            log::info!("hjv: unbind request: this PC's binding is gone");
+            self.last = None;
+            self.logged = None;
+            self.report_unbound = true;
+            self.soon(true);
+        } else {
+            hbb_common::throttled_log!(Duration::from_secs(60), info, "hjv: unbind request");
+        }
+        self.show().await;
+    }
+
+    async fn switch_off(&mut self) {
+        let s = self.service.clone();
+        let pending = self.pending.as_ref().map(|(r, _)| r.clone());
+        let now = server_time(self.offset);
+        if blocking(move || s.pc().switch_off(pending.as_ref(), now)).await == Some(true) {
+            hbb_common::throttled_log!(
+                Duration::from_secs(60),
+                info,
+                "hjv: password-less logins switched off on this PC"
+            );
+            self.soon(true);
+        }
+        self.show().await;
+    }
+
+    /// Clears a request the service handled, unless the UI wrote a new one meanwhile.
+    fn clear(&self, name: &str, handled: &str) {
+        if self.service.option(name) == handled {
+            self.service.set_option(name, "");
+        }
+    }
+
+    /// Writes hjv-pwless-state (and LastState in the key) from the binding as it is now.
+    async fn show(&mut self) {
+        let s = self.service.clone();
+        let last = self.last.clone();
+        let last_ok = self.last_ok;
+        let state = blocking(move || {
+            let pc = s.pc();
+            let state = display(&pc.view(), last.as_ref(), last_ok, unix_now());
+            if pc.store.get(LAST_STATE).as_deref() != Some(state.as_str()) {
+                pc.store.set(LAST_STATE, &state);
+            }
+            state
+        })
+        .await;
+        let Some(state) = state else {
+            return;
+        };
+        if self.service.option(STATE) != state {
+            self.service.set_option(STATE, &state);
+        }
+        self.shown = state;
+    }
+}
