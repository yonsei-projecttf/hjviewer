+//! The PC's binding rules (design v3 4-4 to 4-7), its answers to a sync, its use counts and the
+//! sync request, on an in-memory key and the Linux file; and the sync task itself against an
+//! in-memory hjv-api.
+
+use super::*;
+use crate::hjviewer_account::{
+    conn_proof, parse_trust_pubkeys, pc_sync_message, trust_message,
+    vectors::{
+        self, device_key, pk_bytes, ACCOUNT_PK, ACCOUNT_SEED, CTL_ID, HJV_TRUST_PUBKEYS,
+        LIST_1_SEED, PC_ID, PC_PK, PC_SEED, SYNC_ACCEPTED, SYNC_BODY, SYNC_N_BYTES, SYNC_P, T,
+    },
+    AccountKey, KIND_FILE, KIND_PORT_FORWARD, KIND_REMOTE, KIND_TERMINAL,
+};
+use std::collections::BTreeMap;
+
+/// HKLM\SOFTWARE\HJViewer\Account in memory: None while the key does not exist.
+#[derive(Default, Clone)]
+struct MemStore(Arc<Mutex<Option<BTreeMap<String, String>>>>);
+
+impl MemStore {
+    /// What the uninstaller does to the key.
+    fn delete(&self) {
+        *self.0.lock().unwrap() = None;
+    }
+}
+
+impl Store for MemStore {
+    fn exists(&self) -> bool {
+        self.0.lock().unwrap().is_some()
+    }
+
+    fn create(&self) -> bool {
+        self.0.lock().unwrap().get_or_insert_with(BTreeMap::new);
+        true
+    }
+
+    fn get(&self, name: &str) -> Option<String> {
+        self.0.lock().unwrap().as_ref()?.get(name).cloned()
+    }
+
+    fn set(&self, name: &str, value: &str) -> bool {
+        match self.0.lock().unwrap().as_mut() {
+            Some(values) => {
+                values.insert(name.to_owned(), value.to_owned());
+                true
+            }
+            None => false,
+        }
+    }
+
+    fn remove(&self, name: &str) {
+        if let Some(values) = self.0.lock().unwrap().as_mut() {
+            values.remove(name);
+        }
+    }
+}
+
+const NOW: u64 = 1_760_000_000;
+/// The binding ID of the vectors.
+const ID: &str = vectors::BINDING;
+const OTHER: &str = "0123456789abcdef0123456789abcdef";
+/// A phone of the account that logged in after the vectors' controller (key serial 11).
+const NEWCOMER_SEED: [u8; 32] = [7; 32];
+const NEWCOMER_ID: &str = "555555555";
+
+fn path_of(name: &str) -> PathBuf {
+    std::env::temp_dir().join(format!("hjv-pc-{name}-{}", std::process::id()))
+}
+
+fn dir(name: &str) -> PathBuf {
+    let dir = path_of(name);
+    std::fs::remove_dir_all(&dir).ok();
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+fn cleanup(names: &[&str]) {
+    for name in names {
+        std::fs::remove_dir_all(path_of(name)).ok();
+    }
+}
+
+/// A PC that never had the key.
+fn fresh_pc(name: &str) -> Pc<MemStore> {
+    Pc {
+        store: MemStore::default(),
+        trust: dir(name).join(TRUST_FILE),
+    }
+}
+
+fn pc_pk() -> Vec<u8> {
+    pk_bytes(PC_PK)
+}
+
+fn owner() -> AccountKey {
+    AccountKey::from_seed(&ACCOUNT_SEED).unwrap()
+}
+
+/// A list as hjv-api signs it with list key 1, for the vector PC.
+struct Signed {
+    binding: String,
+    req: String,
+    state: &'static str,
+    iat: u64,
+    login_at: u64,
+    refresh: u64,
+    strict: bool,
+    /// the newcomer's key too, which makes the list's serial 11
+    newcomer: bool,
+    /// hjv-api's revoked lists: no keys, no owner, no login
+    bare: bool,
+}
+
+impl Signed {
+    fn new(binding: &str, req: &str, iat: u64, login_at: u64) -> Signed {
+        Signed {
+            binding: binding.to_owned(),
+            req: req.to_owned(),
+            state: "active",
+            iat,
+            login_at,
+            refresh: 120,
+            strict: false,
+            newcomer: false,
+            bare: false,
+        }
+    }
+
+    fn state(mut self, state: &'static str) -> Signed {
+        self.state = state;
+        self
+    }
+
+    fn bare(mut self) -> Signed {
+        self.bare = true;
+        self
+    }
+
+    fn answer(&self) -> Answer {
+        let (owner, login_at, keys) = if self.bare {
+            ("", 0, serde_json::json!([]))
+        } else {
+            let mut keys = vec![
+                serde_json::json!({"pk": ACCOUNT_PK, "id": CTL_ID, "name": "iPhone 14 Pro",
+                                   "platform": "ios", "kinds": ["remote", "file", "camera"],
+                                   "ks": 10}),
+            ];
+            if self.newcomer {
+                let pk = AccountKey::from_seed(&NEWCOMER_SEED).unwrap().public_key();
+                keys.push(
+                    serde_json::json!({"pk": STANDARD.encode(pk), "id": NEWCOMER_ID,
+                                       "name": "Galaxy S24", "platform": "android",
+                                       "kinds": ["remote", "file", "camera"], "ks": 11}),
+                );
+            }
+            ("홍*동", self.login_at, serde_json::json!(keys))
+        };
+        // the field order of hjv-api's lists
+        let l = serde_json::json!({
+            "v": 1, "typ": "hjv-trust", "kid": 1, "binding": self.binding,
+            "pc_id": PC_ID, "pc_pk": PC_PK, "req": self.req,
+            "serial": if self.newcomer { 11 } else { 10 },
+            "iat": self.iat, "exp": self.iat + 86_400, "refresh": self.refresh,
+            "strict": self.strict, "state": self.state, "owner": owner, "login_at": login_at,
+            "keys": keys
+        });
+        let bytes = serde_json::to_vec(&l).unwrap();
+        let s = sign::sign_detached(&trust_message(&bytes), &device_key(&LIST_1_SEED));
+        Answer {
+            server_time: self.iat,
+            error: String::new(),
+            list: Some(SignedList {
+                kid: 1,
+                l: STANDARD.encode(&bytes),
+                s: STANDARD.encode(s.to_bytes()),
+            }),
+        }
+    }
+}
+
+fn reply(
+    pc: &Pc<MemStore>,
+    mode: Mode,
+    n: &str,
+    status: u16,
+    answer: &Answer,
+    now: u64,
+) -> Answered {
+    let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+    apply(
+        pc,
+        &pinned,
+        (PC_ID, &pc_pk()),
+        &mode,
+        n,
+        status,
+        answer,
+        now,
+    )
+}
+
+fn request(binding: &str, login_at: u64) -> Request {
+    Request {
+        binding: binding.to_owned(),
+        login_at,
+    }
+}
+
+/// Binds `pc` to ID by a login at `login_at`, with the list of that sync.
+fn bind_to(pc: &Pc<MemStore>, login_at: u64) {
+    let answer = Signed::new(ID, "n0", login_at + 5, login_at).answer();
+    let bind = Mode::Bind(request(ID, login_at));
+    assert!(matches!(
+        reply(pc, bind, "n0", 200, &answer, login_at + 6),
+        Answered::Kept { .. }
+    ));
+}
+
+/// A PC bound to ID by a login at `login_at`, with the list of that sync.
+fn bound(name: &str, login_at: u64) -> Pc<MemStore> {
+    let pc = fresh_pc(name);
+    bind_to(&pc, login_at);
+    pc
+}
+
+fn proof_from(
+    pc: &Pc<MemStore>,
+    kind: u8,
+    nonce: &[u8; 32],
+    now: u64,
+) -> Result<KeyEntry, Refusal> {
+    let pk = pc_pk();
+    let proof = conn_proof(&owner(), PC_ID, &pk, nonce, CTL_ID, kind, 10).unwrap();
+    let login = KeyLogin {
+        pc_id: PC_ID,
+        pc_pk: &pk,
+        secured: true,
+        nonce,
+        proof: &proof,
+        my_id: CTL_ID,
+        kind,
+    };
+    decide(&pc.view(), &login, now)
+}
+
+#[test]
+fn a_bind_needs_hjv_apis_word_and_a_login_just_now() {
+    let _ = hbb_common::sodiumoxide::init();
+    // a login 5 s before the list: the binding, its owner, its login and the list
+    let pc = bound("bind", NOW);
+    assert_eq!(pc.binding().as_deref(), Some(ID));
+    assert_eq!(pc.store.get(OWNER).as_deref(), Some("홍*동"));
+    assert_eq!(pc.number(LOGIN_AT), Some(NOW));
+    assert_eq!(pc.number(AT), Some(NOW + 6));
+    assert_eq!(pc.view().cached.unwrap().received, NOW + 6);
+    assert_eq!(
+        proof_from(&pc, KIND_REMOTE, &[5; 32], NOW + 60).unwrap().id,
+        CTL_ID
+    );
+
+    // the login more than ten minutes before the list, or a list hjv-api did not sign for this
+    // binding, or another request's list: no key is made
+    let old = fresh_pc("bind-old");
+    let stale = Signed::new(ID, "n1", NOW + 601, NOW).answer();
+    let bind = || Mode::Bind(request(ID, NOW));
+    assert_eq!(
+        reply(&old, bind(), "n1", 200, &stale, NOW + 601),
+        Answered::BindRefused("bind-stale")
+    );
+    let unsigned = Answer {
+        list: None,
+        ..stale
+    };
+    assert_eq!(
+        reply(&old, bind(), "n1", 200, &unsigned, NOW + 601),
+        Answered::BindRefused("bind-mismatch")
+    );
+    assert_eq!(
+        reply(&old, bind(), "n1", 404, &Answer::default(), NOW + 601),
+        Answered::BindRefused("bind-mismatch")
+    );
+    let replayed = Signed::new(ID, "n0", NOW + 5, NOW).answer();
+    assert_eq!(
+        reply(&old, bind(), "n1", 200, &replayed, NOW + 6),
+        Answered::Failed("list")
+    );
+    let other = Signed::new(OTHER, "n1", NOW + 5, NOW).answer();
+    assert_eq!(
+        reply(&old, bind(), "n1", 200, &other, NOW + 6),
+        Answered::Failed("list")
+    );
+    assert!(!old.store.exists());
+
+    // a paused account's PC is bound and shows it; a revoked binding is not
+    let paused = fresh_pc("bind-paused");
+    let disabled = Signed::new(ID, "n1", NOW + 5, NOW)
+        .state("disabled")
+        .answer();
+    assert!(matches!(
+        reply(&paused, bind(), "n1", 200, &disabled, NOW + 6),
+        Answered::Kept { .. }
+    ));
+    assert_eq!(display(&paused.view(), None, NOW + 6, NOW + 7), "disabled");
+    assert_eq!(
+        proof_from(&paused, KIND_REMOTE, &[5; 32], NOW + 60).unwrap_err(),
+        Refusal::NotActive
+    );
+    let gone = fresh_pc("bind-revoked");
+    let revoked = Signed::new(ID, "n1", NOW + 5, NOW)
+        .state("revoked")
+        .bare()
+        .answer();
+    assert_eq!(
+        reply(&gone, bind(), "n1", 200, &revoked, NOW + 6),
+        Answered::BindRefused("bind-revoked")
+    );
+    assert!(!gone.store.exists());
+    cleanup(&["bind", "bind-old", "bind-paused", "bind-revoked"]);
+}
