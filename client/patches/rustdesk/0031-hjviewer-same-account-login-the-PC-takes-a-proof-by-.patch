+//! Same-account logins at this PC (design v3 3-5): a proof in the LoginRequest opens the session
+//! as the right permanent password would. A child module of connection.rs, so it calls the
+//! connection's private steps as they are. It reads the latched `self.lr`, because the login
+//! branch moves parts of `lr` (`match lr.union`).
+
+use super::*;
+use crate::hjviewer_account;
+
+/// The Hash's `hjv_nonce`: 32 new bytes where this process takes same-account logins, else empty,
+/// which keeps the Hash as 1.5.1 sends it.
+pub(super) fn nonce() -> hbb_common::bytes::Bytes {
+    hjviewer_account::hash_nonce()
+}
+
+impl Connection {
+    /// After the click-approval branch. None for a login without a proof, or with one this PC
+    /// refused: the branches after this one then run as before, a refused proof without a password
+    /// first answered with "Empty Password", which every controller takes for its password prompt.
+    /// A refusal does not count as a failed attempt. Some(keep_alive) once this branch decided:
+    /// the proof was accepted, or the address is blocked for its failed attempts.
+    pub(super) async fn hjv_account_login(
+        &mut self,
+        allow_logon_screen_password: bool,
+    ) -> Option<bool> {
+        if self.hash.hjv_nonce.is_empty() {
+            return None;
+        }
+        let proof = self.lr.hjv_key_proof.as_ref()?.clone();
+        // where only the temporary password opens this PC, what was seen there is the only way in
+        let permanent_ok = password::permanent_enabled() || allow_logon_screen_password;
+        let mut failure = None;
+        if permanent_ok {
+            let (f, res) = self.check_failure(0).await;
+            if !res {
+                return Some(true);
+            }
+            failure = Some(f);
+        }
+        let accepted = hjviewer_account::key_login(
+            permanent_ok,
+            self.stream.is_secured(),
+            &self.hash.hjv_nonce,
+            &proof,
+            &self.lr.my_id,
+            hjviewer_account::kind_of_union(&self.lr.union),
+        )
+        .await;
+        let Ok(accepted) = accepted else {
+            if self.lr.password.is_empty() {
+                self.send_login_error(crate::client::LOGIN_MSG_PASSWORD_EMPTY)
+                    .await;
+            }
+            return None;
+        };
+        if let Some(failure) = failure {
+            self.update_failure_with_scope(failure, true, 0, FailureScope::Default);
+        }
+        if !self.send_logon_response_and_keep_alive().await {
+            return Some(false);
+        }
+        self.try_start_cm(self.lr.my_id.clone(), accepted.name, self.authorized);
+        Some(true)
+    }
+}
