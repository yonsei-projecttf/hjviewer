+#[tokio::test(start_paused = true)]
+async fn a_login_binds_and_a_logout_unbinds_within_the_second_however_slow_hjv_api_is() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pc = Fake::new("loop-bind");
+    let login = unix_now() - 5;
+    pc.api().bound = Some((ID.to_owned(), login));
+    let _asks = Syncer::spawn(pc.clone());
+    // an unbound PC sends nothing
+    sleep(30).await;
+    assert_eq!(pc.requests(), 0);
+    // the login's bind request and knock, as the UI writes them
+    let req = format!("{ID}.{login}");
+    pc.set_option(BIND_REQ, &req);
+    pc.set_option(KNOCK, "1");
+    until("bound", || pc.binding().as_deref() == Some(ID)).await;
+    until("shown", || pc.option(STATE).starts_with("active 1 ")).await;
+    assert_eq!(pc.option(BIND_REQ), "");
+    assert_eq!(pc.api().got[0].0["binding"], ID);
+    assert_eq!(pc.pc().number(LOGIN_AT), Some(login));
+
+    // hjv-api stops answering; the off switch and the logout's unbind still act within the
+    // second
+    pc.api().delay = Duration::from_secs(60);
+    pc.set_option(KNOCK, "2");
+    until("a request out", || pc.api().out == 1).await;
+    pc.set_option(OFF_REQ, "Y");
+    let second = Duration::from_millis(1100);
+    assert!(until("off", || pc.option(STATE) == "off").await <= second);
+    assert!(pc.pc().off());
+    assert_eq!(pc.option(OFF_REQ), "");
+    // Off lives in the key: the request written over or taken away changes nothing
+    pc.set_option(OFF_REQ, "N");
+    sleep(2).await;
+    assert!(pc.pc().off());
+    assert_eq!(
+        (pc.option(OFF_REQ), pc.option(STATE)),
+        (String::new(), "off".to_owned())
+    );
+    pc.set_option(UNBIND_REQ, &req);
+    assert!(until("unbound", || pc.binding().is_none()).await <= second);
+    assert_eq!(pc.api().out, 1);
+    assert!(!pc.pc().off());
+    assert_eq!(
+        (pc.option(UNBIND_REQ), pc.option(STATE)),
+        (String::new(), String::new())
+    );
+    assert_eq!(pc.store.get(UNBOUND_BINDING).as_deref(), Some(ID));
+    assert_eq!(pc.pc().number(UNBOUND_LOGIN_AT), Some(login));
+
+    // when hjv-api answers again: the late answer changes nothing, one report says the binding
+    // went, and that login's bind request put back does not bind
+    pc.api().delay = Duration::ZERO;
+    until("the report", || {
+        pc.api().got.last().is_some_and(|(p, _)| p["binding"] == "")
+    })
+    .await;
+    assert_eq!(pc.binding(), None);
+    pc.set_option(BIND_REQ, &req);
+    until("refused", || {
+        pc.option(STATE).starts_with("error bind-released ")
+    })
+    .await;
+    assert_eq!((pc.binding(), pc.option(BIND_REQ)), (None, String::new()));
+    // a later login binds again
+    pc.api().bound = Some((ID.to_owned(), login + 1));
+    pc.set_option(BIND_REQ, &format!("{ID}.{}", login + 1));
+    until("bound again", || pc.binding().as_deref() == Some(ID)).await;
+    cleanup(&["loop-bind"]);
+}
