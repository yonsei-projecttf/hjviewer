+/// hjv-api answering /api/hjv/pc/sync for the vector PC as design 5-2 says.
+#[derive(Default)]
+struct FakeApi {
+    /// this PC's binding on the server and the last login on the PC
+    bound: Option<(String, u64)>,
+    /// released bindings: a signed revoked
+    released: Vec<String>,
+    /// the administrator's switch off: a disabled list, with its owner and login as hjv-api has
+    /// them, which binds the PC as an active one does
+    disabled: bool,
+    strict: bool,
+    newcomer: bool,
+    refresh: u64,
+    /// hjv-api's clock minus the PC's
+    skew: i64,
+    /// how long an answer takes
+    delay: Duration,
+    /// each request's payload and `t`
+    got: Vec<(serde_json::Value, u64)>,
+    out: usize,
+}
+
+impl FakeApi {
+    fn answer(&mut self, body: &str) -> (u16, Answer) {
+        let envelope: serde_json::Value = serde_json::from_str(body).unwrap();
+        let text = |name: &str| envelope[name].as_str().unwrap().to_owned();
+        let (id, n, p, s) = (text("id"), text("n"), text("p"), text("s"));
+        let t = envelope["t"].as_u64().unwrap();
+        // signed by the PC's device key
+        let sig = sign::Signature::from_bytes(&STANDARD.decode(s).unwrap()).unwrap();
+        let pk = sign::PublicKey::from_slice(&pc_pk()).unwrap();
+        assert!(sign::verify_detached(
+            &sig,
+            &pc_sync_message(&id, t, &n, &p),
+            &pk
+        ));
+        let now = (unix_now() as i64 + self.skew) as u64;
+        let p: serde_json::Value = serde_json::from_str(&p).unwrap();
+        self.got.push((p.clone(), t));
+        let plain = |status, error: &str| {
+            (
+                status,
+                Answer {
+                    server_time: now,
+                    error: error.to_owned(),
+                    list: None,
+                },
+            )
+        };
+        if t.abs_diff(now) > 300 {
+            return plain(400, "clock");
+        }
+        let binding = p["binding"].as_str().unwrap().to_owned();
+        if !binding.is_empty() && self.released.contains(&binding) {
+            let list = Signed::new(&binding, &n, now, 0).state("revoked").bare();
+            return (200, list.answer());
+        }
+        match &self.bound {
+            Some((b, login_at)) if *b == binding => {
+                let mut list = Signed::new(&binding, &n, now, *login_at);
+                list.refresh = self.refresh;
+                list.strict = self.strict;
+                list.newcomer = self.newcomer;
+                if self.disabled {
+                    list = list.state("disabled");
+                }
+                (200, list.answer())
+            }
+            Some(_) => plain(200, ""),
+            None => plain(404, "unbound"),
+        }
+    }
+}
+
+/// The service with its options, key, refusal counts and hjv-api in memory.
+#[derive(Clone)]
+struct Fake {
+    options: Arc<Mutex<BTreeMap<String, String>>>,
+    store: MemStore,
+    trust: PathBuf,
+    refused: Arc<Mutex<Refused>>,
+    api: Arc<Mutex<FakeApi>>,
+}
+
+impl Fake {
+    fn new(name: &str) -> Fake {
+        Fake {
+            options: Arc::default(),
+            store: MemStore::default(),
+            trust: dir(name).join(TRUST_FILE),
+            refused: Arc::default(),
+            api: Arc::new(Mutex::new(FakeApi {
+                refresh: 120,
+                ..FakeApi::default()
+            })),
+        }
+    }
+
+    fn api(&self) -> std::sync::MutexGuard<'_, FakeApi> {
+        self.api.lock().unwrap()
+    }
+
+    fn requests(&self) -> usize {
+        self.api().got.len()
+    }
+
+    fn binding(&self) -> Option<String> {
+        self.pc().binding()
+    }
+}
+
+impl Service for Fake {
+    type Store = MemStore;
+
+    fn option(&self, name: &str) -> String {
+        self.options
+            .lock()
+            .unwrap()
+            .get(name)
+            .cloned()
+            .unwrap_or_default()
+    }
+
+    fn set_option(&self, name: &str, value: &str) {
+        let mut options = self.options.lock().unwrap();
+        if value.is_empty() {
+            options.remove(name);
+        } else {
+            options.insert(name.to_owned(), value.to_owned());
+        }
+    }
+
+    fn pc(&self) -> Pc<MemStore> {
+        Pc {
+            store: self.store.clone(),
+            trust: self.trust.clone(),
+        }
+    }
+
+    fn device(&self) -> (String, Vec<u8>, Vec<u8>) {
+        (PC_ID.to_owned(), device_key(&PC_SEED).0.to_vec(), pc_pk())
+    }
+
+    fn pinned(&self) -> Vec<(u32, [u8; 32])> {
+        parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap()
+    }
+
+    fn refused(&self) -> &Mutex<Refused> {
+        &self.refused
+    }
+
+    fn post(&self, body: String) -> Posted {
+        let api = self.api.clone();
+        Box::pin(async move {
+            let delay = {
+                let mut api = api.lock().unwrap();
+                api.out += 1;
+                api.delay
+            };
+            tokio::time::sleep(delay).await;
+            let answer = {
+                let mut api = api.lock().unwrap();
+                api.out -= 1;
+                api.answer(&body)
+            };
+            Ok(answer)
+        })
+    }
+}
+
+/// Waits (on the test runtime's paused clock) until `done`, ten minutes at most, and says how
+/// long it took.
+async fn until(what: &str, done: impl Fn() -> bool) -> Duration {
+    let start = Instant::now();
+    for _ in 0..6000 {
+        if done() {
+            return start.elapsed();
+        }
+        tokio::time::sleep(Duration::from_millis(100)).await;
+    }
+    panic!("not within ten minutes: {what}");
+}
+
+async fn sleep(secs: u64) {
+    tokio::time::sleep(Duration::from_secs(secs)).await;
+}
