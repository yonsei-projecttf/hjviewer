+/// One sync now, for a proof the cached list cannot decide: the sync task runs one at a time
+/// (later callers get its result), none within GAP of the last one proofs waited for (they get
+/// that one's result), and a caller waits WAIT at most. Whether the sync brought a list.
+async fn refresh_now(asks: Option<&Asks>) -> bool {
+    let Some(asks) = asks else {
+        return false;
+    };
+    let (ask, answer) = oneshot::channel();
+    if asks.send(ask).is_err() {
+        return false;
+    }
+    matches!(timeout(WAIT, answer).await, Ok(Ok(true)))
 }
 
