+#[test]
+fn an_undone_login_again_on_a_bound_pc_stays_undone() {
+    let _ = hbb_common::sodiumoxide::init();
+    // bound by a login at NOW, its last list from NOW + 100; the owner logs in again at NOW + 200
+    // and out before the service took that bind request (hjv-api unreachable, say)
+    let pc = bound("again", NOW);
+    let list = Signed::new(ID, "n1", NOW + 100, NOW).answer();
+    assert!(matches!(
+        reply(&pc, Mode::Bound(ID.to_owned()), "n1", 200, &list, NOW + 100),
+        Answered::Kept { .. }
+    ));
+    let again = request(ID, NOW + 200);
+    assert!(pc.unbind(&again, Some(&again), NOW + 210));
+    assert_eq!(pc.number(UNBOUND_LOGIN_AT), Some(NOW + 200));
+    // so that login's request, put back within its ten minutes, does not bind
+    let replay = Signed::new(ID, "n2", NOW + 300, NOW + 200).answer();
+    assert_eq!(
+        reply(&pc, Mode::Bind(again), "n2", 200, &replay, NOW + 301),
+        Answered::BindRefused("bind-released")
+    );
+    // a bind request and an unbind made up together hold the record to hjv-api's clock
+    let forged = request(ID, u64::MAX);
+    let other = bound("again-forged", NOW);
+    assert!(other.unbind(&forged, Some(&forged), NOW + 10));
+    assert_eq!(
+        other.number(UNBOUND_LOGIN_AT),
+        Some(NOW + 10 + PENDING_AHEAD)
+    );
+    cleanup(&["again", "again-forged"]);
+}
