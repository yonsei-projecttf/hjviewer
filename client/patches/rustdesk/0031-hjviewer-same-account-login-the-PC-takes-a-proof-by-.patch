+#[test]
+fn off_holds_until_a_later_login() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pc = bound("off", NOW);
+    assert!(pc.switch_off(None, NOW + 30));
+    assert_eq!(pc.number(OFF), Some(NOW));
+    assert_eq!(
+        proof_from(&pc, KIND_REMOTE, &[5; 32], NOW + 60).unwrap_err(),
+        Refusal::Off
+    );
+    assert_eq!(display(&pc.view(), None, NOW, NOW + 60), "off");
+    // Config2 is not where Off lives; the same login's bind request again leaves it off
+    let again = Signed::new(ID, "n1", NOW + 100, NOW).answer();
+    assert!(matches!(
+        reply(
+            &pc,
+            Mode::Bind(request(ID, NOW)),
+            "n1",
+            200,
+            &again,
+            NOW + 101
+        ),
+        Answered::Kept { .. }
+    ));
+    assert!(pc.off());
+    // a later login on this PC turns it on again
+    let later = Signed::new(ID, "n2", NOW + 200, NOW + 190).answer();
+    assert!(matches!(
+        reply(
+            &pc,
+            Mode::Bind(request(ID, NOW + 190)),
+            "n2",
+            200,
+            &later,
+            NOW + 201
+        ),
+        Answered::Kept { .. }
+    ));
+    assert!(!pc.off());
+    assert_eq!(pc.number(LOGIN_AT), Some(NOW + 190));
+    assert!(proof_from(&pc, KIND_REMOTE, &[5; 32], NOW + 260).is_ok());
+
+    // switched off while a login's bind request is in hand (hjv-api slow or away): hjv-api's
+    // confirmation of that earlier login leaves it off; a made-up request in hand holds it off up
+    // to PENDING_AHEAD past hjv-api's clock, and no later
+    let relogin = request(ID, NOW + 300);
+    assert!(pc.switch_off(Some(&relogin), NOW + 310));
+    assert_eq!(pc.number(OFF), Some(NOW + 300));
+    let late = Signed::new(ID, "n3", NOW + 320, NOW + 300).answer();
+    let rebind = |login_at| Mode::Bind(request(ID, login_at));
+    assert!(matches!(
+        reply(&pc, rebind(NOW + 300), "n3", 200, &late, NOW + 321),
+        Answered::Kept { .. }
+    ));
+    assert!(pc.off());
+    let made_up = request(ID, u64::MAX);
+    assert!(pc.switch_off(Some(&made_up), NOW + 330));
+    assert_eq!(pc.number(OFF), Some(NOW + 330 + PENDING_AHEAD));
+    let owner = Signed::new(ID, "n4", NOW + 990, NOW + 980).answer();
+    assert!(matches!(
+        reply(&pc, rebind(NOW + 980), "n4", 200, &owner, NOW + 991),
+        Answered::Kept { .. }
+    ));
+    assert!(!pc.off());
+    cleanup(&["off"]);
+}
