+#[test]
+fn an_undone_login_stays_undone() {
+    let _ = hbb_common::sodiumoxide::init();
+    // logged out after the bind: the binding goes at once, offline too, and the same login's
+    // bind request (still within ten minutes of it) does not bring it back
+    let pc = bound("undone", NOW);
+    assert!(pc.unbind(&request(ID, NOW), None, NOW + 30));
+    assert_eq!(pc.binding(), None);
+    assert!(!pc.off() && pc.cached().is_none());
+    assert_eq!(
+        (
+            pc.store.get(UNBOUND_BINDING).as_deref(),
+            pc.number(UNBOUND_LOGIN_AT)
+        ),
+        (Some(ID), Some(NOW))
+    );
+    let replay = Signed::new(ID, "n1", NOW + 60, NOW).answer();
+    let rebind = |login_at| Mode::Bind(request(ID, login_at));
+    assert_eq!(
+        reply(&pc, rebind(NOW), "n1", 200, &replay, NOW + 61),
+        Answered::BindRefused("bind-released")
+    );
+    // a forged unbind of another binding does not wipe that record, nor one undoing a made-up
+    // bind request (written with it) while the record guards the ten minutes after its login
+    assert!(!pc.unbind(&request(OTHER, 1), None, NOW + 62));
+    assert_eq!(pc.store.get(UNBOUND_BINDING).as_deref(), Some(ID));
+    let made_up = request(OTHER, 0);
+    assert!(!pc.unbind(&made_up, Some(&made_up), NOW + 62));
+    assert_eq!(pc.store.get(UNBOUND_BINDING).as_deref(), Some(ID));
+    assert_eq!(
+        reply(&pc, rebind(NOW), "n1", 200, &replay, NOW + 63),
+        Answered::BindRefused("bind-released")
+    );
+    // a later login binds again
+    let later = Signed::new(ID, "n2", NOW + 400, NOW + 390).answer();
+    assert!(matches!(
+        reply(&pc, rebind(NOW + 390), "n2", 200, &later, NOW + 401),
+        Answered::Kept { .. }
+    ));
+
+    // logged out before the service took the bind request, on a PC never bound: the unbind
+    // comes first and makes the key for its record alone
+    let fresh = fresh_pc("undone-before");
+    let login = request(ID, NOW);
+    assert!(!fresh.unbind(&login, Some(&login), NOW + 2));
+    assert!(fresh.store.exists() && fresh.binding().is_none());
+    assert_eq!(fresh.number(UNBOUND_LOGIN_AT), Some(NOW));
+    let late = Signed::new(ID, "n3", NOW + 300, NOW).answer();
+    assert_eq!(
+        reply(&fresh, Mode::Bind(login), "n3", 200, &late, NOW + 301),
+        Answered::BindRefused("bind-released")
+    );
+    assert!(fresh.binding().is_none());
+    // without that bind request in hand nothing makes the key
+    let other = fresh_pc("undone-other");
+    assert!(!other.unbind(&request(ID, NOW), None, NOW + 2));
+    assert!(!other.store.exists());
+    cleanup(&["undone", "undone-before", "undone-other"]);
+}
