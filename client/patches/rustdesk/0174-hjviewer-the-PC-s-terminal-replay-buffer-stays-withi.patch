From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ysfaculty <haejin.cho@yonsei.ac.kr>
Date: Tue, 10 Nov 2026 22:03:01 +0900
Subject: [PATCH 174/194] hjviewer: the PC's terminal replay buffer stays
 within 1 MB for output without newlines

The PC keeps each terminal's recent output for a reconnect, capped at
1 MB. The cap was only applied after a chunk with a newline: a program
that prints without one (cat of a minified file, a progress bar drawn
with \r) made the buffer grow 4 KiB per read with no limit, in the
process the SYSTEM service started, until a newline came. The trim now
runs after every chunk, and when one line without a newline is all that
is left over the cap, its newest half stays, so a reconnect still
replays the latest output.

Backported from rustdesk/rustdesk 76ab280ae9628c7e788cc7779c493a52f9826796 (fix(terminal): trim the replay buffer when output has no newline (#16545))
Upstream's diff unchanged, with its test.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/server/terminal_service.rs | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/server/terminal_service.rs b/src/server/terminal_service.rs
index 8664a99..20e659a 100644
--- a/src/server/terminal_service.rs
+++ b/src/server/terminal_service.rs
@@ -463,7 +463,7 @@ impl OutputBuffer {
                     // Still no newline, append all
                     last_line.extend_from_slice(data);
                     self.total_size += data.len();
-                    return;
+                    start = data.len();
                 }
             }
         }
@@ -494,6 +494,14 @@ impl OutputBuffer {
 
         // Trim old data if buffer is too large
         while self.total_size > MAX_OUTPUT_BUFFER_SIZE || self.lines.len() > MAX_BUFFER_LINES {
+            if self.lines.len() == 1 && self.last_line_incomplete {
+                // Only an oversized line without newline is left: keep its newest half
+                // instead of dropping it, so the copy happens once per half buffer.
+                let line = &mut self.lines[0];
+                line.drain(..line.len().saturating_sub(MAX_OUTPUT_BUFFER_SIZE / 2));
+                self.total_size = line.len();
+                break;
+            }
             if let Some(removed) = self.lines.pop_front() {
                 if removed.len() > self.total_size {
                     log::error!(
@@ -2188,4 +2196,18 @@ mod tests {
         let actual_size: usize = buffer.lines.iter().map(|line| line.len()).sum();
         assert_eq!(buffer.total_size, actual_size);
     }
+
+    #[test]
+    fn output_buffer_trims_output_without_newlines() {
+        let mut buffer = OutputBuffer::new();
+
+        let chunk = vec![b'a'; 4096];
+        for _ in 0..(super::MAX_OUTPUT_BUFFER_SIZE / chunk.len()) {
+            buffer.append(&chunk);
+        }
+        buffer.append(b"TAIL");
+
+        assert!(buffer.get_recent(usize::MAX).len() <= super::MAX_OUTPUT_BUFFER_SIZE);
+        assert_eq!(buffer.get_recent(4), b"TAIL");
+    }
 }
