+/// What Settings → About says of HJViewer: who makes it, and in an account build who "관리자" is
+/// (the policy's `contact`, else the maker; U34) and that the service is a pilot (U31).
+List<String> hjvAboutNoticeLines(HjvTexts t,
+        {required bool accountBuild, String contact = ''}) =>
+    [
+      t.maker,
+      if (accountBuild)
+        t.adminContact(contact.trim().isEmpty ? t.makerName : contact.trim()),
