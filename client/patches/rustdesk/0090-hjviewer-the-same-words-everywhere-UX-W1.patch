+/// U27: a card's second line in the app's language, from the `hjv` of hjv-api's device list:
+/// with its `wake` (hjv-api 1.9 on), the words of `pwless`, `synced` (Unix seconds of the PC's
+/// last sync) and `wake`; else `note`, the server's own text, as it came.
+String hjvPeerNoteText(HjvTexts t, Map hjv,
+    {required String note, required int now}) {
+  if (!hjv.containsKey('wake')) return note;
+  final synced = hjv['synced'];
+  final state = switch (hjv['pwless']) {
+    'active' => t.noteActive,
+    'off' => t.noteOff,
+    'disabled' => t.notePaused,
+    'expired' => synced is int && synced > 0
+        ? t.noteUnsyncedSince(t.ago(now - synced))
+        : t.noteUnsynced,
+    'listed' => t.noteListed,
+    'needs-relogin' => t.noteRelogin,
+    _ => '',
+  };
+  final wake = switch (hjv['wake']) {
+    'ready' => t.noteCanWake,
+    'not_ready' => t.noteCannotWake,
+    _ => '',
+  };
+  return [state, wake].where((s) => s.isNotEmpty).join(' · ');
+}
 
