+/// What Settings → About says of HJViewer: who makes it, and in an account build, whose login
+/// goes to the service, that the service is a pilot.
+List<String> hjvAboutNoticeLines(HjvTexts t, {required bool accountBuild}) =>
+    [t.maker, if (accountBuild) t.pilotNotice];
