+/// D12 (login.dart): under the login dialog's title, that the service is a pilot.
+List<Widget> hjvLoginPilot() => _accountBuild
+    ? [
+        Text(_t.pilotNotice,
+                style: const TextStyle(fontSize: 12, color: Colors.grey))
+            .marginOnly(top: 8)
+      ]
+    : [];
+
+/// D13 (desktop settings, About): who makes HJViewer and, in an account build, the pilot notice.
+List<Widget> hjvAboutNotice() => [
+      for (final line in hjvAboutNoticeLines(_t, accountBuild: _accountBuild))
+        SelectionArea(child: Text(line).marginSymmetric(vertical: 4.0)),
+    ];
+
+/// D14 (mobile settings, About): the same, as a tile.
+List<AbstractSettingsTile> hjvAboutNoticeTiles() {
+  final lines = hjvAboutNoticeLines(_t, accountBuild: _accountBuild);
+  return [
+    SettingsTile(
+      title: Text(lines.first),
+      description: lines.length > 1 ? Text(lines.skip(1).join('\n')) : null,
+      leading: const Icon(Icons.info_outline),
+    ),
+  ];
+}
+
 /// D3 (login.dart): the logout dialog's text.
