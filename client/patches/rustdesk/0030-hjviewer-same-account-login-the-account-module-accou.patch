+        .unwrap();
+        assert_eq!(header, json_header());
+        let body = body.unwrap();
+        let (sent, asked): (Value, Value) = (
+            serde_json::from_str(&body).unwrap(),
+            serde_json::from_str(&login).unwrap(),
+        );
+        for field in ["username", "id", "uuid", "autoLogin", "type", "deviceInfo"] {
+            assert_eq!(sent[field], asked[field]);
+        }
+        // the payload is the vectors': the password, the time, the nonce, the device ID, the key
+        // ID, and the account key with its proof
+        let sealed = sealed_of(&body);
+        assert_eq!(open(&sealed), SEAL_PAYLOAD.as_bytes());
+        assert!(!body.contains("test-password"));
+        // the device key signs it as hjv-api checks it
+        let hjv = &sent["hjv"];
+        assert_eq!(
+            (
+                hjv["v"].as_u64(),
+                hjv["installed"].as_bool(),
+                hjv["ver"].as_str()
+            ),
+            (Some(1), Some(true), Some(crate::VERSION))
