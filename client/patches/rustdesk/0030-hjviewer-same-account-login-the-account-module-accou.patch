+struct Proofs {
+    pc_pk: Vec<u8>,
+    nonce: [u8; 32],
+    cached: Cached,
+}
+
+impl Proofs {
+    fn new() -> Proofs {
+        let pc_pk = pc().0 .0.to_vec();
+        let (kid, l, s) = list(
+            &list_key(1),
+            1,
+            "n",
+            10,
+            NOW,
+            NOW + 86_400,
+            "active",
+            &owner().public_key(),
+        );
+        let cached = Cached {
+            list: verify_list(&pinned(), kid, &l, &s, &local_for(&pc_pk, "n", 1)).unwrap(),
+            received: NOW,
+        };
+        Proofs {
+            pc_pk,
+            nonce: [5; 32],
+            cached,
+        }
+    }
+
+    fn proof(&self, key: &AccountKey, signed_pc_pk: &[u8], kind: u8, id: &str) -> HjvKeyProof {
+        conn_proof(key, PC_ID, signed_pc_pk, &self.nonce, id, kind, 10).unwrap()
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn check(
+        &self,
+        proof: &HjvKeyProof,
+        secured: bool,
+        nonce: &[u8],
+        my_id: &str,
+        kind: u8,
+        cached: Option<&Cached>,
+        now: u64,
+    ) -> Result<KeyEntry, Refusal> {
+        let login = KeyLogin {
+            pc_id: PC_ID,
+            pc_pk: &self.pc_pk,
+            secured,
+            nonce,
+            proof,
+            my_id,
+            kind,
+        };
+        check_key_login(&login, cached, now)
+    }
+}
