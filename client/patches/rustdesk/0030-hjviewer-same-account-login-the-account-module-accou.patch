+#[test]
+fn sync_interval_stays_within_bounds() {
+    for refresh in [0, 1, 3600, u64::MAX] {
+        for jitter in [0, u32::MAX / 2, u32::MAX] {
+            let wait = sync_interval(refresh, jitter);
+            assert!(
+                wait >= Duration::from_secs(MIN_REFRESH)
+                    && wait <= Duration::from_secs(MAX_REFRESH),
+                "{refresh} {jitter} {wait:?}"
+            );
+        }
+    }
+    // the usual 120 s spreads over 96..=144 s
+    assert_eq!(sync_interval(120, 0), Duration::from_secs(96));
+    assert_eq!(sync_interval(120, u32::MAX), Duration::from_secs(144));
+}
