+    // a 1.6.0 controller's login with a proof and a remembered password, at a 1.5.1 PC
+    let pc_pk = pk_bytes(PC_PK);
+    let proof = conn_proof(
+        &owner(),
+        PC_ID,
+        &pc_pk,
+        &CONN_NONCE,
+        CTL_ID,
+        KIND_FILE,
+        CONN_KEY_SERIAL,
+    )
+    .unwrap();
+    let mut lr = LoginRequest {
+        username: PC_ID.into(),
+        password: vec![7; 32].into(),
+        my_id: CTL_ID.into(),
+        my_name: "Hong".into(),
+        session_id: 42,
+        version: "1.6.0".into(),
+        hjv_key_proof: MessageField::some(proof),
+        ..Default::default()
+    };
+    lr.set_file_transfer(FileTransfer {
+        dir: "C:\\".into(),
+        ..Default::default()
+    });
+    let mut msg = Message::new();
+    msg.set_login_request(lr);
+    let parsed = old_message
+        .parse_from_bytes(&msg.write_to_bytes().unwrap())
+        .unwrap();
+    let parsed = old_message
+        .field_by_name("login_request")
+        .unwrap()
+        .get_singular_field_or_default(&*parsed)
+        .to_message()
+        .unwrap();
+    let field = |name: &str| old_lr.field_by_name(name).unwrap();
+    assert_eq!(
+        field("username")
+            .get_singular_field_or_default(&*parsed)
+            .to_str(),
+        Some(PC_ID)
+    );
+    assert_eq!(
+        field("my_id")
+            .get_singular_field_or_default(&*parsed)
+            .to_str(),
+        Some(CTL_ID)
+    );
+    assert_eq!(
+        field("password")
+            .get_singular_field_or_default(&*parsed)
+            .to_bytes(),
+        Some(&[7u8; 32][..])
+    );
+    assert_eq!(
+        field("session_id")
+            .get_singular_field_or_default(&*parsed)
+            .to_u64(),
+        Some(42)
+    );
+    assert!(field("file_transfer").has_field(&*parsed));
+    // the proof stays an unknown field it does not act on
+    assert!(parsed
+        .special_fields_dyn()
+        .unknown_fields()
+        .get(1001)
+        .is_some());
+
+    // a 1.6.0 PC's Hash with its nonce, at a 1.5.1 controller
+    let hash = Hash {
+        salt: "saltsalt".into(),
+        challenge: "abc234".into(),
+        hjv_nonce: vec![9; 32].into(),
+        ..Default::default()
+    };
+    let parsed = old_hash
+        .parse_from_bytes(&hash.write_to_bytes().unwrap())
+        .unwrap();
+    let field = |name: &str| old_hash.field_by_name(name).unwrap();
+    assert_eq!(
+        field("salt")
+            .get_singular_field_or_default(&*parsed)
+            .to_str(),
+        Some("saltsalt")
+    );
+    assert_eq!(
+        field("challenge")
+            .get_singular_field_or_default(&*parsed)
+            .to_str(),
