+/// message.proto as 1.5.1 had it: without HjvKeyProof and the fields from 1000 up.
+fn proto_1_5_1() -> FileDescriptor {
+    let mut file = base::message_proto::file_descriptor().proto().clone();
+    file.message_type.retain(|m| m.name() != "HjvKeyProof");
+    for m in file.message_type.iter_mut() {
+        m.field.retain(|f| f.number() < 1000);
+    }
+    FileDescriptor::new_dynamic(file, &[]).unwrap()
+}
+
+fn hash_1_5_1(salt: &str, challenge: &str) -> Vec<u8> {
+    let hash = proto_1_5_1()
+        .message_by_package_relative_name("Hash")
+        .unwrap();
+    let mut m = hash.new_instance();
+    for (field, value) in [("salt", salt), ("challenge", challenge)] {
+        hash.field_by_name(field)
+            .unwrap()
+            .set_singular_field(&mut *m, ReflectValueBox::String(value.to_owned()));
+    }
+    m.write_to_bytes_dyn().unwrap()
+}
