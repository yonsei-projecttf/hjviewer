+#[test]
+fn proofs() {
+    let _ = hbb_common::sodiumoxide::init();
+    let p = Proofs::new();
+    let at = NOW + 60;
+    let c = Some(&p.cached);
+    let ok = p.proof(&owner(), &p.pc_pk, KIND_REMOTE, CTL_ID);
+    assert_eq!(
+        p.check(&ok, true, &p.nonce, CTL_ID, KIND_REMOTE, c, at)
+            .unwrap()
+            .id,
+        CTL_ID
+    );
+    // not secured, no nonce (a 1.5.x PC), another nonce (a replay)
+    assert_eq!(
+        p.check(&ok, false, &p.nonce, CTL_ID, KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::NotSecured
+    );
+    assert_eq!(
+        p.check(&ok, true, &[], CTL_ID, KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::NoNonce
+    );
+    assert_eq!(
+        p.check(&ok, true, &[6; 32], CTL_ID, KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::BadProofSignature
+    );
+    // signed for an impostor's key (hbbs's key stolen, the session relayed to the real PC)
+    let impostor = sign::keypair_from_seed(&sign::Seed([8; 32])).0;
+    let relayed = p.proof(&owner(), &impostor.0, KIND_REMOTE, CTL_ID);
+    assert_eq!(
+        p.check(&relayed, true, &p.nonce, CTL_ID, KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::BadProofSignature
+    );
+    // a file transfer's proof used for the remote screen
+    let as_file = p.proof(&owner(), &p.pc_pk, KIND_FILE, CTL_ID);
+    assert_eq!(
+        p.check(&as_file, true, &p.nonce, CTL_ID, KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::BadProofSignature
+    );
+    // a listed key under another device's ID, signed for that ID
+    let borrowed = p.proof(&owner(), &p.pc_pk, KIND_REMOTE, "111111111");
+    assert_eq!(
+        p.check(&borrowed, true, &p.nonce, "111111111", KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::IdMismatch
+    );
+    // port forwarding never by proof; the terminal only where the list's kinds have it
+    let forward = p.proof(&owner(), &p.pc_pk, KIND_PORT_FORWARD, CTL_ID);
+    assert_eq!(
+        p.check(&forward, true, &p.nonce, CTL_ID, KIND_PORT_FORWARD, c, at)
+            .unwrap_err(),
+        Refusal::KindNotByProof
+    );
+    let terminal = p.proof(&owner(), &p.pc_pk, KIND_TERMINAL, CTL_ID);
+    assert_eq!(
+        p.check(&terminal, true, &p.nonce, CTL_ID, KIND_TERMINAL, c, at)
+            .unwrap_err(),
+        Refusal::KindNotAllowed
+    );
+    // a key the list does not have
+    let stranger = AccountKey::from_seed(&[4; 32]).unwrap();
+    let unknown = p.proof(&stranger, &p.pc_pk, KIND_REMOTE, CTL_ID);
+    assert_eq!(
+        p.check(&unknown, true, &p.nonce, CTL_ID, KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::UnknownKey
+    );
+    // a proof under C's prototype string (hjv-login-v1, which api/ uses for logins) does not count
+    let mut old = b"hjv-login-v1\0".to_vec();
+    let transcript = conn_transcript(
+        PC_ID,
+        &p.pc_pk,
+        &p.nonce,
+        CTL_ID,
+        KIND_REMOTE,
+        &owner().public_key(),
+    )
+    .unwrap();
+    old.extend_from_slice(&transcript[CONN_CONTEXT.len() + 1..]);
+    let old_proof = HjvKeyProof {
+        signature: owner().sign(&old).to_vec().into(),
+        ..ok.clone()
+    };
+    assert_eq!(
+        p.check(&old_proof, true, &p.nonce, CTL_ID, KIND_REMOTE, c, at)
+            .unwrap_err(),
+        Refusal::BadProofSignature
+    );
+    // an expired list or none refuses even a good proof, which then asks for a sync
+    let expired = p.check(&ok, true, &p.nonce, CTL_ID, KIND_REMOTE, c, NOW + 86_400);
+    assert_eq!(expired.clone().unwrap_err(), Refusal::Expired);
+    assert!(should_refresh_for(&expired, c, NOW + 86_400, 10));
+    let none = p.check(&ok, true, &p.nonce, CTL_ID, KIND_REMOTE, None, at);
+    assert_eq!(none.clone().unwrap_err(), Refusal::NoList);
+    assert!(should_refresh_for(&none, None, at, 0));
+    // an unknown key asks for a sync only when it is newer than the list
+    let unknown = p.check(&unknown, true, &p.nonce, CTL_ID, KIND_REMOTE, c, at);
+    assert!(should_refresh_for(&unknown, c, at, 11));
+    assert!(!should_refresh_for(&unknown, c, at, 10));
+    // an accepted proof does not, unless the list is strict
+    let accepted = p.check(&ok, true, &p.nonce, CTL_ID, KIND_REMOTE, c, at);
+    assert!(!should_refresh_for(&accepted, c, at, 11));
+    let mut strict = p.cached.clone();
+    strict.list.strict = true;
+    assert!(should_refresh_for(&accepted, Some(&strict), at, 0));
+}
+
+#[test]
+fn a_bad_signature_never_asks_for_a_sync() {
+    let _ = hbb_common::sodiumoxide::init();
+    let p = Proofs::new();
+    // a key nobody listed, signing for another PC: no list, an expired list, a strict list, a
+    // serial far ahead would each ask for a sync for a good signature
+    let forger = AccountKey::from_seed(&[66; 32]).unwrap();
+    let other_pc = sign::keypair_from_seed(&sign::Seed([7; 32])).0;
+    let forged = p.proof(&forger, &other_pc.0, KIND_REMOTE, CTL_ID);
+    let mut strict = p.cached.clone();
+    strict.list.strict = true;
+    for (cached, now) in [
+        (None, NOW),
+        (Some(&p.cached), NOW + 86_400),
+        (Some(&strict), NOW + 60),
+    ] {
+        let outcome = p.check(&forged, true, &p.nonce, CTL_ID, KIND_REMOTE, cached, now);
+        assert_eq!(outcome.clone().unwrap_err(), Refusal::BadProofSignature);
+        assert!(!should_refresh_for(&outcome, cached, now, u64::MAX));
+    }
+    // nor a proof on an unsecured channel, without a nonce, or with garbage for a key
+    let ok = p.proof(&owner(), &p.pc_pk, KIND_REMOTE, CTL_ID);
+    let garbage = HjvKeyProof {
+        pk: vec![1; 31].into(),
+        ..ok.clone()
+    };
+    for outcome in [
+        p.check(&ok, false, &p.nonce, CTL_ID, KIND_REMOTE, None, NOW),
+        p.check(&ok, true, &[], CTL_ID, KIND_REMOTE, None, NOW),
+        p.check(&garbage, true, &p.nonce, CTL_ID, KIND_REMOTE, None, NOW),
+    ] {
+        assert!(!should_refresh_for(&outcome, None, NOW, u64::MAX));
+    }
+}
