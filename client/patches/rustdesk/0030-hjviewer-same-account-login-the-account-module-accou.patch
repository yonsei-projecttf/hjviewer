+/// `list` of a sync answer: the list bytes and their signature, both standard base64.
+#[derive(Deserialize, Debug, Clone)]
+pub(crate) struct SignedList {
+    pub kid: u32,
+    pub l: String,
+    pub s: String,
+}
+
+/// What the PC checks a sync answer's list against.
+pub(crate) struct Local<'a> {
+    pub pc_id: &'a str,
+    pub pc_pk: &'a [u8],
+    /// the binding ID this request carried
+    pub binding: &'a str,
+    /// this request's `n`
+    pub request_nonce: &'a str,
+    pub kid_floor: u32,
+}
+
+/// A list the PC accepted, with the time it arrived by the PC's own clock.
+#[derive(Debug, Clone)]
+pub(crate) struct Cached {
+    pub list: TrustList,
+    pub received: u64,
+}
+
+/// A proof as the PC received it, with what the PC checks it against.
+pub(crate) struct KeyLogin<'a> {
+    /// this PC's ID and public key (Config::get_key_pair().1)
+    pub pc_id: &'a str,
+    pub pc_pk: &'a [u8],
+    pub secured: bool,
+    /// the nonce this PC put in its Hash
+    pub nonce: &'a [u8],
+    pub proof: &'a HjvKeyProof,
+    /// LoginRequest.my_id
+    pub my_id: &'a str,
+    /// kind_of_union of the LoginRequest
+    pub kind: u8,
+}
+
+/// A proof the PC accepted: what its connection manager shows.
+pub(crate) struct Accepted {
+    pub name: String,
+    pub owner: String,
+}
+
+/// Checks a sync answer's list: a pinned key number not below the floor, the signature over the
+/// bytes as received (and only then their contents), this PC, the binding this request carried,
+/// this very request (`req`), a lifetime of at most MAX_LIST_TTL, and a known state. The caller
+/// stores the list with its receipt time and raises the floor to `max(floor, kid)`.
+pub(crate) fn verify_list(
+    pinned: &[(u32, [u8; 32])],
+    kid: u32,
+    list_b64: &str,
+    sig_b64: &str,
+    local: &Local,
+) -> Result<TrustList, Refusal> {
+    let bytes = STANDARD
+        .decode(list_b64)
+        .map_err(|_| Refusal::BadEncoding)?;
+    let sig = STANDARD.decode(sig_b64).map_err(|_| Refusal::BadEncoding)?;
+    let pk = pinned
+        .iter()
+        .find(|(k, _)| *k == kid)
+        .map(|(_, pk)| sign::PublicKey(*pk))
+        .ok_or(Refusal::UnknownKid)?;
+    if kid < local.kid_floor {
+        return Err(Refusal::RetiredKid);
+    }
+    let sig = sign::Signature::from_bytes(&sig).map_err(|_| Refusal::BadEncoding)?;
+    if !sign::verify_detached(&sig, &trust_message(&bytes), &pk) {
+        return Err(Refusal::BadListSignature);
+    }
+    let list: TrustList = serde_json::from_slice(&bytes).map_err(|_| Refusal::BadEncoding)?;
+    if list.v != 1 || list.typ != "hjv-trust" || list.kid != kid {
+        return Err(Refusal::BadEncoding);
+    }
+    let pc_pk = STANDARD
+        .decode(&list.pc_pk)
+        .map_err(|_| Refusal::BadEncoding)?;
+    if list.pc_id != local.pc_id || pc_pk != local.pc_pk {
+        return Err(Refusal::WrongPc);
+    }
+    if list.binding != local.binding {
+        return Err(Refusal::WrongBinding);
+    }
+    if list.req != local.request_nonce {
+        return Err(Refusal::NotThisRequest);
+    }
+    if list.exp <= list.iat || list.exp - list.iat > MAX_LIST_TTL {
+        return Err(Refusal::BadLifetime);
+    }
+    if !matches!(list.state.as_str(), "active" | "revoked" | "disabled") {
+        return Err(Refusal::BadEncoding);
+    }
+    Ok(list)
+}
+
+/// A cached list lives for its lifetime from its receipt by the PC's clock, not from its own
+/// dates, so the server's clock does not matter; a PC clock set back by more than BACKWARD_SKEW
+/// counts it as expired.
+pub(crate) fn valid_at(cached: &Cached, now: u64) -> bool {
+    let life = cached.list.exp.saturating_sub(cached.list.iat);
+    now.saturating_add(BACKWARD_SKEW) >= cached.received
+        && now < cached.received.saturating_add(life)
+}
+
+/// The PC's check of a proof: the channel and the nonce, then the signature over the transcript
+/// this PC rebuilds from its own ID, key and nonce, and only then the cached list (valid, active,
+/// the key, its kinds, the controller's ID). The binding, `Off` and the temporary-password-only
+/// setting are the caller's, before this.
+pub(crate) fn check_key_login(
+    login: &KeyLogin,
+    cached: Option<&Cached>,
+    now: u64,
+) -> Result<KeyEntry, Refusal> {
+    if !login.secured {
+        return Err(Refusal::NotSecured);
+    }
+    if login.nonce.len() != 32 {
+        return Err(Refusal::NoNonce);
+    }
+    if login.kind > KIND_TERMINAL {
+        return Err(Refusal::KindNotByProof);
+    }
+    let proof = login.proof;
+    if proof.version != 1 {
+        return Err(Refusal::BadEncoding);
+    }
+    let pk = sign::PublicKey::from_slice(&proof.pk).ok_or(Refusal::BadEncoding)?;
+    let sig = sign::Signature::from_bytes(&proof.signature).map_err(|_| Refusal::BadEncoding)?;
+    let transcript = conn_transcript(
+        login.pc_id,
+        login.pc_pk,
+        login.nonce,
+        login.my_id,
+        login.kind,
+        &proof.pk,
+    )
+    .ok_or(Refusal::BadEncoding)?;
+    if !sign::verify_detached(&sig, &transcript, &pk) {
+        return Err(Refusal::BadProofSignature);
+    }
+    let cached = cached.ok_or(Refusal::NoList)?;
+    if !valid_at(cached, now) {
+        return Err(Refusal::Expired);
+    }
+    if cached.list.state != "active" {
+        return Err(Refusal::NotActive);
+    }
+    let entry = cached
+        .list
+        .keys
+        .iter()
+        .find(|k| STANDARD.decode(&k.pk).ok().as_deref() == Some(&proof.pk[..]))
+        .ok_or(Refusal::UnknownKey)?;
+    if !entry.kinds.iter().any(|k| k == kind_name(login.kind)) {
+        return Err(Refusal::KindNotAllowed);
+    }
+    if entry.id != login.my_id {
+        return Err(Refusal::IdMismatch);
+    }
+    Ok(entry.clone())
+}
+
+/// Whether one immediate sync could change what `check_key_login` said: no list or an expired
+/// one, a key newer than the list (`key_serial`, the proof's hint), or a list that wants a sync
+/// for every proof (`strict`). A proof refused before the list was looked at never asks, so a
+/// replayed or broken proof, or one signed for another PC, cannot make the PC call hjv-api. A
+/// sender's own new key can; the caller runs one sync at a time and none within 10 s of the last.
+pub(crate) fn should_refresh_for(
+    outcome: &Result<KeyEntry, Refusal>,
+    cached: Option<&Cached>,
+    now: u64,
+    key_serial: u64,
+) -> bool {
+    if matches!(outcome, Err(r) if r.before_list()) {
+        return false;
+    }
+    match cached {
+        None => true,
+        Some(c) => {
+            !valid_at(c, now)
+                || c.list.strict
+                || (matches!(outcome, Err(Refusal::UnknownKey)) && key_serial > c.list.serial)
+        }
+    }
+}
+
+/// One line of the sync report's `used`: the proofs this PC accepted from one account key on one
+/// UTC day, `last` the latest of them by the PC's clock and `n` that day's running count (not the
+/// increase since the last report), so the server can merge reports by taking the larger values.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq)]
+pub(crate) struct UseEntry {
+    pub pk: String,
+    pub day: String,
+    pub last: u64,
+    pub n: u64,
+}
+
+/// The UTC day of a Unix time, `YYYY-MM-DD`.
+pub(crate) fn utc_day(t: u64) -> String {
+    i64::try_from(t)
+        .ok()
+        .and_then(|t| chrono::DateTime::<chrono::Utc>::from_timestamp(t, 0))
+        .map(|d| d.format("%Y-%m-%d").to_string())
+        .unwrap_or_default()
+}
+
+/// Counts a proof of `pk` (standard base64) accepted at `at`.
+pub(crate) fn count_use(entries: &mut Vec<UseEntry>, pk: &str, at: u64) {
+    let day = utc_day(at);
+    match entries.iter_mut().find(|e| e.pk == pk && e.day == day) {
+        Some(e) => {
+            e.last = e.last.max(at);
+            e.n += 1;
+        }
+        None => entries.push(UseEntry {
+            pk: pk.to_owned(),
+            day,
+            last: at,
+            n: 1,
+        }),
+    }
+}
+
+/// What a sync reports and the PC keeps: today's and yesterday's lines (UTC), so that a day's
+/// count reaches the server in full after midnight.
+pub(crate) fn used_report(entries: &[UseEntry], now: u64) -> Vec<UseEntry> {
+    let days = [utc_day(now), utc_day(now.saturating_sub(86_400))];
+    entries
+        .iter()
+        .filter(|e| days.contains(&e.day))
+        .cloned()
+        .collect()
+}
+
+/// Phones never take same-account logins: the PC side's names, doing nothing.
+#[cfg(any(target_os = "android", target_os = "ios"))]
