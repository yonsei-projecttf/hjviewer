+#[test]
+fn without_one_build_variable_the_hash_is_1_5_1s() {
+    let _ = hbb_common::sodiumoxide::init();
+    let (seal, trust) = (Some(SEAL_PK), Some(HJV_TRUST_PUBKEYS));
+    for (pinned, seal, trust) in [
+        (false, seal, trust),
+        (true, None, trust),
+        (true, seal, None),
+        (true, Some(""), trust),
+        (true, seal, Some("")),
+    ] {
+        let capable = account_build(pinned, seal, trust);
+        assert!(!capable);
+        let hash = Hash {
+            salt: "saltsalt".into(),
+            challenge: "abc234".into(),
+            hjv_nonce: nonce_if(capable),
+            ..Default::default()
+        };
+        assert!(hash.hjv_nonce.is_empty());
+        assert_eq!(
+            hash.write_to_bytes().unwrap(),
+            hash_1_5_1("saltsalt", "abc234")
+        );
+    }
+    // and that is what 1.5.1 itself sends, not only this build's Hash without its new field
+    assert_eq!(
+        hex::encode(hash_1_5_1("saltsalt", "abc234")),
+        "0a0873616c7473616c741206616263323334"
+    );
+    // with all three, a capable PC's nonce is 32 new bytes
+    assert!(account_build(true, seal, trust));
+    let (a, b) = (nonce_if(true), nonce_if(true));
+    assert_eq!((a.len(), b.len()), (32, 32));
+    assert_ne!(a, b);
+}
