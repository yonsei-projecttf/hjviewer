+    #[test]
+    fn the_device_list_changes_only_with_a_full_list() {
+        let fake = Fake::logged_in();
+        let user = json!({ "name": ACCOUNT_ID, "display_name": "홍길동", "status": 1 });
+        fake.set_local("user_info", &user.to_string());
+        let page = |current: u64| {
+            url(&format!(
+                "/api/peers?current={current}&pageSize=2&accessible=&status=1"
+            ))
+        };
+        let pc = |id: &str| {
+            json!({
+                "id": id, "user_name": ACCOUNT_ID, "info": { "device_name": "lab", "os": "windows" },
+                "status": 1, "note": "비밀번호 없이 연결",
+                "hjv": { "pk": PC_PK, "pwless": "active", "kinds": ["remote", "file", "camera"], "wol": "unknown" },
+            })
+        };
+        let first = json!({ "total": 3, "data": [pc("111111111"), pc("222222222")] });
+        observe(&fake, &page(1), &answer(200, &first));
+        assert_eq!(fake.local(MY_DEVICES), "");
+        // an entry without `hjv` counts towards the total but is no PC of the list
+        let last = json!({ "total": 3, "data": [{ "id": "333333333", "status": 1 }] });
+        observe(&fake, &page(2), &answer(200, &last));
+        let full = format!(
+            r#"{{"acct":"{ACCOUNT_ID}","at":{T},"pcs":{{"111111111":{{"pk":"{PC_PK}","pwless":"active","kinds":["remote","file","camera"]}},"222222222":{{"pk":"{PC_PK}","pwless":"active","kinds":["remote","file","camera"]}}}}}}"#
+        );
+        assert_eq!(fake.local(MY_DEVICES), full);
+        assert_eq!(
+            my_list(&fake).pcs["111111111"],
+            MyPc {
+                pk: PC_PK.to_owned(),
+                pwless: "active".to_owned(),
+                kinds: vec!["remote".to_owned(), "file".to_owned(), "camera".to_owned()],
+            }
+        );
+
+        // failures, a clock answer, no answer at all, and a fetch that broke off keep it
+        fake.now.set(T + 60);
+        for status in [500, 502, 401, 400, 409] {
+            let failed = json!({ "error": "x", "hjv": "clock", "server_time": T });
+            observe(&fake, &page(1), &answer(status, &failed));
+        }
+        observe(&fake, &page(1), "reqwest::Error { kind: Request }");
+        let other = json!({ "total": 3, "data": [pc("444444444"), pc("555555555")] });
+        observe(&fake, &page(1), &answer(200, &other));
+        observe(&fake, &page(2), &answer(500, &json!({ "error": "x" })));
