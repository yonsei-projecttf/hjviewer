+#[test]
+fn sealed_login_key() {
+    let _ = hbb_common::sodiumoxide::init();
+    assert_eq!(
+        hex::encode(ckey_message(CKEY_N, CKEY_ID, ACCOUNT_PK)),
+        CKEY_SIGNED_HEX
+    );
+    let account = AccountKey::from_seed(&ACCOUNT_SEED).unwrap();
+    let (ck, cp) = ckey_proof(&account, CKEY_N, CKEY_ID);
+    assert_eq!((ck.as_str(), cp.as_str()), (ACCOUNT_PK, CKEY_CP));
+    let payload: serde_json::Value = serde_json::from_str(SEAL_PAYLOAD).unwrap();
+    assert_eq!(payload["n"], CKEY_N);
+    assert_eq!(payload["id"], CKEY_ID);
+    assert_eq!(payload["kid"], SEAL_KID);
+    assert_eq!(
+        (payload["ck"].as_str(), payload["cp"].as_str()),
+        (Some(ACCOUNT_PK), Some(CKEY_CP))
+    );
+}
