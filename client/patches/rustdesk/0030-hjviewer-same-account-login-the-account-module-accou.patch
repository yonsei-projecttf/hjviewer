+//! The controlled PC: the service's sync with hjv-api, the binding it keeps (HKLM on Windows, a
+//! 0600 file in the service's config folder elsewhere), and its check of a proof against the
+//! cached trust list. Desktop only; phones get the same names from mod.rs, doing nothing.
+//!
+//! The names and types the hooks call; the sync and the binding come with the PC's patch.
+
+use super::{enabled, Accepted, Refusal};
+use base::message_proto::HjvKeyProof;
+
+/// Whether this process sends a nonce and takes proofs: an account build's service process
+/// (`--server`) of an installed HJViewer.
+pub(crate) fn pc_capable() -> bool {
+    enabled() && crate::is_server() && crate::platform::is_installed()
+}
+
+/// Starts the sync task once, in the service process next to hbbs_http::sync::start(); nothing
+/// unless `pc_capable()`.
+pub(crate) fn start_pc_sync() {}
+
+/// A proof this PC received (`secured`: the session's channel; `nonce`: the PC's own Hash nonce):
+/// the binding and `Off`, then `check_key_login` against the cached list with at most one
+/// immediate sync.
+pub(crate) async fn key_login(
+    _secured: bool,
+    _nonce: &[u8],
+    _proof: &HjvKeyProof,
+    _my_id: &str,
+    _kind: u8,
+) -> Result<Accepted, Refusal> {
+    Err(Refusal::NotBound)
+}
+
+/// One sync now, for a proof the cached list cannot decide: one at a time (later callers wait for
+/// its result), none within 10 s of the last one. Whether a list came.
+pub(crate) async fn refresh_now() -> bool {
+    false
+}
+
+/// `--uninstall`: forgets this PC's binding, so that a reinstalled PC takes no proof until someone
+/// logs in on it again.
+pub(crate) fn forget_pc_binding() {}
