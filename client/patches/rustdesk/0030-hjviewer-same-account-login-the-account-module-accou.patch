new file mode 100644
index 0000000..f4201a1
--- /dev/null
+++ b/src/hjviewer_account/ctl.rs
@@ -0,0 +1,46 @@
+//! The controller: the PC key each session was checked against, whether a login carries a proof,
+//! and the proof itself.
+//!
+//! The names and types the hooks call; the conditions and the signing come with the controller's
+//! patch.
+
+use base::message_proto::HjvKeyProof;
+
+/// What the controller knows when the PC's Hash arrives.
+pub(crate) struct LoginContext<'a> {
+    pub session_id: u64,
+    /// LoginRequest.username: the PC's ID
+    pub pc_id: &'a str,
+    /// LoginRequest.my_id: this device's ID
+    pub ctl_id: &'a str,
+    /// kind_of_conn_type of the session
+    pub kind: u8,
+    /// an `id@server` connection
+    pub other_server: bool,
+    /// Hash.hjv_nonce
+    pub nonce: &'a [u8],
+    pub secured: bool,
+}
+
+pub(crate) enum ProofDecision {
+    /// the login goes out as it would without the feature
+    No,
+    /// the PC's key differs from the one the account's list bound to it: warn, send nothing, close
+    KeyChanged,
+    /// send this proof, with the remembered password if there is one
+    Send(HjvKeyProof),
+}
+
+/// Client::start: the PC key this session's channel was checked against, kept only for a secured
+/// channel.
+pub(crate) fn note_peer_key(_session_id: u64, _secured: bool, _pk: Option<&[u8]>) {}
+
+/// handle_hash: whether this login carries a proof, and the proof.
+pub(crate) fn key_proof(_login: &LoginContext) -> ProofDecision {
+    ProofDecision::No
+}
+
+/// handle_login_error: whether this session's last login carried a proof (forgetting it).
+pub(crate) fn take_proof_sent(_session_id: u64) -> bool {
+    false
+}
diff --git a/src/hjviewer_account/keystore.rs b/src/hjviewer_account/keystore.rs
new file mode 100644
index 0000000..bf4e7a4
--- /dev/null
+++ b/src/hjviewer_account/keystore.rs
@@ -0,0 +1,285 @@
+//! Where the account key lives, one per device user: on the iPhone the Keychain (this device
+//! only, while unlocked; a backup restored on a phone brings no key back), on Windows a file
+//! wrapped with DPAPI for this Windows user in %LOCALAPPDATA%\HJViewer-account (not roaming, and
+//! outside %LOCALAPPDATA%\hjviewer, which the portable packer clears for every new version),
+//! elsewhere the user's LocalConfig, `hjv-ctl-key` (Android keeps the app's files out of cloud
+//! backups and device transfers).
+
+use super::AccountKey;
+use hbb_common::ResultType;
+
+/// The store cannot be read right now (the iPhone's Keychain while the phone is locked): send no
+/// account request, and do not log out.
+pub(crate) struct Unavailable;
+
+/// Windows: the key's folder in %LOCALAPPDATA% and its file. NTFS ignores case, and the packer
+/// unpacks into the lower-cased stem of the executable it carries and removes that folder whenever
+/// another version runs, so the folder must never be named like it.
+#[cfg(any(target_os = "windows", test))]
+const KEY_DIR: &str = "HJViewer-account";
+#[cfg(any(target_os = "windows", test))]
+const KEY_FILE: &str = "account-key.bin";
+
+/// This device user's account key; Ok(None) when there is none (logged out, or a restored iPhone,
+/// whose Keychain keeps no key from the backup).
+pub(crate) fn load() -> Result<Option<AccountKey>, Unavailable> {
+    store_impl::load()
+}
+
+pub(crate) fn store(key: &AccountKey) -> ResultType<()> {
+    store_impl::store(key)
+}
+
+pub(crate) fn forget() {
+    store_impl::forget()
+}
+
+#[cfg(target_os = "ios")]
+mod store_impl {
+    use super::{AccountKey, Unavailable};
+    use hbb_common::{log, sodiumoxide::utils::memzero, ResultType};
+    use security_framework::{
+        access_control::{ProtectionMode, SecAccessControl},
+        passwords::{
+            delete_generic_password_options, generic_password, set_generic_password_options,
+            PasswordOptions,
+        },
+    };
+
+    const SERVICE: &str = "HJViewer";
+    const ACCOUNT: &str = "hjv-ctl-key";
+    /// errSecItemNotFound
+    const NOT_FOUND: i32 = -25300;
+
+    fn item() -> PasswordOptions {
+        PasswordOptions::new_generic_password(SERVICE, ACCOUNT)
+    }
+
+    pub(super) fn load() -> Result<Option<AccountKey>, Unavailable> {
+        match generic_password(item()) {
+            Ok(mut seed) => {
+                let key = AccountKey::from_seed(&seed);
+                memzero(&mut seed);
+                Ok(key)
+            }
+            Err(e) if e.code() == NOT_FOUND => Ok(None),
+            // errSecInteractionNotAllowed (-25308) while the phone is locked
+            Err(e) => {
+                hbb_common::throttled_log!(
+                    std::time::Duration::from_secs(600),
+                    warn,
+                    "account key: the Keychain answered {}",
+                    e.code()
+                );
+                Err(Unavailable)
+            }
+        }
+    }
+
+    pub(super) fn store(key: &AccountKey) -> ResultType<()> {
+        // a new item rather than an update, which would keep an old item's protection
+        forget();
+        let mut item = item();
+        item.set_access_control(SecAccessControl::create_with_protection(
+            Some(ProtectionMode::AccessibleWhenUnlockedThisDeviceOnly),
+            0,
+        )?);
+        set_generic_password_options(key.seed(), item)?;
+        Ok(())
+    }
+
+    pub(super) fn forget() {
+        match delete_generic_password_options(item()) {
+            Err(e) if e.code() != NOT_FOUND => {
+                log::warn!("account key: the Keychain did not delete it ({})", e.code())
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+mod store_impl {
+    use super::{AccountKey, Unavailable, KEY_DIR, KEY_FILE};
+    use hbb_common::{
+        anyhow::anyhow, bail, directories_next::BaseDirs, log, sodiumoxide::utils::memzero,
+        ResultType,
+    };
+    use std::{io::ErrorKind, path::PathBuf};
+    use windows::{
+        core::PCWSTR,
+        Win32::{
+            Foundation::{LocalFree, HLOCAL},
+            Security::Cryptography::{
+                CryptProtectData, CryptUnprotectData, CRYPTPROTECT_UI_FORBIDDEN, CRYPT_INTEGER_BLOB,
+            },
+        },
+    };
+
+    /// %LOCALAPPDATA% as the Known Folder, which the packer unpacks into as well (libs/portable,
+    /// `dirs::data_local_dir`), so the two folders are siblings whatever the environment says.
+    fn path() -> Option<PathBuf> {
+        Some(
+            BaseDirs::new()?
+                .data_local_dir()
+                .join(KEY_DIR)
+                .join(KEY_FILE),
+        )
+    }
+
+    pub(super) fn load() -> Result<Option<AccountKey>, Unavailable> {
+        let Some(path) = path() else {
+            return Ok(None);
+        };
+        match std::fs::read(path) {
+            // another Windows user's file, or a damaged one, holds no key of this user
+            Ok(wrapped) => Ok(unwrap_key(&wrapped)),
+            Err(e) if e.kind() == ErrorKind::NotFound => Ok(None),
+            Err(e) => {
+                hbb_common::throttled_log!(
+                    std::time::Duration::from_secs(600),
+                    warn,
+                    "account key: {e}"
+                );
+                Err(Unavailable)
+            }
+        }
+    }
+
+    pub(super) fn store(key: &AccountKey) -> ResultType<()> {
+        let path = path().ok_or_else(|| anyhow!("no local application data folder"))?;
+        let wrapped = wrap_key(key.seed())?;
+        if let Some(dir) = path.parent() {
+            std::fs::create_dir_all(dir)?;
+        }
+        let new = path.with_extension("new");
+        std::fs::write(&new, wrapped)?;
+        std::fs::rename(&new, &path)?;
+        Ok(())
+    }
+
+    pub(super) fn forget() {
+        let Some(path) = path() else {
+            return;
+        };
+        if let Err(e) = std::fs::remove_file(path) {
+            if e.kind() != ErrorKind::NotFound {
+                log::warn!("account key: not deleted ({e})");
+            }
+        }
+    }
+
+    /// DPAPI for the Windows user this process runs as.
+    fn wrap_key(seed: &[u8]) -> ResultType<Vec<u8>> {
+        let input = CRYPT_INTEGER_BLOB {
+            cbData: u32::try_from(seed.len())?,
+            pbData: seed.as_ptr() as *mut u8,
+        };
+        let mut out = CRYPT_INTEGER_BLOB::default();
+        unsafe {
+            CryptProtectData(
+                &input,
+                PCWSTR::null(),
+                None,
+                None,
+                None,
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut out,
+            )?;
+        }
+        if out.pbData.is_null() {
+            bail!("DPAPI returned no data");
+        }
+        let wrapped =
+            unsafe { std::slice::from_raw_parts(out.pbData, out.cbData as usize) }.to_vec();
+        unsafe { LocalFree(Some(HLOCAL(out.pbData as _))) };
+        Ok(wrapped)
+    }
+
+    fn unwrap_key(wrapped: &[u8]) -> Option<AccountKey> {
+        let input = CRYPT_INTEGER_BLOB {
+            cbData: u32::try_from(wrapped.len()).ok()?,
+            pbData: wrapped.as_ptr() as *mut u8,
+        };
+        let mut out = CRYPT_INTEGER_BLOB::default();
+        unsafe {
+            CryptUnprotectData(
+                &input,
+                None,
+                None,
+                None,
+                None,
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut out,
+            )
+        }
+        .ok()?;
+        if out.pbData.is_null() {
+            return None;
+        }
+        let seed = unsafe { std::slice::from_raw_parts_mut(out.pbData, out.cbData as usize) };
+        let key = AccountKey::from_seed(seed);
+        memzero(seed);
+        unsafe { LocalFree(Some(HLOCAL(out.pbData as _))) };
+        key
+    }
+}
+
+#[cfg(not(any(target_os = "ios", target_os = "windows")))]
+mod store_impl {
+    use super::{AccountKey, Unavailable};
+    use hbb_common::{
+        base64::{engine::general_purpose::STANDARD, Engine as _},
+        config::LocalConfig,
+        sodiumoxide::utils::memzero,
+        ResultType,
+    };
+
+    const OPTION: &str = "hjv-ctl-key";
+
+    pub(super) fn load() -> Result<Option<AccountKey>, Unavailable> {
+        let value = LocalConfig::get_option(OPTION);
+        if value.is_empty() {
+            return Ok(None);
+        }
+        Ok(STANDARD.decode(value).ok().and_then(|mut seed| {
+            let key = AccountKey::from_seed(&seed);
+            memzero(&mut seed);
+            key
+        }))
+    }
+
+    pub(super) fn store(key: &AccountKey) -> ResultType<()> {
+        LocalConfig::set_option(OPTION.to_owned(), STANDARD.encode(key.seed()));
+        Ok(())
+    }
+
+    pub(super) fn forget() {
+        LocalConfig::set_option(OPTION.to_owned(), String::new());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The packer's folder (libs/portable `app_dir_name`): the packed executable's lower-cased
+    /// stem, HJViewer.exe in HJViewer's builds and rustdesk when none is packed.
+    const PACKER_DIRS: [&str; 2] = ["hjviewer", "rustdesk"];
+
+    #[test]
+    fn the_key_folder_is_not_the_packers() {
+        for packer in PACKER_DIRS {
+            assert!(
+                !KEY_DIR.eq_ignore_ascii_case(packer),
+                "{KEY_DIR} is {packer}"
+            );
+        }
+        assert_eq!(
+            (KEY_DIR.to_ascii_lowercase().as_str(), KEY_FILE),
+            ("hjviewer-account", "account-key.bin")
+        );
+        // a sibling of the packer's folder, not inside it
+        assert!(!KEY_DIR.contains(['/', '\\']));
+    }
+}
