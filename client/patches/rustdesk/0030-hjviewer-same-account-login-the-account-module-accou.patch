+
+    #[test]
+    fn the_servers_clock_moves_signatures_and_seals() {
+        let fake = Fake::logged_in();
+        let user = url("/api/currentUser");
+        // the login dialog's first request: a Date header 10 s ahead, used but not worth keeping
+        observe(
+            &fake,
+            &url("/api/login-options"),
+            &answer_dated(200, &json!([]), T + 10),
+        );
+        assert_eq!(lock(&fake).clock, Some(10));
+        assert_eq!(fake.local(CLOCK_OFFSET), "");
+        // a 409 clock answer: this device is 15 minutes behind; nobody is logged out
+        let list = r#"{"acct":"2026000001","at":1,"pcs":{}}"#;
+        fake.set_local(MY_DEVICES, list);
+        let clock = json!({ "error": "기기의 날짜와 시간이 맞지 않습니다.", "hjv": "clock", "server_time": T + 900 });
+        observe(&fake, &user, &answer(409, &clock));
+        assert_eq!(fake.local(CLOCK_OFFSET), "900");
+        assert_eq!(
+            [fake.local("access_token"), fake.local(MY_DEVICES)],
+            [REQ_TOKEN, list]
+        );
+        assert_eq!(fake.stored_key().as_deref(), Some(ACCOUNT_PK));
+        // the next request is signed at the server's time, not sent again by the hook
+        let body = Some("{}".to_owned());
+        let (_, header) = prepare(&fake, &user, "post", body, token_header(REQ_TOKEN)).unwrap();
+        assert_eq!(proof_time(&header), T + 900);
+        // a few seconds' drift is used, not written
+        observe(
+            &fake,
+            &user,
+            &answer_dated(200, &json!({ "name": ACCOUNT_ID }), T + 905),
+        );
+        assert_eq!(
+            (lock(&fake).clock, fake.local(CLOCK_OFFSET)),
+            (Some(905), "900".to_owned())
+        );
+        // a new process starts from the kept offset, for its seals too
+        let restarted = fake.restarted();
+        let login = Some(login_body("account"));
+        let (body, _) =
+            prepare(&restarted, &url("/api/login"), "post", login, json_header()).unwrap();
+        let payload: Value = serde_json::from_slice(&open(&sealed_of(&body.unwrap()))).unwrap();
+        assert_eq!(payload["t"].as_u64(), Some(T + 900));
+        // the clock set right: the next answer's Date brings the offset back and keeps it
+        observe(
+            &restarted,
+            &user,
+            &answer_dated(200, &json!({ "name": ACCOUNT_ID }), T),
+        );
+        assert_eq!(restarted.local(CLOCK_OFFSET), "0");
+    }
