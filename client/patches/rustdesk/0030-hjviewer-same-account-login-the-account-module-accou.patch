+        observe(&fake, &page(2), &answer(200, &rest));
+        assert_eq!(fake.local(MY_DEVICES), full);
+
+        // a new process has it, and a page that does not start a list leaves it
+        let restarted = fake.restarted();
+        assert_eq!(restarted.local(MY_DEVICES), full);
+        observe(&restarted, &page(2), &answer(200, &rest));
+        assert_eq!(restarted.local(MY_DEVICES), full);
+
+        // the same account's login keeps it; another account's drops it
+        log_in(&fake, ACCOUNT_ID, json!({ "ks": 1 }));
+        assert_eq!(fake.local(MY_DEVICES), full);
