+#[test]
+fn receipt_time_and_clock_jumps() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pk = pc().0;
+    // the server's dates are a day off from the PC's clock: irrelevant
+    let (kid, l, s) = list(
+        &list_key(1),
+        1,
+        "n",
+        10,
+        NOW + 86_400,
+        NOW + 2 * 86_400,
+        "active",
+        &owner().public_key(),
+    );
+    let cached = Cached {
+        list: verify_list(&pinned(), kid, &l, &s, &local_for(&pk.0, "n", 1)).unwrap(),
+        received: NOW,
+    };
+    assert!(valid_at(&cached, NOW + 1));
+    assert!(valid_at(&cached, NOW + 86_399));
+    assert!(!valid_at(&cached, NOW + 86_400));
+    // the PC clock jumped back by more than the skew (a CMOS reset): expired
+    assert!(valid_at(&cached, NOW - BACKWARD_SKEW));
+    assert!(!valid_at(&cached, NOW - BACKWARD_SKEW - 1));
+}
