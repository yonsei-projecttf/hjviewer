+#[test]
+fn keys_and_build_variables() {
+    let _ = hbb_common::sodiumoxide::init();
+    for (seed, pk) in [
+        (LIST_1_SEED, LIST_1_PK),
+        (LIST_2_SEED, LIST_2_PK),
+        (PC_SEED, PC_PK),
+        (ACCOUNT_SEED, ACCOUNT_PK),
+    ] {
+        assert_eq!(STANDARD.encode(device_key(&seed).public_key().0), pk);
+    }
+    let account = AccountKey::from_seed(&ACCOUNT_SEED).unwrap();
+    assert_eq!(STANDARD.encode(account.public_key()), ACCOUNT_PK);
+    assert_eq!(account.seed(), &ACCOUNT_SEED[..]);
+    let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+    assert_eq!(pinned.len(), 2);
+    assert_eq!(
+        (pinned[0].0, &pinned[0].1[..]),
+        (1, &pk_bytes(LIST_1_PK)[..])
+    );
+    assert_eq!(
+        (pinned[1].0, &pinned[1].1[..]),
+        (2, &pk_bytes(LIST_2_PK)[..])
+    );
+    assert_eq!(seal_kid(&parse_seal_pubkey(SEAL_PK).unwrap()), SEAL_KID);
+}
+
+#[test]
+fn trust_list() {
+    let _ = hbb_common::sodiumoxide::init();
+    let signed = trust_message(LIST.as_bytes());
+    let sig = sign::sign_detached(&signed, &device_key(&LIST_1_SEED));
+    assert_eq!(STANDARD.encode(sig.to_bytes()), LIST_SIG);
+    let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+    let pc_pk = pk_bytes(PC_PK);
+    let list = verify_list(&pinned, 1, &STANDARD.encode(LIST), LIST_SIG, &local(&pc_pk)).unwrap();
+    assert_eq!(
+        (list.serial, list.iat, list.exp, list.refresh),
+        (4182, 1_760_000_001, 1_760_086_401, 120)
+    );
+    assert_eq!(
+        (list.state.as_str(), list.owner.as_str(), list.login_at),
+        ("active", "홍*동", 1_759_999_950)
+    );
+    let key = &list.keys[0];
+    assert_eq!(
+        (key.pk.as_str(), key.id.as_str(), key.ks),
+        (ACCOUNT_PK, CTL_ID, CONN_KEY_SERIAL)
+    );
+    assert_eq!(key.kinds, ["remote", "file", "camera"]);
+    // the same bytes under list key 2 are not list key 1's signature
+    assert_eq!(
+        verify_list(&pinned, 2, &STANDARD.encode(LIST), LIST_SIG, &local(&pc_pk)).unwrap_err(),
+        Refusal::BadListSignature
+    );
+}
