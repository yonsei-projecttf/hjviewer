+/// The portal ID of the login, from `user_info` as the app keeps it.
+fn account_name(user_info: &str) -> String {
+    serde_json::from_str::<Value>(user_info)
+        .ok()
+        .and_then(|info| Some(info.get("name")?.as_str()?.to_owned()))
+        .unwrap_or_default()
+}
+
+/// H16 (flutter_ffi.rs main_get_common): the account screens' queries; None for any other key.
+/// - `hjv-account`: "Y" in an account build;
+/// - `hjv-relogin`: "Y" when the login was dropped for want of its account key;
+/// - `hjv-pc-bound`: "Y" when this user's login keeps this PC bound (logging out unbinds it).
+pub(crate) fn get_common(key: &str) -> Option<String> {
+    if !enabled() {
+        return None;
+    }
+    common_value(&App, key)
+}
+
+fn common_value(env: &impl Env, key: &str) -> Option<String> {
+    let yes = |set: bool| if set { "Y" } else { "" }.to_owned();
+    Some(match key {
+        "hjv-account" => yes(true),
+        RELOGIN => yes(env.local(RELOGIN) == "Y"),
+        "hjv-pc-bound" => yes(!env.local(PC_BINDING).is_empty()),
+        _ => return None,
+    })
+}
+
+/// main_set_common: true when the key was the account screens'. `hjv-relogin` set to "" once the
+/// notice was shown.
+pub(crate) fn set_common(key: &str, value: &str) -> bool {
+    if !enabled() {
+        return false;
+    }
+    set_common_value(&App, key, value)
+}
+
+fn set_common_value(env: &impl Env, key: &str, value: &str) -> bool {
+    if key != RELOGIN {
+        return false;
+    }
+    env.set_local(RELOGIN, value);
+    true
+}
+
+/// H21 (client.rs create_login_msg): in an account build the name other PCs see stays what 1.5.1
+/// sent, the built-in display name or else (on the next line there) the OS user name, never the
+/// login's name or portal ID (§1-5, §10-1).
+pub(crate) fn hide_account_name(name: &mut String) {
+    hide_name(enabled(), name, || {
+        crate::get_builtin_option(keys::OPTION_DISPLAY_NAME)
+    });
+}
+
+fn hide_name(account_build: bool, name: &mut String, builtin: impl FnOnce() -> String) {
+    if account_build {
+        *name = builtin();
+    }
+}
