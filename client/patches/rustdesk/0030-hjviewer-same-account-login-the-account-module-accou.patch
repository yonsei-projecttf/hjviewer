index 0000000..e554aff
--- /dev/null
+++ b/src/hjviewer_account/mod.rs
@@ -0,0 +1,779 @@
+//! Same-account logins: devices logged in to the same Yonsei portal account connect to the
+//! account's Windows PCs without the PC's password. The controller signs a proof with its account
+//! key (an Ed25519 key it makes at every password login); the PC checks it against a trust list
+//! that hjv-api signed for that PC and that the PC fetched itself.
+//!
+//! This file holds what every platform shares, all of it pure so that tests can pass keys and
+//! build variables in: the build variables, the bytes each signature covers, the connection kinds,
+//! and the PC's checks of a trust list and of a proof. `pc` is the controlled PC (desktop only),
+//! `ctl` the controller, `api` the account requests and `keystore` where the account key lives.
+//!
+//! A build without HJV_SERVER, HJV_LOGIN_SEAL_PUBKEY or HJV_TRUST_PUBKEYS is not an account build:
+//! the PC sends no nonce, the controller no proof, and nothing reaches hjv-api, as in 1.5.1.
+
+use base::message_proto::{login_request, HjvKeyProof};
+use hbb_common::{
+    base64::{
+        engine::general_purpose::{STANDARD, URL_SAFE_NO_PAD},
+        Engine as _,
+    },
+    bytes::Bytes,
+    rendezvous_proto::ConnType,
+    sodiumoxide::{crypto::sign, randombytes},
+};
+use serde_derive::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::time::Duration;
+
+mod api;
+mod ctl;
+mod keystore;
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+mod pc;
+#[cfg(test)]
+pub(crate) mod vectors;
+
+pub(crate) use api::{
+    account_tls, get_common, hide_account_name, observe_account_response, prepare_account_request,
+    proof_header, set_common,
+};
+pub(crate) use ctl::{key_proof, note_peer_key, take_proof_sent, LoginContext, ProofDecision};
+pub(crate) use pc::{forget_pc_binding, key_login, pc_capable, refresh_now, start_pc_sync};
+
+const SEAL_PUBKEY: Option<&str> = option_env!("HJV_LOGIN_SEAL_PUBKEY");
+const TRUST_PUBKEYS: Option<&str> = option_env!("HJV_TRUST_PUBKEYS");
+
+/// The account key's proof of possession inside the sealed login.
+pub(crate) const CKEY_CONTEXT: &[u8] = b"hjv-ckey-v1";
+/// The account key's signature of an account request (X-HJV-Proof).
+pub(crate) const REQ_CONTEXT: &[u8] = b"hjv-req-v1";
+/// The account key's proof in LoginRequest.hjv_key_proof.
+pub(crate) const CONN_CONTEXT: &[u8] = b"hjv-conn-v1";
+/// The PC's device key over its sync request.
+pub(crate) const PC_CONTEXT: &[u8] = b"hjv-pc-v1";
+/// hjv-api's list key over a trust list.
+pub(crate) const TRUST_CONTEXT: &[u8] = b"hjv-trust-v1";
+
+/// The longest a trust list may live (`exp - iat`), whatever the server signs.
+pub(crate) const MAX_LIST_TTL: u64 = 72 * 3600;
+/// The PC asks hjv-api at most this often and at least this often, whatever `refresh` says, so a
+/// PC that reaches the server learns of a revocation within MAX_REFRESH.
+pub(crate) const MIN_REFRESH: u64 = 5;
+pub(crate) const MAX_REFRESH: u64 = 300;
+/// How far the PC's clock may run behind a list's receipt before the list counts as expired.
+pub(crate) const BACKWARD_SKEW: u64 = 300;
+
+/// The service's options (Config2) by which the UI asks the PC's sync task: a bind and an unbind
+/// request, each `<binding>.<login_at>`, and a knock that makes it sync at once. The account
+/// requests (`api`) write them and the service (`pc`) reads them every second, both by these
+/// names, so that a logout's unbind cannot miss the service.
+const BIND_REQ: &str = "hjv-bind-req";
+const UNBIND_REQ: &str = "hjv-unbind-req";
+const KNOCK: &str = "hjv-pc-sync";
+
+/// An account build: pinned to the hjviewer server, with the seal key and the trust list keys.
+pub(crate) fn enabled() -> bool {
+    account_build(crate::hjviewer::pinned(), SEAL_PUBKEY, TRUST_PUBKEYS)
+}
+
+/// A build with only some of the three behaves as 1.5.1: login without password-less
+/// connections is not a build anyone gets.
+fn account_build(pinned: bool, seal_pubkey: Option<&str>, trust_pubkeys: Option<&str>) -> bool {
+    pinned
+        && seal_pubkey.and_then(parse_seal_pubkey).is_some()
+        && trust_pubkeys.and_then(parse_trust_pubkeys).is_some()
+}
+
+/// The seal key of an account build (HJV_LOGIN_SEAL_PUBKEY).
+pub(crate) fn seal_pubkey() -> Option<[u8; 32]> {
+    if !enabled() {
+        return None;
+    }
+    SEAL_PUBKEY.and_then(parse_seal_pubkey)
+}
+
+/// The trust list keys of an account build (HJV_TRUST_PUBKEYS), by key number.
+pub(crate) fn trust_pubkeys() -> Vec<(u32, [u8; 32])> {
+    if !enabled() {
+        return Vec::new();
+    }
+    TRUST_PUBKEYS
+        .and_then(parse_trust_pubkeys)
+        .unwrap_or_default()
+}
+
+/// Standard base64 of the 32-byte X25519 key that `hjv-api keygen seal` prints.
+pub(crate) fn parse_seal_pubkey(value: &str) -> Option<[u8; 32]> {
+    STANDARD.decode(value.trim()).ok()?.try_into().ok()
+}
+
+/// The key ID hjv-api gives a seal key (`hjv-sealed-v1.<kid>.`): its SHA-256's first 8 bytes in hex.
+pub(crate) fn seal_kid(pk: &[u8; 32]) -> String {
+    Sha256::digest(pk)[..8]
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect()
+}
+
+/// `<key number>:<standard base64 of an Ed25519 key>`, comma-separated (`1:…,2:…`). A malformed
+/// pair or a repeated key number makes the whole value unusable rather than half used.
+pub(crate) fn parse_trust_pubkeys(value: &str) -> Option<Vec<(u32, [u8; 32])>> {
+    let mut keys: Vec<(u32, [u8; 32])> = Vec::new();
+    for pair in value.split(',') {
+        let (kid, key) = pair.trim().split_once(':')?;
+        let kid = kid.trim().parse::<u32>().ok().filter(|kid| *kid > 0)?;
+        let key: [u8; 32] = STANDARD.decode(key.trim()).ok()?.try_into().ok()?;
+        if keys.iter().any(|(k, _)| *k == kid) {
+            return None;
+        }
+        keys.push((kid, key));
+    }
+    Some(keys)
+}
+
+/// The kinds of connection a proof names (the transcript's `kind` byte).
+pub(crate) const KIND_REMOTE: u8 = 0;
+pub(crate) const KIND_FILE: u8 = 1;
+pub(crate) const KIND_CAMERA: u8 = 2;
+pub(crate) const KIND_TERMINAL: u8 = 3;
+/// Port forwarding and RDP never go by proof: the mappings of one window share a session ID, so
+/// the PC key each of them was checked against cannot be told apart.
+pub(crate) const KIND_PORT_FORWARD: u8 = 4;
+
+/// What a trust list's `kinds` calls a kind.
+pub(crate) fn kind_name(kind: u8) -> &'static str {
+    match kind {
+        KIND_REMOTE => "remote",
+        KIND_FILE => "file",
+        KIND_CAMERA => "camera",
+        KIND_TERMINAL => "terminal",
+        _ => "port-forward",
+    }
+}
+
+/// PC: the kind of connection a LoginRequest asks for.
+pub(crate) fn kind_of_union(union: &Option<login_request::Union>) -> u8 {
+    match union {
+        None => KIND_REMOTE,
+        Some(login_request::Union::FileTransfer(_)) => KIND_FILE,
+        Some(login_request::Union::ViewCamera(_)) => KIND_CAMERA,
+        Some(login_request::Union::Terminal(_)) => KIND_TERMINAL,
+        // port forwarding, RDP, and whatever upstream adds
+        Some(_) => KIND_PORT_FORWARD,
+    }
+}
+
+/// Controller: the kind of connection a session opens.
+pub(crate) fn kind_of_conn_type(conn_type: ConnType) -> u8 {
+    match conn_type {
+        ConnType::DEFAULT_CONN => KIND_REMOTE,
+        ConnType::FILE_TRANSFER => KIND_FILE,
+        ConnType::VIEW_CAMERA => KIND_CAMERA,
+        ConnType::TERMINAL => KIND_TERMINAL,
+        _ => KIND_PORT_FORWARD,
+    }
+}
+
+fn joined(parts: &[&[u8]]) -> Vec<u8> {
+    parts.join(&0u8)
+}
+
+fn sha256_b64(data: &[u8]) -> String {
+    STANDARD.encode(Sha256::digest(data))
+}
+
+/// What a controller signs with its account key and the PC rebuilds to check it:
+///
+/// ```text
+/// "hjv-conn-v1" 0x00, u8 len(pc_id) | pc_id, pc_pk[32], nonce[32], u8 len(ctl_id) | ctl_id,
+/// u8 kind, ctl_pk[32]
+/// ```
+///
+/// `pc_pk` is the PC key this very channel was checked against (the PC: its own key), `nonce` the
+/// PC's Hash.hjv_nonce, `ctl_id` LoginRequest.my_id. None when a field does not fit.
+pub(crate) fn conn_transcript(
+    pc_id: &str,
+    pc_pk: &[u8],
+    nonce: &[u8],
+    ctl_id: &str,
+    kind: u8,
+    ctl_pk: &[u8],
+) -> Option<Vec<u8>> {
+    if pc_id.len() > 255
+        || ctl_id.len() > 255
+        || pc_pk.len() != 32
+        || nonce.len() != 32
+        || ctl_pk.len() != 32
+    {
+        return None;
+    }
+    let mut m = CONN_CONTEXT.to_vec();
+    m.push(0);
+    m.push(pc_id.len() as u8);
+    m.extend_from_slice(pc_id.as_bytes());
+    m.extend_from_slice(pc_pk);
+    m.extend_from_slice(nonce);
+    m.push(ctl_id.len() as u8);
+    m.extend_from_slice(ctl_id.as_bytes());
+    m.push(kind);
+    m.extend_from_slice(ctl_pk);
+    Some(m)
+}
+
+/// What the list key signs: `"hjv-trust-v1" NUL` and the list bytes exactly as hjv-api sent them.
+pub(crate) fn trust_message(list: &[u8]) -> Vec<u8> {
+    let mut m = TRUST_CONTEXT.to_vec();
+    m.push(0);
+    m.extend_from_slice(list);
+    m
+}
+
+/// What X-HJV-Proof signs, the parts joined by NUL bytes:
+/// `"hjv-req-v1", METHOD, path?query, t, n, base64(SHA-256(body)), base64(SHA-256(token))`.
+/// The method goes in capitals, as on the wire; `t` in decimal.
+pub(crate) fn req_message(
+    method: &str,
+    path_and_query: &str,
+    t: u64,
+    n: &str,
+    body: &[u8],
+    token: &str,
+) -> Vec<u8> {
+    let method = method.to_ascii_uppercase();
+    let t = t.to_string();
+    let (body, token) = (sha256_b64(body), sha256_b64(token.as_bytes()));
+    joined(&[
+        REQ_CONTEXT,
+        method.as_bytes(),
+        path_and_query.as_bytes(),
+        t.as_bytes(),
+        n.as_bytes(),
+        body.as_bytes(),
+        token.as_bytes(),
+    ])
+}
+
+/// What the PC's device key signs for a sync request: the relay envelope's bytes
+/// (relay/PROTOCOL.md 4.1) under the PC's own context, `"hjv-pc-v1", "sync", id, t, n,
+/// base64(SHA-256(p))` joined by NUL bytes.
+pub(crate) fn pc_sync_message(id: &str, t: u64, n: &str, p: &str) -> Vec<u8> {
+    let t = t.to_string();
+    let p = sha256_b64(p.as_bytes());
+    joined(&[
+        PC_CONTEXT,
+        b"sync",
+        id.as_bytes(),
+        t.as_bytes(),
+        n.as_bytes(),
+        p.as_bytes(),
+    ])
+}
+
+/// What a new account key signs inside the sealed login: `"hjv-ckey-v1", n, id, ck` joined by NUL
+/// bytes, with the sealed payload's own `n` and `id` and `ck` as the payload has it.
+pub(crate) fn ckey_message(n: &str, id: &str, ck: &str) -> Vec<u8> {
+    joined(&[CKEY_CONTEXT, n.as_bytes(), id.as_bytes(), ck.as_bytes()])
+}
+
+/// An account key: the Ed25519 key pair a device makes at every password login. The key stores
+/// keep its 32-byte seed. (sodiumoxide zeroes the secret key when it is dropped.)
+pub(crate) struct AccountKey(sign::SecretKey);
+
+impl AccountKey {
+    pub(crate) fn generate() -> AccountKey {
+        AccountKey(sign::gen_keypair().1)
+    }
+
+    pub(crate) fn from_seed(seed: &[u8]) -> Option<AccountKey> {
+        sign::Seed::from_slice(seed).map(|seed| AccountKey(sign::keypair_from_seed(&seed).1))
+    }
+
+    /// libsodium keeps the seed as the secret key's first half.
+    pub(crate) fn seed(&self) -> &[u8] {
+        &self.0 .0[..32]
+    }
+
+    pub(crate) fn public_key(&self) -> [u8; 32] {
+        self.0.public_key().0
+    }
+
+    pub(crate) fn sign(&self, message: &[u8]) -> [u8; 64] {
+        sign::sign_detached(message, &self.0).to_bytes()
+    }
+}
+
+/// The X-HJV-Proof value of an account request: `v1.<t>.<n>.<sig>`, `n` (16 random bytes) and
+/// `sig` in base64url without padding.
+pub(crate) fn request_proof(
+    key: &AccountKey,
+    method: &str,
+    path_and_query: &str,
+    body: &[u8],
+    token: &str,
+    t: u64,
+    n: &[u8; 16],
+) -> String {
+    let n = URL_SAFE_NO_PAD.encode(n);
+    let sig = key.sign(&req_message(method, path_and_query, t, &n, body, token));
+    format!("v1.{t}.{n}.{}", URL_SAFE_NO_PAD.encode(sig))
+}
+
+/// `ck` and `cp` of the sealed login payload, both standard base64.
+pub(crate) fn ckey_proof(key: &AccountKey, n: &str, id: &str) -> (String, String) {
+    let ck = STANDARD.encode(key.public_key());
+    let cp = STANDARD.encode(key.sign(&ckey_message(n, id, &ck)));
+    (ck, cp)
+}
+
+/// LoginRequest.hjv_key_proof. None when the transcript's fields do not fit.
+pub(crate) fn conn_proof(
+    key: &AccountKey,
+    pc_id: &str,
+    pc_pk: &[u8],
+    nonce: &[u8],
+    ctl_id: &str,
+    kind: u8,
+    key_serial: u64,
+) -> Option<HjvKeyProof> {
+    let pk = key.public_key();
+    let transcript = conn_transcript(pc_id, pc_pk, nonce, ctl_id, kind, &pk)?;
+    Some(HjvKeyProof {
+        version: 1,
+        pk: Bytes::copy_from_slice(&pk),
+        signature: Bytes::copy_from_slice(&key.sign(&transcript)),
+        key_serial,
+        ..Default::default()
+    })
+}
+
+#[derive(Serialize)]
+struct Envelope<'a> {
+    id: &'a str,
+    t: u64,
+    n: &'a str,
+    p: &'a str,
+    s: &'a str,
+}
+
+/// The body of a PC's sync request: the relay envelope `{"id","t","n","p","s"}`, `n` (16 random
+/// bytes) in base64url and `s` by the device key in standard base64.
+pub(crate) fn pc_sync_envelope(
+    device_key: &sign::SecretKey,
+    id: &str,
+    t: u64,
+    n: &[u8; 16],
+    p: &str,
+) -> String {
+    let n = URL_SAFE_NO_PAD.encode(n);
+    let s = STANDARD.encode(sign::sign_detached(
+        &pc_sync_message(id, t, &n, p),
+        device_key,
+    ));
+    // strings and a number always serialize
+    serde_json::to_string(&Envelope {
+        id,
+        t,
+        n: &n,
+        p,
+        s: &s,
+    })
+    .unwrap_or_default()
+}
+
+/// The `hjv_nonce` of this PC's Hash: 32 random bytes where this process takes same-account
+/// logins, else empty, which leaves the Hash byte-identical to 1.5.1's.
+pub(crate) fn hash_nonce() -> Bytes {
+    nonce_if(pc_capable())
+}
+
+fn nonce_if(capable: bool) -> Bytes {
+    if capable {
+        Bytes::from(randombytes::randombytes(32))
+    } else {
+        Bytes::new()
+    }
+}
+
+/// How long the PC waits before its next sync: the server's `refresh` held to
+/// MIN_REFRESH..=MAX_REFRESH, spread by up to ±20% so that PCs do not ask in step (`jitter` from
+/// 0, -20%, to u32::MAX, +20%), and held to the bounds again.
+pub(crate) fn sync_interval(refresh: u64, jitter: u32) -> Duration {
+    let base = refresh.clamp(MIN_REFRESH, MAX_REFRESH) * 1000;
+    let permille = 800 + u64::from(jitter) * 400 / u64::from(u32::MAX);
+    Duration::from_millis((base * permille / 1000).clamp(MIN_REFRESH * 1000, MAX_REFRESH * 1000))
+}
+
+/// Why the PC refused a trust list or a proof.
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub(crate) enum Refusal {
+    // a sync answer's list
+    BadEncoding,
+    UnknownKid,
+    RetiredKid,
+    BadListSignature,
+    WrongPc,
+    WrongBinding,
+    NotThisRequest,
+    BadLifetime,
+    // a proof, before the list is looked at
+    NotSecured,
+    NoNonce,
+    /// port forwarding, RDP, or a kind this build does not know
+    KindNotByProof,
+    BadProofSignature,
+    // a proof, against the list
+    NoList,
+    Expired,
+    NotActive,
+    UnknownKey,
+    KindNotAllowed,
+    IdMismatch,
+    // the PC's own state, decided before the proof
+    TemporaryOnly,
+    NotBound,
+    Off,
+}
+
+impl Refusal {
+    /// Its counter in the sync report's `refused`.
+    pub(crate) fn report_name(self) -> &'static str {
+        match self {
+            Refusal::UnknownKey => "unknown_key",
+            Refusal::KindNotByProof | Refusal::KindNotAllowed => "kind",
+            Refusal::TemporaryOnly => "temporary_only",
+            Refusal::NotSecured => "not_secured",
+            Refusal::BadProofSignature | Refusal::BadEncoding => "bad_sig",
+            Refusal::NoList | Refusal::Expired => "expired",
+            Refusal::Off => "off",
+            Refusal::NotActive => "not_active",
+            Refusal::IdMismatch => "id_mismatch",
+            Refusal::NoNonce => "no_nonce",
+            Refusal::NotBound => "unbound",
+            Refusal::UnknownKid
+            | Refusal::RetiredKid
+            | Refusal::BadListSignature
+            | Refusal::WrongPc
+            | Refusal::WrongBinding
+            | Refusal::NotThisRequest
+            | Refusal::BadLifetime => "list",
+        }
+    }
+
+    /// Decided before the list was looked at: a new list cannot change it.
+    fn before_list(self) -> bool {
+        matches!(
+            self,
+            Refusal::NotSecured
+                | Refusal::NoNonce
+                | Refusal::KindNotByProof
+                | Refusal::BadEncoding
+                | Refusal::BadProofSignature
+        )
+    }
+}
+
+/// One account key in a trust list.
+#[derive(Deserialize, Debug, Clone)]
