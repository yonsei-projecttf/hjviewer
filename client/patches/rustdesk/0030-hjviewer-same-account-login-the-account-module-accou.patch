+#[test]
+fn pc_sync_envelope_and_used_report() {
+    let _ = hbb_common::sodiumoxide::init();
+    let mut uses = Vec::new();
+    for at in SYNC_ACCEPTED {
+        count_use(&mut uses, ACCOUNT_PK, at);
+    }
+    let used = used_report(&uses, T);
+    assert_eq!(serde_json::to_string(&used).unwrap(), SYNC_USED);
+    // each line: the UTC day of its last use and that day's running count
+    for u in &used {
+        assert_eq!(u.day, utc_day(u.last));
+        let n = SYNC_ACCEPTED
+            .iter()
+            .filter(|at| utc_day(**at) == u.day)
+            .count();
+        assert_eq!(u.n, n as u64);
+    }
+    assert!(SYNC_P.contains(&format!(r#""used":{SYNC_USED}"#)));
+    assert_eq!(STANDARD.encode(Sha256::digest(SYNC_P)), SYNC_P_SHA256);
+    assert_eq!(
+        hex::encode(pc_sync_message(PC_ID, T, SYNC_N, SYNC_P)),
+        SYNC_SIGNED_HEX
+    );
+    let body = pc_sync_envelope(&device_key(&PC_SEED), PC_ID, T, &SYNC_N_BYTES, SYNC_P);
+    assert_eq!(body, SYNC_BODY);
+    let envelope: serde_json::Value = serde_json::from_str(&body).unwrap();
+    assert_eq!(
+        (envelope["p"].as_str(), envelope["s"].as_str()),
+        (Some(SYNC_P), Some(SYNC_S))
+    );
+}
