+//! The PC's list and proof rules (the five cases of the design's trust-v3 check, now with the
+//! signature checked first), the sync interval, the builds without the feature, and the wire
+//! format against a 1.5.1 parser.
+
+use super::{vectors::*, *};
+use base::message_proto::{
+    FileTransfer, Hash, LoginRequest, Message, PortForward, Terminal, ViewCamera,
+};
+use hbb_common::protobuf::{
+    reflect::{FileDescriptor, ReflectValueBox},
+    Message as _, MessageField,
+};
+
+const NOW: u64 = 1_760_000_000;
+
+fn list_key(seed: u8) -> sign::SecretKey {
+    device_key(&[seed; 32])
+}
+
+fn pinned() -> Vec<(u32, [u8; 32])> {
+    vec![
+        (1, list_key(1).public_key().0),
+        (2, list_key(9).public_key().0),
+    ]
+}
+
+fn pc() -> (sign::PublicKey, sign::SecretKey) {
+    sign::keypair_from_seed(&sign::Seed([2; 32]))
+}
+
+fn owner() -> AccountKey {
+    AccountKey::from_seed(&[3; 32]).unwrap()
+}
+
+/// A list as hjv-api signs it, for the vector PC and binding.
+#[allow(clippy::too_many_arguments)]
+fn list(
+    key: &sign::SecretKey,
+    kid: u32,
+    req: &str,
+    serial: u64,
+    iat: u64,
+    exp: u64,
+    state: &str,
+    ctl_pk: &[u8],
+) -> (u32, String, String) {
+    let l = serde_json::json!({
+        "v": 1, "typ": "hjv-trust", "kid": kid, "binding": BINDING,
+        "pc_id": PC_ID, "pc_pk": STANDARD.encode(pc().0 .0), "req": req, "serial": serial,
+        "iat": iat, "exp": exp, "refresh": 120, "strict": false, "state": state,
+        "owner": "홍*동", "login_at": iat - 50,
+        "keys": [{"pk": STANDARD.encode(ctl_pk), "id": CTL_ID, "name": "iPhone", "platform": "ios",
+                  "kinds": ["remote", "file", "camera"], "ks": 10}]
+    });
+    let bytes = serde_json::to_vec(&l).unwrap();
+    let sig = sign::sign_detached(&trust_message(&bytes), key);
+    (
+        kid,
+        STANDARD.encode(&bytes),
+        STANDARD.encode(sig.to_bytes()),
+    )
+}
+
+fn local_for<'a>(pc_pk: &'a [u8], req: &'a str, kid_floor: u32) -> Local<'a> {
+    Local {
+        pc_id: PC_ID,
+        pc_pk,
+        binding: BINDING,
+        request_nonce: req,
+        kid_floor,
+    }
+}
+
+#[test]
+fn poison_list_without_end_is_refused() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pk = pc().0;
+    let attacker = sign::keypair_from_seed(&sign::Seed([66; 32])).0;
+    // the security review's first poison: serial u64::MAX - 1, exp u64::MAX
+    let (kid, l, s) = list(
+        &list_key(1),
+        1,
+        "n1",
+        u64::MAX - 1,
+        NOW,
+        u64::MAX,
+        "active",
+        &attacker.0,
+    );
+    let r = verify_list(&pinned(), kid, &l, &s, &local_for(&pk.0, "n1", 1));
+    assert_eq!(r.unwrap_err(), Refusal::BadLifetime);
+}
+
+#[test]
+fn poison_future_list_is_bounded_and_does_not_block_recovery() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pk = pc().0;
+    let attacker = sign::keypair_from_seed(&sign::Seed([66; 32])).0;
+    // the second poison, as a list: ten years ahead, a huge serial, the longest lifetime allowed
+    let future = NOW + 10 * 365 * 86_400;
+    let (kid, l, s) = list(
+        &list_key(1),
+        1,
+        "n1",
+        u64::MAX - 1,
+        future,
+        future + MAX_LIST_TTL,
+        "active",
+        &attacker.0,
+    );
+    let poisoned =
+        verify_list(&pinned(), kid, &l, &s, &local_for(&pk.0, "n1", 1)).expect("accepted once");
+    let cached = Cached {
+        list: poisoned,
+        received: NOW,
+    };
+    // it lives from its receipt on the PC's clock, not from its own dates
+    assert!(valid_at(&cached, NOW + MAX_LIST_TTL - 1));
+    assert!(!valid_at(&cached, NOW + MAX_LIST_TTL));
+    // recovery: the clean server signs with key 2 and a normal serial; nothing refuses it
+    let (kid2, l2, s2) = list(
+        &list_key(9),
+        2,
+        "n2",
+        5_000,
+        NOW + 3_600,
+        NOW + 3_600 + 86_400,
+        "active",
+        &owner().public_key(),
+    );
+    assert_eq!(
+        verify_list(&pinned(), kid2, &l2, &s2, &local_for(&pk.0, "n2", 1))
+            .unwrap()
+            .serial,
+        5_000
+    );
+    // and once key 2 arrived, key 1 is retired
+    let (kid1, l1, s1) = list(
+        &list_key(1),
+        1,
+        "n3",
+        6_000,
+        NOW + 7_200,
+        NOW + 7_200 + 86_400,
+        "active",
+        &attacker.0,
+    );
+    assert_eq!(
+        verify_list(&pinned(), kid1, &l1, &s1, &local_for(&pk.0, "n3", 2)).unwrap_err(),
+        Refusal::RetiredKid
+    );
+}
+
+#[test]
+fn a_list_answers_one_request_only() {
+    let _ = hbb_common::sodiumoxide::init();
+    let pk = pc().0;
+    let (kid, l, s) = list(
+        &list_key(1),
+        1,
+        "old-nonce",
+        10,
+        NOW,
+        NOW + 86_400,
+        "active",
+        &owner().public_key(),
+    );
+    // an old, validly signed list replayed into a later sync
+    assert_eq!(
+        verify_list(&pinned(), kid, &l, &s, &local_for(&pk.0, "new-nonce", 1)).unwrap_err(),
+        Refusal::NotThisRequest
+    );
+    // a list for another PC, another binding, a tampered list, an unknown key number
+    let other_pc = sign::keypair_from_seed(&sign::Seed([7; 32])).0;
+    assert_eq!(
+        verify_list(
+            &pinned(),
+            kid,
+            &l,
+            &s,
+            &local_for(&other_pc.0, "old-nonce", 1)
+        )
+        .unwrap_err(),
+        Refusal::WrongPc
+    );
+    let wrong_binding = Local {
+        binding: "00",
+        ..local_for(&pk.0, "old-nonce", 1)
+    };
+    assert_eq!(
+        verify_list(&pinned(), kid, &l, &s, &wrong_binding).unwrap_err(),
+        Refusal::WrongBinding
+    );
+    let mut tampered = STANDARD.decode(&l).unwrap();
+    let last = tampered.len() - 2;
+    tampered[last] ^= 1;
+    assert_eq!(
+        verify_list(
+            &pinned(),
+            kid,
+            &STANDARD.encode(tampered),
+            &s,
+            &local_for(&pk.0, "old-nonce", 1)
+        )
+        .unwrap_err(),
+        Refusal::BadListSignature
+    );
+    assert_eq!(
+        verify_list(&pinned(), 3, &l, &s, &local_for(&pk.0, "old-nonce", 1)).unwrap_err(),
+        Refusal::UnknownKid
