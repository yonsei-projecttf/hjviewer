+        let hjv = json!({ "ks": 4182, "binding": BINDING, "login_at": 1_759_999_950 });
+        log_in(&fake, ACCOUNT_ID, hjv);
+        let request = format!("{BINDING}.1759999950");
+        assert_eq!(fake.stored_key().as_deref(), Some(ACCOUNT_PK));
+        assert_eq!([fake.local(KEY_SERIAL), fake.local(RELOGIN)], ["4182", ""]);
+        assert_eq!(fake.local(PC_BINDING), request);
+        assert_eq!(fake.writes.get(), 1);
+        let service = fake.service.borrow().clone();
+        assert_eq!(service.get(BIND_REQ), Some(&request));
+        assert!(service.get(KNOCK).is_some_and(|k| !k.is_empty()));
+
+        // a phone, or another account's PC: no binding in the answer, nothing for the service
+        for hjv in [
+            json!({ "ks": 4183 }),
+            json!({ "ks": 4183, "binding": "B0F1E2D3C4B5A69788796A5B4C3D2E1F", "login_at": 1 }),
+            json!({ "ks": 4183, "binding": BINDING, "login_at": 0 }),
+        ] {
+            let phone = Fake::new();
+            log_in(&phone, ACCOUNT_ID, hjv);
+            assert_eq!(
+                (phone.writes.get(), phone.local(PC_BINDING)),
+                (0, String::new())
+            );
+            assert_eq!(phone.stored_key().as_deref(), Some(ACCOUNT_PK));
+        }
+
+        // [이 PC 빼기]: an undo that did nothing leaves the binding, one that took the PC out
+        // unbinds it at once
+        let undo = url("/api/hjv/this-device/undo");
+        let kept = json!({ "id": PC_ID, "status": "added", "undo": false, "message": "" });
+        observe(&fake, &undo, &answer(200, &kept));
+        let removed = json!({ "id": PC_ID, "status": "removed", "undo": false, "message": "" });
+        observe(&fake, &undo, &answer(500, &removed));
+        assert_eq!(
+            (fake.writes.get(), fake.local(PC_BINDING)),
+            (1, request.clone())
+        );
+        observe(&fake, &undo, &answer(200, &removed));
+        assert_eq!(fake.writes.get(), 2);
+        assert_eq!(fake.service.borrow().get(UNBIND_REQ), Some(&request));
+        assert_eq!(fake.local(PC_BINDING), "");
+    }
+
+    #[test]
+    fn logout_unbinds_this_pc_first_in_one_write() {
+        let fake = Fake::logged_in();
+        let request = format!("{BINDING}.1759999950");
+        fake.set_local(PC_BINDING, &request);
+        fake.set_local(MY_DEVICES, r#"{"acct":"2026000001","at":1,"pcs":{}}"#);
+        fake.set_local(KEY_SERIAL, "4182");
+        fake.service.borrow_mut().extend([
+            (BIND_REQ.to_owned(), request.clone()),
+            ("approve-mode".to_owned(), "password".to_owned()),
+        ]);
+        // the app's logout (user_model.dart logOut) with hjv-api's token: signed as hjv-api's
+        // vector before the key went
+        fake.randoms.borrow_mut().push(REQ_POST.n);
+        let body = Some(API_LOGOUT_BODY.to_owned());
+        let logout = url("/api/logout");
+        let (_, header) = prepare(
+            &fake,
+            &logout,
+            "post",
+            body.clone(),
+            token_header(API_TOKEN),
+        )
+        .unwrap();
+        assert_eq!(headers(&header)[PROOF_HEADER], API_LOGOUT_PROOF);
+        assert_eq!(fake.stored_key(), None);
+        for key in [PC_BINDING, MY_DEVICES, KEY_SERIAL] {
+            assert_eq!(fake.local(key), "", "{key}");
+        }
+        // one write: the bind request gone, the unbind request and a knock in, the rest kept
+        assert_eq!(fake.writes.get(), 1);
+        let service = fake.service.borrow().clone();
+        assert_eq!(service.get(BIND_REQ), None);
+        assert_eq!(service.get(UNBIND_REQ), Some(&request));
+        assert!(service.get(KNOCK).is_some_and(|k| !k.is_empty()));
+        assert_eq!(
+            service.get("approve-mode").map(String::as_str),
+            Some("password")
+        );
+
+        // offline, with a locked key store or with no token left, the PC unbinds all the same;
+        // nothing unsigned goes
+        for (stored, header) in [
+            (Err(()), token_header(API_TOKEN)),
+            (Ok(Some(ACCOUNT_SEED)), token_header("")),
+            (Ok(Some(ACCOUNT_SEED)), json_header()),
+        ] {
+            let pc = Fake::logged_in();
+            pc.set_local(PC_BINDING, &request);
+            *pc.stored.borrow_mut() = stored;
+            let sent = prepare(&pc, &logout, "post", body.clone(), header);
+            assert!(sent.map_or(true, |(_, h)| !h.contains(PROOF_HEADER)
+                && !h.contains("hjv_")));
+            assert_eq!(pc.service.borrow().get(UNBIND_REQ), Some(&request));
+            assert_eq!(pc.local(PC_BINDING), "");
+        }
+
+        // another Windows user of this PC, who bound nothing: the owner's binding is left alone
+        let other = Fake::logged_in();
+        prepare(&other, &logout, "post", body, token_header(API_TOKEN));
+        assert_eq!(other.writes.get(), 0);
+    }
