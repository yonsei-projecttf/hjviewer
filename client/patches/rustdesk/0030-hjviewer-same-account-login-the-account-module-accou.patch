--- /dev/null
+++ b/src/hjviewer_account/api.rs
@@ -0,0 +1,1661 @@
+//! The account requests the app sends to hjv-api through `http_request` (design v3 §4-1, §4-2,
+//! §4-4, §4-7, §6-3), in an account build only:
+//!
+//! - the first step of a password login goes with the password sealed to hjv-api's key, a new
+//!   account key's public half and proof inside the seal, and the device key's signature;
+//! - every request with a token carries the account key's signature (X-HJV-Proof); without a key
+//!   the token does not go out at all;
+//! - the answers teach the server's clock, the login's account key, serial and PC binding, and
+//!   the account's device list (`hjv-my-devices`), which the controller sends proofs by;
+//! - an explicit logout drops the key and the list and, on a PC its user's login bound, asks the
+//!   service to unbind before the request goes out.
+//!
+//! Account requests never accept an invalid certificate (`account_tls`).
+
+use super::{
+    ckey_proof, enabled, joined,
+    keystore::{self, Unavailable},
+    request_proof, seal_kid, seal_pubkey, AccountKey, BIND_REQ, KNOCK, UNBIND_REQ,
+};
+use base::config::keys;
+use hbb_common::{
+    base64::{
+        engine::general_purpose::{STANDARD, URL_SAFE_NO_PAD},
+        Engine as _,
+    },
+    config::{Config, LocalConfig},
+    log,
+    sodiumoxide::{
+        crypto::{box_, sealedbox, sign},
+        randombytes,
+        utils::memzero,
+    },
+    ResultType,
+};
+use serde_derive::{Deserialize, Serialize};
+use serde_json::{json, Map, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, HashMap},
+    sync::{Mutex, MutexGuard},
+};
+
+/// LocalConfig, this device user's: the account's PCs as the last full device list had them.
+const MY_DEVICES: &str = "hjv-my-devices";
+/// LocalConfig: the server's clock minus this device's, in seconds, for a new process.
+const CLOCK_OFFSET: &str = "hjv-clock-offset";
+/// LocalConfig: the account key's serial (the login answer's `hjv.ks`), a connection proof's hint.
+const KEY_SERIAL: &str = "hjv-key-serial";
+/// LocalConfig: `<binding>.<login_at>` while this user's login keeps this PC bound.
+const PC_BINDING: &str = "hjv-pc-binding";
+/// LocalConfig: "Y" after a token was dropped for want of its account key: log in again.
+const RELOGIN: &str = "hjv-relogin";
+
+const PROOF_HEADER: &str = "X-HJV-Proof";
+const SEALED_PREFIX: &str = "hjv-sealed-v1.";
+/// The device key's signature of a login (server/api/src/devsig.rs).
+const LOGIN_CONTEXT: &[u8] = b"hjv-login-v1";
+/// A learned clock offset reaches LocalConfig only when it moved by more than this.
+const CLOCK_KEEP_STEP: u64 = 30;
+
+/// The account API's paths the app calls. What goes there carries the portal password or the
+/// token, so it goes only with the server's certificate checked, and the token only signed.
+fn is_account_path(path: &str) -> bool {
+    matches!(
+        path,
+        "/api/login"
+            | "/api/logout"
+            | "/api/currentUser"
+            | "/api/users"
+            | "/api/peers"
+            | "/api/login-options"
+            | "/api/device-group/accessible"
+    ) || path.starts_with("/api/hjv/")
+}
+
+/// The request target (the path and the query, as sent) of a request to the API server; None for
+/// any other URL.
+fn api_target(url: &str, api_server: &str) -> Option<String> {
+    let (url, api) = (
+        url::Url::parse(url).ok()?,
+        url::Url::parse(api_server).ok()?,
+    );
+    let same_server = api.host_str().is_some()
+        && url.scheme() == api.scheme()
+        && url.host_str() == api.host_str()
+        && url.port_or_known_default() == api.port_or_known_default();
+    same_server.then(|| url[url::Position::BeforePath..url::Position::AfterQuery].to_owned())
+}
+
+/// The request target of a request to one of the account API's paths.
+fn account_target(url: &str, api_server: &str) -> Option<String> {
+    api_target(url, api_server).filter(|target| is_account_path(target_path(target)))
+}
+
+fn target_path(target: &str) -> &str {
+    target.split('?').next().unwrap_or_default()
+}
+
+/// H15 (common.rs): whether a request may accept an invalid certificate. An account request
+/// never does, whatever the host's cached TLS settings say, so neither the password nor the token
+/// reaches a TLS interceptor (design v2 §8-2).
+pub(crate) fn account_tls(url: &str, cached: Option<bool>) -> Option<bool> {
+    if !enabled() {
+        return cached;
+    }
+    strict_tls(&Config::get_option(keys::OPTION_API_SERVER), url, cached)
+}
+
+fn strict_tls(api_server: &str, url: &str, cached: Option<bool>) -> Option<bool> {
+    if account_target(url, api_server).is_some() {
+        Some(false)
+    } else {
+        cached
+    }
+}
+
+/// What the account requests keep from one request to the next, in this process.
+struct State {
+    /// the account key of a password login under way, until an answer brings its token
+    pending: Option<AccountKey>,
+    /// the server's clock minus this device's
+    clock: Option<i64>,
+    /// a device list arriving page by page
+    pages: Option<Pages>,
+}
+
+impl State {
+    const fn new() -> State {
+        State {
+            pending: None,
+            clock: None,
+            pages: None,
+        }
+    }
+}
+
+struct Pages {
+    total: u64,
+    next: u64,
+    seen: u64,
+    pcs: BTreeMap<String, MyPc>,
+}
+
+static STATE: Mutex<State> = Mutex::new(State::new());
+
+/// `hjv-my-devices`: the account's PCs as the last full device list (`/api/peers`) had them.
+#[derive(Serialize, Deserialize, Default, Debug, Clone, PartialEq)]
+pub(crate) struct MyDevices {
+    /// the account's portal ID
+    pub acct: String,
+    /// when it came, by this device's clock
+    pub at: u64,
+    pub pcs: BTreeMap<String, MyPc>,
+}
+
+/// A PC of the device list: `hjv` of its `/api/peers` entry.
+#[derive(Serialize, Deserialize, Default, Debug, Clone, PartialEq)]
+pub(crate) struct MyPc {
+    /// the PC's key as hbbs held it when it was bound (standard base64), for key continuity
+    #[serde(default)]
+    pub pk: String,
+    /// active, listed, off, expired, disabled or needs-relogin
+    #[serde(default)]
+    pub pwless: String,
+    #[serde(default)]
+    pub kinds: Vec<String>,
+}
+
+/// What the account requests read and change outside this module.
+trait Env {
+    /// where the account API is: `https://<server>`
+    fn api_server(&self) -> String;
+    fn seal_pubkey(&self) -> Option<[u8; 32]>;
+    /// this device's clock, Unix seconds
+    fn now(&self) -> u64;
+    fn random16(&self) -> [u8; 16];
+    fn new_key(&self) -> AccountKey;
+    /// this device user's LocalConfig
+    fn local(&self, key: &str) -> String;
+    fn set_local(&self, key: &str, value: &str);
+    fn load_key(&self) -> Result<Option<AccountKey>, Unavailable>;
+    fn store_key(&self, key: &AccountKey) -> ResultType<()>;
+    fn forget_key(&self);
+    /// the device key the login signs with (the one registered with hbbs), if there is one
+    fn device_key(&self) -> Option<sign::SecretKey>;
+    fn installed(&self) -> bool;
+    /// one write of the service's options, `change` applied to what they are now
+    fn write_service_options(&self, change: &dyn Fn(&mut HashMap<String, String>));
+    fn state(&self) -> &Mutex<State>;
+}
+
+/// The app itself.
+struct App;
+
+impl Env for App {
+    fn api_server(&self) -> String {
+        Config::get_option(keys::OPTION_API_SERVER)
+    }
+
+    fn seal_pubkey(&self) -> Option<[u8; 32]> {
+        seal_pubkey()
+    }
+
+    fn now(&self) -> u64 {
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |d| d.as_secs())
+    }
+
+    fn random16(&self) -> [u8; 16] {
+        let _ = hbb_common::sodiumoxide::init();
+        let mut n = [0u8; 16];
+        randombytes::randombytes_into(&mut n);
+        n
+    }
+
+    fn new_key(&self) -> AccountKey {
+        let _ = hbb_common::sodiumoxide::init();
+        AccountKey::generate()
+    }
+
+    fn local(&self, key: &str) -> String {
+        LocalConfig::get_option(key)
+    }
+
+    fn set_local(&self, key: &str, value: &str) {
+        LocalConfig::set_option(key.to_owned(), value.to_owned());
+    }
+
+    fn load_key(&self) -> Result<Option<AccountKey>, Unavailable> {
+        keystore::load()
+    }
+
+    fn store_key(&self, key: &AccountKey) -> ResultType<()> {
+        keystore::store(key)
+    }
+
+    fn forget_key(&self) {
+        keystore::forget()
+    }
+
+    fn device_key(&self) -> Option<sign::SecretKey> {
+        Config::get_existing_key_pair().and_then(|(sk, _)| sign::SecretKey::from_slice(&sk))
+    }
+
+    fn installed(&self) -> bool {
+        #[cfg(not(any(target_os = "android", target_os = "ios")))]
+        return crate::platform::is_installed();
+        #[cfg(any(target_os = "android", target_os = "ios"))]
+        return false;
+    }
+
+    fn write_service_options(&self, change: &dyn Fn(&mut HashMap<String, String>)) {
+        #[cfg(not(any(target_os = "android", target_os = "ios")))]
+        {
+            // the IPC calls start a runtime of their own, so they run off the caller's thread,
+            // which may be on one; the options come from the service, not this process's copy
+            let Ok(mut options) = std::thread::spawn(crate::ipc::get_options).join() else {
+                log::error!("account: the service's options could not be read");
+                return;
+            };
+            change(&mut options);
+            if std::thread::spawn(move || crate::ui_interface::set_options(options))
+                .join()
+                .is_err()
+            {
+                log::error!("account: the service's options could not be written");
+            }
+        }
+        #[cfg(any(target_os = "android", target_os = "ios"))]
+        {
+            let mut options = Config::get_options();
+            change(&mut options);
+            Config::set_options(options);
+        }
+    }
+
+    fn state(&self) -> &Mutex<State> {
+        &STATE
+    }
+}
+
+fn lock(env: &impl Env) -> MutexGuard<'_, State> {
+    env.state().lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// H13 (ui_interface.rs http_request): an account request's body and header as they go out; None
+/// to send nothing, when the account key cannot be used right now (a locked iPhone), so that the
+/// request fails without logging the app out.
+pub(crate) fn prepare_account_request(
+    url: &str,
+    method: &str,
+    body: Option<String>,
+    header: String,
+) -> Option<(Option<String>, String)> {
+    if !enabled() {
+        return Some((body, header));
+    }
+    prepare(&App, url, method, body, header)
+}
+
+fn prepare(
+    env: &impl Env,
+    url: &str,
+    method: &str,
+    mut body: Option<String>,
+    header: String,
+) -> Option<(Option<String>, String)> {
+    let Some(target) = api_target(url, &env.api_server()) else {
+        return Some((body, header));
+    };
+    let path = target_path(&target);
+    let post = method.eq_ignore_ascii_case("post");
+    if path == "/api/login" && post {
+        if let Some(login) = body.take() {
+            body = Some(match seal_login(env, &login) {
+                Seal::NotPasswordLogin => login,
+                Seal::Sealed(sealed) => {
+                    memzero(&mut login.into_bytes());
+                    sealed
+                }
+                // the password never goes out unsealed
+                Seal::Failed => return None,
+            });
+        }
+    }
+    let logout = path == "/api/logout" && post;
+    // signed with the key before a logout drops it
+    let header = with_token(env, method, &target, body.as_deref(), header, logout);
+    if logout {
+        log_out(env);
+    }
+    Some((body, header?))
+}
+
+/// The header of a request to the API server: a token goes signed by the account key to an
+/// account path and nowhere else; None when the key cannot be used right now.
+fn with_token(
+    env: &impl Env,
+    method: &str,
+    target: &str,
+    body: Option<&str>,
+    header: String,
+    logout: bool,
+) -> Option<String> {
+    // http_request_sync refuses a header it cannot read
+    let Ok(mut headers) = serde_json::from_str::<Map<String, Value>>(&header) else {
+        return Some(header);
+    };
+    let Some((authorization, token)) = bearer(&headers) else {
+        return Some(header);
+    };
+    if is_account_path(target_path(target)) {
+        match env.load_key() {
+            Ok(Some(key)) => {
+                let body = body.unwrap_or_default().as_bytes();
+                let proof = sign_request(env, &key, method, target, body, &token);
+                headers.insert(PROOF_HEADER.to_owned(), Value::String(proof));
+                return Some(Value::Object(headers).to_string());
+            }
+            Err(Unavailable) => return None,
+            // no account key (a restored iPhone): the token is no use any more
+            Ok(None) if !logout => drop_login(env),
+            Ok(None) => {}
+        }
+    }
+    headers.remove(&authorization);
+    Some(Value::Object(headers).to_string())
+}
+
+/// The Authorization header's name as sent and its bearer token.
+fn bearer(headers: &Map<String, Value>) -> Option<(String, String)> {
+    headers.iter().find_map(|(name, value)| {
+        let token = value.as_str()?.strip_prefix("Bearer ")?.trim();
+        (name.eq_ignore_ascii_case("authorization") && !token.is_empty())
+            .then(|| (name.clone(), token.to_owned()))
+    })
+}
+
+/// The X-HJV-Proof value of an account request (§4-2): the account key's signature of the
+/// method, the path with its query, the body and the token; None when the key cannot be used
+/// (none, or a locked iPhone). Every request with a token gets one in http_request; the minimum
+/// version work's update check asks for one here.
+pub(crate) fn proof_header(
+    method: &str,
+    path_and_query: &str,
+    body: &[u8],
+    token: &str,
+) -> Option<String> {
+    if !enabled() {
+        return None;
+    }
+    proof_header_with(&App, method, path_and_query, body, token)
+}
+
+fn proof_header_with(
+    env: &impl Env,
+    method: &str,
+    path_and_query: &str,
+    body: &[u8],
+    token: &str,
+) -> Option<String> {
+    let key = env.load_key().ok()??;
+    Some(sign_request(env, &key, method, path_and_query, body, token))
+}
+
+fn sign_request(
+    env: &impl Env,
+    key: &AccountKey,
+    method: &str,
+    target: &str,
+    body: &[u8],
+    token: &str,
+) -> String {
+    let t = server_now(env);
+    request_proof(key, method, target, body, token, t, &env.random16())
+}
+
+/// This device's clock set by what the server taught it (§4-2): the `t` of a signature or seal.
+fn server_now(env: &impl Env) -> u64 {
+    let offset = {
+        let mut state = lock(env);
+        *state
+            .clock
+            .get_or_insert_with(|| env.local(CLOCK_OFFSET).parse().unwrap_or(0))
+    };
+    let now = i64::try_from(env.now()).unwrap_or(i64::MAX);
+    u64::try_from(now.saturating_add(offset)).unwrap_or(0)
+}
+
+enum Seal {
+    NotPasswordLogin,
+    Sealed(String),
+    Failed,
+}
+
+/// The sealed payload (server/api/src/seal.rs), with the new account key's public half `ck` and
+/// its proof `cp` (§4-1).
+#[derive(Serialize)]
+struct Payload<'a> {
+    v: u32,
+    pw: &'a str,
+    t: u64,
+    n: &'a str,
+    id: &'a str,
+    kid: &'a str,
+    ck: &'a str,
+    cp: &'a str,
+}
+
+fn login_payload(pw: &str, t: u64, n: &str, id: &str, kid: &str, key: &AccountKey) -> Vec<u8> {
+    let (ck, cp) = ckey_proof(key, n, id);
+    let payload = Payload {
+        v: 1,
+        pw,
+        t,
+        n,
+        id,
+        kid,
+        ck: &ck,
+        cp: &cp,
+    };
+    // strings and numbers always serialize
+    serde_json::to_vec(&payload).unwrap_or_default()
+}
+
+/// What the device key signs for a login (server/api/src/devsig.rs): `"hjv-login-v1", id, t, n,
+/// base64(SHA-256(sealed)), "1" or "0" for installed, os`, joined by NUL bytes.
+fn login_message(id: &str, t: u64, n: &str, sealed: &[u8], installed: bool, os: &str) -> Vec<u8> {
+    let (t, hash) = (t.to_string(), STANDARD.encode(Sha256::digest(sealed)));
+    joined(&[
+        LOGIN_CONTEXT,
+        id.as_bytes(),
+        t.as_bytes(),
+        n.as_bytes(),
+        hash.as_bytes(),
+        if installed { b"1" } else { b"0" },
+        os.as_bytes(),
+    ])
+}
+
+/// The first step of a password login (§4-1, design v2 §8-2): the password goes sealed to
+/// hjv-api's key together with a new account key, which is kept until the answer brings the
+/// token, and the device key signs the login. The second step of a two-factor login carries a
+/// code and no password, and goes as it is.
+fn seal_login(env: &impl Env, body: &str) -> Seal {
+    let Ok(mut login) = serde_json::from_str::<Map<String, Value>>(body) else {
+        return Seal::NotPasswordLogin;
+    };
+    let Some(Value::String(password)) = login.remove("password") else {
+        return Seal::NotPasswordLogin;
+    };
+    let Some(seal_pk) = env.seal_pubkey() else {
+        return Seal::Failed;
+    };
+    let id = login
+        .get("id")
+        .and_then(Value::as_str)
+        .unwrap_or_default()
+        .to_owned();
+    let os = login
+        .get("deviceInfo")
+        .and_then(|info| info.get("os"))
+        .and_then(Value::as_str)
+        .unwrap_or_default()
+        .to_owned();
+    let (key, n, t, kid) = (
+        env.new_key(),
+        STANDARD.encode(env.random16()),
+        server_now(env),
+        seal_kid(&seal_pk),
+    );
+    let mut payload = login_payload(&password, t, &n, &id, &kid, &key);
+    memzero(&mut password.into_bytes());
+    let sealed = sealedbox::seal(&payload, &box_::PublicKey(seal_pk));
+    memzero(&mut payload);
+    let installed = env.installed();
+    let mut hjv = json!({ "v": 1, "installed": installed, "ver": crate::VERSION });
+    if let Some(device) = env.device_key() {
+        let message = login_message(&id, t, &n, &sealed, installed, &os);
+        hjv["sig"] = STANDARD
+            .encode(sign::sign_detached(&message, &device).to_bytes())
+            .into();
+    }
+    login.insert(
+        "password".to_owned(),
+        format!("{SEALED_PREFIX}{kid}.{}", URL_SAFE_NO_PAD.encode(&sealed)).into(),
+    );
+    login.insert("hjv".to_owned(), hjv);
+    lock(env).pending = Some(key);
+    Seal::Sealed(Value::Object(login).to_string())
+}
+
+/// An explicit logout (§4-7), before its request goes out, so whether or not it arrives: the
+/// account key and the device list go, and a PC this user's login bound stops taking proofs.
+/// The app's own logout after a 401 or 400 (UserModel.reset) sends no /api/logout and keeps all.
+fn log_out(env: &impl Env) {
+    env.forget_key();
+    {
+        let mut state = lock(env);
+        state.pending = None;
+        state.pages = None;
+    }
+    for key in [MY_DEVICES, KEY_SERIAL, RELOGIN] {
+        env.set_local(key, "");
+    }
+    unbind_this_pc(env);
+}
+
+/// The PC this user's login bound stops taking proofs at once, whether or not the server hears of
+/// it: one write of the service's options drops the bind request and puts in the unbind request
+/// and a knock; the service handles the unbinding first (§4-7).
+fn unbind_this_pc(env: &impl Env) {
+    let binding = env.local(PC_BINDING);
+    if binding.is_empty() {
+        return;
+    }
+    let knock = knock(env);
+    env.write_service_options(&|options| {
+        options.remove(BIND_REQ);
+        options.insert(UNBIND_REQ.to_owned(), binding.clone());
+        options.insert(KNOCK.to_owned(), knock.clone());
+    });
+    env.set_local(PC_BINDING, "");
+}
+
+/// A token without its account key (a restored iPhone, whose Keychain kept no key) can do
+/// nothing: the login is forgotten and the user asked to log in again (§1-1, §4-2).
+fn drop_login(env: &impl Env) {
+    for (key, value) in [("access_token", ""), ("user_info", ""), (RELOGIN, "Y")] {
+        env.set_local(key, value);
+    }
+    log::warn!("account: no account key for the login, logged out");
+}
+
+fn knock(env: &impl Env) -> String {
+    hex::encode(env.random16())
+}
+
+/// What http_request answers: the status, the headers (lower-case names) and the body.
+#[derive(Deserialize)]
+struct Answer {
+    status_code: u16,
+    #[serde(default)]
+    headers: HashMap<String, String>,
+    #[serde(default)]
+    body: String,
+}
+
+/// H14 (ui_interface.rs http_request): what an account answer says, before the app reads it,
+/// which it leaves as it is.
+pub(crate) fn observe_account_response(url: &str, response: &str) {
+    if enabled() {
+        observe(&App, url, response);
+    }
+}
+
+fn observe(env: &impl Env, url: &str, response: &str) {
+    let Some(target) = account_target(url, &env.api_server()) else {
+        return;
+    };
+    // no answer: the request never reached the server
+    let Ok(answer) = serde_json::from_str::<Answer>(response) else {
+        return;
+    };
+    let body = serde_json::from_str::<Value>(&answer.body).unwrap_or_default();
+    learn_clock(env, &answer, &body);
+    let ok = answer.status_code == 200;
+    match target_path(&target) {
+        "/api/login" => login_answered(env, ok, &body),
+        "/api/peers" if ok => device_list_page(env, &target, &body),
+        "/api/peers" => lock(env).pages = None,
+        // [이 PC 빼기] took this PC out of the list again: it stops taking proofs at once
+        "/api/hjv/this-device/undo"
+            if ok && body.get("status").and_then(Value::as_str) == Some("removed") =>
+        {
+            unbind_this_pc(env)
+        }
+        _ => {}
+    }
+}
+
+/// §4-2: the server's clock, from the `server_time` of a 409 `clock` answer or else from the
+/// `Date` header, minus this device's. Kept for the next signature and seal, and in LocalConfig
+/// when it moved by more than CLOCK_KEEP_STEP, for the next process.
+fn learn_clock(env: &impl Env, answer: &Answer, body: &Value) {
+    let clock = body.get("hjv").and_then(Value::as_str) == Some("clock");
+    let server_time = body
+        .get("server_time")
+        .and_then(Value::as_i64)
+        .filter(|_| clock)
+        .or_else(|| {
+            let (_, date) = answer
+                .headers
+                .iter()
+                .find(|(name, _)| name.eq_ignore_ascii_case("date"))?;
+            Some(chrono::DateTime::parse_from_rfc2822(date).ok()?.timestamp())
+        });
+    let Some(server_time) = server_time else {
+        return;
+    };
+    let offset = server_time.saturating_sub(i64::try_from(env.now()).unwrap_or(i64::MAX));
+    lock(env).clock = Some(offset);
+    let kept = env.local(CLOCK_OFFSET).parse::<i64>().unwrap_or(0);
+    if offset.abs_diff(kept) > CLOCK_KEEP_STEP {
+        env.set_local(CLOCK_OFFSET, &offset.to_string());
+    }
+}
+
+/// The answer to `/api/login`. With the token (the first step's, or with two factors the
+/// second's) the login's account key is kept; the device list goes when the login is another
+/// account's; and a PC the login bound (`hjv.binding`, `hjv.login_at`) gets its service's bind
+/// request (§4-4).
+fn login_answered(env: &impl Env, ok: bool, body: &Value) {
+    let token = body.get("type").and_then(Value::as_str) == Some("access_token")
+        && body
+            .get("access_token")
+            .and_then(Value::as_str)
+            .is_some_and(|t| !t.is_empty());
+    if !ok || !token {
+        // a second factor's code dialog waits with the key; a failed login drops it
+        if !ok {
+            lock(env).pending = None;
+        }
+        return;
+    }
+    let pending = lock(env).pending.take();
+    match pending.map(|key| env.store_key(&key)) {
+        Some(Ok(())) => log::info!("account: logged in with a new account key"),
+        Some(Err(e)) => log::error!("account: the account key was not stored: {e}"),
+        None => log::error!("account: a login answer without an account key of this process"),
+    }
+    let hjv = body.get("hjv");
+    let serial = hjv.and_then(|h| h.get("ks")).and_then(Value::as_u64);
+    env.set_local(
+        KEY_SERIAL,
+        &serial.map(|s| s.to_string()).unwrap_or_default(),
+    );
+    env.set_local(RELOGIN, "");
+    let account = body
+        .get("user")
+        .and_then(|u| u.get("name"))
+        .and_then(Value::as_str)
+        .unwrap_or_default();
+    let listed = env.local(MY_DEVICES);
+    if !listed.is_empty()
+        && serde_json::from_str::<MyDevices>(&listed).map_or(true, |l| l.acct != account)
+    {
+        env.set_local(MY_DEVICES, "");
+    }
+    let Some(binding) = hjv.and_then(bind_request) else {
+        return;
+    };
+    env.set_local(PC_BINDING, &binding);
+    let knock = knock(env);
+    env.write_service_options(&|options| {
+        options.insert(BIND_REQ.to_owned(), binding.clone());
+        options.insert(KNOCK.to_owned(), knock.clone());
+    });
+}
+
+/// `<binding>.<login_at>` of a login answer that bound this PC.
+fn bind_request(hjv: &Value) -> Option<String> {
+    let binding = hjv.get("binding")?.as_str()?;
+    let login_at = hjv.get("login_at")?.as_u64().filter(|t| *t > 0)?;
+    let hex32 = binding.len() == 32
+        && binding
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b));
+    hex32.then(|| format!("{binding}.{login_at}"))
+}
+
+/// A 200 page of `/api/peers`. The app asks page after page from `current=1` until it has
+/// `total` PCs; the list replaces `hjv-my-devices` only once all of it came, so a failed or
+/// partial fetch keeps the last full list (§6-3).
+fn device_list_page(env: &impl Env, target: &str, body: &Value) {
+    let query = target.split_once('?').map_or("", |(_, q)| q);
+    let current = url::form_urlencoded::parse(query.as_bytes())
+        .find(|(name, _)| name == "current")
+        .and_then(|(_, value)| value.parse::<u64>().ok())
+        .unwrap_or(1);
+    let total = body.get("total").and_then(Value::as_u64);
+    let data = body.get("data").and_then(Value::as_array);
+    let complete = {
+        let mut state = lock(env);
+        let (Some(total), Some(data)) = (total, data) else {
+            state.pages = None;
+            return;
+        };
+        if current == 1 {
+            state.pages = Some(Pages {
+                total,
+                next: 1,
+                seen: 0,
+                pcs: BTreeMap::new(),
+            });
+        }
+        let Some(pages) = state.pages.as_mut().filter(|p| p.next == current) else {
+            state.pages = None;
+            return;
+        };
+        for pc in data {
+            pages.seen += 1;
+            let id = pc.get("id").and_then(Value::as_str);
+            let hjv = pc.get("hjv").cloned().map(serde_json::from_value::<MyPc>);
+            if let (Some(id), Some(Ok(hjv))) = (id, hjv) {
+                pages.pcs.insert(id.to_owned(), hjv);
+            }
+        }
+        pages.next += 1;
+        if pages.seen < pages.total {
+            return;
+        }
+        state.pages.take()
+    };
+    let Some(pages) = complete else {
+        return;
+    };
+    // a page answered after an explicit logout, which dropped the key first, keeps no list
+    if !matches!(env.load_key(), Ok(Some(_))) {
+        return;
+    }
+    let list = MyDevices {
+        acct: account_name(&env.local("user_info")),
+        at: env.now(),
+        pcs: pages.pcs,
+    };
+    if let Ok(list) = serde_json::to_string(&list) {
+        env.set_local(MY_DEVICES, &list);
+    }
+}
