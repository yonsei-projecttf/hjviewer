+#[test]
+fn request_proofs() {
+    let _ = hbb_common::sodiumoxide::init();
+    let account = AccountKey::from_seed(&ACCOUNT_SEED).unwrap();
+    for r in [REQ_POST, REQ_GET] {
+        let n = URL_SAFE_NO_PAD.encode(r.n);
+        let signed = req_message(
+            r.method,
+            r.path_and_query,
+            T,
+            &n,
+            r.body.as_bytes(),
+            REQ_TOKEN,
+        );
+        assert_eq!(hex::encode(signed), r.signed_hex);
+        let header = request_proof(
+            &account,
+            r.method,
+            r.path_and_query,
+            r.body.as_bytes(),
+            REQ_TOKEN,
+            T,
+            &r.n,
+        );
+        assert_eq!(header, r.header);
+        // the app's method strings are lower case; the wire's are not
+        let lower = r.method.to_ascii_lowercase();
+        assert_eq!(
+            request_proof(
+                &account,
+                &lower,
+                r.path_and_query,
+                r.body.as_bytes(),
+                REQ_TOKEN,
+                T,
+                &r.n
+            ),
+            r.header
+        );
+    }
+}
