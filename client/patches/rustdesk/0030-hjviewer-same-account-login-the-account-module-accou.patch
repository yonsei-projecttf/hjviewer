+        let sig = STANDARD.decode(hjv["sig"].as_str().unwrap()).unwrap();
+        let message = login_message(CKEY_ID, T, CKEY_N, &sealed, true, "windows");
+        assert!(sign::verify_detached(
+            &sign::Signature::from_bytes(&sig).unwrap(),
+            &message,
+            &device_key(&PC_SEED).public_key()
+        ));
+        // the new key waits for the token
+        let pending = lock(&fake).pending.as_ref().map(AccountKey::public_key);
+        assert_eq!(
+            pending.map(|pk| STANDARD.encode(pk)).as_deref(),
+            Some(ACCOUNT_PK)
+        );
+        assert_eq!(fake.stored_key(), None);
+
+        // with two factors, the code dialog keeps the key; the second step, with no password,
+        // goes as it is and its token stores the key
+        let challenge = json!({ "type": "email_check", "tfa_type": "tfa_check", "secret": "s" });
+        observe(&fake, &url("/api/login"), &answer(200, &challenge));
+        assert!(lock(&fake).pending.is_some());
