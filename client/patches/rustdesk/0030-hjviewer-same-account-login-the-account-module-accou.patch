+#[test]
+fn conn_proof_bytes() {
+    let _ = hbb_common::sodiumoxide::init();
+    let (pc_pk, account_pk) = (pk_bytes(PC_PK), pk_bytes(ACCOUNT_PK));
+    let transcript =
+        conn_transcript(PC_ID, &pc_pk, &CONN_NONCE, CTL_ID, CONN_KIND, &account_pk).unwrap();
+    assert_eq!(hex::encode(&transcript), CONN_TRANSCRIPT_HEX);
+    let account = AccountKey::from_seed(&ACCOUNT_SEED).unwrap();
+    let proof = conn_proof(
+        &account,
+        PC_ID,
+        &pc_pk,
+        &CONN_NONCE,
+        CTL_ID,
+        CONN_KIND,
+        CONN_KEY_SERIAL,
+    )
+    .unwrap();
+    assert_eq!(STANDARD.encode(&proof.signature), CONN_SIG);
+    assert_eq!(
+        hex::encode(proof.write_to_bytes().unwrap()),
+        CONN_PROOF_PROTO_HEX
+    );
+    // the PC that received it accepts it against the vector list
+    let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+    let list = verify_list(&pinned, 1, &STANDARD.encode(LIST), LIST_SIG, &local(&pc_pk)).unwrap();
+    let cached = Cached { list, received: T };
+    let login = KeyLogin {
+        pc_id: PC_ID,
+        pc_pk: &pc_pk,
+        secured: true,
+        nonce: &CONN_NONCE,
+        proof: &proof,
+        my_id: CTL_ID,
+        kind: CONN_KIND,
+    };
+    assert_eq!(
+        check_key_login(&login, Some(&cached), T + 60).unwrap().name,
+        "iPhone 14 Pro"
+    );
+}
