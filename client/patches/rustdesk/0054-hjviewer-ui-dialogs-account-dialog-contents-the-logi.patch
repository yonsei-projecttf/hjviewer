+// HJViewer: a dialog's title with an icon, as the dialogs of the app's look show it
+// (common/hjv_style.dart): on the left, the icon in the accent colour (the danger colour for a
+// destructive action), the text cut with an ellipsis.
+class HjvDialogTitle extends StatelessWidget {
+  final IconData icon;
+  final String text;
+  final bool danger;
+  const HjvDialogTitle(this.icon, this.text, {Key? key, this.danger = false})
+      : super(key: key);
+
+  @override
+  Widget build(BuildContext context) {
+    final p = HjvPalette.of(context);
+    return Row(
+      children: [
+        Icon(icon, size: 22, color: danger ? p.danger : p.primary),
+        const SizedBox(width: 10),
+        Flexible(child: Text(text, overflow: TextOverflow.ellipsis)),
+      ],
+    );
+  }
+}
+
+// HJViewer: a dialog's explanation below its title: the body size in the secondary text colour.
+TextStyle hjvDialogTextStyle(BuildContext context) => TextStyle(
+    fontSize: 14, height: 1.5, color: HjvPalette.of(context).textSecondary);
+
+// HJViewer: a quiet note in a dialog: a block of the fields' grey with an icon, the text in the
+// secondary colour and an action at its right, the same in every dialog.
+Widget hjvNoteBlock(BuildContext context,
+    {IconData? icon, required Widget text, Widget? action}) {
+  final p = HjvPalette.of(context);
+  return Container(
+    padding: action == null
+        ? const EdgeInsets.all(12)
+        : const EdgeInsets.fromLTRB(12, 12, 4, 4),
+    decoration: BoxDecoration(
+      color: p.fill,
+      borderRadius: BorderRadius.circular(HjvRadius.md),
+    ),
+    child: Column(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Row(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            if (icon != null)
+              Icon(icon, size: 18, color: p.textSecondary).marginOnly(right: 8),
+            Expanded(
+              child: DefaultTextStyle.merge(
+                  style: TextStyle(
+                      fontSize: 13, height: 1.45, color: p.textSecondary),
+                  child: text),
+            ),
+          ],
+        ).marginOnly(right: action == null ? 0 : 8),
+        if (action != null)
+          Align(alignment: Alignment.centerRight, child: action),
+      ],
+    ),
+  );
+}
