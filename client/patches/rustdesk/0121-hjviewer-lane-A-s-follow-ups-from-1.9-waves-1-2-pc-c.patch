+/// The support code's result: as note() has it, with `"staff"`.
+fn note_code(result: Result<(u64, bool), Failure>) {
+    let staff = matches!(result, Ok((_, true)));
+    note("pc-code".to_owned(), result.map(|(until, _)| until));
+    let mut results = RESULTS.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(value) = results.get_mut("pc-code") {
+        if let Ok(Value::Object(mut noted)) = serde_json::from_str::<Value>(value) {
+            noted.insert("staff".to_owned(), json!(staff));
+            *value = Value::Object(noted).to_string();
+        }
+    }
+}
+
+/// Whether an exchange's answer brings a support grant for this PC that the process that
+/// registers keeps (hjviewer_access::keep_guest_pc checks it the same way).
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+fn keeps_grant(answer: &Value, id: &str, pk: &[u8], now: u64) -> bool {
+    answer.get("staff").is_some_and(|staff| {
+        let pinned = crate::hjviewer_account::trust_pubkeys();
+        crate::hjviewer_account::verify_grant(&pinned, staff, id, pk, now).is_ok()
+    })
+}
