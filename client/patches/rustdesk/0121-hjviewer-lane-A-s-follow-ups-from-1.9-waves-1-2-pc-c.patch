+/// `--hjv-e2e-support-wait <secs>`: a support code as `--hjv-e2e-support-code` makes it, then
+/// what S2 reads from the waiting room each second in this process, whose memory holds it:
+/// `hjv-e2e: support arrived: <PC ID>` (0), or `none` after `secs` (7).
+fn support_wait(secs: u64) -> i32 {
+    let made = crate::hjviewer_account::e2e_support_code();
+    if made != 0 {
+        return made;
+    }
+    let until = Instant::now() + Duration::from_secs(secs);
+    loop {
+        let arrived = crate::hjviewer_account::get_common("hjv-support-arrived").unwrap_or_default();
+        let pc = serde_json::from_str::<Value>(&arrived)
+            .ok()
+            .and_then(|a| a.get("pc").and_then(Value::as_str).map(str::to_owned));
+        if let Some(pc) = pc {
+            println!("hjv-e2e: support arrived: {pc}");
+            return 0;
+        }
+        if Instant::now() >= until {
+            println!("hjv-e2e: support arrived: none");
+            return 7;
+        }
+        std::thread::sleep(Duration::from_secs(1));
+    }
+}
