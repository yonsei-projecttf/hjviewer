+/// carryover.md (1.8.2 checkpoint): a refused PC asks again after 20 s, with the same ticket or
+/// none, before hbbs drops its connection (30 s), so that it is back soon after hbbs lets it in.
+#[test]
+fn a_refused_pc_registers_again_after_20_seconds() {
+    let sent = |t: &str| Sent {
+        t: t.into(),
+        half: NOW + 100_000,
+        at: NOW,
+    };
+    let same = held("same", NOW + 259_200, 259_200);
+    for (sent, next) in [(sent("same"), Some(&same)), (sent(""), None)] {
+        assert_eq!(reregister(Some(&sent), next, true, NOW + 19), Next::Wait);
+        assert_eq!(reregister(Some(&sent), next, true, NOW + 20), Next::Register);
+        // a registration hbbs took waits as before
+        assert_eq!(reregister(Some(&sent), next, false, NOW + 20), Next::Wait);
+    }
+}
