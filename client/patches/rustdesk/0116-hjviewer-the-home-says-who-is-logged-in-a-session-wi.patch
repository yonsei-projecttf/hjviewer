+/// U33 (login.dart, under the fields): on an installed Windows PC, that the login adds it to My
+/// PCs.
+List<Widget> hjvLoginAddsThisPc() => _accountBuild &&
+        isWindows &&
+        bind.mainIsInstalled()
+    ? [
+        Builder(
+            builder: (context) => Align(
+                alignment: Alignment.centerLeft,
+                child: Text(hjvKeepAll(_t.loginAddsThisPc),
+                        style: TextStyle(
+                            fontSize: 13,
+                            height: 1.45,
+                            color: HjvPalette.of(context).textTertiary))
+                    .marginOnly(top: 8)))
+      ]
+    : [];
+
+/// U26 (desktop_setting_page.dart): an account build's settings start with the account.
+bool hjvAccountTabFirst() => _accountBuild;
+
+/// U26: the desktop settings' tabs, the account's first in an account build.
+List<T> hjvSettingsTabs<T>(List<T> keys, T account) =>
+    hjvAccountFirst(keys, account, first: _accountBuild);
+
+/// U26 (the desktop home under the password's card, the phone's under the ID field): who is
+/// logged in, by name only (the portal ID stays in Settings → Account, since anyone at the PC
+/// sees the home); without a login, its plain [로그인] unless the window has another. A press
+/// opens Settings → Account (`onOpen`; a phone's goes to its settings tab).
+List<Widget> hjvAccountLine({VoidCallback? onOpen}) =>
+    _accountBuild && !bind.isDisableAccount()
+        ? [_HjvAccountLine(onOpen: onOpen ?? _openSettingsTab)]
+        : [];
+
+void _openSettingsTab() {
+  final bar = navigationBarKey.currentWidget;
+  if (bar is BottomNavigationBar && bar.items.isNotEmpty) {
+    bar.onTap?.call(bar.items.length - 1);
+  }
+}
+
+class _HjvAccountLine extends StatelessWidget {
+  final VoidCallback onOpen;
+  const _HjvAccountLine({required this.onOpen});
+
+  @override
+  Widget build(BuildContext context) => Obx(() {
+        final t = _t;
+        final p = HjvPalette.of(context);
+        final user = gFFI.userModel;
+        final loggedIn = user.isLogin;
+        final text = hjvAccountLineText(t,
+            loggedIn: loggedIn,
+            displayName: user.displayName.value,
+            portalId: user.userName.value);
+        final logIn = hjvAccountLineLogIn(
+            loggedIn: loggedIn,
+            homeLogsIn: hjvAccessHomeLogsIn(),
+            connectHintShown: hjvAccessConnectHintShown());
+        final avatar = loggedIn
+            ? buildAvatarWidget(
+                avatar:
+                    bind.mainResolveAvatarUrl(avatar: user.avatar.value),
+                size: 20)
+            : null;
+        // a phone's line as high as a touch target; the name on one line, cut with an ellipsis
+        return Padding(
+          padding: isDesktop
+              ? const EdgeInsets.fromLTRB(12, 0, 12, 8)
+              : const EdgeInsets.only(top: 4, bottom: 4),
+          child: Row(
+            children: [
+              Expanded(
+                child: Semantics(
+                  button: true,
+                  child: InkWell(
+                    borderRadius: BorderRadius.circular(HjvRadius.sm),
+                    onTap: onOpen,
+                    child: ConstrainedBox(
+                      constraints:
+                          BoxConstraints(minHeight: isDesktop ? 32 : 44),
+                      child: Row(
+                        children: [
+                          avatar ??
+                              Icon(Icons.person_outline_rounded,
+                                  size: 20, color: p.textTertiary),
+                          const SizedBox(width: 8),
+                          Expanded(
+                            child: Text(text,
+                                maxLines: loggedIn ? 1 : 2,
+                                overflow: TextOverflow.ellipsis,
+                                style: TextStyle(
+                                    fontSize: 13, color: p.textSecondary)),
+                          ),
+                        ],
+                      ).paddingSymmetric(horizontal: 6),
+                    ),
+                  ),
+                ),
+              ),
+              if (logIn)
+                TextButton(
+                    style: TextButton.styleFrom(
+                        padding: const EdgeInsets.symmetric(horizontal: 8),
+                        minimumSize: Size(0, isDesktop ? 32 : 44),
+                        tapTargetSize: MaterialTapTargetSize.shrinkWrap),
+                    onPressed: () => loginDialog(),
+                    child: Text(t.logIn)),
+            ],
+          ),
+        );
+      });
+}
