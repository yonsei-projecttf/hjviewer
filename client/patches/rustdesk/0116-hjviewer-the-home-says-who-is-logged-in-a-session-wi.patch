diff --git a/flutter/test/hjviewer_home_test.dart b/flutter/test/hjviewer_home_test.dart
new file mode 100644
index 0000000..b6c0e9a
--- /dev/null
+++ b/flutter/test/hjviewer_home_test.dart
@@ -0,0 +1,76 @@
+import 'package:flutter_hbb/common/hjviewer_account_texts.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// UX-H1 (U26, U33): the home's account line, the settings' tab order and the session window's
+// login texts (common/hjviewer_account_texts.dart), plain Dart without the bridge.
+
+void main() {
+  const ko = HjvTexts(true);
+  const en = HjvTexts(false);
+
+  test('the account line shows the name only, never the portal ID', () {
+    expect(
+        hjvAccountLineText(ko,
+            loggedIn: true, displayName: '홍길동', portalId: 'portal-id'),
+        '로그인됨 · 홍길동');
+    expect(
+        hjvAccountLineText(en,
+            loggedIn: true, displayName: ' 홍길동 ', portalId: 'portal-id'),
+        'Logged in · 홍길동');
+    // hjv-api's display name missing or the same as the ID: no name at all
+    for (final name in ['', 'portal-id']) {
+      expect(
+          hjvAccountLineText(ko,
+              loggedIn: true, displayName: name, portalId: 'portal-id'),
+          '로그인됨');
+    }
+    expect(
+        hjvAccountLineText(ko,
+            loggedIn: false, displayName: '', portalId: ''),
+        '로그인하지 않음');
+    expect(
+        hjvAccountLineText(en,
+            loggedIn: false, displayName: '', portalId: ''),
+        'Not logged in');
+  });
+
+  test('the account line has its [로그인] only when the window has no other', () {
+    expect(
+        hjvAccountLineLogIn(
+            loggedIn: false, homeLogsIn: false, connectHintShown: false),
+        isTrue);
+    // P1 or G2 above has the filled one, or G3 its own
+    expect(
+        hjvAccountLineLogIn(
+            loggedIn: false, homeLogsIn: true, connectHintShown: false),
+        isFalse);
+    expect(
+        hjvAccountLineLogIn(
+            loggedIn: false, homeLogsIn: false, connectHintShown: true),
+        isFalse);
+    expect(
+        hjvAccountLineLogIn(
+            loggedIn: true, homeLogsIn: false, connectHintShown: false),
+        isFalse);
+  });
+
+  test('an account build\'s settings start with the account', () {
+    const keys = ['general', 'safety', 'network', 'display', 'account', 'about'];
+    expect(hjvAccountFirst(keys, 'account', first: true),
+        ['account', 'general', 'safety', 'network', 'display', 'about']);
+    expect(hjvAccountFirst(keys, 'account', first: false), keys);
+    // no account tab (accounts disabled): as it was
+    expect(
+        hjvAccountFirst(['general', 'about'], 'account', first: true),
+        ['general', 'about']);
+  });
+
+  test('a session window\'s login points at the main window', () {
+    expect(ko.loggedInSeeMain, '로그인했습니다. 이 PC에 대한 안내는 HJViewer 주 창에 있습니다.');
+    expect(en.loggedInSeeMain,
+        "Logged in. HJViewer's main window has a note about this PC.");
+    expect(ko.loginAddsThisPc, '설치된 이 PC에서 로그인하면 이 PC가 내 PC 목록에 추가됩니다.');
+    expect(en.loginAddsThisPc,
+        'Logging in on this installed PC adds it to My PCs.');
+  });
+}
