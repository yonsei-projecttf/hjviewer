+  // U26: the home's account line ("로그인됨 · name", so that no particle follows the name)
+  String accountLoggedIn(String name) => name.isEmpty
+      ? _t('로그인됨', 'Logged in')
+      : _t('로그인됨 · $name', 'Logged in · $name');
+  String get accountNotLoggedIn => _t('로그인하지 않음', 'Not logged in');
+
+  // U33: a session window's login, whose notice about this PC the main window shows
+  String get loggedInSeeMain => _t('로그인했습니다. 이 PC에 대한 안내는 HJViewer 주 창에 있습니다.',
+      "Logged in. HJViewer's main window has a note about this PC.");
+  String get loginAddsThisPc => _t('설치된 이 PC에서 로그인하면 이 PC가 내 PC 목록에 추가됩니다.',
+      'Logging in on this installed PC adds it to My PCs.');
+}
+
+// ---- the home's account line (U26) ----
+
+/// The name the home's account line shows: the display name only, never the portal ID
+/// (hjv-api's `name`); empty when there is no other.
+String hjvAccountLineName(String displayName, String portalId) {
+  final name = displayName.trim();
+  return name == portalId.trim() ? '' : name;
 }
 
+/// The home's account line: "로그인됨 · name" or "로그인하지 않음".
+String hjvAccountLineText(HjvTexts t,
+        {required bool loggedIn,
+        required String displayName,
+        required String portalId}) =>
+    loggedIn
+        ? t.accountLoggedIn(hjvAccountLineName(displayName, portalId))
+        : t.accountNotLoggedIn;
+
+/// Whether the account line carries its plain [로그인]: without a login, when the window has no
+/// other (one [로그인] a window, 1.8.2): not while the PC home's notice has the filled one (P1, G2,
+/// `homeLogsIn`, hjvPcHomeLogsIn) or G3 shows its own (`connectHintShown`).
+bool hjvAccountLineLogIn(
+        {required bool loggedIn,
+        required bool homeLogsIn,
+        required bool connectHintShown}) =>
+    !loggedIn && !homeLogsIn && !connectHintShown;
+
+/// U26: the desktop settings' tabs with the account's first (`first`, an account build), so that
+/// the settings open on it, as a phone's do.
+List<T> hjvAccountFirst<T>(List<T> keys, T account, {required bool first}) =>
+    first && keys.contains(account)
+        ? [account, ...keys.where((k) => k != account)]
+        : keys;
+
 /// "HJViewer 관리자: <contact>", the one wording of who "관리자" is (D-1, U34): the About screen,
 /// the update screens (hjv_update_model.dart) and the PC's accept window use it.
 String hjvAdminContactText(String contact, {required bool korean}) => korean
