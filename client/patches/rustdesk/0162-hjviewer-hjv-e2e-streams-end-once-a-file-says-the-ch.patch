+            // a stream that a file can release looks for it between the messages
+            Err(_) if last_message.elapsed() < Duration::from_secs(30) => continue,
             _ => {
                 eprintln!("hjv-e2e: the session ended before a screen arrived");
                 return 1;
@@ -529,6 +537,26 @@ async fn close(stream: &mut Stream) {
     stream.send(&msg).await.ok();
 }
 
+/// `HJV_E2E_STREAM_UNTIL`: once the file it names exists, a stream ends as at its seconds, so that
+/// the E2E ends a background stream right after the checks it has to outlast.
+fn released() -> bool {
+    let released = std::env::var_os("HJV_E2E_STREAM_UNTIL")
+        .is_some_and(|file| std::path::Path::new(&file).exists());
+    if released {
+        println!("hjv-e2e: released");
+    }
+    released
+}
+
+/// How long a session waits for its next message: 30 s, or 200 ms at a time for a stream that a
+/// file can release (`released`).
+fn wait_ms(watch: &Watch) -> u64 {
+    match watch {
+        Watch::Stream(..) if std::env::var_os("HJV_E2E_STREAM_UNTIL").is_some() => 200,
+        _ => 30_000,
+    }
+}
+
