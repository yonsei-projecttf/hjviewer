-        let bytes = match timeout(30_000, stream.next()).await {
-            Ok(Some(Ok(bytes))) => bytes,
+        let bytes = match timeout(wait_ms(&watch), stream.next()).await {
+            Ok(Some(Ok(bytes))) => {
+                last_message = Instant::now();
