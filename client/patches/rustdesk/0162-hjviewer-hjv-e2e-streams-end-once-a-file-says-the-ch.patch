@@ -401,6 +403,7 @@ async fn desktop(id: String, password: String, watch: Watch) -> i32 {
     let mut video: Option<VideoHandler> = None;
     let (mut frames, mut video_bytes, mut first_frame) = (0u64, 0u64, None);
     let mut recording = false;
+    let mut last_message = Instant::now();
     loop {
         if let (Watch::Stream(secs, true), Some(start)) = (&watch, first_frame) {
             let elapsed = Instant::now().duration_since(start).as_secs_f64();
@@ -417,7 +420,7 @@ async fn desktop(id: String, password: String, watch: Watch) -> i32 {
         }
         if let (Watch::Stream(secs, _), Some(start)) = (&watch, first_frame) {
             let elapsed = std::time::Instant::now().duration_since(start).as_secs_f64();
-            if elapsed >= *secs as f64 {
+            if elapsed >= *secs as f64 || released() {
                 println!(
