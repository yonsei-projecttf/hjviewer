@@ -0,0 +1,258 @@
+// HJViewer UX-K1 (U25): the desktop by keyboard. The focus ring that the app's own widgets and the
+// theme's buttons draw, where a menu opens when a key opens it, the keys of a focused PC card and
+// the main window's request to search the PC list. Plain Flutter without the bridge, so that
+// ci.sh tests it with the web stand-in (test/hjviewer_keys_test.dart).
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import 'hjv_style.dart';
+
+/// The focus ring's width: the PC cards' hover border, which the ring matches.
+const double kHjvFocusRingWidth = 2;
+
+/// The ring's colour: the accent (4.4 to 5.6:1 on the page, the cards and the fields in both
+/// themes); on a filled accent or danger button the text colour, since the accent would vanish
+/// into the fill.
+Color hjvFocusRingColor(HjvPalette p, {bool filled = false}) =>
+    filled ? p.text : p.primary;
+
+/// The theme buttons' border (hjv_theme.dart): the ring while the button has the keyboard's focus,
+/// else `rest` (null: the shape's own, none).
+WidgetStateProperty<BorderSide?> hjvFocusSide(HjvPalette p,
+        {bool filled = false, BorderSide? rest}) =>
+    WidgetStateProperty.resolveWith((states) =>
+        states.contains(WidgetState.focused) &&
+                !states.contains(WidgetState.disabled)
+            ? BorderSide(
+                color: hjvFocusRingColor(p, filled: filled),
+                width: kHjvFocusRingWidth)
+            : rest);
+
+/// The ring drawn over a widget (a foregroundDecoration).
+BoxDecoration hjvFocusRing(BuildContext context,
+        {BorderRadius? radius, bool circle = false}) =>
+    BoxDecoration(
+      border: Border.all(
+          color: hjvFocusRingColor(HjvPalette.of(context)),
+          width: kHjvFocusRingWidth),
+      borderRadius: circle ? null : radius,
+      shape: circle ? BoxShape.circle : BoxShape.rectangle,
+    );
+
+/// No ring, in the ring's place: a Container keeps a foregroundDecoration also when the ring is
+/// off, since one that gains or loses it rebuilds its child, which drops the focus.
+const BoxDecoration kHjvNoFocusRing = BoxDecoration();
+
+/// Whether a focus that just came should show its ring: on a keyboard's (and a mouse's)
+/// interaction, not after a touch.
+bool hjvShowsFocusRing() =>
+    FocusManager.instance.highlightMode == FocusHighlightMode.traditional;
+
+/// The ring over a focusable widget the app draws itself (an InkWell's tab pill, window button,
+/// side bar row): it shows while `child` or a widget in it has the keyboard's focus. With
+/// `tooltip`, the Tooltip around it shows on that focus too (for an icon without a label), and
+/// goes with it.
+class HjvFocusRing extends StatefulWidget {
+  final Widget child;
+  final BorderRadius? radius;
+  final bool circle;
+  final bool tooltip;
+
+  const HjvFocusRing(
+      {Key? key,
+      required this.child,
+      this.radius,
+      this.circle = false,
+      this.tooltip = false})
+      : super(key: key);
+
+  @override
+  State<HjvFocusRing> createState() => _HjvFocusRingState();
+}
+
+class _HjvFocusRingState extends State<HjvFocusRing> {
+  var _ring = false;
+
+  void _onFocusChange(bool focused) {
+    final ring = focused && hjvShowsFocusRing();
+    if (ring == _ring) return;
+    setState(() => _ring = ring);
+    if (!widget.tooltip) return;
+    if (ring) {
+      context.findAncestorStateOfType<TooltipState>()?.ensureTooltipVisible();
+    } else {
+      Tooltip.dismissAllToolTips();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => Focus(
+        canRequestFocus: false,
+        skipTraversal: true,
+        onFocusChange: _onFocusChange,
+        child: Container(
+          foregroundDecoration: _ring
+              ? hjvFocusRing(context,
+                  radius: widget.radius, circle: widget.circle)
+              : kHjvNoFocusRing,
+          child: widget.child,
+        ),
+      );
+}
+
+/// Where a menu opens: upstream's showMenu calls take RelativeRect.fromLTRB(x, y, x, y) of a point.
+RelativeRect hjvMenuRect(Offset point) =>
+    RelativeRect.fromLTRB(point.dx, point.dy, point.dx, point.dy);
+
+/// The point of a menu that a key opened from `anchor` (a widget's rect on the screen): under a
+/// button's left edge, or at a card's top right corner.
+Offset hjvMenuPoint(Rect anchor, {bool topRight = false}) =>
+    topRight ? anchor.topRight : anchor.bottomLeft;
+
+/// `box`'s rect on the screen.
+Rect hjvGlobalRect(RenderBox box) => box.localToGlobal(Offset.zero) & box.size;
+
+/// The menu's place for a key that opened it from the widget `box` draws.
+RelativeRect hjvMenuRectFrom(RenderBox box, {bool topRight = false}) =>
+    hjvMenuRect(hjvMenuPoint(hjvGlobalRect(box), topRight: topRight));
+
+/// For a button that opens its menu where it was pressed (onTapDown keeps the point): an InkWell
+/// calls onTap without onTapDown when a key presses it, and the menu then opened at the screen's
+/// corner. `down` keeps the pointer's point, `take` gives it, or, without one, the point under
+/// the button `context` draws.
+class HjvMenuAnchor {
+  Offset? _pointer;
+
+  void down(Offset global) => _pointer = global;
+
+  Offset take(BuildContext context, {bool topRight = false}) {
+    final pointer = _pointer;
+    _pointer = null;
+    if (pointer != null) return pointer;
+    final box = context.findRenderObject();
+    if (box is RenderBox && box.hasSize) {
+      return hjvMenuPoint(hjvGlobalRect(box), topRight: topRight);
+    }
+    return Offset.zero;
+  }
+}
+
+/// What a key does on a focused PC card.
+enum HjvCardKey { connect, menu, select, rename, remove }
+
+/// A focused PC card's keys: Enter connects, the menu key and Shift+F10 open its menu, F2 renames
+/// and Delete removes it; while several are being chosen, Space chooses it and nothing else
+/// applies (the card has no menu then). Null for any other key or with Ctrl, Alt or the meta key.
+HjvCardKey? hjvCardKey(LogicalKeyboardKey key,
+    {bool shift = false, bool ctrlAltMeta = false, bool multiSelect = false}) {
+  if (ctrlAltMeta) return null;
+  if (multiSelect) {
+    return key == LogicalKeyboardKey.space ? HjvCardKey.select : null;
+  }
+  if (key == LogicalKeyboardKey.contextMenu ||
+      (shift && key == LogicalKeyboardKey.f10)) {
+    return HjvCardKey.menu;
+  }
+  if (shift) return null;
+  if (key == LogicalKeyboardKey.enter ||
+      key == LogicalKeyboardKey.numpadEnter) {
+    return HjvCardKey.connect;
+  }
+  if (key == LogicalKeyboardKey.f2) return HjvCardKey.rename;
+  if (key == LogicalKeyboardKey.delete) return HjvCardKey.remove;
+  return null;
+}
+
+/// A PC card's keyboard part (peer_card.dart draws the card in it): a stop of the Tab order whose
+/// keys (hjvCardKey) go to `onKey` while the card itself has the focus (a key on its ⋮ inside is
+/// the ⋮'s). `onRing` says whether the card's ring should show. The mouse's gestures stay the
+/// card's.
+class HjvPeerCardKeys extends StatefulWidget {
+  final bool multiSelect;
+  final ValueChanged<HjvCardKey> onKey;
+  final ValueChanged<bool>? onRing;
+  final Widget child;
+
+  const HjvPeerCardKeys(
+      {Key? key,
+      required this.onKey,
+      required this.child,
+      this.multiSelect = false,
+      this.onRing})
+      : super(key: key);
+
+  @override
+  State<HjvPeerCardKeys> createState() => _HjvPeerCardKeysState();
+}
+
+class _HjvPeerCardKeysState extends State<HjvPeerCardKeys> {
+  final _node = FocusNode(debugLabel: 'hjv-peer-card');
+  var _ring = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _node.addListener(_onFocus);
+  }
+
+  @override
+  void dispose() {
+    _node.removeListener(_onFocus);
+    _node.dispose();
+    super.dispose();
+  }
+
+  void _onFocus() {
+    final ring = _node.hasPrimaryFocus && hjvShowsFocusRing();
+    if (ring == _ring) return;
+    _ring = ring;
+    widget.onRing?.call(ring);
+  }
+
+  KeyEventResult _onKeyEvent(FocusNode node, KeyEvent event) {
+    if (!node.hasPrimaryFocus || event is! KeyDownEvent) {
+      return KeyEventResult.ignored;
+    }
+    final keys = HardwareKeyboard.instance;
+    final key = hjvCardKey(event.logicalKey,
+        shift: keys.isShiftPressed,
+        ctrlAltMeta:
+            keys.isControlPressed || keys.isAltPressed || keys.isMetaPressed,
+        multiSelect: widget.multiSelect);
+    if (key == null) return KeyEventResult.ignored;
+    widget.onKey(key);
+    return KeyEventResult.handled;
+  }
+
+  @override
+  Widget build(BuildContext context) =>
+      Focus(focusNode: _node, onKeyEvent: _onKeyEvent, child: widget.child);
+}
+
+/// A button that opens a menu by a key as well: Enter or Space while it has the focus calls
+/// `onKey` with its context (for HjvMenuAnchor or hjvMenuRectFrom), and the ring shows. The mouse
+/// keeps `child`'s own handling (the PC card's ⋮ opens on the pointer's release).
+Widget hjvKeyMenuButton(
+        {required Widget child,
+        required ValueChanged<BuildContext> onKey,
+        bool circle = false,
+        BorderRadius? radius}) =>
+    Builder(
+        builder: (context) => HjvFocusRing(
+              circle: circle,
+              radius: radius,
+              child: FocusableActionDetector(
+                actions: <Type, Action<Intent>>{
+                  ActivateIntent: CallbackAction<ActivateIntent>(
+                      onInvoke: (_) => onKey(context)),
+                  ButtonActivateIntent: CallbackAction<ButtonActivateIntent>(
+                      onInvoke: (_) => onKey(context)),
+                },
+                child: ExcludeFocus(child: child),
+              ),
+            ));
+
+/// The main window's Ctrl+F (⌘F on a Mac): the PC list's search field opens and takes the focus
+/// (peer_tab_page.dart's search bar listens).
+final hjvPeerSearchRequest = ValueNotifier<int>(0);
