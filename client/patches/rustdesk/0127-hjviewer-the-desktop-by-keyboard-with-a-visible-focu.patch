+/// HJViewer UX-K1: the main window's keys (main.dart's keyListenerBuilder binds them around the
+/// window): Ctrl+F (⌘F on a Mac) opens the PC list's search on the home tab, Ctrl+W (⌘W)
+/// closes the settings tab while it is the one shown.
+Map<ShortcutActivator, VoidCallback> hjvMainWindowShortcuts() {
+  if (!isDesktop) return const {};
+  String? shown() {
+    if (!Get.isRegistered<DesktopTabController>()) return null;
+    final state = Get.find<DesktopTabController>().state.value;
+    return state.selected < state.tabs.length
+        ? state.tabs[state.selected].key
+        : null;
+  }
+
+  return {
+    SingleActivator(LogicalKeyboardKey.keyF, control: !isMacOS, meta: isMacOS):
+        () {
+      if (shown() == kTabLabelHomePage) hjvPeerSearchRequest.value++;
+    },
+    SingleActivator(LogicalKeyboardKey.keyW, control: !isMacOS, meta: isMacOS):
+        () {
+      if (shown() == kTabLabelSettingPage) {
+        Get.find<DesktopTabController>().closeBy(kTabLabelSettingPage);
+      }
+    },
+  };
+}
