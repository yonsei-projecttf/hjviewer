+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common/hjv_keys.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// UX-K1 (U25), the desktop by keyboard (common/hjv_keys.dart): a focused PC card's keys, the
+// focus ring's colour and the theme buttons' ring, where a menu opens when a key opens it.
+// Plain Flutter, no bridge.
+
+double contrast(Color a, Color b) {
+  final la = a.computeLuminance();
+  final lb = b.computeLuminance();
+  final hi = la > lb ? la : lb;
+  final lo = la > lb ? lb : la;
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+Widget app(Widget child) =>
+    MaterialApp(home: Scaffold(body: Center(child: child)));
+
+void main() {
+  setUp(() => FocusManager.instance.highlightStrategy =
+      FocusHighlightStrategy.alwaysTraditional);
+  tearDown(() => FocusManager.instance.highlightStrategy =
+      FocusHighlightStrategy.automatic);
+
+  test(
+      'a focused card: Enter connects, the menu key and Shift+F10 open the menu',
+      () {
+    expect(hjvCardKey(LogicalKeyboardKey.enter), HjvCardKey.connect);
+    expect(hjvCardKey(LogicalKeyboardKey.numpadEnter), HjvCardKey.connect);
+    expect(hjvCardKey(LogicalKeyboardKey.contextMenu), HjvCardKey.menu);
+    expect(hjvCardKey(LogicalKeyboardKey.f10, shift: true), HjvCardKey.menu);
+    expect(hjvCardKey(LogicalKeyboardKey.f10), isNull);
+    expect(hjvCardKey(LogicalKeyboardKey.f2), HjvCardKey.rename);
+    expect(hjvCardKey(LogicalKeyboardKey.delete), HjvCardKey.remove);
+    expect(hjvCardKey(LogicalKeyboardKey.enter, ctrlAltMeta: true), isNull);
+    expect(hjvCardKey(LogicalKeyboardKey.space), isNull);
+  });
+
+  test('while several are chosen, Space chooses and nothing else applies', () {
+    expect(hjvCardKey(LogicalKeyboardKey.space, multiSelect: true),
+        HjvCardKey.select);
+    for (final key in [
+      LogicalKeyboardKey.enter,
+      LogicalKeyboardKey.contextMenu,
+      LogicalKeyboardKey.f2,
+      LogicalKeyboardKey.delete,
+    ]) {
+      expect(hjvCardKey(key, multiSelect: true), isNull, reason: '$key');
+    }
+  });
+
+  for (final (name, p) in [
+    ('light', HjvPalette.light),
+    ('dark', HjvPalette.dark),
+  ]) {
+    test('$name: the focus ring reaches 3:1 where it is drawn', () {
+      for (final ground in [
+        p.surface,
+        p.card,
+        p.canvas,
+        p.fill,
+        p.primarySoft,
+      ]) {
+        expect(
+            contrast(hjvFocusRingColor(p), ground), greaterThanOrEqualTo(3.0),
+            reason: '$ground');
+      }
+      // a filled button's ring: against its fill and the page around it
+      for (final ground in [p.primaryFill, p.dangerFill, p.surface, p.card]) {
+        expect(contrast(hjvFocusRingColor(p, filled: true), ground),
+            greaterThanOrEqualTo(3.0),
+            reason: '$ground');
+      }
+    });
+
+    test('$name: a theme button draws the ring only while it has the focus',
+        () {
+      final rest = BorderSide(color: p.borderStrong);
+      final side = hjvFocusSide(p, rest: rest);
+      final focused = side.resolve({WidgetState.focused});
+      expect(focused?.color, p.primary);
+      expect(focused?.width, kHjvFocusRingWidth);
+      expect(side.resolve({}), rest);
+      expect(side.resolve({WidgetState.hovered}), rest);
+      expect(side.resolve({WidgetState.focused, WidgetState.disabled}), rest);
+      expect(hjvFocusSide(p).resolve({}), isNull);
+      expect(
+          hjvFocusSide(p, filled: true).resolve({WidgetState.focused})?.color,
+          p.text);
+    });
+  }
+
+  test('a menu that a key opened: under a button, at a card\'s top right', () {
+    const rect = Rect.fromLTWH(100, 50, 40, 30);
+    expect(hjvMenuPoint(rect), const Offset(100, 80));
+    expect(hjvMenuPoint(rect, topRight: true), const Offset(140, 50));
+    expect(hjvMenuRect(const Offset(100, 80)),
+        const RelativeRect.fromLTRB(100, 80, 100, 80));
+  });
+
+  testWidgets(
+      'a pressed menu button keeps the pointer, a key gives the point under it',
+      (tester) async {
+    final anchor = HjvMenuAnchor();
