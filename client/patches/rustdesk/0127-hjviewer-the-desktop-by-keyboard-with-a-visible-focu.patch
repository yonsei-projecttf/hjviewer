+    anchor.down(const Offset(7, 9));
+    expect(anchor.take(box), const Offset(7, 9));
+    expect(anchor.take(box), rect.bottomLeft);
+  });
+
+  testWidgets(
+      'a focused card gets its keys and its ring; a key on its ⋮ stays the ⋮\'s',
+      (tester) async {
+    final keys = <HjvCardKey>[];
+    final rings = <bool>[];
+    final more = FocusNode();
+    addTearDown(more.dispose);
+    await tester.pumpWidget(app(HjvPeerCardKeys(
+      onKey: keys.add,
+      onRing: rings.add,
+      child: SizedBox(
+          width: 200,
+          height: 100,
+          child: Align(
+              alignment: Alignment.topRight,
+              child: Focus(focusNode: more, child: const SizedBox(width: 20)))),
+    )));
+    await tester.sendKeyEvent(LogicalKeyboardKey.tab);
+    await tester.pump();
+    expect(rings, [true]);
+    await tester.sendKeyEvent(LogicalKeyboardKey.enter);
+    await tester.sendKeyEvent(LogicalKeyboardKey.f2);
+    await tester.sendKeyEvent(LogicalKeyboardKey.delete);
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.shiftLeft);
+    await tester.sendKeyEvent(LogicalKeyboardKey.f10);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.shiftLeft);
+    expect(keys, [
+      HjvCardKey.connect,
+      HjvCardKey.rename,
+      HjvCardKey.remove,
+      HjvCardKey.menu,
+    ]);
+    more.requestFocus();
+    await tester.pump();
+    expect(rings, [true, false]);
+    await tester.sendKeyEvent(LogicalKeyboardKey.enter);
+    expect(keys.length, 4);
+  });
+
+  testWidgets('while several are chosen, Space chooses the focused card',
+      (tester) async {
+    final keys = <HjvCardKey>[];
+    await tester.pumpWidget(app(HjvPeerCardKeys(
+        multiSelect: true,
+        onKey: keys.add,
+        child: const SizedBox(width: 200, height: 100))));
+    await tester.sendKeyEvent(LogicalKeyboardKey.tab);
+    await tester.pump();
+    await tester.sendKeyEvent(LogicalKeyboardKey.enter);
+    await tester.sendKeyEvent(LogicalKeyboardKey.space);
+    expect(keys, [HjvCardKey.select]);
+  });
+
+  testWidgets(
+      'a menu button opens by Enter, with the ring while it has the focus',
+      (tester) async {
+    var opened = 0;
+    await tester.pumpWidget(app(hjvKeyMenuButton(
+        circle: true,
+        onKey: (_) => opened++,
+        child: InkWell(
+            onTap: () {}, child: const SizedBox(width: 28, height: 28)))));
+    BoxDecoration? ring() => tester
+        .widgetList<Container>(find.byType(Container))
+        .map((c) => c.foregroundDecoration)
+        .whereType<BoxDecoration>()
+        .where((d) => d.border != null)
+        .firstOrNull;
+    expect(ring(), isNull);
+    await tester.sendKeyEvent(LogicalKeyboardKey.tab);
+    await tester.pump();
+    expect(ring()?.shape, BoxShape.circle);
+    // the ring's rebuild keeps the focus where it was
+    await tester.sendKeyEvent(LogicalKeyboardKey.enter);
+    await tester.sendKeyEvent(LogicalKeyboardKey.space);
+    expect(opened, 2);
+  });
