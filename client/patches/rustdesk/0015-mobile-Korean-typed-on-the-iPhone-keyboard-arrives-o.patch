+          isNull);
+      // Also when the commit only ends the composing range.
+      expect(iosSoftKeyboardEdit('${filler}n', value('你')),
+          (backspaces: 1, text: '你'));
+    });
+
+    test('kana is held until it is converted', () {
+      expect(iosSoftKeyboardEdit('$filler' 'に', value('にほん', composingFrom: 0)),
+          isNull);
+      expect(iosSoftKeyboardEdit('$filler' 'に', value('日本', composingFrom: 0)),
+          (backspaces: 1, text: '日本'));
+    });
+
+    test('English letters and Return', () {
+      expect(
+          iosSoftKeyboardEdit(filler, value('a')), (backspaces: 0, text: 'a'));
+      expect(iosSoftKeyboardEdit('${filler}a', value('a\n')),
+          (backspaces: 0, text: '\n'));
+    });
+
+    test('an emoji is one Backspace and is never split', () {
+      expect(iosSoftKeyboardEdit('$filler😀', value('')),
+          (backspaces: 1, text: ''));
+      expect(iosSoftKeyboardEdit('$filler😀', value('😁')),
+          (backspaces: 1, text: '😁'));
+    });
+
+    test('the field is refilled once the filler runs low', () {
+      expect(
+          softKeyboardFillerRunsLow(TextEditingValue(text: filler)), isFalse);
+      expect(
+          softKeyboardFillerRunsLow(
+              TextEditingValue(text: filler.substring(600))),
+          isTrue);
+      expect(
+          softKeyboardFillerRunsLow(const TextEditingValue(text: '')), isTrue);
+      // Not while something is being composed.
+      expect(
+          softKeyboardFillerRunsLow(TextEditingValue(
+              text: '${filler.substring(600)}ㅎ',
+              composing: const TextRange(start: 424, end: 425))),
+          isFalse);
+    });
+
+    test('a held Backspace that deletes the filler is capped', () {
+      // A word deletion takes the typed word and the filler at once (one word
+      // to the keyboard): the remote side loses the typed word, nothing more.
+      expect(iosSoftKeyboardEdit('${filler}hello', TextEditingValue(text: '1')),
+          (backspaces: 5, text: ''));
+      expect(iosSoftKeyboardEdit('${filler}hel', const TextEditingValue()),
+          (backspaces: 3, text: ''));
+      // Held on past the typed text, each word deletion of the filler alone
+      // deletes a few remote characters.
+      expect(iosSoftKeyboardEdit(filler, const TextEditingValue(text: '')),
+          (backspaces: kMaxSoftKeyboardFillerBackspaces, text: ''));
+      expect(
+          iosSoftKeyboardEdit(
+              filler.substring(500), const TextEditingValue(text: '')),
+          (backspaces: kMaxSoftKeyboardFillerBackspaces, text: ''));
+      // Quick Backspaces that one settled edit merged all count, also where
+      // they run from the typed text into the filler.
+      expect(
+          iosSoftKeyboardEdit(
+              '${filler}X', TextEditingValue(text: filler.substring(2))),
+          (backspaces: 3, text: ''));
+      expect(
+          iosSoftKeyboardEdit(
+              '${filler}ab', TextEditingValue(text: filler.substring(3))),
+          (backspaces: 5, text: ''));
+      // One Backspace on the filler is one remote Backspace.
+      expect(
+          iosSoftKeyboardEdit(
+              filler, TextEditingValue(text: filler.substring(1))),
+          (backspaces: 1, text: ''));
+      // A long word of its own is still capped.
+      final long = 'a' * 40;
+      expect(
+          iosSoftKeyboardEdit('$filler$long', TextEditingValue(text: filler)),
+          (backspaces: kMaxSoftKeyboardBackspaces, text: ''));
+    });
+  });
+
+  group('Hangul text', () {
+    test('Hangul text', () {
+      expect(isHangulText('한글'), isTrue);
+      expect(isHangulText('ㅎㅏ'), isTrue);
+      expect(isHangulText('한a'), isFalse);
+      expect(isHangulText(''), isFalse);
+    });
+  });
+}
+
+/// The remote side's text as it replays the edits of the hidden field.
+class _Remote {
+  _Remote(this.baseline, this.diff);
+
+  String baseline;
+  final SoftKeyboardEdit? Function(String, TextEditingValue) diff;
+  String text = '';
+  int deletedBeforeStart = 0;
+
+  void type(String tail) => apply(TextEditingValue(text: '$baseline$tail'));
+
+  void apply(TextEditingValue value) {
+    final edit = diff(baseline, value);
+    if (edit == null) return;
+    baseline = value.text;
+    for (var i = 0; i < edit.backspaces; ++i) {
+      if (text.isEmpty) {
+        ++deletedBeforeStart;
+      } else {
+        text = text.substring(0, text.length - 1);
+      }
+    }
+    text += edit.text;
+  }
+}
+
+/// remote_page.dart `_handleIOSSoftKeyboardInput` before this change.
+SoftKeyboardEdit? _diffBeforeFix(String oldValue, TextEditingValue value) {
+  final newValue = value.text;
+  var i = newValue.length - 1;
+  for (; i >= 0 && newValue[i] != '1'; --i) {}
+  var j = oldValue.length - 1;
+  for (; j >= 0 && oldValue[j] != '1'; --j) {}
+  if (i < j) j = i;
+  final subNewValue = newValue.substring(j + 1);
+  final subOldValue = oldValue.substring(j + 1);
+  var common = 0;
+  for (;
+      common < subOldValue.length &&
+          common < subNewValue.length &&
+          subNewValue[common] == subOldValue[common];
+      ++common) {}
+  final newStr =
+      subNewValue.length > common ? subNewValue.substring(common) : '';
+  if (value.isComposingRangeValid &&
+      value.composing.end - value.composing.start > newStr.length) {
+    return null;
+  }
+  return (backspaces: subOldValue.length - common, text: newStr);
+}
