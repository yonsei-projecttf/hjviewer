+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/models/soft_keyboard_input.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  final filler = '1' * 1024;
+
+  TextEditingValue value(String tail, {int? composingFrom}) {
+    final text = '$filler$tail';
+    return TextEditingValue(
+      text: text,
+      composing: composingFrom == null
+          ? TextRange.empty
+          : TextRange(start: filler.length + composingFrom, end: text.length),
+    );
+  }
+
+  group('iOS Korean keyboard', () {
+    test('the rewrite steps arriving one by one send no stray 1', () {
+      // Like the test below, but without the settle delay merging the steps.
+      final remote = _Remote(filler, iosSoftKeyboardEdit)..type('ㅎ');
+      remote
+        ..apply(TextEditingValue(text: filler.substring(1)))
+        ..apply(TextEditingValue(text: filler))
+        ..apply(value('하', composingFrom: 0));
+      expect(remote.text, '하');
+      expect(remote.deletedBeforeStart, 0);
+
+      // The diff this replaces, applied to the same steps.
+      final before = _Remote(filler, _diffBeforeFix)..type('ㅎ');
+      before
+        ..apply(TextEditingValue(text: filler.substring(1)))
+        ..apply(TextEditingValue(text: filler))
+        ..apply(value('하', composingFrom: 0));
+      expect(before.text, '1하');
+      expect(before.deletedBeforeStart, 1);
+    });
+
+    test('the same after Backspaces deleted part of the filler', () {
+      final short = filler.substring(2);
+      final remote = _Remote(filler, iosSoftKeyboardEdit)
+        ..apply(TextEditingValue(text: filler.substring(1)))
+        ..apply(TextEditingValue(text: short));
+      expect(remote.deletedBeforeStart, 2);
+      remote
+        ..type('ㅎ')
+        ..apply(TextEditingValue(text: short.substring(1)))
+        ..apply(TextEditingValue(text: short))
+        ..apply(TextEditingValue(text: '$short하'));
+      expect(remote.text, '하');
+      expect(remote.deletedBeforeStart, 2);
+    });
+
+    test('a syllable the keyboard rewrote in steps is replaced once', () {
+      // Typing ㅏ after ㅎ: the keyboard removes ㅎ and one filler character,
+      // puts the filler back, then inserts 하 (rustdesk PR #15201 tests).
+      final steps = [
+        TextEditingValue(text: filler.substring(1)),
+        TextEditingValue(text: filler),
+        value('하', composingFrom: 0),
+      ];
+      // The step that also removed a filler character waits for the next.
+      expect(iosSoftKeyboardEdit('$filler' 'ㅎ', steps[0]), isNull);
+      // Settled, it is one Backspace and the new syllable.
+      expect(iosSoftKeyboardEdit('$filler' 'ㅎ', steps.last),
+          (backspaces: 1, text: '하'));
+    });
+
+    test('a word the keyboard deleted and retyped sends only the change', () {
+      // flutter/flutter#134507: typing ㅏ after 안녕ㅎ deletes the word, then
+      // inserts 안, 안녕, 안녕하.
+      expect(iosSoftKeyboardEdit('$filler안녕ㅎ', value('안녕하', composingFrom: 2)),
+          (backspaces: 1, text: '하'));
+    });
+
+    test('composing Hangul is sent, also when it is longer than the change',
+        () {
+      expect(iosSoftKeyboardEdit('$filler' 'ㅎ', value('ㅎㅏ', composingFrom: 0)),
+          (backspaces: 0, text: 'ㅏ'));
+      expect(iosSoftKeyboardEdit('$filler안녕', value('안녕하', composingFrom: 0)),
+          (backspaces: 0, text: '하'));
+    });
+
+    test('a final consonant moving to the next syllable', () {
+      expect(iosSoftKeyboardEdit('$filler한', value('하나', composingFrom: 1)),
+          (backspaces: 1, text: '하나'));
+    });
+
+    test('one filler character put back too many is not typed', () {
+      // rustdesk PR #15201 "does not send over-restored sentinel before
+      // committed Korean text": filler -> filler + '1한'.
+      final overRestored = TextEditingValue(text: '${filler}1한');
+      expect(
+          iosSoftKeyboardEdit(filler, overRestored,
+              initialFillerLength: filler.length),
+          (backspaces: 0, text: '한'));
+      // A 1 the user typed after Korean text, or while composing, is kept.
+      expect(
+          iosSoftKeyboardEdit('$filler가', TextEditingValue(text: '$filler가1'),
+              initialFillerLength: filler.length),
+          (backspaces: 0, text: '1'));
+      expect(
+          iosSoftKeyboardEdit(filler, value('1한', composingFrom: 1),
+              initialFillerLength: filler.length),
+          (backspaces: 0, text: '1한'));
