new file mode 100644
index 0000000..9aa0d45
--- /dev/null
+++ b/flutter/lib/models/soft_keyboard_input.dart
@@ -0,0 +1,117 @@
+import 'dart:math' as math;
+
+import 'package:flutter/services.dart';
+
+/// The text the soft keyboard changed in the hidden field since [oldValue],
+/// as the remote side should replay it: delete [backspaces] characters, then
+/// type [text].
+typedef SoftKeyboardEdit = ({int backspaces, String text});
+
+/// One edit never deletes more than this on the remote side. A held Backspace
+/// on iOS speeds up to deleting whole words, and the field's filler text is a
+/// single long "word" that must not turn into a thousand remote Backspaces.
+const kMaxSoftKeyboardBackspaces = 32;
+
+/// Filler characters deleted in one edit up to this many are remote
+/// Backspaces (quick Backspaces that one settled edit merged). More is a word
+/// deletion of the held iOS Backspace, and the filler is a single long word:
+/// alone it deletes this many remote characters per step; together with text
+/// typed after it (one word to the keyboard) only that text.
+const kMaxSoftKeyboardFillerBackspaces = 8;
+
+/// Diffs the hidden iOS text field.
+///
+/// [value] must be the settled field value: the iOS Korean keyboard rewrites
+/// the field in several steps for one key press (it removes the syllable and
+/// a filler character, puts the filler back, then inserts the new syllable),
+/// and diffing those steps one by one sends stray Backspaces and "1"s.
+///
+/// Returns null while a Chinese or Japanese IME composes text that is longer
+/// than what changed (pinyin, kana), so that only the converted text is sent.
+/// Hangul is sent while it is composed, as the remote side has no way to show
+/// an uncommitted syllable otherwise.
+SoftKeyboardEdit? iosSoftKeyboardEdit(String oldValue, TextEditingValue value,
+    {int? initialFillerLength}) {
+  final newValue = value.text;
+  // Should the step that removes the syllable and one filler character still
+  // arrive alone, wait for the next one, which puts the filler back.
+  final oldFiller = _fillerLength(oldValue);
+  if (oldFiller < oldValue.length &&
+      newValue.length == oldFiller - 1 &&
+      _fillerLength(newValue) == newValue.length) {
+    return null;
+  }
+  // The keyboard can also put back one filler character too many before a
+  // syllable (rustdesk PR #15201, "over-restored sentinel"). Only on a full,
+  // otherwise empty filler, so that a 1 the user typed is never dropped.
+  if (initialFillerLength != null &&
+      !value.isComposingRangeValid &&
+      oldFiller == initialFillerLength &&
+      oldFiller == oldValue.length) {
+    final newFiller = _fillerLength(newValue);
+    final tail = newValue.substring(newFiller);
+    if (newFiller > oldFiller && isHangulText(tail)) {
+      return (backspaces: 0, text: tail);
+    }
+  }
+  var common = 0;
+  final maxCommon = math.min(oldValue.length, newValue.length);
+  while (common < maxCommon &&
+      oldValue.codeUnitAt(common) == newValue.codeUnitAt(common)) {
+    ++common;
+  }
+  // Do not split a surrogate pair: replace the whole emoji.
+  if (common > 0 && _isHighSurrogate(oldValue.codeUnitAt(common - 1))) {
+    --common;
+  }
+  final text = newValue.substring(common);
+  if (value.isComposingRangeValid &&
+      value.composing.end - value.composing.start > text.length &&
+      !isHangulText(value.composing.textInside(newValue))) {
+    return null;
+  }
+  final int fillerDeleted = math.max(0, oldFiller - common);
+  final int tailDeleted =
+      oldValue.substring(math.max(common, oldFiller)).runes.length;
+  // A word deletion that took typed text with the filler deleted that text on
+  // the remote side, not what was there before it.
+  final int fillerBackspaces = fillerDeleted <= kMaxSoftKeyboardFillerBackspaces
+      ? fillerDeleted
+      : (tailDeleted > 0 ? 0 : kMaxSoftKeyboardFillerBackspaces);
+  final int deleted = tailDeleted + fillerBackspaces;
+  return (
+    backspaces: math.min(deleted, kMaxSoftKeyboardBackspaces),
+    text: text,
+  );
+}
+
+bool _isHighSurrogate(int codeUnit) => codeUnit >= 0xD800 && codeUnit <= 0xDBFF;
+
+/// Whether the hidden field should be refilled: fewer than [minimum] filler
+/// characters are left and nothing is being composed.
+bool softKeyboardFillerRunsLow(TextEditingValue value, {int minimum = 512}) =>
+    !value.isComposingRangeValid && _fillerLength(value.text) < minimum;
+
+/// The number of filler characters ('1', see remote_page.dart `initText`) the
+/// field starts with.
+int _fillerLength(String value) {
+  var n = 0;
+  while (n < value.length && value.codeUnitAt(n) == 0x31) {
+    ++n;
+  }
+  return n;
+}
+
+/// Whether [text] is non-empty and only Hangul: syllables, jamo, or the
+/// strokes of the 10-key (Cheonjiin) layout.
+bool isHangulText(String text) =>
+    text.isNotEmpty && text.runes.every(_isHangulRune);
+
+bool _isHangulRune(int rune) =>
+    (rune >= 0x1100 && rune <= 0x11FF) || // Hangul Jamo
+    (rune >= 0x3130 && rune <= 0x318F) || // Hangul Compatibility Jamo
+    (rune >= 0xA960 && rune <= 0xA97F) || // Hangul Jamo Extended-A
+    (rune >= 0xAC00 && rune <= 0xD7A3) || // Hangul Syllables
+    (rune >= 0xD7B0 && rune <= 0xD7FF) || // Hangul Jamo Extended-B
+    rune == 0x00B7 || // middle dot, a Cheonjiin stroke
+    rune == 0x2025; // two dot leader, a Cheonjiin stroke
