+/// main_get_common: "Y" while hjv-api refused the login's ticket request (or, 1.9, a waiting room
+/// request) with 401 and that login is still the app's (U68).
 const LOGIN_ENDED: &str = "hjv-access-login-ended";
 
 /// The SHA-256 of the token whose ticket request hjv-api answered with 401.
 static REFUSED_LOGIN: Mutex<Option<[u8; 32]>> = Mutex::new(None);
 
+/// The waiting room's 401 to the login of `token` (support.rs): the screens end it as the ticket
+/// request's 401 (U68), also when none of its codes is open any more (the doc 3-7, S-02).
+pub(crate) fn note_login_refused(token: &str) {
+    *REFUSED_LOGIN.lock().unwrap_or_else(|e| e.into_inner()) = Some(token_hash(token));
+}
+
 fn token_hash(token: &str) -> [u8; 32] {
     Sha256::digest(token.as_bytes()).into()
 }
