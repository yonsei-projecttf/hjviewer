+/// Whether `reply` is hjv-api's 401 to the login of `token`, which is still the app's: it ends the
+/// login as any account request's 401 does (L4, A1 on phones), by the ticket request's way (U68),
+/// also when none of its codes is open any more and no screen asks the waiting room.
+fn refused(reply: Option<&(u16, String)>, token: &str) -> bool {
+    let refused = matches!(reply, Some((401, _)));
+    if refused {
+        crate::hjviewer_access::note_login_refused(token);
+    }
+    refused
