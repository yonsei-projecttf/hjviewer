+
+// HJViewer: the phone's settings as a grouped list, on Android as on an iPhone: the canvas
+// behind, each section a card under its small grey title, settings_ui's iOS rows inside in the
+// palette's colours, and the switches in the accent colour.
+Widget _hjvSettingsList(BuildContext context,
+    {required List<AbstractSettingsSection> sections}) {
+  final p = HjvPalette.of(context);
+  final dark = Theme.of(context).brightness == Brightness.dark;
+  // the cards paint their own colour; a tile's description, which settings_ui paints in the
+  // list's colour below the tile, stays on its card
+  final theme = SettingsThemeData(
+    settingsListBackground: Colors.transparent,
+    settingsSectionBackground: Colors.transparent,
+    titleTextColor: p.textSecondary,
+    settingsTileTextColor: p.text,
+    tileDescriptionTextColor: p.textSecondary,
+    leadingIconsColor: p.textSecondary,
+    tileHighlightColor: p.hover,
+    dividerColor: p.border,
+    trailingTextColor: p.textTertiary,
+    inactiveTitleColor: p.textDisabled,
+    inactiveSubtitleColor: p.textDisabled,
+  );
+  return ColoredBox(
+    color: dark ? p.surface : p.canvas,
+    child: CupertinoTheme(
+      data: CupertinoTheme.of(context)
+          .copyWith(primaryColor: p.primary, applyThemeToAll: true),
+      child: SettingsList(
+        platform: DevicePlatform.iOS,
+        lightTheme: theme,
+        darkTheme: theme,
+        contentPadding: const EdgeInsets.only(top: 16, bottom: 8),
+        sections: [
+          for (final section in sections)
+            section is SettingsSection ? _HjvSettingsSection(section) : section,
+        ],
+      ),
+    ),
+  );
+}
+
+// HJViewer: a section of the grouped list: its title over a card that holds its rows, which
+// settings_ui's iOS section lays out (dividers between them, none for a tile that is empty).
+class _HjvSettingsSection extends AbstractSettingsSection {
+  const _HjvSettingsSection(this.section);
+
+  final SettingsSection section;
+
+  @override
+  Widget build(BuildContext context) {
+    final p = HjvPalette.of(context);
+    final title = section.title;
+    // in a section with icons, a row without one keeps the icon's room, so that the titles and
+    // the dividers start at one edge
+    final reserve =
+        section.tiles.any((t) => t is SettingsTile && t.leading != null);
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(12, 0, 12, 24),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          if (title != null)
+            Padding(
+              padding: const EdgeInsetsDirectional.only(
+                  start: 19, end: 19, bottom: 8),
+              child: DefaultTextStyle.merge(
+                style: TextStyle(
+                    fontSize: 13,
+                    fontWeight: FontWeight.w600,
+                    color: p.textTertiary),
+                child: title,
+              ),
+            ),
+          if (section.tiles.isNotEmpty)
+            LayoutBuilder(builder: (context, constraints) {
+              // a row's room for its title and value: the card less its border, the row's
+              // padding and, in a section with icons, the icon's room (24 + 12)
+              final room = constraints.maxWidth - 2 - 34 - (reserve ? 36 : 0);
+              // a value leaves the title at least 120 px (or half the row) and wraps beyond
+              final valueWidth = max(0.0, max(room / 2, room - 120));
+              return Container(
+                decoration: hjvCardDecoration(context),
+                child: ClipRRect(
+                  borderRadius: BorderRadius.circular(HjvRadius.lg - 1),
+                  child: IconTheme.merge(
+                    data: const IconThemeData(size: 24),
+                    child: SettingsSection(
+                      margin: EdgeInsetsDirectional.zero,
+                      tiles: [
+                        for (final tile in section.tiles)
+                          _hjvTile(context, tile, valueWidth, reserve)
+                      ],
+                    ),
+                  ),
+                ),
+              );
+            }),
+        ],
+      ),
+    );
+  }
+}
+
+// HJViewer: a row of the grouped list with its texts in the app's typeface (settings_ui gives
+// them none), a gap between a long title and the switch or value at the end, and the value in a
+// quieter colour, at most `valueWidth` wide. A description goes under the title, inside the row:
+// settings_ui's iOS row puts it below the row, outside its tap and press colour, with no divider
+// after it. With `reserve` a row without an icon keeps the icon's room. Off an iPhone a row is
+// 48 px high, Android's touch target, and a switch row still toggles from anywhere on it, as
+// settings_ui's Android row did.
+AbstractSettingsTile _hjvTile(BuildContext context, AbstractSettingsTile tile,
+    double valueWidth, bool reserve) {
+  if (tile is! SettingsTile) return tile;
+  final p = HjvPalette.of(context);
+  Widget font(Widget child, [TextStyle? style, TextAlign? textAlign]) =>
+      DefaultTextStyle.merge(
+          style: const TextStyle(fontFamily: kHjvFont).merge(style),
+          textAlign: textAlign,
+          child: child);
+  final description = tile.description;
+  final title = Padding(
+      padding: EdgeInsetsDirectional.only(
+          end: 12, top: isIOS ? 0 : 2, bottom: isIOS ? 0 : 2),
+      child: description == null
+          ? font(tile.title)
+          : Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                font(tile.title),
+                Padding(
+                  padding: const EdgeInsets.only(top: 2),
+                  child: font(
+                      description,
+                      TextStyle(
+                          fontSize: 13,
+                          height: 1.4,
+                          color: tile.enabled
+                              ? p.textSecondary
+                              : p.textDisabled)),
+                ),
+              ],
+            ));
+  final leading = tile.leading ?? (reserve ? const SizedBox(width: 24) : null);
+  Widget? value(double maxWidth) => tile.value == null
+      ? null
+      : ConstrainedBox(
+          constraints: BoxConstraints(maxWidth: max(0.0, maxWidth)),
+          child: font(
+              tile.value!,
+              TextStyle(
+                  fontSize: 14,
+                  color: p.textSecondary,
+                  fontFeatures: HjvText.tabular),
+              TextAlign.end));
+  switch (tile.tileType) {
+    case SettingsTileType.switchTile:
+      final onToggle = tile.onToggle;
+      final on = tile.initialValue ?? false;
+      return SettingsTile.switchTile(
+        key: tile.key,
+        initialValue: tile.initialValue,
+        onToggle: onToggle,
+        activeSwitchColor: tile.activeSwitchColor,
+        leading: leading,
+        trailing: tile.trailing,
+        title: title,
+        enabled: tile.enabled,
+        onPressed: tile.onPressed ??
+            (isIOS || onToggle == null ? null : (_) => onToggle(!on)),
+      );
+    case SettingsTileType.navigationTile:
+      // the value and the app's chevron as the trailing: settings_ui's own chevron is a
+      // CupertinoIcons glyph, a font the app does not bundle. A row that cannot be opened (a
+      // fixed option) shows no chevron.
+      final valueBox = value(valueWidth - 24);
+      return SettingsTile.navigation(
+        key: tile.key,
+        leading: leading,
+        trailing: tile.trailing ??
+            Row(mainAxisSize: MainAxisSize.min, children: [
+              if (valueBox != null) valueBox,
+              if (tile.onPressed != null)
+                Icon(Icons.chevron_right_rounded, color: p.textTertiary),
+            ]),
+        title: title,
+        onPressed: tile.onPressed,
+        enabled: tile.enabled,
+      );
+    case SettingsTileType.simpleTile:
+      return SettingsTile(
+        key: tile.key,
+        leading: leading,
+        trailing: tile.trailing,
+        value: value(valueWidth),
+        title: title,
+        onPressed: tile.onPressed,
+        enabled: tile.enabled,
+      );
+  }
+}
