+/// The answer to an account request.
+enum Answer {
+    /// hjv-api's (or the web server's) status and body
+    Http(u16, Value),
+    /// no HTTP answer: what http_request left instead, such as "hjv: account key unavailable"
+    /// from the account hook that sent nothing, or the TLS error of a certificate it refused
+    None(String),
+}
+
+impl Answer {
+    /// "HTTP 409 clock: <error>" and the like, for a line of output.
+    fn describe(&self) -> String {
+        match self {
+            Answer::Http(status, body) => {
+                let clock = if body.get("hjv").and_then(Value::as_str) == Some("clock") {
+                    " clock"
+                } else {
+                    ""
+                };
+                let error = body.get("error").and_then(Value::as_str).unwrap_or("");
+                format!("HTTP {status}{clock}: {error}")
+            }
+            Answer::None(why) => why.to_owned(),
+        }
+    }
+}
+
+/// Sends an account request the way the app's HttpService does with flutter-http-on-rust on:
+/// ui_interface::http_request (with the account hooks H13 and H14), whose result it polls.
+fn send_request(method: &str, path: &str, body: Option<String>, headers: &Value) -> String {
+    let url = format!("{}{path}", crate::ui_interface::get_api_server());
+    crate::ui_interface::http_request(url.clone(), method.to_owned(), body, headers.to_string());
+    url
+}
+
+/// The result of a request `send_request` sent, once there is one, or None after `wait`.
+fn poll_request(url: &str, wait: Duration) -> Option<Answer> {
+    let started = Instant::now();
+    loop {
+        match crate::ui_interface::get_async_http_status(url.to_owned()) {
+            Some(result) if result != " " => return Some(parse_result(result)),
+            _ if started.elapsed() > wait => return None,
+            _ => std::thread::sleep(Duration::from_millis(50)),
+        }
+    }
+}
+
+fn parse_result(result: String) -> Answer {
+    let Ok(Value::Object(answer)) = serde_json::from_str::<Value>(&result) else {
+        return Answer::None(result);
+    };
+    let status = answer
+        .get("status_code")
+        .and_then(Value::as_u64)
+        .and_then(|s| u16::try_from(s).ok());
+    let Some(status) = status else {
+        return Answer::None(result);
+    };
+    let text = answer.get("body").and_then(Value::as_str).unwrap_or("");
+    let body = serde_json::from_str(text).unwrap_or_else(|_| Value::String(text.to_owned()));
+    Answer::Http(status, body)
+}
+
+/// One account request, with a minute for its answer (two attempts of http_request's 12 s).
+fn account_request(method: &str, path: &str, body: Option<String>, headers: &Value) -> Answer {
+    let url = send_request(method, path, body, headers);
+    poll_request(&url, Duration::from_secs(60))
+        .unwrap_or_else(|| Answer::None("no answer within 60 s".to_owned()))
+}
+
+/// The app's getHttpHeaders(): the token of the login, signed on its way by the account hook.
+fn auth_headers() -> Value {
+    json!({ "Authorization": format!("Bearer {}", LocalConfig::get_option("access_token")) })
+}
+
+/// The login dialog's request (login.dart), and what the app keeps of its answer
+/// (handleLoginResponse) and asks next (`this-device`, design v3 1-2).
+fn login(user: &str, password: &str) -> i32 {
+    let id = crate::ipc::get_id();
+    let body = json!({
+        "username": user,
+        "password": password,
+        "id": id,
+        "uuid": crate::ui_interface::get_uuid(),
+        "autoLogin": true,
+        "type": "account",
+        "deviceInfo": serde_json::to_value(crate::ui_interface::get_login_device_info())
+            .unwrap_or_default(),
+    });
+    let headers = json!({ "Content-Type": "application/json" });
+    let answer = account_request("post", "/api/login", Some(body.to_string()), &headers);
+    let Answer::Http(200, body) = &answer else {
+        println!("hjv-e2e: login failed: {}", answer.describe());
+        return 1;
+    };
+    let token = body
+        .get("access_token")
+        .and_then(Value::as_str)
+        .filter(|t| !t.is_empty());
+    let (Some("access_token"), Some(token)) = (body.get("type").and_then(Value::as_str), token)
+    else {
+        println!("hjv-e2e: login failed: no token in the answer");
+        return 1;
+    };
+    let user = body.get("user").cloned().unwrap_or_else(|| json!({}));
+    LocalConfig::set_option("access_token".to_owned(), token.to_owned());
+    LocalConfig::set_option("user_info".to_owned(), user.to_string());
+    let text = |v: &Value, k: &str| v.get(k).and_then(Value::as_str).unwrap_or("").to_owned();
+    println!(
+        "hjv-e2e: logged in as {} ({}) on {id}",
+        text(&user, "display_name"),
+        text(&user, "name")
+    );
+    let hjv = body.get("hjv").cloned().unwrap_or_default();
+    match (
+        hjv.get("binding").and_then(Value::as_str),
+        hjv.get("login_at").and_then(Value::as_u64),
+    ) {
+        (Some(binding), Some(login_at)) => println!("hjv-e2e: bind request {binding}.{login_at}"),
+        _ => println!("hjv-e2e: no bind request"),
+    }
+    match account_request("get", "/api/hjv/this-device", None, &auth_headers()) {
+        Answer::Http(200, device) => {
+            println!(
+                "hjv-e2e: this device: {} {}",
+                text(&device, "status"),
+                text(&device, "pwless")
+            );
+            0
+        }
+        answer => {
+            println!("hjv-e2e: this device: {}", answer.describe());
+            1
+        }
+    }
+}
+
+/// [로그아웃] (user_model.dart logOut): `/api/logout`, whose answer the app waits two seconds for,
+/// then the token and the user go. With `during_devices` a device list request goes out first and
+/// is answered after the logout's hook ran (the test holds hjv-api meanwhile), as when the app
+/// fetches the list while its user logs out.
+fn logout(during_devices: bool) -> i32 {
+    let peers = during_devices.then(|| {
+        let url = send_request("get", PEERS, None, &auth_headers());
+        std::thread::sleep(Duration::from_millis(300));
+        url
+    });
+    let body = json!({ "id": crate::ipc::get_id(), "uuid": crate::ui_interface::get_uuid() });
+    let mut headers = auth_headers();
+    headers["Content-Type"] = json!("application/json");
+    let url = send_request("post", "/api/logout", Some(body.to_string()), &headers);
+    let wait = if during_devices { 60 } else { 2 };
+    let answer = poll_request(&url, Duration::from_secs(wait))
+        .map_or_else(|| "no answer".to_owned(), |a| a.describe());
+    LocalConfig::set_option("access_token".to_owned(), String::new());
+    LocalConfig::set_option("user_info".to_owned(), String::new());
+    println!("hjv-e2e: logged out ({answer})");
+    if let Some(url) = peers {
+        let list = poll_request(&url, Duration::from_secs(60))
+            .map_or_else(|| "no answer".to_owned(), |a| a.describe());
+        let kept = LocalConfig::get_option("hjv-my-devices");
+        println!(
+            "hjv-e2e: device list answered after the logout ({list}); hjv-my-devices {}",
+            if kept.is_empty() { "empty" } else { "kept" }
+        );
+    }
+    0
+}
+
+/// The device list request of group_model.dart.
+const PEERS: &str = "/api/peers?current=1&pageSize=100&accessible=&status=1";
+
+/// The device tab's list (group_model.dart _getPeers), 100 a page, as the app asks for it.
+fn devices() -> i32 {
+    let (mut current, mut total, mut seen) = (0u64, 0u64, 0u64);
+    loop {
+        current += 1;
+        let path = format!("/api/peers?current={current}&pageSize=100&accessible=&status=1");
+        let body = match account_request("get", &path, None, &auth_headers()) {
+            Answer::Http(200, body) => body,
+            answer => {
+                println!("hjv-e2e: devices failed: {}", answer.describe());
+                return 1;
+            }
+        };
+        if current == 1 {
+            total = body.get("total").and_then(Value::as_u64).unwrap_or(0);
+        }
+        for pc in body
+            .get("data")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+        {
+            seen += 1;
+            let text = |v: Option<&Value>| v.and_then(Value::as_str).unwrap_or("").to_owned();
+            let hjv = pc.get("hjv");
+            println!(
+                "hjv-e2e: device {} {} pwless={} pk={} kinds={} note={}",
+                text(pc.get("id")),
+                text(pc.pointer("/info/os")),
+                text(hjv.and_then(|h| h.get("pwless"))),
+                text(hjv.and_then(|h| h.get("pk"))),
+                hjv.and_then(|h| h.get("kinds"))
+                    .map_or_else(String::new, Value::to_string),
+                text(pc.get("note")),
+            );
+        }
+        if current * 100 >= total {
+            break;
+        }
+    }
+    println!("hjv-e2e: {seen} device(s)");
+    0
+}
