+/// '로그인한 기기' (design v3 1-7): the account's keys.
+fn keys() -> i32 {
+    match account_request(
+        "get",
+        "/api/hjv/keys?current=1&pageSize=100",
+        None,
+        &auth_headers(),
+    ) {
+        Answer::Http(200, body) => {
+            for key in body
+                .get("data")
+                .and_then(Value::as_array)
+                .into_iter()
+                .flatten()
+            {
+                let text = |k: &str| key.get(k).and_then(Value::as_str).unwrap_or("").to_owned();
+                println!(
+                    "hjv-e2e: key {} current={} app_name={} platform={} use={} name={}",
+                    key.get("ckid").map_or_else(String::new, Value::to_string),
+                    key.get("current")
+                        .map_or_else(String::new, Value::to_string),
+                    text("app_name"),
+                    text("platform"),
+                    key.get("use").map_or_else(String::new, Value::to_string),
+                    text("name"),
+                );
+            }
+            0
+        }
+        answer => {
+            println!("hjv-e2e: keys failed: {}", answer.describe());
+            1
+        }
+    }
+}
