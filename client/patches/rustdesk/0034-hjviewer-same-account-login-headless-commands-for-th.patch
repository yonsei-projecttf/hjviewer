+/// The commands of the account E2E (design v3 7-4); None for any other arguments. They log in and
+/// ask hjv-api as the app does: the same requests through ui_interface::http_request, where the
+/// account hooks seal, sign and observe them, so a PC's login alone gets it bound. (A session's
+/// empty password is a password-less connection: a password box ends `--hjv-e2e-screenshot`,
+/// `-stream` and `-forward` with exit code 3, an 'error' box with exit code 4.)
+///
+///     <app> --hjv-e2e-id                                  (this device's ID and public key)
+///     <app> --hjv-e2e-login <portal ID> <password>
+///     <app> --hjv-e2e-logout [--during-devices]           (with a device list request still out)
+///     <app> --hjv-e2e-devices | --hjv-e2e-keys
+///     <app> --hjv-e2e-remove <PC ID>
+///     <app> --hjv-e2e-revoke-key <ckid>
+///     <app> --hjv-e2e-option <name> [<value> [<name> <value>]...]   (the service's options, over
+///                                                         its IPC: one read, or written at once)
+///     <app> --hjv-e2e-local-option <name> [<value>]       (this device user's LocalConfig)
+///     <app> --hjv-e2e-service-password <password>         (the service's permanent password)
+///     <app> --hjv-e2e-cm             (a connection manager printing the logins it is told of)
+fn account_command(args: &[String]) -> Option<i32> {
+    Some(match args {
+        [cmd] if cmd == "--hjv-e2e-id" => {
+            let pk = Config::get_existing_key_pair()
+                .map(|(_, pk)| crate::encode64(pk))
+                .unwrap_or_else(|| "-".to_owned());
+            println!("{} {pk}", crate::ipc::get_id());
+            0
+        }
+        [cmd, user, password] if cmd == "--hjv-e2e-login" => login(user, password),
+        [cmd] if cmd == "--hjv-e2e-logout" => logout(false),
+        [cmd, flag] if cmd == "--hjv-e2e-logout" && flag == "--during-devices" => logout(true),
+        [cmd] if cmd == "--hjv-e2e-devices" => devices(),
+        [cmd, id] if cmd == "--hjv-e2e-remove" => {
+            simple_request("delete", &format!("/api/hjv/devices/{id}"), "remove")
+        }
+        [cmd] if cmd == "--hjv-e2e-keys" => keys(),
+        [cmd, ckid] if cmd == "--hjv-e2e-revoke-key" => {
+            simple_request("delete", &format!("/api/hjv/keys/{ckid}"), "revoke-key")
+        }
+        [cmd, name] if cmd == "--hjv-e2e-option" => {
+            let options = crate::ipc::get_options();
+            println!("{}", options.get(name).map(String::as_str).unwrap_or(""));
+            0
+        }
+        [cmd, pairs @ ..] if cmd == "--hjv-e2e-option" && pairs.len() % 2 == 0 => {
+            // one write, as the account hooks write theirs (an empty value removes the option)
+            let mut options = crate::ipc::get_options();
+            for pair in pairs.chunks(2) {
+                if pair[1].is_empty() {
+                    options.remove(&pair[0]);
+                } else {
+                    options.insert(pair[0].clone(), pair[1].clone());
+                }
+            }
+            crate::ui_interface::set_options(options);
+            0
+        }
+        [cmd, name] if cmd == "--hjv-e2e-local-option" => {
+            println!("{}", LocalConfig::get_option(name));
+            0
+        }
+        [cmd, name, value] if cmd == "--hjv-e2e-local-option" => {
+            LocalConfig::set_option(name.to_owned(), value.to_owned());
+            0
+        }
+        [cmd, password] if cmd == "--hjv-e2e-service-password" => {
+            if crate::ui_interface::set_permanent_password_with_result(password.to_owned()) {
+                0
+            } else {
+                eprintln!("hjv-e2e: the service did not take the password");
+                1
+            }
+        }
+        [cmd] if cmd == "--hjv-e2e-cm" => connection_manager(),
+        _ => return None,
+    })
+}
