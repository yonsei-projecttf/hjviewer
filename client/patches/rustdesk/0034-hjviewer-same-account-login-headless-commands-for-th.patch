+/// A request of the account screens without a body (hjviewer_account.dart _request).
+fn simple_request(method: &str, path: &str, what: &str) -> i32 {
+    let answer = account_request(method, path, None, &auth_headers());
+    println!("hjv-e2e: {what}: {}", answer.describe());
+    i32::from(!matches!(answer, Answer::Http(200, _)))
+}
+
+/// Stands in for the connection manager the service starts for each session (`--cm`), and prints
+/// the peer and the name the service shows for each login.
+#[tokio::main(flavor = "current_thread")]
+async fn connection_manager() -> i32 {
+    let mut incoming = match crate::ipc::new_listener("_cm").await {
+        Ok(incoming) => incoming,
+        Err(err) => {
+            eprintln!("hjv-e2e: cm: {err}");
+            return 1;
+        }
+    };
+    println!("hjv-e2e: cm listening");
+    while let Some(stream) = incoming.next().await {
+        let Ok(stream) = stream else {
+            continue;
+        };
+        tokio::spawn(async move {
+            let mut conn = crate::ipc::Connection::new(stream);
+            while let Ok(data) = conn.next().await {
+                if let Some(crate::ipc::Data::Login {
+                    peer_id,
+                    name,
+                    authorized,
+                    ..
+                }) = data
+                {
+                    println!(
+                        "hjv-e2e: cm login from {peer_id} named {name:?}, authorized {authorized}"
+                    );
+                }
+            }
+        });
+    }
+    0
+}
