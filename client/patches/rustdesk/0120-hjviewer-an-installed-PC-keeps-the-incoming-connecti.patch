+/// The answer the screens get carries these fields and no others: never the session number,
+/// the run or an address.
+#[test]
+fn the_answer_has_a_fixed_set_of_fields() {
+    let rows = fold(
+        &text(&[
+            start(RUN, 1, NOW - 100, "123456789", 42, "remote"),
+            end(RUN, 1, NOW - 50, "pc"),
+        ]),
+        RUN,
+        NOW,
+    );
+    let row = rows[0].to_json();
+    let mut keys: Vec<_> = row.as_object().unwrap().keys().cloned().collect();
+    keys.sort();
+    assert_eq!(
+        keys,
+        ["auth", "dev", "end", "id", "kind", "name", "own", "re", "t0", "t1", "ver"]
+    );
+    assert!(!row.to_string().contains("42"));
+}
