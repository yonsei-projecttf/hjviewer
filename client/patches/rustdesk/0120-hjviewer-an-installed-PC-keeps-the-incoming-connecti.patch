index 0000000..1f053a0
--- /dev/null
+++ b/src/hjviewer_incoming.rs
@@ -0,0 +1,511 @@
+//! TV-W9, the incoming connections (들어온 연결): the sessions this PC let in, for 90 days and
+//! 2,000 at most, in FILE in the config folder of the process that takes connections. Only an
+//! installed PC records (D-16: an account build's service process, as for same-account logins).
+//! Nothing here is sent anywhere: the settings read the list over the IPC (`Data::Config`
+//! "hjv-incoming", the way they read the trusted devices) through main_get_common
+//! ("hjv-incoming"), behind the unlock of the security settings.
+//!
+//! One line of JSON is written when a connection is let in (`"e":"s"`) and one when it closes
+//! (`"e":"e"`); reading folds them. A connection's lines share its process's run and its number in
+//! that run, so a start without an end is `open` in the process that wrote it and `unknown` (the PC
+//! was off or restarted) in any later one. A reconnect of the same session (the same peer ID,
+//! session number and kind within MERGE_SECS of a line that ended `lost`) continues that line.
+//!
+//! What is kept: when, the peer's ID and the name it sent (none for a `staff` row, S-05), the
+//! signed list's device name and masked owner for a same-account row, the connection manager's
+//! mark (`same-account`, `staff`, `unverified-name` or none), how it got in, the kind, how it
+//! ended, and the session number (only to fold reconnects; never in the answer). No addresses, no
+//! passwords or their hashes, no file names, no contents; refused attempts are not written.
+//!
+//! The answer, newest first: `{"on":true,"rows":[{"t0":<Unix s>,"t1":<Unix s>|null,"id":"…",
+//! "name":"…","dev":"…","own":"…","ver":"same-account"|"staff"|"unverified-name"|"","auth":
+//! "account"|"recent"|"otp"|"permanent"|"click"|"switch"|"","kind":"remote"|"file"|"camera"|
+//! "terminal"|"forward","end":"peer"|"pc"|"idle"|"service"|"switch"|"scope"|"revoked"|"lost"|
+//! "other"|"unknown"|"open","re":<reconnects>}]}`; `"on":false` (and no rows) where this process
+//! does not record. The screens get `{"error":"ipc"}` when the service did not answer.
+
+use hbb_common::config::Config;
+use serde_derive::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{
+    collections::{HashMap, HashSet},
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Mutex,
+    },
+};
+
+/// The list's file, in the service's config folder (Config::path).
+pub(crate) const FILE: &str = "hjv-incoming.jsonl";
+/// main_get_common's key, and the IPC's `Data::Config` name.
+pub(crate) const KEY: &str = "hjv-incoming";
+const KEEP_SECS: u64 = 90 * 86_400;
+const KEEP_ROWS: usize = 2_000;
+const MERGE_SECS: u64 = 120;
+/// The file is rewritten without what is past keeping at the first write and then once a day,
+/// or sooner after this many lines.
+const COMPACT_SECS: u64 = 86_400;
+const COMPACT_LINES: usize = 2 * KEEP_ROWS;
+/// The name a peer sent, and its ID, are cut to this many characters.
+const MAX_NAME: usize = 64;
+const MAX_ID: usize = 32;
+/// A line longer than this is none of ours.
+const MAX_LINE: usize = 4096;
+const VERSION: u32 = 1;
+
+/// A connection's handle on its row: empty until the connection is let in, and again once its end
+/// is written.
+#[derive(Debug, Default)]
+pub(crate) struct Row {
+    key: Option<u64>,
+    /// let in by the session's memory of its one-time password (`is_recent_session`)
+    recent: bool,
+}
+
+impl Row {
+    /// The connection got in as a reconnect of the same session (connection.rs).
+    pub(crate) fn set_recent(&mut self) {
+        self.recent = true;
+    }
+
+    pub(crate) fn recent(&self) -> bool {
+        self.recent
+    }
+}
+
+/// What a connection that was let in tells (connection/hjv_account.rs fills it from the one proof
+/// record and the connection manager's mark).
+pub(crate) struct Start<'a> {
+    pub peer_id: &'a str,
+    /// the name the peer sent; not kept for a `staff` row
+    pub name: &'a str,
+    /// the signed list's device name and masked owner, for a same-account row
+    pub device: &'a str,
+    pub owner: &'a str,
+    /// the connection manager's mark (hjviewer_cm), "" for none
+    pub mark: &'a str,
+    pub auth: &'static str,
+    /// connection.rs's audit type: 0 remote, 1 file transfer, 2 port forward, 3 camera, 4 terminal
+    pub kind: u8,
+    pub session_id: u64,
+}
+
+/// Whether this process records: an installed PC's service, in an account build (D-16).
+pub(crate) fn enabled() -> bool {
+    crate::hjviewer_account::pc_capable()
+}
+
+/// This process's run, which tells its open rows from those an earlier process left.
+fn run() -> &'static str {
+    lazy_static::lazy_static! {
+        static ref RUN: String = format!("{:016x}", hbb_common::rand::random::<u64>());
+    }
+    &RUN
+}
+
+static NEXT: AtomicU64 = AtomicU64::new(1);
+
+/// A connection was let in (after its logon response's audit line): writes its start.
+pub(crate) fn started(row: &mut Row, start: Start) {
+    if row.key.is_some() || !enabled() {
+        return;
+    }
+    let n = NEXT.fetch_add(1, Ordering::Relaxed);
+    row.key = Some(n);
+    let staff = start.mark == crate::hjviewer_cm::STAFF;
+    let line = Line {
+        v: VERSION,
+        e: "s".to_owned(),
+        r: run().to_owned(),
+        n,
+        t: unix_now(),
+        id: clean(start.peer_id, MAX_ID),
+        name: if staff {
+            String::new()
+        } else {
+            clean(start.name, MAX_NAME)
+        },
+        dev: clean(start.device, MAX_NAME),
+        own: clean(start.owner, MAX_NAME),
+        ver: known(start.mark, &MARKS),
+        auth: start.auth.to_owned(),
+        kind: kind_name(start.kind).to_owned(),
+        sid: start.session_id,
+        end: String::new(),
+    };
+    append(&line);
+}
+
+/// The connection closed (on_close, once): writes its end. Nothing for a connection that was never
+/// let in.
+pub(crate) fn ended(row: &mut Row, reason: &str) {
+    let Some(n) = row.key.take() else {
+        return;
+    };
+    let line = Line {
+        v: VERSION,
+        e: "e".to_owned(),
+        r: run().to_owned(),
+        n,
+        t: unix_now(),
+        end: end_of(reason).to_owned(),
+        ..Default::default()
+    };
+    append(&line);
+}
+
+/// The IPC's answer (ipc.rs `Data::Config` "hjv-incoming"), in the process that records.
+pub(crate) fn list_json() -> String {
+    if !enabled() {
+        return json!({ "on": false, "rows": [] }).to_string();
+    }
+    let text = std::fs::read_to_string(Config::path(FILE)).unwrap_or_default();
+    let rows: Vec<Value> = fold(&text, run(), unix_now())
+        .iter()
+        .map(Entry::to_json)
+        .collect();
+    json!({ "on": true, "rows": rows }).to_string()
+}
+
+/// main_get_common "hjv-incoming": the service's list over the IPC, `{"error":"ipc"}` when it did
+/// not answer; None for any other key, on phones and in a build that is not an account build.
+pub(crate) fn get_common(key: &str) -> Option<String> {
+    if key != KEY || !crate::hjviewer_account::enabled() {
+        return None;
+    }
+    #[cfg(any(target_os = "android", target_os = "ios"))]
+    return None;
+    #[cfg(not(any(target_os = "android", target_os = "ios")))]
+    {
+        // the IPC call starts a runtime of its own, so it runs off the caller's thread
+        let answer = std::thread::spawn(|| crate::ipc::get_config(KEY))
+            .join()
+            .ok()
+            .and_then(Result::ok)
+            .flatten();
+        Some(answer.unwrap_or_else(|| json!({ "error": "ipc" }).to_string()))
+    }
+}
+
+/// How on_close's reason ended the session (design w7-w9 3-3).
+fn end_of(reason: &str) -> &'static str {
+    match reason {
+        "" | "End" | "web console" => "other",
+        "Peer close" => "peer",
+        "connection manager" | "connection manager window closed" => "pc",
+        "auto disconnect" => "idle",
+        "stop service" => "service",
+        "switch sides" => "switch",
+        "Session scope violation" => "scope",
+        "hjv: account key no longer trusted" => "revoked",
+        _ if reason.starts_with("connection manager error") => "other",
+        // Timeout, Reset by the peer and the stream's errors
+        _ => "lost",
+    }
+}
+
+fn kind_name(kind: u8) -> &'static str {
+    match kind {
+        1 => "file",
+        2 => "forward",
+        3 => "camera",
+        4 => "terminal",
+        _ => "remote",
+    }
+}
+
+const MARKS: [&str; 3] = [
+    crate::hjviewer_cm::SAME_ACCOUNT,
+    crate::hjviewer_cm::STAFF,
+    crate::hjviewer_cm::UNVERIFIED_NAME,
+];
+
+/// `value` if it is one of `known`, else "".
+fn known(value: &str, known: &[&str]) -> String {
+    if known.contains(&value) {
+        value.to_owned()
+    } else {
+        String::new()
+    }
+}
+
+/// Without control, format (zero-width, bidi) and line or paragraph separator characters, at most
+/// `max` characters.
+fn clean(s: &str, max: usize) -> String {
+    s.chars()
+        .filter(|&c| {
+            !(c.is_control()
+                || ('\u{200B}'..='\u{200F}').contains(&c)
+                || ('\u{2028}'..='\u{202E}').contains(&c)
+                || ('\u{2060}'..='\u{2069}').contains(&c)
+                || matches!(c, '\u{FEFF}' | '\u{180E}' | '\u{061C}'))
+        })
+        .take(max)
+        .collect()
+}
+
+fn unix_now() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// One line of the file.
+#[derive(Debug, Default, Clone, Serialize, Deserialize)]
+struct Line {
+    v: u32,
+    /// "s" a start, "e" an end
+    e: String,
+    /// the writing process's run, and the connection's number in it
+    r: String,
+    n: u64,
+    t: u64,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    id: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    name: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    dev: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    own: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    ver: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    auth: String,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    kind: String,
+    #[serde(default, skip_serializing_if = "is_zero")]
+    sid: u64,
+    #[serde(default, skip_serializing_if = "String::is_empty")]
+    end: String,
+}
+
+fn is_zero(n: &u64) -> bool {
+    *n == 0
+}
+
+fn parse(line: &str) -> Option<Line> {
+    if line.len() > MAX_LINE {
+        return None;
+    }
+    let line: Line = serde_json::from_str(line).ok()?;
+    (line.v == VERSION && matches!(line.e.as_str(), "s" | "e")).then_some(line)
+}
+
+/// A row as the screens get it: one connection, or a session's connections that reconnected.
+#[derive(Debug, Clone, PartialEq)]
+struct Entry {
+    t0: u64,
+    t1: Option<u64>,
+    id: String,
+    name: String,
+    dev: String,
+    own: String,
+    ver: String,
+    auth: String,
+    kind: String,
+    sid: u64,
+    end: String,
+    re: u32,
+    /// the connections in it, by (run, number)
+    keys: Vec<(String, u64)>,
+}
+
+impl Entry {
+    /// The fields the screens get; never `sid` or the keys.
+    fn to_json(&self) -> Value {
+        json!({
+            "t0": self.t0,
+            "t1": self.t1,
+            "id": self.id,
+            "name": self.name,
+            "dev": self.dev,
+            "own": self.own,
+            "ver": self.ver,
+            "auth": self.auth,
+            "kind": self.kind,
+            "end": self.end,
+            "re": self.re,
+        })
+    }
+
+    /// Whether `next` is a reconnect of this row's session (W9-D2).
+    fn continued_by(&self, next: &Entry) -> bool {
+        self.sid != 0
+            && self.end == "lost"
+            && self.id == next.id
+            && self.sid == next.sid
+            && self.kind == next.kind
+            && self
+                .t1
+                .is_some_and(|t1| next.t0 >= t1 && next.t0 - t1 <= MERGE_SECS)
+    }
+
+    /// Still listed at `now`: open, or ended (begun, without an end) within KEEP_SECS.
+    fn kept_at(&self, now: u64) -> bool {
+        self.end == "open" || self.t1.unwrap_or(self.t0).saturating_add(KEEP_SECS) >= now
+    }
+}
+
+/// The file's lines as rows, newest first, at most KEEP_ROWS and none past KEEP_SECS; `run` is
+/// this process's. Lines that do not parse are left out.
+fn fold(text: &str, run: &str, now: u64) -> Vec<Entry> {
+    let mut starts = Vec::new();
+    let mut ends: HashMap<(String, u64), (u64, String)> = HashMap::new();
+    let mut seen = HashSet::new();
+    for line in text.lines().filter_map(parse) {
+        let key = (line.r.clone(), line.n);
+        if line.e == "s" {
+            // a key starts once
+            if seen.insert(key) {
+                starts.push(line);
+            }
+        } else {
+            ends.entry(key).or_insert((line.t, line.end));
+        }
+    }
+    starts.sort_by_key(|line| line.t);
+    let mut rows: Vec<Entry> = Vec::new();
+    // the newest row of each (id, sid, kind), by its index in rows
+    let mut last: HashMap<(String, u64, String), usize> = HashMap::new();
+    for line in starts {
+        let key = (line.r, line.n);
+        let (t1, end) = match ends.remove(&key) {
+            Some((t, end)) => (Some(t), known(&end, &ENDS)),
+            None if key.0 == run => (None, "open".to_owned()),
+            None => (None, "unknown".to_owned()),
+        };
+        let entry = Entry {
+            t0: line.t,
+            t1,
+            id: line.id,
+            name: line.name,
+            dev: line.dev,
+            own: line.own,
+            ver: known(&line.ver, &MARKS),
+            auth: known(&line.auth, &AUTHS),
+            kind: known(&line.kind, &KINDS),
+            sid: line.sid,
+            end: if end.is_empty() { "other".to_owned() } else { end },
+            re: 0,
+            keys: vec![key],
+        };
+        let same = (entry.id.clone(), entry.sid, entry.kind.clone());
+        match last.get(&same).map(|&i| &mut rows[i]) {
+            Some(row) if row.continued_by(&entry) => {
+                row.t1 = entry.t1;
+                row.end = entry.end;
+                row.re += 1;
+                row.keys.extend(entry.keys);
+            }
+            _ => {
+                last.insert(same, rows.len());
+                rows.push(entry);
+            }
+        }
+    }
+    rows.retain(|row| row.kept_at(now));
+    rows.reverse();
+    rows.truncate(KEEP_ROWS);
+    rows
+}
+
+const ENDS: [&str; 9] = [
+    "peer", "pc", "idle", "service", "switch", "scope", "revoked", "lost", "other",
+];
+const AUTHS: [&str; 6] = ["account", "recent", "otp", "permanent", "click", "switch"];
+const KINDS: [&str; 5] = ["remote", "file", "camera", "terminal", "forward"];
+
+/// The file without what fold() no longer lists: the lines of the rows it keeps, in their order.
+fn compact(text: &str, run: &str, now: u64) -> String {
+    let kept: HashSet<(String, u64)> = fold(text, run, now)
+        .into_iter()
+        .flat_map(|row| row.keys)
+        .collect();
+    let mut out = String::new();
+    for line in text.lines() {
+        if parse(line).is_some_and(|l| kept.contains(&(l.r, l.n))) {
+            out.push_str(line);
+            out.push('\n');
+        }
+    }
+    out
+}
+
+/// When the file was last compacted by this process, and the lines it wrote since.
+struct Writer {
+    compacted: Option<u64>,
+    lines: usize,
+}
+
+static WRITER: Mutex<Writer> = Mutex::new(Writer {
+    compacted: None,
+    lines: 0,
+});
+
+/// Adds a line to the file, after a compaction when one is due. A failure is logged and the
+/// connection goes on.
+fn append(line: &Line) {
+    let Ok(mut text) = serde_json::to_string(line) else {
+        return;
+    };
+    text.push('\n');
+    let path = Config::path(FILE);
+    let mut writer = WRITER.lock().unwrap_or_else(|e| e.into_inner());
+    let now = unix_now();
+    let due = writer
+        .compacted
+        .map_or(true, |at| now.saturating_sub(at) >= COMPACT_SECS || now < at)
+        || writer.lines >= COMPACT_LINES;
+    if due {
+        let old = std::fs::read_to_string(&path).unwrap_or_default();
+        if !old.is_empty() {
+            if let Err(err) = replace(&path, compact(&old, run(), now).as_bytes()) {
+                hbb_common::throttled_log!(
+                    std::time::Duration::from_secs(3600),
+                    warn,
+                    "hjv: incoming connections: could not rewrite the list: {err}"
+                );
+            }
+        }
+        writer.compacted = Some(now);
+        writer.lines = 0;
+    }
+    match add(&path, text.as_bytes()) {
+        Ok(()) => writer.lines += 1,
+        Err(err) => hbb_common::throttled_log!(
+            std::time::Duration::from_secs(3600),
+            warn,
+            "hjv: incoming connections: could not write the list: {err}"
+        ),
+    }
+}
+
+/// Appends to the file, made with the owner's access only on Unix (the service's config folder
+/// keeps other users out on Windows).
+fn add(path: &std::path::Path, data: &[u8]) -> std::io::Result<()> {
+    use std::io::Write;
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let mut options = std::fs::OpenOptions::new();
+    options.append(true).create(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    options.open(path)?.write_all(data)
+}
+
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+fn replace(path: &std::path::Path, data: &[u8]) -> std::io::Result<()> {
+    crate::hjviewer_account::write_private(path, data)
+}
+
+#[cfg(any(target_os = "android", target_os = "ios"))]
+fn replace(_path: &std::path::Path, _data: &[u8]) -> std::io::Result<()> {
+    // phones take no connections that record (enabled() is false there)
+    Ok(())
+}
