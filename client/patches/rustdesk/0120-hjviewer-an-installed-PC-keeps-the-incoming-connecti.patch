+/// W9-D5: what a peer sent is cut and left without control or format characters.
+#[test]
+fn a_peers_name_and_id_are_cleaned_and_cut() {
+    assert_eq!(clean("a\nb\u{202E}c\u{200B}d\te", 64), "abcde");
+    assert_eq!(clean(&"가".repeat(70), MAX_NAME).chars().count(), 64);
+    assert_eq!(clean(&"1".repeat(40), MAX_ID).len(), 32);
+}
