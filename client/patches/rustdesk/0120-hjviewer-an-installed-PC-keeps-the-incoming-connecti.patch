+/// A file that cannot be written does not stop the connection, and on Unix a new file is the
+/// owner's alone.
+#[test]
+fn writing_fails_quietly_and_the_file_is_private() {
+    let dir = std::env::temp_dir().join(format!("hjv-incoming-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join(FILE);
+    add(&path, b"x\n").unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mode = std::fs::metadata(&path).unwrap().permissions().mode();
+        assert_eq!(mode & 0o777, 0o600);
+    }
+    // a directory where the file should be
+    assert!(add(&dir, b"x\n").is_err());
+    std::fs::remove_dir_all(&dir).ok();
+}
