+/// Design w7-w9 3-3: every reason on_close is called with, and what it does not know.
+#[test]
+fn how_a_session_ended_follows_on_closes_reason() {
+    for (reason, value) in [
+        ("Peer close", "peer"),
+        ("connection manager", "pc"),
+        ("connection manager window closed", "pc"),
+        ("auto disconnect", "idle"),
+        ("stop service", "service"),
+        ("switch sides", "switch"),
+        ("Session scope violation", "scope"),
+        ("hjv: account key no longer trusted", "revoked"),
+        ("Timeout", "lost"),
+        ("Reset by the peer", "lost"),
+        ("Connection reset by peer (os error 104)", "lost"),
+        ("End", "other"),
+        ("web console", "other"),
+        ("connection manager error: broken pipe", "other"),
+        ("", "other"),
+    ] {
+        assert_eq!(end_of(reason), value, "{reason}");
+    }
+}
+
+/// A start and its end make one row; a start without an end is open in the process that wrote
+/// it and unknown in a later one; lines that are not ours are left out; the newest comes first.
+#[test]
+fn the_lines_fold_into_rows_newest_first() {
+    let lines = text(&[
+        start(OLD, 1, NOW - 600, "111", 7, "remote"),
+        "not json".into(),
+        r#"{"v":2,"e":"s","r":"x","n":1,"t":1}"#.into(),
+        start(RUN, 1, NOW - 300, "222", 8, "file"),
+        end(RUN, 1, NOW - 60, "peer"),
+        start(RUN, 2, NOW - 10, "333", 9, "remote"),
+    ]);
+    let rows = fold(&lines, RUN, NOW);
+    let got: Vec<_> = rows
+        .iter()
+        .map(|r| (r.id.as_str(), r.end.as_str(), r.t1))
+        .collect();
+    assert_eq!(
+        got,
+        [
+            ("333", "open", None),
+            ("222", "peer", Some(NOW - 60)),
+            ("111", "unknown", None)
+        ]
+    );
+}
+
+/// W9-D2: a reconnect of the same session within two minutes of a lost connection continues its
+/// row; later, of another kind or session, or after another end, it is a row of its own.
+#[test]
+fn a_reconnect_of_the_same_session_continues_its_row() {
+    let lost = |extra: Vec<String>| {
+        let mut lines = vec![
+            start(RUN, 1, NOW - 1000, "111", 7, "remote"),
+            end(RUN, 1, NOW - 900, "lost"),
+        ];
+        lines.extend(extra);
+        fold(&text(&lines), RUN, NOW)
+    };
+    let rows = lost(vec![
+        start(RUN, 2, NOW - 780, "111", 7, "remote"),
+        end(RUN, 2, NOW - 700, "peer"),
+    ]);
+    assert_eq!(rows.len(), 1);
+    assert_eq!(
+        (rows[0].t0, rows[0].t1, rows[0].end.as_str(), rows[0].re),
+        (NOW - 1000, Some(NOW - 700), "peer", 1)
+    );
+    for (n, t, id, sid, kind) in [
+        (2, NOW - 779, "111", 7, "remote"),
+        (2, NOW - 800, "111", 7, "file"),
+        (2, NOW - 800, "111", 8, "remote"),
+        (2, NOW - 800, "999", 7, "remote"),
+    ] {
+        assert_eq!(lost(vec![start(RUN, n, t, id, sid, kind)]).len(), 2);
+    }
+    let rows = fold(
+        &text(&[
+            start(RUN, 1, NOW - 1000, "111", 7, "remote"),
+            end(RUN, 1, NOW - 900, "peer"),
+            start(RUN, 2, NOW - 850, "111", 7, "remote"),
+        ]),
+        RUN,
+        NOW,
+    );
+    assert_eq!(rows.len(), 2);
+}
+
+/// W9-D3: 90 days and 2,000 rows; an open row stays whatever its age, and the compacted file
+/// keeps exactly the lines of the rows still listed.
+#[test]
+fn the_list_keeps_90_days_and_2000_rows() {
+    let mut lines = vec![
+        start(OLD, 1, NOW - KEEP_SECS - 86_400, "old", 1, "remote"),
+        end(OLD, 1, NOW - KEEP_SECS - 86_400 + 60, "peer"),
+        start(RUN, 1, NOW - KEEP_SECS - 86_400, "open", 2, "remote"),
+    ];
+    for n in 0..(KEEP_ROWS as u64 + 5) {
+        lines.push(start(RUN, 10 + n, NOW - 50_000 + n, "x", 0, "remote"));
+    }
+    let all = text(&lines);
+    let rows = fold(&all, RUN, NOW);
+    assert_eq!(rows.len(), KEEP_ROWS);
+    assert!(rows.iter().all(|r| r.id != "old"));
+    // the 2,000 newest
+    assert_eq!(rows.last().unwrap().t0, NOW - 50_000 + 5);
+    let compacted = compact(&all, RUN, NOW);
+    assert_eq!(compacted.lines().count(), KEEP_ROWS);
+    assert_eq!(fold(&compacted, RUN, NOW), rows);
+    // with fewer rows the open one stays
+    let few = text(&lines[..4]);
+    let rows = fold(&few, RUN, NOW);
+    assert_eq!(
+        rows.iter().map(|r| r.id.as_str()).collect::<Vec<_>>(),
+        ["x", "open"]
+    );
+    assert_eq!(compact(&few, RUN, NOW).lines().count(), 2);
+}
