+      expect(tester.widget<Icon>(find.byIcon(Icons.error_outline_rounded)).color,
+          p.dangerText);
+      // the close x: 18 px in textTertiary, a 32 px target on a desktop
+      final x = tester.widget<Icon>(find.byIcon(Icons.close_rounded));
+      expect(x.color, p.textTertiary);
+      expect(tester.getSize(find.byType(IconButton)), const Size(32, 32));
+      expect(tester.widget<IconButton>(find.byType(IconButton)).iconSize, 18);
+    });
