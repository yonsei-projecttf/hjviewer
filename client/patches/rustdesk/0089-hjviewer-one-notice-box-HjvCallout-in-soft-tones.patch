+/// The tone of an HjvCallout: info (the accent), success, warning, danger, and neutral (the
+/// fields' grey, hjvNoteBlock's).
+enum HjvTone { info, success, warning, danger, neutral }
+
+/// An HjvCallout's colours in `tone`: its background (on the canvas a card, which the border sets
+/// off), its icon, its text and its actions' text. The icon and the actions take the tone's text
+/// colour, as the tone's own colour does not reach 3:1 on its soft background in the light theme.
+({Color back, Color icon, Color text, Color action}) hjvToneColors(
+    HjvPalette p, HjvTone tone,
+    {bool onCanvas = false}) {
+  final (soft, strong) = switch (tone) {
+    HjvTone.info => (p.infoSoft, p.infoText),
+    HjvTone.success => (p.successSoft, p.successText),
+    HjvTone.warning => (p.warningSoft, p.warningText),
+    HjvTone.danger => (p.dangerSoft, p.dangerText),
+    HjvTone.neutral => (p.fill, p.primaryStrong),
+  };
+  return (
+    back: onCanvas ? p.card : soft,
+    icon: tone == HjvTone.neutral ? p.textSecondary : strong,
+    text: tone == HjvTone.danger ? p.text : p.textSecondary,
+    action: strong,
+  );
+}
+
+/// The buttons that HjvCallout stacks (`stacked`), as P1 had them in the home's 200 px pane: at
+/// least 34 high, growing with a label of two lines.
+const _kHjvStackedButton = ButtonStyle(
+  minimumSize: WidgetStatePropertyAll(Size(0, 34)),
+  padding:
+      WidgetStatePropertyAll(EdgeInsets.symmetric(horizontal: 8, vertical: 6)),
+);
+
+/// A notice in a box, the one look of the app's (U49): the medium radius, 12 inside, an optional
+/// 18 px icon in the tone's colour 8 before the text, an optional title (13/600 in the text
+/// colour; `titleOneLine`: one line, whole in its tooltip), the text (13/1.45 in the secondary
+/// colour, danger's in the text colour; Korean breaks at spaces), the actions (TextButtons) at
+/// the right of the text while it fits on one line beside them, else below it at the right, and
+/// an optional close x (18 px, textTertiary, a 32 px target on a desktop, 48 on a phone).
+/// `stacked`: the actions below at the box's width instead, each at least 34 high (the desktop
+/// home's 200 px pane), any button kind. The background: the tone's soft one, neutral's the
+/// fields' grey; `onCanvas` (on the canvas, where the grey does not show): a card with a border.
+/// High contrast adds a border. hjvNoteBlock (dialog.dart) is its neutral and warning tones.
+class HjvCallout extends StatelessWidget {
+  final String text;
+  final Widget? _body;
+  final HjvTone tone;
+  final IconData? icon;
+  final String? title;
+  final List<Widget> actions;
+  final VoidCallback? onClose;
+  final bool stacked;
+  final bool onCanvas;
+  final bool titleOneLine;
+
+  /// the close x's tooltip (default: the platform's "Close")
+  final String? closeTooltip;
+
+  const HjvCallout(
+      {super.key,
+      required this.text,
+      this.tone = HjvTone.neutral,
+      this.icon,
+      this.title,
+      this.actions = const [],
+      this.onClose,
+      this.stacked = false,
+      this.onCanvas = false,
+      this.titleOneLine = false,
+      this.closeTooltip})
+      : _body = null;
+
+  /// A widget of its own in the text's place, drawn in the text's style (hjvNoteBlock's text, a
+  /// text with a tooltip, a selectable one).
+  const HjvCallout.rich(
+      {super.key,
+      required Widget body,
+      this.tone = HjvTone.neutral,
+      this.icon,
+      this.title,
+      this.actions = const [],
+      this.onClose,
+      this.stacked = false,
+      this.onCanvas = false,
+      this.titleOneLine = false,
+      this.closeTooltip})
+      : text = '',
+        _body = body;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final p = HjvPalette.of(context);
+    final c = hjvToneColors(p, tone, onCanvas: onCanvas);
+    final phone = theme.platform == TargetPlatform.android ||
+        theme.platform == TargetPlatform.iOS;
+    final highContrast = MediaQuery.maybeHighContrastOf(context) ?? false;
+    final hasText = _body != null || text.isNotEmpty;
+    final inline = actions.isNotEmpty && !stacked;
+    final heading = title == null
+        ? null
+        : Text(hjvKeepAll(title!),
+            maxLines: titleOneLine ? 1 : null,
+            overflow: titleOneLine ? TextOverflow.ellipsis : null,
+            style: TextStyle(
+                fontSize: 13,
+                fontWeight: FontWeight.w600,
+                height: 1.35,
+                color: p.text));
+    final lead = Row(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        if (icon != null)
+          Padding(
+              padding: const EdgeInsets.only(right: 8),
+              child: Icon(icon, size: 18, color: c.icon)),
+        Expanded(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              if (heading != null)
+                titleOneLine
+                    // the title reads whole to a screen reader all the same
+                    ? Tooltip(
+                        message: title, excludeFromSemantics: true, child: heading)
+                    : heading,
+              if (heading != null && hasText) const SizedBox(height: 2),
+              if (hasText)
+                DefaultTextStyle.merge(
+                    style: TextStyle(fontSize: 13, height: 1.45, color: c.text),
+                    child: _body ?? Text(hjvKeepAll(text))),
+            ],
+          ),
+        ),
+      ],
+    );
+    final close = onClose == null
+        ? null
+        : IconButton(
+            onPressed: onClose,
+            tooltip: closeTooltip ??
+                MaterialLocalizations.of(context).closeButtonTooltip,
+            padding: EdgeInsets.zero,
+            constraints: BoxConstraints.tightFor(
+                width: phone ? 48 : 32, height: phone ? 48 : 32),
+            iconSize: 18,
+            icon: Icon(Icons.close_rounded, color: p.textTertiary));
+    final scale = MediaQuery.textScalerOf(context).scale(13);
+    final body = _HjvCalloutBody(
+      firstLine: scale * (heading != null ? 1.35 : 1.45),
+      padBottom: stacked && actions.isNotEmpty ? 0 : 12,
+      hasActions: inline,
+      hasClose: close != null,
+      children: [
+        lead,
+        if (inline)
+          TextButtonTheme(
+              data: TextButtonThemeData(
+                  style: TextButton.styleFrom(
+                          foregroundColor: c.action,
+                          minimumSize: const Size(0, 32),
+                          padding: const EdgeInsets.symmetric(horizontal: 10),
+                          tapTargetSize: phone
+                              ? MaterialTapTargetSize.padded
+                              : MaterialTapTargetSize.shrinkWrap)
+                      .merge(theme.textButtonTheme.style)),
+              child: Wrap(
+                  alignment: WrapAlignment.end,
+                  crossAxisAlignment: WrapCrossAlignment.center,
+                  spacing: 4,
+                  children: actions)),
+        if (close != null) close,
+      ],
+    );
+    return Container(
+      padding:
+          EdgeInsets.only(left: 12, right: inline || close != null ? 4 : 12),
+      decoration: BoxDecoration(
+        color: c.back,
+        borderRadius: BorderRadius.circular(HjvRadius.md),
+        border: onCanvas || highContrast
+            ? Border.all(color: highContrast ? p.textTertiary : p.border)
+            : null,
+      ),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          body,
+          if (stacked && actions.isNotEmpty) ...[
+            for (final action in actions)
+              Padding(
+                padding: EdgeInsets.only(
+                    top: 8, right: inline || close != null ? 8 : 0),
+                child: ConstrainedBox(
+                  constraints: const BoxConstraints(minHeight: 34),
+                  child: Theme(
+                      data: theme.copyWith(
+                          outlinedButtonTheme: OutlinedButtonThemeData(
+                              style: _kHjvStackedButton
+                                  .merge(theme.outlinedButtonTheme.style)),
+                          elevatedButtonTheme: ElevatedButtonThemeData(
+                              style: _kHjvStackedButton
+                                  .merge(theme.elevatedButtonTheme.style)),
+                          textButtonTheme: TextButtonThemeData(
+                              style: _kHjvStackedButton
+                                  .merge(theme.textButtonTheme.style))),
+                      child: action),
+                ),
+              ),
+            const SizedBox(height: 12),
+          ],
+        ],
+      ),
+    );
+  }
+}
+
+/// HjvCallout's row: the icon and the text (`children` first), then its actions (`hasActions`)
+/// and its close x (`hasClose`). The actions and the x stay on the text's line, centred on it,
+/// while the whole text fits on one line beside them; otherwise the actions go below the text at
+/// the right and the x stays centred on the first line (`firstLine` high). 12 above the text and
+/// `padBottom` below; a target higher than the line reaches into those.
+class _HjvCalloutBody extends MultiChildRenderObjectWidget {
+  final double firstLine;
+  final double padBottom;
+  final bool hasActions;
+  final bool hasClose;
+  const _HjvCalloutBody(
+      {required this.firstLine,
+      required this.padBottom,
+      required this.hasActions,
+      required this.hasClose,
+      required super.children});
+
+  @override
+  RenderObject createRenderObject(BuildContext context) =>
+      _RenderHjvCalloutBody()..take(this);
+
+  @override
+  void updateRenderObject(
+          BuildContext context, _RenderHjvCalloutBody renderObject) =>
+      renderObject.take(this);
+}
+
+class _HjvCalloutBodyData extends ContainerBoxParentData<RenderBox> {}
+
+class _RenderHjvCalloutBody extends RenderBox
+    with
+        ContainerRenderObjectMixin<RenderBox, _HjvCalloutBodyData>,
+        RenderBoxContainerDefaultsMixin<RenderBox, _HjvCalloutBodyData> {
+  static const _padTop = 12.0;
+  static const _gap = 8.0;
+  double _line = 19;
+  double _padBottom = 12;
+  bool _hasActions = false;
+  bool _hasClose = false;
+
+  void take(_HjvCalloutBody w) {
+    if (w.firstLine == _line &&
+        w.padBottom == _padBottom &&
+        w.hasActions == _hasActions &&
+        w.hasClose == _hasClose) {
+      return;
+    }
+    _line = w.firstLine;
+    _padBottom = w.padBottom;
+    _hasActions = w.hasActions;
+    _hasClose = w.hasClose;
+    markNeedsLayout();
+  }
+
+  @override
+  void setupParentData(RenderBox child) {
+    if (child.parentData is! _HjvCalloutBodyData) {
+      child.parentData = _HjvCalloutBodyData();
+    }
+  }
+
+  (RenderBox, RenderBox?, RenderBox?) get _parts {
+    final lead = firstChild!;
+    return (
+      lead,
+      _hasActions ? childAfter(lead) : null,
+      _hasClose ? lastChild : null
+    );
+  }
+
+  /// The size and the offsets of the text, the actions and the x.
+  (Size, List<Offset>) _place(BoxConstraints constraints, ChildLayouter layout) {
+    final (lead, actions, close) = _parts;
+    final cs = close == null ? Size.zero : layout(close, const BoxConstraints());
+    final leadWide = lead.getMaxIntrinsicWidth(double.infinity);
+    var w = constraints.maxWidth;
+    final as = actions == null
+        ? Size.zero
+        : layout(actions,
+            BoxConstraints(maxWidth: w.isFinite ? math.max(0, w - cs.width) : w));
+    final ahead = actions == null ? 0.0 : as.width + _gap;
+    if (!w.isFinite) w = leadWide + ahead + cs.width;
+    final inline = actions == null || leadWide + ahead + cs.width <= w;
+    // the text's room: beside the actions, or 8 before the box's right where the actions'
+    // padding (4) is all there is
+    final room = w -
+        cs.width -
+        (inline ? ahead : (close == null ? _gap : 0));
+    final ls = layout(lead, BoxConstraints(maxWidth: math.max(0, room)));
+    final centre = _padTop + (inline ? ls.height : _line) / 2;
+    var leadY = _padTop;
+    var closeY = centre - cs.height / 2;
+    var actionsY = inline ? centre - as.height / 2 : _padTop + ls.height + 4;
+    final shift = -[0.0, closeY, if (actions != null) actionsY].reduce(math.min);
+    leadY += shift;
+    closeY += shift;
+    actionsY += shift;
+    final height = [
+      leadY + ls.height + _padBottom,
+      if (close != null) closeY + cs.height,
+      if (actions != null)
+        actionsY + as.height + (inline ? 0 : math.max(0, _padBottom - 8)),
+    ].reduce(math.max);
+    return (
+      constraints.constrain(Size(w, height)),
+      [
+        Offset(0, leadY),
+        if (actions != null) Offset(w - cs.width - as.width, actionsY),
+        if (close != null) Offset(w - cs.width, closeY),
+      ]
+    );
+  }
+
+  @override
+  void performLayout() {
+    final (size, offsets) = _place(constraints, ChildLayoutHelper.layoutChild);
+    this.size = size;
+    var child = firstChild;
+    for (final offset in offsets) {
+      (child!.parentData as _HjvCalloutBodyData).offset = offset;
+      child = childAfter(child);
+    }
+  }
+
+  @override
+  Size computeDryLayout(covariant BoxConstraints constraints) =>
+      _place(constraints, ChildLayoutHelper.dryLayoutChild).$1;
+
+  @override
+  double computeMinIntrinsicWidth(double height) {
+    final (lead, actions, close) = _parts;
+    return math.max(lead.getMinIntrinsicWidth(height),
+            actions?.getMinIntrinsicWidth(height) ?? 0) +
+        (close?.getMinIntrinsicWidth(height) ?? 0);
+  }
+
+  @override
+  double computeMaxIntrinsicWidth(double height) {
+    final (lead, actions, close) = _parts;
+    return lead.getMaxIntrinsicWidth(height) +
+        (actions == null ? 0 : _gap + actions.getMaxIntrinsicWidth(height)) +
+        (close?.getMaxIntrinsicWidth(height) ?? 0);
+  }
+
+  @override
+  double computeMinIntrinsicHeight(double width) =>
+      computeDryLayout(BoxConstraints(maxWidth: width)).height;
+
+  @override
+  double computeMaxIntrinsicHeight(double width) =>
+      computeDryLayout(BoxConstraints(maxWidth: width)).height;
+
+  @override
+  double? computeDistanceToActualBaseline(TextBaseline baseline) =>
+      defaultComputeDistanceToFirstActualBaseline(baseline);
+
+  @override
+  void paint(PaintingContext context, Offset offset) =>
+      defaultPaint(context, offset);
+
+  @override
+  bool hitTestChildren(BoxHitTestResult result, {required Offset position}) =>
+      defaultHitTestChildren(result, position: position);
+}
+
 /// How long a toast stays: `least` (3 seconds) and about 70 ms a character more, at most 8 seconds
 /// (or `least` when that is longer), so that a sentence of the gate can be read to its end.
 Duration hjvToastTime(String text,
