+            ('text', c.text),
+            ('action', c.action),
+          ]) {
+            expect(contrast(color, c.back), greaterThanOrEqualTo(4.5),
+                reason: '$what of $where');
+          }
+          expect(contrast(c.icon, c.back), greaterThanOrEqualTo(3),
+              reason: 'icon of $where');
+        }
+      }
+      expect(hjvToneColors(p, HjvTone.neutral).back, p.fill);
+      expect(hjvToneColors(p, HjvTone.success).back, p.successSoft);
+      expect(hjvToneColors(p, HjvTone.warning).back, p.warningSoft);
+      expect(hjvToneColors(p, HjvTone.danger).back, p.dangerSoft);
+      expect(hjvToneColors(p, HjvTone.info).back, p.primarySoft);
+      // danger's text in the text colour, the others' in the secondary one
+      expect(hjvToneColors(p, HjvTone.danger).text, p.text);
+      expect(hjvToneColors(p, HjvTone.warning).text, p.textSecondary);
+      // the tones' text colours read on a card and on the fields' grey too
+      for (final t in [p.successText, p.warningText]) {
+        expect(contrast(t, p.card), greaterThanOrEqualTo(4.5));
+        expect(contrast(t, p.fill), greaterThanOrEqualTo(4.5));
+      }
+    });
+  }
