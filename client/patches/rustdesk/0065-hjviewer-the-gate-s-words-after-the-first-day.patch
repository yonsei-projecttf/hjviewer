+/// The session's text for "Remote desktop is offline" (handleMsgBox), null to keep upstream's: on
+/// a staff-only server (`mode`) a PC nobody logged in on is offline too, said for sure or as a
+/// condition; to a controller that just got the access password for that PC (`passed`) since its
+/// own PC is the one missing; with a line for a PC this session restarted (`restarted`).
+String? hjvOfflineGateText(HjvAccessTexts t,
+    {required String mode, bool passed = false, bool restarted = false}) {
+  final closes = hjvGateCloses(mode);
+  if (!passed && closes == false) return null;
+  final text = passed ? t.offlinePassed : t.offline(known: closes == true);
+  return restarted ? '$text\n${t.offlineRestarted}' : text;
+}
+
+/// The remote restart's confirm (dialog.dart), null for no line: what a restart does on a
+/// staff-only server (`mode`) to a PC nobody logged in on, and that HJViewer that is not
+/// installed there (`installed`) does not start again.
+String? hjvRestartGateNote(HjvAccessTexts t,
+    {required String mode, required bool installed}) {
+  final closes = hjvGateCloses(mode);
+  final lines = [
+    if (closes != false) t.restartGate(known: closes == true),
+    if (!installed) t.restartNotInstalled,
+  ];
+  return lines.isEmpty ? null : lines.join('\n');
+}
