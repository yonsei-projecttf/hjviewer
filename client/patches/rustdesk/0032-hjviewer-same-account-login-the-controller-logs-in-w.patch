+fn proof_for(
+    login: &LoginContext,
+    account: &Account,
+    key: impl FnOnce() -> Result<AccountKey, &'static str>,
+) -> ProofDecision {
+    let seen = seen_keys(login.session_id);
+    let decision = match decide(login, &seen, account, key) {
+        Ok(decision) => decision,
+        Err(why) => {
+            if !why.is_empty() {
+                hbb_common::throttled_log!(
+                    LOG_INTERVAL,
+                    debug,
+                    "no same-account proof for {}: {why}",
+                    login.pc_id
+                );
+            }
+            ProofDecision::No
+        }
+    };
+    match decision {
+        ProofDecision::Send(_) => {
+            hbb_common::throttled_log!(LOG_INTERVAL, info, "same-account proof for {}", login.pc_id)
+        }
+        ProofDecision::KeyChanged { .. } => hbb_common::throttled_log!(
+            LOG_INTERVAL,
+            warn,
+            "{}: not the key the account's list has for the PC; closed without a proof or a password",
+            login.pc_id
+        ),
+        ProofDecision::No => {}
+    }
+    mark_proof_sent(login.session_id, matches!(decision, ProofDecision::Send(_)));
+    decision
