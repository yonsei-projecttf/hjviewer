+/// 3-4's conditions. The key continuity check (its 8th) runs before what only a proof needs (a
+/// kind that goes by proof, the nonce, the list's kinds, the account key), so that neither a PC
+/// that leaves out its nonce nor a port forwarding to it has the remembered password sent without
+/// it. It covers the account's PCs that are not needs-relogin, over a secured channel; everything
+/// else goes the password way as before. Err says why no proof goes out, "" for the everyday
+/// cases (logged out, not the account's PC).
+fn decide(
+    login: &LoginContext,
+    seen: &[[u8; 32]],
+    account: &Account,
+    key: impl FnOnce() -> Result<AccountKey, &'static str>,
+) -> Result<ProofDecision, &'static str> {
+    if login.other_server || !account.logged_in {
+        return Err("");
+    }
+    let Some(pc) = account.devices.pcs.get(login.pc_id) else {
+        return Err("");
+    };
+    if pc.pwless == NEEDS_RELOGIN {
+        return Err("the PC needs its owner to log in on it again");
+    }
+    if !login.secured || seen.is_empty() {
+        return Err("the channel is not secured");
+    }
+    let Some(bound) = STANDARD
+        .decode(&pc.pk)
+        .ok()
+        .and_then(|pk| <[u8; 32]>::try_from(pk).ok())
+    else {
+        return Err("the device list has no key for the PC");
+    };
+    if seen.iter().any(|pk| *pk != bound) {
+        let (title, text) = key_changed(account.korean);
+        return Ok(ProofDecision::KeyChanged { title, text });
+    }
+    // the mappings of one port forwarding window share a session, so the key each of them was
+    // checked against cannot be told apart for a proof
+    if login.kind > KIND_TERMINAL {
+        return Err("port forwarding and RDP go by password");
+    }
+    // a proof alone would leave a PC without the feature waiting for its user to accept
+    if login.nonce.len() != 32 {
+        return Err("the PC sent no nonce");
+    }
+    if !pc.kinds.iter().any(|k| k == kind_name(login.kind)) {
+        return Err("the account does not open this kind of connection without a password");
+    }
+    let key = key()?;
+    conn_proof(
+        &key,
+        login.pc_id,
+        &bound,
+        login.nonce,
+        login.ctl_id,
+        login.kind,
+        account.key_serial,
+    )
+    .map(ProofDecision::Send)
+    .ok_or("an ID too long for a proof")
+}
+
+fn load_key() -> Result<AccountKey, &'static str> {
+    match keystore::load() {
+        Ok(Some(key)) => Ok(key),
+        Ok(None) => Err("no account key"),
+        Err(_) => Err("the account key cannot be read now"),
+    }
