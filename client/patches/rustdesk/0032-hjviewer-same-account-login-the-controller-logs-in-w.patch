+    fn the_boxes() {
+        for korean in [true, false] {
+            let (title, text) = refused(korean);
+            let (warning, advice) = key_changed(korean);
+            for s in [title, text, warning, advice] {
+                assert!(!s.is_empty() && !s.contains(['{', '}']), "{s}");
+            }
+            // the refusal names the box's own [Retry] (ko.rs: "재시도")
+            assert!(text.contains(if korean { "[재시도]" } else { "[Retry]" }));
+        }
+    }
