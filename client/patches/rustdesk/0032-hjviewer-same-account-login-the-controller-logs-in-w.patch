+    #[test]
+    fn no_proof_without_a_nonce() {
+        let _ = hbb_common::sodiumoxide::init();
+        let active = account(devices("active", PC_PK, &["remote", "file", "camera"]));
+        // a 1.5.x PC's Hash has none; anything but 32 bytes is no nonce
+        for nonce in [&[][..], &[1; 16][..], &[1; 31][..], &[1; 33][..]] {
+            let decision = decide(&login(nonce), &[pc_pk()], &active, the_key);
+            assert_eq!(
+                decision.err(),
+                Some("the PC sent no nonce"),
+                "{}",
+                nonce.len()
+            );
+        }
+    }
+
+    #[test]
+    fn a_changed_key_warns_for_the_accounts_pcs_only() {
+        let _ = hbb_common::sodiumoxide::init();
+        let impostor = [[7u8; 32]];
+        let active = || account(devices("active", PC_PK, &["remote", "file", "camera"]));
+        let decision = decide(&login(&CONN_NONCE), &impostor, &active(), || {
+            panic!("the account key is not needed to warn")
+        });
+        let Ok(ProofDecision::KeyChanged { title, text }) = decision else {
+            panic!("no warning");
+        };
+        assert_eq!((title, text), key_changed(false));
+        // whatever the PC leaves out, and whatever kind the list opens
+        for (nonce, kind) in [(&[][..], KIND_REMOTE), (&CONN_NONCE[..], KIND_TERMINAL)] {
+            let l = LoginContext {
+                kind,
+                ..login(nonce)
+            };
+            assert_eq!(decide_with(&l, &impostor, &active()), "key changed");
+        }
+        // one channel of the session to another key is enough, whichever was noted last
+        for seen in [[pc_pk(), [7; 32]], [[7; 32], pc_pk()]] {
+            assert_eq!(
+                decide_with(&login(&CONN_NONCE), &seen, &active()),
+                "key changed"
+            );
+        }
+        // not in the list, or needs-relogin: the password way, without a warning
+        let not_mine = LoginContext {
+            pc_id: "555555555",
+            ..login(&CONN_NONCE)
+        };
+        assert_eq!(decide_with(&not_mine, &impostor, &active()), "password");
+        let relogin = account(devices(NEEDS_RELOGIN, PC_PK, &["remote"]));
+        assert_eq!(
+            decide_with(&login(&CONN_NONCE), &impostor, &relogin),
+            "password"
+        );
+        // and for port forwarding, which goes by password to the PC under the bound key only
+        let forward = LoginContext {
+            kind: KIND_PORT_FORWARD,
+            ..login(&CONN_NONCE)
+        };
+        assert_eq!(decide_with(&forward, &impostor, &active()), "key changed");
+        assert_eq!(decide_with(&forward, &[pc_pk()], &active()), "password");
+    }
+
+    #[test]
+    fn the_proof_is_the_vectors() {
+        let _ = hbb_common::sodiumoxide::init();
+        let pk = pc_pk();
+        let active = account(devices("active", PC_PK, &["remote", "file", "camera"]));
+        let Ok(ProofDecision::Send(proof)) = decide(&login(&CONN_NONCE), &[pk], &active, the_key)
+        else {
+            panic!("no proof");
+        };
+        assert_eq!(
+            hex::encode(proof.write_to_bytes().unwrap()),
+            CONN_PROOF_PROTO_HEX
+        );
+        assert_eq!(STANDARD.encode(&proof.signature), CONN_SIG);
+        assert_eq!(proof.key_serial, CONN_KEY_SERIAL);
+        // and the PC that sent the nonce takes it against the vector list
+        let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+        let list = verify_list(&pinned, 1, &STANDARD.encode(LIST), LIST_SIG, &local(&pk)).unwrap();
+        let login = KeyLogin {
+            pc_id: PC_ID,
+            pc_pk: &pk,
+            secured: true,
+            nonce: &CONN_NONCE,
+            proof: &proof,
+            my_id: CTL_ID,
+            kind: KIND_REMOTE,
+        };
+        let cached = Cached { list, received: T };
+        assert_eq!(
+            check_key_login(&login, Some(&cached), T + 60).unwrap().id,
+            CTL_ID
+        );
+    }
+
+    #[test]
+    fn the_device_list_as_kept() {
+        let json = r#"{"acct":"2026000001","at":1760000000,"pcs":{"123456789":{"pk":"gTl3Dqh9F19Wo1Rmw0x+zMuNipG07jeiXfYPW4/Js5Q=","pwless":"expired","kinds":["remote","file","camera"],"wol":"ok"}}}"#;
+        let list: MyDevices = serde_json::from_str(json).unwrap();
+        let pc = &list.pcs[PC_ID];
+        assert_eq!((pc.pk.as_str(), pc.pwless.as_str()), (PC_PK, "expired"));
+        assert_eq!(pc.kinds, ["remote", "file", "camera"]);
+        // a missing or damaged option is an empty list
+        for bad in ["", "{", "[]", r#"{"pcs":3}"#] {
+            let list: MyDevices = serde_json::from_str(bad).unwrap_or_default();
+            assert!(list.pcs.is_empty(), "{bad}");
+        }
