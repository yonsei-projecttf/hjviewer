+            logged_in: false,
+            ..active()
+        };
+        assert_eq!(
+            decide_with(&login(&CONN_NONCE), &pk, &logged_out),
+            "password"
+        );
+        for no_key in ["no account key", "the account key cannot be read now"] {
+            let decision = decide(&login(&CONN_NONCE), &pk, &active(), || Err(no_key));
+            assert_eq!(decision.err(), Some(no_key));
+        }
+        let other_server = LoginContext {
+            other_server: true,
+            ..login(&CONN_NONCE)
+        };
+        assert_eq!(decide_with(&other_server, &pk, &active()), "password");
+        let not_mine = LoginContext {
+            pc_id: "555555555",
+            ..login(&CONN_NONCE)
+        };
+        assert_eq!(decide_with(&not_mine, &pk, &active()), "password");
+
+        // a state other than active still sends (the app's copy may be old), needs-relogin never
+        for state in ["listed", "off", "disabled", "expired", ""] {
+            let list = account(devices(state, PC_PK, &usual));
+            assert_eq!(
+                decide_with(&login(&CONN_NONCE), &pk, &list),
+                "proof",
+                "{state}"
+            );
+        }
+        let relogin = account(devices(NEEDS_RELOGIN, PC_PK, &usual));
+        assert_eq!(decide_with(&login(&CONN_NONCE), &pk, &relogin), "password");
+
+        // the kinds: what the list opens, never port forwarding or RDP
+        for (kind, opened) in [
+            (KIND_FILE, "proof"),
+            (KIND_CAMERA, "proof"),
+            (KIND_TERMINAL, "password"),
+            (KIND_PORT_FORWARD, "password"),
+        ] {
+            let l = LoginContext {
+                kind,
+                ..login(&CONN_NONCE)
+            };
+            assert_eq!(decide_with(&l, &pk, &active()), opened, "{kind}");
+        }
+        let with_terminal = account(devices("active", PC_PK, &["remote", "terminal"]));
+        let terminal = LoginContext {
+            kind: KIND_TERMINAL,
+            ..login(&CONN_NONCE)
+        };
+        assert_eq!(decide_with(&terminal, &pk, &with_terminal), "proof");
+
+        // an unsecured channel, or no key noted for this session
+        let unsecured = LoginContext {
+            secured: false,
+            ..login(&CONN_NONCE)
+        };
+        assert_eq!(decide_with(&unsecured, &pk, &active()), "password");
+        assert_eq!(decide_with(&login(&CONN_NONCE), &[], &active()), "password");
+        // a list without a usable key for the PC
+        for bad in ["", "AAAA", &STANDARD.encode([1u8; 31])] {
+            let list = account(devices("active", bad, &usual));
+            assert_eq!(decide_with(&login(&CONN_NONCE), &pk, &list), "password");
+        }
+    }
