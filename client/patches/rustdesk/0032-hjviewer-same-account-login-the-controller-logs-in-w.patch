+
+    #[test]
+    fn a_session_keeps_its_secured_keys_and_one_proof() {
+        let id = SESSION + 1;
+        let pk = pc_pk();
+        note(id, true, Some(&pk));
+        assert_eq!(seen_keys(id), [pk]);
+        // an unsecured channel, or one without a key, adds nothing and removes nothing
+        note(id, false, Some(&[7; 32]));
+        note(id, true, Some(&pk[..31]));
+        note(id, true, None);
+        assert_eq!(seen_keys(id), [pk]);
+        // another secured channel of the session to another key counts too, once
+        note(id, true, Some(&[7; 32]));
+        note(id, true, Some(&[7; 32]));
+        assert_eq!(seen_keys(id), [pk, [7; 32]]);
+        assert!(seen_keys(id + 1).is_empty());
+        // the proof is taken once, and only after a login that carried one
+        assert!(!take_sent(id));
+        mark_proof_sent(id, true);
+        assert!(take_sent(id));
+        assert!(!take_sent(id));
+        mark_proof_sent(id, true);
+        mark_proof_sent(id, false);
+        assert!(!take_sent(id));
+        // a key counts for a day, so a channel held open before its login does not outlast its
+        // key's note (unless the machine has not been up that long)
+        if let Some(earlier) = Instant::now().checked_sub(Duration::from_secs(3600)) {
+            SESSIONS.lock().unwrap().get_mut(&id).unwrap().keys[0].1 = earlier;
+            assert_eq!(seen_keys(id), [pk, [7; 32]]);
+        }
+        if let Some(then) = Instant::now().checked_sub(SEEN_FOR) {
+            SESSIONS.lock().unwrap().get_mut(&id).unwrap().keys[0].1 = then;
+            assert_eq!(seen_keys(id), [[7; 32]]);
+            mark_proof_sent(id, true);
+            SESSIONS.lock().unwrap().get_mut(&id).unwrap().keys[0].1 = then;
+            assert!(seen_keys(id).is_empty());
+            assert!(!take_sent(id));
+        }
+    }
