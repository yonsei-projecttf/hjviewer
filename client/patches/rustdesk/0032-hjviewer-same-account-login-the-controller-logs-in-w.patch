+/// An unsecured channel adds nothing and removes nothing: its own login never carries a proof, and
+/// the keys the session's other channels were checked against still count.
+fn note(session_id: u64, secured: bool, pk: Option<&[u8]>) {
+    let mut sessions = SESSIONS.lock().unwrap();
+    forget_old(&mut sessions);
+    let Some(pk) = pk
+        .and_then(|pk| <[u8; 32]>::try_from(pk).ok())
+        .filter(|_| secured)
+    else {
+        return;
+    };
+    let keys = &mut sessions.entry(session_id).or_default().keys;
+    keys.retain(|(k, _)| *k != pk);
+    keys.push((pk, Instant::now()));
+}
+
+fn forget_old(sessions: &mut HashMap<u64, Session>) {
+    sessions.retain(|_, s| {
+        s.keys.retain(|(_, at)| at.elapsed() < SEEN_FOR);
+        !s.keys.is_empty()
+    });
+}
+
+fn seen_keys(session_id: u64) -> Vec<[u8; 32]> {
+    let mut sessions = SESSIONS.lock().unwrap();
+    forget_old(&mut sessions);
+    sessions
+        .get(&session_id)
+        .map(|s| s.keys.iter().map(|(pk, _)| *pk).collect())
+        .unwrap_or_default()
+}
+
+fn mark_proof_sent(session_id: u64, sent: bool) {
+    if let Some(s) = SESSIONS.lock().unwrap().get_mut(&session_id) {
+        s.proof_sent = sent;
+    }
+}
+
+fn take_sent(session_id: u64) -> bool {
+    SESSIONS
+        .lock()
+        .unwrap()
+        .get_mut(&session_id)
+        .is_some_and(|s| std::mem::take(&mut s.proof_sent))
 }
 
