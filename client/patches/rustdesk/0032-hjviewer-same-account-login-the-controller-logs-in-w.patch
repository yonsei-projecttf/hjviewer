+//! The controller's hooks in client.rs for same-account logins (design v3 3-1, 3-4, 3-9). A child
+//! module of `client`, so that it builds the login with the private `create_login_msg` and reads
+//! LoginConfigHandler's fields. The decisions are `hjviewer_account`'s; in a build without the
+//! feature every hook does nothing.
+
+use crate::{
+    client::{Interface, LoginConfigHandler, LOGIN_MSG_PASSWORD_EMPTY},
+    hjviewer_account::{
+        enabled, key_proof, kind_of_conn_type, note_peer_key as note_session_key, take_proof_sent,
+        LoginContext, ProofDecision,
+    },
+};
+use base::message_proto::{message, Hash};
+use hbb_common::{
+    allow_err, log,
+    protobuf::MessageField,
+    sha2::{Digest, Sha256},
+    Stream,
+};
+use std::sync::{Arc, RwLock};
+
+/// H10, Client::start: the PC key this connection's channel was checked against.
+pub(super) fn note_peer_key(interface: &impl Interface, stream: &Stream, pk: Option<&[u8]>) {
+    if !enabled() {
+        return;
+    }
+    let session_id = interface.get_lch().read().unwrap().session_id;
+    note_session_key(session_id, stream.is_secured(), pk);
+}
+
+/// H11, handle_login_error: true when handled here.
+pub(super) fn on_login_error(
+    lc: &Arc<RwLock<LoginConfigHandler>>,
+    err: &str,
+    interface: &impl Interface,
+) -> bool {
+    enabled() && refused(lc, err, interface)
+}
+
+/// After a login with a proof, "Empty Password" means that the PC refused the proof and no
+/// password came with it. The 're-input-password' box says so; its [Retry] opens the password box.
+fn refused(lc: &Arc<RwLock<LoginConfigHandler>>, err: &str, interface: &impl Interface) -> bool {
+    let session_id = lc.read().unwrap().session_id;
+    let Some((title, text)) = take_proof_sent(session_id) else {
+        return false;
+    };
+    if err != LOGIN_MSG_PASSWORD_EMPTY {
+        return false;
+    }
+    lc.write().unwrap().password = Default::default();
+    interface.msgbox("re-input-password", title, text, "");
+    true
+}
+
+/// H12, handle_hash, with the remembered password (salted) as handle_hash found it. Some(true):
+/// the login went out with an account key proof and that password, without a password box first.
+/// Some(false): the PC's key is not the one the account bound to it; the warning is up, nothing
+/// was sent, and the connection ends. None: handle_hash goes on as before.
+pub(super) async fn key_login(
+    lc: &Arc<RwLock<LoginConfigHandler>>,
+    hash: &Hash,
+    password: &[u8],
+    interface: &impl Interface,
+    peer: &mut Stream,
+) -> Option<bool> {
+    if !enabled() {
+        return None;
+    }
+    login_with(lc, hash, password, interface, peer, key_proof).await
+}
+
+async fn login_with(
+    lc: &Arc<RwLock<LoginConfigHandler>>,
+    hash: &Hash,
+    password: &[u8],
+    interface: &impl Interface,
+    peer: &mut Stream,
+    decide: impl FnOnce(&LoginContext) -> ProofDecision,
+) -> Option<bool> {
+    let password = if password.is_empty() {
+        Vec::new()
+    } else {
+        let mut hasher = Sha256::new();
+        hasher.update(password);
+        hasher.update(&hash.challenge);
+        hasher.finalize()[..].into()
+    };
+    let (mut msg, session_id, kind, other_server) = {
+        let lc = lc.read().unwrap();
+        (
+            lc.create_login_msg(String::new(), String::new(), password),
+            lc.session_id,
+            kind_of_conn_type(lc.conn_type),
+            lc.other_server.is_some(),
+        )
+    };
+    let Some(message::Union::LoginRequest(lr)) = msg.union.as_mut() else {
+        return None;
+    };
+    let decision = decide(&LoginContext {
+        session_id,
+        pc_id: &lr.username,
+        ctl_id: &lr.my_id,
+        kind,
+        other_server,
+        nonce: &hash.hjv_nonce,
+        secured: peer.is_secured(),
+    });
+    match decision {
+        ProofDecision::No => None,
+        ProofDecision::KeyChanged { title, text } => {
+            lc.write().unwrap().password = Default::default();
+            interface.msgbox("error", title, text, "");
+            Some(false)
+        }
+        ProofDecision::Send(proof) => {
+            lr.hjv_key_proof = MessageField::some(proof);
+            allow_err!(peer.send(&msg).await);
+            lc.write().unwrap().hash = hash.clone();
+            Some(true)
+        }
+    }
+}
+
+/// The controller's side of a connection, through the client's own secured handshake, against a
+/// PC on loopback that takes same-account logins as design 3-5 has it (its key check, without the
+/// binding, the sync and the CM). This test build has none of the build variables, so the steps
+/// that an account build's hooks take are taken here: Client::start's note (H10), handle_hash's
+/// hook (H12) and handle_login_error's (H11), each followed by the client's own way when the hook
+/// leaves the login to it.
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        client::{handle_hash, handle_login_error, Client, Data},
+        hjviewer_account::{check_key_login, kind_of_union, vectors::*, Cached, KeyLogin},
+    };
+    use async_trait::async_trait;
+    use base::message_proto::{
+        login_response, LoginRequest, LoginResponse, Message, PeerInfo, SignedId, TestDelay,
+        WindowsSession,
+    };
+    use hbb_common::{
+        config::Config,
+        protobuf::Message as _,
+        rand,
+        rendezvous_proto::{ConnType, IdPk},
+        socket_client::connect_tcp,
+        sodiumoxide::crypto::{box_, sign},
+        tcp::{new_listener, Encrypt, FramedStream},
+        timeout,
+        tokio::{self, task::JoinHandle},
+    };
+    use std::sync::Mutex;
+
+    /// The PC's permanent password.
+    const PC_PASSWORD: &str = "pc-password";
+    const SALT: &str = "salt";
+    const CHALLENGE: &str = "abcdef";
+
+    /// A session's interface that keeps the boxes it was asked to show.
+    #[derive(Clone)]
+    struct Ui {
+        lc: Arc<RwLock<LoginConfigHandler>>,
+        boxes: Arc<Mutex<Vec<(String, String)>>>,
+    }
+
+    impl Ui {
+        fn new(conn_type: ConnType) -> Ui {
+            let lc = LoginConfigHandler {
+                id: PC_ID.to_owned(),
+                conn_type,
+                session_id: rand::random::<u64>() | 1,
+                ..Default::default()
+            };
+            Ui {
+                lc: Arc::new(RwLock::new(lc)),
+                boxes: Default::default(),
+            }
+        }
+
+        /// (type, title) of each box shown
+        fn boxes(&self) -> Vec<(String, String)> {
+            self.boxes.lock().unwrap().clone()
+        }
+    }
+
+    #[async_trait]
+    impl Interface for Ui {
+        fn send(&self, _data: Data) {}
+        fn msgbox(&self, msgtype: &str, title: &str, _text: &str, _link: &str) {
+            self.boxes
+                .lock()
+                .unwrap()
+                .push((msgtype.to_owned(), title.to_owned()));
+        }
+        fn handle_login_error(&self, err: &str) -> bool {
+            handle_login_error(self.lc.clone(), err, self)
+        }
+        fn handle_peer_info(&self, _pi: PeerInfo) {}
+        fn set_multiple_windows_session(&self, _sessions: Vec<WindowsSession>) {}
+        async fn handle_hash(&self, pass: &str, hash: Hash, peer: &mut Stream) -> bool {
+            handle_hash(self.lc.clone(), pass, hash, self, peer).await
+        }
+        async fn handle_login_from_ui(
+            &self,
+            _os_username: String,
+            _os_password: String,
+            _password: String,
+            _remember: bool,
+            _peer: &mut Stream,
+        ) {
+        }
+        async fn handle_test_delay(&self, _t: TestDelay, _peer: &mut Stream) {}
+        fn get_lch(&self) -> Arc<RwLock<LoginConfigHandler>> {
+            self.lc.clone()
+        }
+    }
+
+    fn sha256(a: &[u8], b: &[u8]) -> Vec<u8> {
+        let mut hasher = Sha256::new();
+        hasher.update(a);
+        hasher.update(b);
+        hasher.finalize()[..].into()
+    }
+
+    /// The PC, as the device list and the trust list have it.
+    struct Pc {
+        /// Hash.hjv_nonce; none from a PC without the feature (1.5.x)
+        nonce: Option<[u8; 32]>,
+        /// the trust list it checks proofs against, holding this device's account key
+        list: bool,
+    }
+
+    const PC: Pc = Pc {
+        nonce: Some(CONN_NONCE),
+        list: true,
+    };
+
+    /// The PC's answer to a login: a proof it takes, else its password; an empty password without
+    /// a proof waits for its user to accept, and gets no answer.
+    fn answer(pc: &Pc, lr: &LoginRequest) -> Option<login_response::Union> {
+        let list: Option<Cached> = pc.list.then(|| Cached {
+            // the list's key carries this device's ID, the LoginRequest's my_id
+            list: serde_json::from_str(&LIST.replace(CTL_ID, &Config::get_id())).unwrap(),
+            received: T,
+        });
+        let pc_pk = pk_bytes(PC_PK);
+        let proof = lr
+            .hjv_key_proof
+            .as_ref()
+            .zip(pc.nonce)
+            .map(|(proof, nonce)| {
+                let login = KeyLogin {
+                    pc_id: PC_ID,
+                    pc_pk: &pc_pk,
+                    secured: true,
+                    nonce: &nonce,
+                    proof,
+                    my_id: &lr.my_id,
+                    kind: kind_of_union(&lr.union),
+                };
+                check_key_login(&login, list.as_ref(), T + 60).is_ok()
+            });
+        let password = sha256(
+            &sha256(PC_PASSWORD.as_bytes(), SALT.as_bytes()),
+            CHALLENGE.as_bytes(),
+        );
+        match proof {
+            Some(true) => Some(login_response::Union::PeerInfo(Default::default())),
+            _ if lr.password.is_empty() => {
+                proof.map(|_| login_response::Union::Error(LOGIN_MSG_PASSWORD_EMPTY.to_owned()))
+            }
+            _ if lr.password[..] == password[..] => {
+                Some(login_response::Union::PeerInfo(Default::default()))
+            }
+            _ => Some(login_response::Union::Error("Wrong Password".to_owned())),
+        }
+    }
+
+    /// The PC on loopback: the controlled side's handshake under its device key (the vectors' PC
+    /// key, which the rendezvous server signs for its ID), its Hash, and its answer to the login.
+    /// Returns where it listens, its signed identity, the rendezvous key, and the login it got.
+    async fn run_pc(pc: Pc) -> (String, Vec<u8>, String, JoinHandle<Option<LoginRequest>>) {
+        let (rs_pk, rs_sk) = sign::gen_keypair();
+        let id_pk = |pk: &[u8]| {
+            IdPk {
+                id: PC_ID.to_owned(),
+                pk: pk.to_vec().into(),
+                ..Default::default()
+            }
+            .write_to_bytes()
+            .unwrap()
+        };
+        let signed_id_pk = sign::sign(&id_pk(&pk_bytes(PC_PK)), &rs_sk);
+        let listener = new_listener("127.0.0.1:0", false).await.unwrap();
+        let host = listener.local_addr().unwrap().to_string();
+        let task = tokio::spawn(async move {
+            let (stream, addr) = listener.accept().await.unwrap();
+            let mut s = FramedStream::from(stream, addr);
+            let (box_pk, box_sk) = box_::gen_keypair();
+            let mut msg = Message::new();
+            msg.set_signed_id(SignedId {
+                id: sign::sign(&id_pk(&box_pk.0), &device_key(&PC_SEED)).into(),
+                ..Default::default()
+            });
+            s.send(&msg).await.unwrap();
+            let bytes = s.next().await.unwrap().unwrap();
+            let Some(message::Union::PublicKey(pk)) =
+                Message::parse_from_bytes(&bytes).unwrap().union
+            else {
+                panic!("expected the controller's public key");
+            };
+            s.set_key(Encrypt::decode(&pk.symmetric_value, &pk.asymmetric_value, &box_sk).unwrap());
+            let mut msg = Message::new();
+            msg.set_hash(Hash {
+                salt: SALT.to_owned(),
+                challenge: CHALLENGE.to_owned(),
+                hjv_nonce: pc.nonce.map(|n| n.to_vec()).unwrap_or_default().into(),
+                ..Default::default()
+            });
+            s.send(&msg).await.unwrap();
+            // the controller closes the connection when it sends no login
+            let Ok(Some(Ok(bytes))) = timeout(10_000, s.next()).await else {
+                return None;
+            };
+            let lr = Message::parse_from_bytes(&bytes)
+                .unwrap()
+                .login_request()
+                .clone();
+            if let Some(union) = answer(&pc, &lr) {
+                let mut msg = Message::new();
+                msg.set_login_response(LoginResponse {
+                    union: Some(union),
+                    ..Default::default()
+                });
+                s.send(&msg).await.unwrap();
+            }
+            Some(lr)
+        });
+        (host, signed_id_pk, crate::encode64(rs_pk.0), task)
+    }
+
+    /// The PC's Hash, which it sends right after the handshake.
+    async fn hash_from(peer: &mut Stream) -> Hash {
+        let bytes = timeout(10_000, peer.next())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        Message::parse_from_bytes(&bytes).unwrap().hash().clone()
+    }
+
+    /// What one connection came to.
+    struct Outcome {
+        /// (type, title) of each box the controller showed
+        boxes: Vec<(String, String)>,
+        /// handle_hash's result: false ends the session
+        kept: bool,
+        logged_in: bool,
+        /// the login the PC got
+        at_pc: Option<LoginRequest>,
+        /// what create_login_msg makes for the password the login carried
+        plain_login: LoginRequest,
+    }
+
+    /// One connection to `pc` by a device logged in to the account with its key, `my_devices` its
+    /// `hjv-my-devices`; `remembered`: the PC's password is remembered.
+    async fn connect(conn_type: ConnType, pc: Pc, my_devices: &str, remembered: bool) -> Outcome {
+        let _ = hbb_common::sodiumoxide::init();
+        let ui = Ui::new(conn_type);
+        let session_id = ui.lc.read().unwrap().session_id;
+        let (host, signed_id_pk, rs_pk, at_pc) = run_pc(pc).await;
+        let mut peer = connect_tcp(host, 3000).await.unwrap();
+        let pk = Client::secure_connection(PC_ID, signed_id_pk, &rs_pk, &mut peer)
+            .await
+            .unwrap();
+        assert!(peer.is_secured());
+        LoginContext::note_for_test(session_id, peer.is_secured(), pk.as_deref());
+        let hash = hash_from(&mut peer).await;
+        if remembered {
+            ui.lc.write().unwrap().password = sha256(PC_PASSWORD.as_bytes(), hash.salt.as_bytes());
+        }
+        let password = ui.lc.read().unwrap().password.clone();
+        let kept = match login_with(&ui.lc, &hash, &password, &ui, &mut peer, |login| {
+            login.decide_for_test(my_devices, ACCOUNT_SEED)
+        })
+        .await
+        {
+            Some(kept) => kept,
+            None => handle_hash(ui.lc.clone(), "", hash.clone(), &ui, &mut peer).await,
+        };
+        // the PC closes the connection after its answer, or without one
+        let mut logged_in = false;
+        if kept {
+            if let Ok(Some(Ok(bytes))) = timeout(10_000, peer.next()).await {
+                match Message::parse_from_bytes(&bytes).unwrap().union {
+                    Some(message::Union::LoginResponse(res)) => match res.union {
+                        Some(login_response::Union::PeerInfo(_)) => logged_in = true,
+                        Some(login_response::Union::Error(err)) => {
+                            let _ = refused(&ui.lc, &err, &ui)
+                                || handle_login_error(ui.lc.clone(), &err, &ui);
+                        }
+                        _ => {}
+                    },
+                    _ => panic!("not a login response"),
+                }
+            }
+        }
+        drop(peer);
+        let at_pc = at_pc.await.unwrap();
+        let carried = at_pc
+            .as_ref()
+            .map(|lr| lr.password.to_vec())
+            .unwrap_or_default();
+        let plain_login = ui
+            .lc
+            .read()
+            .unwrap()
+            .create_login_msg(String::new(), String::new(), carried)
+            .login_request()
+            .clone();
+        Outcome {
+            boxes: ui.boxes(),
+            kept,
+            logged_in,
+            at_pc,
+            plain_login,
+        }
+    }
+
+    /// `hjv-my-devices` with the PC at `pwless`, under the key `pk`.
+    fn my_devices(pwless: &str, pk: &str) -> String {
+        format!(
+            r#"{{"acct":"2026000001","at":1760000000,"pcs":{{"{PC_ID}":{{"pk":"{pk}","pwless":"{pwless}","kinds":["remote","file","camera"]}}}}}}"#
+        )
+    }
+
+    fn password_box() -> Vec<(String, String)> {
+        vec![("input-password".to_owned(), "Password Required".to_owned())]
+    }
+
+    /// S4, S14: the account's PC takes the proof. No password box comes up, with or without a
