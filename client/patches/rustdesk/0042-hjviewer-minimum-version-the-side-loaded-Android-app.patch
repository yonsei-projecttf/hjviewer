             android:name="flutterEmbedding"
             android:value="2" />
+
+        <!-- HJViewer: hands the checked update APK to the system installer (HjvUpdate.kt). The
+             Google Play bundle removes this provider by its class name. -->
+        <provider
+            android:name=".HjvUpdateFileProvider"
+            android:authorities="${applicationId}.fileprovider"
+            android:exported="false"
+            android:grantUriPermissions="true">
+            <meta-data
+                android:name="android.support.FILE_PROVIDER_PATHS"
+                android:resource="@xml/hjv_update_paths" />
+        </provider>
     </application>
 
 </manifest>
diff --git a/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/HjvUpdate.kt b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/HjvUpdate.kt
new file mode 100644
index 0000000..0909057
--- /dev/null
+++ b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/HjvUpdate.kt
@@ -0,0 +1,122 @@
+package com.carriez.flutter_hbb
+
+import android.app.Activity
+import android.content.Intent
+import android.content.pm.PackageInfo
+import android.content.pm.PackageManager
+import android.os.Build
+import android.util.Log
+import androidx.core.content.FileProvider
+import io.flutter.plugin.common.MethodChannel
+import java.io.File
+import kotlin.concurrent.thread
+
+// HJViewer: the in-app update of the side-loaded APK (minimum version design 5-4). The Rust core
+// downloads the new version into the app's cache (cache/updates) and checks its size and SHA-256
+// against the signed version policy. The system installer gets the file only if it is also this
+// app: an APK with another package name would install beside this one as a new app, since Android
+// compares signing certificates only within one package.
+
+/**
+ * Serves cache/updates only (res/xml/hjv_update_paths.xml). A class of its own, so that the
+ * manifest of the Google Play bundle can remove exactly this provider, together with
+ * REQUEST_INSTALL_PACKAGES: an app from Google Play updates through Play only.
+ */
+class HjvUpdateFileProvider : FileProvider()
+
+private const val HJV_UPDATE_TAG = "hjvUpdate"
+
+/**
+ * MainActivity's "hjv_install_apk", with the path of the APK the core checked. Answers "ok" once
+ * Android was asked to open the system installer (from Android 10 on it opens none for an app in
+ * the background, so the screen asks only while the app is in front), "permission" while this
+ * app may not ask to install apps (Android 8 and later), "mismatch" when the file is not this app
+ * (it is deleted then), and "failed" otherwise. Android before 7.0 takes no content URI; the
+ * screen sends it to the browser instead.
+ */
+fun hjvInstallApk(activity: Activity, path: Any?, result: MethodChannel.Result) {
+    val apk = (path as? String)?.let { hjvUpdateFile(activity, it) }
+    if (apk == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.N) {
+        result.success("failed")
+        return
+    }
+    // reading an archive's certificates verifies its signature over the whole file
+    thread(name = "hjv-update-install") {
+        val same = try {
+            hjvSameApp(activity, apk)
+        } catch (e: Exception) {
+            Log.w(HJV_UPDATE_TAG, "the APK could not be read", e)
+            null
+        }
+        if (same == false) apk.delete()
+        activity.runOnUiThread {
+            result.success(
+                when (same) {
+                    true -> hjvOpenInstaller(activity, apk)
+                    false -> "mismatch"
+                    null -> "failed"
+                }
+            )
+        }
+    }
+}
+
+/** The file at `path` if it is an APK right in cache/updates, where the core writes. */
+private fun hjvUpdateFile(activity: Activity, path: String): File? = try {
+    val folder = File(activity.cacheDir, "updates").canonicalFile
+    File(path).canonicalFile.takeIf {
+        it.parentFile == folder && it.name.endsWith(".apk") && it.isFile
+    }
+} catch (e: Exception) {
+    null
+}
+
+/**
+ * Whether the APK has this app's package name and the signing certificates of the installed app.
+ * When Android reads no certificates from the archive, the package name decides: Android then
+ * installs it only as an update that is signed like the installed app.
+ */
+@Suppress("DEPRECATION")
+private fun hjvSameApp(activity: Activity, apk: File): Boolean {
+    val manager = activity.packageManager
+    // some versions read an archive's certificates for GET_SIGNATURES only
+    val flags = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+        PackageManager.GET_SIGNING_CERTIFICATES or PackageManager.GET_SIGNATURES
+    } else {
+        PackageManager.GET_SIGNATURES
+    }
+    val archive = manager.getPackageArchiveInfo(apk.path, flags) ?: return false
+    if (archive.packageName != activity.packageName) return false
+    val signers = hjvSigners(archive) ?: return true
+    return signers == hjvSigners(manager.getPackageInfo(activity.packageName, flags))
+}
+
+/** The certificates a package is signed with now, as hex; null when Android gives none. */
+@Suppress("DEPRECATION")
+private fun hjvSigners(info: PackageInfo): Set<String>? {
+    val signatures = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+        info.signingInfo?.apkContentsSigners
+    } else {
+        info.signatures
+    }
+    return signatures?.map { it.toCharsString() }?.toSet()?.takeIf { it.isNotEmpty() }
+}
+
+private fun hjvOpenInstaller(activity: Activity, apk: File): String = try {
+    // before the permission: a Play bundle has neither the provider nor the permission
+    val uri = FileProvider.getUriForFile(activity, "${activity.packageName}.fileprovider", apk)
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O &&
+        !activity.packageManager.canRequestPackageInstalls()
+    ) {
+        "permission"
+    } else {
+        activity.startActivity(Intent(Intent.ACTION_VIEW).apply {
+            setDataAndType(uri, "application/vnd.android.package-archive")
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        })
+        "ok"
+    }
+} catch (e: Exception) {
+    Log.w(HJV_UPDATE_TAG, "the installer did not open", e)
+    "failed"
+}
diff --git a/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MainActivity.kt b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MainActivity.kt
index 08f1239..0230161 100644
--- a/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MainActivity.kt
+++ b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/MainActivity.kt
@@ -647,6 +647,7 @@ class MainActivity : FlutterActivity() {
                 "on_voice_call_closed" -> {
                     onVoiceCallClosed()
                 }
+                "hjv_install_apk" -> hjvInstallApk(this, call.arguments, result)
                 else -> {
                     result.error("-1", "No such method", null)
                 }
diff --git a/flutter/android/app/src/main/res/xml/hjv_update_paths.xml b/flutter/android/app/src/main/res/xml/hjv_update_paths.xml
new file mode 100644
index 0000000..5b993a3
--- /dev/null
+++ b/flutter/android/app/src/main/res/xml/hjv_update_paths.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- HJViewer: what HjvUpdateFileProvider may hand out, the update APK that the core downloads to
+     the app's cache (cache/updates) and nothing else. -->
+<paths>
+    <cache-path name="updates" path="updates/" />
+</paths>
