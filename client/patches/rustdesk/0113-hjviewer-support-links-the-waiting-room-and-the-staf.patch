+lazy_static::lazy_static! {
+    static ref ROOM: Mutex<Room> = Default::default();
+}
+/// Wakes the waiting thread from its wait after a failure (`Room.kicked`).
+static KICK: Condvar = Condvar::new();
+
+fn room() -> MutexGuard<'static, Room> {
+    ROOM.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// One waiting thread per process while a code of the login is open; a running one asks again now.
+fn start_waiting(room: &mut Room) {
+    if room.waiting {
+        room.kicked = true;
+        KICK.notify_all();
+        return;
+    }
+    let Some(server) = server() else {
+        return;
+    };
+    room.waiting = std::thread::Builder::new()
+        .name("hjv-support-wait".to_owned())
+        .spawn(move || wait_loop(&server))
+        .is_ok();
+}
+
+/// The waiting thread: one request at a time, each with the last `rev`, until no code of the
+/// login is open, the login changes or ends, or the server has no waiting room.
+fn wait_loop(server: &str) {
+    let mut failures = 0;
+    loop {
+        let token = LocalConfig::get_option("access_token");
+        let login = login_of(&token);
+        let rev = {
+            let mut room = room();
+            room.tidy(&login, Instant::now());
+            if token.is_empty() || !room.open() {
+                room.waiting = false;
+                return;
+            }
+            room.kicked = false;
+            room.rev
+        };
+        let sent = Instant::now();
+        let reply = ask(server, &token, rev, WAIT_TIMEOUT);
+        let mut room = room();
+        // a logout or another login while it was out: its answer is not the login's
+        if LocalConfig::get_option("access_token") != token {
+            continue;
+        }
+        let step = room.take_reply(
+            &login,
+            rev,
+            reply
+                .as_ref()
+                .map(|(status, text)| (*status, text.as_str())),
+            sent.elapsed(),
+            &mut failures,
+            Instant::now(),
+        );
+        match step {
+            Step::Now => {}
+            Step::After(pause) => {
+                if failures > 0 {
+                    hbb_common::throttled_log!(
+                        Duration::from_secs(60),
+                        debug,
+                        "support codes: the waiting room failed, again in {pause:?}"
+                    );
+                }
+                let _ = KICK
+                    .wait_timeout_while(room, pause, |room| !room.kicked)
+                    .unwrap_or_else(|e| e.into_inner());
+            }
+            Step::Stop => {
+                room.waiting = false;
+                return;
+            }
+        }
+    }
+}
+
+/// One waiting room request by the login (`rev` hjv-api's last, none for an answer at once):
+/// its status and body; None without an answer (or without an account key to sign it).
+fn ask(server: &str, token: &str, rev: Option<u64>, timeout: Duration) -> Option<(u16, String)> {
+    let target = match rev {
+        Some(rev) => format!("{WAIT_PATH}?rev={rev}"),
+        None => WAIT_PATH.to_owned(),
+    };
+    let proof = super::proof_header("GET", &target, b"", token)?;
+    let url = format!("https://{server}{target}");
+    let (status, date, text) = request(&url, token, &proof, None, timeout)?;
+    observe(&url, status, &date, &text);
+    Some((status, text))
+}
