+/// ctl.rs, before a support proof goes (S-02): whether hjv-api still takes this login, by an
+/// answer of the last FRESH or one waiting room request now. A lost device's login that the
+/// account ended gets 401 and the proof does not go; so does one hjv-api cannot be asked about.
+/// It blocks.
+pub(super) fn login_still_taken() -> bool {
+    let token = LocalConfig::get_option("access_token");
+    if token.is_empty() {
+        return false;
+    }
+    let login = login_of(&token);
+    let fresh = |room: &Room| {
+        room.fresh
+            .is_some_and(|(of, at)| of == login && at.elapsed() < FRESH)
+    };
+    if fresh(&room()) {
+        return true;
+    }
+    let Some(server) = server() else {
+        return false;
+    };
+    let reply = ask(&server, &token, None, CHECK_TIMEOUT);
+    let mut room = room();
+    if LocalConfig::get_option("access_token") != token {
+        return false;
+    }
+    let mut failures = 0;
+    room.take_reply(
+        &login,
+        None,
+        reply
+            .as_ref()
+            .map(|(status, text)| (*status, text.as_str())),
+        QUICK,
+        &mut failures,
+        Instant::now(),
+    );
+    fresh(&room)
+}
