+
+/// While a code of this window is waited for: once a second, a PC that entered a code whose S2 is
+/// closed brings S13 up (on the desktop in the main window, which also comes to the front). After
+/// a pause of the app (an iPhone in the background) the core is asked to ask again at once.
+void _watchArrivals() {
+  if (_arrivals != null) return;
+  _arrivalsTick = DateTime.now();
+  _arrivals = Timer.periodic(const Duration(seconds: 1), (timer) {
+    final now = DateTime.now();
+    final last = _arrivalsTick;
+    _arrivalsTick = now;
+    if (last != null && now.difference(last) > const Duration(seconds: 3)) {
+      unawaited(bind
+          .mainSetCommon(key: kHjvSupportWaitKick, value: '')
+          .catchError((Object e) => debugPrint('hjv: $e')));
+    }
+    final arrival = hjvSupportArrival(_commonSync(kHjvSupportArrived));
+    if (arrival != null &&
+        _slotsWaited.remove(arrival.slot) &&
+        !_slotsShown.contains(arrival.slot)) {
+      _arrivedDialog(_t, arrival.pc);
+    }
+    for (final slot in _slotsWaited.toList()) {
+      final wait = hjvSupportWait(_commonSync(hjvSupportWaitKey(slot))).state;
+      if (wait == 'login' && !_slotsShown.contains(slot)) {
+        // hjv-api ended the login: as an account request's 401 ends it (the notice tells it)
+        _slotsWaited.clear();
+        unawaited(gFFI.userModel.reset(resetOther: true));
+        break;
+      }
+      // used is left for the arrival above; the rest is over
+      if (wait != 'open' && wait != 'used') _slotsWaited.remove(slot);
+    }
+    if (_slotsWaited.isEmpty) {
+      timer.cancel();
+      _arrivals = null;
+    }
+  });
+}
