+/// The waiting room's main_get_common keys for `login` (the module's doc).
+fn room_common(room: &mut Room, login: &[u8; 32], key: &str, now: Instant) -> Option<String> {
+    room.tidy(login, now);
+    if key == "hjv-support-arrived" {
+        return Some(
+            room.arrived
+                .pop_front()
+                .map(|(slot, pc)| json!({ "slot": slot, "pc": pc }).to_string())
+                .unwrap_or_default(),
+        );
+    }
+    if let Some(slot) = key.strip_prefix("hjv-support-wait:") {
+        let slot = slot.parse::<u64>().ok();
+        return Some(
+            room.codes
+                .iter()
+                .find(|c| Some(c.slot) == slot)
+                .map(|c| match &c.state {
+                    State::Used(pc) => json!({ "state": "used", "pc": pc }),
+                    state => json!({ "state": state.name() }),
+                })
+                .map(|state| state.to_string())
+                .unwrap_or_default(),
+        );
+    }
+    let pc = key.strip_prefix("hjv-support-pc:")?;
+    Some(if room.pcs.contains_key(pc) { "Y" } else { "" }.to_owned())
+}
