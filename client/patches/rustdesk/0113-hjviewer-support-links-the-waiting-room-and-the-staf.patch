+/// From a 1.9 server (TV-W6), the made code's support link (`https://…`) and its slot in the
+/// waiting room; null from an older one, which gives neither (S2 stays as in 1.8.2).
+({String link, int slot})? hjvSupportCodeRoom(String result) {
+  try {
+    final value = jsonDecode(result);
+    if (value is Map && value['ok'] == true) {
+      final link = value['link'];
+      final slot = value['slot'];
+      if (link is String &&
+          link.startsWith('https://') &&
+          slot is int &&
+          slot > 0) {
+        return (link: link, slot: slot);
+      }
+    }
+  } catch (e) {
+    // no result
+  }
+  return null;
+}
+
+/// What the waiting room says of S2's code (hjvSupportWaitKey): `open`, `used` with the PC's ID,
+/// `over`, `login` (hjv-api's 401) or `off` (no waiting room); '' while the core knows nothing.
+({String state, String pc}) hjvSupportWait(String value) {
+  try {
+    final v = jsonDecode(value);
+    if (v is Map) {
+      final state = v['state'];
+      final pc = v['pc'];
+      if (state is String &&
+          const {'open', 'used', 'over', 'login', 'off'}.contains(state)) {
+        if (state != 'used') return (state: state, pc: '');
+        if (pc is String && pc.isNotEmpty) return (state: state, pc: pc);
+      }
+    }
+  } catch (e) {
+    // none
+  }
+  return (state: '', pc: '');
+}
+
+/// A code a PC used (kHjvSupportArrived): its slot and the PC's ID; null for none.
+({int slot, String pc})? hjvSupportArrival(String value) {
+  try {
+    final v = jsonDecode(value);
+    if (v is Map) {
+      final slot = v['slot'];
+      final pc = v['pc'];
+      if (slot is int && pc is String && pc.isNotEmpty) {
+        return (slot: slot, pc: pc);
+      }
+    }
+  } catch (e) {
+    // none
+  }
+  return null;
+}
