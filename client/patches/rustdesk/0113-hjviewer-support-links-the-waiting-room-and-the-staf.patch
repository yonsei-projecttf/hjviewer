+      '{"ok":true,"code":"K7M2-Q9XD","expires_in":600,"link":"/api/hjv/s/x","slot":2}',
+      '{"ok":true,"code":"K7M2-Q9XD","expires_in":600,"link":"$link","slot":0}',
+      '{"ok":false,"error":"busy","link":"$link","slot":2}',
+      '',
+      '<html>',
