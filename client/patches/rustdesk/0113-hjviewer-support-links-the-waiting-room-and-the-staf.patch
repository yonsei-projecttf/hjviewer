+// ---- the waiting room (1.9, TV-W6) ----
+
+#[derive(Clone, Debug, PartialEq)]
+enum State {
+    Open,
+    /// a PC with this ID used the code
+    Used(String),
+    Over,
+    /// hjv-api answered the login with 401
+    Login,
+    /// the server has no waiting room
+    Off,
+}
+
+impl State {
+    fn name(&self) -> &'static str {
+        match self {
+            State::Open => "open",
+            State::Used(_) => "used",
+            State::Over => "over",
+            State::Login => "login",
+            State::Off => "off",
+        }
+    }
+}
+
+/// A code this process made with a waiting number.
+struct Code {
+    slot: u64,
+    wait: String,
+    login: [u8; 32],
+    /// its ten minutes by this device's count, plus GRACE
+    open_until: Instant,
+    state: State,
+    ended: Option<Instant>,
+}
+
+impl Code {
+    fn end(&mut self, state: State, now: Instant) {
+        self.state = state;
+        self.ended = Some(now);
+    }
+}
+
+/// A PC that used one of the login's codes, until its ticket ends (the support PCs).
+struct SupportPc {
+    pk: [u8; 32],
+    until: Instant,
+    login: [u8; 32],
+}
+
+/// What hjv-api's waiting room says of one code.
+#[derive(Debug, PartialEq)]
+enum Seen {
+    Open,
+    Used {
+        pc: String,
+        pk: [u8; 32],
+        until_in: u64,
+    },
+    Over,
+}
+
+#[derive(Default)]
+struct Room {
+    last_slot: u64,
+    codes: Vec<Code>,
+    /// hjv-api's `rev` of the last answer
+    rev: Option<u64>,
+    /// codes a PC used, (slot, PC ID), until the screens read them
+    arrived: VecDeque<(u64, String)>,
+    pcs: HashMap<String, SupportPc>,
+    /// the waiting thread runs
+    waiting: bool,
+    /// the app asked to ask again now
+    kicked: bool,
+    /// when hjv-api last answered a request of this login (S-02)
+    fresh: Option<([u8; 32], Instant)>,
+}
+
+/// What the waiting thread does next.
+#[derive(Debug, PartialEq)]
+enum Step {
+    Now,
+    After(Duration),
+    Stop,
+}
+
+impl Room {
+    /// make(): a code of `login` that hjv-api gave a waiting number. The screens get the link as
+    /// the whole address and the code's slot; the waiting number stays here.
+    /// Without a waiting number (a server before 1.9, a login that changed meanwhile) the screens
+    /// get neither, as from 1.8.2's hjv-api.
+    fn made(
+        &mut self,
+        answer: &mut Value,
+        wait: Option<Value>,
+        server: &str,
+        login: &[u8; 32],
+        now: Instant,
+    ) {
+        let Some(made) = answer.as_object_mut() else {
+            return;
+        };
+        let (Some(Value::String(wait)), Some(Value::String(link)), Some(expires_in)) = (
+            wait,
+            made.remove("link"),
+            made.get("expires_in").and_then(Value::as_u64),
+        ) else {
+            return;
+        };
+        self.last_slot += 1;
+        let slot = self.last_slot;
+        made.insert("link".to_owned(), json!(format!("https://{server}{link}")));
+        made.insert("slot".to_owned(), json!(slot));
+        self.codes.push(Code {
+            slot,
+            wait,
+            login: *login,
+            open_until: now + Duration::from_secs(expires_in) + GRACE,
+            state: State::Open,
+            ended: None,
+        });
+    }
+
+    /// Drops what is not the login's (a logout, another login) and what is over; ends a code
+    /// whose time is up here.
+    fn tidy(&mut self, login: &[u8; 32], now: Instant) {
+        self.codes.retain(|c| {
+            &c.login == login
+                && c.ended
+                    .map_or(true, |at| now.saturating_duration_since(at) < KEEP_ENDED)
+        });
+        for c in self.codes.iter_mut() {
+            if c.state == State::Open && now >= c.open_until {
+                c.end(State::Over, now);
+            }
+        }
+        self.pcs
+            .retain(|_, pc| &pc.login == login && now < pc.until);
+        let codes = &self.codes;
+        self.arrived
+            .retain(|(slot, _)| codes.iter().any(|c| c.slot == *slot));
+        if self.fresh.is_some_and(|(of, _)| &of != login) {
+            self.fresh = None;
+        }
+    }
+
+    fn open(&self) -> bool {
+        self.codes.iter().any(|c| c.state == State::Open)
+    }
+
+    /// hjv-api's 200 to `login`.
+    fn answered(&mut self, login: &[u8; 32], rev: u64, seen: &HashMap<String, Seen>, now: Instant) {
+        self.rev = Some(rev);
+        self.fresh = Some((*login, now));
+        for c in self
+            .codes
+            .iter_mut()
+            .filter(|c| c.state == State::Open && &c.login == login)
+        {
+            match seen.get(&c.wait) {
+                Some(Seen::Open) => {}
+                Some(Seen::Used { pc, pk, until_in }) => {
+                    self.pcs.insert(
+                        pc.clone(),
+                        SupportPc {
+                            pk: *pk,
+                            until: now + Duration::from_secs(*until_in),
+                            login: *login,
+                        },
+                    );
+                    self.arrived.push_back((c.slot, pc.clone()));
+                    c.end(State::Used(pc.clone()), now);
+                }
+                // over, or gone from hjv-api's memory (it restarted): the code works no more
+                Some(Seen::Over) | None => c.end(State::Over, now),
+            }
+        }
+    }
+
+    /// The waiting room's answer `reply` to a request of `login` that carried `sent_rev` and
+    /// took `took`: what it says, and what comes next. `failures` counts the failed ones in a row.
+    fn take_reply(
+        &mut self,
+        login: &[u8; 32],
+        sent_rev: Option<u64>,
+        reply: Option<(u16, &str)>,
+        took: Duration,
+        failures: &mut u32,
+        now: Instant,
+    ) -> Step {
+        let fail = |failures: &mut u32| {
+            *failures = failures.saturating_add(1);
+            let doubled = RETRY_MIN.saturating_mul(1 << (*failures - 1).min(4));
+            Step::After(doubled.min(RETRY_MAX))
+        };
+        match reply {
+            Some((200, text)) => match read_wait(text) {
+                Some((rev, seen)) => {
+                    *failures = 0;
+                    self.answered(login, rev, &seen, now);
+                    if took < QUICK && sent_rev == Some(rev) {
+                        Step::After(RETRY_MIN)
+                    } else {
+                        Step::Now
+                    }
+                }
+                None => fail(failures),
+            },
+            // hjv-api ended the login: its codes say so, and its support PCs go
+            Some((401, _)) => {
+                for c in self
+                    .codes
+                    .iter_mut()
+                    .filter(|c| c.state == State::Open && &c.login == login)
+                {
+                    c.end(State::Login, now);
+                }
+                self.pcs.retain(|_, pc| &pc.login != login);
+                self.fresh = None;
+                Step::Stop
+            }
+            // a server without the waiting room, or the App Review account (`no_code`)
+            Some((403 | 404, _)) => {
+                for c in self.codes.iter_mut().filter(|c| c.state == State::Open) {
+                    c.end(State::Off, now);
+                }
+                Step::Stop
+            }
+            _ => fail(failures),
+        }
+    }
+}
+
+/// A waiting room answer: its `rev` and what it says of each code by its waiting number; None for
+/// an answer that is none. A `used` code whose PC is not sound counts as over.
+fn read_wait(text: &str) -> Option<(u64, HashMap<String, Seen>)> {
+    let answer: Value = serde_json::from_str(text).ok()?;
+    let rev = answer.get("rev")?.as_u64()?;
+    let mut seen = HashMap::new();
+    for code in answer.get("codes")?.as_array()? {
+        let Some(wait) = code
+            .get("wait")
+            .and_then(Value::as_str)
+            .filter(|wait| random_value(wait))
+        else {
+            continue;
+        };
+        let state = match code.get("state").and_then(Value::as_str) {
+            Some("open") => Seen::Open,
+            Some("over") => Seen::Over,
+            Some("used") => used(code).unwrap_or(Seen::Over),
+            _ => continue,
+        };
+        seen.insert(wait.to_owned(), state);
+    }
+    Some((rev, seen))
+}
+
+fn used(code: &Value) -> Option<Seen> {
+    let pc = code.get("pc")?.as_str().filter(|pc| pc_id(pc))?;
+    let pk = STANDARD
+        .decode(code.get("pk")?.as_str()?)
+        .ok()?
+        .try_into()
+        .ok()?;
+    let until_in = code
+        .get("until_in")?
+        .as_u64()
+        .filter(|until_in| (1..=MAX_UNTIL).contains(until_in))?;
+    Some(Seen::Used {
+        pc: pc.to_owned(),
+        pk,
+        until_in,
+    })
+}
