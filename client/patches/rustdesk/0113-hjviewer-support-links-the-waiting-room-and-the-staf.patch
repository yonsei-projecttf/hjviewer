+        assert_eq!(common(&mut room, "hjv-support-wait:x", now), "");
+        assert_eq!(common(&mut room, "hjv-support-arrived", now), "");
+        // the first request goes without a rev and is answered at once
+        let open = json!({"rev": 3, "codes": [{"wait": WAIT, "state": "open"}]}).to_string();
+        let step = room.take_reply(
+            &login(),
+            None,
+            Some((200, open.as_str())),
+            Duration::from_millis(50),
+            &mut failures,
+            now,
+        );
+        assert_eq!(step, Step::Now);
+        assert_eq!(room.rev, Some(3));
+        // the same rev back at once: hjv-api did not hold it, so a pause
+        let step = room.take_reply(
+            &login(),
+            Some(3),
+            Some((200, open.as_str())),
+            Duration::from_millis(50),
+            &mut failures,
+            now,
+        );
+        assert_eq!(step, Step::After(RETRY_MIN));
+        // held, then the PC came
+        let came = json!({"rev": 4, "codes": [used(WAIT, "123456789", 7190)]}).to_string();
+        let step = room.take_reply(
+            &login(),
+            Some(3),
+            Some((200, came.as_str())),
+            Duration::from_secs(4),
+            &mut failures,
+            now,
+        );
+        assert_eq!(step, Step::Now);
+        assert!(!room.open());
+        assert_eq!(
+            common(&mut room, "hjv-support-wait:1", now),
+            r#"{"pc":"123456789","state":"used"}"#
+        );
+        assert_eq!(
+            common(&mut room, "hjv-support-arrived", now),
+            r#"{"pc":"123456789","slot":1}"#
+        );
+        assert_eq!(common(&mut room, "hjv-support-arrived", now), "");
+        assert_eq!(common(&mut room, "hjv-support-pc:123456789", now), "Y");
+        assert_eq!(common(&mut room, "hjv-support-pc:555555555", now), "");
+        assert_eq!(
+            room.pcs["123456789"].pk.to_vec(),
+            STANDARD.decode(PK).unwrap()
+        );
+        // the waiting number is in no answer
+        for key in [
+            "hjv-support-wait:1",
+            "hjv-support-arrived",
+            "hjv-support-pc:123456789",
+        ] {
+            assert!(!common(&mut room, key, now).contains(WAIT), "{key}");
+        }
+        // a logout or another login: nothing of the login's is left
+        let other = login_of("another token");
+        assert_eq!(
+            room_common(&mut room, &other, "hjv-support-pc:123456789", now).as_deref(),
+            Some("")
+        );
+        assert!(room.codes.is_empty() && room.pcs.is_empty());
+        // the support PC goes when its ticket ends
+        let (mut room, _) = room_with_code(now);
+        room.take_reply(
+            &login(),
+            None,
+            Some((200, came.as_str())),
+            QUICK,
+            &mut failures,
+            now,
+        );
+        let later = now + Duration::from_secs(7190);
+        assert_eq!(common(&mut room, "hjv-support-pc:123456789", later), "");
+        // ...and the code a while after it ended
+        assert_eq!(
+            common(&mut room, "hjv-support-wait:1", now + KEEP_ENDED),
+            ""
+        );
+        assert_eq!(
+            room_common(&mut room, &login(), "hjv-support-other", now),
+            None
+        );
+    }
+
+    #[test]
+    fn an_ended_code_and_a_failing_waiting_room() {
+        let now = Instant::now();
+        let mut failures = 0;
+        // over, and gone from hjv-api's memory, both end the code
+        for answer in [
+            json!({"rev": 9, "codes": [{"wait": WAIT, "state": "over"}]}),
+            json!({"rev": 0, "codes": []}),
+        ] {
+            let (mut room, _) = room_with_code(now);
+            room.take_reply(
+                &login(),
+                Some(8),
+                Some((200, answer.to_string().as_str())),
+                QUICK,
+                &mut failures,
+                now,
+            );
+            assert_eq!(
+                room_common(&mut room, &login(), "hjv-support-wait:1", now).as_deref(),
+                Some(r#"{"state":"over"}"#)
+            );
+        }
+        // its ten minutes are up here too, with a minute for hjv-api's word
+        let (mut room, _) = room_with_code(now);
+        let up = now + Duration::from_secs(600) + GRACE;
+        assert_eq!(
+            room_common(&mut room, &login(), "hjv-support-wait:1", up).as_deref(),
+            Some(r#"{"state":"over"}"#)
+        );
+        // failures wait 3 s, doubled up to 30 s; an answer starts again
+        let (mut room, _) = room_with_code(now);
+        let waits: Vec<_> = [
+            None,
+            Some((500, "")),
+            Some((429, "")),
+            Some((200, "{")),
+            Some((409, "")),
+            None,
+            None,
+        ]
+        .into_iter()
+        .map(|reply| room.take_reply(&login(), None, reply, QUICK, &mut failures, now))
+        .collect();
+        let secs = |s: u64| Step::After(Duration::from_secs(s));
+        assert_eq!(
+            waits,
+            [
+                secs(3),
+                secs(6),
+                secs(12),
+                secs(24),
+                secs(30),
+                secs(30),
+                secs(30)
+            ]
+        );
+        assert!(room.open());
+        let open = json!({"rev": 1, "codes": [{"wait": WAIT, "state": "open"}]}).to_string();
+        room.take_reply(
+            &login(),
+            None,
+            Some((200, open.as_str())),
+            QUICK,
+            &mut failures,
+            now,
+        );
+        assert_eq!(failures, 0);
+        // hjv-api's 401: the screens end the login, its support PCs go, no more waiting
+        let came = json!({"rev": 2, "codes": [
+            {"wait": WAIT, "state": "open"},
+            used(WAIT_2, "123456789", 60),
+        ]})
+        .to_string();
+        let mut answer = outcome_of(
+            200,
+            json!({"code": "K7M2-Q9XE", "expires_in": 600, "link": LINK, "wait": WAIT_2}),
+        );
+        let wait = answer.as_object_mut().unwrap().remove("wait");
+        room.made(&mut answer, wait, "hjv.example", &login(), now);
+        assert_eq!(answer["slot"], 2);
+        room.take_reply(
+            &login(),
+            Some(1),
+            Some((200, came.as_str())),
+            QUICK,
+            &mut failures,
+            now,
+        );
+        assert_eq!(room.pcs.len(), 1);
+        assert!(room.fresh.is_some());
+        let step = room.take_reply(
+            &login(),
+            Some(2),
+            Some((401, "")),
+            QUICK,
+            &mut failures,
+            now,
+        );
+        assert_eq!(step, Step::Stop);
+        assert!(room.pcs.is_empty() && room.fresh.is_none());
+        assert_eq!(
+            room_common(&mut room, &login(), "hjv-support-wait:1", now).as_deref(),
+            Some(r#"{"state":"login"}"#)
+        );
+        // a server without the waiting room, or the App Review account: no waiting, no error
+        for status in [403, 404] {
+            let (mut room, _) = room_with_code(now);
+            let step = room.take_reply(
+                &login(),
+                None,
+                Some((status, "")),
+                QUICK,
+                &mut failures,
+                now,
+            );
+            assert_eq!(step, Step::Stop);
+            assert_eq!(
+                room_common(&mut room, &login(), "hjv-support-wait:1", now).as_deref(),
+                Some(r#"{"state":"off"}"#)
+            );
+        }
+    }
