@@ -1392,6 +1392,14 @@ where
     Ok(())
 }
 
+/// Whether `connect` failed because nothing serves the endpoint (no pipe or socket of that
+/// name), as opposed to an endpoint that is there but busy, refused or not trusted.
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+pub(crate) fn is_endpoint_missing(err: &hbb_common::anyhow::Error) -> bool {
+    err.downcast_ref::<std::io::Error>()
+        .map_or(false, |err| err.kind() == std::io::ErrorKind::NotFound)
+}
+
 #[inline]
 async fn connect_with_path(ms_timeout: u64, path: &str) -> ResultType<ConnectionTmpl<ConnClient>> {
     let client = timeout(ms_timeout, Endpoint::connect(path)).await??;
@@ -2305,6 +2313,21 @@ pub async fn set_install_option(k: String, v: String) -> ResultType<()> {
 mod test {
     use super::*;
 
+    #[cfg(not(any(target_os = "android", target_os = "ios")))]
+    #[test]
+    fn test_ipc_endpoint_missing_is_only_not_found() {
+        let missing: ResultType<()> =
+            Err(std::io::Error::from(std::io::ErrorKind::NotFound).into());
+        assert!(is_endpoint_missing(&missing.unwrap_err()));
+        let denied: ResultType<()> =
+            Err(std::io::Error::from(std::io::ErrorKind::PermissionDenied).into());
+        assert!(!is_endpoint_missing(&denied.unwrap_err()));
+        let refused: ResultType<()> = Err(hbb_common::anyhow::anyhow!(
+            "IPC server is not owned by the expected identity"
+        ));
+        assert!(!is_endpoint_missing(&refused.unwrap_err()));
+    }
+
     #[cfg(windows)]
     #[test]
     fn test_windows_protected_ipc_includes_connection_window() {
diff --git a/src/server/connection.rs b/src/server/connection.rs
index 150da35..8430e6b 100644
--- a/src/server/connection.rs
+++ b/src/server/connection.rs
@@ -6411,6 +6411,46 @@ pub fn claim_pending_switch_sides_uuid(id: &str, uuid: &uuid::Uuid) -> bool {
     false
 }
 
+#[cfg(not(any(target_os = "android", target_os = "ios")))]
+async fn start_cm_process() -> ResultType<()> {
+    let args = vec!["--cm"];
+    let run_done;
+    if crate::platform::is_root() {
+        let mut res = Ok(None);
+        for _ in 0..10 {
+            #[cfg(not(any(target_os = "linux")))]
+            {
+                log::debug!("Start cm");
+                res = crate::platform::run_as_user(args.clone());
+            }
+            #[cfg(target_os = "linux")]
+            {
+                log::debug!("Start cm");
+                res = crate::platform::run_as_user(args.clone(), None, None::<(&str, &str)>);
+            }
+            if res.is_ok() {
+                break;
+            }
+            log::error!("Failed to run cm: {res:?}");
+            sleep(1.).await;
+        }
+        if let Some(task) = res? {
+            super::CHILD_PROCESS.lock().unwrap().push(task);
+        }
+        run_done = true;
+    } else {
+        run_done = false;
+    }
+    if !run_done {
+        log::debug!("Start cm");
+        super::CHILD_PROCESS
+            .lock()
+            .unwrap()
+            .push(crate::run_me(args)?);
+    }
+    Ok(())
+}
+
