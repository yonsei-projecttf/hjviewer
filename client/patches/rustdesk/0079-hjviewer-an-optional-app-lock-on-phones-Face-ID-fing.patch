diff --git a/flutter/test/hjviewer_applock_test.dart b/flutter/test/hjviewer_applock_test.dart
new file mode 100644
index 0000000..2caa863
--- /dev/null
+++ b/flutter/test/hjviewer_applock_test.dart
@@ -0,0 +1,197 @@
+import 'package:flutter_hbb/common/hjviewer_applock_rules.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The optional app lock (W13): when it asks and what an answer does, without the bridge or the
+// plugin.
+
+final t0 = DateTime(2026, 10, 19, 9);
+DateTime at(int seconds) => t0.add(Duration(seconds: seconds));
+
+HjvAppLockPolicy on([Duration after = kHjvAppLockDefault]) =>
+    HjvAppLockPolicy(enabled: true, after: after);
+
+/// Locked, then unlocked with a successful prompt.
+HjvAppLockPolicy unlocked([Duration after = kHjvAppLockDefault]) {
+  final p = on(after)..start();
+  p.beginAuth();
+  p.endUnlock(HjvAuthOutcome.success);
+  return p;
+}
+
+void main() {
+  test('a cold start asks while the lock is on, and not while it is off', () {
+    final p = on();
+    expect(p.start(), isTrue);
+    expect(p.locked, isTrue);
+
+    final off = HjvAppLockPolicy(enabled: false);
+    expect(off.start(), isFalse);
+    expect(off.locked, isFalse);
+    off.background(at(0));
+    expect(off.foreground(at(3600)), isFalse);
+    expect(off.locked, isFalse);
+  });
+
+  test('a successful prompt unlocks; a failed or cancelled one keeps the lock', () {
+    final p = on()..start();
+    expect(p.beginAuth(), isTrue);
+    expect(p.beginAuth(), isFalse, reason: 'one prompt at a time');
+    expect(p.endUnlock(HjvAuthOutcome.failed), HjvAuthEnd.none);
+    expect(p.locked, isTrue);
+
+    expect(p.beginAuth(), isTrue);
+    expect(p.endUnlock(HjvAuthOutcome.success), HjvAuthEnd.unlocked);
+    expect(p.locked, isFalse);
+  });
+
+  test('a background shorter than the time does not ask; as long or longer does', () {
+    final p = unlocked();
+    p.background(at(0));
+    expect(p.foreground(at(59)), isFalse);
+    expect(p.locked, isFalse);
+
+    p.background(at(100));
+    expect(p.foreground(at(160)), isTrue);
+    expect(p.locked, isTrue);
+  });
+
+  test('바로 asks after any background; 5분 waits five minutes', () {
+    final now = unlocked(Duration.zero);
+    now.background(at(0));
+    expect(now.foreground(at(0)), isTrue);
+
+    final five = unlocked(const Duration(minutes: 5));
+    five.background(at(0));
+    expect(five.foreground(at(299)), isFalse);
+    five.background(at(400));
+    expect(five.foreground(at(700)), isTrue);
+  });
+
+  test('the background starts when the app left, and a clock that went back locks', () {
+    final p = unlocked();
+    p.background(at(0));
+    p.background(at(50)); // hidden, then paused
+    expect(p.foreground(at(61)), isTrue);
+
+    final q = unlocked();
+    q.background(at(100));
+    expect(q.foreground(at(10)), isTrue);
+  });
+
+  test('a return without a background (inactive only, e.g. Face ID) does not ask', () {
+    final p = unlocked(Duration.zero);
+    expect(p.foreground(at(10)), isFalse);
+    expect(p.locked, isFalse);
+  });
+
+  test('while locked, every return to the foreground asks again', () {
+    final p = on()..start();
+    p.background(at(0));
+    expect(p.foreground(at(1)), isTrue);
+  });
+
+  test('leaving for the prompt itself (the Android passcode screen) neither locks nor asks', () {
+    // the return comes after the answer
+    final p = unlocked(Duration.zero);
+    p.background(at(0));
+    expect(p.foreground(at(1)), isTrue);
+    p.beginAuth();
+    p.background(at(2));
+    expect(p.endUnlock(HjvAuthOutcome.failed), HjvAuthEnd.none);
+    expect(p.foreground(at(3)), isFalse, reason: 'no prompt loop after a cancel');
+    expect(p.locked, isTrue);
+
+    // the return comes before the answer; a later real background counts again
+    final q = unlocked(Duration.zero);
+    q.background(at(0));
+    q.foreground(at(1));
+    q.beginAuth();
+    q.background(at(2));
+    expect(q.foreground(at(3)), isFalse);
+    expect(q.endUnlock(HjvAuthOutcome.success), HjvAuthEnd.unlocked);
+    q.background(at(10));
+    expect(q.foreground(at(11)), isTrue);
+  });
+
+  test('a device without biometrics or a passcode cannot turn the lock on', () {
+    expect(hjvAuthOutcomeOf('NotAvailable'), HjvAuthOutcome.unavailable);
+    expect(hjvAuthOutcomeOf('PasscodeNotSet'), HjvAuthOutcome.unavailable);
+    expect(hjvAuthOutcomeOf('NotEnrolled'), HjvAuthOutcome.unavailable);
+    expect(hjvAuthOutcomeOf('no_fragment_activity'), HjvAuthOutcome.unavailable);
+    expect(hjvAuthOutcomeOf('LockedOut'), HjvAuthOutcome.failed);
+    expect(hjvAuthOutcomeOf('auth_in_progress'), HjvAuthOutcome.failed);
+
+    final p = HjvAppLockPolicy(enabled: false)..start();
+    expect(p.beginAuth(), isTrue);
+    expect(p.endSwitch(HjvAuthOutcome.unavailable, on: true), isFalse);
+    expect(p.enabled, isFalse);
+  });
+
+  test('turning the lock on or off takes one successful prompt', () {
+    final p = HjvAppLockPolicy(enabled: false)..start();
+    p.beginAuth();
+    expect(p.endSwitch(HjvAuthOutcome.failed, on: true), isFalse);
+    expect(p.enabled, isFalse);
+    p.beginAuth();
+    expect(p.endSwitch(HjvAuthOutcome.success, on: true), isTrue);
+    expect(p.enabled, isTrue);
+    expect(p.locked, isFalse, reason: 'turning it on does not lock the app');
+
+    p.beginAuth();
+    expect(p.endSwitch(HjvAuthOutcome.failed, on: false), isFalse);
+    expect(p.enabled, isTrue);
+    p.beginAuth();
+    expect(p.endSwitch(HjvAuthOutcome.success, on: false), isTrue);
+    expect(p.enabled, isFalse);
+    p.background(at(0));
+    expect(p.foreground(at(3600)), isFalse);
+  });
+
+  test('a device that lost its passcode is not kept out: the lock turns off', () {
+    final p = on()..start();
+    p.beginAuth();
+    expect(p.endUnlock(HjvAuthOutcome.unavailable), HjvAuthEnd.turnedOff);
+    expect(p.locked, isFalse);
+    expect(p.enabled, isFalse);
+  });
+
+  test('the stored time is one of the choices, else 1분', () {
+    expect(hjvAppLockAfter('0'), Duration.zero);
+    expect(hjvAppLockAfter('60'), const Duration(minutes: 1));
+    expect(hjvAppLockAfter('300'), const Duration(minutes: 5));
+    expect(hjvAppLockAfter(''), kHjvAppLockDefault);
+    expect(hjvAppLockAfter('42'), kHjvAppLockDefault);
+    expect(kHjvAppLockDefault, const Duration(minutes: 1));
+  });
+
+  test('the texts', () {
+    const ko = HjvAppLockTexts(true);
+    const en = HjvAppLockTexts(false);
+    expect(ko.title, '앱 잠금');
+    expect(en.title, 'App lock');
+    expect(ko.caption(HjvBiometricKind.generic), 'Face ID, 지문 또는 기기 암호로 앱을 엽니다.');
+    expect(en.caption(HjvBiometricKind.generic),
+        'Opens the app with Face ID, fingerprint or the device passcode.');
+    expect(ko.caption(HjvBiometricKind.touchId), contains('Touch ID'));
+    expect(en.caption(HjvBiometricKind.touchId), contains('Touch ID'));
+    expect([for (final d in kHjvAppLockChoices) ko.afterLabel(d)], ['바로', '1분', '5분']);
+    expect([for (final d in kHjvAppLockChoices) en.afterLabel(d)],
+        ['Immediately', '1 minute', '5 minutes']);
+    expect(ko.locked, '앱이 잠겨 있습니다');
+    expect(en.locked, 'HJViewer is locked');
+    expect(ko.unlock, '잠금 해제');
+    expect(en.unlock, 'Unlock');
+    for (final t in [ko, en]) {
+      for (final s in [
+        t.unlockReason,
+        t.turnOnReason,
+        t.turnOffReason,
+        t.unavailable,
+        t.turnedOff,
+      ]) {
+        expect(s, isNotEmpty);
+        expect(s.contains('{') || s.contains('}'), isFalse);
+      }
+    }
+  });
+}
