+/// HJViewer: getPlatformImage in one colour, for the soft tiles of the peer cards.
+Widget hjvPlatformIcon(String platform, double size, Color color) {
+  if (platform.isEmpty) return SizedBox(width: size, height: size);
+  if (platform == kPeerPlatformMacOS) {
+    platform = 'mac';
+  } else if (platform != kPeerPlatformLinux &&
+      platform != kPeerPlatformAndroid) {
+    platform = 'win';
+  } else {
+    platform = platform.toLowerCase();
+  }
+  return SvgPicture.asset('assets/$platform.svg',
+      height: size,
+      width: size,
+      colorFilter: ColorFilter.mode(color, BlendMode.srcIn));
+}
