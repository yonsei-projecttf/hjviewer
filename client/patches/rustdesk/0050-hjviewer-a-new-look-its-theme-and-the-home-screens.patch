+// HJViewer: the app's themes in its own look (hjv_style.dart). MyTheme.lightTheme and darkTheme
+// keep upstream's definitions and pass them through hjvRestyle, which sets the typeface and
+// replaces the colours and the shapes of the components; what upstream's definitions set and
+// this does not touch stays as it is. The roles stay upstream's: colorScheme.background is the
+// frame around the content (title and tab bars, side panels), scaffoldBackgroundColor the
+// content, cardColor a quiet grey block.
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import '../common.dart';
+import '../desktop/widgets/tabbar_widget.dart';
+import 'hjv_style.dart';
+
+ThemeData hjvRestyle(ThemeData base) {
+  final dark = base.brightness == Brightness.dark;
+  final p = dark ? HjvPalette.dark : HjvPalette.light;
+  final desktop = isDesktop || isWebDesktop;
+  final radius = BorderRadius.circular(HjvRadius.md);
+  final font = base.textTheme.apply(fontFamily: kHjvFont);
+  TextStyle? colored(TextStyle? s, Color color) => s?.copyWith(color: color);
+  final textTheme = font.copyWith(
+    titleLarge: colored(font.titleLarge, p.text)
+        ?.copyWith(fontWeight: FontWeight.w700, letterSpacing: -0.2),
+    titleMedium: colored(font.titleMedium, p.text),
+    titleSmall: colored(font.titleSmall, p.text),
+    bodyLarge: colored(font.bodyLarge, p.text),
+    bodyMedium: colored(font.bodyMedium, p.text),
+    bodySmall: colored(font.bodySmall, p.textSecondary),
+  );
+  final noBorder = OutlineInputBorder(
+    borderRadius: radius,
+    borderSide: const BorderSide(color: Colors.transparent, width: 0),
+  );
+  return base.copyWith(
+    textTheme: textTheme,
+    primaryTextTheme: base.primaryTextTheme.apply(fontFamily: kHjvFont),
+    primaryColor: p.primary,
+    scaffoldBackgroundColor: p.surface,
+    canvasColor: p.surface,
+    dialogBackgroundColor: p.card,
+    cardColor: p.fill,
+    hoverColor: p.hover,
+    hintColor: p.textTertiary,
+    dividerColor: p.border,
+    iconTheme: base.iconTheme.copyWith(color: p.textSecondary),
+    colorScheme: base.colorScheme.copyWith(
+      primary: p.primary,
+      onPrimary: Colors.white,
+      primaryContainer: p.primarySoft,
+      onPrimaryContainer: p.primary,
+      secondary: p.primary,
+      onSecondary: Colors.white,
+      // upstream's widgets read the frame colour from colorScheme.background
+      // ignore: deprecated_member_use
+      background: p.canvas,
+      // ignore: deprecated_member_use
+      onBackground: p.text,
+      surface: p.surface,
+      onSurface: p.text,
+      surfaceContainerHighest: p.fill,
+      onSurfaceVariant: p.textSecondary,
+      outline: p.border,
+      error: p.danger,
+    ),
+    appBarTheme: AppBarTheme(
+      backgroundColor: p.surface,
+      foregroundColor: p.text,
+      elevation: 0,
+      scrolledUnderElevation: 0,
+      shadowColor: Colors.transparent,
+      centerTitle: true,
+      iconTheme: IconThemeData(color: p.text),
+      actionsIconTheme: IconThemeData(color: p.textSecondary),
+      titleTextStyle: TextStyle(
+          fontFamily: kHjvFont,
+          fontSize: 17,
+          fontWeight: FontWeight.w700,
+          color: p.text),
+      shape: Border(bottom: BorderSide(color: p.border)),
+      systemOverlayStyle:
+          dark ? SystemUiOverlayStyle.light : SystemUiOverlayStyle.dark,
+    ),
+    dialogTheme: DialogTheme(
+      backgroundColor: p.card,
+      elevation: 12,
+      shadowColor: Colors.black.withOpacity(dark ? 0.6 : 0.18),
+      shape: RoundedRectangleBorder(
+        borderRadius: BorderRadius.circular(HjvRadius.xl),
+        side: BorderSide(color: p.border),
+      ),
+      titleTextStyle: TextStyle(
+          fontFamily: kHjvFont,
+          fontSize: 18,
+          fontWeight: FontWeight.w700,
+          color: p.text),
+    ),
+    inputDecorationTheme: InputDecorationTheme(
+      filled: true,
+      fillColor: p.fill,
+      isDense: desktop,
+      hintStyle: TextStyle(color: p.textTertiary),
+      contentPadding: desktop
+          ? const EdgeInsets.symmetric(horizontal: 12, vertical: 11)
+          : const EdgeInsets.symmetric(horizontal: 14, vertical: 14),
+      border: noBorder,
+      enabledBorder: noBorder,
+      disabledBorder: noBorder,
+      focusedBorder: OutlineInputBorder(
+        borderRadius: radius,
+        borderSide: BorderSide(color: p.primary, width: 1.5),
+      ),
+      errorBorder: OutlineInputBorder(
+        borderRadius: radius,
+        borderSide: BorderSide(color: p.danger),
+      ),
+      focusedErrorBorder: OutlineInputBorder(
+        borderRadius: radius,
+        borderSide: BorderSide(color: p.danger, width: 1.5),
+      ),
+    ),
+    elevatedButtonTheme: ElevatedButtonThemeData(
+      style: ElevatedButton.styleFrom(
+        backgroundColor: p.primary,
+        foregroundColor: Colors.white,
+        disabledBackgroundColor: p.fill,
+        disabledForegroundColor: p.textDisabled,
+        elevation: 0,
+        shadowColor: Colors.transparent,
+        textStyle: const TextStyle(
+            fontFamily: kHjvFont, fontWeight: FontWeight.w600),
+        shape: RoundedRectangleBorder(borderRadius: radius),
+        splashFactory: desktop ? NoSplash.splashFactory : null,
+      ),
+    ),
+    outlinedButtonTheme: OutlinedButtonThemeData(
+      style: OutlinedButton.styleFrom(
+        backgroundColor: p.card,
+        foregroundColor: p.text,
+        disabledForegroundColor: p.textDisabled,
+        side: BorderSide(color: p.borderStrong),
+        textStyle: const TextStyle(
+            fontFamily: kHjvFont, fontWeight: FontWeight.w600),
+        shape: RoundedRectangleBorder(borderRadius: radius),
+        splashFactory: desktop ? NoSplash.splashFactory : null,
+      ),
+    ),
+    textButtonTheme: TextButtonThemeData(
+      style: TextButton.styleFrom(
+        foregroundColor: p.primary,
+        disabledForegroundColor: p.textDisabled,
+        textStyle: const TextStyle(
+            fontFamily: kHjvFont, fontWeight: FontWeight.w600),
+        padding: desktop
+            ? null
+            : const EdgeInsets.symmetric(
+                horizontal: MyTheme.mobileTextButtonPaddingLR),
+        shape: RoundedRectangleBorder(borderRadius: radius),
+        splashFactory: desktop ? NoSplash.splashFactory : null,
+      ),
+    ),
+    checkboxTheme: base.checkboxTheme.copyWith(
+      fillColor: WidgetStateProperty.resolveWith((states) =>
+          states.contains(WidgetState.selected) ? p.primary : null),
+      checkColor: const WidgetStatePropertyAll(Colors.white),
+      side: BorderSide(color: p.borderStrong, width: 1.5),
+      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(4)),
+    ),
+    radioTheme: base.radioTheme.copyWith(
+      fillColor: WidgetStateProperty.resolveWith((states) =>
+          states.contains(WidgetState.selected) ? p.primary : p.textTertiary),
+    ),
+    switchTheme: base.switchTheme.copyWith(
+      thumbColor: WidgetStateProperty.resolveWith((states) =>
+          states.contains(WidgetState.selected)
+              ? Colors.white
+              : (dark ? p.textSecondary : Colors.white)),
+      trackColor: WidgetStateProperty.resolveWith((states) =>
+          states.contains(WidgetState.selected) ? p.primary : p.borderStrong),
+    ),
+    listTileTheme: base.listTileTheme.copyWith(
+      shape: RoundedRectangleBorder(borderRadius: radius),
+    ),
+    popupMenuTheme: PopupMenuThemeData(
+      color: p.card,
+      elevation: 8,
+      shadowColor: Colors.black.withOpacity(dark ? 0.5 : 0.12),
+      textStyle: TextStyle(fontFamily: kHjvFont, fontSize: 14, color: p.text),
+      shape: RoundedRectangleBorder(
+        borderRadius: BorderRadius.circular(12),
+        side: BorderSide(color: p.border),
+      ),
+    ),
+    menuTheme: MenuThemeData(
+      style: MenuStyle(
+        backgroundColor: WidgetStatePropertyAll(p.card),
+        surfaceTintColor: const WidgetStatePropertyAll(Colors.transparent),
+        elevation: const WidgetStatePropertyAll(8),
+        shape: WidgetStatePropertyAll(RoundedRectangleBorder(
+          borderRadius: BorderRadius.circular(12),
+          side: BorderSide(color: p.border),
+        )),
+      ),
+    ),
+    menuBarTheme: MenuBarThemeData(
+      style: MenuStyle(backgroundColor: WidgetStatePropertyAll(p.card)),
+    ),
+    tooltipTheme: base.tooltipTheme.copyWith(
+      decoration: BoxDecoration(
+        color: dark ? const Color(0xFFE6E9EE) : const Color(0xFF2B313B),
+        borderRadius: BorderRadius.circular(HjvRadius.sm),
+      ),
+      textStyle: TextStyle(
+          fontFamily: kHjvFont,
+          fontSize: 12,
+          color: dark ? const Color(0xFF191F28) : Colors.white),
+    ),
+    tabBarTheme: base.tabBarTheme.copyWith(
+      labelColor: p.text,
+      unselectedLabelColor: p.textTertiary,
+      indicatorColor: p.primary,
+      labelStyle:
+          const TextStyle(fontFamily: kHjvFont, fontWeight: FontWeight.w600),
+      unselectedLabelStyle: const TextStyle(fontFamily: kHjvFont),
+    ),
+    dividerTheme: base.dividerTheme.copyWith(color: p.border),
+    bottomNavigationBarTheme: BottomNavigationBarThemeData(
+      backgroundColor: p.surface,
+      elevation: 0,
+      selectedItemColor: p.primary,
+      unselectedItemColor: p.textTertiary,
+      selectedLabelStyle: const TextStyle(
+          fontFamily: kHjvFont, fontSize: 12, fontWeight: FontWeight.w600),
+      unselectedLabelStyle:
+          const TextStyle(fontFamily: kHjvFont, fontSize: 12),
