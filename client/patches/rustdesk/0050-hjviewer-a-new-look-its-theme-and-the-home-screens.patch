diff --git a/flutter/lib/common/hjv_style.dart b/flutter/lib/common/hjv_style.dart
new file mode 100644
index 0000000..be50659
--- /dev/null
+++ b/flutter/lib/common/hjv_style.dart
@@ -0,0 +1,187 @@
+// HJViewer: the look of the app (2026-10). The colours, shapes and text the themes in common.dart
+// (MyTheme.lightTheme, MyTheme.darkTheme) are built from, and the few decorations the screens
+// share: a calm canvas with white (in the dark theme, slightly lifted) cards, thin borders
+// instead of shadows, rounded corners, the app icon's blue as the one accent, and the Pretendard
+// typeface (SIL Open Font License 1.1, assets/fonts) on every platform, so Windows, Android and
+// iOS read alike. Plain Flutter without the bridge.
+
+import 'package:flutter/material.dart';
+
+/// The typeface every text uses, bundled in assets/fonts (Regular 400, SemiBold 600, Bold 700).
+const String kHjvFont = 'Pretendard';
+
+/// One theme's colours.
+class HjvPalette {
+  /// the app icon's blue, and its darker and its faint tint
+  final Color primary;
+  final Color primaryStrong;
+  final Color primarySoft;
+
+  /// the frame around the content (title and tab bars, side panels: colorScheme.background), the
+  /// content (scaffoldBackgroundColor), a card on the content, and the fill of fields
+  final Color canvas;
+  final Color surface;
+  final Color card;
+  final Color fill;
+
+  /// thin lines: around cards and between sections
+  final Color border;
+  final Color borderStrong;
+
+  /// text, from the most to the least prominent
+  final Color text;
+  final Color textSecondary;
+  final Color textTertiary;
+  final Color textDisabled;
+
+  final Color success;
+  final Color warning;
+  final Color danger;
+
+  /// the hover of a row or an icon button
+  final Color hover;
+
+  const HjvPalette({
+    required this.primary,
+    required this.primaryStrong,
+    required this.primarySoft,
+    required this.canvas,
+    required this.surface,
+    required this.card,
+    required this.fill,
+    required this.border,
+    required this.borderStrong,
+    required this.text,
+    required this.textSecondary,
+    required this.textTertiary,
+    required this.textDisabled,
+    required this.success,
+    required this.warning,
+    required this.danger,
+    required this.hover,
+  });
+
+  static const light = HjvPalette(
+    primary: Color(0xFF1E6FD9),
+    primaryStrong: Color(0xFF1659BE),
+    primarySoft: Color(0xFFEAF2FE),
+    canvas: Color(0xFFF3F5F8),
+    surface: Color(0xFFFFFFFF),
+    card: Color(0xFFFFFFFF),
+    fill: Color(0xFFF1F3F6),
+    border: Color(0xFFE5E8EC),
+    borderStrong: Color(0xFFD1D6DD),
+    text: Color(0xFF191F28),
+    textSecondary: Color(0xFF4E5968),
+    textTertiary: Color(0xFF8B95A1),
+    textDisabled: Color(0xFFB0B8C1),
+    success: Color(0xFF12B76A),
+    warning: Color(0xFFF79009),
+    danger: Color(0xFFF04438),
+    hover: Color(0xFFEEF1F5),
+  );
+
+  static const dark = HjvPalette(
+    primary: Color(0xFF4C8DF0),
+    primaryStrong: Color(0xFF6CA2F4),
+    primarySoft: Color(0xFF1A2639),
+    canvas: Color(0xFF1A1D23),
+    surface: Color(0xFF121418),
+    card: Color(0xFF1A1D23),
+    fill: Color(0xFF242830),
+    border: Color(0xFF2A2E37),
+    borderStrong: Color(0xFF3A404B),
+    text: Color(0xFFECEFF3),
+    textSecondary: Color(0xFFB4BCC6),
+    textTertiary: Color(0xFF7E8794),
+    textDisabled: Color(0xFF555D69),
+    success: Color(0xFF32D583),
+    warning: Color(0xFFFDB022),
+    danger: Color(0xFFF97066),
+    hover: Color(0xFF242832),
+  );
+
+  static HjvPalette of(BuildContext context) =>
+      Theme.of(context).brightness == Brightness.dark ? dark : light;
+}
+
+/// Corner radii: small controls, fields and buttons, cards, dialogs and sheets.
+class HjvRadius {
+  static const double sm = 8;
+  static const double md = 10;
+  static const double lg = 14;
+  static const double xl = 20;
+}
+
+/// The text sizes and weights, without colours (the theme adds them).
+class HjvText {
+  static const TextStyle titleLarge =
+      TextStyle(fontSize: 20, fontWeight: FontWeight.w700, height: 1.3);
+  static const TextStyle titleMedium =
+      TextStyle(fontSize: 16, fontWeight: FontWeight.w600, height: 1.35);
+  static const TextStyle titleSmall =
+      TextStyle(fontSize: 14, fontWeight: FontWeight.w600, height: 1.35);
+  static const TextStyle body =
+      TextStyle(fontSize: 14, fontWeight: FontWeight.w400, height: 1.4);
+  static const TextStyle bodySmall =
+      TextStyle(fontSize: 12, fontWeight: FontWeight.w400, height: 1.35);
+  static const TextStyle label =
+      TextStyle(fontSize: 14, fontWeight: FontWeight.w600, height: 1.2);
+
+  /// Digits of the same width, so that an ID or a code does not jitter as it changes.
+  static const List<FontFeature> tabular = [FontFeature.tabularFigures()];
+
+  /// A device ID shown large (the home screen's own ID).
+  static const TextStyle idLarge = TextStyle(
+      fontSize: 26,
+      fontWeight: FontWeight.w700,
+      height: 1.2,
+      letterSpacing: 0.3,
+      fontFeatures: tabular);
+
+  /// A device ID typed into the connect field.
+  static const TextStyle idInput = TextStyle(
+      fontSize: 20,
+      fontWeight: FontWeight.w600,
+      height: 1.4,
+      letterSpacing: 0.3,
+      fontFeatures: tabular);
+}
+
+/// A card: the surface colour, a thin border and the large radius.
+BoxDecoration hjvCardDecoration(BuildContext context,
+    {Color? color, double radius = HjvRadius.lg, bool shadow = false}) {
+  final p = HjvPalette.of(context);
+  final dark = Theme.of(context).brightness == Brightness.dark;
+  return BoxDecoration(
+    color: color ?? p.card,
+    borderRadius: BorderRadius.circular(radius),
+    border: Border.all(color: p.border),
+    boxShadow: shadow
+        ? [
+            BoxShadow(
+              color: Colors.black.withOpacity(dark ? 0.35 : 0.06),
+              blurRadius: 16,
+              offset: const Offset(0, 4),
+            ),
+          ]
+        : null,
+  );
+}
+
+/// The soft background of an icon tile in a peer's colour (light: a pale tint, dark: a deep one),
+/// and the icon colour that reads on it.
+(Color, Color) hjvTint(BuildContext context, Color color) {
+  final dark = Theme.of(context).brightness == Brightness.dark;
+  final hsl = HSLColor.fromColor(color);
+  if (dark) {
+    return (
+      hsl.withSaturation((hsl.saturation * 0.55).clamp(0.0, 1.0)).withLightness(0.22).toColor(),
+      hsl.withSaturation((hsl.saturation * 0.9).clamp(0.0, 1.0)).withLightness(0.72).toColor(),
+    );
+  }
+  return (
+    hsl.withSaturation((hsl.saturation * 0.7).clamp(0.0, 1.0)).withLightness(0.93).toColor(),
+    hsl.withSaturation((hsl.saturation * 0.85).clamp(0.0, 1.0)).withLightness(0.42).toColor(),
+  );
+}
