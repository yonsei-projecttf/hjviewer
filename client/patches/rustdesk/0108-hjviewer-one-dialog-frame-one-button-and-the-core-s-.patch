+/// A button's part in its dialog or screen (U51, U10): the main action, a quiet one ([취소],
+/// [닫기]), another way ([로그인] beside [연결] in A1 with the field open, [이 PC 빼기] in the login
+/// notice), and an action that deletes or can lock a PC out.
+enum HjvButtonTone { primary, quiet, alt, danger }
+
+/// A button's height: the theme's (36 on a desktop), a screen's action (40: connecting, the
+/// [로그인] that stands in for the account) and a form's submit (44: the login, the update screen).
+enum HjvButtonSize {
+  normal(null),
+  screen(40),
+  form(44);
+
+  const HjvButtonSize(this.height);
+  final double? height;
+
+  /// The height as a ButtonStyle (null for the theme's).
+  ButtonStyle? get style => height == null
+      ? null
+      : ButtonStyle(
+          minimumSize: WidgetStatePropertyAll(Size(0, height!)),
+          visualDensity: VisualDensity.standard);
+}
+
+/// The desktop theme's buttons (hjv_theme.dart; Elevated, Outlined, Text): at least 36 high, 16
+/// at the sides, at the standard density (the platform's compact one drew them 28 high, below the
+/// fields beside them).
+const ButtonStyle kHjvDesktopButton = ButtonStyle(
+  minimumSize: WidgetStatePropertyAll(Size(0, 36)),
+  padding: WidgetStatePropertyAll(EdgeInsets.symmetric(horizontal: 16)),
+  visualDensity: VisualDensity.standard,
+);
+
+enum HjvButtonKind { elevated, outlined, text }
+
+/// What a button of `tone` is: on a desktop a filled button for the main action (danger's on the
+/// danger fill) and a bordered one for the quiet and the other way; on a phone a text button, the
+/// main action in the accent's colour and bold, the quiet one in the secondary text colour, the
+/// other way in the accent's colour at 600 (so that it does not read as [취소]), danger's in the
+/// danger text colour and bold. A null colour or weight is the theme's.
+({HjvButtonKind kind, Color? fill, Color? color, FontWeight? weight})
+    hjvButtonLook(HjvPalette p, HjvButtonTone tone, {required bool desktop}) {
+  if (desktop) {
+    return switch (tone) {
+      HjvButtonTone.primary =>
+        (kind: HjvButtonKind.elevated, fill: null, color: null, weight: null),
+      HjvButtonTone.quiet ||
+      HjvButtonTone.alt =>
+        (kind: HjvButtonKind.outlined, fill: null, color: null, weight: null),
+      HjvButtonTone.danger => (
+          kind: HjvButtonKind.elevated,
+          fill: p.dangerFill,
+          color: Colors.white,
+          weight: null
+        ),
+    };
+  }
+  final (color, weight) = switch (tone) {
+    HjvButtonTone.primary => (p.primary, FontWeight.w700),
+    HjvButtonTone.quiet => (p.textSecondary, FontWeight.w600),
+    HjvButtonTone.alt => (p.primary, FontWeight.w600),
+    HjvButtonTone.danger => (p.dangerText, FontWeight.w700),
+  };
+  return (kind: HjvButtonKind.text, fill: null, color: color, weight: weight);
+}
+
+/// The app's one button (dialog.dart's hjvButton, common.dart's dialogButton): `label` as it is,
+/// centred also on two lines, in hjvButtonLook's form for `desktop`, `size` high at least.
+/// `style` is the label's, `buttonStyle` is merged last.
+Widget hjvButtonFor(String label, VoidCallback? onPressed,
+        {HjvButtonTone tone = HjvButtonTone.primary,
+        HjvButtonSize size = HjvButtonSize.normal,
+        required bool desktop,
+        TextStyle? style,
+        ButtonStyle? buttonStyle}) =>
+    Builder(builder: (context) {
+      final look = hjvButtonLook(HjvPalette.of(context), tone, desktop: desktop);
+      final child = Text(label, textAlign: TextAlign.center, style: style);
+      switch (look.kind) {
+        case HjvButtonKind.elevated:
+          return ElevatedButton(
+              style: ElevatedButton.styleFrom(
+                      elevation: 0,
+                      backgroundColor: look.fill,
+                      foregroundColor: look.color)
+                  .merge(size.style)
+                  .merge(buttonStyle),
+              onPressed: onPressed,
+              child: child);
+        case HjvButtonKind.outlined:
+          return OutlinedButton(
+              style: size.style?.merge(buttonStyle) ?? buttonStyle,
+              onPressed: onPressed,
+              child: child);
+        case HjvButtonKind.text:
+          return TextButton(
+              style: TextButton.styleFrom(
+                      foregroundColor: look.color,
+                      textStyle: TextStyle(
+                          fontFamily: kHjvFont, fontWeight: look.weight))
+                  .merge(size.style)
+                  .merge(buttonStyle),
+              onPressed: onPressed,
+              child: child);
+      }
+    });
+
+/// The dialogs' widths (U50), for CustomAlertDialog's contentBoxConstraints: sm for a short
+/// confirm (delete, rename, turn off), md for the gate's, the account's and a session's dialogs,
+/// lg for the update screen and the login notice. Where the screen is narrower, the dialog's own
+/// bounds make it the screen's width. Upstream's dialogs keep their 500 at most.
+class HjvDialogWidth {
+  static const double sm = 360;
+  static const double md = 440;
+  static const double lg = 560;
+
+  static BoxConstraints box(double width) =>
+      BoxConstraints(minWidth: width, maxWidth: width);
+}
