+/// GET /api/hjv/access, at most once a minute: hjv-api asks hbbs at most every 30 seconds.
+Future<void> _askGateMode() async {
+  final asked = _gateAsked;
+  if (asked != null &&
+      DateTime.now().difference(asked) < const Duration(minutes: 1)) {
+    return;
+  }
+  _gateAsked = DateTime.now();
+  try {
+    final url = Uri.parse('${await bind.mainGetApiServer()}$kHjvAccessPath');
+    final resp = await http.get(url);
+    final mode = hjvGateModeOf(resp.statusCode, decode_http_response(resp));
+    if (mode != null) _gateMode.value = mode;
+  } catch (e) {
+    debugPrint('hjv: access mode: $e');
