             lastTapDownDetails.localPosition.dy);
@@ -504,6 +513,7 @@ class _RawTouchGestureDetectorRegionState
     if (isNotTouchBasedDevice()) {
       return;
     }
+    _scaleEndedWithFingerDown = d.pointerCount > 0;
