diff --git a/flutter/test/hjviewer_pins_test.dart b/flutter/test/hjviewer_pins_test.dart
new file mode 100644
index 0000000..bb0856f
--- /dev/null
+++ b/flutter/test/hjviewer_pins_test.dart
@@ -0,0 +1,31 @@
+import 'package:flutter_hbb/common/hjviewer_pins.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// What the settings leave out for what a build pins (src/hjviewer.rs), without the bridge.
+
+void main() {
+  test('a row is left out only while its option is fixed off', () {
+    expect(hjvPinnedOff(fixed: true, on: false), isTrue);
+    // a build that fixes the option on still shows it (the port row of direct IP access)
+    expect(hjvPinnedOff(fixed: true, on: true), isFalse);
+    expect(hjvPinnedOff(fixed: false, on: false), isFalse);
+  });
+
+  test('remote printing is offered only with the printer driver adapter', () {
+    expect(hjvOffersPrinter(windows: true, supportsDriver: 'true'), isTrue);
+    // is-support-printer-driver is false without the adapter (hjviewer builds) and before
+    // Windows 10
+    expect(hjvOffersPrinter(windows: true, supportsDriver: 'false'), isFalse);
+    expect(hjvOffersPrinter(windows: false, supportsDriver: 'true'), isFalse);
+  });
+
+  test('the connection tip of a pinned build names only the ID', () {
+    for (final t in [const HjvPinTexts(true), const HjvPinTexts(false)]) {
+      expect(t.idInputTip, isNot(matches(RegExp(r'IP|@|/r|[{}]'))));
+    }
+    expect(const HjvPinTexts(true).idInputTip,
+        '연결할 PC의 ID를 넣으세요. ID는 그 PC의 HJViewer 첫 화면에 있습니다.');
+    expect(const HjvPinTexts(false).idInputTip,
+        "Enter the ID of the PC to connect to. It is shown on that PC's HJViewer home screen.");
+  });
+}
