@@ -0,0 +1,26 @@
+// What a build pinned to the hjviewer server fixes or leaves out (src/hjviewer.rs), and what its
+// screens then leave out instead of offering it. Plain Dart without the bridge, so that ci.sh tests
+// it with the web stand-in; the call sites read the options and pass them in.
+
+/// A setting fixed off, as a pinned build fixes direct IP access, LAN discovery and the insecure
+/// TLS fallback, can never be turned on here: its row is left out rather than drawn grey, and so
+/// is the Discovered tab, which no PC of such a build answers.
+bool hjvPinnedOff({required bool fixed, required bool on}) => fixed && !on;
+
+/// Remote printing needs RustDesk's printer driver adapter, which hjviewer builds leave out
+/// (src/hjviewer.rs printer_adapter_present). [supportsDriver] is main_get_common's
+/// 'is-support-printer-driver'; without it the Printer tab and the permission are left out.
+bool hjvOffersPrinter({required bool windows, required String supportsDriver}) =>
+    windows && supportsDriver == 'true';
+
+class HjvPinTexts {
+  final bool korean;
+  const HjvPinTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  /// The connection box's tip where direct IP access is fixed off; upstream's id_input_tip
+  /// explains direct IPs, other servers and '/r'.
+  String get idInputTip => _t('연결할 PC의 ID를 넣으세요. ID는 그 PC의 HJViewer 첫 화면에 있습니다.',
+      "Enter the ID of the PC to connect to. It is shown on that PC's HJViewer home screen.");
+}
