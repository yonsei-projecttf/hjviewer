@@ -1,9 +1,11 @@
 // HJViewer: what the phone screens share: the size of a tap target and the plan of the peer
 // bar's right side (U57), the system bars' style of each theme (U61), and the rows of the
-// settings' "Network (advanced)" screen (U40). Plain Flutter without the bridge.
+// settings' "Network (advanced)" screen (U40), and an overlay dialog's back press and screen
+// reader scope (U63, U59). Plain Flutter without the bridge.
 
 import 'dart:math';
 
+import 'package:back_button_interceptor/back_button_interceptor.dart';
 import 'package:flutter/material.dart';
 import 'package:flutter/services.dart';
 
@@ -101,6 +103,32 @@ List<HjvNetworkRow> hjvPhoneNetworkRows({
       ],
     ];
 
+/// U63: a back press while a dialog of OverlayDialogManager.show is up (common.dart), under the
+/// dialog's tag. [onBack] is the dialog's own [취소] or [닫기], which an HJViewer dialog passes
+/// (also while it checks, as the button); without it a [backDismiss] dialog closes, and an
+/// upstream dialog does nothing, as before. Either way the press goes no further. Only the top
+/// dialog takes it: the interceptor added last runs first, and once one has taken the press the
+/// ones below are skipped; so is every dialog while the app lock holds back presses
+/// (hjviewer_applock.dart, which runs before them by its zIndex).
+void hjvAddDialogBack(String tag,
+        {VoidCallback? onBack,
+        bool backDismiss = false,
+        required VoidCallback close}) =>
+    BackButtonInterceptor.add((stopDefaultButtonEvent, routeInfo) {
+      if (onBack != null) {
+        onBack();
+      } else if (backDismiss) {
+        close();
+      }
+      return true;
+    }, name: tag, ifNotYetIntercepted: true);
+
+/// U59: an overlay dialog as a screen of its own for TalkBack, VoiceOver and Narrator: what is
+/// behind it leaves the semantics tree while it is up, as behind a dialog route. The mask is a
+/// plain colour, which has no semantics to exclude.
+Widget hjvDialogScope(Widget dialog) => BlockSemantics(
+    child: Semantics(scopesRoute: true, explicitChildNodes: true, child: dialog));
+
 /// The phone screens' own texts, Korean where translate() is Korean (hjviewer_labels.dart).
 class HjvPhoneTexts {
   final bool korean;
diff --git a/flutter/test/hjviewer_phone_test.dart b/flutter/test/hjviewer_phone_test.dart
index 76d9f39..d8c53e3 100644
--- a/flutter/test/hjviewer_phone_test.dart
+++ b/flutter/test/hjviewer_phone_test.dart
@@ -1,5 +1,6 @@
 import 'dart:io';
 
+import 'package:back_button_interceptor/back_button_interceptor.dart';
 import 'package:flutter/material.dart';
 import 'package:flutter_hbb/common/hjv_phone.dart';
 import 'package:flutter_hbb/common/hjv_style.dart';
@@ -150,4 +151,95 @@ void main() {
       expect(build, isNot(contains("translate('$row')")), reason: row);
     }
   });
+
+  testWidgets('a back press goes to the top dialog alone, its onBack first',
+      (tester) async {
+    var routePops = 0;
+    final routePop = BackButtonInterceptor.handlePopRouteFunction;
+    BackButtonInterceptor.handlePopRouteFunction = () async => routePops++;
+    addTearDown(() {
+      BackButtonInterceptor.removeAll();
+      BackButtonInterceptor.handlePopRouteFunction = routePop;
+    });
+    final did = <String>[];
+    // as OverlayDialogManager.show adds them: an upstream dialog, one that a back press closes,
+    // and an HJViewer dialog on top that passes its [취소]
+    hjvAddDialogBack('upstream', close: () => did.add('upstream closed'));
+    hjvAddDialogBack('below',
+        backDismiss: true, close: () => did.add('below closed'));
+    hjvAddDialogBack('top',
+        onBack: () => did.add('top cancelled'),
+        backDismiss: true,
+        close: () => did.add('top closed'));
+
+    await BackButtonInterceptor.popRoute();
+    expect(did, ['top cancelled']);
+    // the dialog's close takes its interceptor out (common.dart)
+    BackButtonInterceptor.removeByName('top');
+    await BackButtonInterceptor.popRoute();
+    expect(did, ['top cancelled', 'below closed']);
+    BackButtonInterceptor.removeByName('below');
+    // the upstream dialog does not close, and the route under it does not pop
+    await BackButtonInterceptor.popRoute();
+    expect(did, ['top cancelled', 'below closed']);
+    expect(routePops, 0);
+
+    // while the app lock holds back presses (hjviewer_applock.dart), no dialog takes one, also
+    // one shown after the lock came up
+    BackButtonInterceptor.add((stop, info) => true,
+        name: 'hjv-app-lock', zIndex: 1 << 30);
+    hjvAddDialogBack('later',
+        onBack: () => did.add('later cancelled'), close: () {});
+    await BackButtonInterceptor.popRoute();
+    expect(did, ['top cancelled', 'below closed']);
+    BackButtonInterceptor.removeByName('hjv-app-lock');
+    await BackButtonInterceptor.popRoute();
+    expect(did.last, 'later cancelled');
+
+    BackButtonInterceptor.removeAll();
+    await BackButtonInterceptor.popRoute();
+    expect(routePops, 1);
+  });
+
+  testWidgets('a screen reader stays inside an overlay dialog', (tester) async {
+    final semantics = tester.ensureSemantics();
+    final overlay = GlobalKey<OverlayState>();
+    await tester.pumpWidget(MaterialApp(
+        home: Overlay(key: overlay, initialEntries: [
+      OverlayEntry(
+          builder: (_) => Scaffold(
+              body: TextButton(onPressed: () {}, child: const Text('home')))),
+    ])));
+    List<String> read() => tester.semantics
+        .simulatedAccessibilityTraversal()
+        .map((node) => node.label)
+        .where((label) => label.isNotEmpty)
+        .toList();
+    expect(read(), contains('home'));
+
+    Widget dialog() => Container(
+        color: Colors.black12,
+        child: Center(
+            child: TextButton(onPressed: () {}, child: const Text('cancel'))));
+    // without the scope the home stays reachable behind the dialog
+    final plain = OverlayEntry(builder: (_) => dialog());
+    overlay.currentState!.insert(plain);
+    await tester.pump();
+    expect(read(), containsAll(['home', 'cancel']));
+    plain.remove();
+
+    final scoped = OverlayEntry(builder: (_) => hjvDialogScope(dialog()));
+    overlay.currentState!.insert(scoped);
+    await tester.pump();
+    expect(read(), contains('cancel'));
+    expect(read(), isNot(contains('home')));
+    expect(
+        tester.getSemantics(find.text('cancel')).getSemanticsData().label,
+        'cancel');
+
+    scoped.remove();
+    await tester.pump();
+    expect(read(), contains('home'));
+    semantics.dispose();
+  });
 }
