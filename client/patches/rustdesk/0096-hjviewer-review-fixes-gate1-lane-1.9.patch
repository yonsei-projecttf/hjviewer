+/// What a link to a PC does (hjvLinkAsk): `go` in a build not pinned and in the run after LK1's
+/// [연결] (`pass`); else LK1 first, but a phone where A0 is due goes on, A0 then with LK1's line.
+enum HjvLinkStep { go, askLk1, a0WithLine }
+
+HjvLinkStep hjvLinkStep(
+    {required bool pass,
+    required bool pinned,
+    required bool mobile,
+    required bool a0Due}) {
+  if (pass || !pinned) return HjvLinkStep.go;
+  return mobile && a0Due ? HjvLinkStep.a0WithLine : HjvLinkStep.askLk1;
+}
+
+/// Whether the link that `linked` (and since `at`) records is opening `target` now: the same
+/// session ID, within 30 seconds.
+bool hjvLinkPending(
+        {required String? linked,
+        required DateTime? at,
+        required String target,
+        required DateTime now}) =>
+    linked == target &&
+    at != null &&
+    now.difference(at) <= const Duration(seconds: 30);
+
+/// What connect() asks before a session (hjvAccessAskBeforeConnect): A0 when it is due (with
+/// LK1's line when a link is pending), LK1 when a phone's link skipped it for an A0 that is no
+/// longer due (the mode changed meanwhile, X-17), else nothing.
+enum HjvBeforeConnect { open, a0, lk1 }
+
+HjvBeforeConnect hjvBeforeConnect(
+        {required bool a0Due, required bool linkPending}) =>
+    a0Due
+        ? HjvBeforeConnect.a0
+        : linkPending
+            ? HjvBeforeConnect.lk1
+            : HjvBeforeConnect.open;
+
+/// A0's Enter: [연결] while the field is open with something typed (connect checks the rest),
+/// else [로그인] if there is one and nothing is being checked.
+enum HjvAskEnter { connect, logIn, none }
+
+HjvAskEnter hjvAskEnter(
+    {required bool open,
+    required String typed,
+    required bool canLogIn,
+    required bool busy}) {
+  if (open && typed.trim().isNotEmpty) return HjvAskEnter.connect;
+  return canLogIn && !busy ? HjvAskEnter.logIn : HjvAskEnter.none;
+}
