diff --git a/flutter/test/hjviewer_incoming_test.dart b/flutter/test/hjviewer_incoming_test.dart
new file mode 100644
index 0000000..8030922
--- /dev/null
+++ b/flutter/test/hjviewer_incoming_test.dart
@@ -0,0 +1,200 @@
+import 'dart:convert';
+
+import 'package:flutter_hbb/common/hjviewer_incoming_rules.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// TV-W9's incoming connections list (hjviewer_incoming_rules.dart): the service's answer, the
+// rows' lines and every text, without the bridge.
+
+const ko = HjvIncomingTexts(true);
+const en = HjvIncomingTexts(false);
+
+int secs(DateTime t) => t.millisecondsSinceEpoch ~/ 1000;
+
+HjvIncomingList parse(Object json) => hjvParseIncoming(jsonEncode(json));
+
+void main() {
+  group('the answer', () {
+    test('reads rows, newest first as given, and leaves out what is not a row',
+        () {
+      final list = parse({
+        'on': true,
+        'rows': [
+          {'t0': 200, 't1': 260, 'id': '123456789', 'kind': 'remote', 're': 2},
+          {'t1': 5},
+          'x',
+          {'t0': 100, 't1': null, 'end': 'open'},
+        ],
+      });
+      expect(list.state, HjvIncomingState.ok);
+      expect(list.rows.map((r) => r.t0), [200, 100]);
+      expect(list.rows.first.re, 2);
+      expect(list.rows.last.t1, isNull);
+    });
+
+    test('an IPC failure or a broken answer reads as an error', () {
+      expect(parse({'error': 'ipc'}).state, HjvIncomingState.error);
+      expect(hjvParseIncoming('').state, HjvIncomingState.error);
+      expect(
+          hjvParseIncoming('{"on":true,"rows":').state, HjvIncomingState.error);
+      expect(parse([1, 2]).state, HjvIncomingState.error);
+      expect(parse({'on': true}).state, HjvIncomingState.error);
+    });
+
+    test('a PC that does not record says so', () {
+      expect(parse({'on': false, 'rows': []}).state, HjvIncomingState.off);
+      expect(ko.off, contains('설치한 PC만'));
+    });
+
+    test('a name with control and bidi characters is not drawn as sent', () {
+      final row = parse({
+        'on': true,
+        'rows': [
+          {'t0': 1, 'name': 'Bob\n\u202Egnp.exe\u200B\u0007', 'id': '12\r3'},
+        ],
+      }).rows.single;
+      expect(row.name, 'Bobgnp.exe');
+      expect(row.id, '123');
+      expect(hjvIncomingClean('가' * 70, kHjvIncomingMaxName).length, 64);
+    });
+  });
+
+  group('the texts', () {
+    test(
+        'every stored value has its Korean and English words, an unknown one is unknown',
+        () {
+      const ends = [
+        'peer', 'pc', 'idle', 'service', 'switch', 'scope', 'revoked', //
+        'lost', 'other', 'unknown', 'open'
+      ];
+      const auths = [
+        'account',
+        'recent',
+        'otp',
+        'permanent',
+        'click',
+        'switch'
+      ];
+      const kinds = ['remote', 'file', 'camera', 'terminal', 'forward'];
+      for (final t in [ko, en]) {
+        for (final v in ends) {
+          expect(t.end(v), isNot(t.unknown), reason: v);
+        }
+        for (final v in auths) {
+          expect(t.auth(v), isNot(t.unknown), reason: v);
+        }
+        for (final v in kinds) {
+          expect(t.kind(v), isNot(t.unknown), reason: v);
+        }
+        expect(t.end('later'), t.unknown);
+        expect(t.auth(''), t.unknown);
+        expect(t.kind('x'), t.unknown);
+      }
+      expect(ko.end('pc'), '이 PC에서 끊음');
+      expect(
+          en.end('revoked'), 'Ended: the device was logged out of the account');
+      expect(ko.auth('click'), '이 PC에서 수락');
+      expect(en.kind('forward'), 'Port forwarding');
+    });
+
+    test('lengths', () {
+      expect(ko.duration(59), '1분 미만');
+      expect(en.duration(59), 'Under 1 min');
+      expect(ko.duration(60), '1분');
+      expect(en.duration(38 * 60), '38 min');
+      expect(ko.duration(65 * 60), '1시간 5분');
+      expect(en.duration(65 * 60), '1 h 5 min');
+      expect(ko.duration(2 * 86400 + 3 * 3600 + 59), '2일 3시간');
+      expect(en.duration(2 * 86400 + 3 * 3600), '2 d 3 h');
+    });
+
+    test('day headers: today, yesterday across midnight, then the date', () {
+      final now = DateTime(2026, 10, 20, 0, 0, 30);
+      expect(ko.day(DateTime(2026, 10, 20), now), '오늘');
+      expect(en.day(DateTime(2026, 10, 19), now), 'Yesterday');
+      expect(ko.day(DateTime(2026, 10, 17), now), '10월 17일 (토)');
+      expect(en.day(DateTime(2026, 10, 16), now), 'Fri, Oct 16');
+      expect(ko.day(DateTime(2025, 12, 30), now), '2025년 12월 30일 (화)');
+      expect(en.day(DateTime(2025, 12, 30), now), 'Tue, Dec 30, 2025');
+      final rows = [
+        HjvIncomingRow(t0: secs(DateTime(2026, 10, 20, 0, 0, 5))),
+        HjvIncomingRow(t0: secs(DateTime(2026, 10, 19, 23, 59, 59))),
+        HjvIncomingRow(t0: secs(DateTime(2026, 10, 19, 8))),
+      ];
+      final days = hjvIncomingDays(rows);
+      expect(days.map((d) => d.$1),
+          [DateTime(2026, 10, 20), DateTime(2026, 10, 19)]);
+      expect(days.last.$2.length, 2);
+    });
+  });
+
+  group('a row', () {
+    final t0 = secs(DateTime(2026, 10, 20, 14, 3));
+    final t1 = secs(DateTime(2026, 10, 20, 14, 41));
+
+    test('a password row: the times, the name the peer sent, unverified', () {
+      final row = HjvIncomingRow(
+          t0: t0,
+          t1: t1,
+          id: '123456789',
+          name: 'kim-pc',
+          auth: 'permanent',
+          kind: 'remote',
+          end: 'peer',
+          re: 1);
+      expect(ko.line1(row), '14:03–14:41 · 38분 · 원격 화면');
+      expect(en.line1(row), '14:03–14:41 · 38 min · Remote screen');
+      expect(ko.line2(row), 'kim-pc · 123 456 789');
+      expect(row.verified, isFalse);
+      expect(ko.line3(row), '확인되지 않은 이름 · 영구 비밀번호 · 상대가 끊음 · 다시 연결 1번');
+      expect(en.line3(row),
+          'Unverified name · Permanent password · Ended by the other device · Reconnected once');
+      expect(ko.spoken(row, DateTime(2026, 10, 20, 15)),
+          '오늘 ${ko.line1(row)}, ${ko.line2(row)}, ${ko.line3(row)}');
+    });
+
+    test(
+        'a same-account row: the signed device name and the mark with the masked owner',
+        () {
+      final row = HjvIncomingRow(
+          t0: t0,
+          id: '987654321',
+          name: 'typed name',
+          dev: 'iPhone 15',
+          own: '홍*동',
+          ver: 'same-account',
+          auth: 'account',
+          kind: 'file',
+          end: 'open');
+      expect(row.verified, isTrue);
+      expect(ko.line1(row), '14:03 · 파일 전송');
+      expect(ko.line2(row), 'iPhone 15 · 987 654 321');
+      expect(ko.line3(row), '같은 계정 확인됨 · 홍*동 · 같은 계정(비밀번호 없이) · 지금 연결 중');
+      expect(en.line3(row),
+          'Same account, verified · 홍*동 · Same account (no password) · Connected now');
+    });
+
+    test('a staff row has no name, only the ID and the staff mark', () {
+      final row = HjvIncomingRow(
+          t0: t0,
+          t1: t1,
+          id: '111222333',
+          name: 'should not show',
+          ver: 'staff',
+          auth: 'click',
+          kind: 'remote',
+          end: 'pc');
+      expect(row.verified, isTrue);
+      expect(ko.line2(row), '111 222 333');
+      expect(ko.line3(row), '연세대 교직원(로그인 확인) · 이 PC에서 수락 · 이 PC에서 끊음');
+      expect(en.line3(row),
+          'Yonsei faculty or staff (verified login) · Accepted on this PC · Ended on this PC');
+    });
+
+    test('an unknown mark is never drawn as verified', () {
+      const row = HjvIncomingRow(t0: 1, ver: 'admin', name: 'x');
+      expect(row.verified, isFalse);
+      expect(en.mark(row), 'Unverified name');
+    });
+  });
+}
