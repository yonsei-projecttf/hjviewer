 /// Pins the build to the hjviewer server named by `HJV_SERVER` / `HJV_SERVER_KEY` at build time;
-/// a build without `HJV_SERVER` behaves as upstream.
+/// a build without `HJV_SERVER` behaves as upstream, except that Android is controller-only.
 ///
 /// Signaling and relay go over WebSocket, `wss://<server>/ws/{id,relay}` on 443, the one port
 /// firewalls reliably let out, while WebRTC still connects peers directly wherever their networks
 /// allow it.
 pub fn apply() {
+    if cfg!(target_os = "android") {
+        controller_only();
+    }
     let Some(server) = SERVER.filter(|s| !s.is_empty()) else {
         return;
     };
@@ -78,6 +81,16 @@ pub(crate) fn pinned() -> bool {
     SERVER.is_some_and(|s| !s.is_empty())
 }
 
+/// Every Android build is controller-only, pinned or not: its manifest declares none of the
+/// services and permissions a controlled phone needs. Upstream's outgoing-only switch hides the
+/// screens that would start them.
+fn controller_only() {
+    config::HARD_SETTINGS
+        .write()
+        .unwrap()
+        .insert("conn-type".to_owned(), "outgoing".to_owned());
+}
+
 /// A heartbeat reply can rewrite options of every PC (`strategy`) and end its sessions
 /// (`disconnect`). The hjviewer server answers /api/heartbeat with 404, so such a reply could only
 /// come from a TLS interceptor that the TLS fallback let through; hjviewer builds drop both keys.
@@ -155,4 +168,13 @@ mod tests {
         let kept = rendezvous_token("token".to_owned());
         assert_eq!(kept, if pinned() { "" } else { "token" });
     }
+
+    #[test]
+    fn controller_only_is_upstreams_outgoing_only() {
+        assert!(!config::is_outgoing_only());
+        controller_only();
+        let outgoing_only = config::is_outgoing_only();
+        config::HARD_SETTINGS.write().unwrap().remove("conn-type");
+        assert!(outgoing_only);
+    }
 }
