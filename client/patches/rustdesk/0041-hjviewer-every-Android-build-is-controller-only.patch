diff --git a/flutter/test/hjviewer_android_test.dart b/flutter/test/hjviewer_android_test.dart
new file mode 100644
index 0000000..3954b69
--- /dev/null
+++ b/flutter/test/hjviewer_android_test.dart
@@ -0,0 +1,56 @@
+import 'dart:io';
+
+import 'package:flutter_hbb/common/hjviewer_android_rules.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// HJViewer's controller-only Android build, without the bridge.
+
+/// What a voice call does, in order.
+Future<List<String>> voiceCall(
+    {bool android = true, bool granted = false, bool allow = false}) async {
+  final steps = <String>[];
+  await hjvVoiceCall(
+    android: android,
+    granted: () async => granted,
+    explain: () => steps.add('explain'),
+    ask: () async {
+      steps.add('ask');
+      return allow;
+    },
+    call: () => steps.add('call'),
+  );
+  return steps;
+}
+
+void main() {
+  test('a voice call on Android asks for the microphone it lacks', () async {
+    expect(await voiceCall(allow: true), ['explain', 'ask', 'call']);
+    expect(await voiceCall(granted: true), ['call']);
+    expect(await voiceCall(android: false), ['call']);
+  });
+
+  test('a voice call is not made when the microphone is refused', () async {
+    expect(await voiceCall(), ['explain', 'ask']);
+  });
+
+  test('the Android manifest declares nothing of the controlled side', () {
+    final manifest =
+        File('android/app/src/main/AndroidManifest.xml').readAsStringSync();
+    for (final name in [
+      '.InputService',
+      '.MainService',
+      '.FloatingWindowService',
+      '.BootReceiver',
+      'BIND_ACCESSIBILITY_SERVICE',
+      'foregroundServiceType',
+      'FOREGROUND_SERVICE',
+      'SYSTEM_ALERT_WINDOW',
+      'REQUEST_IGNORE_BATTERY_OPTIMIZATIONS',
+      'RECEIVE_BOOT_COMPLETED',
+    ]) {
+      expect(manifest, isNot(contains(name)));
+    }
+    // a voice call from the phone records with it
+    expect(manifest, contains('android.permission.RECORD_AUDIO'));
+  });
+}
diff --git a/src/hjviewer.rs b/src/hjviewer.rs
index 1553bd6..c0bbd84 100644
--- a/src/hjviewer.rs
+++ b/src/hjviewer.rs
@@ -6,12 +6,15 @@ const SERVER: Option<&str> = option_env!("HJV_SERVER");
