index 0000000..8aeb094
--- /dev/null
+++ b/flutter/lib/common/hjviewer_android.dart
@@ -0,0 +1,17 @@
+// HJViewer's Android builds are controller-only (src/hjviewer.rs controller_only): upstream's
+// outgoing-only switch hides the controlled-side screens, and the hooks here do what a controller
+// still needed those screens for. The decisions are in hjviewer_android_rules.dart.
+
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/hjviewer_android_rules.dart';
+import 'package:flutter_hbb/consts.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+
+/// Requests a voice call, on Android once the microphone is allowed ([hjvVoiceCall]).
+Future<void> hjvRequestVoiceCall(SessionID sessionId) => hjvVoiceCall(
+      android: isAndroid,
+      granted: () => AndroidPermissionManager.check(kRecordAudio),
+      explain: () => showToast(translate('config_microphone')),
+      ask: () => AndroidPermissionManager.request(kRecordAudio),
+      call: () => bind.sessionRequestVoiceCall(sessionId: sessionId),
+    );
diff --git a/flutter/lib/common/hjviewer_android_rules.dart b/flutter/lib/common/hjviewer_android_rules.dart
new file mode 100644
index 0000000..8e1514c
--- /dev/null
+++ b/flutter/lib/common/hjviewer_android_rules.dart
@@ -0,0 +1,20 @@
+// What HJViewer's controller-only Android build decides, in plain Dart without the bridge, so that
+// ci.sh tests it with the web stand-in; hjviewer_android.dart wires it to the app.
+
+/// A voice call records with Android's microphone permission. The "Share screen" page was the one
+/// place that asked for it and a controller-only build does not show that page, so the call asks
+/// itself: [explain] says why, [ask] is Android's prompt, and without the permission [call] is
+/// not made. Other platforms call as before.
+Future<void> hjvVoiceCall({
+  required bool android,
+  required Future<bool> Function() granted,
+  required void Function() explain,
+  required Future<bool> Function() ask,
+  required void Function() call,
+}) async {
+  if (android && !await granted()) {
+    explain();
+    if (!await ask()) return;
+  }
+  call();
+}
