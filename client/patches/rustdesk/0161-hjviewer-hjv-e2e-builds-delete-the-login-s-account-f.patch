+/// hjv-api's deletion of the login's account (hjviewer_account.dart `_kDeleteAccountPath`), with
+/// the confirmation's fixed body.
+const ACCOUNT_DELETE: &str = "/api/hjv/account/delete";
+const ACCOUNT_DELETE_BODY: &str = r#"{"confirm":"delete-account"}"#;
+
+/// `--hjv-e2e-delete-account [again]`: [계정 삭제]'s request as http_request sends it, signed by
+/// the account hook H13 and its answer observed by H14 (which logs this device out on
+/// `"deleted":true`), and printed as `hjv-e2e: delete-account: HTTP <status> <body>`. With
+/// `again` the very same bytes go once more, as http_request_sync's own second try (the other TLS
+/// stack, the TCP proxy) sends them after an answer that was lost: `hjv-e2e: delete-account
+/// again: …`. Last, `hjv-e2e: after delete-account:` says whether the login's values are empty
+/// or kept, never what they are. Exit code 0 when the first answer was a 200.
+fn delete_account(again: bool) -> i32 {
+    let url = format!("{}{ACCOUNT_DELETE}", crate::ui_interface::get_api_server());
+    let mut headers = auth_headers();
+    headers["Content-Type"] = json!("application/json");
+    let Some((body, header)) = crate::hjviewer_account::prepare_account_request(
+        &url,
+        "post",
+        Some(ACCOUNT_DELETE_BODY.to_owned()),
+        headers.to_string(),
+    ) else {
+        println!("hjv-e2e: delete-account: hjv: account key unavailable");
+        return 1;
+    };
+    let mut code = 1;
+    for (what, send) in [("delete-account", true), ("delete-account again", again)] {
+        if !send {
+            continue;
+        }
+        let (u, b, h) = (url.clone(), body.clone(), header.clone());
+        // (http_request_sync starts a runtime of its own: on a thread of its own, as http_request)
+        let res = std::thread::spawn(move || {
+            crate::http_request_sync(u, "post".to_owned(), b, h).unwrap_or_else(|e| e.to_string())
+        })
+        .join()
+        .unwrap_or_else(|_| "the request's thread failed".to_owned());
+        crate::hjviewer_account::observe_account_response(&url, &res);
+        let answer = parse_result(res);
+        match &answer {
+            Answer::Http(status, body) => println!("hjv-e2e: {what}: HTTP {status} {body}"),
+            Answer::None(why) => println!("hjv-e2e: {what}: {why}"),
+        }
+        if what == "delete-account" {
+            code = i32::from(!matches!(answer, Answer::Http(200, _)));
+        }
+    }
+    let state = |key: &str| {
+        if LocalConfig::get_option(key).is_empty() {
+            "empty"
+        } else {
+            "kept"
+        }
+    };
+    println!(
+        "hjv-e2e: after delete-account: access_token {}, user_info {}, hjv-my-devices {}",
+        state("access_token"),
+        state("user_info"),
+        state("hjv-my-devices")
+    );
+    code
+}
