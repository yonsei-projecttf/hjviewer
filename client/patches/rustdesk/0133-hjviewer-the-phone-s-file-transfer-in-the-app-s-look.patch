+// HJViewer (U15): the phone's file transfer rows in the app's look. The same function as the
+// shared session look's hjvFileRowColors (common/hjv_session_look.dart); the merge keeps one.
+
+import 'package:flutter/material.dart';
+
+import 'hjv_style.dart';
+
+/// A row of the desktop file list, and of the phone's.
+({Color bg, Color name, Color icon, Color meta}) hjvFileRowColors(
+    BuildContext context,
+    {required bool selected}) {
+  final p = HjvPalette.of(context);
+  return selected
+      ? (
+          bg: p.primarySoft,
+          name: p.primaryStrong,
+          icon: p.primary,
+          meta: p.textSecondary
+        )
+      : (
+          bg: Colors.transparent,
+          name: p.text,
+          icon: p.textSecondary,
+          meta: p.textSecondary
+        );
+}
