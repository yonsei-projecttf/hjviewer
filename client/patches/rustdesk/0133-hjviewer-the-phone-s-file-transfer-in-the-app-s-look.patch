@@ -0,0 +1,42 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjv_phone_files_look.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The phone's file transfer rows (U15, common/hjv_phone_files_look.dart): the chosen row reads in
+// both themes. Plain Flutter, no bridge.
+
+double contrast(Color a, Color b) {
+  final la = a.computeLuminance();
+  final lb = b.computeLuminance();
+  final hi = la > lb ? la : lb;
+  final lo = la > lb ? lb : la;
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+void main() {
+  for (final (brightness, p) in [
+    (Brightness.light, HjvPalette.light),
+    (Brightness.dark, HjvPalette.dark),
+  ]) {
+    testWidgets('$brightness: a chosen row is faint blue with readable text',
+        (tester) async {
+      late BuildContext ctx;
+      await tester.pumpWidget(Theme(
+          data: ThemeData(brightness: brightness),
+          child: Builder(builder: (c) {
+            ctx = c;
+            return const SizedBox();
+          })));
+      final chosen = hjvFileRowColors(ctx, selected: true);
+      final plain = hjvFileRowColors(ctx, selected: false);
+      expect(chosen.bg, p.primarySoft);
+      expect(chosen.name, p.primaryStrong);
+      expect(plain.bg, Colors.transparent);
+      expect(plain.name, p.text);
+      expect(contrast(chosen.name, chosen.bg), greaterThanOrEqualTo(4.5));
+      expect(contrast(chosen.meta, chosen.bg), greaterThanOrEqualTo(4.5));
+      expect(contrast(plain.meta, p.surface), greaterThanOrEqualTo(4.5));
+    });
+  }
+}
