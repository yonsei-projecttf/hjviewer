+  // HJViewer: a tab of the sidebar as a rounded pill: primarySoft with the icon and the label in
+  // primary when selected, the canvas's hover colour (hoverStrong) under the pointer otherwise.
+  // Upstream's _listItem stays as it is, unused.
+  Widget _hjvListItem({required _TabInfo tab}) {
+    return Obx(() {
+      final p = HjvPalette.of(context);
+      final selected = tab.key == selectedTab.value;
+      final radius = BorderRadius.circular(HjvRadius.md);
+      return Padding(
+        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 2),
+        child: Material(
+          color: selected ? p.primarySoft : Colors.transparent,
+          borderRadius: radius,
+          child: InkWell(
+            borderRadius: radius,
+            // not transparent: a hover that turns transparent paints black
+            hoverColor: selected ? p.primarySoft : p.hoverStrong,
+            onTap: () {
+              if (selectedTab.value != tab.key) {
+                int index = DesktopSettingPage.tabKeys.indexOf(tab.key);
+                if (index == -1) {
+                  return;
+                }
+                controller.jumpToPage(index);
+              }
+              selectedTab.value = tab.key;
+            },
+            child: SizedBox(
+              height: _kTabHeight,
+              child: Row(children: [
+                Icon(
+                  selected ? tab.selected : tab.unselected,
+                  color: selected ? p.primary : p.textSecondary,
+                  size: 20,
+                ).marginOnly(left: 12, right: 12),
+                Expanded(
+                  child: Text(
+                    translate(tab.label),
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                    style: TextStyle(
+                        color: selected ? p.primary : p.textSecondary,
+                        fontWeight:
+                            selected ? FontWeight.w600 : FontWeight.w400,
+                        fontSize: _kContentFontSize),
+                  ),
+                ),
+              ]),
+            ),
+          ),
+        ),
+      );
+    });
+  }
 }
 
