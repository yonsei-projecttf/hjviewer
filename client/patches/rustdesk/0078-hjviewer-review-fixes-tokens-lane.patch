+  for (final (name, brightness, p) in [
+    ('light', Brightness.light, HjvPalette.light),
+    ('dark', Brightness.dark, HjvPalette.dark),
+  ]) {
+    final focused = OutlineInputBorder(borderSide: BorderSide(color: p.primary, width: 2));
+    final error = OutlineInputBorder(borderSide: BorderSide(color: p.danger));
+    final theme = ThemeData(
+        brightness: brightness,
+        inputDecorationTheme: InputDecorationTheme(
+            border: InputBorder.none,
+            enabledBorder: InputBorder.none,
+            focusedBorder: focused,
+            errorBorder: error,
+            focusedErrorBorder: focused));
+
+    test('$name high contrast: the fields get a thin textTertiary border, focus and error stay', () {
+      final hc = hjvHighContrast(theme);
+      for (final b in [hc.inputDecorationTheme.border, hc.inputDecorationTheme.enabledBorder]) {
+        expect(b, isA<OutlineInputBorder>());
+        final side = (b as OutlineInputBorder).borderSide;
+        expect((side.color, side.width), (p.textTertiary, 1.0));
+        expect(b.borderRadius, BorderRadius.circular(HjvRadius.md));
+      }
+      expect(hc.inputDecorationTheme.focusedBorder, same(focused));
+      expect(hc.inputDecorationTheme.errorBorder, same(error));
+      expect(hc.inputDecorationTheme.focusedErrorBorder, same(focused));
+      expect(hc.brightness, brightness);
+      expect(identical(hjvHighContrast(theme), hc), isTrue, reason: 'made once per theme');
+    });
+  }
