index 0000000..3572a25
--- /dev/null
+++ b/flutter/lib/common/hjv_phone.dart
@@ -0,0 +1,54 @@
+// HJViewer: what the phone screens share: the size of a tap target and the plan of the peer
+// bar's right side (U57), and the system bars' style of each theme (U61). Plain Flutter without
+// the bridge.
+
+import 'dart:math';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+
+import 'hjv_style.dart';
+
+/// The smallest tap target on a phone: iOS's 44 pt. What looks smaller (a 26 px icon box, a
+/// 32 px pill) keeps its look and gets a target of this size around it.
+const double kHjvPhoneTarget = 44;
+
+/// The peer bar on a phone: a tab's width (its pill is 40 x 32 in a target 44 high) and the
+/// width of the open search field.
+const double kHjvPhoneTabWidth = 40;
+const double kHjvPhoneSearchWidth = 120;
+
+/// How many of the peer bar's [actions] (refresh, select, sort, ...) show beside the search on a
+/// phone [width] wide with [tabs] tabs, each a [kHjvPhoneTarget] wide; the rest go under one
+/// "more" button. The plan keeps the room of the open search field, so opening it moves nothing.
+int hjvPhoneBarShownActions(
+    {required double width, required int tabs, required int actions}) {
+  // the page's 10 px margins and the bar's 2 px paddings
+  final room = width -
+      10 * 2 -
+      2 * 2 -
+      tabs * kHjvPhoneTabWidth -
+      kHjvPhoneSearchWidth;
+  final slots = room < 0 ? 0 : room ~/ kHjvPhoneTarget;
+  if (actions <= 1 || actions <= slots) return actions;
+  // one slot is the "more" button
+  return max(0, slots - 1);
+}
+
+/// The status and navigation bars of [dark] or light: the app's surface under the navigation bar
+/// with icons that read on it, a transparent status bar. Flutter's SystemUiOverlayStyle.dark and
+/// .light presets also paint the navigation bar black with light icons.
+SystemUiOverlayStyle hjvSystemUiOverlayStyle(bool dark) {
+  final p = dark ? HjvPalette.dark : HjvPalette.light;
+  final icons = dark ? Brightness.light : Brightness.dark;
+  return SystemUiOverlayStyle(
+    statusBarColor: Colors.transparent,
+    // Android reads the icons' brightness, iOS the bar's
+    statusBarIconBrightness: icons,
+    statusBarBrightness: dark ? Brightness.dark : Brightness.light,
+    systemNavigationBarColor: p.surface,
+    systemNavigationBarIconBrightness: icons,
+    systemNavigationBarDividerColor: p.border,
+    systemNavigationBarContrastEnforced: false,
+  );
+}
