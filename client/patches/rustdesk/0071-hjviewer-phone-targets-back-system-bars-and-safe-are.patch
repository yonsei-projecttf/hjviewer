diff --git a/flutter/test/hjviewer_phone_test.dart b/flutter/test/hjviewer_phone_test.dart
new file mode 100644
index 0000000..362f130
--- /dev/null
+++ b/flutter/test/hjviewer_phone_test.dart
@@ -0,0 +1,48 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjv_phone.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// HJViewer's phone targets and system bars, without the bridge.
+
+/// The width the peer bar's right side takes with the search field open.
+double openRight(int shown, int actions) =>
+    kHjvPhoneSearchWidth +
+    (shown + (shown < actions ? 1 : 0)) * kHjvPhoneTarget;
+
+void main() {
+  test('the peer bar fits its 44 px actions beside the open search', () {
+    // a 360 dp phone with four tabs: refresh, select and sort under "more"
+    expect(hjvPhoneBarShownActions(width: 360, tabs: 4, actions: 3), 0);
+    // a 393 dp phone: the refresh beside it
+    expect(hjvPhoneBarShownActions(width: 393, tabs: 4, actions: 3), 1);
+    // with three tabs all three fit at 412 dp; a lone action never folds
+    expect(hjvPhoneBarShownActions(width: 412, tabs: 3, actions: 3), 3);
+    expect(hjvPhoneBarShownActions(width: 320, tabs: 5, actions: 1), 1);
+    for (final width in [360.0, 375.0, 393.0, 412.0, 430.0]) {
+      for (var tabs = 1; tabs <= 4; tabs++) {
+        for (var actions = 0; actions <= 4; actions++) {
+          final shown = hjvPhoneBarShownActions(
+              width: width, tabs: tabs, actions: actions);
+          final room = width - 24 - tabs * kHjvPhoneTabWidth;
+          expect(openRight(shown, actions), lessThanOrEqualTo(room),
+              reason: '$width dp, $tabs tabs, $actions actions');
+        }
+      }
+    }
+  });
+
+  test('the navigation bar takes the surface and icons that read on it', () {
+    final light = hjvSystemUiOverlayStyle(false);
+    expect(light.systemNavigationBarColor, HjvPalette.light.surface);
+    expect(light.systemNavigationBarIconBrightness, Brightness.dark);
+    expect(light.statusBarIconBrightness, Brightness.dark);
+    expect(light.statusBarColor, Colors.transparent);
+    expect(light.systemNavigationBarContrastEnforced, isFalse);
+    final dark = hjvSystemUiOverlayStyle(true);
+    expect(dark.systemNavigationBarColor, HjvPalette.dark.surface);
+    expect(dark.systemNavigationBarIconBrightness, Brightness.light);
+    expect(dark.statusBarIconBrightness, Brightness.light);
+    expect(dark.systemNavigationBarDividerColor, HjvPalette.dark.border);
+  });
+}
