+// HJViewer UX-S4 (U36): tabs of text as the PC list's tab bar draws its pills (peer_tab_page.dart):
+// the selected one on the accent's faint tint in its strong text, the others in the secondary text
+// colour. They drive a TabController (the DefaultTabController's when none is given), so that a
+// TabBarView under them pages as under a TabBar. Plain Flutter without the bridge, so that ci.sh
+// tests it with the web stand-in (test/hjviewer_style_test.dart).
+
+import 'package:flutter/material.dart';
+
+import '../hjv_keys.dart';
+import '../hjv_semantics.dart';
+import '../hjv_style.dart';
+
+class HjvPillTabs extends StatelessWidget {
+  final List<String> labels;
+  final TabController? controller;
+  const HjvPillTabs({super.key, required this.labels, this.controller});
+
+  @override
+  Widget build(BuildContext context) {
+    final tabs = controller ?? DefaultTabController.of(context);
+    return AnimatedBuilder(
+      animation: tabs,
+      builder: (context, _) => Padding(
+        padding: const EdgeInsets.symmetric(vertical: 8),
+        child: Row(
+          children: [
+            for (var i = 0; i < labels.length; i++)
+              Flexible(
+                child: Padding(
+                  padding:
+                      EdgeInsets.only(right: i == labels.length - 1 ? 0 : 6),
+                  child: _HjvPill(
+                      label: labels[i],
+                      selected: tabs.index == i,
+                      onTap: () => tabs.animateTo(i)),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _HjvPill extends StatelessWidget {
+  final String label;
+  final bool selected;
+  final VoidCallback onTap;
+  const _HjvPill(
+      {required this.label, required this.selected, required this.onTap});
+
+  @override
+  Widget build(BuildContext context) {
+    final p = HjvPalette.of(context);
+    // the weight too, so that the choice does not rest on the colour alone (UX-K2)
+    final style = selected
+        ? HjvText.captionStrong.copyWith(color: p.primaryStrong)
+        : HjvText.caption.copyWith(height: 1.35, color: p.textSecondary);
+    return hjvSelectedSemantics(
+      selected: selected,
+      child: HjvFocusRing(
+        radius: BorderRadius.circular(16),
+        child: Material(
+          type: MaterialType.transparency,
+          child: InkWell(
+            customBorder: const StadiumBorder(),
+            hoverColor: p.hover,
+            onTap: onTap,
+            child: Ink(
+              decoration: ShapeDecoration(
+                  shape: const StadiumBorder(),
+                  color: selected ? p.primarySoft : Colors.transparent),
+              // 32 high as the PC list's pills, higher with a big font
+              child: ConstrainedBox(
+                constraints: const BoxConstraints(minHeight: 32),
+                child: Center(
+                  widthFactor: 1,
+                  heightFactor: 1,
+                  child: Padding(
+                    padding:
+                        const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
+                    child: Text(label,
+                        maxLines: 1,
+                        softWrap: false,
+                        overflow: TextOverflow.ellipsis,
+                        style: style),
+                  ),
+                ),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
