diff --git a/src/hjviewer_cm.rs b/src/hjviewer_cm.rs
index a742ac9..c2d3b8e 100644
--- a/src/hjviewer_cm.rs
+++ b/src/hjviewer_cm.rs
@@ -90,27 +90,39 @@ fn unproven_in(pinned: bool, name: &str) -> (String, HjvMark) {
 
 /// Whether a name holds one of the marks' words once NFKC-normalized, lowercased and left with
 /// its letters and digits only (no white space, punctuation, symbols, format or control
-/// characters): "Same-Account", full-width "ｓａｍｅ" and "같\u{200B}은 계정" all do. Look-alike
-/// letters of other scripts (a Cyrillic "а") do not.
+/// characters, and no Hangul fillers, letters that show as a blank: NFKC turns U+3164 and U+FFA0
+/// into U+1160): "Same-Account", full-width "ｓａｍｅ", "같\u{200B}은 계정" and "같은\u{3164}계정"
+/// all do. Look-alike letters of other scripts (a Cyrillic "а") do not.
 fn imitates_mark(name: &str) -> bool {
     let folded: String = name
         .nfkc()
         .flat_map(char::to_lowercase)
-        .filter(|c| c.is_alphanumeric())
+        .filter(|&c| c.is_alphanumeric() && !matches!(c, '\u{115F}' | '\u{1160}'))
         .collect();
     MARK_WORDS.iter().any(|word| folded.contains(word))
 }
 
 /// The name without control characters (Cc), zero-width characters and marks (U+200B-200F,
-/// U+FEFF) and bidi embeddings, overrides and isolates (U+202A-202E, U+2066-2069).
+/// U+2060-2064, U+FEFF, U+180E, U+061C), bidi embeddings, overrides and isolates (U+202A-202E,
+/// U+2066-2069) and the Hangul fillers that show as a blank (U+115F, U+1160, U+3164, U+FFA0).
 fn shown_name(name: &str) -> String {
     name.chars()
         .filter(|&c| {
             !(c.is_control()
                 || ('\u{200B}'..='\u{200F}').contains(&c)
+                || ('\u{2060}'..='\u{2064}').contains(&c)
                 || ('\u{202A}'..='\u{202E}').contains(&c)
                 || ('\u{2066}'..='\u{2069}').contains(&c)
-                || c == '\u{FEFF}')
+                || matches!(
+                    c,
+                    '\u{FEFF}'
+                        | '\u{180E}'
+                        | '\u{061C}'
+                        | '\u{115F}'
+                        | '\u{1160}'
+                        | '\u{3164}'
+                        | '\u{FFA0}'
+                ))
         })
         .collect()
 }
