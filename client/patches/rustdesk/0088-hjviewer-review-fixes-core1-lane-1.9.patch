+
+#[test]
+fn a_support_grant_stays_beside_this_pcs_ticket_and_goes_with_it() {
+    let grant = crate::hjviewer_account::Grant {
+        ck: [7; 32],
+        ctl_id: "987654321".into(),
+        life: 7200,
+        received: NOW,
+    };
+    let code = json!({ "ticket": "t1.code", "use": "pc", "exp": NOW + 7200, "server_time": NOW });
+    assert!(keep_guest_pc_with(&code, Some(grant.clone()), NOW));
+    assert_eq!(held_grant(NOW + 60), Some(grant.clone()));
+    assert_eq!(held_grant(NOW + 7200), None);
+    // the access password's ticket brings none and ends it
+    let password =
+        json!({ "ticket": "t1.password", "use": "pc", "exp": NOW + 43_200, "server_time": NOW });
+    assert!(keep_guest_pc_with(&password, None, NOW));
+    assert_eq!(held_grant(NOW + 60), None);
+    // and so does the end of this PC's ticket (hjv-guest-pc-end)
+    assert!(keep_guest_pc_with(&code, Some(grant), NOW));
+    forget_guest_pc();
+    assert_eq!(held_grant(NOW + 60), None);
+    // a build that is not an account build holds none
+    assert!(!holds_support_grant());
+}
