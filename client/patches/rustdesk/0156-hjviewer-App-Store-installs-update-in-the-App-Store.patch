@@ -255,6 +261,10 @@ class HjvDevice {
   /// iOS: how the build was exported (HJV_IOS_EXPORT).
   final String iosExport;
 
+  /// iOS: where the app came from, as package_info_plus reads it from the app's receipt
+  /// (kHjvAppStoreInstaller); "" while unknown.
+  final String iosInstaller;
+
   /// This app takes connections from other devices (a PC), so they go on while it is blocked.
   final bool takesIncoming;
 
@@ -262,10 +272,18 @@ class HjvDevice {
     this.platform = HjvPlatform.other,
     this.sdk = 0,
     this.iosExport = '',
+    this.iosInstaller = '',
     this.takesIncoming = false,
   });
 
-  bool get testFlight => iosExport == kHjvTestFlightExport;
+  /// An App Store Connect build that the App Store installed: it updates there.
+  bool get appStore =>
+      iosExport == kHjvAppStoreConnectExport &&
+      iosInstaller == kHjvAppStoreInstaller;
+
+  /// Any other App Store Connect build updates in TestFlight, as every such build did before
+  /// 1.9.1, also while where it came from is not known.
+  bool get testFlight => iosExport == kHjvAppStoreConnectExport && !appStore;
 
