-const kHjvTestFlightExport = 'app-store-connect';
+/// How an App Store Connect build is exported (client-build.yml IOS_EXPORT_METHOD, passed to the
+/// app as HJV_IOS_EXPORT). TestFlight and the App Store hand out the same such build; any other
+/// iOS build cannot be updated through either.
+const kHjvAppStoreConnectExport = 'app-store-connect';
+
+/// The installer package_info_plus names for an iOS app whose receipt is the App Store's. A
+/// sandbox receipt, which TestFlight's builds have and so does the copy App Review runs, gives
+/// "com.apple.testflight".
+const kHjvAppStoreInstaller = 'com.apple';
 
 /// The first Android that takes an APK from the app's own files (a content URI); older ones get
