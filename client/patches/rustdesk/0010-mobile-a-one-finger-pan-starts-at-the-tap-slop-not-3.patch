From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hjviewer <haejin.cho@yonsei.ac.kr>
Date: Sun, 11 Oct 2026 02:11:21 +0900
Subject: [PATCH 010/147] mobile: a one-finger pan starts at the tap slop, not
 36 px

HoldTapMoveGestureRecognizer stayed in the arena of a first touch that moved,
so the pan recognizer waited for its own 36 px pan slop: the cursor (mouse mode)
or a drag (touch mode) started late and every stroke lost 36 px. A first touch
that moves past the double-tap slop is now rejected, as Flutter's
DoubleTapGestureRecognizer does; double tap and double-tap drag are unchanged.

(Research patch ios-touch 0001; regression test in mobile_gestures_test.dart.)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 flutter/lib/common/widgets/gestures.dart |  5 ++
 flutter/test/mobile_gestures_test.dart   | 60 ++++++++++++++++++++++++
 2 files changed, 65 insertions(+)
 create mode 100644 flutter/test/mobile_gestures_test.dart

diff --git a/flutter/lib/common/widgets/gestures.dart b/flutter/lib/common/widgets/gestures.dart
index 0501ca4..80cd89f 100644
--- a/flutter/lib/common/widgets/gestures.dart
+++ b/flutter/lib/common/widgets/gestures.dart
@@ -300,6 +300,11 @@ class HoldTapMoveGestureRecognizer extends GestureRecognizer {
         if (_firstTap != null && _firstTap!.pointer == event.pointer) {
           // first tap move
           _reject(tracker);
+        } else if (_firstTap == null && _secondTap == null) {
+          // A first touch moved this far is a pan, not the first tap of a
+          // double tap. Staying in its arena kept the pan waiting for its own
+          // 36 px slop instead of the 18 px tap slop.
+          _reject(tracker);
         } else if (_secondTap != null && _secondTap!.pointer == event.pointer) {
           // debugPrint("_secondTap move");
           // second tap move
diff --git a/flutter/test/mobile_gestures_test.dart b/flutter/test/mobile_gestures_test.dart
new file mode 100644
index 0000000..9387687
--- /dev/null
+++ b/flutter/test/mobile_gestures_test.dart
@@ -0,0 +1,60 @@
+import 'package:flutter/gestures.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/common/widgets/gestures.dart';
+
+// The recognizers RawTouchGestureDetectorRegion puts in the arena for a
+// one-finger pan or a two-finger tap, with the times their callbacks fire.
+Future<List<String>> _run(
+    WidgetTester tester, Future<void> Function(Duration Function() now) body,
+    {required List<String> log, bool holdTapMove = true}) async {
+  final t0 = tester.binding.clock.now();
+  Duration now() => tester.binding.clock.now().difference(t0);
+  String at(String name) => '$name@${now().inMilliseconds}';
+  await tester.pumpWidget(Directionality(
+    textDirection: TextDirection.ltr,
+    child: RawGestureDetector(
+      gestures: {
+        TapGestureRecognizer:
+            GestureRecognizerFactoryWithHandlers<TapGestureRecognizer>(
+                () => TapGestureRecognizer(),
+                (i) => i.onTap = () => log.add(at('tap'))),
+        if (holdTapMove)
+          HoldTapMoveGestureRecognizer: GestureRecognizerFactoryWithHandlers<
+                  HoldTapMoveGestureRecognizer>(
+              () => HoldTapMoveGestureRecognizer(),
+              (i) => i.onHoldDragStart = (_) => log.add(at('holdDrag'))),
+        DoubleFinerTapGestureRecognizer: GestureRecognizerFactoryWithHandlers<
+                DoubleFinerTapGestureRecognizer>(
+            () => DoubleFinerTapGestureRecognizer(),
+            (i) => i.onDoubleFinerTap = (_) => log.add(at('twoFingerTap'))),
+        CustomTouchGestureRecognizer:
+            GestureRecognizerFactoryWithHandlers<CustomTouchGestureRecognizer>(
+                () => CustomTouchGestureRecognizer(),
+                (i) => i.onOneFingerPanStart =
+                    (d) => log.add('panStart@x=${d.localPosition.dx}')),
+      },
+      child: const ColoredBox(color: Color(0xFF000000)),
+    ),
+  ));
+  await body(now);
+  for (var i = 0; i < 50; i++) {
+    await tester.pump(const Duration(milliseconds: 10));
+  }
+  return log;
+}
+
+void main() {
+  testWidgets('a one-finger pan starts once it cannot be a tap', (t) async {
+    final log = await _run(t, (_) async {
+      final g = await t.startGesture(const Offset(100, 100));
+      for (var i = 0; i < 60; i++) {
+        await g.moveBy(const Offset(1, 0));
+        await t.pump(const Duration(milliseconds: 8));
+      }
+      await g.up();
+    }, log: []);
+    // 18 px is the tap slop; it used to wait for the 36 px pan slop.
+    expect(log, contains('panStart@x=120.0'));
+  });
+}
