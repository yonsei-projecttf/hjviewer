+/// Auto Login. A peer that can check for its logon or lock screen gets the password and types it
+/// itself, only if it is there right then. Keys typed from here land in whatever has focus if the
+/// screen is not locked by the time they arrive.
+pub fn auto_login(p: String, pi: &PeerInfo, interface: impl Interface) {
+    if !is_peer_handling_os_login(pi) {
+        input_os_password(p, true, interface);
+        return;
+    }
+    std::thread::spawn(move || {
+        activate_os(&interface, true);
+        std::thread::sleep(Duration::from_millis(1200));
+        let mut msg_out = Message::new();
+        msg_out.set_os_login(OSLogin {
+            password: p,
+            ..Default::default()
+        });
+        interface.send(Data::Message(msg_out));
+    });
+}
+
+/// The first HJViewer whose PC handles `os_login`. A PC reports HJViewer's version, not
+/// upstream's (client/version.env goes into Cargo.toml, `PeerInfo.version` is `crate::VERSION`),
+/// so upstream's "1.5.1" would also name the 1.9.2 PCs, which drop the message unread.
+const HJV_MIN_VERSION_OS_LOGIN: &str = "1.9.3";
+
+/// Windows and macOS peers from HJViewer 1.9.3 handle `os_login`.
+fn is_peer_handling_os_login(pi: &PeerInfo) -> bool {
+    (pi.platform == crate::common::PLATFORM_WINDOWS || pi.platform == crate::common::PLATFORM_MACOS)
+        && hbb_common::get_version_number(&pi.version)
+            >= hbb_common::get_version_number(HJV_MIN_VERSION_OS_LOGIN)
+}
+
+#[cfg(test)]
+mod os_login_gate_tests {
+    use super::*;
+
+    fn peer(platform: &str, version: &str) -> PeerInfo {
+        PeerInfo {
+            platform: platform.to_owned(),
+            version: version.to_owned(),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn os_login_goes_only_to_a_pc_from_hjviewer_1_9_3() {
+        let windows = crate::common::PLATFORM_WINDOWS;
+        // PCs with the handler
+        for v in ["1.9.3", "1.9.4", "1.9.10", "1.10.0", "2.0.0"] {
+            assert!(is_peer_handling_os_login(&peer(windows, v)), "{v}");
+        }
+        // PCs without it get the keys as before: the released 1.9.2 and older, a version that
+        // passes upstream's own gate (1.5.1), a local build (Cargo.toml's 1.5.0), no version
+        for v in ["1.9.2", "1.9.1", "1.9.0", "1.8.2", "1.5.1", "1.5.0", ""] {
+            assert!(!is_peer_handling_os_login(&peer(windows, v)), "{v}");
+        }
+        assert!(is_peer_handling_os_login(&peer(
+            crate::common::PLATFORM_MACOS,
+            "1.9.3"
+        )));
+        // these peers have no handler in any version
+        for p in [crate::common::PLATFORM_LINUX, crate::common::PLATFORM_ANDROID, ""] {
+            assert!(!is_peer_handling_os_login(&peer(p, "1.9.3")), "{p}");
+        }
+    }
+}
