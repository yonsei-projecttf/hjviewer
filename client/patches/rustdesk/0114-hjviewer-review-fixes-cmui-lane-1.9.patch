diff --git a/flutter/test/hjviewer_cm_fit_test.dart b/flutter/test/hjviewer_cm_fit_test.dart
new file mode 100644
index 0000000..a0413dc
--- /dev/null
+++ b/flutter/test/hjviewer_cm_fit_test.dart
@@ -0,0 +1,232 @@
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common/hjv_cm_layout.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjviewer_cm_texts.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// The connection window's card in its real size (300 x 490, 462 below the 28 px tab bar) with
+// Pretendard: the 1.9 notes (the caution with a contact, P5, the recording line) and the mark line
+// never push [수락]/[거부] or themselves out of the window (review of 1.9, TV-W2/TV-W6). The
+// header, the permissions and the buttons are server_page.dart's sizes; the card's column, the
+// mark line, the caution box and the callouts are the app's own widgets.
+
+const _window = Size(300, 462);
+// a contact long enough for the box's two lines (the real one comes from the signed policy)
+const _contact = 'HJViewer 지원 담당 helpdesk@example.ac.kr, 02-0000-0000';
+
+Future<void> _loadPretendard() async {
+  final loader = FontLoader(kHjvFont);
+  for (final weight in ['Regular', 'SemiBold', 'Bold']) {
+    final bytes = File('assets/fonts/Pretendard-$weight.otf').readAsBytesSync();
+    loader.addFont(Future.value(ByteData.view(bytes.buffer)));
+  }
+  await loader.load();
+}
+
+Widget _button(String text) => Padding(
+      padding: const EdgeInsets.all(4),
+      child: SizedBox(
+        key: Key('button $text'),
+        height: 36,
+        child: Center(
+            child: Text(text,
+                style: const TextStyle(
+                    fontSize: 13, fontWeight: FontWeight.w600))),
+      ),
+    );
+
+Widget _header(String name, HjvMarkView? mark, String status,
+        {required bool connected}) =>
+    Container(
+      margin: const EdgeInsets.symmetric(horizontal: 4.0, vertical: 8.0),
+      padding: const EdgeInsets.only(top: 12, bottom: 12, left: 12, right: 4),
+      child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        const Padding(
+            padding: EdgeInsets.only(right: 12),
+            child: SizedBox(width: 56, height: 56)),
+        Expanded(
+          child:
+              Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+            FittedBox(
+                child: Text(name,
+                    maxLines: 1,
+                    style: const TextStyle(
+                        fontWeight: FontWeight.w700,
+                        fontSize: 18,
+                        height: 1.3))),
+            if (mark != null) HjvMarkLine(view: mark),
+            const FittedBox(
+                child: Text('(123456789)', style: TextStyle(fontSize: 13))),
+            const SizedBox(height: 8),
+            FittedBox(
+                child: Text(status, style: const TextStyle(fontSize: 13))),
+          ]),
+        ),
+        // the chat button of a connected card
+        if (connected) const SizedBox(width: 48, height: 48),
+      ]),
+    );
+
+Widget _board() => Container(
+      key: const Key('board'),
+      width: double.infinity,
+      height: 160,
+      margin: const EdgeInsets.symmetric(horizontal: 4.0),
+      padding: const EdgeInsets.fromLTRB(0, 10, 0, 2),
+      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        const Padding(
+            padding: EdgeInsets.only(left: 12, bottom: 6),
+            child: Text('Permissions', style: TextStyle(fontSize: 12))),
+        Expanded(
+          child: GridView.count(
+            crossAxisCount: 4,
+            padding: const EdgeInsets.symmetric(horizontal: 10),
+            mainAxisSpacing: 10,
+            crossAxisSpacing: 10,
+            children: List.generate(8, (_) => const Icon(Icons.keyboard)),
+          ),
+        ),
+      ]),
+    );
+
+class _Case {
+  final String name;
+  final HjvCmTexts t;
+  final HjvMarkView? mark;
+  final bool connected;
+  final Widget? note;
+  final List<String> buttons;
+  const _Case(this.name, this.t,
+      {this.mark, this.connected = false, this.note, required this.buttons});
+}
+
+List<_Case> _cases() {
+  final cases = <_Case>[];
+  for (final t in [const HjvCmTexts(true), const HjvCmTexts(false)]) {
+    final ko = t.korean;
+    final accept = ko ? '수락' : 'Accept';
+    final dismiss = ko ? '거부' : 'Dismiss';
+    final elevate = ko ? '수락 및 권한 상승' : 'Accept and Elevate';
+    final caution = HjvCautionView(
+        key: const Key('note'),
+        text:
+            hjvCautionText(t, place: HjvCautionPlace.accept, contact: _contact),
+        line: hjvContactLine(t, _contact),
+        contact: _contact);
+    final lang = ko ? 'ko' : 'en';
+    // an outsider's PC from the support link: not installed, so [수락 및 권한 상승] shows
+    cases.add(_Case('$lang caution, elevate', t,
+        note: caution, buttons: [elevate, accept, dismiss]));
+    cases.add(_Case('$lang unverified name, caution, elevate', t,
+        mark: hjvMarkView(kHjvMarkUnverifiedName, '', t),
+        note: caution,
+        buttons: [elevate, accept, dismiss]));
+    cases.add(_Case('$lang staff, P5, elevate', t,
+        mark: hjvMarkView(kHjvMarkStaff, '', t),
+        note: HjvCallout(
+            key: const Key('note'),
+            text: t.staffAccept,
+            tone: HjvTone.info,
+            icon: Icons.verified_user_rounded),
+        buttons: [elevate, accept, dismiss]));
+    cases.add(_Case('$lang same account, recording, elevate', t,
+        mark: hjvMarkView(kHjvMarkSameAccount, '홍*동', t),
+        connected: true,
+        note: Padding(
+          padding: const EdgeInsets.only(left: 4, right: 4, top: 8),
+          child: HjvCallout(
+              key: const Key('note'),
+              text: t.recordingLine(canChange: true),
+              tone: HjvTone.danger,
+              icon: Icons.fiber_manual_record_rounded),
+        ),
+        buttons: [ko ? '권한 상승' : 'Elevate', ko ? '연결 해제' : 'Disconnect']));
+  }
+  return cases;
+}
+
+Widget _card(_Case c) {
+  final rows = c.buttons.length == 3
+      ? [
+          _button(c.buttons[0]),
+          Row(children: [
+            Expanded(child: _button(c.buttons[1])),
+            Expanded(child: _button(c.buttons[2])),
+          ]),
+        ]
+      : [
+          for (final b in c.buttons)
+            Row(children: [Expanded(child: _button(b))])
+        ];
+  return Padding(
+    padding: const EdgeInsets.symmetric(vertical: 4.0, horizontal: 8.0),
+    child: HjvCmCardColumn(
+      header: _header('DESKTOP-7Q2', c.mark,
+          c.connected ? (c.t.korean ? '연결됨 00:12' : 'Connected 00:12') : '…',
+          connected: c.connected),
+      board: _board(),
+      note: c.connected ? c.note : null,
+      panel: Padding(
+        padding: const EdgeInsets.only(bottom: 8),
+        child: Column(mainAxisAlignment: MainAxisAlignment.end, children: [
+          if (!c.connected)
+            Padding(padding: const EdgeInsets.only(bottom: 8), child: c.note),
+          ...rows,
+        ]),
+      ),
+    ),
+  );
+}
+
+void main() {
+  setUpAll(_loadPretendard);
+
+  for (final c in _cases()) {
+    testWidgets('the card fits: ${c.name}', (tester) async {
+      tester.view.physicalSize = _window;
+      tester.view.devicePixelRatio = 1;
+      addTearDown(tester.view.reset);
+      await tester.pumpWidget(MaterialApp(
+          theme: ThemeData(fontFamily: kHjvFont),
+          home: Material(
+              child: Align(
+                  alignment: Alignment.topLeft,
+                  child: SizedBox.fromSize(size: _window, child: _card(c))))));
+      // an overflow would have failed the pump
+      expect(tester.takeException(), isNull);
+      final window = Offset.zero & _window;
+      for (final b in c.buttons) {
+        final r = tester.getRect(find.byKey(Key('button $b')));
+        expect(
+            window.contains(r.topLeft) &&
+                window.contains(r.bottomRight - const Offset(0.01, 0.01)),
+            isTrue,
+            reason: '[$b] at $r');
+      }
+      final note = tester.getRect(find.byKey(const Key('note')));
+      expect(note.bottom <= _window.height && note.top >= 0, isTrue,
+          reason: 'the note at $note');
+      // the permissions keep at least a row's part (their grid scrolls)
+      expect(tester.getSize(find.byKey(const Key('board'))).height,
+          greaterThanOrEqualTo(48),
+          reason: 'the board');
+      if (c.mark != null) {
+        // the line's text, after its icon's glyph
+        final mark = tester.renderObject<RenderParagraph>(find
+            .descendant(
+                of: find.byType(HjvMarkLine), matching: find.byType(RichText))
+            .last);
+        expect(mark.didExceedMaxLines, isFalse, reason: 'the mark line is cut');
+      }
+      // ignore: avoid_print
+      print('CMFIT ${c.name}: board '
+          '${tester.getSize(find.byKey(const Key('board'))).height.toStringAsFixed(1)} px, '
+          'note ${note.height.toStringAsFixed(1)} px');
+    });
+  }
+}
