diff --git a/flutter/lib/common/hjv_cm_layout.dart b/flutter/lib/common/hjv_cm_layout.dart
new file mode 100644
index 0000000..b78c168
--- /dev/null
+++ b/flutter/lib/common/hjv_cm_layout.dart
@@ -0,0 +1,157 @@
+// The PC connection window's (CM's) HJViewer parts that decide what fits in its 300 x 490 window
+// (TV-W2, TV-W6; review fix of 1.9): the card's column, the mark line under the peer's name and
+// the caution box's look. Plain Flutter without the bridge, so that a pure Dart test measures them
+// with Pretendard (test/hjviewer_cm_fit_test.dart); server_page.dart and hjv_admin_contact.dart
+// show them.
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/common/hjviewer_cm_texts.dart';
+
+/// The connection card: `header` on top, `panel` (the notes above the buttons: the caution box,
+/// P5, and the buttons) whole at the bottom, and between them `board` (the permissions), which
+/// gives up height when the notes need it (its grid scrolls), with `note` (the recording line)
+/// whole under it. 1.8.2 filled the window to the pixel, so the notes the 1.9 card adds (the caution
+/// with a contact, P5, the recording line) would push [수락]/[거부] below the window's edge, or,
+/// if they scrolled, show nothing of the caution where it matters.
+class HjvCmCardColumn extends StatelessWidget {
+  final Widget header;
+  final Widget board;
+  final Widget? note;
+  final Widget panel;
+
+  const HjvCmCardColumn(
+      {super.key,
+      required this.header,
+      required this.board,
+      this.note,
+      required this.panel});
+
+  @override
+  Widget build(BuildContext context) => Column(
+        mainAxisAlignment: MainAxisAlignment.start,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          header,
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Flexible(child: board),
+                if (note != null) note!,
+              ],
+            ),
+          ),
+          panel,
+        ],
+      );
+}
+
+/// The mark line under the peer's name in the kind's fixed icon and colour: two lines at most, so
+/// that the words S10 and P6 tell the person to look for are never cut (English P4 needs about
+/// 205 px; the accept card's header leaves 174, a connected card's about 130).
+class HjvMarkLine extends StatelessWidget {
+  final HjvMarkView view;
+
+  const HjvMarkLine({super.key, required this.view});
+
+  @override
+  Widget build(BuildContext context) {
+    final p = HjvPalette.of(context);
+    final color = view.warning ? p.warningText : p.primaryStrong;
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 2),
+      child: Semantics(
+        label: view.text,
+        excludeSemantics: true,
+        child: Tooltip(
+          message: view.tooltip,
+          child: Row(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Padding(
+                padding: const EdgeInsets.only(top: 1),
+                child: Icon(
+                    view.warning
+                        ? Icons.warning_amber_rounded
+                        : Icons.verified_user_rounded,
+                    size: 14,
+                    color: view.warning ? p.warningText : p.primary),
+              ),
+              const SizedBox(width: 4),
+              Flexible(
+                child: Text(hjvKeepAll(view.text),
+                    maxLines: 2,
+                    overflow: TextOverflow.ellipsis,
+                    style: TextStyle(
+                        color: color,
+                        fontSize: 12,
+                        fontWeight: FontWeight.w600)),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// A caution in the warning tone (HjvCallout): `text`, then `line` ("HJViewer 관리자: <contact>")
+/// in two lines at most, whole in its tooltip; a long press copies `contact` and calls `onCopied`.
+/// Never a link.
+class HjvCautionView extends StatelessWidget {
+  final String text;
+  final String? line;
+  final String contact;
+  final VoidCallback? onCopied;
+
+  const HjvCautionView(
+      {super.key,
+      required this.text,
+      required this.line,
+      required this.contact,
+      this.onCopied});
+
+  @override
+  Widget build(BuildContext context) {
+    final line = this.line;
+    return Semantics(
+      container: true,
+      label: line == null ? text : '$text\n$line',
+      excludeSemantics: true,
+      child: HjvCallout.rich(
+        tone: HjvTone.warning,
+        icon: Icons.report_gmailerrorred_rounded,
+        body: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(hjvKeepAll(text), style: const TextStyle(fontSize: 12)),
+            if (line != null)
+              Padding(
+                padding: const EdgeInsets.only(top: 4),
+                child: Tooltip(
+                  message: line,
+                  child: GestureDetector(
+                    onLongPress: () {
+                      Clipboard.setData(ClipboardData(text: contact.trim()));
+                      onCopied?.call();
+                    },
+                    child: Text(line,
+                        maxLines: 2,
+                        overflow: TextOverflow.ellipsis,
+                        style: TextStyle(
+                            fontSize: 12,
+                            fontWeight: FontWeight.w600,
+                            color: HjvPalette.of(context).text)),
+                  ),
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
