 libs/portable/generate.py | 32 ++++++++++++++++++++++++--------
 1 file changed, 24 insertions(+), 8 deletions(-)

diff --git a/libs/portable/generate.py b/libs/portable/generate.py
index 26d0b37..946e1ac 100755
--- a/libs/portable/generate.py
+++ b/libs/portable/generate.py
@@ -3,6 +3,7 @@
 import os
 import optparse
 import subprocess
+from concurrent.futures import ProcessPoolExecutor
 from hashlib import md5
 import brotli
 import datetime
@@ -22,33 +23,48 @@ def normalize(path: str) -> str:
     return path.lower()
 
 
+def compress_file(source: str, level) -> tuple:
+    # Top level, so that the worker processes can import it (Windows spawns them).
+    with open(source, "rb") as f:
+        content = f.read()
+    md5_code = md5(content).hexdigest().encode(encoding=encoding)
+    return (brotli.compress(content, quality=level), md5_code)
+
+
 def generate_md5_table(folder: str, level, exclude: str = None) -> dict:
     res: dict = dict()
     skip = normalize(exclude) if exclude else None
     excluded = False
+    paths = []
     # os.curdir is the literal ".", so restoring it left us inside `folder`.
     curdir = os.getcwd()
     os.chdir(folder)
     for root, _, files in os.walk('.'):
         # remove ./
         for f in files:
-            md5_generator = md5()
             full_path = os.path.join(root, f)
             if skip and normalize(full_path) == skip:
                 print(f"Excluding {full_path}...")
                 excluded = True
                 continue
             print(f"Processing {full_path}...")
-            f = open(full_path, "rb")
-            content = f.read()
-            content_compressed = brotli.compress(
-                content, quality=level)
-            md5_generator.update(content)
-            md5_code = md5_generator.hexdigest().encode(encoding=encoding)
-            res[full_path] = (content_compressed, md5_code)
+            paths.append(full_path)
+    sources = [os.path.abspath(path) for path in paths]
     os.chdir(curdir)
     if skip and not excluded:
         raise ValueError(f"excluded file was not found in {folder}: {exclude}")
+    # Quality 11 takes minutes for the app's files on one core: each file is still compressed
+    # whole, now on every core, the largest first so that none starts last, and the table keeps
+    # the walk's order, so the blob stays the same byte for byte.
+    if len(paths) > 1 and (os.cpu_count() or 1) > 1:
+        largest_first = sorted(range(len(paths)), key=lambda i: -os.path.getsize(sources[i]))
+        with ProcessPoolExecutor() as pool:
+            done = {i: pool.submit(compress_file, sources[i], level) for i in largest_first}
+            for i, path in enumerate(paths):
+                res[path] = done[i].result()
+    else:
+        for path, source in zip(paths, sources):
+            res[path] = compress_file(source, level)
     return res
 
 
