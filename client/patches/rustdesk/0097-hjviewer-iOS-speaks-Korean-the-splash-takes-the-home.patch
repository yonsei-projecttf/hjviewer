 /// What a voice call does, in order.
+/// An Android colour resource of [file] (res/values*/...), as a Color.
+Color androidColor(String file, String name) {
+  final xml =
+      File('android/app/src/main/res/$file/hjv_splash.xml').readAsStringSync();
+  final hex = RegExp('<color name="$name">#([0-9A-Fa-f]{6})</color>')
+      .firstMatch(xml)!
+      .group(1)!;
+  return Color(int.parse('FF$hex', radix: 16));
+}
+
+/// The light and dark colours of an iOS asset catalog colour set.
+List<Color> iosColors(String set) {
+  final json = jsonDecode(
+      File('ios/Runner/Assets.xcassets/$set.colorset/Contents.json')
+          .readAsStringSync()) as Map<String, dynamic>;
+  Color of(Map<String, dynamic> entry) {
+    final c = entry['color']['components'] as Map<String, dynamic>;
+    int v(String k) => int.parse((c[k] as String).substring(2), radix: 16);
+    return Color.fromARGB(255, v('red'), v('green'), v('blue'));
+  }
+
+  final colors = (json['colors'] as List).cast<Map<String, dynamic>>();
+  return [
+    of(colors.firstWhere((e) => e['appearances'] == null)),
+    of(colors.firstWhere((e) => e['appearances'] != null)),
+  ];
+}
