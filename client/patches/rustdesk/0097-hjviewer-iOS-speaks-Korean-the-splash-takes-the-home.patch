@@ -1,6 +1,6 @@
 // HJViewer: what the phone screens share: the size of a tap target and the plan of the peer
-// bar's right side (U57), and the system bars' style of each theme (U61). Plain Flutter without
-// the bridge.
+// bar's right side (U57), the system bars' style of each theme (U61), and the rows of the
+// settings' "Network (advanced)" screen (U40). Plain Flutter without the bridge.
 
 import 'dart:math';
 
@@ -52,3 +52,62 @@ SystemUiOverlayStyle hjvSystemUiOverlayStyle(bool dark) {
     systemNavigationBarContrastEnforced: false,
   );
 }
+
+/// The rows of the phone's "Network (advanced)" screen (U40), in their order: the expert rows
+/// that were in the settings' first section. A row shows under the same conditions as before;
+/// the settings show the screen's entry only when a row is left.
+enum HjvNetworkRow {
+  server,
+  proxy,
+  deploy,
+  webSocket,
+  insecureTlsFallback,
+  disableUdp,
+  tcpPunch,
+  udpPunch,
+  ipv6,
+  webrtc,
+}
+
+/// Which [HjvNetworkRow]s show. [tlsFallbackPinnedOff] is hjvPinnedOff of the insecure TLS
+/// fallback (a pinned build fixes it off, U37).
+List<HjvNetworkRow> hjvPhoneNetworkRows({
+  required bool android,
+  required bool settingsDisabled,
+  required bool hideNetwork,
+  required bool hideServer,
+  required bool hideProxy,
+  required bool hideWebSocket,
+  required bool outgoingOnly,
+  required bool incomingOnly,
+  required bool publicServer,
+  required bool tlsFallbackPinnedOff,
+}) =>
+    [
+      if (!settingsDisabled && !hideNetwork && !hideServer)
+        HjvNetworkRow.server,
+      if (!hideNetwork && !hideProxy) HjvNetworkRow.proxy,
+      if (android && !outgoingOnly) HjvNetworkRow.deploy,
+      if (!settingsDisabled && !hideNetwork && !hideWebSocket)
+        HjvNetworkRow.webSocket,
+      if (!publicServer && !tlsFallbackPinnedOff)
+        HjvNetworkRow.insecureTlsFallback,
+      if (android && !outgoingOnly && !publicServer) HjvNetworkRow.disableUdp,
+      if (!incomingOnly) ...[
+        HjvNetworkRow.tcpPunch,
+        HjvNetworkRow.udpPunch,
+        HjvNetworkRow.ipv6,
+        HjvNetworkRow.webrtc,
+      ],
+    ];
+
+/// The phone screens' own texts, Korean where translate() is Korean (hjviewer_labels.dart).
+class HjvPhoneTexts {
+  final bool korean;
+  const HjvPhoneTexts(this.korean);
+
+  String _t(String ko, String en) => korean ? ko : en;
+
+  // the settings' sub-screen with the expert network rows (U40)
+  String get networkAdvanced => _t('네트워크(고급)', 'Network (advanced)');
+}
