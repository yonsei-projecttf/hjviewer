diff --git a/flutter/android/app/src/main/res/drawable-v23/launch_background.xml b/flutter/android/app/src/main/res/drawable-v23/launch_background.xml
new file mode 100644
index 0000000..e295369
--- /dev/null
+++ b/flutter/android/app/src/main/res/drawable-v23/launch_background.xml
@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Splash for API 23-30 (API 31+ shows the system splash of values-v31/styles.xml with the same
+     parts): the Flutter UI's background colour, the launcher icon in a 160dp circle in the centre
+     and the organisation line near the bottom. API 22 keeps drawable-v21 (no item gravity there). -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:drawable="@color/hjv_splash_background" />
+    <item
+        android:width="160dp"
+        android:height="160dp"
+        android:gravity="center">
+        <shape android:shape="oval">
+            <solid android:color="@color/ic_launcher_background" />
+        </shape>
+    </item>
+    <item
+        android:width="240dp"
+        android:height="240dp"
+        android:drawable="@drawable/hjv_splash_icon"
+        android:gravity="center" />
+    <item
+        android:width="200dp"
+        android:height="80dp"
+        android:bottom="24dp"
+        android:drawable="@drawable/hjv_splash_branding"
+        android:gravity="bottom|center_horizontal" />
+</layer-list>
