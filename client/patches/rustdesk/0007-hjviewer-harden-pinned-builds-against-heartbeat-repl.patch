+fn pinned() -> bool {
+    SERVER.is_some_and(|s| !s.is_empty())
+}
+
+/// A heartbeat reply can rewrite options of every PC (`strategy`) and end its sessions
+/// (`disconnect`). The hjviewer server answers /api/heartbeat with 404, so such a reply could only
+/// come from a TLS interceptor that the TLS fallback let through; hjviewer builds drop both keys.
+#[cfg(not(target_os = "ios"))]
+pub fn strip_heartbeat_controls(rsp: &mut std::collections::HashMap<&str, serde_json::Value>) {
+    if pinned() {
+        remove_heartbeat_controls(rsp);
+    }
+}
+
+#[cfg(not(target_os = "ios"))]
+fn remove_heartbeat_controls(rsp: &mut std::collections::HashMap<&str, serde_json::Value>) {
+    let dropped: Vec<&str> = ["strategy", "disconnect"]
+        .into_iter()
+        .filter(|k| rsp.remove(k).is_some())
+        .collect();
+    if !dropped.is_empty() {
+        hbb_common::throttled_log!(
+            crate::common::API_LOG_INTERVAL,
+            warn,
+            "ignored {dropped:?} in a heartbeat reply"
+        );
+    }
+}
+
+/// The account token rides along in PunchHoleRequest and RequestRelay, and hbbs hands RequestRelay
+/// to the peer as it is, so the token would reach every PC its owner connects to through the relay.
+/// The hjviewer server never reads it; hjviewer builds leave it out.
+pub fn rendezvous_token(token: String) -> String {
+    if pinned() {
+        String::new()
+    } else {
+        token
+    }
+}
+
+/// A renamed executable ("…host=…,key=…,api=….exe") would override the pinned ID, relay and API
+/// servers and the key; hjviewer builds take no settings from their file name.
+#[cfg(target_os = "windows")]
+pub fn refuse_exe_name_settings() -> hbb_common::ResultType<()> {
+    if pinned() {
+        hbb_common::bail!("hjviewer builds take no settings from the executable name");
+    }
+    Ok(())
+}
+
 /// hjviewer builds leave out RustDesk's printer driver adapter (closed source), so remote printing
 /// is offered only where one was installed by hand next to the executable.
 #[cfg(target_os = "windows")]
@@ -59,3 +114,27 @@ pub fn printer_adapter_present() -> bool {
         .map(|exe| exe.with_file_name("printer_driver_adapter.dll").exists())
         .unwrap_or(false)
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[cfg(not(target_os = "ios"))]
+    #[test]
+    fn heartbeat_reply_loses_strategy_and_disconnect() {
+        let reply = r#"{"sysinfo":1,"disconnect":[3],"modified_at":5,
+            "strategy":{"config_options":{"approve-mode":"click","whitelist":""}}}"#;
+        let mut rsp: std::collections::HashMap<&str, serde_json::Value> =
+            serde_json::from_str(reply).unwrap();
+        remove_heartbeat_controls(&mut rsp);
+        let mut left: Vec<&str> = rsp.keys().copied().collect();
+        left.sort();
+        assert_eq!(left, ["modified_at", "sysinfo"]);
+    }
+
+    #[test]
+    fn rendezvous_token_only_kept_in_unpinned_builds() {
+        let kept = rendezvous_token("token".to_owned());
+        assert_eq!(kept, if pinned() { "" } else { "token" });
+    }
+}
