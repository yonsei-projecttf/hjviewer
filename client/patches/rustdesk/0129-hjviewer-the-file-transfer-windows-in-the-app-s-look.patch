@@ -0,0 +1,70 @@
+// HJViewer (U15): the session windows (file transfer, port forwarding, chat) in the app's look:
+// the colours upstream passes, mapped to the palette as the session toolbar's
+// _hjvToolbarButtonColors does (remote_toolbar.dart). Plain Flutter without the bridge.
+
+import 'package:flutter/material.dart';
+
+import 'hjv_style.dart';
+
+/// A file transfer MenuButton's background and hover from the colour upstream passes: the
+/// theme's cardColor (the head's tools) on the fields' grey with the stronger hover (the plain
+/// one does not show on it), the accent (a transfer card's resume and cancel) clear on the card,
+/// the theme's disabledColor (the close x while the path is typed) without a hover; any other
+/// colour as it is.
+({Color bg, Color hover}) hjvMenuButtonColors(
+    BuildContext context, Color color, Color hoverColor) {
+  final p = HjvPalette.of(context);
+  final theme = Theme.of(context);
+  if (color == theme.cardColor) return (bg: p.fill, hover: p.hoverStrong);
+  // MyTheme.accent and MyTheme.button (common.dart) are the light palette's primary in both
+  // themes; comparing with it keeps this file free of common.dart and the bridge
+  if (color == HjvPalette.light.primary) {
+    return (bg: Colors.transparent, hover: p.hover);
+  }
+  if (color == theme.disabledColor) return (bg: p.fill, hover: p.fill);
+  return (bg: color, hover: hoverColor);
+}
+
+/// A row of the desktop file list, and of the phone's: a selected row on the accent's faint tint
+/// with a thin accent border (so that a range shows also on a dull screen), its name in
+/// primaryStrong (primary does not reach 4.5:1 on the tint) and its icon in primary; an
+/// unselected row clear, its name in the text colour. The date and size in textSecondary.
+({Color bg, Color? border, Color name, Color icon, Color meta})
+    hjvFileRowColors(BuildContext context, {required bool selected}) {
+  final p = HjvPalette.of(context);
+  return selected
+      ? (
+          bg: p.primarySoft,
+          border: p.primary.withOpacity(0.35),
+          name: p.primaryStrong,
+          icon: p.primary,
+          meta: p.textSecondary
+        )
+      : (
+          bg: Colors.transparent,
+          border: null,
+          name: p.text,
+          icon: p.textSecondary,
+          meta: p.textSecondary
+        );
+}
+
+/// A chat bubble: one's own on primaryFill with white text and time (any dimmed white falls below
+/// 4.5:1 there), the other side's on the fields' grey in the text colour, its time secondary.
+({Color bg, Color text, Color time}) hjvChatBubbleColors(BuildContext context,
+    {required bool own}) {
+  final p = HjvPalette.of(context);
+  return own
+      ? (bg: p.primaryFill, text: Colors.white, time: Colors.white)
+      : (bg: p.fill, text: p.text, time: p.textSecondary);
+}
+
+/// The file list's and the port forwarding table's column heads: 12/600 in textTertiary.
+TextStyle hjvFileHeadStyle(BuildContext context) => TextStyle(
+    fontSize: 12,
+    fontWeight: FontWeight.w600,
+    color: HjvPalette.of(context).textTertiary);
+
+/// A row's date (13) and size (12): `color`, digits of one width.
+TextStyle hjvFileMetaStyle(Color color, {required double size}) =>
+    TextStyle(fontSize: size, color: color, fontFeatures: HjvText.tabular);
