diff --git a/flutter/test/hjviewer_session_look_test.dart b/flutter/test/hjviewer_session_look_test.dart
new file mode 100644
index 0000000..b9cad81
--- /dev/null
+++ b/flutter/test/hjviewer_session_look_test.dart
@@ -0,0 +1,119 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjv_session_look.dart';
+import 'package:flutter_hbb/common/hjv_style.dart';
+import 'package:flutter_hbb/desktop/widgets/menu_button.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// U15, the session windows in the app's look (common/hjv_session_look.dart): the colours
+// upstream passes to the file transfer's MenuButton, a file row's and a chat bubble's colours and
+// their contrast, and a MenuButton that cannot be pressed. Plain Flutter, no bridge: the themes
+// carry the colours hjvRestyle (hjv_theme.dart) gives cardColor and hoverColor, and the accent
+// upstream passes is MyTheme.accent's value, the light palette's primary (common.dart).
+
+double contrast(Color a, Color b) {
+  final la = a.computeLuminance();
+  final lb = b.computeLuminance();
+  final hi = la > lb ? la : lb;
+  final lo = la > lb ? lb : la;
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+Future<BuildContext> themed(WidgetTester tester, ThemeData theme) async {
+  late BuildContext ctx;
+  await tester.pumpWidget(Theme(
+      data: theme,
+      child: Builder(builder: (context) {
+        ctx = context;
+        return const SizedBox();
+      })));
+  return ctx;
+}
+
+void main() {
+  ThemeData app(Brightness brightness, HjvPalette p) =>
+      ThemeData(brightness: brightness, cardColor: p.fill, hoverColor: p.hover);
+  final themes = [
+    ('light', app(Brightness.light, HjvPalette.light), HjvPalette.light),
+    ('dark', app(Brightness.dark, HjvPalette.dark), HjvPalette.dark),
+  ];
+  const accent = Color(0xFF1E6FD9);
+  const accent80 = Color(0xAA1E6FD9);
+
+  testWidgets(
+      'a MenuButton\'s colours from what upstream passes, in both themes',
+      (tester) async {
+    for (final (name, theme, p) in themes) {
+      final context = await themed(tester, theme);
+      expect(hjvMenuButtonColors(context, theme.cardColor, theme.hoverColor),
+          (bg: p.fill, hover: p.hoverStrong),
+          reason: '$name head tool');
+      expect(hjvMenuButtonColors(context, accent, accent80),
+          (bg: Colors.transparent, hover: p.hover),
+          reason: '$name transfer card');
+      expect(
+          hjvMenuButtonColors(context, theme.disabledColor, theme.hoverColor),
+          (bg: p.fill, hover: p.fill),
+          reason: '$name path being typed');
+      expect(hjvMenuButtonColors(context, Colors.purple, Colors.pink),
+          (bg: Colors.purple, hover: Colors.pink),
+          reason: '$name other colours');
+    }
+  });
+
+  testWidgets('a selected file row reads on its tint, in both themes',
+      (tester) async {
+    for (final (name, theme, p) in themes) {
+      final context = await themed(tester, theme);
+      final on = hjvFileRowColors(context, selected: true);
+      expect((
+        on.bg,
+        on.name,
+        on.icon
+      ), (
+        p.primarySoft,
+        p.primaryStrong,
+        p.primary
+      ), reason: name);
+      expect(on.border, isNotNull, reason: name);
+      expect(contrast(on.name, on.bg), greaterThanOrEqualTo(4.5), reason: name);
+      expect(contrast(on.meta, on.bg), greaterThanOrEqualTo(4.5), reason: name);
+      final off = hjvFileRowColors(context, selected: false);
+      expect((off.bg, off.name, off.border), (Colors.transparent, p.text, null),
+          reason: name);
+    }
+  });
+
+  testWidgets('chat bubbles: text and time reach 4.5:1, in both themes',
+      (tester) async {
+    for (final (name, theme, p) in themes) {
+      final context = await themed(tester, theme);
+      final own = hjvChatBubbleColors(context, own: true);
+      final other = hjvChatBubbleColors(context, own: false);
+      expect(own.bg, p.primaryFill, reason: name);
+      expect(other.bg, p.fill, reason: name);
+      for (final b in [own, other]) {
+        expect(contrast(b.text, b.bg), greaterThanOrEqualTo(4.5), reason: name);
+        expect(contrast(b.time, b.bg), greaterThanOrEqualTo(4.5), reason: name);
+      }
+    }
+  });
+
+  testWidgets('a MenuButton that cannot be pressed is dimmed', (tester) async {
+    Future<Iterable<Opacity>> pump(VoidCallback? onPressed) async {
+      await tester.pumpWidget(MaterialApp(
+          theme: themes.first.$2,
+          home: Scaffold(
+              body: MenuButton(
+                  onPressed: onPressed,
+                  color: themes.first.$2.cardColor,
+                  hoverColor: themes.first.$2.hoverColor,
+                  child: const Icon(Icons.delete_outline)))));
+      return tester.widgetList<Opacity>(find.ancestor(
+          of: find.byIcon(Icons.delete_outline),
+          matching: find.byType(Opacity)));
+    }
+
+    expect((await pump(null)).map((o) => o.opacity), [0.4]);
+    expect(await pump(() {}), isEmpty);
+  });
+}
