+/// Whether [text] has any Hangul in it, see [isHangulText].
+bool containsHangul(String text) => text.runes.any(_isHangulRune);
+
 bool _isHangulRune(int rune) =>
     (rune >= 0x1100 && rune <= 0x11FF) || // Hangul Jamo
