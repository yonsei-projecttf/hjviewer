   /// that text first, so that it does not overtake it.
   VoidCallback? flushSoftKeyboardText;
 
+  /// Modifiers turned on from the mobile key bar ('ctrl', 'alt', 'shift',
+  /// 'command'): true while one applies to the next key or click only, false
+  /// while it is kept on.
+  final keyBarModifiers = <String, bool>{}.obs;
