+  /// Whether the key bar has Ctrl, Alt or Win/Cmd on, so that what the soft
+  /// keyboard types next is a shortcut. A modifier only a key event turned on
+  /// does not count.
+  bool get keyBarHotkey =>
+      (ctrl && keyBarModifiers.containsKey('ctrl')) ||
+      (alt && keyBarModifiers.containsKey('alt')) ||
+      (command && keyBarModifiers.containsKey('command'));
+
+  // Buttons pressed through [sendMouse] and not released yet: only the
+  // release of one uses up a one-shot key-bar modifier, not the stray
+  // release a two-finger gesture ends with.
+  final _sentButtonPresses = <MouseButtons>{};
+
   final ToReleaseRawKeys toReleaseRawKeys = ToReleaseRawKeys();
   final ToReleaseKeys toReleaseKeys = ToReleaseKeys();
 
@@ -1044,6 +1062,55 @@ class InputModel {
         ctrl: ctrl,
         shift: shift,
         command: command);
+    if (name.isNotEmpty && !_kModifierKeyNames.contains(name)) {
+      releaseOneShotModifiers();
+    }
+  }
+
+  static const _kModifierKeyNames = {
+    'VK_SHIFT',
+    'RShift',
+    'VK_CONTROL',
+    'RControl',
+    'VK_MENU',
+    'RAlt',
+    'Meta',
+    'RWin',
+  };
+
+  /// Turns off the key bar's one-shot modifiers, after the key or click they
+  /// were meant for has been sent.
+  void releaseOneShotModifiers() {
+    final names = [
+      for (final e in keyBarModifiers.entries)
+        if (e.value) e.key
+    ];
+    if (names.isEmpty) return;
+    for (final name in names) {
+      setModifier(name, false);
+      keyBarModifiers.remove(name);
+    }
+  }
+
+  bool modifierOn(String name) => switch (name) {
+        'ctrl' => ctrl,
+        'alt' => alt,
+        'shift' => shift,
+        'command' => command,
+        _ => false,
+      };
+
+  void setModifier(String name, bool on) {
+    switch (name) {
+      case 'ctrl':
+        ctrl = on;
+      case 'alt':
+        alt = on;
+      case 'shift':
+        shift = on;
+      case 'command':
+        command = on;
+    }
   }
 
   static Map<String, dynamic> getMouseEventMove() => {
