+
+/// Sends [key] with the given modifiers and the ones the key bar has on.
+/// One-shot modifiers are used up; modifiers kept on stay on.
+void sendShortcut(String key,
+    {bool ctrl = false,
+    bool alt = false,
+    bool shift = false,
+    bool command = false}) {
+  final input = gFFI.inputModel;
+  input.flushSoftKeyboardText?.call();
+  bool kept(bool on, String name) => on && input.keyBarModifiers[name] != true;
+  final keptCtrl = kept(input.ctrl, 'ctrl');
+  final keptAlt = kept(input.alt, 'alt');
+  final keptShift = kept(input.shift, 'shift');
+  final keptCommand = kept(input.command, 'command');
+  input.ctrl |= ctrl;
+  input.alt |= alt;
+  input.shift |= shift;
+  input.command |= command;
+  input.inputKey(key);
+  input.releaseOneShotModifiers();
+  input.ctrl = keptCtrl;
+  input.alt = keptAlt;
+  input.shift = keptShift;
+  input.command = keptCommand;
 }
 
