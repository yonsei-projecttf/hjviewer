+  test('phones and tablets choose their layout by size, not by aspect (U64)',
+      () {
+    // the app keeps the touch layout held landscape, on an iPad, in a split screen
+    for (final aspect in [0.46, 1.0, 1.33, 2.17]) {
+      expect(hjvPortraitLayout(mobileApp: true, aspect: aspect), isTrue,
+          reason: '$aspect');
+    }
+    // the web chooses by aspect as upstream does
+    expect(hjvPortraitLayout(mobileApp: false, aspect: 0.6), isTrue);
+    expect(hjvPortraitLayout(mobileApp: false, aspect: 1.0), isTrue);
+    expect(hjvPortraitLayout(mobileApp: false, aspect: 1.6), isFalse);
+
+    // iPhone SE, 15, 15 Pro Max, an Android phone hold portrait; iPad mini, Air, 13" do not
+    for (final side in [320.0, 375.0, 393.0, 412.0, 430.0, 599.0]) {
+      expect(hjvLocksPortrait(side), isTrue, reason: '$side');
+    }
+    for (final side in [600.0, 744.0, 820.0, 1024.0]) {
+      expect(hjvLocksPortrait(side), isFalse, reason: '$side');
+    }
+    expect(hjvHomeOrientations(shortestSide: 393, homeOnTop: true),
+        [DeviceOrientation.portraitUp]);
+    expect(hjvHomeOrientations(shortestSide: 393, homeOnTop: false), isEmpty);
+    expect(hjvHomeOrientations(shortestSide: 820, homeOnTop: true), isEmpty);
+  });
+
