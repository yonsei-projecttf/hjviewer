+// ---- the layout by size (U64, U65) ----
+
+/// A screen whose shortest side is at least this (dp, iOS pt) is a tablet's; below it, a phone's.
+const double kHjvTabletSide = 600;
+
+/// The connection page's column on a tablet: as wide as the settings' list (settings_ui's 810).
+const double kHjvPageColumn = 810;
+
+/// A peer list at least this wide shows its cards in two columns.
+const double kHjvTwoColumns = 700;
+
+/// The home's app bar on a window this low or lower (a phone held landscape where the system
+/// ignores the portrait lock, as in Android's split screen and free windows) is [kHjvLowAppBar].
+const double kHjvLowWindow = 500;
+const double kHjvLowAppBar = 44;
+
+/// stateGlobal.isPortrait (main.dart): the Android and iOS app keep the portrait layout in any
+/// orientation and window (a phone held landscape, an iPad, a split screen), so that the touch
+/// screens never get the desktop's cards, hover and 28 px ⋮; the web keeps choosing by [aspect]
+/// (width / height), as upstream does.
+bool hjvPortraitLayout({required bool mobileApp, required double aspect}) =>
+    mobileApp || aspect <= 1;
+
+/// Whether the phone's home (its tabs, their popups and dialogs) holds the portrait orientation:
+/// on a phone, not on a tablet, whose multitasking does not let an app hold one.
+bool hjvLocksPortrait(double shortestSide) => shortestSide < kHjvTabletSide;
+
+/// The orientations the app asks for: portrait up while a phone's home is the top page, every
+/// one the app declares (an empty list) under a page above it (the remote screen, file transfer,
+/// the terminal, the camera, and the settings' sub-screens) and on a tablet.
+List<DeviceOrientation> hjvHomeOrientations(
+        {required double shortestSide, required bool homeOnTop}) =>
+    homeOnTop && hjvLocksPortrait(shortestSide)
+        ? const [DeviceOrientation.portraitUp]
+        : const [];
+
+/// How many columns of the portrait cards a peer list [width] wide shows, in a window whose
+/// shortest side is [shortestSide]: a phone's list is one card per row, a tablet's two from
+/// [kHjvTwoColumns] (the page column keeps it below three).
+int hjvPeerColumns({required double width, required double shortestSide}) =>
+    shortestSide >= kHjvTabletSide && width >= kHjvTwoColumns ? 2 : 1;
+
+/// The home's app bar height in a window [height] high: [kHjvLowAppBar] in a low window, else
+/// the theme's (null).
+double? hjvAppBarHeight(double height) =>
+    height <= kHjvLowWindow ? kHjvLowAppBar : null;
+
+/// The shortest side of the device's display (not of the app's window), in logical pixels: a
+/// phone in a split screen is still a phone.
+double hjvDisplayShortestSide() {
+  final views = WidgetsBinding.instance.platformDispatcher.views;
+  if (views.isEmpty) return 0;
+  final display = views.first.display;
+  return display.size.shortestSide / display.devicePixelRatio;
+}
+
+/// Holds a phone's home in portrait (hjvHomeOrientations): counts the pages on the app's
+/// navigator (a popup menu or a dialog route is not a page) and asks the system again as the
+/// count crosses one. [apply] again when the display may have changed (a foldable opened).
+class HjvOrientationObserver extends NavigatorObserver {
+  final double Function() shortestSide;
+  final Future<void> Function(List<DeviceOrientation>) setOrientations;
+  HjvOrientationObserver(
+      {double Function()? shortestSide,
+      Future<void> Function(List<DeviceOrientation>)? setOrientations})
+      : shortestSide = shortestSide ?? hjvDisplayShortestSide,
+        setOrientations =
+            setOrientations ?? SystemChrome.setPreferredOrientations;
+
+  int _pages = 0;
+  List<DeviceOrientation>? _asked;
+
+  /// The pages on the navigator, the home included.
+  int get pages => _pages;
+
+  void apply() {
+    final want = hjvHomeOrientations(
+        shortestSide: shortestSide(), homeOnTop: _pages <= 1);
+    if (_asked != null && listEquals(_asked, want)) return;
+    _asked = want;
+    setOrientations(want).catchError((Object e) => debugPrint('hjv: $e'));
+  }
+
+  void _count(Route<dynamic>? route, int by) {
+    if (route is PageRoute) {
+      _pages = max(0, _pages + by);
+      apply();
+    }
+  }
+
+  @override
+  void didPush(Route<dynamic> route, Route<dynamic>? previousRoute) =>
+      _count(route, 1);
+
+  @override
+  void didPop(Route<dynamic> route, Route<dynamic>? previousRoute) =>
+      _count(route, -1);
+
+  @override
+  void didRemove(Route<dynamic> route, Route<dynamic>? previousRoute) =>
+      _count(route, -1);
+
+  @override
+  void didReplace({Route<dynamic>? newRoute, Route<dynamic>? oldRoute}) {
+    _count(oldRoute, -1);
+    _count(newRoute, 1);
+  }
+}
+
+/// The phone app's one observer (main.dart's navigatorObservers and its metrics).
+final hjvOrientationObserver = HjvOrientationObserver();
+
