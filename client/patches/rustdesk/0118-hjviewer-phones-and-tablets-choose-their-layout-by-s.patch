+    expect(hjvPeerColumns(width: 912, shortestSide: 430), 1);
+    // iPad 11" either way (the 810 column less the page's margins), iPad mini portrait
+    expect(hjvPeerColumns(width: 790, shortestSide: 834), 2);
+    expect(hjvPeerColumns(width: 724, shortestSide: 744), 2);
+    expect(hjvPeerColumns(width: kHjvTwoColumns, shortestSide: 800), 2);
+    // narrower: an Android tablet's 600 dp, an iPad's split view
+    expect(hjvPeerColumns(width: 699, shortestSide: 800), 1);
+    expect(hjvPeerColumns(width: 580, shortestSide: 600), 1);
+    expect(hjvPeerColumns(width: 300, shortestSide: 320), 1);
+    // the page column (the settings' 810) keeps two columns of cards far above the item's 160
+    expect(hjvPeerColumns(width: kHjvPageColumn, shortestSide: 1024), 2);
+    expect(kHjvPageColumn / 2, greaterThanOrEqualTo(160));
+  });
