+  // HJViewer: the touch cards one per row on a phone, in two columns on a tablet's wide list
+  // (U64, U65); still one ListView.builder (see the rebuild note above), a row per item
+  Widget _hjvPortraitList(
+          List<Peer> peers, Widget Function(Peer, bool) buildOnePeer) =>
+      LayoutBuilder(builder: (context, c) {
+        final cols = hjvPeerColumns(
+            width: c.maxWidth,
+            shortestSide: MediaQuery.sizeOf(context).shortestSide);
+        return ListView.builder(
+          itemCount: (peers.length + cols - 1) ~/ cols,
+          itemBuilder: (BuildContext context, int index) {
+            final Widget row = cols == 1
+                ? buildOnePeer(peers[index], true)
+                : Row(
+                    crossAxisAlignment: CrossAxisAlignment.start,
+                    children: [
+                        for (var i = 0; i < cols; i++) ...[
+                          if (i > 0) SizedBox(width: space),
+                          Expanded(
+                              child: index * cols + i < peers.length
+                                  ? buildOnePeer(peers[index * cols + i], true)
+                                  : const SizedBox.shrink()),
+                        ]
+                      ]);
+            return row.marginOnly(
+                top: index == 0 ? 0 : space / 2, bottom: space / 2);
+          },
+        );
+      });
+
   var _queryInterval = const Duration(seconds: 20);
 
