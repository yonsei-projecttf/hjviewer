+      await tester.pumpAndSettle();
+      expect(observer.pages, 1);
+      nav.currentState!.pop();
+      await tester.pumpAndSettle();
+
+      // the remote screen (a page) rotates; back home, portrait again; asked once each
+      nav.currentState!.push(MaterialPageRoute(
+          builder: (_) => const Scaffold(body: Text('remote'))));
+      await tester.pumpAndSettle();
+      nav.currentState!.push(MaterialPageRoute(
+          builder: (_) => const Scaffold(body: Text('file transfer'))));
+      await tester.pumpAndSettle();
+      expect(observer.pages, 3);
+      nav.currentState!.pop();
+      await tester.pumpAndSettle();
+      nav.currentState!.pop();
+      await tester.pumpAndSettle();
+      expect(observer.pages, 1);
+      expect(
