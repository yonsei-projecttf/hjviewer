+  testWidgets('a phone home holds portrait, the pages above it rotate (U64)',
+      (tester) async {
+    for (final side in [393.0, 820.0]) {
+      final asked = <List<DeviceOrientation>>[];
+      final observer = HjvOrientationObserver(
+          shortestSide: () => side,
+          setOrientations: (o) async => asked.add(o));
+      final nav = GlobalKey<NavigatorState>();
+      await tester.pumpWidget(MaterialApp(
+          key: ValueKey(side),
+          navigatorKey: nav,
+          navigatorObservers: [observer],
+          home: const Scaffold(body: Text('home'))));
+      expect(observer.pages, 1);
+      final phone = side < kHjvTabletSide;
+      expect(asked, [if (phone) [DeviceOrientation.portraitUp] else []],
