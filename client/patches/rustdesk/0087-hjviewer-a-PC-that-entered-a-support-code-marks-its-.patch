+pub(crate) fn support_grant() -> Option<crate::hjviewer_account::Grant> {
+    if !active() {
+        return None;
+    }
+    held_grant(unix_now())
+}
+
+fn held_grant(now: u64) -> Option<crate::hjviewer_account::Grant> {
+    memory()
+        .support
+        .clone()
+        .filter(|grant| crate::hjviewer_account::grant_valid_at(grant, now))
+}
