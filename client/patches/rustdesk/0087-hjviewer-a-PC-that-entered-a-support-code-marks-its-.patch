+/// hjv-e2e builds: counts the input that reaches the PC before the connection is authorized, which
+/// on_message drops (TV-W6, "no input before [수락]"), in the option `hjv_e2e_dropped_input` that
+/// `--hjv-e2e-option` reads.
+#[cfg(feature = "hjv-e2e")]
+pub(super) fn e2e_dropped_input(authorized: bool, msg: &Message) {
+    use std::sync::atomic::AtomicU64;
+    static DROPPED: AtomicU64 = AtomicU64::new(0);
+    if authorized
+        || !matches!(
+            msg.union,
+            Some(
+                message::Union::MouseEvent(_)
+                    | message::Union::KeyEvent(_)
+                    | message::Union::PointerDeviceEvent(_)
+                    | message::Union::Clipboard(_)
+                    | message::Union::MultiClipboards(_)
+            )
+        )
+    {
+        return;
+    }
+    let n = DROPPED.fetch_add(1, Ordering::Relaxed) + 1;
+    Config::set_option("hjv_e2e_dropped_input".to_owned(), n.to_string());
+}
