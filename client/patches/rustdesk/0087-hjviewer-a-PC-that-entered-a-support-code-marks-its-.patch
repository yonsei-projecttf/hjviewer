+++ b/src/hjviewer_account/grant.rs
@@ -0,0 +1,423 @@
+//! The support grant (지원 확인, TV-W6; docs/access-tickets.md 3-7 "지원 확인"): with the ticket
+//! a PC gets for a staff member's support code, hjv-api signs with its list key which device made
+//! the code, for that PC only. The PC keeps it next to the ticket, in memory only (hjviewer_access)
+//! and, while it holds one, sends a nonce in its Hash, also when not installed. A connection whose
+//! same-account proof (`hjv-conn-v1`) is by that device's account key gets the connection
+//! manager's staff mark. The mark opens nothing: the click approval, the password and 2FA decide
+//! as they did.
+//!
+//! ```text
+//! "staff":{"kid":1,"g":"<standard base64 of the grant bytes>","s":"<standard base64, 88>"}
+//! signed: "hjv-support-v1" NUL <grant bytes>         key: list key `kid` (HJV_TRUST_PUBKEYS)
+//! grant bytes: {"v":1,"typ":"hjv-support","kid":1,"pc_id":"…","pc_pk":"…","ck":"…",
+//!               "ctl_id":"…","name":"","iat":…,"exp":…}
+//! ```
+
+use super::{conn_transcript, KeyLogin, Refusal, BACKWARD_SKEW, KIND_TERMINAL, SUPPORT_CONTEXT};
+use hbb_common::{
+    base64::{engine::general_purpose::STANDARD, Engine as _},
+    config::Config,
+    log,
+    sodiumoxide::crypto::sign,
+};
+use serde_derive::Deserialize;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+/// The longest a grant may live (`exp - iat`): the support code's ticket, two hours.
+pub(crate) const MAX_GRANT_LIFE: u64 = 7200;
+/// The grant bytes hjv-api may send, at most.
+const MAX_GRANT_BYTES: usize = 4096;
+/// A 64-byte signature in standard base64.
+const SIG_B64_LEN: usize = 88;
+
+/// `staff` of the support code's answer.
+#[derive(Deserialize)]
+struct Signed {
+    kid: u32,
+    g: String,
+    s: String,
+}
+
+/// The grant bytes, read only after their signature held, and only with these ten members.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Statement {
+    v: u32,
+    typ: String,
+    kid: u32,
+    pc_id: String,
+    pc_pk: String,
+    ck: String,
+    ctl_id: String,
+    /// always "" (decisions: outsiders' PCs show no name); read, never shown
+    #[allow(dead_code)]
+    name: String,
+    iat: u64,
+    exp: u64,
+}
+
+/// A grant this PC accepted.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Grant {
+    /// the account key of the device that made the code
+    pub ck: [u8; 32],
+    /// that device's ID, or "" when hjv-api did not know it
+    pub ctl_id: String,
+    /// `exp - iat`
+    pub life: u64,
+    /// when it came, by this PC's clock
+    pub received: u64,
+}
+
+/// What the list key signs: `"hjv-support-v1" NUL` and the grant bytes as hjv-api sent them.
+pub(crate) fn support_message(grant: &[u8]) -> Vec<u8> {
+    let mut m = SUPPORT_CONTEXT.to_vec();
+    m.push(0);
+    m.extend_from_slice(grant);
+    m
+}
+
+/// Checks the `staff` of a support code's answer, received at `received` by this PC's clock: a
+/// pinned list key (no key floor: such a PC is not bound), the signature over the bytes as
+/// received and only then their contents, this PC's ID and device key, a 32-byte account key and
+/// a lifetime of 1 to MAX_GRANT_LIFE seconds.
+pub(crate) fn verify_grant(
+    pinned: &[(u32, [u8; 32])],
+    staff: &serde_json::Value,
+    own_id: &str,
+    own_pk: &[u8],
+    received: u64,
+) -> Result<Grant, Refusal> {
+    let signed: Signed = serde_json::from_value(staff.clone()).map_err(|_| Refusal::BadEncoding)?;
+    if signed.s.len() != SIG_B64_LEN || signed.g.len() > MAX_GRANT_BYTES.div_ceil(3) * 4 {
+        return Err(Refusal::BadEncoding);
+    }
+    let bytes = STANDARD
+        .decode(&signed.g)
+        .map_err(|_| Refusal::BadEncoding)?;
+    let sig = STANDARD
+        .decode(&signed.s)
+        .map_err(|_| Refusal::BadEncoding)?;
+    if bytes.len() > MAX_GRANT_BYTES {
+        return Err(Refusal::BadEncoding);
+    }
+    let pk = pinned
+        .iter()
+        .find(|(k, _)| *k == signed.kid)
+        .map(|(_, pk)| sign::PublicKey(*pk))
+        .ok_or(Refusal::UnknownKid)?;
+    let sig = sign::Signature::from_bytes(&sig).map_err(|_| Refusal::BadEncoding)?;
+    if !sign::verify_detached(&sig, &support_message(&bytes), &pk) {
+        return Err(Refusal::BadListSignature);
+    }
+    let grant: Statement = serde_json::from_slice(&bytes).map_err(|_| Refusal::BadEncoding)?;
+    if grant.v != 1 || grant.typ != "hjv-support" || grant.kid != signed.kid {
+        return Err(Refusal::BadEncoding);
+    }
+    let pc_pk = STANDARD
+        .decode(&grant.pc_pk)
+        .map_err(|_| Refusal::BadEncoding)?;
+    if grant.pc_id != own_id || pc_pk != own_pk {
+        return Err(Refusal::WrongPc);
+    }
+    let ck: [u8; 32] = STANDARD
+        .decode(&grant.ck)
+        .ok()
+        .and_then(|ck| ck.try_into().ok())
+        .ok_or(Refusal::BadEncoding)?;
+    if grant.exp <= grant.iat || grant.exp - grant.iat > MAX_GRANT_LIFE {
+        return Err(Refusal::BadLifetime);
+    }
+    Ok(Grant {
+        ck,
+        ctl_id: grant.ctl_id,
+        life: grant.exp - grant.iat,
+        received,
+    })
+}
+
+/// A grant lives for its lifetime from its receipt by the PC's clock, as a trust list does; a PC
+/// clock set back by more than BACKWARD_SKEW ends it.
+pub(crate) fn grant_valid_at(grant: &Grant, now: u64) -> bool {
+    now.saturating_add(BACKWARD_SKEW) >= grant.received
+        && now < grant.received.saturating_add(grant.life)
+}
+
+/// The PC's check of a proof against the support grant, in this order: a grant that holds, the
+/// channel, the nonce, the kind, the proof's version, its key being the grant's `ck`, the
+/// signature over the transcript this PC rebuilds from its own ID, key and nonce, and the grant's
+/// `ctl_id` being empty or the login's ID. Ok marks the connection; nothing else changes.
+pub(crate) fn support_mark(
+    grant: Option<&Grant>,
+    login: &KeyLogin,
+    now: u64,
+) -> Result<(), Refusal> {
+    let grant = grant.ok_or(Refusal::NoList)?;
+    if !grant_valid_at(grant, now) {
+        return Err(Refusal::Expired);
+    }
+    if !login.secured {
+        return Err(Refusal::NotSecured);
+    }
+    if login.nonce.len() != 32 {
+        return Err(Refusal::NoNonce);
+    }
+    if login.kind > KIND_TERMINAL {
+        return Err(Refusal::KindNotByProof);
+    }
+    let proof = login.proof;
+    if proof.version != 1 {
+        return Err(Refusal::BadEncoding);
+    }
+    if proof.pk[..] != grant.ck[..] {
+        return Err(Refusal::UnknownKey);
+    }
+    let sig = sign::Signature::from_bytes(&proof.signature).map_err(|_| Refusal::BadEncoding)?;
+    let transcript = conn_transcript(
+        login.pc_id,
+        login.pc_pk,
+        login.nonce,
+        login.my_id,
+        login.kind,
+        &proof.pk,
+    )
+    .ok_or(Refusal::BadEncoding)?;
+    if !sign::verify_detached(&sig, &transcript, &sign::PublicKey(grant.ck)) {
+        return Err(Refusal::BadProofSignature);
+    }
+    if !grant.ctl_id.is_empty() && grant.ctl_id != login.my_id {
+        return Err(Refusal::IdMismatch);
+    }
+    Ok(())
+}
+
+/// PC (server/connection): whether a LoginRequest's proof is by the device that made this PC's
+/// support code. False without a grant or a proof; a refusal is logged once a minute.
+pub(crate) fn staff_login(
+    secured: bool,
+    nonce: &[u8],
+    proof: &base::message_proto::HjvKeyProof,
+    my_id: &str,
+    kind: u8,
+) -> bool {
+    let Some(grant) = crate::hjviewer_access::support_grant() else {
+        return false;
+    };
+    let pc_id = Config::get_id();
+    let pc_pk = Config::get_key_pair().1;
+    let login = KeyLogin {
+        pc_id: &pc_id,
+        pc_pk: &pc_pk,
+        secured,
+        nonce,
+        proof,
+        my_id,
+        kind,
+    };
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs());
+    match support_mark(Some(&grant), &login, now) {
+        Ok(()) => {
+            log::info!("hjv: support mark for {my_id}");
+            true
+        }
+        Err(refusal) => {
+            hbb_common::throttled_log!(
+                Duration::from_secs(60),
+                info,
+                "hjv: support mark refused: {refusal:?}"
+            );
+            false
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::hjviewer_account::{
+        conn_proof, parse_trust_pubkeys, vectors::*, AccountKey, KIND_FILE, KIND_PORT_FORWARD,
+    };
+    use base::message_proto::HjvKeyProof;
+    use hbb_common::bytes::Bytes;
+    use serde_json::json;
+
+    fn staff(g: &str, s: &str) -> serde_json::Value {
+        json!({ "kid": 1, "g": STANDARD.encode(g), "s": s })
+    }
+
+    fn grant() -> Grant {
+        let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+        verify_grant(
+            &pinned,
+            &staff(SUPPORT_GRANT, SUPPORT_GRANT_SIG),
+            PC_ID,
+            &pk_bytes(PC_PK),
+            T,
+        )
+        .unwrap()
+    }
+
+    fn vector_proof() -> HjvKeyProof {
+        HjvKeyProof {
+            version: 1,
+            pk: Bytes::from(pk_bytes(ACCOUNT_PK)),
+            signature: Bytes::from(pk_bytes(CONN_SIG)),
+            key_serial: CONN_KEY_SERIAL,
+            ..Default::default()
+        }
+    }
+
+    fn login<'a>(pc_pk: &'a [u8], proof: &'a HjvKeyProof) -> KeyLogin<'a> {
+        KeyLogin {
+            pc_id: PC_ID,
+            pc_pk,
+            secured: true,
+            nonce: &CONN_NONCE,
+            proof,
+            my_id: CTL_ID,
+            kind: CONN_KIND,
+        }
+    }
+
+    #[test]
+    fn a_grant_lives_from_its_receipt_and_ends_with_the_clock_set_back() {
+        let grant = grant();
+        assert_eq!(grant.life, MAX_GRANT_LIFE);
+        assert!(grant_valid_at(&grant, T));
+        assert!(grant_valid_at(&grant, T + MAX_GRANT_LIFE - 1));
+        assert!(!grant_valid_at(&grant, T + MAX_GRANT_LIFE));
+        assert!(grant_valid_at(&grant, T - BACKWARD_SKEW));
+        assert!(!grant_valid_at(&grant, T - BACKWARD_SKEW - 1));
+    }
+
+    #[test]
+    fn a_grant_is_refused_for_its_form_before_its_bytes_are_read() {
+        let _ = hbb_common::sodiumoxide::init();
+        let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+        let pc_pk = pk_bytes(PC_PK);
+        let check = |staff: serde_json::Value| verify_grant(&pinned, &staff, PC_ID, &pc_pk, T);
+        // a key number the build does not pin
+        let mut other_kid = staff(SUPPORT_GRANT, SUPPORT_GRANT_SIG);
+        other_kid["kid"] = json!(3);
+        assert_eq!(check(other_kid), Err(Refusal::UnknownKid));
+        // list key 2 did not sign it
+        let mut kid_2 = staff(SUPPORT_GRANT, SUPPORT_GRANT_SIG);
+        kid_2["kid"] = json!(2);
+        assert_eq!(check(kid_2), Err(Refusal::BadListSignature));
+        // the signature's length, a missing member, too many bytes
+        assert_eq!(
+            check(staff(SUPPORT_GRANT, &SUPPORT_GRANT_SIG[..86])),
+            Err(Refusal::BadEncoding)
+        );
+        assert_eq!(
+            check(json!({ "kid": 1, "g": STANDARD.encode(SUPPORT_GRANT) })),
+            Err(Refusal::BadEncoding)
+        );
+        let long = "x".repeat(MAX_GRANT_BYTES + 1);
+        assert_eq!(
+            check(staff(&long, SUPPORT_GRANT_SIG)),
+            Err(Refusal::BadEncoding)
+        );
+        // the trust list's signature over the same bytes is not a grant's: another context
+        let sig = sign::sign_detached(
+            &crate::hjviewer_account::trust_message(SUPPORT_GRANT.as_bytes()),
+            &device_key(&LIST_1_SEED),
+        );
+        assert_eq!(
+            check(staff(SUPPORT_GRANT, &STANDARD.encode(sig.to_bytes()))),
+            Err(Refusal::BadListSignature)
+        );
+    }
+
+    #[test]
+    fn the_device_that_made_the_code_gets_the_mark() {
+        let _ = hbb_common::sodiumoxide::init();
+        let (grant, pc_pk, proof) = (grant(), pk_bytes(PC_PK), vector_proof());
+        assert_eq!(
+            support_mark(Some(&grant), &login(&pc_pk, &proof), T + 60),
+            Ok(())
+        );
+        // also as a file transfer, by a proof made for it
+        let account = AccountKey::from_seed(&ACCOUNT_SEED).unwrap();
+        let file = conn_proof(&account, PC_ID, &pc_pk, &CONN_NONCE, CTL_ID, KIND_FILE, 0).unwrap();
+        let file_login = KeyLogin {
+            kind: KIND_FILE,
+            ..login(&pc_pk, &file)
+        };
+        assert_eq!(support_mark(Some(&grant), &file_login, T + 60), Ok(()));
+    }
+
+    #[test]
+    fn every_other_login_goes_without_the_mark() {
+        let _ = hbb_common::sodiumoxide::init();
+        let (grant, pc_pk, proof) = (grant(), pk_bytes(PC_PK), vector_proof());
+        let mark = |login: &KeyLogin, now: u64| support_mark(Some(&grant), login, now);
+        let now = T + 60;
+        assert_eq!(
+            support_mark(None, &login(&pc_pk, &proof), now),
+            Err(Refusal::NoList)
+        );
+        assert_eq!(
+            mark(&login(&pc_pk, &proof), T + MAX_GRANT_LIFE),
+            Err(Refusal::Expired)
+        );
+        let plain = KeyLogin {
+            secured: false,
+            ..login(&pc_pk, &proof)
+        };
+        assert_eq!(mark(&plain, now), Err(Refusal::NotSecured));
+        let no_nonce = KeyLogin {
+            nonce: &[],
+            ..login(&pc_pk, &proof)
+        };
+        assert_eq!(mark(&no_nonce, now), Err(Refusal::NoNonce));
+        let forward = KeyLogin {
+            kind: KIND_PORT_FORWARD,
+            ..login(&pc_pk, &proof)
+        };
+        assert_eq!(mark(&forward, now), Err(Refusal::KindNotByProof));
+        let v2 = HjvKeyProof {
+            version: 2,
+            ..vector_proof()
+        };
+        assert_eq!(mark(&login(&pc_pk, &v2), now), Err(Refusal::BadEncoding));
+        // another account key's valid proof: the vectors' other_key_proof
+        let other = HjvKeyProof {
+            pk: Bytes::from(pk_bytes(SUPPORT_OTHER_KEY_PK)),
+            signature: Bytes::from(pk_bytes(SUPPORT_OTHER_KEY_SIG)),
+            ..vector_proof()
+        };
+        assert_eq!(mark(&login(&pc_pk, &other), now), Err(Refusal::UnknownKey));
+        // the maker's key, but signed for another nonce (a replay from another connection)
+        let replay = KeyLogin {
+            nonce: &[0x41; 32],
+            ..login(&pc_pk, &proof)
+        };
+        assert_eq!(mark(&replay, now), Err(Refusal::BadProofSignature));
+        // the maker's key signing for another controller ID than the grant's
+        let account = AccountKey::from_seed(&ACCOUNT_SEED).unwrap();
+        let elsewhere = conn_proof(
+            &account,
+            PC_ID,
+            &pc_pk,
+            &CONN_NONCE,
+            "111111111",
+            CONN_KIND,
+            0,
+        )
+        .unwrap();
+        let elsewhere_login = KeyLogin {
+            my_id: "111111111",
+            ..login(&pc_pk, &elsewhere)
+        };
+        assert_eq!(mark(&elsewhere_login, now), Err(Refusal::IdMismatch));
+        // a grant without ctl_id takes any controller ID the proof signed
+        let any_id = Grant {
+            ctl_id: String::new(),
+            ..grant.clone()
+        };
+        assert_eq!(support_mark(Some(&any_id), &elsewhere_login, now), Ok(()));
+    }
+}
