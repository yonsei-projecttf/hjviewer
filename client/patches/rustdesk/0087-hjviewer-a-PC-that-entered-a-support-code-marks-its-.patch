+    let grant = crate::hjviewer_account::Grant {
+        ck: [7; 32],
+        ctl_id: "987654321".into(),
+        life: 7200,
+        received: NOW,
+    };
+    let code = json!({ "ticket": "t1.code", "use": "pc", "exp": NOW + 7200, "server_time": NOW });
+    assert!(keep_guest_pc_with(&code, Some(grant.clone()), NOW));
+    assert_eq!(held_grant(NOW + 60), Some(grant.clone()));
+    assert_eq!(held_grant(NOW + 7200), None);
