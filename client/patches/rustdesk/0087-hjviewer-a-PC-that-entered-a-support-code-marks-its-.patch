+/// flutter's formatID: digits in groups of three, the first group the remainder.
+fn spaced_id(id: &str) -> String {
+    if id.len() <= 3 || !id.bytes().all(|b| b.is_ascii_digit()) {
+        return id.to_owned();
+    }
+    let first = match id.len() % 3 {
+        0 => 3,
+        n => n,
+    };
+    let mut spaced = id[..first].to_owned();
+    for group in id.as_bytes()[first..].chunks(3) {
+        spaced.push(' ');
+        spaced.push_str(&String::from_utf8_lossy(group));
+    }
+    spaced
+}
