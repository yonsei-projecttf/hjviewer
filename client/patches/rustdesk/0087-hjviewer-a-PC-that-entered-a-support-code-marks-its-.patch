+#[test]
+fn support_grant() {
+    use crate::hjviewer_account::grant::{support_mark, support_message, verify_grant};
+    let _ = hbb_common::sodiumoxide::init();
+    let pinned = parse_trust_pubkeys(HJV_TRUST_PUBKEYS).unwrap();
+    let pc_pk = pk_bytes(PC_PK);
+    let staff = |g: &str, s: &str| serde_json::json!({"kid": 1, "g": STANDARD.encode(g), "s": s});
+    let check = |g: &str, s: &str| verify_grant(&pinned, &staff(g, s), PC_ID, &pc_pk, T);
+    // libsodium signs what the vectors say
+    let signed = support_message(SUPPORT_GRANT.as_bytes());
+    assert_eq!(hex::encode(&signed), SUPPORT_GRANT_SIGNED_HEX);
+    for (g, s) in [
+        (SUPPORT_GRANT, SUPPORT_GRANT_SIG),
+        (SUPPORT_OTHER_PC, SUPPORT_OTHER_PC_SIG),
+        (SUPPORT_LIFE_7201, SUPPORT_LIFE_7201_SIG),
+        (SUPPORT_UNKNOWN_MEMBER, SUPPORT_UNKNOWN_MEMBER_SIG),
+    ] {
+        let sig = sign::sign_detached(&support_message(g.as_bytes()), &device_key(&LIST_1_SEED));
+        assert_eq!(STANDARD.encode(sig.to_bytes()), s);
+    }
+    let grant = check(SUPPORT_GRANT, SUPPORT_GRANT_SIG).unwrap();
+    assert_eq!(
+        (
+            grant.ck.to_vec(),
+            grant.ctl_id.as_str(),
+            grant.life,
+            grant.received
+        ),
+        (pk_bytes(ACCOUNT_PK), CTL_ID, 7200, T)
+    );
+    // the five refusals, each for its own reason
+    assert_eq!(
+        check(SUPPORT_OTHER_PC, SUPPORT_OTHER_PC_SIG),
+        Err(Refusal::WrongPc)
+    );
+    assert_eq!(
+        check(SUPPORT_ALTERED, SUPPORT_GRANT_SIG),
+        Err(Refusal::BadListSignature)
+    );
+    assert_eq!(
+        check(SUPPORT_LIFE_7201, SUPPORT_LIFE_7201_SIG),
+        Err(Refusal::BadLifetime)
+    );
+    assert_eq!(
+        check(SUPPORT_UNKNOWN_MEMBER, SUPPORT_UNKNOWN_MEMBER_SIG),
+        Err(Refusal::BadEncoding)
+    );
+    let other_pk = pk_bytes(SUPPORT_OTHER_KEY_PK);
+    let transcript =
+        conn_transcript(PC_ID, &pc_pk, &CONN_NONCE, CTL_ID, CONN_KIND, &other_pk).unwrap();
+    assert_eq!(hex::encode(&transcript), SUPPORT_OTHER_KEY_TRANSCRIPT_HEX);
+    let other = AccountKey::from_seed(&SUPPORT_OTHER_KEY_SEED).unwrap();
+    assert_eq!(
+        STANDARD.encode(other.sign(&transcript)),
+        SUPPORT_OTHER_KEY_SIG
+    );
+    let proof = |pk: &str, sig: &str| HjvKeyProof {
+        version: 1,
+        pk: Bytes::from(pk_bytes(pk)),
+        signature: Bytes::from(pk_bytes(sig)),
+        ..Default::default()
+    };
+    fn login<'a>(pc_pk: &'a [u8], proof: &'a HjvKeyProof) -> KeyLogin<'a> {
+        KeyLogin {
+            pc_id: PC_ID,
+            pc_pk,
+            secured: true,
+            nonce: &CONN_NONCE,
+            proof,
+            my_id: CTL_ID,
+            kind: CONN_KIND,
+        }
+    }
+    let maker = proof(ACCOUNT_PK, CONN_SIG);
+    assert_eq!(
+        support_mark(Some(&grant), &login(&pc_pk, &maker), T + 60),
+        Ok(())
+    );
+    let other = proof(SUPPORT_OTHER_KEY_PK, SUPPORT_OTHER_KEY_SIG);
+    assert_eq!(
+        support_mark(Some(&grant), &login(&pc_pk, &other), T + 60),
+        Err(Refusal::UnknownKey)
+    );
+}
