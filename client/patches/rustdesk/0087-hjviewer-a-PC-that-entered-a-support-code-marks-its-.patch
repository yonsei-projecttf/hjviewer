+    assert!(keep_guest_pc_with(&password, None, NOW));
+    assert_eq!(held_grant(NOW + 60), None);
+    // and so does the end of this PC's ticket (hjv-guest-pc-end)
+    assert!(keep_guest_pc_with(&code, Some(grant), NOW));
+    forget_guest_pc();
+    assert_eq!(held_grant(NOW + 60), None);
