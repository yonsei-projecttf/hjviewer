+/// hjv-e2e builds only: every headless command is a process of its own, and the support PCs live
+/// in the memory of the process that learned them. `--hjv-e2e-support-wait` hands the PC its
+/// waiting room named on in LocalConfig (E2E_PC), which support_pc reads when its memory has
+/// none, so that the next command's controller sends the support proof (docs/e2e.md, W6-E4).
+#[cfg(feature = "hjv-e2e")]
+const E2E_PC: &str = "hjv-e2e-support-pc";
+
+#[cfg(feature = "hjv-e2e")]
+fn unix_now() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+/// `--hjv-e2e-support-wait`: keeps the support PC `pc_id` of this login for the next commands.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) fn e2e_keep_support_pc(pc_id: &str) {
+    let login = login_of(&LocalConfig::get_option("access_token"));
+    let now = Instant::now();
+    let mut room = room();
+    room.tidy(&login, now);
+    let Some(pc) = room.pcs.get(pc_id) else {
+        return;
+    };
+    let until = unix_now() + pc.until.saturating_duration_since(now).as_secs();
+    let kept = json!({
+        "pc": pc_id,
+        "pk": STANDARD.encode(pc.pk),
+        "until": until,
+        "login": STANDARD.encode(login),
+    });
+    LocalConfig::set_option(E2E_PC.to_owned(), kept.to_string());
+}
+
+/// The key of the support PC `pc_id` that an earlier command kept for `login`, until its ticket ends.
+#[cfg(feature = "hjv-e2e")]
+fn e2e_support_pc(pc_id: &str, login: &[u8; 32]) -> Option<[u8; 32]> {
+    let kept: Value = serde_json::from_str(&LocalConfig::get_option(E2E_PC)).ok()?;
+    (kept.get("pc")?.as_str()? == pc_id).then_some(())?;
+    (kept.get("login")?.as_str()? == STANDARD.encode(login)).then_some(())?;
+    (unix_now() < kept.get("until")?.as_u64()?).then_some(())?;
+    STANDARD
+        .decode(kept.get("pk")?.as_str()?)
+        .ok()?
+        .try_into()
+        .ok()
+}
+
