new file mode 100644
index 0000000..12c9379
--- /dev/null
+++ b/src/hjviewer_account/support.rs
@@ -0,0 +1,293 @@
+//! Support codes (지원 코드, docs/access-tickets.md 3-7, 1.8.2): a logged-in staff member's app
+//! makes one with `POST /api/hjv/support-code` for someone who is not logged in, whose PC trades
+//! it for a ticket of its own (hjviewer_access/guest.rs). The request goes by the login, its token
+//! signed by the account key (X-HJV-Proof), as every account request.
+//!
+//! The screens ask through main_set_common, which waits for the answer, and read it once with
+//! main_get_common, so that the code stays in no setting, file or log:
+//!   set "hjv-support-code-make"
+//!   get "hjv-support-code-result"
+//!       {"ok":true,"code":"K7M2-Q9XD","expires_in":600} or {"ok":false,"error":"no_code"|
+//!       "too_many_codes"|"rate_limited"|"busy"|"unavailable"|"bad_request"|"login"|"network"|
+//!       "config"}, `too_many_codes` and `rate_limited` with "retry_after" when hjv-api said it;
+//!       "" once read. `login` is hjv-api's 401 to the login that still is the app's: the screens
+//!       end it as their own 401 ends it.
+//! Whether this login may make codes at all (`hjv-support-code`) is the login answer's and
+//! currentUser's `hjv.support_code` (api.rs).
+
+use hbb_common::config::LocalConfig;
+use serde_json::{json, Value};
+use std::{io::Read, sync::Mutex, time::Duration};
+
+const PATH: &str = "/api/hjv/support-code";
+/// The one body hjv-api takes (`use` is where a controller's code would go; 1.8.2 makes `pc`).
+const BODY: &str = r#"{"use":"pc"}"#;
+const SERVER: Option<&str> = option_env!("HJV_SERVER");
+const TIMEOUT: Duration = Duration::from_secs(20);
+const MAX_ANSWER: u64 = 8192;
+/// hjv-api's codes live ten minutes; an `expires_in` beyond an hour is no code's.
+const MAX_EXPIRES: u64 = 3600;
+
+/// The last answer, until the screen read it.
+static RESULT: Mutex<String> = Mutex::new(String::new());
+
+/// main_set_common: true when the key was this module's.
+pub(super) fn set_common(key: &str) -> bool {
+    if key != "hjv-support-code-make" {
+        return false;
+    }
+    let result = make().to_string();
+    *RESULT.lock().unwrap_or_else(|e| e.into_inner()) = result;
+    true
+}
+
+/// main_get_common: the last answer, taken.
+pub(super) fn get_common(key: &str) -> Option<String> {
+    (key == "hjv-support-code-result")
+        .then(|| std::mem::take(&mut *RESULT.lock().unwrap_or_else(|e| e.into_inner())))
+}
+
+/// One request for a code, and once more after a 409 `clock`, whose server time the account
+/// module learns from the answer as from any account answer. It blocks.
+fn make() -> Value {
+    let Some(server) = SERVER.filter(|server| !server.is_empty()) else {
+        return failed("config", 0);
+    };
+    let token = LocalConfig::get_option("access_token");
+    if token.is_empty() {
+        return failed("login", 0);
+    }
+    let url = format!("https://{server}{PATH}");
+    let mut again = true;
+    loop {
+        // no proof: no account key that can be used now (a locked iPhone, a restored one)
+        let Some(proof) = super::proof_header("POST", PATH, BODY.as_bytes(), &token) else {
+            return failed("config", 0);
+        };
+        let Some((status, date, text)) = post(&url, &token, &proof) else {
+            return failed("network", 0);
+        };
+        super::observe_account_response(
+            &url,
+            &json!({ "status_code": status, "headers": { "date": date }, "body": text })
+                .to_string(),
+        );
+        let answer = outcome(status, &text);
+        if again && answer.get("error").and_then(Value::as_str) == Some("clock") {
+            again = false;
+            continue;
+        }
+        // a 401 to a login that another login or a logout replaced meanwhile ends nothing
+        if answer.get("error").and_then(Value::as_str) == Some("login")
+            && LocalConfig::get_option("access_token") != token
+        {
+            return failed("network", 0);
+        }
+        return answer;
+    }
+}
+
+/// POSTs the body by the login with the certificate checked: the status, the Date header and at
+/// most MAX_ANSWER bytes of the answer; None without an answer of the asked address.
+fn post(url: &str, token: &str, proof: &str) -> Option<(u16, String, String)> {
+    let client = crate::hbbs_http::create_http_client_with_url_strict(url).ok()?;
+    let response = client
+        .post(url)
+        .header(reqwest::header::CONTENT_TYPE, "application/json")
+        .header(reqwest::header::AUTHORIZATION, format!("Bearer {token}"))
+        .header("X-HJV-Proof", proof)
+        .body(BODY)
+        .timeout(TIMEOUT)
+        .send()
+        .ok()?;
+    // the client follows redirections: an answer from elsewhere is not hjv-api's
+    if url::Url::parse(url).ok().as_ref() != Some(response.url()) {
+        return None;
+    }
+    let status = response.status().as_u16();
+    let date = response
+        .headers()
+        .get(reqwest::header::DATE)
+        .and_then(|date| date.to_str().ok())
+        .unwrap_or_default()
+        .to_owned();
+    let mut text = Vec::new();
+    response.take(MAX_ANSWER).read_to_end(&mut text).ok()?;
+    Some((status, date, String::from_utf8_lossy(&text).into_owned()))
+}
+
+fn failed(error: &str, retry_after: u64) -> Value {
+    if retry_after > 0 {
+        json!({ "ok": false, "error": error, "retry_after": retry_after })
+    } else {
+        json!({ "ok": false, "error": error })
+    }
+}
+
+/// What the screens get for hjv-api's answer of `status` with the body `text` (the doc 3-7):
+/// the code of a 200 answer as hjv-api shows it, or why none came (`clock` for the one more try).
+fn outcome(status: u16, text: &str) -> Value {
+    let answer = serde_json::from_str::<Value>(text).unwrap_or_default();
+    let hjv = answer
+        .get("hjv")
+        .and_then(Value::as_str)
+        .unwrap_or_default();
+    let retry_after = answer
+        .get("retry_after")
+        .and_then(Value::as_u64)
+        .unwrap_or_default();
+    match (status, hjv) {
+        (200, _) => {
+            let code = answer.get("code").and_then(Value::as_str);
+            let expires_in = answer.get("expires_in").and_then(Value::as_u64);
+            match (code, expires_in) {
+                (Some(code), Some(expires_in))
+                    if shown_code(code) && (1..=MAX_EXPIRES).contains(&expires_in) =>
+                {
+                    json!({ "ok": true, "code": code, "expires_in": expires_in })
+                }
+                _ => failed("bad_request", 0),
+            }
+        }
+        (401, _) => failed("login", 0),
+        (403, "no_code") => failed("no_code", 0),
+        (409, "clock") => failed("clock", 0),
+        (429, "too_many_codes") => failed("too_many_codes", retry_after),
+        (429, _) => failed("rate_limited", retry_after),
+        (503, "busy") => failed("busy", 0),
+        (502..=504, _) => failed("unavailable", 0),
+        (400, _) => failed("bad_request", 0),
+        _ => failed("network", 0),
+    }
+}
+
+/// A code as hjv-api shows it: `XXXX-XXXX` of Crockford's base32 (update.rs `shown`).
+fn shown_code(code: &str) -> bool {
+    const SYMBOLS: &[u8] = b"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+    let bytes = code.as_bytes();
+    bytes.len() == 9
+        && bytes[4] == b'-'
+        && bytes
+            .iter()
+            .enumerate()
+            .all(|(i, b)| i == 4 || SYMBOLS.contains(b))
+}
+
+/// `--hjv-e2e-support-code`: a code made by the login, printed for the E2E's PC to trade
+/// (`--hjv-e2e-guest-pc-code`). 0, or 6 without one.
+#[cfg(feature = "hjv-e2e")]
+pub(crate) fn e2e_make() -> i32 {
+    let answer = make();
+    match answer.get("code").and_then(Value::as_str) {
+        Some(code) => {
+            println!("hjv-e2e: support code: {code}");
+            0
+        }
+        None => {
+            let error = answer.get("error").and_then(Value::as_str);
+            println!("hjv-e2e: support code: {}", error.unwrap_or("network"));
+            6
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn outcome_of(status: u16, body: Value) -> Value {
+        outcome(status, &body.to_string())
+    }
+
+    #[test]
+    fn what_hjv_api_answers_a_request_for_a_code() {
+        // the one body hjv-api takes
+        assert_eq!(
+            serde_json::from_str::<Value>(BODY).unwrap(),
+            json!({ "use": "pc" })
+        );
+        assert_eq!(
+            outcome_of(
+                200,
+                json!({"code": "K7M2-Q9XD", "use": "pc", "expires_in": 600})
+            ),
+            json!({"ok": true, "code": "K7M2-Q9XD", "expires_in": 600})
+        );
+        // a 200 answer that is not a code's
+        for body in [
+            json!({"code": "K7M2Q9XD", "expires_in": 600}),
+            json!({"code": "K7M2-Q9XU", "expires_in": 600}),
+            json!({"code": "k7m2-q9xd", "expires_in": 600}),
+            json!({"code": "K7M2-Q9XD", "expires_in": 0}),
+            json!({"code": "K7M2-Q9XD", "expires_in": 7200}),
+            json!({"code": "K7M2-Q9XD"}),
+            json!({"error": "x"}),
+        ] {
+            assert_eq!(
+                outcome_of(200, body.clone()),
+                json!({"ok": false, "error": "bad_request"}),
+                "{body}"
+            );
+        }
+        assert_eq!(
+            outcome(200, "<html>"),
+            json!({"ok": false, "error": "bad_request"})
+        );
+        // the refusals (server/api/src/support.rs), S5 to S7
+        let refused = |status: u16, body: Value| outcome_of(status, body);
+        assert_eq!(
+            refused(
+                403,
+                json!({"error": "이 계정으로는 지원 코드를 만들 수 없습니다.", "hjv": "no_code"})
+            ),
+            json!({"ok": false, "error": "no_code"})
+        );
+        assert_eq!(
+            refused(
+                429,
+                json!({"error": "…", "hjv": "too_many_codes", "retry_after": 170})
+            ),
+            json!({"ok": false, "error": "too_many_codes", "retry_after": 170})
+        );
+        assert_eq!(
+            refused(429, json!({"error": "…", "hjv": "rate_limited"})),
+            json!({"ok": false, "error": "rate_limited"})
+        );
+        assert_eq!(
+            refused(503, json!({"error": "…", "hjv": "busy"})),
+            json!({"ok": false, "error": "busy"})
+        );
+        assert_eq!(
+            refused(503, json!({"error": "…", "hjv": "unavailable"})),
+            json!({"ok": false, "error": "unavailable"})
+        );
+        assert_eq!(
+            refused(409, json!({"error": "…", "hjv": "clock", "server_time": 1})),
+            json!({"ok": false, "error": "clock"})
+        );
+        assert_eq!(
+            refused(401, json!({"error": "invalid token"})),
+            json!({"ok": false, "error": "login"})
+        );
+        assert_eq!(
+            refused(400, json!({"error": "…", "hjv": "bad_request"})),
+            json!({"ok": false, "error": "bad_request"})
+        );
+        for status in [403, 404, 500] {
+            assert_eq!(
+                refused(status, json!({})),
+                json!({"ok": false, "error": "network"}),
+                "{status}"
+            );
+        }
+        // what the screens read, once
+        *RESULT.lock().unwrap() = failed("busy", 0).to_string();
+        assert_eq!(
+            get_common("hjv-support-code-result").as_deref(),
+            Some(r#"{"error":"busy","ok":false}"#)
+        );
+        assert_eq!(get_common("hjv-support-code-result").as_deref(), Some(""));
+        assert_eq!(get_common("hjv-support-code"), None);
+        assert!(!set_common("hjv-support-code-result"));
+    }
+}
