-/// [끝내기]: the process that registers forgets this PC's access password ticket, and the PC
-/// registers without it.
+/// P3: a support code from a staff member in the place of the access password, as P2 takes that;
+/// what is not a code's form is not sent (E6 at once).
+void _pcCodeDialog(HjvAccessTexts t) {
+  final controller = TextEditingController();
+  String? error;
+  var busy = false;
+  var retryAt = 0;
+  var closed = false;
+  final dialog = gFFI.dialogManager.show((setState, close, context) {
+    bool canSend(String typed) =>
+        hjvAccessCanSend(typed, busy: busy, retryAt: retryAt, now: _unixNow());
+
+    Future<void> submit() async {
+      final code = hjvAccessPassword(controller.text);
+      if (!canSend(code)) return;
+      if (hjvReadSupportCode(code) == null) {
+        setState(() => error = t.codeFailure('denied'));
+        return;
+      }
+      setState(() {
+        busy = true;
+        error = null;
+      });
+      String result() =>
+          bind.mainGetCommonSync(key: hjvGuestResultKey(code: true));
+      String? failure;
+      try {
+        await bind.mainSetCommon(
+            key: kHjvGuestPcCode, value: hjvGuestPcCodeValue(code));
+        final noted = hjvGuestFailure(result());
+        if (noted != null) {
+          failure = t.codeFailure(noted,
+              wait: hjvGuestNumber(result(), 'retry_after'));
+        }
+      } catch (e) {
+        failure = t.codeFailure('network');
+      }
+      if (closed) {
+        // [취소] while it was checked: a ticket that came all the same ends at once
+        if (failure == null) {
+          unawaited(bind
+              .mainSetCommon(key: kHjvGuestPcEnd, value: '')
+              .catchError((Object e) => debugPrint('hjv: $e')));
+        }
+        return;
+      }
+      if (failure != null) {
+        setState(() {
+          busy = false;
+          error = failure;
+          retryAt = hjvRetryAt(result(), _unixNow());
+        });
+        _untilRetry(retryAt, setState, () => closed);
+        return;
+      }
+      close();
+      final until = hjvGuestNumber(result(), 'until');
+      if (until > _unixNow()) {
+        _guestUntil.value = until;
+        _guestByCode.value = true;
+        showToast(t.pcGuestToast(_until(until)));
+      }
+    }
+
+    return CustomAlertDialog(
+      title: HjvDialogTitle(Icons.support_agent_rounded, t.pcCode),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(hjvKeepAll(t.pcCodeText), style: hjvDialogTextStyle(context)),
+          const SizedBox(height: 8),
+          DialogTextField(
+            title: t.pcCode,
+            controller: controller,
+            hintText: 'XXXX-XXXX',
+            prefixIcon: const Icon(Icons.support_agent_rounded, size: 20),
+            helperText: hjvKeepAll(t.codeHint),
+            errorText:
+                hjvAccessErrorNow(t, error, retryAt: retryAt, now: _unixNow()),
+            // a one-time value: no autofill, no suggestions, the letters as the code shows them
+            keyboardType: TextInputType.visiblePassword,
+            inputFormatters: [
+              TextInputFormatter.withFunction((_, value) =>
+                  value.copyWith(text: hjvCodeCapitals(value.text)))
+            ],
+            textInputAction: TextInputAction.done,
+            onSubmitted: (_) => submit(),
+            autocorrect: false,
+            enableSuggestions: false,
+          ),
+          if (busy) _checking(t, label: t.codeCheckingLabel),
+        ],
+      ),
+      actions: [
+        _button(t.cancel, close, outline: true),
+        _sendButton(t.connect, controller, canSend, submit),
+      ],
+      onSubmit: submit,
+      onCancel: close,
+    );
+  });
+  unawaited(dialog.whenComplete(() => closed = true).catchError((Object e) {
+    debugPrint('hjv: $e');
+    return null;
+  }));
+}
