+// ---- a support code from staff (S1, S2) ----
+
+/// S1 (hjviewer_account.dart: the desktop's account card, the phone's account section, the 내 PC
+/// tab): whether this login may make support codes, as hjv-api said at the login or in
+/// currentUser (reads the login, for an Obx); false outside an account build.
+bool hjvOffersSupportCodeNow() =>
+    _accountBuild &&
+    hjvOffersSupportCode(_commonSync(kHjvSupportCode),
+        loggedIn: gFFI.userModel.isLogin);
+
+/// S1's [지원 코드 만들기].
+String hjvSupportCodeLabel() => _t.makeCode;
+
+/// S1 on the home (my_group.dart, the 내 PC tab, the account's list): a quiet [지원 코드 만들기]
+/// above the list while the login may make codes.
+List<Widget> hjvSupportCodeEntry() => _accountBuild
+    ? [
+        Obx(() => hjvOffersSupportCodeNow()
+            ? Align(
+                alignment: Alignment.centerRight,
+                child: TextButton.icon(
+                    onPressed: hjvMakeSupportCode,
+                    icon: const Icon(Icons.support_agent_rounded, size: 18),
+                    label: Text(_t.makeCode)))
+            : const SizedBox.shrink())
+      ]
+    : [];
+
+/// S1: a code made at once and shown (S2) with the time it has left, until the window closes;
+/// the code stays in this window's memory only and keeps working until its ten minutes are over.
+void hjvMakeSupportCode() => _supportCodeDialog(_t);
+
+void _supportCodeDialog(HjvAccessTexts t) {
+  ({String code, int expiresIn})? made;
+  var madeAt = DateTime.now();
+  String? error;
+  var again = true;
+  var busy = false;
+  var started = false;
+  var closed = false;
+  Timer? timer;
+  unawaited(_askGateMode());
+  final dialog = gFFI.dialogManager.show((setState, close, context) {
+    Future<void> make() async {
+      timer?.cancel();
+      setState(() {
+        busy = true;
+        error = null;
+        made = null;
+      });
+      var result = '';
+      try {
+        await bind.mainSetCommon(key: kHjvSupportCodeMake, value: '');
+        result = bind.mainGetCommonSync(key: kHjvSupportCodeResult);
+      } catch (e) {
+        debugPrint('hjv: support code: $e');
+      }
+      if (closed) return;
+      final code = hjvSupportCodeMade(result);
+      if (code == null) {
+        final failure = hjvGuestFailure(result) ?? 'network';
+        if (failure == 'login') {
+          // hjv-api ended the login: as an account request's 401 ends it (the notice tells it)
+          close();
+          unawaited(gFFI.userModel.reset(resetOther: true));
+          return;
+        }
+        setState(() {
+          busy = false;
+          again = failure != 'no_code';
+          error = t.makeFailure(failure,
+              wait: hjvGuestNumber(result, 'retry_after'));
+        });
+        return;
+      }
+      setState(() {
+        busy = false;
+        made = code;
+        madeAt = DateTime.now();
+      });
+      timer = Timer.periodic(const Duration(seconds: 1), (timer) {
+        if (closed) {
+          timer.cancel();
+          return;
+        }
+        setState(() {});
+        if (hjvCodeLeft(code.expiresIn, madeAt, DateTime.now()) == 0) {
+          timer.cancel();
+        }
+      });
+    }
+
+    if (!started) {
+      started = true;
+      Future.microtask(make);
+    }
+    void copy(String text, String done) {
+      Clipboard.setData(ClipboardData(text: text));
+      showToast(done);
+    }
+
+    final p = HjvPalette.of(context);
+    final code = made;
+    final left =
+        code == null ? 0 : hjvCodeLeft(code.expiresIn, madeAt, DateTime.now());
+    return CustomAlertDialog(
+      title: HjvDialogTitle(Icons.support_agent_rounded, t.pcCode),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(hjvKeepAll(t.madeText), style: hjvDialogTextStyle(context)),
+          const SizedBox(height: 16),
+          if (busy) _checking(t, label: t.makingLabel, word: t.making),
+          if (error != null)
+            Semantics(
+                liveRegion: true,
+                child: Text(hjvKeepAll(error!),
+                    style: TextStyle(
+                        fontSize: 14, height: 1.45, color: p.dangerText))),
+          if (code != null && left > 0) ...[
+            Center(
+              child: SelectableText(code.code,
+                  style: HjvText.idLarge
+                      .copyWith(fontSize: 32, letterSpacing: 2, color: p.text)),
+            ),
+            Center(
+              child: Text(t.codeLeft(left),
+                  style: HjvText.bodySmall.copyWith(
+                      fontSize: 13,
+                      color: p.textSecondary,
+                      fontFeatures: HjvText.tabular)),
+            ).marginOnly(top: 4),
+            if (hjvGateCloses(_gateMode.value) == false)
+              hjvNoteBlock(context,
+                      icon: Icons.info_outline_rounded,
+                      text: Text(hjvKeepAll(t.serverOpen)))
+                  .marginOnly(top: 16),
+          ],
+          if (code != null && left == 0)
+            Text(hjvKeepAll(t.codeOver),
+                style: TextStyle(fontSize: 14, height: 1.45, color: p.text)),
+        ],
+      ),
+      actions: [
+        _button(t.close, close, outline: true),
+        if (code != null && left > 0) ...[
+          _button(t.copyInstructions,
+              () => copy(t.instructions(code.code), t.instructionsCopied),
+              outline: true),
+          _button(t.copyCode, () => copy(code.code, t.codeCopied)),
+        ] else if (!busy && again)
+          _button(t.makeAnother, make),
+      ],
+      onSubmit: code != null && left > 0
+          ? () => copy(code.code, t.codeCopied)
+          : close,
+      onCancel: close,
+    );
+  });
+  unawaited(dialog.whenComplete(() {
+    closed = true;
+    timer?.cancel();
+  }).catchError((Object e) {
+    debugPrint('hjv: $e');
+    return null;
+  }));
+}
