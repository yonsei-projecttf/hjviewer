+/// A session this PC ended because another connection turned privacy mode on keeps that end,
+/// also when the same controller comes back right away.
+#[test]
+fn a_privacy_mode_end_is_not_folded_into_a_reconnect() {
+    let lines = text(&[
+        start(RUN, 1, NOW - 1000, "111", 7, "remote"),
+        end(RUN, 1, NOW - 900, end_of("privacy mode")),
+        start(RUN, 2, NOW - 890, "111", 7, "remote"),
+    ]);
+    let rows = fold(&lines, RUN, NOW);
+    let ends: Vec<_> = rows.iter().map(|r| (r.end.as_str(), r.re)).collect();
+    assert_eq!(ends, [("open", 0), ("privacy", 0)]);
+}
+
 /// W9-D3's bound holds for rows that reconnect often: a row takes at most MAX_RE reconnects, and
 /// the kept rows at most KEEP_KEYS connections, so the compacted file stays bounded too.
 #[test]
