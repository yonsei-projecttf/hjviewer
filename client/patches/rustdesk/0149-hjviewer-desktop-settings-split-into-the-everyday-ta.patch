+import 'dart:io';
+
+import 'package:flutter_hbb/common/hjviewer_settings_split.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// 1.9.1: the desktop settings' split into the everyday tabs and 고급 설정
+// (common/hjviewer_settings_split.dart), plain Dart without the bridge.
+
+void main() {
+  test('고급 설정 shows its groups in the decided order', () {
+    expect(HjvAdvancedGroup.values, [
+      HjvAdvancedGroup.connection,
+      HjvAdvancedGroup.displayPerformance,
+      HjvAdvancedGroup.sessionDefaults,
+      HjvAdvancedGroup.recording,
+      HjvAdvancedGroup.security,
+      HjvAdvancedGroup.serviceUpdates,
+    ]);
+  });
+
+  test('the Display tab keeps three default options, 고급 설정 the rest', () {
+    const display = [
+      'show_remote_cursor',
+      'disable_audio',
+      'lock_after_session_end',
+    ];
+    const performance = ['i444', 'show_quality_monitor'];
+    for (final key in display) {
+      expect(hjvDefaultOptionPlace(key), HjvDefaultOptionPlace.display,
+          reason: key);
+    }
+    for (final key in performance) {
+      expect(hjvDefaultOptionPlace(key), HjvDefaultOptionPlace.performance,
+          reason: key);
+    }
+    for (final key in [
+      'view_only',
+      'collapse_toolbar',
+      'follow_remote_cursor',
+      'privacy_mode',
+    ]) {
+      expect(hjvDefaultOptionPlace(key), HjvDefaultOptionPlace.session,
+          reason: key);
+    }
+    // the literals are consts.dart's option keys
+    final consts = File('lib/consts.dart').readAsStringSync();
+    for (final (name, value) in [
+      ('kOptionShowRemoteCursor', 'show_remote_cursor'),
+      ('kOptionDisableAudio', 'disable_audio'),
+      ('kOptionLockAfterSessionEnd', 'lock_after_session_end'),
+      ('kOptionI444', 'i444'),
+      ('kOptionShowQualityMonitor', 'show_quality_monitor'),
+    ]) {
+      expect(consts, contains('const String $name = "$value";'), reason: name);
+    }
+  });
+
+  test('the new titles read in Korean', () {
+    final ko = File('../src/lang/ko.rs').readAsStringSync();
+    for (final (key, text) in [
+      ('Advanced settings', '고급 설정'),
+      ('Display and performance', '화면과 성능'),
+      ('Session defaults', '세션 기본값'),
+      ('Security (advanced)', '보안 (고급)'),
+      ('Custom (advanced settings)', '사용자 지정 (고급 설정)'),
+      // upstream's, which 고급 설정 uses as titles too
+      ('Connection', '연결'),
+      ('Recording', '녹화'),
+      ('Update', '업데이트'),
+    ]) {
+      expect(ko, contains('("$key", "$text")'), reason: key);
+    }
+  });
+}
