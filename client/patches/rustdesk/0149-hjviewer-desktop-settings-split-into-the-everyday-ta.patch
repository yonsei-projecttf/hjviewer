+// HJViewer 1.9.1: the desktop settings split into the everyday tabs and 고급 설정 (decided
+// 2026-10-26): the order of 고급 설정's groups, and where each of upstream's "Other default options"
+// is. Placement only: the options, their defaults and the conditions they show under are
+// upstream's. Plain Dart without the bridge, so that ci.sh tests it with the web stand-in.
+
+/// 고급 설정's groups, in their order on the page (desktop_setting_page.dart _AdvancedState).
+enum HjvAdvancedGroup {
+  /// hole punching, IPv6 and WebRTC P2P, the port forwarding mux; the network card behind the
+  /// network unlock
+  connection,
+
+  /// hardware codec, rendering, capture, bitrate, wallpaper, the default codec, the custom image
+  /// quality, true colour and the quality monitor
+  displayPerformance,
+
+  /// the session defaults, the toolbar and clipboard options, the scroll style and trackpad speed
+  sessionDefaults,
+
+  /// automatic recording and its folders
+  recording,
+
+  /// behind the Security tab's unlock: permissions, the numeric one-time password, 2FA, the ID,
+  /// RDP sharing, LAN discovery, direct IP, the whitelists, PIN; then the audio input and the
+  /// privacy mode implementation, which no unlock held before
+  security,
+
+  /// the service, the updates and Wayland
+  serviceUpdates,
+}
+
+/// Where a row of upstream's "Other default options" (setting_widgets.dart otherDefaultSettings)
+/// is: the Display tab keeps three, 고급 설정 shows true colour and the quality monitor with the
+/// display and performance group and the rest with the session defaults.
+enum HjvDefaultOptionPlace { display, performance, session }
+
+HjvDefaultOptionPlace hjvDefaultOptionPlace(String key) => switch (key) {
+      // kOptionShowRemoteCursor, kOptionDisableAudio, kOptionLockAfterSessionEnd
+      'show_remote_cursor' ||
+      'disable_audio' ||
+      'lock_after_session_end' =>
+        HjvDefaultOptionPlace.display,
+      // kOptionI444, kOptionShowQualityMonitor
+      'i444' || 'show_quality_monitor' => HjvDefaultOptionPlace.performance,
+      _ => HjvDefaultOptionPlace.session,
+    };
