+}
+
+class _HjvWakeConnectsState extends State<_HjvWakeConnects> {
+  var _on = _wakeConnects();
+
+  void _toggle([bool? on]) {
+    setState(() => _on = on ?? !_on);
+    bind.setLocalFlutterOption(k: _kWakeConnects, v: _on ? '' : 'N');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (isMobile) {
+      return SettingsTile.switchTile(
+          title: Text(_t.wakeConnects),
+          leading: const Icon(Icons.power_settings_new),
+          initialValue: _on,
+          onToggle: _toggle);
+    }
+    return GestureDetector(
