+/// D11 (peer_card.dart, connectInPeerTab): a PC of the account's list that is off is offered to be
+/// woken before the app connects to it (design v3 §1-3, §8-5). True when the connection does not
+/// go on. Once the wake brought the PC up it does, with the app's own context, which `live` gets:
+/// the card's may be gone by then.
+Future<bool> hjvOfferWake(BuildContext context, Peer peer, PeerTabIndex tab,
+    void Function(BuildContext context) live) async {
+  if (!_accountBuild || tab != PeerTabIndex.group || peer.online) return false;
+  if (!hjvOffersWake(
+      loggedIn: gFFI.userModel.isLogin,
+      online: peer.online,
+      verdict: _wolVerdict(peer.id))) {
+    return false;
+  }
+  // "Terminal (Run as administrator)" left its mark for the session that follows at once
+  // (setEnvTerminalAdmin). It waits here with the connection, or the next terminal would take it.
+  final asAdmin = bind.mainGetEnv(key: 'IS_TERMINAL_ADMIN') == 'Y';
+  if (asAdmin) bind.mainSetEnv(key: 'IS_TERMINAL_ADMIN');
+  final t = _t;
+  final wake = await _show<bool>((setState, close, context) => hjvConfirmDialog(
+      t,
+      title: _nameOf(peer),
+      text: t.wakeAsk,
+      yes: t.wake,
+      no: t.close,
+      onYes: () => close(true),
+      onNo: close));
+  if (wake != true || !await _wake(t, peer)) return true;
+  final app = globalKey.currentContext;
+  if (app == null) return true;
+  if (asAdmin) setEnvTerminalAdmin();
+  live(app);
+  return false;
+}
