+// ---- waking a PC (design v3 §8-5) ----
+
+bool _wakeConnects() => bind.getLocalFlutterOption(k: _kWakeConnects) != 'N';
+
+/// hjv-api's verdict of whether the PC can be woken, from the last device list (Rust keeps it).
+String _wolVerdict(String id) => _commonSync('hjv-wol:$id');
+
+/// Whether the account has a PC to wake, so that Settings → Account has something to say of it.
+bool _wakesAny() =>
+    gFFI.groupModel.peers.any((p) => hjvCanWake(_wolVerdict(p.id)));
+
+void _connectTo(String id) {
+  final context = globalKey.currentContext;
+  if (context != null) connect(context, id);
+}
+
+/// The wakes under way, by PC: a new wake of a PC ends the one before.
+final _wakes = <String, HjvWaking>{};
+
+/// Wakes the PC and shows how it goes (HjvWaking); true when the PC came up and the app goes on
+/// to connect to it.
+Future<bool> _wake(HjvTexts t, Peer peer) {
+  final wake = HjvWaking(t, _nameOf(peer), _HjvWakeApp(t, peer.id));
+  _wakes[peer.id]?.end();
+  _wakes[peer.id] = wake;
+  return wake.run();
+}
+
+/// The app around a wake of the PC `id`.
+class _HjvWakeApp extends HjvWakeApp {
+  final HjvTexts t;
+  final String id;
+  _HjvWakeApp(this.t, this.id);
+
+  @override
+  Future<HjvWake> ask(bool anyRelay) async {
+    try {
+      final (code, body) = await _request('POST', '/api/hjv/devices/$id/wake',
+          json: anyRelay ? jsonEncode({'any_relay': true}) : null);
+      return hjvWakeAsked(code, body);
+    } catch (e) {
+      return HjvWake(HjvWakeKind.refused, text: hjvFailure(t, e));
+    }
+  }
+
+  @override
+  Future<HjvWake> poll(HjvWake last) async {
+    try {
+      final (code, body) = await _request('GET', '/api/hjv/wake/${last.job}');
+      return hjvWakePolled(code, body, last);
+    } catch (e) {
+      // no answer this time: the next poll asks again
+      return last;
+    }
+  }
+
+  @override
+  bool get online => gFFI.groupModel.peers.any((p) => p.id == id && p.online);
+
+  @override
+  void askHbbs() => bind.queryOnlines(ids: [id]);
+
+  @override
+  void refresh() => gFFI.groupModel.pull(force: true, quiet: true);
+
+  @override
+  bool get connects => _wakeConnects();
+
+  @override
+  bool get free => !isMobile || stateGlobal.isInMainPage;
+
+  @override
+  Future<bool> show(HjvWaking wake) async {
+    final connect = await _show<bool>((setState, close, context) {
+      wake.redraw = () => setState(() {});
+      wake.close = close;
+      return hjvWakeDialog(t, wake.name, wake.view(),
+          onClose: close,
+          onConnect: () => close(true),
+          onAgain: wake.start,
+          onAnyRelay: () => wake.start(anyRelay: true));
+    });
+    return connect == true;
+  }
+
+  @override
+  void toast(String text) => showToast(text);
+
+  @override
+  void connect() => _connectTo(id);
+}
+
+/// A wake's progress (design v3 §8-5): where it stands, hjv-api's hints, and the buttons its state
+/// has next to [닫기].
+CustomAlertDialog hjvWakeDialog(HjvTexts t, String pc, HjvWakeView view,
+        {required VoidCallback onClose,
+        required VoidCallback onConnect,
+        required VoidCallback onAgain,
+        required VoidCallback onAnyRelay}) =>
+    CustomAlertDialog(
+      title: Text(t.wakeTitle(pc)),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(view.text),
+          if (view.note.isNotEmpty) Text(view.note).marginOnly(top: 8),
+          if (view.busy) const LinearProgressIndicator().marginOnly(top: 12),
+          if (view.hints.isNotEmpty)
+            _HjvWakeHints(t: t, hints: view.hints, open: view.hintsOpen),
+        ],
+      ),
+      actions: [
+        _button(t.close, onClose, outline: true),
+        if (view.anyRelay) _button(t.wakeAnyRelay, onAnyRelay),
+        if (view.again) _button(t.wakeAgain, onAgain),
+        if (view.connect) _button(t.connect, onConnect),
+      ],
+      onSubmit: view.connect ? onConnect : null,
+      onCancel: onClose,
+    );
+
+/// hjv-api's hints of what may keep the PC from waking: behind [준비 안내 보기], or at once.
+class _HjvWakeHints extends StatefulWidget {
+  final HjvTexts t;
+  final List<String> hints;
+  final bool open;
+  const _HjvWakeHints(
+      {required this.t, required this.hints, required this.open});
+
+  @override
+  State<_HjvWakeHints> createState() => _HjvWakeHintsState();
+}
+
+class _HjvWakeHintsState extends State<_HjvWakeHints> {
+  var _opened = false;
+
+  @override
+  Widget build(BuildContext context) {
+    if (!widget.open && !_opened) {
+      return TextButton(
+          onPressed: () => setState(() => _opened = true),
+          child: Text(widget.t.wakeHints));
+    }
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children:
+          widget.hints.map((h) => Text('· $h').marginOnly(top: 8)).toList(),
+    );
+  }
+}
+
+/// Settings → Account: whether a wake goes on to connect once the PC is on.
+class _HjvWakeConnects extends StatefulWidget {
+  const _HjvWakeConnects();
