+    'queued' => HjvWakeKind.queued,
+    'sent' => HjvWakeKind.sent,
+    'confirmed' => HjvWakeKind.on,
+    'not_confirmed' => HjvWakeKind.notConfirmed,
+    'failed' => HjvWakeKind.failed,
+    _ => null,
+  };
+  final job = _text(body['job']);
+  if (kind == null || !RegExp(r'^[0-9a-f]{32}$').hasMatch(job)) return null;
+  final relay = body['relay'];
+  final hints = body['hints'];
+  return HjvWake(kind,
+      job: job,
+      relay: relay is Map ? _text(relay['name']) : '',
+      code: kind == HjvWakeKind.failed ? _text(body['error']) : '',
+      hints: hints is List ? hints.whereType<String>().toList() : const []);
