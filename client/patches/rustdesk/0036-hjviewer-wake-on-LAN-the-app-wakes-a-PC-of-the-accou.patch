+Future<HjvWake?> hjvFollowWake(HjvWake wake,
+    {required Future<HjvWake> Function(HjvWake last) poll,
+    required bool Function() online,
+    required bool Function() current,
+    required void Function(HjvWake wake) show,
+    required DateTime began,
