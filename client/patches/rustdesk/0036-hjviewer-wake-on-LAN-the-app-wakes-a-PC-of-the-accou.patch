+  final lastSeen = map['last_seen'];
+  return HjvWake(HjvWakeKind.refused,
+      code: code,
+      anyRelay: map['any_relay'] == true,
+      lastSeen: lastSeen is int ? lastSeen : null,
+      text: _text(map['error']));
