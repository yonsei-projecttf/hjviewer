+        let body = envelope(1, &SIGNING_1, &policy_text(1, 7), None);
+        let envelope = parse_envelope(body.as_bytes()).unwrap();
+        assert_eq!(envelope.policy.k, 1);
+        assert_eq!(envelope.policy.p, policy_text(1, 7));
+        assert!(envelope.root.is_none());
+        // a file ends with a line feed; a root part that is null is not there
+        assert_eq!(
+            parse_envelope(format!("{body}\n").as_bytes()),
+            Ok(envelope.clone())
+        );
+        let null_root = body.replacen(r#"{"v":1,"#, r#"{"root":null,"v":1,"#, 1);
+        assert_eq!(parse_envelope(null_root.as_bytes()), Ok(envelope));
+
+        let change = |from: &str, to: &str| {
+            assert!(body.contains(from));
+            parse_envelope(body.replacen(from, to, 1).as_bytes())
+        };
+        assert_eq!(change(r#""v":1"#, r#""v":2"#), Err(Reject::Version));
+        assert_eq!(change(r#""v":1"#, r#""v":"1""#), Err(Reject::Envelope));
+        assert_eq!(change(r#""v":1"#, r#""v":1,"v":1"#), Err(Reject::Envelope));
+        assert_eq!(change(r#""k":1"#, r#""k":0"#), Err(Reject::Envelope));
+        assert_eq!(change(r#""k":1"#, r#""k":65536"#), Err(Reject::Envelope));
+        assert_eq!(change(r#""k":1"#, r#""k":"1""#), Err(Reject::Envelope));
+        assert_eq!(change(r#""k":1"#, r#""k":1,"k":2"#), Err(Reject::Envelope));
+        assert_eq!(change(r#""s":""#, r#""s":"AAAA"#), Err(Reject::Envelope));
+        assert_eq!(change(r#""s":""#, r#""sig":""#), Err(Reject::Envelope));
+        assert_eq!(
+            change(r#""k":1"#, r#""k":1,"root":[]"#),
+            Err(Reject::Envelope)
+        );
+        assert_eq!(
+            change(r#""k":1"#, r#""k":1,"root":{"k":101}"#),
+            Err(Reject::Envelope)
+        );
+        // a root part is an object, also when an array holds its three members in their order
+        let root = root_part(&ROOT, &root_text(2, &[1]));
+        let part: serde_json::Value = serde_json::from_str(&root).unwrap();
+        let listed = serde_json::json!([part["k"], part["p"], part["s"]]);
+        assert!(change(r#""k":1"#, &format!(r#""k":1,"root":{root}"#)).is_ok());
+        assert_eq!(
+            change(r#""k":1"#, &format!(r#""k":1,"root":{listed}"#)),
+            Err(Reject::Envelope)
+        );
+        assert_eq!(parse_envelope(b""), Err(Reject::Envelope));
+        assert_eq!(parse_envelope(b"[]"), Err(Reject::Envelope));
+        assert_eq!(parse_envelope(b"[1]"), Err(Reject::Envelope));
+        assert_eq!(parse_envelope(b"[2]"), Err(Reject::Envelope));
+        assert_eq!(parse_envelope(&[0xff, 0xfe]), Err(Reject::Envelope));
+        // UTF-8 first: an envelope of another version that is not UTF-8 is no envelope at all
+        let mut v2 = body.replacen(r#""v":1"#, r#""v":2"#, 1).into_bytes();
+        let end = v2.len() - 1;
+        v2.splice(end..end, *b",\"y\":\"\xff\"");
+        assert_eq!(parse_envelope(&v2), Err(Reject::Envelope));
+        // an unknown member with a lone surrogate is skipped; in `p` it is an error
+        assert!(change(r#""k":1"#, r#""k":1,"y":"\ud800""#).is_ok());
+        assert_eq!(change(r#""p":""#, r#""p":"\ud800"#), Err(Reject::Envelope));
+        let long = format!("{body}{}", " ".repeat(MAX_ENVELOPE));
+        assert_eq!(parse_envelope(long.as_bytes()), Err(Reject::TooLarge));
+    }
+
+    /// `s` is canonical base64 of exactly 64 bytes: the character before `==` has no unused bits,
+    /// although a lenient decoder would give the same bytes.
+    #[test]
+    fn a_signature_is_canonical_base64() {
+        let body = envelope(1, &SIGNING_1, &policy_text(1, 7), None);
+        let at = body.find("==\"").unwrap() - 1;
+        let last = body.as_bytes()[at];
+        assert!(b"AQgw".contains(&last), "{}", last as char);
+        for other in [last + 1, last + 2, last + 3] {
+            let mut changed = body.clone().into_bytes();
+            changed[at] = other;
+            assert_eq!(
+                parse_envelope(&changed),
+                Err(Reject::Envelope),
+                "{}",
+                other as char
+            );
+        }
+        let unpadded = body.replacen("==\"", "\"", 1);
+        assert_eq!(parse_envelope(unpadded.as_bytes()), Err(Reject::Envelope));
+    }
+
+    #[test]
+    fn a_root_declaration_reads() {
+        let root = parse_root(&root_text(2, &[1])).unwrap();
+        assert_eq!((root.epoch, root.revoked.as_slice()), (2, &[1u16][..]));
+        assert_eq!((root.server.as_str(), root.issued), (SERVER, ISSUED));
+        // the base is the requirement part of the vectors' policy, read as a policy
+        let policy = parse_policy(&policy_text(2, 1)).unwrap();
+        let base = &root.base;
+        assert_eq!((base.epoch, base.seq, base.issued), (2, 0, ISSUED));
+        assert!(base.contact.is_none());
+        for ((name, from_base), (_, from_policy)) in
+            base.entries().into_iter().zip(policy.entries())
+        {
+            let (from_base, from_policy) = (from_base.unwrap(), from_policy.unwrap());
+            assert_eq!(from_base.min, from_policy.min, "{name}");
+            assert_eq!(from_base.latest, from_policy.latest, "{name}");
+            assert_eq!(from_base.grace_until, from_policy.grace_until, "{name}");
+            assert_eq!(from_base.grace_min, from_policy.grace_min, "{name}");
+            assert!(
+                from_base.package.is_none() && from_base.os_min.is_none(),
+                "{name}"
+            );
+            assert!(from_base.source.is_none() && from_base.auto_install_after.is_none());
+        }
+
+        let change = |from: &str, to: &str| {
+            let text = root_text(2, &[1]);
+            assert!(text.contains(from), "{from}");
+            parse_root(&text.replacen(from, to, 1))
+        };
+        assert_eq!(change(r#""v":1"#, r#""v":2"#), Err(Reject::Version));
+        for (from, to) in [
+            // an epoch from 2 on
+            (r#""epoch":2"#, r#""epoch":1"#),
+            (r#""epoch":2"#, r#""epoch":0"#),
+            (r#""epoch":2"#, r#""epoch":"2""#),
+            // key numbers 1-65535
+            ("[1]", "[0]"),
+            ("[1]", "[65536]"),
+            ("[1]", r#"["1"]"#),
+            ("[1]", "[1,null]"),
+            ("[1]", "1"),
+            ("T00:00:00Z", ""),
+            (r#""server":"#, r#""server":1,"x":"#),
+            // the base: an object, there, of base entries
+            (r#""base":{"#, r#""base":null,"x":{"#),
+            (r#","base":{"#, r#","x":{"#),
+            (r#""base":{"#, r#""base":[],"x":{"#),
+            (r#""windows":{"min":"1.6.0""#, r#""windows":{"min":"1.6""#),
+            (r#""windows":{"min":"1.6.0""#, r#""windows":{"min":"1.6.2""#),
+            (r#""windows":{"min":"1.6.0""#, r#""windows":{"x":"1.6.0""#),
+            (
+                r#""windows":{"min":"1.6.0""#,
+                r#""windows":{"min":"1.6.0","min":"1.6.0""#,
+            ),
+            (r#""grace_min":"1.5.0"}"#, r#""grace_min":"1.6.0"}"#),
+            (r#""grace_min":"1.5.0"}"#, r#""grace_min":"1.7.0"}"#),
+            (r#","grace_min":"1.5.0"}"#, "}"),
+            (r#""grace_until":"2026-11-16T15:00:00Z","#, ""),
+            (
+                r#""grace_until":"2026-11-16T15:00:00Z","#,
+                r#""grace_until":"soon","#,
+            ),
+            (
+                r#""android_play":{"min":"1.5.0","latest":"1.6.1"}"#,
+                r#""android_play":["1.5.0","1.6.1"]"#,
+            ),
+            (
+                r#""android_play":{"min":"1.5.0","latest":"1.6.1"}"#,
+                r#""android_play":{"min":"1.5.0","latest":"1.6.1","grace_min":"1.4.0"}"#,
+            ),
+        ] {
+            assert_eq!(change(from, to), Err(Reject::RootFormat), "{to}");
+        }
+        // no list, or null, is an empty list
+        let empty = |from: &str, to: &str| change(from, to).unwrap().revoked;
+        assert_eq!(empty(r#""revoked":[1],"#, ""), Vec::<u16>::new());
+        assert_eq!(
+            empty(r#""revoked":[1]"#, r#""revoked":null"#),
+            Vec::<u16>::new()
+        );
+        // a base member or a base entry's member this format does not know is skipped unread,
+        // and so is an entry that is null
+        let skipped = |from: &str, to: &str| change(from, to).unwrap().base;
+        assert_eq!(
+            skipped(r#""ios":{"#, r#""macos":{"min":"x"},"ios":{"#),
+            root.base
+        );
+        assert_eq!(
+            skipped(
+                r#""latest":"1.6.1","grace"#,
+                r#""latest":"1.6.1","os_min":7,"package":{},"grace"#
+            ),
+            root.base
+        );
+        assert!(skipped(r#""ios":{"#, r#""ios":null,"x":{"#).ios.is_none());
+        // {} is a base
+        assert!(change(&format!(r#""base":{BASE}"#), r#""base":{}"#)
+            .unwrap()
+            .base
+            .entries()
+            .iter()
+            .all(|(_, e)| e.is_none()));
+    }
+}
