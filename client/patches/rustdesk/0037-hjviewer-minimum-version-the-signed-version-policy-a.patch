@@ -0,0 +1,1657 @@
+//! Whom the app believes about versions: the update keys compiled into the build, and the rules by
+//! which an envelope changes what the app holds (the trust rules of the version policy, sections 1
+//! and 2, which the release tool's shared vectors pin: tools/hjv-release/tests/vectors).
+//!
+//! A build pins one or two **signing keys** and one or two **root keys**. A signing key signs the
+//! policies of everyday releases, and a policy is taken only if it asks no less than the one the
+//! app compares it with, at every time. Only a root **declaration** asks less: it opens a new
+//! epoch, lists the revoked signing keys, and carries a **base**, the requirements of its epoch's
+//! first policy. The app takes a declaration first and keeps it whatever becomes of the policy
+//! that came with it; of the two signed parts it holds, the later one is what it enforces.
+//!
+//! Everything here is pure: the keys, the state and the envelope come in, the new state and what
+//! became of the envelope come out.
+
+use super::{
+    policy::{
+        parse_envelope, parse_policy, parse_root, Entry, Policy, RootDeclaration, Signed,
+        POLICY_CONTEXT, ROOT_CONTEXT,
+    },
+    verdict,
+};
+use hbb_common::{
+    base64::{engine::general_purpose::STANDARD, Engine as _},
+    sodiumoxide::crypto::sign,
+};
+use sha2::{Digest, Sha256};
+use std::collections::BTreeSet;
+
+const FINGERPRINT_CONTEXT: &[u8] = b"hjv-update-keys-v1";
+/// How far one policy may move the sequence number, whoever signed it.
+pub(crate) const MAX_SEQ_STEP: u64 = 1000;
+
+/// Why an envelope was refused (the codes of the trust rules, 2-4).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Reject {
+    TooLarge,
+    /// not UTF-8, not the envelope's JSON, or a key number or signature of another shape
+    Envelope,
+    /// an envelope, policy or root declaration of a version this app does not read
+    Version,
+    /// signed with a key this build does not pin
+    UnknownKey,
+    /// signed with a key the held declaration revokes
+    RevokedKey,
+    BadSignature,
+    /// the root part names a key that is not one of the pinned root keys
+    RootKey,
+    RootSignature,
+    /// the declaration's JSON, its epoch (2 at least), its revoked keys, its time or its base
+    RootFormat,
+    RootServer,
+    /// a declaration of an epoch before the app's
+    RootEpoch,
+    /// the declaration revokes a pinned root key
+    RootRevokesRoot,
+    /// another declaration text for the epoch the app holds one of
+    RootFork,
+    /// the policy's JSON ("json") or the named field breaks its rule
+    Field(&'static str),
+    /// a policy for another server
+    Server,
+    /// a policy of another epoch than the app's, or of epoch 2 or later without its declaration
+    Epoch,
+    /// a sequence number at or below the last one
+    Rollback,
+    /// a sequence number more than MAX_SEQ_STEP ahead
+    Jump,
+    /// the last policy's position with another text
+    Fork,
+    /// older than the policy this build was made under
+    BelowFloor,
+    /// issued before the policy or declaration it is compared with
+    Issued,
+    /// asks less than the policy or base it is compared with, at some time, for some entry
+    Relaxation,
+}
+
+/// Where a policy stands: later epochs first, then later sequence numbers.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) struct Position {
+    pub epoch: u64,
+    pub seq: u64,
+}
+
+/// What the build pins.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Pinned {
+    pub server: String,
+    /// the signing keys by key number
+    pub signing: Vec<(u16, [u8; 32])>,
+    /// the root keys by key number, one or two
+    pub roots: Vec<(u16, [u8; 32])>,
+    /// the position of the policy that was live when this build was made
+    pub floor: Position,
+    /// names the key set (server, signing keys, root keys) in the log and the vectors
+    pub fingerprint: String,
+}
+
+/// A number as the build variables write it: plain digits, no sign and no leading zero.
+fn plain_number(text: &str) -> Option<u64> {
+    let plain = !text.is_empty()
+        && text.len() <= 15
+        && text.bytes().all(|b| b.is_ascii_digit())
+        && (text == "0" || !text.starts_with('0'));
+    plain.then(|| text.parse().ok()).flatten()
+}
+
+/// `<key number>:<standard base64 of an Ed25519 public key>`, the number 1-65535.
+fn parse_key(entry: &str) -> Result<(u16, [u8; 32]), &'static str> {
+    let (id, key) = entry
+        .trim()
+        .split_once(':')
+        .ok_or("not <key number>:<base64 key>")?;
+    let id = plain_number(id.trim())
+        .and_then(|id| u16::try_from(id).ok())
+        .filter(|id| *id > 0)
+        .ok_or("a key number that is not 1-65535")?;
+    let key: [u8; 32] = STANDARD
+        .decode(key.trim())
+        .ok()
+        .and_then(|key| key.try_into().ok())
+        .ok_or("a key that is not the base64 of 32 bytes")?;
+    // libsodium refuses to convert a point that is off the curve, of small order or outside the
+    // main subgroup: with such a "key" anyone could sign
+    let _ = hbb_common::sodiumoxide::init();
+    if sign::to_curve25519_pk(&sign::PublicKey(key)).is_err() {
+        return Err("a weak or invalid key");
+    }
+    Ok((id, key))
+}
+
+/// One or two keys, `<n>:<b64>[,<n>:<b64>]`.
+fn parse_keys(line: &str) -> Result<Vec<(u16, [u8; 32])>, &'static str> {
+    let keys = line
+        .split(',')
+        .map(parse_key)
+        .collect::<Result<Vec<_>, _>>()?;
+    if keys.len() > 2 {
+        return Err("more than two keys of one kind");
+    }
+    Ok(keys)
+}
+
+fn key_line(keys: &[(u16, [u8; 32])]) -> String {
+    let mut keys = keys.to_vec();
+    keys.sort();
+    keys.iter()
+        .map(|(id, key)| format!("{id}:{}", STANDARD.encode(key)))
+        .collect::<Vec<_>>()
+        .join(",")
+}
+
+/// `<epoch>:<seq>`; a build without one starts at 1:0, the position before the first policy.
+fn parse_floor(floor: Option<&str>) -> Result<Position, &'static str> {
+    let Some(floor) = floor.map(str::trim).filter(|f| !f.is_empty()) else {
+        return Ok(Position { epoch: 1, seq: 0 });
+    };
+    floor
+        .split_once(':')
+        .and_then(|(epoch, seq)| {
+            Some(Position {
+                epoch: plain_number(epoch).filter(|e| *e > 0)?,
+                seq: plain_number(seq)?,
+            })
+        })
+        .ok_or("a floor that is not <epoch>:<seq>")
+}
+
+/// The build variables of the update keys: HJV_UPDATE_PUBKEY (one or two signing keys),
+/// HJV_UPDATE_ROOT_PUBKEY (one or two root keys, in number and key unlike every other pinned
+/// key) and HJV_POLICY_FLOOR. A value that does not keep the form makes the whole set unusable
+/// rather than half used.
+pub(crate) fn pinned(
+    server: &str,
+    signing: Option<&str>,
+    root: Option<&str>,
+    floor: Option<&str>,
+) -> Result<Pinned, &'static str> {
+    if server.is_empty() || server.bytes().any(|b| b.is_ascii_whitespace() || b == b'/') {
+        return Err("no server");
+    }
+    let signing = signing
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .ok_or("no signing key")?;
+    let roots = root
+        .map(str::trim)
+        .filter(|r| !r.is_empty())
+        .ok_or("no root key")?;
+    let signing = parse_keys(signing)?;
+    let roots = parse_keys(roots)?;
+    let all: Vec<_> = signing.iter().chain(&roots).collect();
+    for (i, (id, key)) in all.iter().enumerate() {
+        if all[..i]
+            .iter()
+            .any(|(other_id, other_key)| other_id == id || other_key == key)
+        {
+            return Err("a key number or a key appears twice");
+        }
+    }
+    let floor = parse_floor(floor)?;
+    let mut bound = Sha256::new();
+    for (i, part) in [
+        FINGERPRINT_CONTEXT,
+        server.as_bytes(),
+        key_line(&signing).as_bytes(),
+        key_line(&roots).as_bytes(),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        if i > 0 {
+            bound.update([0u8]);
+        }
+        bound.update(part);
+    }
+    Ok(Pinned {
+        server: server.to_owned(),
+        signing,
+        roots,
+        floor,
+        fingerprint: hex::encode(bound.finalize()),
+    })
+}
+
+/// Whether every key of a build is one of this project's test keys, whose private halves are
+/// public: an Ed25519 key made from a seed of one repeated byte or of 32 consecutive byte values,
+/// the two kinds its tests and vectors use and its release checks refuse for a real server.
+pub(crate) fn only_test_keys(pinned: &Pinned) -> bool {
+    let _ = hbb_common::sodiumoxide::init();
+    let mut test_keys = BTreeSet::new();
+    for first in 0..=255u8 {
+        for step in [0u8, 1] {
+            let mut seed = [0u8; 32];
+            for (i, b) in seed.iter_mut().enumerate() {
+                *b = first.wrapping_add(step.wrapping_mul(i as u8));
+            }
+            test_keys.insert(sign::keypair_from_seed(&sign::Seed(seed)).0 .0);
+        }
+    }
+    pinned
+        .signing
+        .iter()
+        .chain(&pinned.roots)
+        .all(|(_, key)| test_keys.contains(key))
+}
+
+/// The held declaration: its root part as received, and its text as read.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Declared {
+    pub part: Signed,
+    pub declaration: RootDeclaration,
+}
+
+/// The held policy: the whole envelope it came in as received, what it says, its signer's key
+/// number and SHA-256 of its text.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Last {
+    pub envelope: String,
+    pub policy: Policy,
+    pub k: u16,
+    pub hash: [u8; 32],
+}
+
+/// What the app keeps between envelopes (1-5). What it enforces, compares with and may install
+/// from follows from these two and the build's floor.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub(crate) struct Trust {
+    pub decl: Option<Declared>,
+    pub held: Option<Last>,
+}
+
+impl Trust {
+    /// DE: the held declaration's epoch, 1 without one.
+    pub(crate) fn declared_epoch(&self) -> u64 {
+        self.decl.as_ref().map_or(1, |decl| decl.declaration.epoch)
+    }
+
+    /// E: the device's epoch, which the build's floor may put later than the declaration's.
+    pub(crate) fn epoch(&self, floor: Position) -> u64 {
+        floor.epoch.max(self.declared_epoch())
+    }
+
+    /// REVOKED: the held declaration's list.
+    pub(crate) fn revoked(&self) -> &[u16] {
+        self.decl
+            .as_ref()
+            .map_or(&[], |decl| decl.declaration.revoked.as_slice())
+    }
+
+    /// CUR: the held policy, when it is of the device's epoch.
+    fn current(&self, floor: Position) -> Option<&Last> {
+        self.held
+            .as_ref()
+            .filter(|held| held.policy.epoch == self.epoch(floor))
+    }
+
+    /// DCUR: the held declaration, when it is of the device's epoch.
+    fn current_declaration(&self, floor: Position) -> Option<&Declared> {
+        self.decl
+            .as_ref()
+            .filter(|decl| decl.declaration.epoch == self.epoch(floor))
+    }
+
+    /// LOW and SAME: what a new policy's sequence number must be above, and the position and text
+    /// hash of a held policy that is current and not below the floor.
+    pub(crate) fn low_same(&self, floor: Position) -> (u64, Option<(u64, [u8; 32])>) {
+        let epoch = self.epoch(floor);
+        match self.current(floor) {
+            Some(current) if Position::of(&current.policy) >= floor => {
+                (current.policy.seq, Some((current.policy.seq, current.hash)))
+            }
+            _ if floor.epoch == epoch && floor.seq >= 1 => (floor.seq - 1, None),
+            _ => (0, None),
+        }
+    }
+
+    /// BASIS: what a new policy is compared with, the current policy, else the current
+    /// declaration's base (whose `issued` is the declaration's).
+    pub(crate) fn basis(&self, floor: Position) -> Option<&Policy> {
+        match self.current(floor) {
+            Some(current) => Some(&current.policy),
+            None => self
+                .current_declaration(floor)
+                .map(|decl| &decl.declaration.base),
+        }
+    }
+
+    /// EFF: what the app enforces. The later of the two signed parts wins: the held policy if it
+    /// is of the declaration's epoch (1 without one) and its signer is not revoked, else the
+    /// declaration's base read as a policy, else nothing.
+    pub(crate) fn effective(&self) -> Option<&Policy> {
+        match &self.held {
+            Some(held)
+                if held.policy.epoch == self.declared_epoch()
+                    && !self.revoked().contains(&held.k) =>
+            {
+                Some(&held.policy)
+            }
+            _ => self.decl.as_ref().map(|decl| &decl.declaration.base),
+        }
+    }
+
+    /// MAY_INSTALL: the held policy is of the device's epoch, not below the build's floor, and its
+    /// signer is not revoked. Nothing is downloaded or installed otherwise.
+    pub(crate) fn may_install(&self, floor: Position) -> bool {
+        self.low_same(floor).1.is_some()
+            && self
+                .held
+                .as_ref()
+                .is_some_and(|held| !self.revoked().contains(&held.k))
+    }
+
+    /// The held policy, when the app may install from it (and then it is what the app enforces).
+    pub(crate) fn installable(&self, floor: Position) -> Option<&Policy> {
+        self.held
+            .as_ref()
+            .filter(|_| self.may_install(floor))
+            .map(|held| &held.policy)
+    }
+}
+
+impl Position {
+    pub(crate) fn of(policy: &Policy) -> Position {
+        Position {
+            epoch: policy.epoch,
+            seq: policy.seq,
+        }
+    }
+}
+
+/// What became of an envelope.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Outcome {
+    /// its policy is held now
+    Taken,
+    /// the held policy came again
+    Unchanged,
+    /// refused; the state may hold the envelope's declaration
+    Refused(Reject),
+}
+
+fn signed_by(context: &[u8], signed: &Signed, key: &[u8; 32]) -> bool {
+    let mut message = Vec::with_capacity(context.len() + 1 + signed.p.len());
+    message.extend_from_slice(context);
+    message.push(0);
+    message.extend_from_slice(signed.p.as_bytes());
+    let _ = hbb_common::sodiumoxide::init();
+    sign::Signature::from_bytes(&signed.sig)
+        .map(|sig| sign::verify_detached(&sig, &message, &sign::PublicKey(*key)))
+        .unwrap_or(false)
+}
+
+/// A root part by itself (steps B1-B3): a pinned root key's number and signature, then the
+/// declaration's text, this server, and no pinned root key among the revoked.
+pub(crate) fn check_root(pinned: &Pinned, part: &Signed) -> Result<RootDeclaration, Reject> {
+    let key = pinned
+        .roots
+        .iter()
+        .find(|(id, _)| *id == part.k)
+        .map(|(_, key)| key)
+        .ok_or(Reject::RootKey)?;
+    if !signed_by(ROOT_CONTEXT, part, key) {
+        return Err(Reject::RootSignature);
+    }
+    let declaration = parse_root(&part.p)?;
+    if declaration.server != pinned.server {
+        return Err(Reject::RootServer);
+    }
+    if pinned
+        .roots
+        .iter()
+        .any(|(id, _)| declaration.revoked.contains(id))
+    {
+        return Err(Reject::RootRevokesRoot);
+    }
+    Ok(declaration)
+}
+
+/// The key a policy part names (step C1 without the revocation): a pinned root key's, else a
+/// pinned signing key's.
+fn policy_key(pinned: &Pinned, k: u16) -> Result<&[u8; 32], Reject> {
+    pinned
+        .roots
+        .iter()
+        .chain(&pinned.signing)
+        .find(|(id, _)| *id == k)
+        .map(|(_, key)| key)
+        .ok_or(Reject::UnknownKey)
+}
+
+/// A policy part whose key is `key` (steps C2 and C3): its signature, then its text and server.
+fn check_policy_part(pinned: &Pinned, part: &Signed, key: &[u8; 32]) -> Result<Policy, Reject> {
+    if !signed_by(POLICY_CONTEXT, part, key) {
+        return Err(Reject::BadSignature);
+    }
+    let policy = parse_policy(&part.p)?;
+    if policy.server != pinned.server {
+        return Err(Reject::Server);
+    }
+    Ok(policy)
+}
+
+/// What a stored envelope holds by itself (1-6 L3): the envelope's form, its root part (B1-B3)
+/// if it has one, and its policy part by a pinned key; whether that key is revoked is not asked
+/// here. The held policy and the root part's epoch and text, for L4.
+pub(crate) fn check_alone(
+    pinned: &Pinned,
+    envelope: &str,
+) -> Option<(Last, Option<(u64, String)>)> {
+    let parsed = parse_envelope(envelope.as_bytes()).ok()?;
+    let root = match &parsed.root {
+        Some(part) => Some((check_root(pinned, part).ok()?.epoch, part.p.clone())),
+        None => None,
+    };
+    let key = policy_key(pinned, parsed.policy.k).ok()?;
+    let policy = check_policy_part(pinned, &parsed.policy, key).ok()?;
+    let held = Last {
+        envelope: envelope.to_owned(),
+        policy,
+        k: parsed.policy.k,
+        hash: Sha256::digest(parsed.policy.p.as_bytes()).into(),
+    };
+    Some((held, root))
+}
+
+/// COVERS(n, o) (2-3): entry `n` asks at least what entry `o` asks, at every time, past included.
+pub(crate) fn covers(n: &Entry, o: &Entry) -> bool {
+    let ((n_lo, n_hi, n_until), (o_lo, o_hi, o_until)) = (verdict::steps(n), verdict::steps(o));
+    let earlier = match (n_until, o_until) {
+        (None, _) => true,
+        (Some(n), Some(o)) => n <= o,
+        (Some(_), None) => false,
+    };
+    n_lo >= o_hi || (n_lo >= o_lo && n_hi >= o_hi && earlier)
+}
+
+/// RELAXES(B, P) (2-3): `new` asks less than `basis` somewhere. An entry of the basis that is
+/// missing, that the new one does not cover, or whose latest version goes down; or a new entry
+/// of the Android pair that does not cover its sibling in the basis, which the PC holds Android
+/// controllers to with it.
+pub(crate) fn relaxes(basis: &Policy, new: &Policy) -> bool {
+    let lowered =
+        basis
+            .entries()
+            .into_iter()
+            .zip(new.entries())
+            .any(|((_, old), (_, new))| match (old, new) {
+                (Some(old), Some(new)) => {
+                    !covers(new, old) || new.latest.number() < old.latest.number()
+                }
+                (Some(_), None) => true,
+                (None, _) => false,
+            });
+    let sibling_lowered = [("android", "android_play"), ("android_play", "android")]
+        .into_iter()
+        .any(
+            |(name, sibling)| match (new.entry(name), basis.entry(name), basis.entry(sibling)) {
+                (Some(new), None, Some(sibling)) => !covers(new, sibling),
+                _ => false,
+            },
+        );
+    lowered || sibling_lowered
+}
+
+/// Step B: the envelope's declaration, checked (B1-B3) and held against the state's (B4). The
+/// state with the declaration it takes, and the declaration's epoch.
+fn take_declaration(pinned: &Pinned, trust: &Trust, part: &Signed) -> Result<(Trust, u64), Reject> {
+    let declaration = check_root(pinned, part)?;
+    let epoch = declaration.epoch;
+    let device = trust.epoch(pinned.floor);
+    if epoch < device {
+        return Err(Reject::RootEpoch);
+    }
+    if epoch == device {
+        if let Some(current) = trust.current_declaration(pinned.floor) {
+            // the same text is no change, whichever root key signed it
+            return match current.part.p == part.p {
+                true => Ok((trust.clone(), epoch)),
+                false => Err(Reject::RootFork),
+            };
+        }
+    }
+    let taken = Trust {
+        decl: Some(Declared {
+            part: part.clone(),
+            declaration,
+        }),
+        held: trust.held.clone(),
+    };
+    Ok((taken, epoch))
+}
+
+/// `accept(build, state, body) -> (state', outcome)` of the trust rules (2-2): steps A, B, C in
+/// this order, and nothing of a text read before its signature held.
+///
+/// - A: the envelope's size and form.
+/// - B: its declaration, if it has one: a later epoch's is taken, also when the policy beside it
+///   is refused afterwards; another text for the epoch held is a fork.
+/// - C: its policy: a pinned key the declaration does not revoke and its signature; the text;
+///   the device's epoch (and from epoch 2 on the declaration beside it); a sequence number above
+///   the last and at most MAX_SEQ_STEP ahead; the build's floor; issued no earlier than the basis;
+///   asking no less than the basis at any time.
+///
+/// The state changes only when the policy is taken, and when a refusal follows a declaration
+/// that was taken.
+pub(crate) fn accept(pinned: &Pinned, trust: &Trust, body: &[u8]) -> (Trust, Outcome) {
+    let floor = pinned.floor;
+    let envelope = match parse_envelope(body) {
+        Ok(envelope) => envelope,
+        Err(why) => return (trust.clone(), Outcome::Refused(why)),
+    };
+    let (state, declared) = match &envelope.root {
+        None => (trust.clone(), None),
+        Some(part) => match take_declaration(pinned, trust, part) {
+            Ok((state, epoch)) => (state, Some(epoch)),
+            Err(why) => return (trust.clone(), Outcome::Refused(why)),
+        },
+    };
+    let k = envelope.policy.k;
+    let checked = policy_key(pinned, k).and_then(|key| {
+        if state.revoked().contains(&k) {
+            return Err(Reject::RevokedKey);
+        }
+        check_policy_part(pinned, &envelope.policy, key)
+    });
+    let policy = match checked {
+        Ok(policy) => policy,
+        Err(why) => return (state, Outcome::Refused(why)),
+    };
+    let refused = |state, why| (state, Outcome::Refused(why));
+    let epoch = state.epoch(floor);
+    // only a declaration moves the epoch, and a policy of a later epoch travels with its own
+    if policy.epoch != epoch || (policy.epoch >= 2 && declared != Some(policy.epoch)) {
+        return refused(state, Reject::Epoch);
+    }
+    let hash: [u8; 32] = Sha256::digest(envelope.policy.p.as_bytes()).into();
+    let (low, same) = state.low_same(floor);
+    if let Some((_, held)) = same.filter(|(seq, _)| *seq == policy.seq) {
+        return match held == hash {
+            true => (state, Outcome::Unchanged),
+            false => refused(state, Reject::Fork),
+        };
+    }
+    if policy.seq <= low {
+        return refused(state, Reject::Rollback);
+    }
+    if policy.seq - low > MAX_SEQ_STEP {
+        return refused(state, Reject::Jump);
+    }
+    if Position::of(&policy) < floor {
+        return refused(state, Reject::BelowFloor);
+    }
+    let compared = state.basis(floor).map(|basis| {
+        if policy.issued < basis.issued {
+            Err(Reject::Issued)
+        } else if relaxes(basis, &policy) {
+            Err(Reject::Relaxation)
+        } else {
+            Ok(())
+        }
+    });
+    if let Some(Err(why)) = compared {
+        return refused(state, why);
+    }
+    let held = Last {
+        // UTF-8 already: the envelope was read
+        envelope: String::from_utf8_lossy(body).into_owned(),
+        policy,
+        k,
+        hash,
+    };
+    let taken = Trust {
+        decl: state.decl,
+        held: Some(held),
+    };
+    (taken, Outcome::Taken)
+}
