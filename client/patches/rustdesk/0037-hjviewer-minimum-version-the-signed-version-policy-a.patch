@@ -0,0 +1,444 @@
+//! Asking the server for the policy: where, how often at most, and over which connection.
+//!
+//! The policy is a file nginx serves at `https://<server>/api/hjv/version`, before any login and
+//! while hjv-api is down. The address is made from the server name compiled into the build, the
+//! request goes out with the certificate checked whatever the user's TLS settings say, and an
+//! answer that was redirected or is longer than an envelope may be is not read. The signature
+//! is what the answer is believed by; the connection only keeps strangers from wasting it.
+
+use super::policy::MAX_ENVELOPE;
+use std::{
+    collections::VecDeque,
+    io::Read,
+    sync::{Condvar, Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+const HOUR: u64 = 3600;
+/// A check nobody waits for goes out at most once a minute.
+pub(crate) const REGULAR_GAP: u64 = 60;
+/// A check somebody waits for (a login, a refusal, a button, a connection about to start) goes
+/// out at most every ten seconds and twelve times an hour.
+pub(crate) const IMMEDIATE_GAP: u64 = 10;
+pub(crate) const IMMEDIATE_PER_HOUR: usize = 12;
+/// After a failure, checks nobody waits for stay away this long.
+pub(crate) const FAILURE_WAIT: u64 = 30 * 60;
+/// The app checks by itself every six hours, ten percent more or less.
+pub(crate) const PERIOD: u64 = 6 * HOUR;
+const HTTP_TIMEOUT: Duration = Duration::from_secs(20);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Kind {
+    Regular,
+    Immediate,
+}
+
+/// The limits of this process's requests, on a clock that only runs forward (seconds).
+#[derive(Debug, Default)]
+pub(crate) struct Limiter {
+    last_request: Option<u64>,
+    /// the immediate checks of the last hour
+    immediate: VecDeque<u64>,
+    /// failures in a row, and when the last one was
+    failures: u32,
+    last_failure: Option<u64>,
+}
+
+impl Limiter {
+    /// Whether a request may go out now; if not, in how many seconds one may. A request that may
+    /// go is counted as sent.
+    pub(crate) fn allow(&mut self, kind: Kind, now: u64) -> Result<(), u64> {
+        while self
+            .immediate
+            .front()
+            .is_some_and(|sent| now.saturating_sub(*sent) >= HOUR)
+        {
+            self.immediate.pop_front();
+        }
+        let left = |since: Option<u64>, wait: u64| {
+            since.map_or(0, |since| wait.saturating_sub(now.saturating_sub(since)))
+        };
+        let wait = match kind {
+            Kind::Regular => {
+                left(self.last_request, REGULAR_GAP).max(left(self.last_failure, FAILURE_WAIT))
+            }
+            Kind::Immediate => {
+                let oldest = self.immediate.front().copied();
+                let used_up = self.immediate.len() >= IMMEDIATE_PER_HOUR;
+                left(self.last_request, IMMEDIATE_GAP).max(left(oldest.filter(|_| used_up), HOUR))
+            }
+        };
+        if wait > 0 {
+            return Err(wait);
+        }
+        self.last_request = Some(now);
+        if kind == Kind::Immediate {
+            self.immediate.push_back(now);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn finished(&mut self, ok: bool, now: u64) {
+        if ok {
+            self.failures = 0;
+            self.last_failure = None;
+        } else {
+            self.failures = self.failures.saturating_add(1);
+            self.last_failure = Some(now);
+        }
+    }
+
+    /// In how many seconds the app next checks by itself: half an hour after a first failure,
+    /// else after the period, also while the failures go on (a server without a policy is not
+    /// asked every half hour for good). `jitter` spreads the period from -10% (0) to +10%.
+    pub(crate) fn next_periodic(&self, jitter: u32) -> u64 {
+        if self.failures == 1 {
+            return FAILURE_WAIT;
+        }
+        PERIOD * 9 / 10 + PERIOD / 5 * u64::from(jitter) / u64::from(u32::MAX)
+    }
+}
+
+/// Seconds since this process first asked, on a clock that only runs forward.
+pub(crate) fn mono() -> u64 {
+    static START: OnceLock<Instant> = OnceLock::new();
+    START.get_or_init(Instant::now).elapsed().as_secs()
+}
+
+/// What wakes the worker thread before its next check is due.
+pub(crate) struct Kicks {
+    pending: Mutex<Option<Kind>>,
+    wake: Condvar,
+}
+
+impl Kicks {
+    pub(crate) const fn new() -> Kicks {
+        Kicks {
+            pending: Mutex::new(None),
+            wake: Condvar::new(),
+        }
+    }
+
+    pub(crate) fn kick(&self, kind: Kind) {
+        let mut pending = self.pending.lock().unwrap_or_else(|e| e.into_inner());
+        // an immediate check that is waiting is not turned into a regular one
+        if *pending != Some(Kind::Immediate) {
+            *pending = Some(kind);
+        }
+        self.wake.notify_all();
+    }
+
+    /// Sleeps until a kick or for `timeout`: the kick, if one came.
+    pub(crate) fn wait(&self, timeout: Duration) -> Option<Kind> {
+        let pending = self.pending.lock().unwrap_or_else(|e| e.into_inner());
+        let (mut pending, _) = self
+            .wake
+            .wait_timeout_while(pending, timeout, |pending| pending.is_none())
+            .unwrap_or_else(|e| e.into_inner());
+        pending.take()
+    }
+}
+
+pub(crate) fn policy_url(server: &str) -> String {
+    format!("https://{server}/api/hjv/version")
+}
+
+/// What to ask: the address. No ETag goes with it: an answer of 304 is not signed, and one forged
+/// answer could keep the app behind a revocation until the server's file changed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Request {
+    pub url: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Reply {
+    pub status: u16,
+    pub date: Option<String>,
+    /// the body of a 200, at most MAX_ENVELOPE bytes
+    pub body: Vec<u8>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FetchError {
+    /// the address is not one a request can go to
+    Config,
+    Network,
+    /// the server's certificate did not hold
+    Tls,
+    /// the answer came from another address
+    Redirect,
+    TooLarge,
+    Status(u16),
+}
+
+/// The time of a `Date` header, as Unix seconds.
+pub(crate) fn http_date(date: &str) -> Option<i64> {
+    Some(chrono::DateTime::parse_from_rfc2822(date).ok()?.timestamp())
+}
+
+/// Whether a request failed for the server's certificate, somewhere down the chain of causes.
+pub(crate) fn tls_failure(error: &reqwest::Error) -> bool {
+    let mut cause: Option<&dyn std::error::Error> = Some(error);
+    while let Some(error) = cause {
+        if error.to_string().to_lowercase().contains("certificate") {
+            return true;
+        }
+        cause = error.source();
+    }
+    false
+}
+
+/// A client for `url` that never accepts an invalid certificate and never goes on without TLS.
+pub(crate) fn strict_client(url: &str) -> Result<reqwest::blocking::Client, FetchError> {
+    crate::hbbs_http::create_http_client_with_url_strict(url).map_err(|_| FetchError::Config)
+}
+
+/// The answer's own address must be the one that was asked: the client follows redirections,
+/// and an answer from elsewhere is not the server's.
+pub(crate) fn from_asked(response: &reqwest::blocking::Response, url: &str) -> bool {
+    same_address(url, response.url())
+}
+
+/// Whether `answered`, the address an answer came from, is `asked`.
+fn same_address(asked: &str, answered: &url::Url) -> bool {
+    url::Url::parse(asked).is_ok_and(|asked| &asked == answered)
+}
+
+/// The body of a 200: at most one byte more than an envelope may have is read, whatever is sent.
+fn read_body(body: impl Read) -> Result<Vec<u8>, FetchError> {
+    let mut read = Vec::new();
+    body.take(MAX_ENVELOPE as u64 + 1)
+        .read_to_end(&mut read)
+        .map_err(|_| FetchError::Network)?;
+    if read.len() > MAX_ENVELOPE {
+        return Err(FetchError::TooLarge);
+    }
+    Ok(read)
+}
+
+/// One request for the policy. It blocks, so it runs on the worker thread only.
+pub(crate) fn get(request: &Request) -> Result<Reply, FetchError> {
+    let client = strict_client(&request.url)?;
+    let builder = client
+        .get(&request.url)
+        .timeout(HTTP_TIMEOUT)
+        .header(reqwest::header::ACCEPT, "application/json");
+    let response = builder.send().map_err(|e| {
+        let tls = tls_failure(&e);
+        hbb_common::throttled_log!(
+            Duration::from_secs(1800),
+            warn,
+            "version policy: no answer ({})",
+            if tls { "certificate" } else { "network" }
+        );
+        if tls {
+            FetchError::Tls
+        } else {
+            FetchError::Network
+        }
+    })?;
+    if !from_asked(&response, &request.url) {
+        return Err(FetchError::Redirect);
+    }
+    let status = response.status().as_u16();
+    let header = |name: reqwest::header::HeaderName| {
+        let value = response.headers().get(name)?.to_str().ok()?;
+        Some(value.to_owned())
+    };
+    let date = header(reqwest::header::DATE);
+    let body = match status {
+        200 => read_body(response)?,
+        _ => Vec::new(),
+    };
+    Ok(Reply { status, date, body })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn checks_nobody_waits_for_are_a_minute_apart() {
+        let mut limiter = Limiter::default();
+        assert_eq!(limiter.allow(Kind::Regular, 100), Ok(()));
+        limiter.finished(true, 101);
+        assert_eq!(limiter.allow(Kind::Regular, 100), Err(60));
+        assert_eq!(limiter.allow(Kind::Regular, 130), Err(30));
+        assert_eq!(limiter.allow(Kind::Regular, 159), Err(1));
+        assert_eq!(limiter.allow(Kind::Regular, 160), Ok(()));
+        // a refused request is not counted
+        assert_eq!(limiter.allow(Kind::Regular, 219), Err(1));
+        assert_eq!(limiter.allow(Kind::Regular, 220), Ok(()));
+    }
+
+    #[test]
+    fn checks_somebody_waits_for_are_ten_seconds_apart_and_twelve_an_hour() {
+        let mut limiter = Limiter::default();
+        // right after a regular check, but not within ten seconds of it
+        assert_eq!(limiter.allow(Kind::Regular, 0), Ok(()));
+        assert_eq!(limiter.allow(Kind::Immediate, 9), Err(1));
+        assert_eq!(limiter.allow(Kind::Immediate, 10), Ok(()));
+        assert_eq!(limiter.allow(Kind::Immediate, 15), Err(5));
+        // and a regular one keeps a minute from the immediate one too
+        assert_eq!(limiter.allow(Kind::Regular, 60), Err(10));
+        for n in 1..12 {
+            assert_eq!(limiter.allow(Kind::Immediate, 10 + n * 10), Ok(()), "{n}");
+        }
+        // twelve went out from 10 to 120: the thirteenth waits until the first is an hour old
+        assert_eq!(limiter.allow(Kind::Immediate, 130), Err(3480));
+        assert_eq!(limiter.allow(Kind::Immediate, 3609), Err(1));
+        // regular checks are not held up by that
+        assert_eq!(limiter.allow(Kind::Regular, 200), Ok(()));
+        assert_eq!(limiter.allow(Kind::Immediate, 3610), Ok(()));
+        assert_eq!(limiter.allow(Kind::Immediate, 3619), Err(1));
+        assert_eq!(limiter.allow(Kind::Immediate, 3620), Ok(()));
+        // a clock that ran far ahead empties the hour
+        assert_eq!(limiter.allow(Kind::Immediate, 100_000), Ok(()));
+        assert_eq!(limiter.immediate.len(), 1);
+    }
+
+    #[test]
+    fn a_failure_puts_unasked_checks_off() {
+        let mut limiter = Limiter::default();
+        assert_eq!(limiter.next_periodic(u32::MAX / 2), PERIOD - 1);
+        assert_eq!(limiter.allow(Kind::Regular, 1000), Ok(()));
+        limiter.finished(false, 1005);
+        // half an hour, for the thread's own next check and for any other unasked one
+        assert_eq!(limiter.next_periodic(0), FAILURE_WAIT);
+        assert_eq!(limiter.allow(Kind::Regular, 1100), Err(1705));
+        assert_eq!(limiter.allow(Kind::Regular, 2804), Err(1));
+        // a person who asks is not put off
+        assert_eq!(limiter.allow(Kind::Immediate, 1100), Ok(()));
+        limiter.finished(false, 1101);
+        // failures in a row: back to the period, never more often
+        assert_eq!(limiter.next_periodic(0), PERIOD * 9 / 10);
+        assert_eq!(limiter.allow(Kind::Regular, 2900), Err(1));
+        assert_eq!(limiter.allow(Kind::Regular, 2901), Ok(()));
+        limiter.finished(false, 2902);
+        assert_eq!(limiter.next_periodic(0), PERIOD * 9 / 10);
+        // a success clears it
+        assert_eq!(limiter.allow(Kind::Immediate, 3000), Ok(()));
+        limiter.finished(true, 3001);
+        assert_eq!(limiter.allow(Kind::Regular, 3060), Ok(()));
+        limiter.finished(false, 3061);
+        assert_eq!(limiter.next_periodic(0), FAILURE_WAIT);
+    }
+
+    #[test]
+    fn the_period_is_six_hours_give_or_take_a_tenth() {
+        let limiter = Limiter::default();
+        assert_eq!(limiter.next_periodic(0), 19_440);
+        assert_eq!(limiter.next_periodic(u32::MAX), 23_760);
+        for jitter in [1, 1000, u32::MAX / 3, u32::MAX - 1] {
+            let wait = limiter.next_periodic(jitter);
+            assert!((19_440..=23_760).contains(&wait), "{wait}");
+        }
+    }
+
+    #[test]
+    fn kicks_wake_the_worker() {
+        let kicks = Kicks::new();
+        assert_eq!(kicks.wait(Duration::ZERO), None);
+        kicks.kick(Kind::Regular);
+        assert_eq!(kicks.wait(Duration::from_secs(60)), Some(Kind::Regular));
+        assert_eq!(kicks.wait(Duration::ZERO), None);
+        // the stronger kick stays
+        kicks.kick(Kind::Immediate);
+        kicks.kick(Kind::Regular);
+        assert_eq!(kicks.wait(Duration::from_secs(60)), Some(Kind::Immediate));
+        kicks.kick(Kind::Regular);
+        kicks.kick(Kind::Immediate);
+        assert_eq!(kicks.wait(Duration::ZERO), Some(Kind::Immediate));
+        assert_eq!(kicks.wait(Duration::ZERO), None);
+    }
+
+    #[test]
+    fn the_address_and_the_date() {
+        assert_eq!(
+            policy_url("rd.example.com"),
+            "https://rd.example.com/api/hjv/version"
+        );
+        assert_eq!(
+            http_date("Mon, 02 Nov 2026 00:00:00 GMT"),
+            Some(1_793_577_600)
+        );
+        assert_eq!(
+            http_date("Mon, 02 Nov 2026 09:00:00 +0900"),
+            Some(1_793_577_600)
+        );
+        assert_eq!(http_date("2026-11-02T00:00:00Z"), None);
+        assert_eq!(http_date(""), None);
+    }
+
+    /// The strict client is for https alone: a request cannot go out in the clear.
+    #[test]
+    fn no_request_without_tls() {
+        for url in [
+            "http://rd.example.com/api/hjv/version",
+            "rd.example.com",
+            "",
+        ] {
+            let request = Request {
+                url: url.to_owned(),
+            };
+            assert_eq!(get(&request), Err(FetchError::Config), "{url:?}");
+        }
+    }
+
+    /// An answer is read only from the address that was asked: one the client was redirected to
+    /// is not the server's.
+    #[test]
+    fn a_redirected_answer_is_not_read() {
+        let asked = policy_url("rd.example.com");
+        let answered = |url: &str| url::Url::parse(url).unwrap();
+        assert!(same_address(&asked, &answered(&asked)));
+        // the same address as the URL parser writes it
+        assert!(same_address(
+            &asked,
+            &answered("https://RD.example.com:443/api/hjv/version")
+        ));
+        for elsewhere in [
+            "https://rd.example.com/api/hjv/version/",
+            "https://rd.example.com/api/hjv/version?x=1",
+            "https://rd.example.com/api/hjv/Version",
+            "https://rd.example.com:8443/api/hjv/version",
+            "https://rd2.example.com/api/hjv/version",
+            "https://example.com/api/hjv/version",
+            "http://rd.example.com/api/hjv/version",
+            "https://user@rd.example.com/api/hjv/version",
+        ] {
+            assert!(!same_address(&asked, &answered(elsewhere)), "{elsewhere}");
+        }
+        assert!(!same_address("not a url", &answered(&asked)));
+    }
+
+    /// A body is read up to one byte more than an envelope may have, whatever is sent.
+    #[test]
+    fn the_body_is_read_up_to_its_limit() {
+        assert_eq!(read_body(&b"{}"[..]), Ok(b"{}".to_vec()));
+        let limit = vec![b' '; MAX_ENVELOPE];
+        assert_eq!(read_body(&limit[..]), Ok(limit.clone()));
+        let over = vec![b' '; MAX_ENVELOPE + 1];
+        assert_eq!(read_body(&over[..]), Err(FetchError::TooLarge));
+        // a server that never stops sending: no more than the limit and a byte are read
+        struct Endless(usize);
+        impl Read for Endless {
+            fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+                buffer.fill(b'x');
+                self.0 += buffer.len();
+                Ok(buffer.len())
+            }
+        }
+        let mut endless = Endless(0);
+        assert_eq!(read_body(&mut endless), Err(FetchError::TooLarge));
+        assert!(endless.0 <= MAX_ENVELOPE + 1, "{}", endless.0);
+        // a connection that breaks
+        struct Broken;
+        impl Read for Broken {
+            fn read(&mut self, _: &mut [u8]) -> std::io::Result<usize> {
+                Err(std::io::Error::other("reset"))
+            }
+        }
+        assert_eq!(read_body(Broken), Err(FetchError::Network));
+    }
+}
diff --git a/src/hjviewer_update/mod.rs b/src/hjviewer_update/mod.rs
new file mode 100644
index 0000000..708fefd
--- /dev/null
+++ b/src/hjviewer_update/mod.rs
@@ -0,0 +1,1657 @@
+//! The minimum app version and updates: the server publishes a signed **version policy**, and an
+//! app that is below its platform's minimum stops connecting out until it is updated.
+//!
+//! - `policy` reads the wire format, `trust` decides whom to believe and what a new policy may
+//!   change, `store` keeps the last believed envelope between runs, `fetch` asks the server,
+//!   `verdict` says what a policy means, and `door` gets packages and short links from hjv-api.
+//! - This file holds the build variables, the state of the process, the thread that checks, and
+//!   what the rest of the app calls: the screens through `main_get_common`/`main_set_common`
+//!   (keys `hjv-update-…`, `hjv-min-version-…`; event `hjv-update`), and the connection code
+//!   through `on_refusal`, `on_login_refusal` and `controller_rule`.
+//!
+//! A build takes part only if it is pinned to a server (HJV_SERVER) and has usable update keys
+//! (HJV_UPDATE_PUBKEY, HJV_UPDATE_ROOT_PUBKEY; HJV_POLICY_FLOOR). Any other build asks the server
+//! nothing and answers the screens nothing, as 1.5.1 does. A build with the E2E's test commands
+//! (feature hjv-e2e) takes part only against the test server `hjv.test` with this repository's
+//! test keys, so that it can never act on a real server's policy.
+//!
+//! The app fails open: without a policy it believes, it blocks nothing. What holds old apps back
+//! for good are hbbs and the PCs, which refuse them; this module makes an app notice by itself.
+
+// Only the Flutter screens ask for the state, a link or a download. A build without them (the
+// Sciter UI, the E2E's headless client) leaves that half uncalled.
+#![cfg_attr(
+    not(any(target_os = "android", target_os = "ios", feature = "flutter")),
+    allow(dead_code)
+)]
+
+use hbb_common::{
+    config::{Config, LocalConfig},
+    log,
+};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use std::{
+    path::PathBuf,
+    sync::{Mutex, Once, OnceLock},
+    time::Duration,
+};
+
+mod door;
+mod fetch;
+mod policy;
+mod store;
+mod trust;
+#[cfg(test)]
+pub(crate) mod vectors;
+mod verdict;
+
+use fetch::Kind;
+use verdict::State;
+
+const BUILD_SERVER: Option<&str> = option_env!("HJV_SERVER");
+const UPDATE_PUBKEY: Option<&str> = option_env!("HJV_UPDATE_PUBKEY");
+const UPDATE_ROOT_PUBKEY: Option<&str> = option_env!("HJV_UPDATE_ROOT_PUBKEY");
+const POLICY_FLOOR: Option<&str> = option_env!("HJV_POLICY_FLOOR");
+/// The only server an E2E build takes a policy from.
+const E2E_SERVER: &str = "hjv.test";
+/// A process that takes connections first checks this long after its start.
+const SERVICE_FIRST_CHECK: Duration = Duration::from_secs(30);
+const LOG_INTERVAL: Duration = Duration::from_secs(1800);
+
+/// The update keys a build uses, or why it uses none.
+fn configured(
+    pinned: bool,
+    server: Option<&str>,
+    signing: Option<&str>,
+    root: Option<&str>,
+    floor: Option<&str>,
+    e2e: bool,
+) -> Result<trust::Pinned, &'static str> {
+    let server = server
+        .filter(|server| pinned && !server.is_empty())
+        .ok_or("not pinned to a server")?;
+    let build = trust::pinned(server, signing, root, floor)?;
+    if e2e && !(server == E2E_SERVER && trust::only_test_keys(&build)) {
+        return Err("a build with the E2E commands takes policies of hjv.test and test keys only");
+    }
+    Ok(build)
+}
+
+fn build() -> Option<&'static trust::Pinned> {
+    static BUILD: OnceLock<Option<trust::Pinned>> = OnceLock::new();
+    BUILD
+        .get_or_init(|| {
+            let pinned = crate::hjviewer::pinned();
+            let (signing, root) = (UPDATE_PUBKEY, UPDATE_ROOT_PUBKEY);
+            let e2e = cfg!(feature = "hjv-e2e");
+            match configured(pinned, BUILD_SERVER, signing, root, POLICY_FLOOR, e2e) {
+                Ok(build) => {
+                    log::info!("version policy: key set {}", build.fingerprint);
+                    Some(build)
+                }
+                Err(why) => {
+                    // no keys is the usual development build; keys that cannot be used are a
+                    // mistake of the build
+                    let given = |value: Option<&str>| value.is_some_and(|v| !v.trim().is_empty());
+                    if pinned && (given(signing) || given(root)) {
+                        log::error!("version policy: off in this build: {why}");
+                    }
+                    None
+                }
+            }
+        })
+        .as_ref()
+}
+
+/// Whether this build checks versions at all.
+pub(crate) fn enabled() -> bool {
+    build().is_some()
+}
+
+/// What happened to a check.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Outcome {
+    /// the same policy came again
+    Unchanged,
+    Updated,
+    Rejected(trust::Reject),
+    /// refused, after the envelope's declaration was taken: it is held and enforced from now on
+    Declared(trust::Reject),
+    Failed(fetch::FetchError),
+}
+
+impl Outcome {
+    fn ok(self) -> bool {
+        matches!(self, Outcome::Unchanged | Outcome::Updated)
+    }
+}
+
+/// What the screens show besides the policy, which this process knows by itself.
+struct Local {
+    current: &'static str,
+    /// installed on Windows, where the service updates the PC
+    installed: bool,
+    /// what this process can show door 1: "token" for a login, else "none"
+    credential: &'static str,
+}
+
+fn local() -> Local {
+    #[cfg(windows)]
+    let installed = crate::platform::is_installed();
+    #[cfg(not(windows))]
+    let installed = false;
+    let logged_in =
+        crate::hjviewer_account::enabled() && !LocalConfig::get_option("access_token").is_empty();
+    Local {
+        current: crate::VERSION,
+        installed,
+        credential: if logged_in { "token" } else { "none" },
+    }
+}
+
+/// What a controller of some platform is held to by the policy this process enforces.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ControllerRule {
+    /// the lowest `min` of the platform's entries, `x.y.z`: the version a refusal names
+    pub min: String,
+    /// LIMIT(now) as `hbb_common::get_version_number` counts: the lowest of what the platform's
+    /// entries block at this time (`grace_min` before a deadline, `min` from it on); a controller
+    /// below it is refused
+    pub min_number: i64,
+    /// whether that blocks anyone at all
+    pub enforced: bool,
+}
+
+/// The state of this process: what it believes, when it asked, and what the screen told it.
+struct Core {
+    build: trust::Pinned,
+    path: PathBuf,
+    os: verdict::Os,
+    e2e: bool,
+    kept: store::Kept,
+    /// whether `kept` changed since it was last written
+    unsaved: bool,
+    /// the last attempt, by the device's clock
+    tried_at: u64,
+    /// the last answer with a policy this app holds, by the forward clock
+    checked: Option<u64>,
+    /// when the thread next checks by itself, by the forward clock
+    next_check: u64,
+    /// a check was asked for or is under way: the screen may wait for its end
+    checking: bool,
+    limiter: fetch::Limiter,
+    /// where an Android app was installed from, once the screen said so ("" for a file)
+    installer: Option<String>,
+    /// the device's system version, as `verdict::os_too_old` reads it
+    device_os: Option<String>,
+    job: door::Job,
+}
+
+#[derive(Deserialize)]
+struct Device {
+    #[serde(default)]
+    installer: Option<String>,
+    #[serde(default)]
+    os: Option<String>,
+}
+
+impl Core {
+    fn open(build: trust::Pinned, path: PathBuf, os: verdict::Os, e2e: bool) -> Core {
+        let kept = store::load(&build, &path);
+        Core {
+            build,
+            path,
+            os,
+            e2e,
+            kept,
+            unsaved: false,
+            tried_at: 0,
+            checked: None,
+            next_check: 0,
+            checking: false,
+            limiter: fetch::Limiter::default(),
+            installer: None,
+            device_os: None,
+            job: door::Job::default(),
+        }
+    }
+
+    fn server(&self) -> &str {
+        &self.build.server
+    }
+
+    /// What this process enforces: the policy it holds, or its declaration's base.
+    fn policy(&self) -> Option<&policy::Policy> {
+        self.kept.trust.effective()
+    }
+
+    /// The policy this process may download and install from, if it may (it is then the one it
+    /// enforces).
+    fn installable(&self) -> Option<&policy::Policy> {
+        self.kept.trust.installable(self.build.floor)
+    }
+
+    /// The time the policy's deadlines are read by.
+    fn now(&self, wall: u64) -> i64 {
+        verdict::policy_now(
+            i64::try_from(wall).unwrap_or(i64::MAX),
+            self.kept.server_offset,
+            self.policy().map_or(i64::MIN, |policy| policy.issued),
+        )
+    }
+
+    fn channel(&self) -> Option<verdict::Channel> {
+        verdict::own_channel(self.os, self.installer.as_deref(), self.e2e)
+    }
+
+    fn entry(&self) -> Option<&policy::Entry> {
+        self.channel()?.entry(self.policy()?)
+    }
+
+    fn installable_entry(&self) -> Option<&policy::Entry> {
+        self.channel()?.entry(self.installable()?)
+    }
+
+    fn state(&self, current: i64, wall: u64) -> State {
+        verdict::judge(self.entry(), current, self.now(wall))
+    }
+
+    /// A request, if the limits let one go out now; else in how many seconds one may.
+    fn begin(&mut self, kind: Kind, mono: u64) -> Result<fetch::Request, u64> {
+        if let Err(wait) = self.limiter.allow(kind, mono) {
+            self.checking = false;
+            // the thread's own check, held up, comes back when it may go
+            if mono >= self.next_check {
+                self.next_check = mono + wait;
+            }
+            return Err(wait);
+        }
+        self.checking = true;
+        Ok(fetch::Request {
+            url: fetch::policy_url(&self.build.server),
+        })
+    }
+
+    /// Takes the answer to a request: an envelope changes what the app holds only by the rules
+    /// of `trust`, and anything else leaves it as it was. A refused envelope whose declaration was
+    /// taken leaves the declaration held, but is no answer.
+    fn finish(
+        &mut self,
+        reply: Result<fetch::Reply, fetch::FetchError>,
+        wall: u64,
+        mono: u64,
+        jitter: u32,
+    ) -> Outcome {
+        self.tried_at = wall;
+        self.checking = false;
+        let outcome = match reply {
+            Err(error) => Outcome::Failed(error),
+            Ok(reply) if reply.status == 200 => {
+                let (trust, outcome) = trust::accept(&self.build, &self.kept.trust, &reply.body);
+                let changed = trust != self.kept.trust;
+                self.kept.trust = trust;
+                match outcome {
+                    trust::Outcome::Taken | trust::Outcome::Unchanged => {
+                        self.answered(reply.date.as_deref(), wall, mono);
+                        match outcome {
+                            trust::Outcome::Taken => Outcome::Updated,
+                            _ => Outcome::Unchanged,
+                        }
+                    }
+                    trust::Outcome::Refused(reject) if changed => {
+                        self.unsaved = true;
+                        Outcome::Declared(reject)
+                    }
+                    trust::Outcome::Refused(reject) => Outcome::Rejected(reject),
+                }
+            }
+            // a 304 too: no request names an envelope
+            Ok(reply) => Outcome::Failed(fetch::FetchError::Status(reply.status)),
+        };
+        self.limiter.finished(outcome.ok(), mono);
+        self.next_check = mono + self.limiter.next_periodic(jitter);
+        outcome
+    }
+
+    fn answered(&mut self, date: Option<&str>, wall: u64, mono: u64) {
+        let device = i64::try_from(wall).unwrap_or(i64::MAX);
+        self.kept.checked_at = wall;
+        self.kept.server_offset = date
+            .and_then(fetch::http_date)
+            .map(|server| server.saturating_sub(device));
+        self.checked = Some(mono);
+        self.unsaved = true;
+    }
+
+    /// What to write, when something changed since the last time.
+    fn take_unsaved(&mut self) -> Option<store::Kept> {
+        std::mem::take(&mut self.unsaved).then(|| self.kept.clone())
+    }
+
+    /// How long the thread sleeps: until its next check, or until a grace period ends, so that
+    /// the screen hears of it when it happens.
+    fn sleep_for(&self, current: i64, wall: u64, mono: u64) -> Duration {
+        let mut seconds = self.next_check.saturating_sub(mono).max(1);
+        if self.state(current, wall) == State::Grace {
+            if let Some(until) = self.entry().and_then(|entry| entry.grace_until) {
+                let left = until.saturating_sub(self.now(wall));
+                seconds = seconds.min(u64::try_from(left).unwrap_or(1).max(1));
+            }
+        }
+        Duration::from_secs(seconds)
+    }
+
+    /// `hjv-update-device`: `{"installer": …, "os": …}`, either or both. `installer` is the store
+    /// an Android app was installed by ("com.android.vending" for Google Play, "" for a file);
+    /// `os` the system `os_min` is held against: Android's API level, the iOS version, the
+    /// Windows version.
+    fn set_device(&mut self, value: &str) {
+        let Ok(device) = serde_json::from_str::<Device>(value) else {
+            return;
+        };
+        let short = |text: &Option<String>| text.as_ref().is_some_and(|text| text.len() <= 100);
+        if short(&device.installer) {
+            self.installer = device.installer;
+        }
+        if short(&device.os) {
+            self.device_os = device.os;
+        }
+    }
+
+    /// `hjv-update-state`: what the screens show.
+    /// - `state`: unknown, ok, available, grace or required, for the entry `channel` (windows,
+    ///   android, android_play, ios, or "" while this app has none), by what this process
+    ///   enforces: the policy it holds, or its declaration's base;
+    /// - `current`, `min`, `latest`, and `grace_min` ("" without a deadline): below it the app is
+    ///   blocked before `grace_until` too; `grace_until`, `policy_issued`, `checked_at` (the last
+    ///   answer) and `tried_at` (the last attempt) in Unix seconds, 0 for none;
+    /// - `os_min`, and `os_too_old` once `hjv-update-device` told the device's system;
+    /// - `notes`, `contact`, `source`: the policy's texts, to show as plain text, never as links
+    ///   (a base has none);
+    /// - `move_to_play`; `package`: the file's name and size, or null when the entry has none or
+    ///   nothing may be installed now (a base, a policy below the build's floor or of another
+    ///   epoch);
+    /// - `installed`, `installer`, `credential`; `policy_epoch`, `policy_seq` (0 for a base);
+    /// - `checking`: a check was asked for and has not ended;
+    /// - `job`: the download's `phase` (idle, downloading, ready, error), the `error`'s code,
+    ///   `done` and `total` in bytes, and the checked `file` when ready.
+    fn state_json(&self, local: &Local, wall: u64) -> Value {
+        let current = hbb_common::get_version_number(local.current);
+        let (channel, entry, policy) = (self.channel(), self.entry(), self.policy());
+        let text = |text: Option<&String>| text.cloned().unwrap_or_default();
+        let os_min = text(entry.and_then(|entry| entry.os_min.as_ref()));
+        let os_too_old = match (channel, &self.device_os) {
+            (Some(channel), Some(device)) if !os_min.is_empty() => {
+                verdict::os_too_old(channel, &os_min, device)
+            }
+            _ => false,
+        };
+        json!({
+            "state": self.state(current, wall).name(),
+            "channel": channel.map_or("", verdict::Channel::name),
+            "current": local.current,
+            "min": entry.map_or("", |entry| entry.min.as_str()),
+            "latest": entry.map_or("", |entry| entry.latest.as_str()),
+            "grace_min": entry
+                .and_then(|entry| entry.grace_min.as_ref())
+                .map_or("", |grace_min| grace_min.as_str()),
+            "grace_until": entry.and_then(|entry| entry.grace_until).unwrap_or(0),
+            "os_min": os_min,
+            "os_too_old": os_too_old,
+            "notes": text(entry.and_then(|entry| entry.notes.as_ref())),
+            "source": text(entry.and_then(|entry| entry.source.as_ref())),
+            "contact": text(policy.and_then(|policy| policy.contact.as_ref())),
+            "move_to_play": entry.is_some_and(|entry| entry.move_to_play),
+            "package": self
+                .installable_entry()
+                .and_then(|entry| entry.package.as_ref())
+                .map(|package| json!({ "file": package.file, "size": package.size })),
+            "installed": local.installed,
+            "installer": text(self.installer.as_ref()),
+            "credential": local.credential,
+            "policy_epoch": policy.map_or(0, |policy| policy.epoch),
+            "policy_seq": policy.map_or(0, |policy| policy.seq),
+            "policy_issued": policy.map_or(0, |policy| policy.issued),
+            "checked_at": self.kept.checked_at,
+            "tried_at": self.tried_at,
+            "checking": self.checking,
+            "job": {
+                "phase": self.job.phase.name(),
+                "error": self.job.error,
+                "done": self.job.done,
+                "total": self.job.total,
+                "file": self.job.file,
+            },
+        })
+    }
+
+    /// `hjv-min-version-<platform>`: the lowest minimum of a peer's platform, or "".
+    fn min_version(&self, platform: &str) -> String {
+        verdict::normalize_platform(platform, self.e2e)
+            .zip(self.policy())
+            .and_then(|(platform, policy)| verdict::family_min(policy, platform))
+            .map(|min| min.as_str().to_owned())
+            .unwrap_or_default()
+    }
+
+    fn controller_rule(&self, platform: &str, wall: u64) -> Option<ControllerRule> {
+        let platform = verdict::normalize_platform(platform, self.e2e)?;
+        let policy = self.policy()?;
+        let limit = verdict::family_limit(policy, platform, self.now(wall))?;
+        Some(ControllerRule {
+            min: verdict::family_min(policy, platform)?.as_str().to_owned(),
+            min_number: limit,
+            enforced: limit > 0,
+        })
+    }
+
+    fn refusal(&self, text: &str, current: i64, wall: u64, mono: u64) -> Option<&'static str> {
+        let required = self.state(current, wall) == State::Required;
+        let checked_just_now = self
+            .checked
+            .is_some_and(|at| mono.saturating_sub(at) <= verdict::REFUSAL_FRESH);
+        verdict::refusal_text(text, required, checked_just_now)
+    }
+
+    /// What `hjv-update-download` gets: the `latest` of this app's entry, if it has a package and
+    /// is above this app's own version, in a policy the app may install from. The app installs
+    /// nothing at or below its version.
+    fn download_plan(&self, current: i64) -> Result<door::Plan, door::Failure> {
+        let missing = door::Failure::Missing;
+        let platform = self
+            .channel()
+            .and_then(door::PackagePlatform::of)
+            .ok_or(missing)?;
+        let entry = self.installable_entry().ok_or(missing)?;
+        let package = entry.package.clone().ok_or(missing)?;
+        if entry.latest.number() <= current {
+            return Err(missing);
+        }
+        Ok(door::Plan {
+            platform,
+            version: entry.latest.clone(),
+            package,
+        })
+    }
+}
+
+static CORE: Mutex<Option<Core>> = Mutex::new(None);
+static KICKS: fetch::Kicks = fetch::Kicks::new();
+
+/// Runs `f` on this process's state, which is read from the store the first time; None in a
+/// build that takes no part.
+fn with_core<R>(f: impl FnOnce(&mut Core) -> R) -> Option<R> {
+    let build = build()?;
+    let mut core = CORE.lock().unwrap_or_else(|e| e.into_inner());
+    let core = core.get_or_insert_with(|| {
+        let e2e = cfg!(feature = "hjv-e2e");
+        Core::open(
+            build.clone(),
+            Config::path(store::FILE),
+            verdict::this_os(),
+            e2e,
+        )
+    });
+    Some(f(core))
+}
+
+/// The device's clock, Unix seconds.
+fn wall() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs())
+}
+
+fn current() -> i64 {
+    hbb_common::get_version_number(crate::VERSION)
+}
+
+/// Tells the main window that the state changed: the state itself as the `hjv-update` event, with
+/// the answer to a link request when there is one.
+fn notify(extra: Option<(&'static str, Value)>) {
+    #[cfg(any(target_os = "android", target_os = "ios", feature = "flutter"))]
+    {
+        let local = local();
+        if let Some(mut event) = with_core(|core| core.state_json(&local, wall())) {
+            event["name"] = "hjv-update".into();
+            if let Some((key, value)) = extra {
+                event[key] = value;
+            }
+            crate::flutter::push_global_event(crate::flutter::APP_TYPE_MAIN, event.to_string());
+        }
+    }
+    #[cfg(not(any(target_os = "android", target_os = "ios", feature = "flutter")))]
+    let _ = extra;
+}
+
+/// One check, start to end, on the worker thread: the request goes out and the record is written
+/// with the state unlocked. False when the limits held the request back.
+fn check(kind: Kind) -> bool {
+    let Some(Ok(request)) = with_core(|core| core.begin(kind, fetch::mono())) else {
+        return false;
+    };
+    let reply = fetch::get(&request);
+    let jitter = hbb_common::rand::random::<u32>();
+    let Some((outcome, at, unsaved, path)) = with_core(|core| {
+        let outcome = core.finish(reply, wall(), fetch::mono(), jitter);
+        let trust = &core.kept.trust;
+        let held = trust
+            .held
+            .as_ref()
+            .map(|held| trust::Position::of(&held.policy));
+        let at = (trust.declared_epoch(), held);
+        (outcome, at, core.take_unsaved(), core.path.clone())
+    }) else {
+        return false;
+    };
+    match (outcome, at) {
+        (Outcome::Updated, (_, Some(held))) => {
+            log::info!("version policy: now at {}:{}", held.epoch, held.seq)
+        }
+        (Outcome::Updated, _) | (Outcome::Unchanged, _) => {}
+        (Outcome::Declared(why), (epoch, _)) => {
+            log::warn!("version policy: refused ({why:?}), with the declaration of epoch {epoch}, which is held now")
+        }
+        (Outcome::Rejected(why), _) => {
+            hbb_common::throttled_log!(LOG_INTERVAL, warn, "version policy: refused ({why:?})")
+        }
+        (Outcome::Failed(why), _) => {
+            hbb_common::throttled_log!(LOG_INTERVAL, warn, "version policy: no policy ({why:?})")
+        }
+    }
+    if let (Some(kept), Some(build)) = (unsaved, build()) {
+        if let Err(e) = store::save(build, &path, &kept) {
+            hbb_common::throttled_log!(LOG_INTERVAL, warn, "version policy: not stored: {e}");
+        }
+    }
+    true
+}
+
+/// The worker thread: it checks when asked and when its own next check is due, and tells the
+/// screen after each check and when a grace period ends. A request that the limits held back
+/// tells the screen nothing, so that asking cannot turn into a stream of events.
+fn worker(first: Duration) {
+    let mut sleep = first;
+    loop {
+        let kick = KICKS.wait(sleep);
+        let due = with_core(|core| fetch::mono() >= core.next_check).unwrap_or(false);
+        let checked = kick.or(due.then_some(Kind::Regular)).is_some_and(check);
+        if checked || kick.is_none() {
+            notify(None);
+        }
+        let Some(next) = with_core(|core| core.sleep_for(current(), wall(), fetch::mono())) else {
+            return;
+        };
+        sleep = next;
+    }
+}
+
+fn start_worker(first: Duration) {
+    static START: Once = Once::new();
+    START.call_once(|| {
+        let spawned = std::thread::Builder::new()
+            .name("hjv-update".to_owned())
+            .spawn(move || worker(first));
+        if let Err(e) = spawned {
+            log::error!("version policy: the checking thread did not start: {e}");
+        }
+    });
+}
+
+fn request_check(kind: Kind) {
+    with_core(|core| core.checking = true);
+    start_worker(Duration::ZERO);
+    KICKS.kick(kind);
+}
+
+/// The process that takes connections (the service's on an installed PC) checks the policy by
+/// itself: first half a minute after its start, then every six hours.
+pub(crate) fn start_service_checks() {
+    if enabled() {
+        start_worker(SERVICE_FIRST_CHECK);
+    }
+}
+
+/// Checks the policy now, within the limits of immediate checks.
+pub(crate) fn check_now() {
+    if enabled() {
+        request_check(Kind::Immediate);
+    }
+}
+
+/// The minimum a controller of `my_platform` (LoginRequest.my_platform) is held to, and whether
+/// its deadline has passed; None when this process has no policy, or none for that platform.
+pub(crate) fn controller_rule(my_platform: &str) -> Option<ControllerRule> {
+    with_core(|core| core.controller_rule(my_platform, wall()))?
+}
+
+fn replaced(text: &str) -> Option<&'static str> {
+    if !verdict::is_version_refusal(text) {
+        return None;
+    }
+    let shown = with_core(|core| core.refusal(text, current(), wall(), fetch::mono()))??;
+    request_check(Kind::Immediate);
+    Some(shown)
+}
+
+/// The text of a connection that hbbs refused (PunchHoleResponse.other_failure). A refusal for the
+/// version is replaced by one of the app's own two texts, which carry no link, and the policy is
+/// checked at once; any other text, and every text in a build that takes no part, stays as it is.
+pub(crate) fn on_refusal(text: &str) -> String {
+    replaced(text).unwrap_or(text).to_owned()
+}
+
+/// The same for the text of a login that a PC refused.
+pub(crate) fn on_login_refusal(text: &str) -> &str {
+    replaced(text).unwrap_or(text)
+}
+
+/// main_get_common: the screens' questions; None for any other key and in a build that takes no
+/// part, where the key then reads as "" like every unknown key.
+/// - `hjv-update-state`: the JSON of `Core::state_json`;
+/// - `hjv-min-version-<platform>`: the minimum a peer of that platform is held to.
+pub(crate) fn get_common(key: &str) -> Option<String> {
+    if key == "hjv-update-state" {
+        let local = enabled().then(local)?;
+        return with_core(|core| core.state_json(&local, wall()).to_string());
+    }
+    let platform = key.strip_prefix("hjv-min-version-")?;
+    with_core(|core| core.min_version(platform))
+}
+
+/// main_set_common: true when the key was this module's.
+/// - `hjv-update-check`: "" for a check nobody waits for, "now" for one somebody does;
+/// - `hjv-update-device`: `{"installer": …, "os": …}`, what only the screen knows of the device;
+/// - `hjv-update-link`: `{"platform": …, "installed": …}`, see `door::request_link`;
+/// - `hjv-update-download`: a folder, see `door::start_download`.
+pub(crate) fn set_common(key: &str, value: &str) -> bool {
+    if !key.starts_with("hjv-update-") || !enabled() {
+        return false;
+    }
+    match key {
+        "hjv-update-check" if value == "now" => request_check(Kind::Immediate),
+        "hjv-update-check" => request_check(Kind::Regular),
+        "hjv-update-device" => {
+            with_core(|core| core.set_device(value));
+        }
+        "hjv-update-link" => door::request_link(value),
+        "hjv-update-download" => door::start_download(value),
+        _ => return false,
+    }
+    true
+}
