+//! Test keys, texts and fixed vectors of the version policy. The expected signatures and hashes
+//! were made with Python's `cryptography` package from the byte layouts alone and checked with
+//! OpenSSL; the tests reproduce them with this module's code on libsodium. The first policy key
+//! and the device key are those of the design's research vector.
+//!
+//! The private keys here are public test values, seeds of 32 consecutive byte values: never use
+//! them for anything else.
+
+use super::{
+    policy::{POLICY_CONTEXT, ROOT_CONTEXT},
+    trust::{self, Pinned},
+};
+use hbb_common::{
+    base64::{engine::general_purpose::STANDARD, Engine as _},
+    sodiumoxide::crypto::sign,
+};
+
+pub(crate) struct TestKey {
+    pub id: u16,
+    /// the seed's first byte; the others count up from it
+    pub seed: u8,
+}
+
+/// The signing keys 1 and 2 (seeds 40 41 .. 5f and 80 81 .. 9f) and the root keys 101 (a0 .. bf)
+/// and 102 (e0 .. ff), the release tool's test keys of the same numbers.
+pub(crate) const SIGNING_1: TestKey = TestKey { id: 1, seed: 0x40 };
+pub(crate) const SIGNING_2: TestKey = TestKey { id: 2, seed: 0x80 };
+pub(crate) const ROOT: TestKey = TestKey {
+    id: 101,
+    seed: 0xa0,
+};
+pub(crate) const ROOT_2: TestKey = TestKey {
+    id: 102,
+    seed: 0xe0,
+};
+/// A key no build pins.
+pub(crate) const STRANGER: TestKey = TestKey { id: 3, seed: 0xc0 };
+/// A device's key (seed 60 61 .. 7f).
+pub(crate) const DEVICE_SEED: u8 = 0x60;
+
+pub(crate) const SIGNING_1_PK: &str = "JUO5L/EJVRFHatyDadtt3JM2ZaEZeN2hQE7hBmypVZ0=";
+pub(crate) const SIGNING_2_PK: &str = "zRSzf5VulTGU/3+3Oz2B3MVh1hp1OAlLfD4aZD7l86o=";
+pub(crate) const ROOT_PK: &str = "T9CZzNR9eJPf6ewkQU7LDZtUICMqrTDZHEZb4zy+ZcQ=";
