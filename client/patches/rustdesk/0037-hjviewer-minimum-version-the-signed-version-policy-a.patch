+++ b/src/hjviewer_update/door.rs
@@ -0,0 +1,1228 @@
+//! Door 1: how an app of 1.6.0 or later gets a package from hjv-api, and how a controller gets a
+//! short link for the browser of a remote PC.
+//!
+//! - `GET /api/hjv/update/{windows|android}/{x.y.z}` by the login (the token and the account
+//!   key's signature of the request, X-HJV-Proof) or by the device key of an installed PC that is
+//!   bound to an account (X-HJV-Device, X-HJV-Time, X-HJV-Sig);
+//! - `POST /api/hjv/update/{windows|android}/link` by the login, which answers a link good for
+//!   ten minutes.
+//!
+//! The policy names no address. The app makes every address from the server compiled into the
+//! build, asks for the `latest` of the signed policy alone, and believes a file only by the size
+//! and SHA-256 that the policy signed. So neither a policy nor an answer can send a download
+//! elsewhere, and whoever controls the server can withhold a package but not replace it.
+
+use super::{
+    fetch,
+    policy::{Package, Version},
+    verdict::Channel,
+};
+use hbb_common::{
+    base64::{engine::general_purpose::STANDARD, Engine as _},
+    config::LocalConfig,
+    log,
+    sodiumoxide::crypto::sign,
+};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicBool, Ordering},
+    time::{Duration, Instant},
+};
+
+/// What a device key signs to download: the context, the device's ID, the time, the platform and
+/// the version, joined by NUL bytes.
+const UPDATE_CONTEXT: &[u8] = b"hjv-update-v1";
+const LINK_TIMEOUT: Duration = Duration::from_secs(20);
+/// For a whole package, on a slow line too.
+const DOWNLOAD_TIMEOUT: Duration = Duration::from_secs(30 * 60);
+const MAX_LINK_ANSWER: u64 = 4096;
+/// hjv-api answers an error with a line of JSON.
+const MAX_ERROR_ANSWER: u64 = 4096;
+const PROGRESS_EVERY: Duration = Duration::from_millis(300);
+
+/// The account key's signature of a request that carries the login's token (design v3 4-2): in
+/// the app the account module's, in tests a stand-in.
+pub(crate) trait RequestSigner {
+    /// The X-HJV-Proof value; None when there is no account key to sign with.
+    fn proof(&self, method: &str, path_and_query: &str, body: &[u8], token: &str)
+        -> Option<String>;
+}
+
+/// The login's account key, through the account module.
+pub(crate) struct AccountSigner;
+
+impl RequestSigner for AccountSigner {
+    fn proof(
+        &self,
+        method: &str,
+        path_and_query: &str,
+        body: &[u8],
+        token: &str,
+    ) -> Option<String> {
+        crate::hjviewer_account::proof_header(method, path_and_query, body, token)
+    }
+}
+
+/// The platforms a package exists for.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum PackagePlatform {
+    Windows,
+    Android,
+}
+
+impl PackagePlatform {
+    /// Play's and Apple's apps come from their stores.
+    pub(crate) fn of(channel: Channel) -> Option<PackagePlatform> {
+        match channel {
+            Channel::Windows => Some(PackagePlatform::Windows),
+            Channel::Android => Some(PackagePlatform::Android),
+            Channel::AndroidPlay | Channel::Ios => None,
+        }
+    }
+
+    pub(crate) fn parse(name: &str) -> Option<PackagePlatform> {
+        match name {
+            "windows" => Some(PackagePlatform::Windows),
+            "android" => Some(PackagePlatform::Android),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            PackagePlatform::Windows => "windows",
+            PackagePlatform::Android => "android",
+        }
+    }
+
+    fn extension(self) -> &'static str {
+        match self {
+            PackagePlatform::Windows => "exe",
+            PackagePlatform::Android => "apk",
+        }
+    }
+}
+
+/// A request to door 1, ready to send.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct DoorRequest {
+    pub post: bool,
+    pub url: String,
+    pub headers: Vec<(&'static str, String)>,
+    pub body: String,
+}
+
+pub(crate) fn package_path(platform: PackagePlatform, version: &Version) -> String {
+    format!("/api/hjv/update/{}/{}", platform.name(), version.as_str())
+}
+
+pub(crate) fn link_path(platform: PackagePlatform) -> String {
+    format!("/api/hjv/update/{}/link", platform.name())
+}
+
+/// Text that can go in a header as it is.
+fn header_safe(value: &str) -> bool {
+    !value.is_empty() && value.bytes().all(|b| (0x21..=0x7e).contains(&b))
+}
+
+/// A request by the login: the token, and the account key's signature of the method, the path,
+/// the body and the token. None without a token or without the key.
+pub(crate) fn by_token(
+    server: &str,
+    post: bool,
+    path: &str,
+    body: String,
+    token: &str,
+    signer: &dyn RequestSigner,
+) -> Option<DoorRequest> {
+    if !header_safe(token) {
+        return None;
+    }
+    let method = if post { "POST" } else { "GET" };
+    let proof = signer.proof(method, path, body.as_bytes(), token)?;
+    header_safe(&proof).then(|| DoorRequest {
+        post,
+        url: format!("https://{server}{path}"),
+        headers: vec![
+            ("Authorization", format!("Bearer {token}")),
+            ("X-HJV-Proof", proof),
+        ],
+        body,
+    })
+}
+
+pub(crate) fn device_message(
+    id: &str,
+    t: u64,
+    platform: PackagePlatform,
+    version: &Version,
+) -> Vec<u8> {
+    let t = t.to_string();
+    [
+        UPDATE_CONTEXT,
+        id.as_bytes(),
+        t.as_bytes(),
+        platform.name().as_bytes(),
+        version.as_str().as_bytes(),
+    ]
+    .join(&0u8)
+}
+
+/// A package download by a device: its ID, the server's time and the device key's signature of
+/// both with the platform and the version. hjv-api takes it from an installed PC that is bound to
+/// an account, for that PC's own platform.
+pub(crate) fn by_device(
+    server: &str,
+    platform: PackagePlatform,
+    version: &Version,
+    id: &str,
+    t: u64,
+    key: &sign::SecretKey,
+) -> Option<DoorRequest> {
+    if !header_safe(id) {
+        return None;
+    }
+    let _ = hbb_common::sodiumoxide::init();
+    let message = device_message(id, t, platform, version);
+    let signature = sign::sign_detached(&message, key).to_bytes();
+    Some(DoorRequest {
+        post: false,
+        url: format!("https://{server}{}", package_path(platform, version)),
+        headers: vec![
+            ("X-HJV-Device", id.to_owned()),
+            ("X-HJV-Time", t.to_string()),
+            ("X-HJV-Sig", STANDARD.encode(signature)),
+        ],
+        body: String::new(),
+    })
+}
+
+/// A short link for the browser of a remote device.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Link {
+    pub url: String,
+    /// the name the browser saves the file under
+    pub file: String,
+    pub expires_in: u64,
+}
+
+#[derive(Deserialize)]
+struct LinkAnswer {
+    url: String,
+    file: String,
+    expires_in: u64,
+}
+
+/// `^/api/hjv/u/[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$`: a code of Crockford's base32.
+fn short_link_path(path: &str) -> bool {
+    let Some(code) = path.strip_prefix("/api/hjv/u/") else {
+        return false;
+    };
+    let symbol = |b: &u8| {
+        b.is_ascii_digit() || (b.is_ascii_uppercase() && !matches!(b, b'I' | b'L' | b'O' | b'U'))
+    };
+    let code = code.as_bytes();
+    code.len() == 9 && code[4] == b'-' && code[..4].iter().chain(&code[5..]).all(symbol)
+}
+
+/// The answer to a link request. The link is this build's server and the answer's path, and only
+/// when the path has exactly the form of a short link: an answer cannot name another site.
+pub(crate) fn parse_link(server: &str, answer: &[u8]) -> Option<Link> {
+    let answer: LinkAnswer = serde_json::from_slice(answer).ok()?;
+    let file_ok = (1..=100).contains(&answer.file.len())
+        && answer
+            .file
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'));
+    let valid = short_link_path(&answer.url) && file_ok && (1..=3600).contains(&answer.expires_in);
+    valid.then(|| Link {
+        url: format!("https://{server}{}", answer.url),
+        file: answer.file,
+        expires_in: answer.expires_in,
+    })
+}
+
+/// Why a package or a link did not come.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Failure {
+    /// no login, no account key, or the server did not take them
+    Login,
+    Network,
+    /// the server's certificate did not hold
+    Tls,
+    /// the server does not hand this out to this login or device
+    Refused,
+    /// no newer package: none in the policy, or none on the server
+    Missing,
+    /// too many requests or downloads right now
+    Busy,
+    Http,
+    /// the file is not the one the policy signed
+    Verify,
+    /// the file could not be written
+    File,
+}
+
+impl Failure {
+    pub(crate) fn code(self) -> &'static str {
+        match self {
+            Failure::Login => "login",
+            Failure::Network => "network",
+            Failure::Tls => "tls",
+            Failure::Refused => "refused",
+            Failure::Missing => "missing",
+            Failure::Busy => "busy",
+            Failure::Http => "http",
+            Failure::Verify => "verify",
+            Failure::File => "file",
+        }
+    }
+}
+
+/// Sends a request with the certificate checked: the 200 answer of the asked address, or why
+/// there is none. It blocks.
+#[cfg(windows)]
+pub(crate) fn send(
+    request: &DoorRequest,
+    timeout: Duration,
+) -> Result<reqwest::blocking::Response, Failure> {
+    let response = transmit(request, timeout)?;
+    match response.status().as_u16() {
+        200 => Ok(response),
+        status => Err(failure_of(status)),
+    }
+}
+
+/// The answer of the asked address, whatever its status, with the certificate checked.
+fn transmit(
+    request: &DoorRequest,
+    timeout: Duration,
+) -> Result<reqwest::blocking::Response, Failure> {
+    let client = fetch::strict_client(&request.url).map_err(|_| Failure::Network)?;
+    let mut builder = if request.post {
+        client
+            .post(&request.url)
+            .header(reqwest::header::CONTENT_TYPE, "application/json")
+            .body(request.body.clone())
+    } else {
+        client.get(&request.url)
+    };
+    for (name, value) in &request.headers {
+        builder = builder.header(*name, value);
+    }
+    let response = builder.timeout(timeout).send().map_err(|e| {
+        if fetch::tls_failure(&e) {
+            Failure::Tls
+        } else {
+            Failure::Network
+        }
+    })?;
+    if !fetch::from_asked(&response, &request.url) {
+        return Err(Failure::Network);
+    }
+    Ok(response)
+}
+
+/// Why an answer other than 200 brings nothing.
+fn failure_of(status: u16) -> Failure {
+    match status {
+        401 => Failure::Login,
+        403 => Failure::Refused,
+        404 => Failure::Missing,
+        429 | 503 => Failure::Busy,
+        _ => Failure::Http,
+    }
+}
+
+/// Sends a request by the login. Its answer reaches the account module as every account answer
+/// does, so that the module learns the server's clock (design v3 4-2); after a 409 `clock`, the
+/// answer to a proof signed more than ten minutes off the server's time, the request goes once
+/// more, signed by the clock that answer taught.
+fn send_by_login(
+    server: &str,
+    post: bool,
+    path: &str,
+    body: &str,
+    timeout: Duration,
+) -> Result<reqwest::blocking::Response, Failure> {
+    let mut again = true;
+    loop {
+        let request = by_token(
+            server,
+            post,
+            path,
+            body.to_owned(),
+            &token(),
+            &AccountSigner,
+        )
+        .ok_or(Failure::Login)?;
+        let mut response = transmit(&request, timeout)?;
+        let status = response.status().as_u16();
+        let date = response
+            .headers()
+            .get(reqwest::header::DATE)
+            .and_then(|date| date.to_str().ok())
+            .unwrap_or_default()
+            .to_owned();
+        let mut text = Vec::new();
+        if status != 200 {
+            // an error's body is a line of JSON; one that does not come says nothing
+            response
+                .by_ref()
+                .take(MAX_ERROR_ANSWER)
+                .read_to_end(&mut text)
+                .ok();
+        }
+        let text = String::from_utf8_lossy(&text);
+        let answer = account_answer(status, &date, &text);
+        crate::hjviewer_account::observe_account_response(&request.url, &answer);
+        if status == 200 {
+            return Ok(response);
+        }
+        if !(again && clock_answer(status, &text)) {
+            return Err(failure_of(status));
+        }
+        again = false;
+    }
+}
+
+/// An answer in the form in which the account module hears every account answer
+/// (`http_request`'s): the status, the Date header and the body.
+fn account_answer(status: u16, date: &str, body: &str) -> String {
+    json!({ "status_code": status, "headers": { "date": date }, "body": body }).to_string()
+}
+
+/// hjv-api's 409 `clock`: `{"error":…,"hjv":"clock","server_time":…}`.
+fn clock_answer(status: u16, body: &str) -> bool {
+    status == 409
+        && serde_json::from_str::<Value>(body)
+            .is_ok_and(|answer| answer.get("hjv").and_then(Value::as_str) == Some("clock"))
+}
+
+/// Copies a package from `body` to `out` and checks it against the policy: exactly `size` bytes
+/// with the signed SHA-256. At most one byte more than the size is read, whatever is sent.
+pub(crate) fn receive(
+    body: &mut dyn Read,
+    package: &Package,
+    out: &mut dyn Write,
+    progress: &mut dyn FnMut(u64),
+) -> Result<(), Failure> {
+    let mut body = body.take(package.size.saturating_add(1));
+    let mut hasher = Sha256::new();
+    let mut buffer = vec![0u8; 64 * 1024];
+    let mut done = 0u64;
+    loop {
+        let n = match body.read(&mut buffer) {
+            Ok(0) => break,
+            Ok(n) => n,
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(_) => return Err(Failure::Network),
+        };
+        done += n as u64;
+        if done > package.size {
+            return Err(Failure::Verify);
+        }
+        hasher.update(&buffer[..n]);
+        out.write_all(&buffer[..n]).map_err(|_| Failure::File)?;
+        progress(done);
+    }
+    let hash: [u8; 32] = hasher.finalize().into();
+    if done != package.size || hash != package.sha256 {
+        return Err(Failure::Verify);
+    }
+    out.flush().map_err(|_| Failure::File)
+}
+
+/// What to download: the `latest` of this app's own entry.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Plan {
+    pub platform: PackagePlatform,
+    pub version: Version,
+    pub package: Package,
+}
+
+impl Plan {
+    /// The file the app writes: its own name for the version, never one from the policy or the
+    /// server.
+    fn file_name(&self) -> String {
+        format!(
+            "HJViewer-{}.{}",
+            self.version.as_str(),
+            self.platform.extension()
+        )
+    }
+}
+
+/// Writes the package to a new file in `dir` and checks it. A file of that name that was there
+/// before is removed first and never read; a file that fails the check is removed again.
+pub(crate) fn store_package(
+    body: &mut dyn Read,
+    plan: &Plan,
+    dir: &Path,
+    progress: &mut dyn FnMut(u64),
+) -> Result<PathBuf, Failure> {
+    if !dir.is_absolute() {
+        return Err(Failure::File);
+    }
+    std::fs::create_dir_all(dir).map_err(|_| Failure::File)?;
+    let path = dir.join(plan.file_name());
+    std::fs::remove_file(&path).ok();
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&path)
+        .map_err(|_| Failure::File)?;
+    let written = receive(body, &plan.package, &mut file, progress)
+        .and_then(|()| file.sync_all().map_err(|_| Failure::File));
+    drop(file);
+    if written.is_err() {
+        std::fs::remove_file(&path).ok();
+    }
+    written.map(|()| path)
+}
+
+/// How far the download of this process got.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub(crate) enum Phase {
+    #[default]
+    Idle,
+    Downloading,
+    /// the file is there and is the one the policy signed
+    Ready,
+    Error,
+}
+
+impl Phase {
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            Phase::Idle => "idle",
+            Phase::Downloading => "downloading",
+            Phase::Ready => "ready",
+            Phase::Error => "error",
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub(crate) struct Job {
+    pub phase: Phase,
+    /// a Failure's code
+    pub error: &'static str,
+    pub done: u64,
+    pub total: u64,
+    /// the checked file, when ready
+    pub file: String,
+}
+
+impl Job {
+    fn failed(failure: Failure) -> Job {
+        Job {
+            phase: Phase::Error,
+            error: failure.code(),
+            ..Default::default()
+        }
+    }
+}
+
+fn token() -> String {
+    LocalConfig::get_option("access_token")
+}
+
+/// An answer that states another length than the signed size is not read at all.
+fn announced(length: Option<u64>, package: &Package) -> Result<(), Failure> {
+    match length {
+        Some(length) if length != package.size => Err(Failure::Verify),
+        _ => Ok(()),
+    }
+}
+
+fn download(
+    server: &str,
+    plan: &Plan,
+    dir: &Path,
+    progress: &mut dyn FnMut(u64),
+) -> Result<PathBuf, Failure> {
+    let path = package_path(plan.platform, &plan.version);
+    let mut response = send_by_login(server, false, &path, "", DOWNLOAD_TIMEOUT)?;
+    announced(response.content_length(), &plan.package)?;
+    store_package(&mut response, plan, dir, progress)
+}
+
+/// `hjv-update-download`: downloads the `latest` of this app's entry into `dir`, by the login, on
+/// a thread of its own. The state's `job` and the `hjv-update` events tell how far it got; when it
+/// is ready, `job.file` is a file that is the one the policy signed.
+pub(crate) fn start_download(dir: &str) {
+    let dir = PathBuf::from(dir);
+    let current = hbb_common::get_version_number(crate::VERSION);
+    let begun = super::with_core(|core| {
+        if core.job.phase == Phase::Downloading {
+            return None;
+        }
+        let plan = core.download_plan(current);
+        core.job = match &plan {
+            Ok(plan) => Job {
+                phase: Phase::Downloading,
+                total: plan.package.size,
+                ..Default::default()
+            },
+            Err(failure) => Job::failed(*failure),
+        };
+        Some((plan.ok()?, core.server().to_owned()))
+    });
+    let Some(Some((plan, server))) = begun else {
+        super::notify(None);
+        return;
+    };
+    let spawned = std::thread::Builder::new()
+        .name("hjv-update-download".to_owned())
+        .spawn(move || {
+            let mut last = Instant::now();
+            let mut progress = |done: u64| {
+                if last.elapsed() >= PROGRESS_EVERY {
+                    last = Instant::now();
+                    super::with_core(|core| core.job.done = done);
+                    super::notify(None);
+                }
+            };
+            let job = match download(&server, &plan, &dir, &mut progress) {
+                Ok(file) => Job {
+                    phase: Phase::Ready,
+                    done: plan.package.size,
+                    total: plan.package.size,
+                    file: file.to_string_lossy().into_owned(),
+                    ..Default::default()
+                },
+                Err(failure) => {
+                    log::warn!("update: the package did not come ({})", failure.code());
+                    Job::failed(failure)
+                }
+            };
+            super::with_core(|core| core.job = job);
+            super::notify(None);
+        });
+    if spawned.is_err() {
+        super::with_core(|core| core.job = Job::failed(Failure::File));
+        super::notify(None);
+    }
+}
+
+fn link(server: &str, platform: PackagePlatform, installed: bool) -> Result<Link, Failure> {
+    let body = format!(r#"{{"installed":{installed}}}"#);
+    let mut answer = Vec::new();
+    send_by_login(server, true, &link_path(platform), &body, LINK_TIMEOUT)?
+        .take(MAX_LINK_ANSWER + 1)
+        .read_to_end(&mut answer)
+        .map_err(|_| Failure::Network)?;
+    parse_link(server, &answer).ok_or(Failure::Http)
+}
+
+/// `hjv-update-link`: asks for a short link of the platform's package (`{"platform":"windows",
+/// "installed":true}`; an installed PC gets the file that opens the installer). The answer comes
+/// in an `hjv-update` event, as `link` (`url`, `file`, `expires_in`) or as `link_error`.
+pub(crate) fn request_link(value: &str) {
+    #[derive(Deserialize)]
+    struct Ask {
+        platform: String,
+        #[serde(default)]
+        installed: bool,
+    }
+    static BUSY: AtomicBool = AtomicBool::new(false);
+    let asked = serde_json::from_str::<Ask>(value)
+        .ok()
+        .and_then(|ask| Some((PackagePlatform::parse(&ask.platform)?, ask.installed)));
+    let Some(((platform, installed), server)) =
+        asked.zip(super::with_core(|core| core.server().to_owned()))
+    else {
+        super::notify(Some(("link_error", Failure::Http.code().into())));
+        return;
+    };
+    if BUSY.swap(true, Ordering::SeqCst) {
+        return;
+    }
+    let spawned = std::thread::Builder::new()
+        .name("hjv-update-link".to_owned())
+        .spawn(move || {
+            let event = match link(&server, platform, installed) {
+                Ok(link) => (
+                    "link",
+                    json!({ "url": link.url, "file": link.file, "expires_in": link.expires_in }),
+                ),
+                Err(failure) => ("link_error", failure.code().into()),
+            };
+            BUSY.store(false, Ordering::SeqCst);
+            super::notify(Some(event));
+        });
+    if spawned.is_err() {
+        BUSY.store(false, Ordering::SeqCst);
+        super::notify(Some(("link_error", Failure::File.code().into())));
+    }
+}
