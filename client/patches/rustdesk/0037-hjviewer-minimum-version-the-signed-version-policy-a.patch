+        assert_eq!(
+            core.sleep_for(number("1.5.1"), wall, 19_400),
+            Duration::from_secs(40)
+        );
+        assert_eq!(
+            core.sleep_for(number("1.5.1"), wall, 30_000),
+            Duration::from_secs(1)
+        );
+    }
