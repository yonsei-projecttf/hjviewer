+    #[test]
+    fn the_limits_and_the_period_of_the_checks() {
+        let file = TempFile::new("limits", store::FILE);
+        let mut core = open(&file, Os::Windows);
+        // due at once after the start
+        assert_eq!(core.next_check, 0);
+        assert_eq!(core.sleep_for(0, 0, 0), Duration::from_secs(1));
+        checked(
+            &mut core,
+            Kind::Regular,
+            5,
+            ISSUED,
+            reply(200, &signed_1(1, 7)),
+        );
+        // then after the period (jitter 0: 90%)
+        assert_eq!(core.next_check, 5 + fetch::PERIOD * 9 / 10);
+        assert_eq!(
+            core.sleep_for(number("1.6.1"), ISSUED as u64, 5),
+            Duration::from_secs(19_440)
+        );
+        // within the minute nothing goes out, and the thread's own check waits
+        assert_eq!(core.begin(Kind::Regular, 30), Err(35));
+        assert_eq!(core.begin(Kind::Immediate, 10), Err(5));
+        // the screen sees a check from the asking to its end, and none when it was held up
+        let checking = |core: &Core| core.state_json(&LOCAL, 0)["checking"] == true;
+        core.checking = true;
+        assert_eq!(core.begin(Kind::Immediate, 11), Err(4));
+        assert!(!checking(&core));
+        assert!(core.begin(Kind::Immediate, 15).is_ok());
+        assert!(checking(&core));
+        core.finish(Err(FetchError::Network), ISSUED as u64, 15, 0);
+        assert!(!checking(&core));
+        // a failure: the thread tries again in half an hour, and regular checks stay away
+        assert_eq!(core.next_check, 15 + fetch::FAILURE_WAIT);
+        assert_eq!(core.begin(Kind::Regular, 100), Err(1715));
+        // its own check, held up when due, comes back when it may go
+        core.next_check = 100;
+        assert_eq!(core.begin(Kind::Regular, 100), Err(1715));
+        assert_eq!(core.next_check, 1815);
+        assert!(core.begin(Kind::Regular, 1815).is_ok());
+        core.finish(Err(FetchError::Network), ISSUED as u64, 1815, u32::MAX);
+        // failures in a row: the period again, not every half hour
+        assert_eq!(core.next_check, 1815 + 23_760);
+        // the policy is still the one that came first
+        assert_eq!(core.policy().map(|p| p.seq), Some(7));
+    }
