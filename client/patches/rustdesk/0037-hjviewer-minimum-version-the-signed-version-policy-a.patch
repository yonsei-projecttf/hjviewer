+    #[test]
+    fn sequence_numbers_only_grow() {
+        let a = at_1_7();
+        // the same bytes again: nothing changes
+        assert_eq!(take(&a, &signed_1(1, 7)), (a.clone(), Outcome::Unchanged));
+        // a lower number, and the same number with another text
+        assert_eq!(refused(&a, &signed_1(1, 6)), Reject::Rollback);
+        assert_eq!(refused(&a, &signed_1(1, 1)), Reject::Rollback);
+        let other = policy_with(1, 7, |p| {
+            p["platforms"]["windows"]["latest"] = "1.6.2".into()
+        });
+        assert_eq!(
+            refused(&a, &envelope(1, &SIGNING_1, &other, None)),
+            Reject::Fork
+        );
+        // a root key cannot rewrite a taken position either
+        assert_eq!(refused(&a, &root_signed(&other)), Reject::Fork);
+        assert_eq!(
+            refused(&a, &root_signed(&policy_text(1, 6))),
+            Reject::Rollback
+        );
+        // the same text signed again with another key is still the same policy
+        let again = envelope(2, &SIGNING_2, &policy_text(1, 7), None);
+        assert_eq!(take(&a, &again), (a.clone(), Outcome::Unchanged));
+        assert_eq!(
+            take(&a, &root_signed(&policy_text(1, 7))),
+            (a.clone(), Outcome::Unchanged)
+        );
+        // one step, and the widest step a policy may take, whoever signed it
+        assert_eq!(seq(&taken(&a, &signed_1(1, 8))), Some((1, 8)));
+        assert_eq!(seq(&taken(&a, &signed_1(1, 1007))), Some((1, 1007)));
+        assert_eq!(refused(&a, &signed_1(1, 1008)), Reject::Jump);
+        assert_eq!(refused(&a, &signed_1(1, u64::MAX)), Reject::Jump);
+        assert_eq!(
+            refused(&a, &root_signed(&policy_text(1, 5000))),
+            Reject::Jump
+        );
+        assert_eq!(
+            seq(&taken(&a, &root_signed(&policy_text(1, 1007)))),
+            Some((1, 1007))
+        );
+        // a first policy is held against the floor the same way
+        let fresh = Trust::default();
+        assert_eq!(seq(&taken(&fresh, &signed_1(1, 1000))), Some((1, 1000)));
+        assert_eq!(refused(&fresh, &signed_1(1, 1001)), Reject::Jump);
+        assert_eq!(
+            refused(&fresh, &root_signed(&policy_text(1, 1001))),
+            Reject::Jump
+        );
+    }
