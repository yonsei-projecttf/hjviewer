+    #[test]
+    fn which_builds_take_part() {
+        fn on(
+            pinned: bool,
+            server: Option<&str>,
+            signing: Option<&str>,
+            root: Option<&str>,
+            e2e: bool,
+        ) -> bool {
+            configured(pinned, server, signing, root, None, e2e).is_ok()
+        }
+        let (signing, root) = (Some(HJV_UPDATE_PUBKEY), Some(HJV_UPDATE_ROOT_PUBKEY));
+        // a build pinned to a server, with the keys
+        assert!(on(true, Some(SERVER), signing, root, false));
+        let build = configured(true, Some(SERVER), signing, root, Some("1:4"), false).unwrap();
+        assert_eq!(build.fingerprint, FINGERPRINT);
+        assert_eq!(build.floor, trust::Position { epoch: 1, seq: 4 });
+        // not pinned: upstream's build, whatever else is set
+        assert!(!on(false, Some(SERVER), signing, root, false));
+        assert!(!on(false, None, signing, root, false));
+        assert!(!on(true, None, signing, root, false));
+        assert!(!on(true, Some(""), signing, root, false));
+        // no keys, or only some: as 1.5.1
+        assert!(!on(true, Some(SERVER), None, None, false));
+        assert!(!on(true, Some(SERVER), Some(""), Some(""), false));
+        assert!(!on(true, Some(SERVER), signing, None, false));
+        assert!(!on(true, Some(SERVER), None, root, false));
+        // keys that do not keep the form
+        assert!(!on(true, Some(SERVER), Some("1:AAAA"), root, false));
+        assert!(configured(true, Some(SERVER), signing, root, Some("x"), false).is_err());
+
+        // a build with the E2E commands: the test server and the test keys, both
+        assert!(on(true, Some("hjv.test"), signing, root, true));
+        assert!(!on(true, Some(SERVER), signing, root, true));
+        assert!(!on(true, Some("hjv.test.example.com"), signing, root, true));
+        assert!(!on(false, Some("hjv.test"), signing, root, true));
+        assert!(!on(true, Some("hjv.test"), None, None, true));
+        // a key whose private half is nowhere in this repository
+        let mut seed = seed(0x40);
+        seed[0] ^= 0x80;
+        let real = sign::keypair_from_seed(&sign::Seed(seed)).0;
+        let real = format!("1:{}", STANDARD.encode(real.0));
+        assert!(!on(true, Some("hjv.test"), Some(real.as_str()), root, true));
+        // the same keys in a build without the E2E commands are that build's keys
+        assert!(on(true, Some("hjv.test"), Some(real.as_str()), root, false));
+    }
