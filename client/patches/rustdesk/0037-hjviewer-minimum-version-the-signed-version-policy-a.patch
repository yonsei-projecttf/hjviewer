+
+    /// The code of the trust rules (2-4) as the vectors write it: `Field:<member>` for a field.
+    pub(crate) fn code(why: Reject) -> String {
+        match why {
+            Reject::Field(member) => format!("Field:{member}"),
+            other => format!("{other:?}"),
+        }
+    }
+
+    /// A state in the words of the vectors' manifest (trust rules 7-4).
+    fn described(pinned: &Pinned, state: &Trust, what: &str) -> Value {
+        let floor = pinned.floor;
+        let held = state.held.as_ref();
+        let enforces = match state.effective() {
+            None => "nothing",
+            Some(policy) if held.is_some_and(|held| std::ptr::eq(policy, &held.policy)) => "policy",
+            Some(_) => "base",
+        };
+        match what {
+            "epoch" => state.epoch(floor).into(),
+            "seq" => held.map_or(Value::Null, |held| held.policy.seq.into()),
+            "revoked" => {
+                let mut revoked = state.revoked().to_vec();
+                revoked.sort();
+                serde_json::json!(revoked)
+            }
+            "p_sha256" => held.map_or(Value::Null, |held| hex::encode(held.hash).into()),
+            "root_sha256" => state.decl.as_ref().map_or(Value::Null, |decl| {
+                sha256_hex(decl.part.p.as_bytes()).into()
+            }),
+            "root_k" => state
+                .decl
+                .as_ref()
+                .map_or(Value::Null, |decl| decl.part.k.into()),
+            "enforces" => enforces.into(),
+            "may_install" => state.may_install(floor).into(),
+            other => panic!("a state member the test does not know: {other}"),
+        }
+    }
+
+    /// Every member the manifest names of a state, as the client has it.
+    fn compare(pinned: &Pinned, state: &Trust, expected: &Value, name: &str, which: &str) {
+        let expected = expected
+            .as_object()
+            .unwrap_or_else(|| panic!("{name}: {which} is no object"));
+        for (member, want) in expected {
+            let have = described(pinned, state, member);
+            assert_eq!(&have, want, "{name}: {which}.{member}");
+        }
+    }
+
+    /// The vectors of the release tool (hjviewer repository, tools/hjv-release/tests/vectors,
+    /// made from the trust rules' model): envelopes an app takes and envelopes it refuses, each
+    /// after the envelopes it took before, and `covers.json`. Every case comes out here as the
+    /// manifest says: its outcome and reason code, and the state it leaves (also a refused one
+    /// that kept its declaration); a case only the tool refuses is taken as `app_expect` says;
+    /// and `then_accept` is taken from the state the refused case left.
+    ///
+    ///     HJV_UPDATE_VECTORS=<that folder> cargo test --lib hjviewer_update::vectors -- --ignored
+    #[test]
+    #[ignore]
+    fn the_release_tools_vectors() {
+        let dir = std::env::var("HJV_UPDATE_VECTORS").expect("HJV_UPDATE_VECTORS");
+        let dir = std::path::PathBuf::from(dir);
+        let read =
+            |file: &str| std::fs::read(dir.join(file)).unwrap_or_else(|e| panic!("{file}: {e}"));
+        let text = |value: &Value| {
+            value
+                .as_str()
+                .unwrap_or_else(|| panic!("not a text: {value}"))
+                .to_owned()
+        };
+        let manifest: Value = serde_json::from_slice(&read("manifest.json")).unwrap();
+        let (server, keys) = (text(&manifest["server"]), &manifest["key_file"]);
+        let build = |floor: &str| {
+            let signing = text(&keys["HJV_UPDATE_PUBKEY"]);
+            let root = text(&keys["HJV_UPDATE_ROOT_PUBKEY"]);
+            trust::pinned(&server, Some(&signing), Some(&root), Some(floor)).unwrap()
+        };
+        let floor = text(&keys["HJV_POLICY_FLOOR"]);
+        let pinned = build(&floor);
+        assert_eq!(pinned.fingerprint, text(&keys["fingerprint_sha256"]));
+        assert_eq!(
+            pinned.roots.len(),
+            2,
+            "the vectors' builds pin two root keys"
+        );
+        assert!(trust::only_test_keys(&pinned));
+
+        let mut counts = std::collections::BTreeMap::<String, usize>::new();
+        let mut count = |what: String| *counts.entry(what).or_default() += 1;
+        for case in manifest["cases"].as_array().unwrap() {
+            let name = text(&case["name"]);
+            let pinned = build(&case.get("floor").map(text).unwrap_or(floor.clone()));
+            let mut state = Trust::default();
+            for before in case["after"].as_array().unwrap() {
+                let (next, outcome) = accept(&pinned, &state, &read(&text(before)));
+                assert!(
+                    matches!(outcome, Outcome::Taken | Outcome::Unchanged),
+                    "{name}: {before} before it: {outcome:?}"
+                );
+                state = next;
+            }
+            let (after, outcome) = accept(&pinned, &state, &read(&text(&case["file"])));
+            let canonical = case["canonical"].as_bool().unwrap_or(true);
+            count(format!("canonical {canonical}"));
+            match case["binding"].as_str().unwrap() {
+                // stricter in the tool than the trust rules ask of an app: the app takes it, as
+                // the manifest says
+                "tool" => {
+                    let expect = &case["app_expect"];
+                    let expect = expect.get("outcome").unwrap_or(expect);
+                    assert_eq!(expect, "accept", "{name}: app_expect");
+                    let taken = match outcome {
+                        Outcome::Taken => "taken",
+                        Outcome::Unchanged => "unchanged",
+                        Outcome::Refused(why) => panic!("{name}: the app refused it: {why:?}"),
+                    };
+                    if let Some(want) = case.get("outcome") {
+                        assert_eq!(want, taken, "{name}: outcome");
+                    }
+                    for state_after in [
+                        case.get("state_after"),
+                        case["app_expect"].get("state_after"),
+                    ]
+                    .into_iter()
+                    .flatten()
+                    {
+                        compare(&pinned, &after, state_after, &name, "state_after");
+                    }
+                    count(format!("tool only, app {taken}"));
+                }
+                "app" => match (case["expect"].as_str().unwrap(), outcome) {
+                    ("accept", Outcome::Taken | Outcome::Unchanged) => {
+                        let taken = match outcome {
+                            Outcome::Taken => "taken",
+                            _ => "unchanged",
+                        };
+                        if let Some(want) = case.get("outcome") {
+                            assert_eq!(want, taken, "{name}: outcome");
+                        }
+                        compare(&pinned, &after, &case["state_after"], &name, "state_after");
+                        count(format!("accept {taken}"));
+                    }
+                    ("reject", Outcome::Refused(why)) => {
+                        assert_eq!(code(why), text(&case["reason"]), "{name}: reason");
+                        match case.get("state_after_refusal") {
+                            Some(kept) => {
+                                assert_ne!(after, state, "{name}: the state did not change");
+                                compare(&pinned, &after, kept, &name, "state_after_refusal");
+                                count("reject, declaration kept".to_owned());
+                            }
+                            None => {
+                                assert_eq!(after, state, "{name}: the state changed");
+                                count("reject".to_owned());
+                            }
+                        }
+                    }
+                    (expect, outcome) => {
+                        panic!("{name}: the manifest says {expect}: {outcome:?}")
+                    }
+                },
+                other => panic!("{name}: binding {other}"),
+            }
+            // from the state the case left
+            if let Some(next) = case.get("then_accept") {
+                let next = next.get("envelope").unwrap_or(next);
+                let (_, then) = accept(&pinned, &after, &read(&text(next)));
+                let then = match then {
+                    Outcome::Taken => "taken",
+                    Outcome::Unchanged => "unchanged",
+                    Outcome::Refused(why) => panic!("{name}: {next} after it: {why:?}"),
+                };
+                if let Some(want) = case.get("then_outcome") {
+                    assert_eq!(want, then, "{name}: then_outcome");
+                }
+                count("then_accept".to_owned());
+            }
+        }
+        // COVERS on every pair of the file
+        let entry = |value: &Value| {
+            let version =
+                |member: &str| value.get(member).map(|v| Version::parse(&text(v)).unwrap());
+            let min = version("min").unwrap();
+            let grace_until = value
+                .get("grace_until")
+                .map(|t| super::super::policy::parse_utc(&text(t)).unwrap());
+            Entry {
+                latest: min.clone(),
+                min,
+                grace_until,
+                grace_min: version("grace_min"),
+                os_min: None,
+                notes: None,
+                source: None,
+                package: None,
+                auto_install_after: None,
+                move_to_play: false,
+            }
+        };
+        let pairs: Value = serde_json::from_slice(&read("covers.json")).unwrap();
+        for pair in pairs.as_array().unwrap() {
+            let (new, old) = (entry(&pair["new"]), entry(&pair["old"]));
+            assert_eq!(
+                Value::Bool(covers(&new, &old)),
+                pair["covers"],
+                "COVERS({}, {})",
+                pair["new"],
+                pair["old"]
+            );
+            count("covers".to_owned());
+        }
+        println!("{counts:?}");
+        assert!(
+            counts.get("covers").is_some_and(|n| *n == 256),
+            "{counts:?}"
+        );
+        // every case was run, and came out as one of these
+        let cases = manifest["cases"].as_array().unwrap().len();
+        let decided: usize = counts
+            .iter()
+            .filter(|(what, _)| {
+                what.starts_with("accept") || what.starts_with("reject") || what.starts_with("tool")
+            })
+            .map(|(_, n)| n)
+            .sum();
+        assert_eq!(decided, cases, "{counts:?}");
+    }
+}
