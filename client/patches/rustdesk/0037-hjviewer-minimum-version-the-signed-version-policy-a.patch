+    /// The answers to the login's requests reach the account module as every account answer
+    /// does, so that it learns the server's clock (design v3 4-2): from the `server_time` of a
+    /// 409 `clock`, the one answer after which a request goes again, or else from the Date.
+    #[test]
+    fn an_answer_tells_the_account_module_the_servers_clock() {
+        let date = "Mon, 02 Nov 2026 00:00:00 GMT";
+        let clock = r#"{"error":"…","hjv":"clock","server_time":1793577600}"#;
+        let heard = |status, body| {
+            serde_json::from_str::<Value>(&account_answer(status, date, body)).unwrap()
+        };
+        assert_eq!(
+            heard(409, clock),
+            json!({ "status_code": 409, "headers": { "date": date }, "body": clock })
+        );
+        assert_eq!(
+            heard(200, ""),
+            json!({ "status_code": 200, "headers": { "date": date }, "body": "" })
+        );
+        assert!(clock_answer(409, clock));
+        for (status, body) in [
+            (200, ""),
+            (401, clock),
+            (409, r#"{"error":"…"}"#),
+            (409, r#"{"hjv":"clocks"}"#),
+            (409, ""),
+            (409, "<html>"),
+        ] {
+            assert!(!clock_answer(status, body), "{status} {body}");
+        }
+        // a second 409 `clock` ends as any other answer that brings nothing
+        assert_eq!(failure_of(409), Failure::Http);
+    }
