+    #[test]
+    fn one_changed_byte_is_refused() {
+        let good = signed_1(1, 7);
+        let fresh = Trust::default();
+        // every byte of the policy text and of the signature is covered
+        let p_start = good.find(r#""p":""#).unwrap() + 5;
+        let s_start = good.find(r#""s":""#).unwrap() + 5;
+        let mut count = 0;
+        for i in (p_start..good.len() - 2).filter(|i| good.is_char_boundary(*i)) {
+            let Some(c) = good[i..]
+                .chars()
+                .next()
+                .filter(|c| c.is_ascii_alphanumeric())
+            else {
+                continue;
+            };
+            let other = if c == '1' { "2" } else { "1" };
+            let mut changed = good.clone();
+            changed.replace_range(i..i + 1, other);
+            let why = refused(&fresh, &changed);
+            if i < s_start - 6 {
+                assert_eq!(why, Reject::BadSignature, "byte {i} ({c})");
+            }
+            count += 1;
+        }
+        assert!(count > 700, "{count}");
+    }
