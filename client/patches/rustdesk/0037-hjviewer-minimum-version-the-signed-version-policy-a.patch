+    }
+
+    /// After a restart the revoked key stays revoked and an older policy stays refused; a
+    /// declaration held without its policy is enforced and compared with as before.
+    #[test]
+    fn what_was_learned_holds_after_a_restart() {
+        let (pinned, file) = (pins(), TempFile::new("restart", FILE));
+        save(&pinned, &file.0, &kept(state_b(&pinned))).unwrap();
+        let loaded = load(&pinned, &file.0).trust;
+        let take = |body: &str| accept(&pinned, &loaded, body.as_bytes()).1;
+        use super::super::trust::Reject;
+        assert_eq!(take(&signed_1(2, 2)), Outcome::Refused(Reject::RevokedKey));
+        assert_eq!(take(&signed_1(1, 8)), Outcome::Refused(Reject::RevokedKey));
+        let by_2 = envelope(2, &SIGNING_2, &policy_text(1, 900), None);
+        assert_eq!(take(&by_2), Outcome::Refused(Reject::Epoch));
+        assert_eq!(take(&declared(2, 1, &[1])), Outcome::Unchanged);
+        assert_eq!(take(&declared(2, 2, &[1])), Outcome::Taken);
+
+        let file = TempFile::new("restart-alone", FILE);
+        let alone = declared_alone(&pinned);
+        save(&pinned, &file.0, &kept(alone.clone())).unwrap();
+        let loaded = load(&pinned, &file.0).trust;
+        assert_eq!(loaded, alone);
+        let base = &loaded.decl.as_ref().unwrap().declaration.base;
+        assert_eq!(loaded.effective(), Some(base));
+        assert!(!loaded.may_install(pinned.floor));
+        assert_eq!(
+            accept(&pinned, &loaded, declared(3, 1, &[1]).as_bytes()).1,
+            Outcome::Taken
+        );
+    }
+
+    /// Each part is checked again alone; a part that does not hold is dropped, and a record that
+    /// keeps nothing is a fresh start.
+    #[test]
+    fn a_part_that_does_not_hold_is_dropped_alone() {
+        let pinned = pins();
+        type Change = fn(&mut Value);
+        // the record's form: a fresh start
+        let fresh: [Change; 12] = [
+            |r| r["v"] = 1.into(),
+            |r| r["v"] = 3.into(),
+            |r| r["v"] = "2".into(),
+            |r| {
+                r.as_object_mut().unwrap().remove("checked_at");
+            },
+            |r| {
+                r.as_object_mut().unwrap().remove("server_offset");
+            },
+            |r| {
+                r.as_object_mut().unwrap().remove("root");
+            },
+            |r| {
+                r.as_object_mut().unwrap().remove("envelope");
+            },
+            |r| r["checked_at"] = Value::Null,
+            |r| r["checked_at"] = (-1).into(),
+            |r| r["server_offset"] = 1.5.into(),
+            |r| r["root"] = "none".into(),
+            |r| r["envelope"] = json!({}),
+        ];
+        for (n, change) in fresh.into_iter().enumerate() {
+            let file = TempFile::new("form", FILE);
+            save(&pinned, &file.0, &kept(state_b(&pinned))).unwrap();
+            edit(&file.0, change);
+            assert_eq!(load(&pinned, &file.0), Kept::default(), "case {n}");
+        }
+        // a root that is no object, also beside a policy of epoch 1 that holds by itself
+        for root in [json!("none"), json!([101, "p", "s"])] {
+            let file = TempFile::new("form-a", FILE);
+            save(&pinned, &file.0, &kept(state_a(&pinned))).unwrap();
+            edit(&file.0, |r| r["root"] = root.clone());
+            assert_eq!(load(&pinned, &file.0), Kept::default(), "{root}");
+        }
+        // the declaration does not hold: dropped, and with it the policy of its epoch
+        let no_declaration: [Change; 6] = [
+            |r| r["root"]["k"] = 102.into(),
+            |r| r["root"]["k"] = 0.into(),
+            |r| r["root"]["k"] = "101".into(),
+            |r| {
+                let p = r["root"]["p"]
+                    .as_str()
+                    .unwrap()
+                    .replacen("[1]", "[1,101]", 1);
+                r["root"]["p"] = p.into();
+            },
+            |r| r["root"]["s"] = B_ROOT_SIG.replacen("Dw==", "Dx==", 1).into(),
+            |r| r["root"] = Value::Null,
+        ];
+        for (n, change) in no_declaration.into_iter().enumerate() {
+            let file = TempFile::new("declaration", FILE);
+            save(&pinned, &file.0, &kept(state_b(&pinned))).unwrap();
+            edit(&file.0, change);
+            assert_eq!(load(&pinned, &file.0), Kept::default(), "case {n}");
+        }
+        // the held policy does not hold: dropped alone, the declaration stays and is enforced
+        let b = state_b(&pinned);
+        let held_drops: [(&str, String); 6] = [
+            // its envelope was changed: one character of a minimum
+            (
+                "changed",
+                b.held
+                    .as_ref()
+                    .unwrap()
+                    .envelope
+                    .replacen("1.6.0", "1.5.0", 1),
+            ),
+            // signed by a key this build does not pin
+            (
+                "unpinned",
+                envelope(
+                    3,
+                    &STRANGER,
+                    &policy_text(2, 1),
+                    Some(&root_part(&ROOT, &root_text(2, &[1]))),
+                ),
+            ),
+            // a policy of epoch 1 with a root part
+            (
+                "epoch 1 with a root part",
+                envelope(
+                    2,
+                    &SIGNING_2,
+                    &policy_text(1, 8),
+                    Some(&root_part(&ROOT, &root_text(2, &[1]))),
+                ),
+            ),
+            // a policy of epoch 2 without one
+            (
+                "no root part",
+                envelope(2, &SIGNING_2, &policy_text(2, 1), None),
+            ),
+            // a later epoch's policy than the declaration's
+            ("root older than policy", declared(3, 1, &[1])),
+            // a policy of the declaration's epoch beside another epoch's root part
+            (
+                "root part of another epoch",
+                envelope(
+                    2,
+                    &SIGNING_2,
+                    &policy_text(2, 1),
+                    Some(&root_part(&ROOT, &root_text(3, &[1]))),
+                ),
+            ),
+        ];
+        for (what, envelope) in held_drops {
+            let file = TempFile::new("held", FILE);
+            save(&pinned, &file.0, &kept(b.clone())).unwrap();
+            edit(&file.0, |r| r["envelope"] = envelope.into());
+            let loaded = load(&pinned, &file.0);
+            assert_eq!(loaded.trust.decl, b.decl, "{what}");
+            assert_eq!(loaded.trust.held, None, "{what}");
+            assert_eq!(
+                (loaded.checked_at, loaded.server_offset),
+                (1_794_000_000, Some(-7))
+            );
+            let base = &loaded.trust.decl.as_ref().unwrap().declaration.base;
+            assert_eq!(loaded.trust.effective(), Some(base), "{what}");
+        }
+        // a policy beside another epoch's root part, under a later declaration: the policy goes
+        let file = TempFile::new("other-root", FILE);
+        let alone = declared_alone(&pinned);
+        save(&pinned, &file.0, &kept(alone.clone())).unwrap();
+        let root_3 = root_part(&ROOT, &root_text(3, &[1]));
+        let mixed = envelope(2, &SIGNING_2, &policy_text(2, 1), Some(&root_3));
+        edit(&file.0, |r| r["envelope"] = mixed.into());
+        let loaded = load(&pinned, &file.0).trust;
+        assert_eq!((loaded.decl, loaded.held), (alone.decl, None));
+        // another declaration text of the same epoch: that declaration stays, the policy goes
+        let file = TempFile::new("fork", FILE);
+        save(&pinned, &file.0, &kept(b.clone())).unwrap();
+        let fork = root_text(2, &[1, 7]);
+        edit(&file.0, |r| {
+            r["root"]["p"] = fork.as_str().into();
+            r["root"]["s"] = ROOT.sign(super::super::policy::ROOT_CONTEXT, &fork).into();
+        });
+        let loaded = load(&pinned, &file.0).trust;
+        assert_eq!(loaded.decl.map(|decl| decl.part.p), Some(fork));
+        assert_eq!(loaded.held, None);
+        // what is not a record at all
+        let file = TempFile::new("garbage", FILE);
+        std::fs::create_dir_all(file.dir()).unwrap();
+        for garbage in [
+            &b""[..],
+            &b"{"[..],
+            &b"[]"[..],
+            &b"[2]"[..],
+            &b"null"[..],
+            &[0xff; 9][..],
+            &vec![b' '; 70_000][..],
+        ] {
+            std::fs::write(&file.0, garbage).unwrap();
+            assert_eq!(load(&pinned, &file.0), Kept::default());
+        }
+        // a file far longer than any record is not read, even if a record is in it
+        let file = TempFile::new("long", FILE);
+        save(&pinned, &file.0, &kept(state_b(&pinned))).unwrap();
+        let mut padded = std::fs::read(&file.0).unwrap();
+        padded.resize(70_000, b' ');
+        std::fs::write(&file.0, &padded).unwrap();
+        assert_eq!(load(&pinned, &file.0), Kept::default());
+        padded.truncate(60_000);
+        std::fs::write(&file.0, &padded).unwrap();
+        assert_eq!(load(&pinned, &file.0), kept(state_b(&pinned)));
+        // what a later version of the app wrote besides is no reason to drop the record
+        let file = TempFile::new("later", FILE);
+        save(&pinned, &file.0, &kept(state_b(&pinned))).unwrap();
+        edit(&file.0, |r| r["later"] = json!({"x": 1}));
+        assert_eq!(load(&pinned, &file.0), kept(state_b(&pinned)));
+        // a record of the first format is a fresh start
+        let file = TempFile::new("v1", FILE);
+        std::fs::create_dir_all(file.dir()).unwrap();
+        let v1 = json!({"v": 1, "fingerprint": FINGERPRINT, "epoch": 1, "seq": 7,
+            "hash": A_POLICY_SHA256, "revoked": [], "envelope": signed_1(1, 7), "etag": "\"x\"",
+            "checked_at": 5, "server_offset": null});
+        std::fs::write(&file.0, v1.to_string()).unwrap();
+        assert_eq!(load(&pinned, &file.0), Kept::default());
+    }
+
+    /// A crafted record whose held policy is signed by a key its own declaration revokes: the
+    /// declaration's base is enforced, and nothing is installed.
+    #[test]
+    fn a_crafted_record_of_a_revoked_signer_enforces_the_base() {
+        let (pinned, file) = (pins(), TempFile::new("crafted", FILE));
+        save(&pinned, &file.0, &kept(state_b(&pinned))).unwrap();
+        let root = root_part(&ROOT, &root_text(2, &[1]));
+        let by_1 = envelope(1, &SIGNING_1, &policy_text(2, 5), Some(&root));
+        edit(&file.0, |r| r["envelope"] = by_1.into());
+        let loaded = load(&pinned, &file.0).trust;
+        assert_eq!(loaded.held.as_ref().map(|held| held.k), Some(1));
+        let base = &loaded.decl.as_ref().unwrap().declaration.base;
+        assert_eq!(loaded.effective(), Some(base));
+        assert!(!loaded.may_install(pinned.floor));
+    }
+
+    /// A build of another key set keeps exactly the parts it can verify (trust rules 1-6).
+    #[test]
+    fn another_key_set_keeps_what_it_verifies() {
+        let (pinned, file) = (pins(), TempFile::new("keys", FILE));
+        let roots = HJV_UPDATE_ROOT_PUBKEY;
+        // keys 2 and 3, the build after a rotation: key 2's policy and its declaration stay
+        let rotated = format!("{},{}", SIGNING_2.line(), STRANGER.line());
+        let rotated = trust::pinned(SERVER, Some(&rotated), Some(roots), Some("2:1")).unwrap();
+        assert_ne!(rotated.fingerprint, pinned.fingerprint);
+        let b = state_b(&pinned);
+        save(&pinned, &file.0, &kept(b.clone())).unwrap();
+        let loaded = load(&rotated, &file.0);
+        assert_eq!(loaded.trust, b);
+        assert!(loaded.trust.may_install(rotated.floor));
+        // key 1's policy of epoch 1: nothing it verifies
+        let file = TempFile::new("keys-1", FILE);
+        save(&pinned, &file.0, &kept(state_a(&pinned))).unwrap();
+        assert_eq!(load(&rotated, &file.0), Kept::default());
+        // root keys 102 and 103: 101's declaration goes, and with it the policy of its epoch
+        let roots_2 = format!(
+            "{},{}",
+            ROOT_2.line(),
+            STRANGER.line().replacen("3:", "103:", 1)
+        );
+        let other_roots =
+            trust::pinned(SERVER, Some(HJV_UPDATE_PUBKEY), Some(&roots_2), None).unwrap();
+        let file = TempFile::new("roots", FILE);
+        save(&pinned, &file.0, &kept(b)).unwrap();
+        assert_eq!(load(&other_roots, &file.0), Kept::default());
+        // but an epoch 1 policy of a signing key it pins stays
+        let file = TempFile::new("roots-1", FILE);
+        let a = state_a(&pinned);
+        save(&pinned, &file.0, &kept(a.clone())).unwrap();
+        assert_eq!(load(&other_roots, &file.0).trust, a);
+        // the same keys for another server: nothing
+        let moved = trust::pinned(
+            "rd2.example.com",
+            Some(HJV_UPDATE_PUBKEY),
+            Some(roots),
+            None,
+        );
+        assert_eq!(load(&moved.unwrap(), &file.0), Kept::default());
+        // the build that wrote it still reads all of it
+        assert_eq!(load(&pinned, &file.0).trust, a);
+    }
+
+    /// A build made under a later policy keeps the stored policy in force; it installs nothing
+    /// from it until it holds a policy at or above its floor.
+    #[test]
+    fn a_later_floor_over_an_older_record() {
+        let (pinned, file) = (pins(), TempFile::new("floor", FILE));
+        let a = state_a(&pinned);
+        save(&pinned, &file.0, &kept(a.clone())).unwrap();
+        let later = pins_with_floor("1:9");
+        let loaded = load(&later, &file.0);
+        assert_eq!(loaded.trust, a);
+        assert_eq!(
+            loaded.trust.effective(),
+            Some(&a.held.as_ref().unwrap().policy)
+        );
+        assert!(!loaded.trust.may_install(later.floor));
+        let take = |body: &str| accept(&later, &loaded.trust, body.as_bytes());
+        use super::super::trust::Reject;
+        assert_eq!(take(&signed_1(1, 8)).1, Outcome::Refused(Reject::Rollback));
+        let (at_floor, outcome) = take(&signed_1(1, 9));
+        assert_eq!(outcome, Outcome::Taken);
+        assert!(at_floor.may_install(later.floor));
+        // a floor in a later epoch: the held policy of the declaration's epoch is still enforced
+        let in_epoch_2 = pins_with_floor("2:3");
+        let loaded = load(&in_epoch_2, &file.0).trust;
+        assert_eq!(loaded.epoch(in_epoch_2.floor), 2);
+        assert_eq!(loaded.effective(), Some(&a.held.as_ref().unwrap().policy));
+        assert_eq!(loaded.basis(Position { epoch: 2, seq: 3 }), None);
+        // writing it again keeps the record what it was
+        save(&later, &file.0, &kept(loaded)).unwrap();
+        assert_eq!(load(&pinned, &file.0).trust, a);
+    }
+
+    /// Of two processes of this user, the record that holds the later declaration, then the later
+    /// policy of its epoch, stays, whichever writes last.
+    #[test]
+    fn the_later_record_of_two_processes_stays() {
+        let pinned = pins();
+        let (a, b, alone) = (state_a(&pinned), state_b(&pinned), declared_alone(&pinned));
+        let next = taken(&pinned, &b, &declared(2, 2, &[1]));
+        for (lower, higher) in [(&a, &b), (&b, &next), (&next, &alone), (&a, &alone)] {
+            for (first, second) in [(lower, higher), (higher, lower)] {
+                let file = TempFile::new("two", FILE);
+                save(&pinned, &file.0, &kept(first.clone())).unwrap();
+                save(&pinned, &file.0, &kept(second.clone())).unwrap();
+                assert_eq!(&load(&pinned, &file.0).trust, higher);
+            }
+        }
+        // a record that does not hold is no reason to keep one's own back
+        let file = TempFile::new("two-broken", FILE);
+        save(&pinned, &file.0, &kept(b.clone())).unwrap();
+        edit(&file.0, |r| r["root"] = Value::Null);
+        save(&pinned, &file.0, &kept(a.clone())).unwrap();
+        assert_eq!(load(&pinned, &file.0).trust, a);
+        // and the same state is written again, with the newer time
+        let mut again = kept(a);
+        again.checked_at = 5;
+        save(&pinned, &file.0, &again).unwrap();
+        assert_eq!(load(&pinned, &file.0), again);
+    }
+}
