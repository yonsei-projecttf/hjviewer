+    #[test]
+    fn the_clock() {
+        let device = GRACE;
+        // the device's clock, when nothing says otherwise
+        assert_eq!(policy_now(device, None, ISSUED), device);
+        assert_eq!(policy_now(device, Some(0), ISSUED), device);
+        // never before the policy was issued: a clock set back does not bring the grace back
+        assert_eq!(policy_now(ISSUED - 86_400 * 400, None, ISSUED), ISSUED);
+        assert_eq!(policy_now(0, Some(-5), ISSUED), ISSUED);
+        // a Date in the future is not believed, however far: it would end a grace period early
+        assert_eq!(policy_now(device, Some(1), ISSUED), device);
+        assert_eq!(policy_now(device, Some(86_400 * 365 * 30), ISSUED), device);
+        // nor a Date up to a day behind the device
+        assert_eq!(policy_now(device, Some(-3600), ISSUED), device);
+        assert_eq!(policy_now(device, Some(-86_400), ISSUED), device);
+        // a device more than a day ahead of the server goes by the server's time
+        assert_eq!(policy_now(device, Some(-86_401), ISSUED), device - 86_401);
+        assert_eq!(
+            policy_now(device + 86_400 * 30, Some(-86_400 * 30), ISSUED),
+            device
+        );
+        // but still not before the policy was issued
+        assert_eq!(policy_now(device, Some(-86_400 * 400), ISSUED), ISSUED);
+        assert_eq!(policy_now(i64::MIN + 5, Some(i64::MIN), ISSUED), ISSUED);
+
+        // what that means for a deadline: a device running a month fast is not blocked early
+        let policy = policy_of(|_| {});
+        let windows = Channel::Windows.entry(&policy);
+        let fast = GRACE - 86_400 + 86_400 * 30;
+        let now = policy_now(fast, Some(-86_400 * 30), ISSUED);
+        assert_eq!(judge(windows, number("1.5.1"), now), State::Grace);
+        assert_eq!(
+            judge(windows, number("1.5.1"), policy_now(fast, None, ISSUED)),
+            State::Required
+        );
+        // and a server that claims a far future date does not block anyone early
+        let now = policy_now(GRACE - 10, Some(86_400 * 365), ISSUED);
+        assert_eq!(judge(windows, number("1.5.1"), now), State::Grace);
+    }
