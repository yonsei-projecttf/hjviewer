+/// The vectors' policy with changes, as the JSON a tool would write for it.
+pub(crate) fn policy_with(
+    epoch: u64,
+    seq: u64,
+    change: impl FnOnce(&mut serde_json::Value),
+) -> String {
+    let mut policy: serde_json::Value = serde_json::from_str(&policy_text(epoch, seq)).unwrap();
+    change(&mut policy);
+    policy.to_string()
+}
+
+/// The requirement part of the vectors' policy: the base of its declarations.
+pub(crate) const BASE: &str = concat!(
+    r#"{"windows":{"min":"1.6.0","latest":"1.6.1","grace_until":"2026-11-16T15:00:00Z","grace_min":"1.5.0"},"#,
+    r#""android":{"min":"1.6.0","latest":"1.6.1","grace_until":"2026-11-16T15:00:00Z","grace_min":"1.5.0"},"#,
+    r#""android_play":{"min":"1.5.0","latest":"1.6.1"},"#,
+    r#""ios":{"min":"1.6.0","latest":"1.6.1","grace_until":"2026-11-16T15:00:00Z","grace_min":"1.5.0"}}"#
+);
+
+/// A declaration of `epoch` that revokes `revoked`, issued with the vectors' policy, with `base`.
+pub(crate) fn declaration(epoch: u64, revoked: &[u16], base: &str) -> String {
+    let revoked: Vec<String> = revoked.iter().map(|k| k.to_string()).collect();
+    format!(
+        r#"{{"v":1,"server":"rd.example.com","epoch":{epoch},"revoked":[{}],"issued":"2026-11-02T00:00:00Z","base":{base}}}"#,
+        revoked.join(",")
+    )
+}
+
+/// A declaration of `epoch` that revokes `revoked`, with the base of the vectors' policy.
+pub(crate) fn root_text(epoch: u64, revoked: &[u16]) -> String {
+    declaration(epoch, revoked, BASE)
+}
+
+/// `{"k":…,"p":…,"s":…}` of a root declaration signed with `key`.
+pub(crate) fn root_part(key: &TestKey, text: &str) -> String {
+    format!(
+        r#"{{"k":{},"p":{},"s":"{}"}}"#,
+        key.id,
+        serde_json::to_string(text).unwrap(),
+        key.sign(ROOT_CONTEXT, text)
+    )
+}
+
+/// The envelope of a policy text signed with `key` under the key number `k`, with a root part.
+pub(crate) fn envelope(k: u16, key: &TestKey, p: &str, root: Option<&str>) -> String {
+    let root = root.map(|r| format!(r#","root":{r}"#)).unwrap_or_default();
+    format!(
+        r#"{{"v":1,"k":{k},"p":{},"s":"{}"{root}}}"#,
+        serde_json::to_string(p).unwrap(),
+        key.sign(POLICY_CONTEXT, p)
+    )
+}
+
+/// An envelope of the vectors' policy signed with signing key 1.
+pub(crate) fn signed_1(epoch: u64, seq: u64) -> String {
+    envelope(1, &SIGNING_1, &policy_text(epoch, seq), None)
+}
+
+/// An envelope of the vectors' policy of `epoch` (2 or later), signed with signing key 2, with the
+/// declaration of that epoch by root key 101 that revokes `revoked`.
+pub(crate) fn declared(epoch: u64, seq: u64, revoked: &[u16]) -> String {
+    let root = root_part(&ROOT, &root_text(epoch, revoked));
+    envelope(2, &SIGNING_2, &policy_text(epoch, seq), Some(&root))
+}
+
+/// A file in a folder of its own for a test, removed with the folder when the test ends.
+pub(crate) struct TempFile(pub std::path::PathBuf);
+
+impl TempFile {
+    pub(crate) fn new(test: &str, file: &str) -> TempFile {
+        static NEXT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+        let dir = std::env::temp_dir().join(format!(
+            "hjv-update-{test}-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, std::sync::atomic::Ordering::SeqCst)
+        ));
+        std::fs::remove_dir_all(&dir).ok();
+        TempFile(dir.join(file))
+    }
+
+    pub(crate) fn dir(&self) -> &std::path::Path {
+        self.0.parent().unwrap()
+    }
+}
+
+impl Drop for TempFile {
+    fn drop(&mut self) {
+        std::fs::remove_dir_all(self.dir()).ok();
+    }
+}
