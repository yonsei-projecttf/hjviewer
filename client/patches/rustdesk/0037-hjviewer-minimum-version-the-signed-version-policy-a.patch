+        assert_eq!(min(&policy, Platform::Windows), Some("1.6.0"));
+        assert_eq!(at(&policy, Platform::Ios, GRACE), Some(number("1.6.0")));
+        // Android: what both entries block, the APK's (1.5.0, then 1.6.0) and Play's (1.5.0)
+        for now in [i64::MIN, GRACE - 1, GRACE, i64::MAX] {
+            assert_eq!(at(&policy, Platform::Android, now), Some(number("1.5.0")));
+        }
+        assert_eq!(min(&policy, Platform::Android), Some("1.5.0"));
+
+        // the two Android entries cross: the APK's 1.6.1 has a deadline, Play's 1.6.0 has none.
+        // Before the deadline only what both block is refused: below 1.5.0
+        let crossing = policy_of(|p| {
+            p["platforms"]["android"]["min"] = "1.6.1".into();
+            p["platforms"]["android_play"]["min"] = "1.6.0".into();
+        });
+        assert_eq!(
+            at(&crossing, Platform::Android, GRACE - 1),
+            Some(number("1.5.0"))
+        );
+        assert_eq!(
+            at(&crossing, Platform::Android, GRACE),
+            Some(number("1.6.0"))
+        );
+        assert_eq!(min(&crossing, Platform::Android), Some("1.6.0"));
+        // and the other way: Play's deadline later than the APK's
+        let later_play = policy_of(|p| {
+            p["platforms"]["android_play"]["min"] = "1.6.1".into();
+            p["platforms"]["android_play"]["grace_until"] = "2026-11-23T15:00:00Z".into();
+            p["platforms"]["android_play"]["grace_min"] = "1.6.0".into();
+        });
+        let week = 7 * 86_400;
+        assert_eq!(
+            at(&later_play, Platform::Android, GRACE - 1),
+            Some(number("1.5.0"))
+        );
+        assert_eq!(
+            at(&later_play, Platform::Android, GRACE),
+            Some(number("1.6.0"))
+        );
+        assert_eq!(
+            at(&later_play, Platform::Android, GRACE + week),
+            Some(number("1.6.0"))
+        );
+        assert_eq!(min(&later_play, Platform::Android), Some("1.6.0"));
+
+        // one Android entry alone is the family; none, and nobody is checked
+        let only_file = policy_of(|p| {
+            p["platforms"]
+                .as_object_mut()
+                .unwrap()
+                .remove("android_play");
+        });
+        assert_eq!(
+            at(&only_file, Platform::Android, GRACE),
+            Some(number("1.6.0"))
+        );
+        assert_eq!(
+            at(&only_file, Platform::Android, GRACE - 1),
+            Some(number("1.5.0"))
+        );
+        let only_play = policy_of(|p| {
+            p["platforms"].as_object_mut().unwrap().remove("android");
+        });
+        assert_eq!(min(&only_play, Platform::Android), Some("1.5.0"));
+        let none = policy_of(|p| {
+            let platforms = p["platforms"].as_object_mut().unwrap();
+            platforms.remove("android");
+            platforms.remove("android_play");
+            platforms.remove("ios");
+        });
+        assert_eq!(at(&none, Platform::Android, GRACE), None);
+        assert_eq!(min(&none, Platform::Ios), None);
+        assert!(at(&none, Platform::Windows, GRACE).is_some());
+    }
+
+    /// A raise with its deadline: before it, a controller below the minimum in force is refused,
+    /// one from it on is let in; from the deadline on, below the new minimum is refused.
+    #[test]
+    fn a_pc_during_a_raise() {
+        let raise = policy_of(|p| {
+            let windows = &mut p["platforms"]["windows"];
+            windows["min"] = "1.6.1".into();
+            windows["grace_min"] = "1.6.0".into();
+        });
+        let limit = |now| family_limit(&raise, Platform::Windows, now);
+        assert_eq!(limit(GRACE - 1), Some(number("1.6.0")));
+        assert_eq!(limit(GRACE), Some(number("1.6.1")));
+        // and the app itself: 1.5.x required, 1.6.0 in grace, 1.6.1 ok
+        let windows = Channel::Windows.entry(&raise);
+        assert_eq!(judge(windows, number("1.5.9"), GRACE - 1), State::Required);
+        assert_eq!(judge(windows, number("1.6.0"), GRACE - 1), State::Grace);
+        assert_eq!(judge(windows, number("1.6.0"), GRACE), State::Required);
+        assert_eq!(judge(windows, number("1.6.1"), GRACE - 1), State::Ok);
+    }
+
+    #[test]
+    fn a_system_too_old_for_the_new_version() {
+        // Android: API levels
+        for channel in [Channel::Android, Channel::AndroidPlay] {
+            assert!(os_too_old(channel, "24", "22"));
+            assert!(os_too_old(channel, "24", "9"));
+            assert!(!os_too_old(channel, "24", "24"));
+            assert!(!os_too_old(channel, "22", "36"));
+        }
+        // iOS: dotted numbers, not text
+        assert!(os_too_old(Channel::Ios, "15.0", "13.7"));
+        assert!(os_too_old(Channel::Ios, "15.1", "15.0.9"));
+        assert!(os_too_old(Channel::Ios, "15.0.1", "15"));
+        assert!(!os_too_old(Channel::Ios, "13.0", "17.5.1"));
+        assert!(!os_too_old(Channel::Ios, "13.0", "13"));
+        assert!(!os_too_old(Channel::Ios, "9.3", "10.0"));
+        assert!(!os_too_old(Channel::Ios, "15.0", "15.0.0"));
+        // Windows: the major version
+        assert!(os_too_old(Channel::Windows, "10", "6.3"));
+        assert!(!os_too_old(Channel::Windows, "10", "10"));
+        assert!(!os_too_old(Channel::Windows, "10", "10.0.22631"));
+        assert!(!os_too_old(Channel::Windows, "10.0", "10"));
+        // what cannot be read is not too old
+        for (min, device) in [
+            ("", "10"),
+            ("10", ""),
+            ("10", "Windows 7"),
+            ("24", "UpsideDownCake"),
+            ("24", "+22"),
+            ("24", "22."),
+            ("x", "1"),
+        ] {
+            for channel in [Channel::Windows, Channel::Android, Channel::Ios] {
+                assert!(!os_too_old(channel, min, device), "{min:?} {device:?}");
+            }
+        }
+    }
+
+    /// Only a refusal that names the version is replaced, and what replaces it never makes the
+    /// session reconnect by itself: upstream's own rule (client.rs) says so.
+    #[test]
+    fn refusals_for_the_version() {
+        let s1 = "HJViewer를 1.6.0 이상으로 업데이트해야 연결할 수 있습니다. 그 밖의 Windows·Android는 https://rd.example.com/api/hjv/get/0123456789abcdef0123456789abcdef/ 에서 새 버전을 받으세요. (version not allowed)";
+        let l1 = "이 PC는 HJViewer 1.6.0 이상에서만 연결을 받습니다. 이 기기의 HJViewer를 업데이트한 뒤 다시 연결하세요(지금 버전 1.5.1). (version not allowed)";
+        for refusal in [
+            s1,
+            l1,
+            "version not allowed",
+            "(Version Not Allowed)",
+            R1,
+            R2,
+        ] {
+            assert!(is_version_refusal(refusal));
+            // the first time, and whenever the app must update
+            assert_eq!(refusal_text(refusal, false, false), Some(R1));
+            assert_eq!(refusal_text(refusal, true, false), Some(R1));
+            assert_eq!(refusal_text(refusal, true, true), Some(R1));
+            // checked a moment ago and no update is asked for
+            assert_eq!(refusal_text(refusal, false, true), Some(R2));
+        }
+        for other in [
+            "",
+            "ID does not exist",
+            "Remote desktop is offline",
+            "Connection not allowed",
+            "not allowed",
+            "version",
+            "Wrong Password",
+            "Offline",
+            "versionnot allowed",
+            "version  not allowed",
+        ] {
+            for (required, checked) in [(false, false), (true, false), (false, true), (true, true)]
+            {
+                assert_eq!(refusal_text(other, required, checked), None, "{other:?}");
+            }
+        }
+        for text in [R1, R2, s1, l1] {
+            for retry_for_relay in [false, true] {
+                assert!(!crate::client::check_if_retry(
+                    "error",
+                    "Connection Error",
+                    text,
+                    retry_for_relay
+                ));
+            }
+        }
+        // what upstream's dialog and translation would trip over
+        for text in [R1, R2] {
+            assert!(text.ends_with("(version not allowed)"));
+            assert!(!text.starts_with("Failed"));
+            assert!(!text.contains('{') && !text.contains('}'));
+            assert!(!text.contains("://") && !text.contains("www."));
+            assert!(!text.contains("RustDesk"));
+            assert!(!text.split(' ').next().unwrap().ends_with("_tip"));
+        }
+    }
+}
