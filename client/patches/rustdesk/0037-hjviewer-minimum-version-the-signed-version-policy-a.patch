+            Some(&root),
+        );
+        let revoked = envelope(1, &SIGNING_1, &policy_text(2, 1), Some(&root));
+        let unknown = envelope(3, &STRANGER, &policy_text(2, 1), Some(&root));
+        for (body, why) in [
+            (bad_signature, Reject::BadSignature),
+            (wrong_epoch, Reject::Epoch),
+            (bad_field, Reject::Field("min")),
+            (relaxing, Reject::Relaxation),
+            (revoked, Reject::RevokedKey),
+            (unknown, Reject::UnknownKey),
+        ] {
+            let (refusal, kept) = refused_declared(&a, &body);
+            assert_eq!(refusal, why);
+            assert_eq!((kept.declared_epoch(), kept.revoked()), (2, &[1u16][..]));
+            // the base is enforced, and nothing is installed
+            let base = &kept.decl.as_ref().unwrap().declaration.base;
+            assert_eq!(kept.effective(), Some(base));
+            assert_eq!((base.epoch, base.seq, base.issued), (2, 0, ISSUED));
+            assert!(!kept.may_install(pins().floor));
+            // key 1 stays revoked, and the epoch's next policy is taken against the base
+            assert_eq!(refused(&kept, &signed_1(1, 8)), Reject::RevokedKey);
+            assert_eq!(seq(&taken(&kept, &declared(2, 1, &[1]))), Some((2, 1)));
+        }
+        // a refusal before the declaration was read keeps nothing
+        let broken = declared(2, 1, &[1]).replacen(r#""v":1,"k":2"#, r#""v":1,"k":0"#, 1);
+        assert_eq!(refused(&a, &broken), Reject::Envelope);
+    }
+
+    /// A body that is not UTF-8 is refused before its declaration is looked at.
+    #[test]
+    fn a_body_that_is_not_utf8_keeps_no_declaration() {
+        let a = at_1_7();
+        let mut body = declared(2, 1, &[1]).into_bytes();
+        let at = body.len() - 1;
+        body.splice(at..at, *b",\"y\":\"\xff\"");
+        let (after, outcome) = accept(&pins(), &a, &body);
+        assert_eq!((after, outcome), (a, Outcome::Refused(Reject::Envelope)));
+    }
+
+    /// What a signing key may change: anything that asks at least as much at every time.
+    #[test]
+    fn what_a_signing_key_may_change() {
+        let a = at_1_7();
+        let next = |change: fn(&mut serde_json::Value)| {
+            envelope(1, &SIGNING_1, &policy_with(1, 8, change), None)
+        };
+        let allowed: [fn(&mut serde_json::Value); 12] = [
+            |_| {},
+            // a higher minimum with a later deadline that keeps the minimum in force
+            |p| {
+                let windows = &mut p["platforms"]["windows"];
+                windows["min"] = "1.6.1".into();
+                windows["grace_until"] = "2027-06-01T00:00:00Z".into();
+                windows["grace_min"] = "1.6.0".into();
+            },
+            // a higher minimum with the same deadline (a raise while one is pending)
+            |p| p["platforms"]["windows"]["min"] = "1.6.1".into(),
+            // a deadline brought forward, or taken away: the minimum holds sooner
+            |p| p["platforms"]["windows"]["grace_until"] = "2026-11-10T00:00:00Z".into(),
+            |p| {
+                let windows = p["platforms"]["windows"].as_object_mut().unwrap();
+                windows.remove("grace_until");
+                windows.remove("grace_min");
+            },
+            // more blocked during the grace period
+            |p| p["platforms"]["windows"]["grace_min"] = "1.5.9".into(),
+            // a newer latest version and its package
+            |p| {
+                p["platforms"]["windows"]["latest"] = "1.6.2".into();
+                p["platforms"]["windows"]["package"]["sha256"] = ANDROID_SHA256.into();
+            },
+            // the unattended install stopped or put off: the operator's brake
+            |p| {
+                p["platforms"]["windows"]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("auto_install_after");
+            },
+            |p| p["platforms"]["windows"]["auto_install_after"] = "2027-01-01T00:00:00Z".into(),
+            // texts, and a package taken away
+            |p| {
+                p["contact_ko"] = "".into();
+                p["platforms"]["windows"]["notes_ko"] = "다른 안내".into();
+                p["platforms"]["android"]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("package");
+            },
+            // a platform this version does not know
+            |p| {
+                let ios = p["platforms"]["ios"].clone();
+                p["platforms"]["later"] = ios;
+            },
+            // a policy issued later
+            |p| p["issued"] = "2026-11-05T00:00:00Z".into(),
+        ];
+        for (n, change) in allowed.into_iter().enumerate() {
+            assert_eq!(seq(&taken(&a, &next(change))), Some((1, 8)), "case {n}");
+        }
+        // a platform that was not there may come with any values, but Android's second entry
+        // must ask what its sibling asks
+        let without_ios = policy_with(1, 7, |p| {
+            p["platforms"].as_object_mut().unwrap().remove("ios");
+        });
+        let start = taken(
+            &Trust::default(),
+            &envelope(1, &SIGNING_1, &without_ios, None),
+        );
+        assert_eq!(seq(&taken(&start, &signed_1(1, 8))), Some((1, 8)));
+    }
+
+    /// What a policy may not do without a declaration, whoever signs it.
+    #[test]
+    fn a_policy_cannot_relax_whoever_signs_it() {
+        let a = at_1_7();
+        type Change = fn(&mut serde_json::Value);
+        let relaxations: [Change; 11] = [
+            // a minimum lowered
+            |p| p["platforms"]["windows"]["min"] = "1.5.9".into(),
+            |p| p["platforms"]["android_play"]["min"] = "1.4.0".into(),
+            // the deadline put off, or given where there was none
+            |p| p["platforms"]["windows"]["grace_until"] = "2026-11-16T15:00:01Z".into(),
+            |p| {
+                p["platforms"]["android_play"]["grace_until"] = "2026-11-01T00:00:00Z".into();
+                p["platforms"]["android_play"]["grace_min"] = "1.4.0".into();
+            },
+            // less blocked during the grace period
+            |p| p["platforms"]["ios"]["grace_min"] = "1.4.9".into(),
+            // a higher minimum with a later deadline that lets the minimum in force go (가)
+            |p| {
+                let windows = &mut p["platforms"]["windows"];
+                windows["min"] = "1.6.1".into();
+                windows["grace_until"] = "2026-11-30T15:00:00Z".into();
+            },
+            // a latest version lowered
+            |p| p["platforms"]["android_play"]["latest"] = "1.6.0".into(),
+            // a platform dropped
+            |p| {
+                p["platforms"].as_object_mut().unwrap().remove("ios");
+            },
+            |p| {
+                p["platforms"]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("android_play");
+            },
+            // a policy issued before the one it follows
+            |p| p["issued"] = "2026-11-01T23:59:59Z".into(),
+            // the same with a later deadline for an entry without one
+            |p| {
+                p["platforms"]["android_play"]["grace_until"] = "2027-01-01T00:00:00Z".into();
+                p["platforms"]["android_play"]["grace_min"] = "0.0.0".into();
+            },
+        ];
+        for (n, change) in relaxations.into_iter().enumerate() {
+            let p = policy_with(1, 8, change);
+            let why = if n == 9 {
+                Reject::Issued
+            } else {
+                Reject::Relaxation
+            };
+            assert_eq!(
+                refused(&a, &envelope(1, &SIGNING_1, &p, None)),
+                why,
+                "case {n}"
+            );
+            assert_eq!(refused(&a, &root_signed(&p)), why, "root, case {n}");
+            assert_eq!(
+                refused(&a, &envelope(102, &ROOT_2, &p, None)),
+                why,
+                "102, case {n}"
+            );
+            // by a declaration (a new epoch whose base is that policy's), any of them is taken
+            let mut relaxed: serde_json::Value = serde_json::from_str(&p).unwrap();
+            relaxed["epoch"] = 2.into();
+            relaxed["seq"] = 1.into();
+            let issued = relaxed["issued"].as_str().unwrap().to_owned();
+            let platforms = relaxed["platforms"].clone();
+            let mut base = serde_json::Map::new();
+            for (name, entry) in platforms.as_object().unwrap() {
+                if name == "later" {
+                    continue;
+                }
+                let mut req = serde_json::Map::new();
+                for member in ["min", "latest", "grace_until", "grace_min"] {
+                    if let Some(value) = entry.get(member) {
+                        req.insert(member.to_owned(), value.clone());
+                    }
+                }
+                base.insert(name.clone(), req.into());
+            }
+            let declaration = declaration(2, &[], &serde_json::Value::from(base).to_string())
+                .replace("2026-11-02T00:00:00Z", &issued);
+            let body = envelope(
+                2,
+                &SIGNING_2,
+                &relaxed.to_string(),
+                Some(&root_part(&ROOT, &declaration)),
+            );
+            assert_eq!(seq(&taken(&a, &body)), Some((2, 1)), "declared, case {n}");
+        }
+    }
+
+    /// (나): a new Android entry asks at least what its sibling asks, as the PC holds Android
+    /// controllers to the lower of the two.
+    #[test]
+    fn a_new_android_entry_asks_what_its_sibling_asks() {
+        let without_play = policy_with(1, 7, |p| {
+            p["platforms"]
+                .as_object_mut()
+                .unwrap()
+                .remove("android_play");
+        });
+        let a = taken(
+            &Trust::default(),
+            &envelope(1, &SIGNING_1, &without_play, None),
+        );
+        let with_play = |play: serde_json::Value| {
+            let p = policy_with(1, 8, |p| p["platforms"]["android_play"] = play);
+            envelope(1, &SIGNING_1, &p, None)
+        };
+        let android = |p: &str| -> serde_json::Value {
+            serde_json::from_str::<serde_json::Value>(&policy_text(1, 7)).unwrap()["platforms"][p]
+                .clone()
+        };
+        let mut level = android("android");
+        level.as_object_mut().unwrap().remove("package");
+        level.as_object_mut().unwrap().remove("move_to_play");
+        assert_eq!(seq(&taken(&a, &with_play(level.clone()))), Some((1, 8)));
+        let mut later = level.clone();
+        later["grace_until"] = "2026-11-30T15:00:00Z".into();
+        assert_eq!(refused(&a, &with_play(later)), Reject::Relaxation);
+        let below = serde_json::json!({"min": "1.0.0", "latest": "1.6.1"});
+        assert_eq!(refused(&a, &with_play(below)), Reject::Relaxation);
+        // the Play entry of the vectors (1.5.0 at once) asks no less than the APK's (1.5.0
+        // before the deadline, then 1.6.0) only until the deadline
+        assert_eq!(
+            refused(&a, &with_play(android("android_play"))),
+            Reject::Relaxation
+        );
+        let above = serde_json::json!({"min": "1.6.1", "latest": "1.6.1"});
+        assert_eq!(seq(&taken(&a, &with_play(above))), Some((1, 8)));
+        // and the other way round: a new APK entry beside the Play entry
+        let without_apk = policy_with(1, 7, |p| {
+            p["platforms"].as_object_mut().unwrap().remove("android");
+        });
+        let play = taken(
+            &Trust::default(),
+            &envelope(1, &SIGNING_1, &without_apk, None),
+        );
+        let with_apk = |apk: serde_json::Value| {
+            let p = policy_with(1, 8, |p| p["platforms"]["android"] = apk);
+            envelope(1, &SIGNING_1, &p, None)
+        };
+        let below = serde_json::json!({"min": "1.0.0", "latest": "1.6.1"});
+        assert_eq!(refused(&play, &with_apk(below)), Reject::Relaxation);
+        let level = serde_json::json!({"min": "1.5.0", "latest": "1.6.1"});
+        assert_eq!(seq(&taken(&play, &with_apk(level))), Some((1, 8)));
+    }
+
+    /// The later of the two signed parts is enforced: a declaration taken alone lifts a forged
+    /// strict policy of a stolen key at once.
+    #[test]
+    fn a_forged_minimum_is_undone_by_a_declaration() {
+        let a = at_1_7();
+        let forged = policy_with(1, 8, |p| {
+            for entry in ["windows", "android", "android_play", "ios"] {
+                let entry = p["platforms"][entry].as_object_mut().unwrap();
+                entry.insert("min".to_owned(), "99.0.0".into());
+                entry.insert("latest".to_owned(), "99.0.0".into());
+                entry.remove("grace_until");
+                entry.remove("grace_min");
+            }
+        });
+        let hit = taken(&a, &envelope(1, &SIGNING_1, &forged, None));
+        assert_eq!(windows_min(hit.effective()), Some("99.0.0"));
+        // key 2's honest policy would lower the forged minimum: refused without a declaration
+        let honest = envelope(2, &SIGNING_2, &policy_text(1, 9), None);
+        assert_eq!(refused(&hit, &honest), Reject::Relaxation);
+        // the declaration that revokes key 1, even with a policy that does not get through
+        let alone = with_root(&SIGNING_1, &policy_text(2, 1), 2, &[1]);
+        let (_, kept) = refused_declared(&hit, &alone);
+        assert_eq!(windows_min(kept.effective()), Some("1.6.0"));
+        assert_eq!(seq(&taken(&kept, &declared(2, 1, &[1]))), Some((2, 1)));
+        // and with its policy
+        let healed = taken(&hit, &declared(2, 1, &[1]));
+        assert_eq!(windows_min(healed.effective()), Some("1.6.0"));
+        // a device that never saw the forgery takes it as it is
+        assert_eq!(seq(&taken(&a, &declared(2, 1, &[1]))), Some((2, 1)));
+        // a declaration of a later epoch taken alone lifts a held policy of the epoch before,
+        // whoever signed it: key 2 is not revoked, and its policy is still not enforced
+        let b = taken(&a, &declared(2, 1, &[1]));
+        let root = root_part(&ROOT, &root_text(3, &[1]));
+        let alone = envelope(2, &SIGNING_1, &policy_text(3, 1), Some(&root));
+        let (_, kept) = refused_declared(&b, &alone);
+        assert_eq!(kept.held.as_ref().map(|held| held.k), Some(2));
+        let base = &kept.decl.as_ref().unwrap().declaration.base;
+        assert_eq!(kept.effective(), Some(base));
+        assert_eq!(kept.basis(pins().floor), Some(base));
+        assert!(!kept.may_install(pins().floor));
+    }
+
+    /// A policy is compared with the base of a declaration held without a policy of its epoch:
+    /// also its time.
+    #[test]
+    fn the_base_is_the_basis_until_a_policy_of_its_epoch() {
+        let fresh = Trust::default();
+        // a declaration whose base asks for 1.6.1 on Windows
+        let strict = BASE.replacen(
+            r#""windows":{"min":"1.6.0","latest":"1.6.1""#,
+            r#""windows":{"min":"1.6.1","latest":"1.6.1""#,
+            1,
+        );
+        let strict = strict.replacen(
+            r#","grace_until":"2026-11-16T15:00:00Z","grace_min":"1.5.0"}"#,
+            "}",
+            1,
+        );
+        let root = root_part(&ROOT, &declaration(2, &[], &strict));
+        let below = envelope(2, &SIGNING_2, &policy_text(2, 1), Some(&root));
+        let (why, kept) = refused_declared(&fresh, &below);
+        assert_eq!(why, Reject::Relaxation);
+        assert_eq!(windows_min(kept.effective()), Some("1.6.1"));
+        // a policy issued before the declaration
+        let root = root_part(&ROOT, &root_text(2, &[]));
+        let early = policy_with(2, 1, |p| p["issued"] = "2026-11-01T00:00:00Z".into());
+        let early = envelope(2, &SIGNING_2, &early, Some(&root));
+        assert_eq!(refused_declared(&fresh, &early).0, Reject::Issued);
+        // the same text as the base is taken, and is the basis from then on
+        let at_base = envelope(2, &SIGNING_2, &policy_text(2, 1), Some(&root));
+        let b = taken(&fresh, &at_base);
+        assert_eq!(
+            b.basis(pins().floor),
+            Some(&b.held.as_ref().unwrap().policy)
+        );
+    }
+
+    /// A held policy whose signer its own declaration revokes (only a crafted record holds one)
+    /// is not enforced: the base is.
+    #[test]
+    fn a_revoked_signers_policy_is_not_enforced() {
+        let b = taken(&at_1_7(), &declared(2, 1, &[1]));
+        let mut crafted = b.clone();
+        crafted.held.as_mut().unwrap().k = 1;
+        let base = &crafted.decl.as_ref().unwrap().declaration.base;
+        assert_eq!(crafted.effective(), Some(base));
+        assert!(!crafted.may_install(pins().floor));
+        assert!(b.may_install(pins().floor));
+    }
+
+    fn requirement(min: &str, until: Option<i64>, grace_min: Option<&str>) -> Entry {
+        let min = super::super::policy::Version::parse(min).unwrap();
+        Entry {
+            latest: min.clone(),
+            min,
+            grace_until: until,
+            grace_min: grace_min.map(|v| super::super::policy::Version::parse(v).unwrap()),
+            os_min: None,
+            notes: None,
+            source: None,
+            package: None,
+            auto_install_after: None,
+            move_to_play: false,
+        }
+    }
+
+    /// COVERS is exactly "asks no less at every time" (INV-1), on every pair of entries over a
+    /// few versions and two deadlines.
+    #[test]
+    fn covers_is_exact() {
+        let versions = ["0.0.0", "1.5.0", "1.6.0", "1.6.1"];
+        let (t1, t2) = (GRACE, GRACE + 7 * 86_400);
+        let mut entries = Vec::new();
+        for (i, min) in versions.iter().enumerate() {
+            entries.push(requirement(min, None, None));
+            for until in [t1, t2] {
+                for grace_min in &versions[..i] {
+                    entries.push(requirement(min, Some(until), Some(grace_min)));
+                }
+            }
+        }
+        assert_eq!(entries.len(), 16);
+        let times = [i64::MIN, t1 - 1, t1, t2 - 1, t2, i64::MAX];
+        for n in &entries {
+            for o in &entries {
+                let pointwise = times
+                    .iter()
+                    .all(|t| verdict::threshold(n, *t) >= verdict::threshold(o, *t));
+                assert_eq!(covers(n, o), pointwise, "{n:?} {o:?}");
+            }
+        }
+    }
+}
