+    /// The JSON rules of the trust rules (2-2): one object, every member of its kind, a known
+    /// member once, unknown members skipped at every level.
+    #[test]
+    fn the_json_of_a_policy() {
+        let text = policy_text(1, 7);
+        let refused = |from: &str, to: &str| {
+            assert!(text.contains(from), "{from}");
+            parse_policy(&text.replacen(from, to, 1))
+        };
+        for (from, to) in [
+            (r#""seq":7"#, r#""seq":7.0"#),
+            (r#""seq":7"#, r#""seq":-7"#),
+            (r#""seq":7"#, r#""seq":-0"#),
+            (r#""seq":7"#, r#""seq":7e0"#),
+            (r#""seq":7"#, r#""seq":18446744073709551616"#),
+            (r#""seq":7"#, r#""seq":true"#),
+            (r#""seq":7"#, r#""seq":null"#),
+            (r#""seq":7"#, r#""seq":7,"seq":8"#),
+            (r#""epoch":1"#, r#""epoch":1,"epoch":1"#),
+            // a known member twice in an entry and in a package
+            (r#""min":"1.6.0""#, r#""min":"1.5.0","min":"1.6.0""#),
+            (r#""size":26214400"#, r#""size":26214400,"size":26214400"#),
+            (
+                r#""grace_min":"1.5.0""#,
+                r#""grace_min":"1.5.0","grace_min":"1.5.0""#,
+            ),
+            // objects are objects
+            (r#""platforms":{"#, r#""platforms":[],"x":{"#),
+            (
+                r#""android_play":{"min":"1.5.0","latest":"1.6.1","version_code":263052251}"#,
+                r#""android_play":["1.5.0","1.6.1"]"#,
+            ),
+            (r#""package":{"file""#, r#""package":["x"],"y":{"file""#),
+            // a lone surrogate in a member that is read, raw control characters, bad escapes
+            (r#""contact_ko":""#, r#""contact_ko":"\ud800"#),
+            (r#""contact_ko":""#, r#""contact_ko":"\udc00"#),
+            (r#""contact_ko":""#, "\"contact_ko\":\"\u{1}"),
+            (r#""contact_ko":""#, r#""contact_ko":"\x"#),
+            (r#""notes_ko":""#, r#""notes_ko":"\uD83D"#),
+            // and in a member name
+            (r#""server""#, r#""\ud800":1,"server""#),
+            // what comes after the object
+            (
+                r#""testflight_build":"263050249"}}}"#,
+                r#""testflight_build":"263050249"}}}{}"#,
+            ),
+        ] {
+            assert_eq!(refused(from, to), Err(Reject::Field("json")), "{to}");
+        }
+        // unknown members are skipped, twice or not, with a lone surrogate in their value
+        for (from, to) in [
+            (r#""seq":7"#, r#""seq":7,"x":1,"x":2"#),
+            (r#""seq":7"#, r#""seq":7,"x":"\ud800""#),
+            (r#""seq":7"#, r#""seq":7,"x":{"y":"\udfff","y":["\ud800"]}"#),
+            (r#""min":"1.6.0""#, r#""min":"1.6.0","later":"\udbff""#),
+            (
+                r#""size":26214400"#,
+                r#""size":26214400,"later":"\ud800","later":2"#,
+            ),
+            // whitespace around the object, and a pair of surrogates where a text is read
+            (r#""contact_ko":""#, r#""contact_ko":"😀"#),
+            (r#"{"v":1"#, " \n\t{\"v\":1"),
+        ] {
+            let read = refused(from, to);
+            assert!(read.is_ok(), "{to}: {read:?}");
+        }
+        assert_eq!(parse_policy(&format!("{text}\n ")).map(|p| p.seq), Ok(7));
+    }
