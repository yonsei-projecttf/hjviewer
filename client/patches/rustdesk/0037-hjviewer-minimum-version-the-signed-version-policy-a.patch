+        );
+        assert_eq!(
+            refused(&fresh, &envelope(2, &SIGNING_1, &p, None)),
+            Reject::BadSignature
+        );
+        // a signing key's or the other root key's signature under a root key's number
+        for (k, by) in [(101, &SIGNING_1), (101, &ROOT_2), (102, &ROOT)] {
