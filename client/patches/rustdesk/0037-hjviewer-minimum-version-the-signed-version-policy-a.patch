+    #[test]
+    fn the_clock_of_the_policy() {
+        let file = TempFile::new("clock", store::FILE);
+        let mut core = open(&file, Os::Windows);
+        let date = |date: &str, body: &str, status| {
+            Ok(Reply {
+                status,
+                date: Some(date.to_owned()),
+                body: body.as_bytes().to_vec(),
+            })
+        };
+        // the device runs 40 days ahead of the server: the grace period still holds
+        let fast = (ISSUED + 40 * 86_400) as u64;
+        let answer = date("Mon, 02 Nov 2026 00:00:00 GMT", &signed_1(1, 7), 200);
+        assert_eq!(
+            checked(&mut core, Kind::Regular, 0, fast as i64, answer),
+            Outcome::Updated
+        );
+        assert_eq!(core.kept.server_offset, Some(-40 * 86_400));
+        assert_eq!(core.now(fast), ISSUED);
+        assert_eq!(core.state(number("1.5.1"), fast), State::Grace);
+        assert_eq!(core.now(fast + 3600), ISSUED + 3600);
+        // a server that claims the far future: not believed
+        let lie = date("Sat, 02 Nov 2086 00:00:00 GMT", &signed_1(1, 7), 200);
+        let wall = ISSUED as u64 + 60;
+        assert_eq!(
+            checked(&mut core, Kind::Regular, 60, wall as i64, lie),
+            Outcome::Unchanged
+        );
+        assert!(core.kept.server_offset.unwrap() > 86_400);
+        assert_eq!(core.now(wall), wall as i64);
+        assert_eq!(core.state(number("1.5.1"), wall), State::Grace);
+        // no Date: the device's clock
+        let plain = reply(200, &signed_1(1, 7));
+        assert_eq!(
+            checked(&mut core, Kind::Regular, 120, wall as i64, plain),
+            Outcome::Unchanged
+        );
+        assert_eq!(core.kept.server_offset, None);
+        // a device set back before the policy was issued is held to the day it was issued
+        assert_eq!(core.now(0), ISSUED);
+        // a rejected answer's Date changes nothing, nor does a 304's
+        let bad = date("Mon, 02 Nov 2026 00:00:00 GMT", &signed_1(1, 6), 200);
+        let outcome = checked(&mut core, Kind::Regular, 180, fast as i64, bad);
+        assert_eq!(outcome, Outcome::Rejected(trust::Reject::Rollback));
+        let not_modified = date("Mon, 02 Nov 2026 00:00:00 GMT", "", 304);
+        let outcome = checked(&mut core, Kind::Immediate, 190, fast as i64, not_modified);
+        assert_eq!(outcome, Outcome::Failed(FetchError::Status(304)));
+        assert_eq!(core.kept.server_offset, None);
+        assert_eq!(core.state(number("1.5.1"), fast), State::Required);
+    }
