+    /// The procedure for a broken update path: a declaration lowers the minimum, also of apps
+    /// that were blocked, and after the repair a signing key raises it again.
+    #[test]
+    fn a_relaxation_is_a_declaration() {
+        let file = TempFile::new("relax", store::FILE);
+        let mut core = open(&file, Os::Windows);
+        let late = GRACE + 1;
+        checked(
+            &mut core,
+            Kind::Regular,
+            0,
+            late,
+            reply(200, &signed_1(1, 7)),
+        );
+        assert_eq!(core.state(number("1.5.1"), late as u64), State::Required);
+        let lower = |epoch, seq| {
+            policy_with(epoch, seq, |p| {
+                let windows = p["platforms"]["windows"].as_object_mut().unwrap();
+                windows.insert("min".to_owned(), "1.5.0".into());
+                windows.remove("grace_until");
+                windows.remove("grace_min");
+            })
+        };
+        // neither a signing key nor a root key relaxes by a policy
+        for (k, key) in [(1, &SIGNING_1), (101, &ROOT), (102, &ROOT_2)] {
+            let body = envelope(k, key, &lower(1, 8), None);
+            assert_eq!(
+                checked(
+                    &mut core,
+                    Kind::Immediate,
+                    60 * u64::from(k),
+                    late,
+                    reply(200, &body)
+                ),
+                Outcome::Rejected(trust::Reject::Relaxation)
+            );
+        }
+        // a declaration whose base is the relaxed policy's requirements
+        let base = BASE.replacen(
+            r#""windows":{"min":"1.6.0","latest":"1.6.1","grace_until":"2026-11-16T15:00:00Z","grace_min":"1.5.0"}"#,
+            r#""windows":{"min":"1.5.0","latest":"1.6.1"}"#,
+            1,
+        );
+        let root = root_part(&ROOT_2, &declaration(2, &[], &base));
+        let relaxed = envelope(2, &SIGNING_2, &lower(2, 1), Some(&root));
+        assert_eq!(
+            checked(&mut core, Kind::Immediate, 7000, late, reply(200, &relaxed)),
+            Outcome::Updated
+        );
+        assert_eq!(core.state(number("1.5.1"), late as u64), State::Available);
+        // after the repair key 2 raises it again, at once
+        let raised = policy_with(2, 2, |p| {
+            let windows = p["platforms"]["windows"].as_object_mut().unwrap();
+            windows.remove("grace_until");
+            windows.remove("grace_min");
+        });
+        let again = envelope(2, &SIGNING_2, &raised, Some(&root));
+        assert_eq!(
+            checked(&mut core, Kind::Immediate, 7060, late, reply(200, &again)),
+            Outcome::Updated
+        );
+        assert_eq!(core.state(number("1.5.1"), late as u64), State::Required);
+    }
