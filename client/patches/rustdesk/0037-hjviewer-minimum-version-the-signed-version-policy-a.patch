+        // B: root key 101 declares epoch 2 and revokes key 1; key 2 signs the epoch's policy
+        let body = declared(2, 1, &[1]);
+        let b = taken(&a, &body);
+        assert_eq!(seq(&b), Some((2, 1)));
+        assert_eq!(b.revoked(), [1]);
+        let decl = b.decl.as_ref().unwrap();
+        assert_eq!((decl.part.k, decl.declaration.epoch), (101, 2));
+        assert_eq!(decl.part.p, root_text(2, &[1]));
+        assert_eq!(b.held.as_ref().unwrap().envelope, body);
+        assert_eq!(b.epoch(pins().floor), 2);
