@@ -0,0 +1,662 @@
+//! What the app keeps between runs (trust rules 1-6): the declaration it holds and the envelope of
+//! the policy it holds, both as they were received, and when the server last answered and how far
+//! its clock was from the device's.
+//!
+//! Nothing read from the file is believed as it stands. Every signed part is checked again at
+//! every start, under the keys of the build that reads it, whichever build wrote it: a part that
+//! does not hold is dropped alone, and a record that keeps nothing is a fresh start. Of two
+//! processes that write the file, the record that holds the later declaration, then the later
+//! policy of its epoch, stays.
+
+use super::{
+    policy::{self, Object, RawSigned},
+    trust::{self, Declared, Pinned, Trust},
+};
+use hbb_common::base64::{engine::general_purpose::STANDARD, Engine as _};
+use serde::de::IgnoredAny;
+use serde_derive::{Deserialize, Serialize};
+use std::path::{Path, PathBuf};
+
+/// In the configuration folder of the process (Config::path). On an installed Windows PC the app
+/// and the service each fetch the policy and keep their own record.
+pub(crate) const FILE: &str = "HJViewer_update.json";
+/// Well above any record: an envelope is at most 16 KiB.
+const MAX_FILE: u64 = 64 * 1024;
+const VERSION: u64 = 2;
+
+/// The five members a record must have, `null` or not.
+#[derive(Deserialize)]
+#[allow(dead_code)]
+struct Members {
+    root: IgnoredAny,
+    envelope: IgnoredAny,
+    checked_at: IgnoredAny,
+    server_offset: IgnoredAny,
+}
+
+/// Their kinds: `root` null or an object, `envelope` null or a string, `checked_at` an integer,
+/// `server_offset` null or an integer.
+#[derive(Deserialize)]
+struct Record {
+    #[serde(default)]
+    #[allow(dead_code)]
+    root: Option<Object<IgnoredAny>>,
+    #[serde(default)]
+    envelope: Option<String>,
+    checked_at: u64,
+    #[serde(default)]
+    server_offset: Option<i64>,
+}
+
+/// The record's root part, read on its own: a part that does not keep its rules drops the
+/// declaration alone.
+#[derive(Deserialize)]
+struct RecordRoot {
+    #[serde(default)]
+    root: Option<Object<RawSigned>>,
+}
+
+#[derive(Serialize)]
+struct Written<'a> {
+    v: u64,
+    root: Option<WrittenPart<'a>>,
+    envelope: Option<&'a str>,
+    checked_at: u64,
+    server_offset: Option<i64>,
+}
+
+#[derive(Serialize)]
+struct WrittenPart<'a> {
+    k: u16,
+    p: &'a str,
+    s: String,
+}
+
+/// What a process holds and keeps.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub(crate) struct Kept {
+    pub trust: Trust,
+    /// when the server last answered with a policy this app holds, by the device's clock
+    pub checked_at: u64,
+    /// the server's `Date` minus the device's clock at that answer
+    pub server_offset: Option<i64>,
+}
+
+/// L1-L5 of the trust rules for the record's text; None for a fresh start.
+fn read_record(pinned: &Pinned, text: &str) -> Option<Kept> {
+    // L1: the record's form
+    if policy::version_of(text)? != VERSION {
+        return None;
+    }
+    policy::object::<Members>(text)?;
+    let record: Record = policy::object(text)?;
+    // L2: the declaration, under this build's root keys
+    let decl = policy::object::<RecordRoot>(text)
+        .and_then(|root| root.root)
+        .and_then(|Object(root)| root.signed())
+        .and_then(|part| {
+            let declaration = trust::check_root(pinned, &part).ok()?;
+            Some(Declared { part, declaration })
+        });
+    // L3: the policy, under this build's keys, whether or not its signer is revoked
+    let held = record
+        .envelope
+        .and_then(|envelope| trust::check_alone(pinned, &envelope))
+        .filter(|(held, root)| {
+            // L4: the policy and the declarations hold together
+            let epoch = held.policy.epoch;
+            match (epoch, root, &decl) {
+                (1, None, _) => true,
+                (1, Some(_), _) | (_, None, _) | (_, _, None) => false,
+                (_, Some((root_epoch, root_p)), Some(decl)) => {
+                    let held_epoch = decl.declaration.epoch;
+                    *root_epoch == epoch
+                        && held_epoch >= epoch
+                        && (held_epoch > epoch || decl.part.p == *root_p)
+                }
+            }
+        })
+        .map(|(held, _)| held);
+    // L5: nothing kept is a fresh start
+    if decl.is_none() && held.is_none() {
+        return None;
+    }
+    Some(Kept {
+        trust: Trust { decl, held },
+        checked_at: record.checked_at,
+        server_offset: record.server_offset,
+    })
+}
+
+fn read(pinned: &Pinned, path: &Path) -> Option<Kept> {
+    if std::fs::metadata(path).ok()?.len() > MAX_FILE {
+        return None;
+    }
+    let bytes = std::fs::read(path).ok()?;
+    read_record(pinned, std::str::from_utf8(&bytes).ok()?)
+}
+
+/// The record, part by part as this build can verify it, or a fresh start: nothing held, never
+/// checked.
+pub(crate) fn load(pinned: &Pinned, path: &Path) -> Kept {
+    read(pinned, path).unwrap_or_else(|| {
+        if path.exists() {
+            hbb_common::log::warn!(
+                "version policy: the stored record holds nothing this build can verify; starting anew"
+            );
+        }
+        Kept::default()
+    })
+}
+
+/// RANK: the declaration's epoch, then the sequence number of a held policy of that epoch, then
+/// whether a policy is held at all.
+fn rank(trust: &Trust) -> (u64, u64, bool) {
+    let epoch = trust.declared_epoch();
+    let seq = trust
+        .held
+        .as_ref()
+        .filter(|held| held.policy.epoch == epoch)
+        .map_or(0, |held| held.policy.seq);
+    (epoch, seq, trust.held.is_some())
+}
+
+/// Writes the record, unless the file holds one of a greater RANK by this build's reading:
+/// another process of this user got further, and its record stays. What this process holds does
+/// not change either way.
+pub(crate) fn save(pinned: &Pinned, path: &Path, kept: &Kept) -> std::io::Result<()> {
+    let trust = &kept.trust;
+    if trust.decl.is_none() && trust.held.is_none() {
+        return Ok(());
+    }
+    if read(pinned, path).is_some_and(|theirs| rank(&theirs.trust) > rank(trust)) {
+        return Ok(());
+    }
+    let record = Written {
+        v: VERSION,
+        root: trust.decl.as_ref().map(|decl| WrittenPart {
+            k: decl.part.k,
+            p: &decl.part.p,
+            s: STANDARD.encode(decl.part.sig),
+        }),
+        envelope: trust.held.as_ref().map(|held| held.envelope.as_str()),
+        checked_at: kept.checked_at,
+        server_offset: kept.server_offset,
+    };
+    write_private(
+        path,
+        &serde_json::to_vec(&record).map_err(std::io::Error::other)?,
+    )
+}
+
+/// Replaces `path` at once, by a new file renamed over it; on Unix only its owner reads it. The
+/// new file is this process's own, so that two processes writing at once do not write into one.
+fn write_private(path: &Path, data: &[u8]) -> std::io::Result<()> {
+    use std::io::Write;
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let mut tmp = path.as_os_str().to_owned();
+    tmp.push(format!(".{}.tmp", std::process::id()));
+    let tmp = PathBuf::from(tmp);
+    // a leftover from a write of this process that did not finish
+    std::fs::remove_file(&tmp).ok();
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    let mut file = options.open(&tmp)?;
+    file.write_all(data)?;
+    file.sync_all()?;
+    drop(file);
+    std::fs::rename(&tmp, path)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{
+        super::{
+            trust::{accept, Outcome, Position},
+            vectors::*,
+        },
+        *,
+    };
+    use serde_json::{json, Value};
+
+    fn taken(pinned: &Pinned, trust: &Trust, body: &str) -> Trust {
+        let (after, outcome) = accept(pinned, trust, body.as_bytes());
+        assert_eq!(outcome, Outcome::Taken, "{body}");
+        after
+    }
+
+    fn kept(trust: Trust) -> Kept {
+        Kept {
+            trust,
+            checked_at: 1_794_000_000,
+            server_offset: Some(-7),
+        }
+    }
+
+    /// The states of the vectors: A (1, 7), B (epoch 2 declared, key 1 revoked, (2, 1) by key 2).
+    fn state_a(pinned: &Pinned) -> Trust {
+        taken(pinned, &Trust::default(), &signed_1(1, 7))
+    }
+
+    fn state_b(pinned: &Pinned) -> Trust {
+        taken(pinned, &state_a(pinned), &declared(2, 1, &[1]))
+    }
+
+    /// A held (2, 1) and the declaration of epoch 3 taken alone: its policy did not get through.
+    fn declared_alone(pinned: &Pinned) -> Trust {
+        let root = root_part(&ROOT, &root_text(3, &[1]));
+        let unsigned = envelope(2, &SIGNING_1, &policy_text(3, 1), Some(&root));
+        let (after, outcome) = accept(pinned, &state_b(pinned), unsigned.as_bytes());
+        assert_eq!(
+            outcome,
+            Outcome::Refused(super::super::trust::Reject::BadSignature)
+        );
+        after
+    }
+
+    fn record(path: &Path) -> Value {
+        serde_json::from_slice(&std::fs::read(path).unwrap()).unwrap()
+    }
+
+    fn edit(path: &Path, change: impl FnOnce(&mut Value)) {
+        let mut value = record(path);
+        change(&mut value);
+        std::fs::write(path, value.to_string()).unwrap();
+    }
+
+    #[test]
+    fn a_record_comes_back_as_it_was_kept() {
+        let (pinned, file) = (pins(), TempFile::new("round", FILE));
+        // nothing there: a fresh start
+        assert_eq!(load(&pinned, &file.0), Kept::default());
+        // nothing held: nothing to write
+        save(&pinned, &file.0, &Kept::default()).unwrap();
+        assert!(!file.0.exists());
+        for (n, trust) in [
+            state_a(&pinned),
+            state_b(&pinned),
+            declared_alone(&pinned),
+            taken(&pinned, &Trust::default(), &declared(2, 2, &[1])),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let file = TempFile::new("round", FILE);
+            let kept = kept(trust);
+            save(&pinned, &file.0, &kept).unwrap();
+            assert_eq!(load(&pinned, &file.0), kept, "state {n}");
+            #[cfg(unix)]
+            {
