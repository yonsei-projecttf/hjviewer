+        assert_eq!(link.file, "HJViewer-1.6.1-install.exe");
+        assert_eq!(link.expires_in, 600);
+        assert!(parse_link(SERVER, answer("/api/hjv/u/0000-ZZZZ").as_bytes()).is_some());
+        for bad in [
+            "",
+            "https://evil.example/api/hjv/u/K7M2-Q9XD",
+            "//evil.example/api/hjv/u/K7M2-Q9XD",
+            "/api/hjv/u/K7M2-Q9XD/",
+            "/api/hjv/u/K7M2-Q9XD?next=https://evil.example",
+            "/api/hjv/u/K7M2-Q9XD#x",
+            "/api/hjv/u/K7M2Q9XD",
+            "/api/hjv/u/K7M2-Q9X",
+            "/api/hjv/u/K7M2-Q9XDA",
+            "/api/hjv/u/k7m2-q9xd",
+            // the letters the code never has
+            "/api/hjv/u/I7M2-Q9XD",
+            "/api/hjv/u/K7L2-Q9XD",
+            "/api/hjv/u/K7M2-O9XD",
+            "/api/hjv/u/K7M2-Q9UD",
+            "/api/hjv/u/K7M2_Q9XD",
+            "/api/hjv/u/K7M2-Q9X가",
+            "/api/hjv/get/K7M2-Q9XD",
+            "/api/hjv/u/../u/K7M2-Q9XD",
+            " /api/hjv/u/K7M2-Q9XD",
+            "@evil.example/api/hjv/u/K7M2-Q9XD",
+        ] {
+            assert_eq!(parse_link(SERVER, answer(bad).as_bytes()), None, "{bad:?}");
+        }
+        let with = |file: &str, expires_in: &str| {
+            let answer = format!(
+                r#"{{"url":"/api/hjv/u/K7M2-Q9XD","file":"{file}","expires_in":{expires_in}}}"#
+            );
+            parse_link(SERVER, answer.as_bytes())
+        };
+        assert!(with("HJViewer-1.6.1.exe", "1").is_some());
+        assert!(with("HJViewer-1.6.1-android-arm64.apk", "3600").is_some());
+        for (file, expires_in) in [
+            ("", "600"),
+            ("a b.exe", "600"),
+            ("../x.exe", "600"),
+            ("x.exe", "0"),
+            ("x.exe", "3601"),
+            ("x.exe", "-1"),
+            ("x.exe", "\"600\""),
+        ] {
+            assert_eq!(with(file, expires_in), None, "{file:?} {expires_in}");
+        }
+        assert_eq!(parse_link(SERVER, b""), None);
+        assert_eq!(
+            parse_link(SERVER, br#"{"url":"/api/hjv/u/K7M2-Q9XD"}"#),
+            None
+        );
+    }
+
+    fn package_of(data: &[u8]) -> Package {
+        Package {
+            file: "HJViewer-1.6.1-windows-x86_64.exe".to_owned(),
+            size: data.len() as u64,
+            sha256: Sha256::digest(data).into(),
+            build: None,
+        }
+    }
+
+    /// A reader that counts what was asked of it.
+    struct Counting<'a>(&'a [u8], usize);
+
+    impl Read for Counting<'_> {
+        fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+            let n = self.0.read(buffer)?;
+            self.1 += n;
+            Ok(n)
+        }
+    }
+
+    #[test]
+    fn a_package_is_believed_by_its_signed_size_and_hash() {
+        let data: Vec<u8> = (0..200_000u32).map(|i| (i % 251) as u8).collect();
+        let package = package_of(&data);
+        let mut out = Vec::new();
+        let mut steps = Vec::new();
+        receive(&mut &data[..], &package, &mut out, &mut |done| {
+            steps.push(done)
+        })
+        .unwrap();
+        assert_eq!(out, data);
+        assert_eq!(steps.last(), Some(&200_000));
+        assert!(steps.windows(2).all(|pair| pair[0] < pair[1]));
+
+        let take = |sent: &[u8], package: &Package| {
+            let mut reader = Counting(sent, 0);
+            let result = receive(&mut reader, package, &mut Vec::new(), &mut |_| {});
+            (result, reader.1)
+        };
+        // one changed byte
+        let mut changed = data.clone();
+        changed[100_000] ^= 1;
+        assert_eq!(take(&changed, &package).0, Err(Failure::Verify));
+        // a byte short, a byte long
+        assert_eq!(
+            take(&data[..data.len() - 1], &package).0,
+            Err(Failure::Verify)
+        );
+        let mut long = data.clone();
+        long.push(0);
+        assert_eq!(take(&long, &package).0, Err(Failure::Verify));
+        // however much is sent, one byte more than the size is all that is read
+        long.extend(vec![0u8; 5_000_000]);
+        assert_eq!(
+            take(&long, &package),
+            (Err(Failure::Verify), data.len() + 1)
+        );
+        // and nothing beyond the signed size is written
+        let mut out = Vec::new();
+        let result = receive(&mut &long[..], &package, &mut out, &mut |_| {});
+        assert_eq!(result, Err(Failure::Verify));
+        assert!(out.len() <= data.len(), "{}", out.len());
+        // the hash of other data of the same size
+        let other = package_of(&changed);
+        assert_eq!(take(&data, &other).0, Err(Failure::Verify));
+        assert_eq!(take(&changed, &other).0, Ok(()));
+        // nothing at all
+        assert_eq!(take(&[], &package).0, Err(Failure::Verify));
+    }
+
+    /// A connection that breaks, and a disk that is full.
+    #[test]
+    fn broken_transfers() {
+        struct Broken;
+        impl Read for Broken {
+            fn read(&mut self, _: &mut [u8]) -> std::io::Result<usize> {
+                Err(std::io::Error::other("reset"))
+            }
+        }
+        struct Full;
+        impl Write for Full {
+            fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+                Err(std::io::Error::other("full"))
+            }
+            fn flush(&mut self) -> std::io::Result<()> {
+                Ok(())
+            }
+        }
+        let data = [7u8; 1000];
+        let package = package_of(&data);
+        assert_eq!(
+            receive(&mut Broken, &package, &mut Vec::new(), &mut |_| {}),
+            Err(Failure::Network)
+        );
+        assert_eq!(
+            receive(&mut &data[..], &package, &mut Full, &mut |_| {}),
+            Err(Failure::File)
+        );
+    }
+
+    #[test]
+    fn a_package_file_is_new_checked_and_named_by_the_app() {
+        let data = vec![9u8; 70_000];
+        let plan = Plan {
+            platform: PackagePlatform::Android,
+            version: version("1.6.1"),
+            package: Package {
+                // the policy's name for it is not the file's name
+                file: "..".to_owned(),
+                ..package_of(&data)
+            },
+        };
+        let temp = TempFile::new("package", "HJViewer-1.6.1.apk");
+        let dir = temp.dir().join("updates");
+        // a file of that name that was there before is not what comes out
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join("HJViewer-1.6.1.apk"), b"planted").unwrap();
+        let path = store_package(&mut &data[..], &plan, &dir, &mut |_| {}).unwrap();
+        assert_eq!(path, dir.join("HJViewer-1.6.1.apk"));
+        assert_eq!(std::fs::read(&path).unwrap(), data);
+        // a file that fails the check does not stay, and neither does the good one before it
+        let mut changed = data.clone();
+        changed[0] ^= 1;
+        assert_eq!(
+            store_package(&mut &changed[..], &plan, &dir, &mut |_| {}),
+            Err(Failure::Verify)
+        );
+        assert!(!path.exists());
+        // a Windows package is an exe
+        let windows = Plan {
+            platform: PackagePlatform::Windows,
+            ..plan.clone()
+        };
+        let path = store_package(&mut &data[..], &windows, &dir, &mut |_| {}).unwrap();
+        assert_eq!(path, dir.join("HJViewer-1.6.1.exe"));
+        // only into a folder that is named in full
+        assert_eq!(
+            store_package(&mut &data[..], &plan, Path::new("updates"), &mut |_| {}),
+            Err(Failure::File)
+        );
+        assert_eq!(
+            store_package(&mut &data[..], &plan, Path::new(""), &mut |_| {}),
+            Err(Failure::File)
+        );
+    }
+
+    #[test]
+    fn failures_have_codes() {
+        let all = [
+            Failure::Login,
+            Failure::Network,
+            Failure::Tls,
+            Failure::Refused,
+            Failure::Missing,
+            Failure::Busy,
+            Failure::Http,
+            Failure::Verify,
+            Failure::File,
+        ];
+        assert_eq!(
+            all.map(Failure::code),
+            ["login", "network", "tls", "refused", "missing", "busy", "http", "verify", "file"]
+        );
+        assert_eq!(Job::failed(Failure::Verify).error, "verify");
+        assert_eq!(Job::failed(Failure::Verify).phase.name(), "error");
+        assert_eq!(Job::default().phase.name(), "idle");
+        assert_eq!(
+            [Phase::Downloading, Phase::Ready].map(Phase::name),
+            ["downloading", "ready"]
+        );
+    }
+
+    /// An answer that states another length than the signed size is refused before its body is
+    /// read; one that states none is read up to the size and a byte.
+    #[test]
+    fn the_stated_length_is_the_signed_size() {
+        let package = package_of(&[7u8; 1000]);
+        assert_eq!(announced(Some(1000), &package), Ok(()));
+        assert_eq!(announced(None, &package), Ok(()));
+        for length in [0, 999, 1001, u64::MAX] {
+            assert_eq!(
+                announced(Some(length), &package),
+                Err(Failure::Verify),
+                "{length}"
+            );
+        }
+    }
+}
