+
+/// HJV_UPDATE_PUBKEY and HJV_UPDATE_ROOT_PUBKEY of a build pinned to these keys.
+pub(crate) const HJV_UPDATE_PUBKEY: &str =
+    "1:JUO5L/EJVRFHatyDadtt3JM2ZaEZeN2hQE7hBmypVZ0=,2:zRSzf5VulTGU/3+3Oz2B3MVh1hp1OAlLfD4aZD7l86o=";
+pub(crate) const HJV_UPDATE_ROOT_PUBKEY: &str = "101:T9CZzNR9eJPf6ewkQU7LDZtUICMqrTDZHEZb4zy+ZcQ=,102:E9mQinCSWZLtVGAH0n9Q2mi6chfvYqw8ynhFKf8QRxw=";
+/// SHA-256("hjv-update-keys-v1" NUL server NUL signing keys NUL root keys) of that build, of one
+/// that pins root key 101 alone, and of one pinned to the first signing key and root key 101.
+pub(crate) const FINGERPRINT: &str =
+    "3d5fdc2ae12abd2dac598179aff56bdf121f60ea4089ba01dbef11f22399fb8b";
+pub(crate) const FINGERPRINT_ONE_ROOT: &str =
+    "6fb0ed8ff5085b36853973067ea623089cbc2422b783f8139326a35d659917cc";
+pub(crate) const FINGERPRINT_ONE_KEY: &str =
+    "f392c77f0104c6923bdd576f915c4729a9b1e7eebccb8c62f6564e2117dc0321";
+
+pub(crate) const SERVER: &str = "rd.example.com";
+/// 2026-11-02T00:00:00Z
+pub(crate) const ISSUED: i64 = 1_793_577_600;
+/// 2026-11-16T15:00:00Z, midnight of 17 November in Korea
+pub(crate) const GRACE: i64 = 1_794_841_200;
+pub(crate) const WINDOWS_SHA256: &str =
