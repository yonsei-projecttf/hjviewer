+pub(crate) fn seed(first: u8) -> [u8; 32] {
+    let mut seed = [0u8; 32];
+    for (i, b) in seed.iter_mut().enumerate() {
+        *b = first.wrapping_add(i as u8);
+    }
+    seed
+}
+
+pub(crate) fn secret_key(first: u8) -> sign::SecretKey {
+    let _ = hbb_common::sodiumoxide::init();
+    sign::keypair_from_seed(&sign::Seed(seed(first))).1
+}
+
+impl TestKey {
+    pub(crate) fn public(&self) -> [u8; 32] {
+        secret_key(self.seed).public_key().0
+    }
+
+    /// `<key number>:<base64>`, one entry of the build variables.
+    pub(crate) fn line(&self) -> String {
+        format!("{}:{}", self.id, STANDARD.encode(self.public()))
+    }
+
+    /// The signature of `context NUL text`, in base64.
+    pub(crate) fn sign(&self, context: &[u8], text: &str) -> String {
+        let mut message = context.to_vec();
+        message.push(0);
+        message.extend_from_slice(text.as_bytes());
+        STANDARD.encode(sign::sign_detached(&message, &secret_key(self.seed)).to_bytes())
+    }
+}
