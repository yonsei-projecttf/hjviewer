+        // the policy says this app must update: its update screen takes over
+        assert_eq!(core.refusal(refused, old, late, 1001), Some(verdict::R1));
+        // the policy was just checked and asks no update of this app: the two disagree
+        assert_eq!(core.refusal(refused, new, late, 1001), Some(verdict::R2));
+        assert_eq!(
+            core.refusal(refused, new, late, 1000 + verdict::REFUSAL_FRESH),
+            Some(verdict::R2)
+        );
+        // later the app checks again first
+        assert_eq!(
+            core.refusal(refused, new, late, 1001 + verdict::REFUSAL_FRESH),
+            Some(verdict::R1)
+        );
+        // a failed check is no check
+        core.begin(Kind::Immediate, 5000).unwrap();
+        core.finish(Err(FetchError::Network), late, 5000, 0);
+        assert_eq!(core.refusal(refused, new, late, 5001), Some(verdict::R1));
+        assert_eq!(core.refusal("Offline", new, late, 5001), None);
+    }
+
+    #[test]
+    fn what_a_download_gets() {
+        let file = TempFile::new("plan", store::FILE);
+        let mut core = open(&file, Os::Windows);
+        assert_eq!(
+            core.download_plan(number("1.5.1")),
+            Err(door::Failure::Missing)
+        );
+        checked(
+            &mut core,
+            Kind::Regular,
+            0,
+            ISSUED,
+            reply(200, &signed_1(1, 7)),
+        );
+        let plan = core.download_plan(number("1.5.1")).unwrap();
+        assert_eq!(plan.platform, door::PackagePlatform::Windows);
+        assert_eq!(plan.version.as_str(), "1.6.1");
+        assert_eq!(hex::encode(plan.package.sha256), WINDOWS_SHA256);
+        assert_eq!(plan.package.size, 26_214_400);
+        assert!(core.download_plan(number("1.6.0")).is_ok());
+        // nothing at or below the app's own version
+        assert_eq!(
+            core.download_plan(number("1.6.1")),
+            Err(door::Failure::Missing)
+        );
+        assert_eq!(
+            core.download_plan(number("1.7.0")),
+            Err(door::Failure::Missing)
+        );
+        // nothing while the app may not install: a build whose floor is above the policy
+        let kept = core.take_unsaved().unwrap();
+        store::save(&core.build, &core.path, &kept).unwrap();
+        let later = Core::open(pins_with_floor("1:8"), file.0.clone(), Os::Windows, false);
+        assert_eq!(later.policy().map(|p| p.seq), Some(7));
+        assert_eq!(
+            later.download_plan(number("1.5.1")),
+            Err(door::Failure::Missing)
+        );
+        // nor from a policy whose package was withdrawn
+        let withdrawn = policy_with(1, 8, |p| {
+            let windows = p["platforms"]["windows"].as_object_mut().unwrap();
+            windows.remove("package");
+            windows.remove("auto_install_after");
+        });
+        let body = envelope(1, &SIGNING_1, &withdrawn, None);
+        assert_eq!(
+            checked(&mut core, Kind::Immediate, 60, ISSUED, reply(200, &body)),
+            Outcome::Updated
+        );
+        assert_eq!(
+            core.download_plan(number("1.5.1")),
+            Err(door::Failure::Missing)
+        );
+        assert_eq!(
+            core.state_json(&LOCAL, ISSUED as u64)["package"],
+            Value::Null
+        );
+        // Android from a file has a package; from Play, and before the screen said, none
+        let mut android = Core::open(pins(), file.0.clone(), Os::Android, false);
+        android.kept = store::Kept::default();
+        checked(
+            &mut android,
+            Kind::Regular,
+            0,
+            ISSUED,
+            reply(200, &signed_1(1, 7)),
+        );
+        assert_eq!(
+            android.download_plan(number("1.5.1")),
+            Err(door::Failure::Missing)
+        );
+        android.set_device(r#"{"installer":""}"#);
+        let plan = android.download_plan(number("1.5.1")).unwrap();
+        assert_eq!(plan.platform, door::PackagePlatform::Android);
+        assert_eq!(hex::encode(plan.package.sha256), ANDROID_SHA256);
+        android.set_device(r#"{"installer":"com.android.vending"}"#);
+        assert_eq!(
+            android.download_plan(number("1.5.1")),
+            Err(door::Failure::Missing)
+        );
+        let ios = Core::open(pins(), file.0.clone(), Os::Ios, false);
+        assert_eq!(
+            ios.download_plan(number("1.5.1")),
+            Err(door::Failure::Missing)
+        );
+    }
+}
diff --git a/src/hjviewer_update/policy.rs b/src/hjviewer_update/policy.rs
new file mode 100644
index 0000000..63aea2d
--- /dev/null
+++ b/src/hjviewer_update/policy.rs
@@ -0,0 +1,1198 @@
+//! The signed version policy as it comes over the wire: the envelope, the policy text and the
+//! root declaration, and the rules their fields keep. Nothing here decides whom to believe: `trust`
+//! checks the signatures first and reads a text only then, and decides what a new policy may change.
+//!
+//! ```text
+//! {"v":1,"k":1,"p":"<policy JSON text>","s":"<base64 Ed25519 signature>",
+//!  "root":{"k":101,"p":"<root declaration JSON text>","s":"<base64 signature>"}}
+//! ```
+//!
+//! A field this version does not know is skipped, so that later policies may say more; a field it
+//! knows must keep its rule, or the whole policy is refused. The JSON is read as the trust rules
+//! write it out (spec 2-2): serde_json's derived readers, with every struct of these texts an
+//! object.
+
+use super::trust::Reject;
+use hbb_common::base64::{engine::general_purpose::STANDARD, Engine as _};
+use serde::de;
+use serde_derive::Deserialize;
+
+/// What the update keys sign: the context, a NUL byte, and the text exactly as it was received.
+pub(crate) const POLICY_CONTEXT: &[u8] = b"hjv-version-v1";
+pub(crate) const ROOT_CONTEXT: &[u8] = b"hjv-version-root-v1";
+/// The longest envelope the app reads.
+pub(crate) const MAX_ENVELOPE: usize = 16 * 1024;
+/// The largest package a policy may name.
+pub(crate) const MAX_PACKAGE: u64 = 200 * 1024 * 1024;
+
+const MAX_CONTACT: usize = 200;
+const MAX_NOTES: usize = 2000;
+
+/// An app version as a policy writes it: `x.y.z`, no leading zeros, the last number below 100.
+/// On this form alone `hbb_common::get_version_number`, which hbbs and the apps compare with,
+/// agrees with plain comparison: it reads "1.6" as 1.0.60 and "1.5.100" as 1.6.0.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Version {
+    text: String,
+    number: i64,
+}
+
+impl Version {
+    pub(crate) fn parse(text: &str) -> Option<Version> {
+        let field = |part: &str, max_len: usize| {
+            !part.is_empty()
+                && part.len() <= max_len
+                && part.bytes().all(|b| b.is_ascii_digit())
+                && (part == "0" || !part.starts_with('0'))
+        };
+        let mut parts = text.split('.');
+        let strict = field(parts.next()?, 3)
+            && field(parts.next()?, 3)
+            && field(parts.next()?, 2)
+            && parts.next().is_none();
+        strict.then(|| Version {
+            text: text.to_owned(),
+            number: hbb_common::get_version_number(text),
+        })
+    }
+
+    pub(crate) fn number(&self) -> i64 {
+        self.number
+    }
+
+    pub(crate) fn as_str(&self) -> &str {
+        &self.text
+    }
+}
+
+/// The one form of a time in a policy, `2026-11-22T15:00:00Z`, as Unix seconds, with a year from
+/// 0001 to 9999 (trust rules 1-2).
+pub(crate) fn parse_utc(text: &str) -> Option<i64> {
+    let b = text.as_bytes();
+    let shaped = b.len() == 20
+        && b[4] == b'-'
+        && b[7] == b'-'
+        && b[10] == b'T'
+        && b[13] == b':'
+        && b[16] == b':'
+        && b[19] == b'Z';
+    if !shaped {
+        return None;
+    }
+    let number = |range: std::ops::Range<usize>| -> Option<u32> {
+        let digits = text.get(range)?;
+        digits
+            .bytes()
+            .all(|b| b.is_ascii_digit())
+            .then(|| digits.parse().ok())
+            .flatten()
+    };
+    let date = chrono::NaiveDate::from_ymd_opt(
+        i32::try_from(number(0..4).filter(|&year| year >= 1)?).ok()?,
+        number(5..7)?,
+        number(8..10)?,
+    )?;
+    let time = date.and_hms_opt(number(11..13)?, number(14..16)?, number(17..19)?)?;
+    Some(time.and_utc().timestamp())
+}
+
+/// A package of a platform's `latest`: what hjv-api hands out and what the app checks it against.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Package {
+    /// The file's name on the server, shown to the user. The app never opens a path made from it.
+    pub file: String,
+    pub size: u64,
+    pub sha256: [u8; 32],
+    /// The Windows file version or the Android versionCode, as the policy writes it.
+    pub build: Option<String>,
+}
+
+/// One platform's entry.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Entry {
+    pub min: Version,
+    pub latest: Version,
+    /// Before this time only versions below `grace_min` are blocked, and those from it to below
+    /// `min` are warned; from it on, every version below `min` is blocked.
+    pub grace_until: Option<i64>,
+    /// There exactly when `grace_until` is, and below `min`.
+    pub grace_min: Option<Version>,
+    pub os_min: Option<String>,
+    pub notes: Option<String>,
+    pub source: Option<String>,
+    pub package: Option<Package>,
+    /// From this time installed Windows PCs install `latest` without a person.
+    pub auto_install_after: Option<i64>,
+    pub move_to_play: bool,
+}
+
+/// A policy text that kept every rule of its fields.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Policy {
+    pub epoch: u64,
+    pub seq: u64,
+    pub issued: i64,
+    pub server: String,
+    pub contact: Option<String>,
+    pub windows: Option<Entry>,
+    pub android: Option<Entry>,
+    pub android_play: Option<Entry>,
+    pub ios: Option<Entry>,
+}
+
+impl Policy {
+    /// The entries a policy may have, in a fixed order.
+    pub(crate) fn entries(&self) -> [(&'static str, Option<&Entry>); 4] {
+        [
+            ("windows", self.windows.as_ref()),
+            ("android", self.android.as_ref()),
+            ("android_play", self.android_play.as_ref()),
+            ("ios", self.ios.as_ref()),
+        ]
+    }
+
+    pub(crate) fn entry(&self, name: &str) -> Option<&Entry> {
+        self.entries()
+            .into_iter()
+            .find(|(entry, _)| *entry == name)
+            .and_then(|(_, entry)| entry)
+    }
+}
+
+/// A root declaration: the epoch it opens, the signing keys it revokes, and the base of that
+/// epoch.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct RootDeclaration {
+    pub server: String,
+    pub epoch: u64,
+    pub revoked: Vec<u16>,
+    pub issued: i64,
+    /// The base read as a policy: its entries with their four requirement members alone (no
+    /// package, texts, `os_min` or install time), the declaration's epoch and `issued`, seq 0.
+    pub base: Policy,
+}
+
+/// A text and its signature, before either is believed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Signed {
+    /// the number of the key that signed it
+    pub k: u16,
+    pub p: String,
+    pub sig: [u8; 64],
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Envelope {
+    pub policy: Signed,
+    pub root: Option<Signed>,
+}
+
+/// A JSON object read into `T`. A struct's derived reader would also take a JSON array, as its
+/// members in order; every struct of these texts is an object.
+pub(crate) struct Object<T>(pub T);
+
+impl<'de, T: de::Deserialize<'de>> de::Deserialize<'de> for Object<T> {
+    fn deserialize<D: de::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Members<T>(std::marker::PhantomData<T>);
+        impl<'de, T: de::Deserialize<'de>> de::Visitor<'de> for Members<T> {
+            type Value = T;
+
+            fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+                f.write_str("a JSON object")
+            }
+
+            fn visit_map<A: de::MapAccess<'de>>(self, map: A) -> Result<T, A::Error> {
+                T::deserialize(de::value::MapAccessDeserializer::new(map))
+            }
+        }
+        deserializer
+            .deserialize_map(Members(std::marker::PhantomData))
+            .map(Object)
+    }
+}
+
+/// `text`, one JSON object and nothing else, read into `T`; None for any shape error.
+pub(crate) fn object<T: de::DeserializeOwned>(text: &str) -> Option<T> {
+    serde_json::from_str::<Object<T>>(text)
+        .ok()
+        .map(|object| object.0)
+}
+
+#[derive(Deserialize)]
+struct VersionOnly {
+    v: u64,
+}
+
+/// The member `v` of a text, read first and alone (every other member skipped).
+pub(crate) fn version_of(text: &str) -> Option<u64> {
+    object::<VersionOnly>(text).map(|only| only.v)
+}
+
+#[derive(Deserialize)]
+struct RawEnvelope {
+    k: u64,
+    p: String,
+    s: String,
+    #[serde(default)]
+    root: Option<Object<RawSigned>>,
+}
+
+/// A signed part as it is written: a root part, or the root of the stored record.
+#[derive(Deserialize)]
+pub(crate) struct RawSigned {
+    k: u64,
+    p: String,
+    s: String,
+}
+
+#[derive(Deserialize)]
+struct RawPolicy {
+    epoch: u64,
+    seq: u64,
+    issued: String,
+    server: String,
+    #[serde(default)]
+    contact_ko: Option<String>,
+    platforms: Object<RawPlatforms>,
+}
+
+#[derive(Deserialize)]
+struct RawPlatforms {
+    #[serde(default)]
+    windows: Option<Object<RawEntry>>,
+    #[serde(default)]
+    android: Option<Object<RawEntry>>,
+    #[serde(default)]
+    android_play: Option<Object<RawEntry>>,
+    #[serde(default)]
+    ios: Option<Object<RawEntry>>,
+}
+
+#[derive(Deserialize)]
+struct RawEntry {
+    min: String,
+    latest: String,
+    #[serde(default)]
+    grace_until: Option<String>,
+    #[serde(default)]
+    grace_min: Option<String>,
+    #[serde(default)]
+    os_min: Option<String>,
+    #[serde(default)]
+    notes_ko: Option<String>,
+    #[serde(default)]
+    source: Option<String>,
+    #[serde(default)]
+    package: Option<Object<RawPackage>>,
+    #[serde(default)]
+    auto_install_after: Option<String>,
+    #[serde(default)]
+    move_to_play: Option<bool>,
+}
+
+#[derive(Deserialize)]
+struct RawPackage {
+    file: String,
+    size: u64,
+    sha256: String,
+    #[serde(default)]
+    build: Option<serde_json::Value>,
+}
+
+#[derive(Deserialize)]
+struct RawRoot {
+    server: String,
+    epoch: u64,
+    #[serde(default)]
+    revoked: Option<Vec<u64>>,
+    issued: String,
+    base: Object<RawBase>,
+}
+
+#[derive(Deserialize)]
+struct RawBase {
+    #[serde(default)]
+    windows: Option<Object<RawBaseEntry>>,
+    #[serde(default)]
+    android: Option<Object<RawBaseEntry>>,
+    #[serde(default)]
+    android_play: Option<Object<RawBaseEntry>>,
+    #[serde(default)]
+    ios: Option<Object<RawBaseEntry>>,
+}
+
+/// A base entry: its four requirement members are read, any other is skipped unread.
+#[derive(Deserialize)]
+struct RawBaseEntry {
+    min: String,
+    latest: String,
+    #[serde(default)]
+    grace_until: Option<String>,
+    #[serde(default)]
+    grace_min: Option<String>,
+}
+
+fn key_number(k: u64) -> Option<u16> {
+    u16::try_from(k).ok().filter(|k| *k > 0)
+}
+
+/// The canonical standard base64 of 64 bytes: the crate's STANDARD engine refuses padding that is
+/// missing or extra and unused bits that are not zero.
+fn signature(s: &str) -> Option<[u8; 64]> {
+    STANDARD.decode(s).ok()?.try_into().ok()
+}
+
+impl RawSigned {
+    /// Key numbers 1-65535, signatures of 64 bytes.
+    pub(crate) fn signed(self) -> Option<Signed> {
+        Some(Signed {
+            k: key_number(self.k)?,
+            p: self.p,
+            sig: signature(&self.s)?,
+        })
+    }
+}
+
+/// The envelope of an answer: UTF-8, version 1, key numbers 1-65535, signatures of 64 bytes.
+pub(crate) fn parse_envelope(body: &[u8]) -> Result<Envelope, Reject> {
+    if body.len() > MAX_ENVELOPE {
+        return Err(Reject::TooLarge);
+    }
+    // before anything else is read: a declaration is taken before the policy is looked at
+    let text = std::str::from_utf8(body).map_err(|_| Reject::Envelope)?;
+    if version_of(text).ok_or(Reject::Envelope)? != 1 {
+        return Err(Reject::Version);
+    }
+    let raw: RawEnvelope = object(text).ok_or(Reject::Envelope)?;
+    let policy = RawSigned {
+        k: raw.k,
+        p: raw.p,
+        s: raw.s,
+    }
+    .signed()
+    .ok_or(Reject::Envelope)?;
+    let root = match raw.root {
+        Some(Object(root)) => Some(root.signed().ok_or(Reject::Envelope)?),
+        None => None,
+    };
+    Ok(Envelope { policy, root })
+}
+
+/// `grace_min` of an entry whose deadline is `grace_until`: there exactly when the deadline is,
+/// a version, and below `min`. None when it breaks one of these.
+fn grace_min(
+    text: Option<&str>,
+    grace_until: Option<i64>,
+    min: &Version,
+) -> Option<Option<Version>> {
+    match (text, grace_until) {
+        (None, None) => Some(None),
+        (Some(text), Some(_)) => Version::parse(text)
+            .filter(|grace_min| grace_min.number() < min.number())
+            .map(Some),
+        _ => None,
+    }
+}
+
+/// A base entry keeps every rule a policy entry has for these four members.
+fn base_entry(raw: RawBaseEntry) -> Option<Entry> {
+    let min = Version::parse(&raw.min)?;
+    let latest = Version::parse(&raw.latest)?;
+    if min.number() > latest.number() {
+        return None;
+    }
+    let grace_until = match raw.grace_until {
+        Some(text) => Some(parse_utc(&text)?),
+        None => None,
+    };
+    let grace_min = grace_min(raw.grace_min.as_deref(), grace_until, &min)?;
+    Some(Entry {
+        min,
+        latest,
+        grace_until,
+        grace_min,
+        os_min: None,
+        notes: None,
+        source: None,
+        package: None,
+        auto_install_after: None,
+        move_to_play: false,
+    })
+}
+
+/// A root declaration's text, after its signature was checked: version 1, an epoch from 2 on, the
+/// revoked key numbers (none when the list is missing or null), the time and the base.
+pub(crate) fn parse_root(text: &str) -> Result<RootDeclaration, Reject> {
+    if version_of(text).ok_or(Reject::RootFormat)? != 1 {
+        return Err(Reject::Version);
+    }
+    let raw: RawRoot = object(text).ok_or(Reject::RootFormat)?;
+    if raw.epoch < 2 {
+        return Err(Reject::RootFormat);
+    }
+    let issued = parse_utc(&raw.issued).ok_or(Reject::RootFormat)?;
+    let revoked = raw
+        .revoked
+        .unwrap_or_default()
+        .into_iter()
+        .map(key_number)
+        .collect::<Option<Vec<u16>>>()
+        .ok_or(Reject::RootFormat)?;
+    let base = raw.base.0;
+    let entry = |raw: Option<Object<RawBaseEntry>>| -> Result<Option<Entry>, Reject> {
+        raw.map(|Object(raw)| base_entry(raw).ok_or(Reject::RootFormat))
+            .transpose()
+    };
+    let base = Policy {
+        epoch: raw.epoch,
+        seq: 0,
+        issued,
+        server: raw.server.clone(),
+        contact: None,
+        windows: entry(base.windows)?,
+        android: entry(base.android)?,
+        android_play: entry(base.android_play)?,
+        ios: entry(base.ios)?,
+    };
+    Ok(RootDeclaration {
+        server: raw.server,
+        epoch: raw.epoch,
+        revoked,
+        issued,
+        base,
+    })
+}
+
+/// `[A-Za-z0-9._-]{1,100}`
+fn plain_name(name: &str) -> bool {
+    (1..=100).contains(&name.len())
+        && name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'))
+}
+
+/// The Windows packer reads its own file name: one ending in `install.exe` installs at once and
+/// one with `-qs-` runs as quick support, so no package is called that.
+fn package_name(name: &str) -> bool {
+    let lower = name.to_ascii_lowercase();
+    plain_name(name) && !lower.contains("-qs-") && !lower.ends_with("install.exe")
+}
+
+fn sha256_hex(text: &str) -> Option<[u8; 32]> {
+    let lower_hex = text
+        .bytes()
+        .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b));
+    if !lower_hex {
+        return None;
+    }
+    hex::decode(text).ok()?.try_into().ok()
+}
+
+fn text_within(text: &Option<String>, max_chars: usize) -> bool {
+    text.as_ref()
+        .map_or(true, |text| text.chars().count() <= max_chars)
+}
+
+fn time(text: Option<&str>, field: &'static str) -> Result<Option<i64>, Reject> {
+    match text {
+        Some(text) => parse_utc(text).map(Some).ok_or(Reject::Field(field)),
+        None => Ok(None),
+    }
+}
+
+fn package(raw: RawPackage) -> Result<Package, Reject> {
+    if !package_name(&raw.file) {
+        return Err(Reject::Field("package.file"));
+    }
+    if raw.size == 0 || raw.size > MAX_PACKAGE {
+        return Err(Reject::Field("package.size"));
+    }
+    let sha256 = sha256_hex(&raw.sha256).ok_or(Reject::Field("package.sha256"))?;
+    let build = match raw.build {
+        Some(serde_json::Value::String(build)) => Some(build),
+        Some(serde_json::Value::Number(build)) => Some(build.to_string()),
+        _ => None,
+    };
+    Ok(Package {
+        file: raw.file,
+        size: raw.size,
+        sha256,
+        build,
+    })
+}
+
+/// An entry's members in the order the trust rules check them (spec 2-2 C3).
+fn entry(raw: RawEntry) -> Result<Entry, Reject> {
+    let min = Version::parse(&raw.min).ok_or(Reject::Field("min"))?;
+    let latest = Version::parse(&raw.latest).ok_or(Reject::Field("latest"))?;
+    if min.number() > latest.number() {
+        return Err(Reject::Field("min"));
+    }
+    let os_min_ok = raw.os_min.as_ref().map_or(true, |os| {
+        (1..=16).contains(&os.len()) && os.bytes().all(|b| b.is_ascii_digit() || b == b'.')
+    });
+    if !os_min_ok {
+        return Err(Reject::Field("os_min"));
+    }
+    if !text_within(&raw.notes_ko, MAX_NOTES) {
+        return Err(Reject::Field("notes_ko"));
+    }
+    if !raw.source.as_deref().map_or(true, plain_name) {
+        return Err(Reject::Field("source"));
+    }
+    let grace_until = time(raw.grace_until.as_deref(), "grace_until")?;
+    let grace_min =
+        grace_min(raw.grace_min.as_deref(), grace_until, &min).ok_or(Reject::Field("grace_min"))?;
+    let package = match raw.package {
+        Some(Object(raw)) => Some(package(raw)?),
+        None => None,
+    };
+    Ok(Entry {
+        min,
+        latest,
+        grace_until,
+        grace_min,
+        os_min: raw.os_min,
+        notes: raw.notes_ko,
+        source: raw.source,
+        package,
+        auto_install_after: time(raw.auto_install_after.as_deref(), "auto_install_after")?,
+        move_to_play: raw.move_to_play.unwrap_or(false),
+    })
+}
+
+/// A policy's text, after its signature was checked: version 1 and every field's rule.
+pub(crate) fn parse_policy(text: &str) -> Result<Policy, Reject> {
+    if version_of(text).ok_or(Reject::Field("json"))? != 1 {
+        return Err(Reject::Version);
+    }
+    let raw: RawPolicy = object(text).ok_or(Reject::Field("json"))?;
+    if raw.epoch == 0 {
+        return Err(Reject::Field("epoch"));
+    }
+    if raw.seq == 0 {
+        return Err(Reject::Field("seq"));
+    }
+    let issued = parse_utc(&raw.issued).ok_or(Reject::Field("issued"))?;
+    if !text_within(&raw.contact_ko, MAX_CONTACT) {
+        return Err(Reject::Field("contact_ko"));
+    }
+    let platforms = raw.platforms.0;
+    let platform = |raw: Option<Object<RawEntry>>| raw.map(|Object(raw)| entry(raw)).transpose();
+    Ok(Policy {
+        epoch: raw.epoch,
+        seq: raw.seq,
+        issued,
+        server: raw.server,
+        contact: raw.contact_ko,
+        windows: platform(platforms.windows)?,
+        android: platform(platforms.android)?,
+        android_play: platform(platforms.android_play)?,
+        ios: platform(platforms.ios)?,
+    })
+}
