+        assert_eq!(ROOT.sign(POLICY_CONTEXT, &policy_text(2, 2)), C_SIG);
+        assert_eq!(SIGNING_1.sign(POLICY_CONTEXT, RESEARCH_P), RESEARCH_SIG);
+        let mut signed = POLICY_CONTEXT.to_vec();
