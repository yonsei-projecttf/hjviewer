+    #[test]
+    fn the_floor_of_the_build() {
+        let pinned = pins_with_floor("1:7");
+        let take = |state: &Trust, body: &str| accept(&pinned, state, body.as_bytes());
+        let fresh = Trust::default();
+        // the policy the build was made under is still taken by a new install
+        assert_eq!(take(&fresh, &signed_1(1, 7)).1, Outcome::Taken);
+        assert_eq!(take(&fresh, &signed_1(1, 8)).1, Outcome::Taken);
+        for below in [signed_1(1, 6), root_signed(&policy_text(1, 6))] {
+            assert_eq!(
+                take(&fresh, &below),
+                (fresh.clone(), Outcome::Refused(Reject::Rollback))
+            );
+        }
+        // and a policy reaches as far from there as from a policy just below it
+        assert_eq!(take(&fresh, &signed_1(1, 1006)).1, Outcome::Taken);
+        assert_eq!(
+            take(&fresh, &signed_1(1, 1007)).1,
+            Outcome::Refused(Reject::Jump)
+        );
+
+        // a floor in a later epoch: the earlier epoch's policies are gone, whoever signs, and the
+        // epoch's declaration comes with its policy
+        let pinned = pins_with_floor("2:3");
+        let take = |state: &Trust, body: &str| accept(&pinned, state, body.as_bytes());
+        for old in [signed_1(1, 9), root_signed(&policy_text(1, 9))] {
+            assert_eq!(take(&fresh, &old).1, Outcome::Refused(Reject::Epoch));
+        }
+        let by_2 = envelope(2, &SIGNING_2, &policy_text(2, 3), None);
+        assert_eq!(take(&fresh, &by_2).1, Outcome::Refused(Reject::Epoch));
+        let (kept, outcome) = take(&fresh, &declared(2, 2, &[1]));
+        assert_eq!(outcome, Outcome::Refused(Reject::Rollback));
+        assert_eq!(kept.declared_epoch(), 2);
+        let (at_floor, outcome) = take(&kept, &declared(2, 3, &[1]));
+        assert_eq!((outcome, seq(&at_floor)), (Outcome::Taken, Some((2, 3))));
+        // a declaration of the earlier epoch is no declaration
+        let old = with_root(&SIGNING_2, &policy_text(1, 9), 1, &[]);
+        assert_eq!(take(&fresh, &old).1, Outcome::Refused(Reject::RootFormat));
+
+        // a held policy below a newer build's floor: still enforced and the basis, and nothing
+        // below the floor is taken; but nothing is installed from it until one at the floor
+        let pinned = pins_with_floor("1:9");
+        let take = |state: &Trust, body: &str| accept(&pinned, state, body.as_bytes());
+        let a = at_1_7();
+        assert_eq!(a.effective(), Some(&a.held.as_ref().unwrap().policy));
+        assert!(!a.may_install(pinned.floor));
+        assert_eq!(a.low_same(pinned.floor), (8, None));
+        assert_eq!(
+            take(&a, &signed_1(1, 8)).1,
+            Outcome::Refused(Reject::Rollback)
+        );
+        let lower = policy_with(1, 9, |p| {
+            p["platforms"]["windows"]["latest"] = "1.6.0".into()
+        });
+        let lower = envelope(1, &SIGNING_1, &lower, None);
+        assert_eq!(take(&a, &lower).1, Outcome::Refused(Reject::Relaxation));
+        let (at_floor, outcome) = take(&a, &signed_1(1, 9));
+        assert_eq!(outcome, Outcome::Taken);
+        assert!(at_floor.may_install(pinned.floor));
+        // exactly at the floor: the position is taken by its own text alone
+        let pinned = pins_with_floor("1:7");
+        let (_, outcome) = accept(&pinned, &a, signed_1(1, 7).as_bytes());
+        assert_eq!(outcome, Outcome::Unchanged);
+        let other = policy_with(1, 7, |p| {
+            p["platforms"]["windows"]["latest"] = "1.6.2".into()
+        });
+        let other = envelope(1, &SIGNING_1, &other, None);
+        let (_, outcome) = accept(&pinned, &a, other.as_bytes());
+        assert_eq!(outcome, Outcome::Refused(Reject::Fork));
+
+        // a held policy of an epoch below a newer build's floor: enforced, but no basis and
+        // nothing installed from it
+        let floor = Position { epoch: 2, seq: 3 };
+        assert_eq!(a.epoch(floor), 2);
+        assert_eq!(a.effective(), Some(&a.held.as_ref().unwrap().policy));
+        assert_eq!((a.basis(floor), a.may_install(floor)), (None, false));
+    }
