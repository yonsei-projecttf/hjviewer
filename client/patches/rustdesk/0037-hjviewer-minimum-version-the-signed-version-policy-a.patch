+    #[test]
+    fn a_declaration_starts_an_epoch_and_revokes() {
+        let a = at_1_7();
+        // a later epoch: its policy starts the sequence numbers anew
+        let b = taken(&a, &declared(2, 1, &[1]));
+        assert_eq!((seq(&b), b.revoked()), (Some((2, 1)), &[1u16][..]));
+        // key 1 is gone, in the new epoch and in the old one
+        assert_eq!(refused(&b, &signed_1(2, 2)), Reject::RevokedKey);
+        assert_eq!(refused(&b, &signed_1(1, 8)), Reject::RevokedKey);
+        // the old epoch's high numbers mean nothing now, and its policies are not taken
+        let by_2 = |epoch, seq| envelope(2, &SIGNING_2, &policy_text(epoch, seq), None);
+        assert_eq!(refused(&b, &by_2(1, 500)), Reject::Epoch);
+        // a policy of epoch 2 travels with its declaration
+        assert_eq!(refused(&b, &by_2(2, 2)), Reject::Epoch);
+        assert_eq!(seq(&taken(&b, &declared(2, 2, &[1]))), Some((2, 2)));
+        // another declaration text for epoch 2: a fork, whatever it says
+        for other in [root_text(2, &[]), root_text(2, &[1, 7])] {
+            let body = envelope(
+                2,
+                &SIGNING_2,
+                &policy_text(2, 2),
+                Some(&root_part(&ROOT, &other)),
+            );
+            assert_eq!(refused(&b, &body), Reject::RootFork);
+        }
+        // the same text signed by the other root key is the same declaration
+        let by_102 = root_part(&ROOT_2, &root_text(2, &[1]));
+        let body = envelope(2, &SIGNING_2, &policy_text(2, 2), Some(&by_102));
+        let c = taken(&b, &body);
+        assert_eq!(c.decl, b.decl);
+
+        // a later declaration lists every earlier revocation (the tool makes it so)
+        let d = taken(&c, &declared(3, 1, &[1, 7]));
+        assert_eq!((seq(&d), d.revoked()), (Some((3, 1)), &[1u16, 7][..]));
+        // an earlier epoch's declaration is refused, with whatever policy
+        assert_eq!(refused(&d, &declared(2, 9, &[1])), Reject::RootEpoch);
+        let old = envelope(
+            2,
+            &SIGNING_2,
+            &policy_text(3, 2),
+            Some(&root_part(&ROOT, &root_text(2, &[1]))),
+        );
+        assert_eq!(refused(&d, &old), Reject::RootEpoch);
+
+        // no root key can be revoked
+        for root in [101, 102] {
+            let body = with_root(&SIGNING_2, &policy_text(2, 1), 2, &[1, root]);
+            assert_eq!(refused(&a, &body), Reject::RootRevokesRoot);
+        }
+        // a signing key cannot start an epoch: without a declaration, or by signing one itself
+        assert_eq!(refused(&a, &signed_1(2, 1)), Reject::Epoch);
+        let own = root_part(&SIGNING_1, &root_text(2, &[2]));
+        let body = envelope(1, &SIGNING_1, &policy_text(2, 1), Some(&own));
+        assert_eq!(refused(&a, &body), Reject::RootKey);
+        let forged = own.replacen("\"k\":1", "\"k\":101", 1);
+        let body = envelope(1, &SIGNING_1, &policy_text(2, 1), Some(&forged));
+        assert_eq!(refused(&a, &body), Reject::RootSignature);
+        // a declaration by a root key this build does not pin
+        let by_103 = root_part(&STRANGER, &root_text(2, &[1])).replacen("\"k\":3", "\"k\":103", 1);
+        let body = envelope(2, &SIGNING_2, &policy_text(2, 1), Some(&by_103));
+        assert_eq!(refused(&a, &body), Reject::RootKey);
+        // epoch 1 has no declaration
+        let body = with_root(&SIGNING_2, &policy_text(1, 8), 1, &[]);
+        assert_eq!(refused(&a, &body), Reject::RootFormat);
+        // another server's declaration, or one of another version
+        let elsewhere = root_text(2, &[1]).replace(SERVER, "rd2.example.com");
+        let body = envelope(
+            2,
+            &SIGNING_2,
+            &policy_text(2, 1),
+            Some(&root_part(&ROOT, &elsewhere)),
+        );
+        assert_eq!(refused(&a, &body), Reject::RootServer);
+        let v2 = root_text(2, &[1]).replacen("\"v\":1", "\"v\":2", 1);
+        let body = envelope(
+            2,
+            &SIGNING_2,
+            &policy_text(2, 1),
+            Some(&root_part(&ROOT, &v2)),
+        );
+        assert_eq!(refused(&a, &body), Reject::Version);
+        // either pinned root key declares
+        let by_102 = root_part(&ROOT_2, &root_text(2, &[1]));
+        let e = taken(
+            &a,
+            &envelope(2, &SIGNING_2, &policy_text(2, 1), Some(&by_102)),
+        );
+        assert_eq!(e.decl.as_ref().map(|decl| decl.part.k), Some(102));
