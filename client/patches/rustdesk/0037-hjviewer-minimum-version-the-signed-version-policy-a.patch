new file mode 100644
index 0000000..64c72de
--- /dev/null
+++ b/src/hjviewer_update/verdict.rs
@@ -0,0 +1,706 @@
+//! What a policy means: for this app (which entry is its own, and whether it may still connect),
+//! for a controller that logs in to this device, for the clock the deadlines are read by, and for
+//! the text the app shows when a server or a PC refused its version.
+
+use super::policy::{Entry, Policy, Version};
+
+const DAY: i64 = 86_400;
+/// Google Play, as the installer of an Android app.
+const PLAY_STORE: &str = "com.android.vending";
+
+/// A policy's entries.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Channel {
+    Windows,
+    /// an APK installed from a file
+    Android,
+    /// an app installed by Google Play
+    AndroidPlay,
+    Ios,
+}
+
+impl Channel {
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            Channel::Windows => "windows",
+            Channel::Android => "android",
+            Channel::AndroidPlay => "android_play",
+            Channel::Ios => "ios",
+        }
+    }
+
+    pub(crate) fn entry(self, policy: &Policy) -> Option<&Entry> {
+        match self {
+            Channel::Windows => policy.windows.as_ref(),
+            Channel::Android => policy.android.as_ref(),
+            Channel::AndroidPlay => policy.android_play.as_ref(),
+            Channel::Ios => policy.ios.as_ref(),
+        }
+    }
+}
+
+/// The system this app was built for, as far as policies tell systems apart.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Os {
+    Windows,
+    Android,
+    Ios,
+    Linux,
+    Other,
+}
+
+pub(crate) fn this_os() -> Os {
+    if cfg!(target_os = "windows") {
+        Os::Windows
+    } else if cfg!(target_os = "android") {
+        Os::Android
+    } else if cfg!(target_os = "ios") {
+        Os::Ios
+    } else if cfg!(target_os = "linux") {
+        Os::Linux
+    } else {
+        Os::Other
+    }
+}
+
+/// The entry this app is held to. An Android app has none until the screen said where the app
+/// was installed from (`installer`, empty for a file): an app from Google Play cannot install the
+/// APK, so it must not be judged by the APK's entry. Linux has an entry only as the E2E's
+/// stand-in for a Windows app.
+pub(crate) fn own_channel(os: Os, installer: Option<&str>, e2e: bool) -> Option<Channel> {
+    match os {
+        Os::Windows => Some(Channel::Windows),
+        Os::Ios => Some(Channel::Ios),
+        Os::Android => installer.map(|installer| {
+            if installer == PLAY_STORE {
+                Channel::AndroidPlay
+            } else {
+                Channel::Android
+            }
+        }),
+        Os::Linux if e2e => Some(Channel::Windows),
+        Os::Linux | Os::Other => None,
+    }
+}
+
+/// What the app may do.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum State {
+    /// no policy that this app has an entry in: nothing is shown and nothing is blocked
+    Unknown,
+    Ok,
+    /// a newer version exists
+    Available,
+    /// below the minimum, before its deadline: a warning
+    Grace,
+    /// below the minimum: no outgoing connections until the app is updated
+    Required,
+}
+
+impl State {
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            State::Unknown => "unknown",
+            State::Ok => "ok",
+            State::Available => "available",
+            State::Grace => "grace",
+            State::Required => "required",
+        }
+    }
+}
+
+/// `(lo, hi, T)` of an entry (trust rules 1-2): with a deadline, `grace_min`'s number, `min`'s
+/// number and the deadline; without one, `min`'s number twice and none.
+pub(crate) fn steps(entry: &Entry) -> (i64, i64, Option<i64>) {
+    let min = entry.min.number();
+    match (entry.grace_until, &entry.grace_min) {
+        (Some(until), Some(grace_min)) => (grace_min.number(), min, Some(until)),
+        _ => (min, min, None),
+    }
+}
+
+/// THRESHOLD(e, t): a version below it is blocked by the entry at the time `t`. Before the
+/// deadline that is `grace_min`, from the deadline on (and always without one) `min`.
+pub(crate) fn threshold(entry: &Entry, t: i64) -> i64 {
+    match steps(entry) {
+        (lo, _, Some(until)) if t < until => lo,
+        (_, hi, _) => hi,
+    }
+}
+
+/// The state of an app of version `current` (as `get_version_number` counts it) under its entry
+/// at the time `now`.
+pub(crate) fn judge(entry: Option<&Entry>, current: i64, now: i64) -> State {
+    let Some(entry) = entry else {
+        return State::Unknown;
+    };
+    if current >= entry.latest.number() {
+        State::Ok
+    } else if current >= entry.min.number() {
+        State::Available
+    } else if current < threshold(entry, now) {
+        State::Required
+    } else {
+        State::Grace
+    }
+}
+
+/// The time a policy's deadlines are read by: the device's clock, but never before the policy was
+/// issued (which is signed), and the server's clock where the device's runs more than a day ahead
+/// of it. `server_offset` is the server's `Date` minus the device's clock when the last answer
+/// came; it is not signed, so it only ever moves the time back, which puts a deadline off as
+/// blocking the policy would, and never brings one forward.
+pub(crate) fn policy_now(device: i64, server_offset: Option<i64>, issued: i64) -> i64 {
+    let now = match server_offset {
+        Some(offset) if offset < -DAY => device.saturating_add(offset),
+        _ => device,
+    };
+    now.max(issued)
+}
+
+/// The platforms a controller can be held to a minimum on.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Platform {
+    Windows,
+    Android,
+    Ios,
+}
+
+/// A peer's platform as LoginRequest.my_platform and PeerInfo.platform name it: "Windows",
+/// "Android", and "Unknown: iOS" for an iPhone. Linux, macOS and whatever else an upstream app
+/// runs on are not checked; in an E2E build the Linux client stands in for a Windows app.
+pub(crate) fn normalize_platform(platform: &str, e2e: bool) -> Option<Platform> {
+    let platform = platform.trim().to_ascii_lowercase();
+    match platform.as_str() {
+        "windows" => Some(Platform::Windows),
+        "android" => Some(Platform::Android),
+        "linux" if e2e => Some(Platform::Windows),
+        other if other.ends_with("ios") => Some(Platform::Ios),
+        _ => None,
+    }
+}
+
+/// The entries a controller of `platform` is held to: an Android controller does not say whether
+/// it came from Google Play, so both Android entries are its family.
+fn family(policy: &Policy, platform: Platform) -> impl Iterator<Item = &Entry> {
+    let names: &[&str] = match platform {
+        Platform::Windows => &["windows"],
+        Platform::Android => &["android", "android_play"],
+        Platform::Ios => &["ios"],
+    };
+    names.iter().filter_map(|name| policy.entry(name))
+}
+
+/// The lowest `min` among the family's entries: the version a refusal tells the controller to
+/// update to. None when the policy has none of them.
+pub(crate) fn family_min(policy: &Policy, platform: Platform) -> Option<&Version> {
+    family(policy, platform)
+        .map(|entry| &entry.min)
+        .min_by_key(|min| min.number())
+}
+
+/// LIMIT(now): the lowest THRESHOLD of the family's entries at `now`. A controller below it is
+/// refused, so only what every entry of the family blocks is refused. None when the policy has
+/// none of them, and nobody is refused.
+pub(crate) fn family_limit(policy: &Policy, platform: Platform, now: i64) -> Option<i64> {
+    family(policy, platform)
+        .map(|entry| threshold(entry, now))
+        .min()
+}
+
+fn numbers(text: &str) -> Option<Vec<u32>> {
+    text.split('.')
+        .map(|part| {
+            (!part.is_empty() && part.bytes().all(|b| b.is_ascii_digit()))
+                .then(|| part.parse().ok())
+                .flatten()
+        })
+        .collect()
+}
+
+/// Whether the device's system is below the entry's `os_min`, so that `latest` cannot run on it.
+/// Android counts API levels (`os_min` "22" against the device's SDK number, not its version
+/// name), iOS dotted numbers ("17.5.1" against "13.0"), Windows the major version. A value that
+/// cannot be read is not too old.
+pub(crate) fn os_too_old(channel: Channel, os_min: &str, device_os: &str) -> bool {
+    let (Some(min), Some(device)) = (numbers(os_min), numbers(device_os)) else {
+        return false;
+    };
+    match channel {
+        Channel::Ios => {
+            let at = |list: &[u32], i: usize| list.get(i).copied().unwrap_or(0);
+            (0..min.len().max(device.len()))
+                .map(|i| at(&device, i).cmp(&at(&min, i)))
+                .find(|order| order.is_ne())
+                .is_some_and(|order| order.is_lt())
+        }
+        Channel::Windows | Channel::Android | Channel::AndroidPlay => device.first() < min.first(),
+    }
+}
+
+/// How hbbs and a PC mark a refusal for the version (the texts S1, S2, L1 and L2 end with it).
+const REFUSAL_MARK: &str = "version not allowed";
+/// What the app shows in place of such a refusal. Its own texts, so that neither a server nor a
+/// PC can put a link or an instruction on the screen under the name of an update; both keep the
+/// mark at the end, which stops the session's automatic reconnection.
+pub(crate) const R1: &str =
+    "이 버전으로는 연결할 수 없다는 답을 받았습니다. 업데이트를 확인하고 있습니다. (version not allowed)";
+pub(crate) const R2: &str =
+    "서버와 앱의 최소 버전 정보가 맞지 않아 연결하지 못했습니다. 잠시 뒤 다시 시도하거나 관리자에게 알려 주세요. (version not allowed)";
+/// How long after a check of the policy a refusal counts as checked.
+pub(crate) const REFUSAL_FRESH: u64 = 300;
+
+pub(crate) fn is_version_refusal(text: &str) -> bool {
+    text.to_lowercase().contains(REFUSAL_MARK)
+}
+
+/// The text in place of a refusal for the version; None for any other text, which stays as it
+/// is. The first refusal gives R1 and the caller checks the policy at once: if the app must
+/// update, its update screen says so. When the policy was checked a moment ago and still does not
+/// ask for an update, the server or PC and the policy disagree, which is R2.
+pub(crate) fn refusal_text(
+    text: &str,
+    required: bool,
+    checked_just_now: bool,
+) -> Option<&'static str> {
+    if !is_version_refusal(text) {
+        return None;
+    }
+    Some(if !required && checked_just_now {
+        R2
+    } else {
+        R1
+    })
+}
+
+#[cfg(test)]
+mod tests {
