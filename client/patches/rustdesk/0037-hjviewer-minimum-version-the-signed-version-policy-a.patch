+
+    /// The whole table of the trust rules 3-2, at times around the deadline.
+    #[test]
+    fn the_states() {
+        let policy = policy_of(|_| {});
+        let windows = Channel::Windows.entry(&policy);
+        // min 1.6.0, latest 1.6.1, until GRACE versions from 1.5.0 are warned
+        for (current, now, state) in [
+            ("1.6.1", 0, State::Ok),
+            ("1.6.2", GRACE + 1, State::Ok),
+            ("2.0.0", GRACE + 1, State::Ok),
+            ("1.6.0", 0, State::Available),
+            ("1.6.0", GRACE + 1, State::Available),
+            ("1.5.1", GRACE - 1, State::Grace),
+            ("1.5.0", 0, State::Grace),
+            ("1.5.0", GRACE - 1, State::Grace),
+            ("1.5.1", GRACE, State::Required),
+            ("1.5.1", GRACE + 1, State::Required),
+            ("1.5.99", i64::MAX, State::Required),
+            ("0.0.1", GRACE, State::Required),
+            // below grace_min: blocked before the deadline too
+            ("1.4.99", GRACE - 1, State::Required),
+            ("0.0.1", i64::MIN, State::Required),
+        ] {
+            assert_eq!(
+                judge(windows, number(current), now),
+                state,
+                "{current} at {now}"
+            );
+        }
+        // the steps of the entry
+        let entry = windows.unwrap();
+        assert_eq!(
+            steps(entry),
+            (number("1.5.0"), number("1.6.0"), Some(GRACE))
+        );
+        assert_eq!(
+            [i64::MIN, GRACE - 1, GRACE, i64::MAX].map(|t| threshold(entry, t)),
+            [
+                number("1.5.0"),
+                number("1.5.0"),
+                number("1.6.0"),
+                number("1.6.0")
+            ]
+        );
+        // a grace_min of 0.0.0: nobody blocked before the deadline
+        let open = policy_of(|p| p["platforms"]["windows"]["grace_min"] = "0.0.0".into());
+        let open = Channel::Windows.entry(&open);
+        assert_eq!(judge(open, number("0.0.1"), GRACE - 1), State::Grace);
+        assert_eq!(judge(open, number("0.0.1"), GRACE), State::Required);
+        // no deadline: the minimum holds at once
+        let policy = policy_of(|p| {
+            let windows = p["platforms"]["windows"].as_object_mut().unwrap();
+            windows.remove("grace_until");
+            windows.remove("grace_min");
+        });
+        let windows = Channel::Windows.entry(&policy);
+        assert_eq!(judge(windows, number("1.5.1"), i64::MIN), State::Required);
+        assert_eq!(judge(windows, number("1.6.0"), i64::MIN), State::Available);
+        // min = latest: nothing between required and ok
+        let policy = policy_of(|p| p["platforms"]["windows"]["min"] = "1.6.1".into());
+        let windows = Channel::Windows.entry(&policy);
+        assert_eq!(judge(windows, number("1.6.0"), GRACE), State::Required);
+        assert_eq!(judge(windows, number("1.6.0"), GRACE - 1), State::Grace);
+        assert_eq!(judge(windows, number("1.6.1"), GRACE), State::Ok);
+        // no policy, or no entry of this app's: nothing is blocked
+        assert_eq!(judge(None, number("1.0.0"), i64::MAX), State::Unknown);
+        assert_eq!(
+            [
+                State::Unknown,
+                State::Ok,
+                State::Available,
+                State::Grace,
+                State::Required
+            ]
+            .map(State::name),
+            ["unknown", "ok", "available", "grace", "required"]
+        );
