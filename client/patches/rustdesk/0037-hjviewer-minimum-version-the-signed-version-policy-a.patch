+    /// While an app is in its grace period the thread wakes when the period ends, so that the
+    /// screen changes then and not at the next check.
+    #[test]
+    fn the_thread_wakes_at_the_deadline() {
+        let file = TempFile::new("deadline", store::FILE);
+        let mut core = open(&file, Os::Windows);
+        let wall = GRACE as u64 - 100;
+        checked(
+            &mut core,
+            Kind::Regular,
+            0,
