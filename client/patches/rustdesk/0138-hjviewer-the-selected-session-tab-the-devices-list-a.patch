diff --git a/flutter/test/hjviewer_title_line_test.dart b/flutter/test/hjviewer_title_line_test.dart
new file mode 100644
index 0000000..92878a6
--- /dev/null
+++ b/flutter/test/hjviewer_title_line_test.dart
@@ -0,0 +1,132 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_hbb/common/hjv_title_line.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+// D16 (the 1.8.2 screen review), the logged-in devices list's rows (common/hjv_title_line.dart):
+// the arrow and [로그아웃시키기] on the middle of the title's first line, on a row of one, two or
+// three lines alike, in a desktop's and a phone's density. Plain Flutter, no bridge.
+
+const _title = TextStyle(fontSize: 14, fontWeight: FontWeight.w600);
+
+Widget _rows(VisualDensity density, {TextStyle title = _title}) => MaterialApp(
+      // the app's theme is Material 2 (common.dart MyTheme)
+      theme: ThemeData(useMaterial3: false, visualDensity: density),
+      home: Scaffold(
+        body: Align(
+          alignment: Alignment.topLeft,
+          child: SizedBox(
+            width: 360,
+            child: Column(children: [
+              hjvTitleLineTile(
+                title: 'One',
+                titleStyle: title,
+                subtitle: const Text('Windows · logged in today'),
+                trailing: TextButton(
+                    style: hjvTitleLineButton(Colors.red),
+                    onPressed: () {},
+                    child: const Text('Log out')),
+                children: const [],
+              ),
+              hjvTitleLineTile(
+                title: 'Two',
+                titleStyle: title,
+                subtitle: const Text('Windows · logged in today\nlast used now'),
+                trailing: TextButton(
+                    style: hjvTitleLineButton(Colors.red),
+                    onPressed: () {},
+                    child: const Text('Log out 2')),
+                children: const [],
+              ),
+              // a phone's row: [로그아웃시키기] below the line
+              hjvTitleLineTile(
+                title: 'Three',
+                titleStyle: title,
+                subtitle: Column(
+                    crossAxisAlignment: CrossAxisAlignment.start,
+                    children: [
+                      const Text('Android · logged in today'),
+                      TextButton(
+                          onPressed: () {}, child: const Text('Log out 3')),
+                    ]),
+                children: const [],
+              ),
+            ]),
+          ),
+        ),
+      ),
+    );
+
+void main() {
+  for (final (name, density) in [
+    ('desktop', VisualDensity.compact),
+    ('phone', VisualDensity.standard),
+  ]) {
+    testWidgets(
+        '$name: the arrow and the button sit on the title line of every row',
+        (tester) async {
+      await tester.pumpWidget(_rows(density));
+      final arrows = find.byIcon(Icons.expand_more);
+      expect(arrows, findsNWidgets(3));
+      final rows = find.byType(ExpansionTile);
+      final offsets = <double>[];
+      for (final (i, title) in ['One', 'Two', 'Three'].indexed) {
+        final row = tester.getRect(rows.at(i));
+        final text = tester.getRect(find.text(title));
+        final arrow = tester.getRect(arrows.at(i));
+        expect(text.height, kHjvTitleLine, reason: title);
+        expect(arrow.height, kHjvTitleLine, reason: title);
+        expect(arrow.center.dy, text.center.dy, reason: title);
+        offsets.add(arrow.center.dy - row.top);
+      }
+      // the rows of two and three lines are taller, but their title line is where the one-line
+      // row's is
+      for (final i in [1, 2]) {
+        expect(tester.getRect(rows.at(i)).height,
+            greaterThan(tester.getRect(rows.at(0)).height));
+      }
+      expect(offsets.toSet(), hasLength(1));
+      for (final (title, label) in [('One', 'Log out'), ('Two', 'Log out 2')]) {
+        final button =
+            tester.getRect(find.widgetWithText(TextButton, label));
+        expect(button.height, kHjvTitleLine, reason: label);
+        expect(button.center.dy, tester.getRect(find.text(title)).center.dy,
+            reason: label);
+      }
+    });
+  }
+
+  testWidgets('a font with a taller line keeps the title line', (tester) async {
+    await tester.pumpWidget(_rows(VisualDensity.compact,
+        title: _title.copyWith(height: 1.7)));
+    final text = tester.getRect(find.text('One'));
+    expect(text.height, kHjvTitleLine);
+    expect(tester.getRect(find.byIcon(Icons.expand_more).first).center.dy,
+        text.center.dy);
+  });
+
+  testWidgets('a long title wraps with the arrow on its first line',
+      (tester) async {
+    await tester.pumpWidget(MaterialApp(
+      theme: ThemeData(useMaterial3: false),
+      home: Scaffold(
+        body: Align(
+          alignment: Alignment.topLeft,
+          child: SizedBox(
+            width: 200,
+            child: hjvTitleLineTile(
+              title: 'A device name long enough for two lines',
+              titleStyle: _title,
+              subtitle: const Text('Windows'),
+              children: const [],
+            ),
+          ),
+        ),
+      ),
+    ));
+    final text =
+        tester.getRect(find.text('A device name long enough for two lines'));
+    expect(text.height, greaterThanOrEqualTo(2 * kHjvTitleLine));
+    expect(tester.getRect(find.byIcon(Icons.expand_more)).center.dy,
+        text.top + kHjvTitleLine / 2);
+  });
+}
