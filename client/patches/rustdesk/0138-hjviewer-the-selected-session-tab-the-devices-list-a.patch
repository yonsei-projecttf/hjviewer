+// HJViewer D16 (the 1.8.2 screen review): a list row that opens (the logged-in devices list's), with
+// its arrow and its button on the middle of the title's first line, on a row of one line under the
+// title as on one of two or three. Plain Flutter without the bridge, so that ci.sh tests it with the
+// web stand-in (test/hjviewer_title_line_test.dart).
+
+import 'package:flutter/material.dart';
+
+/// The title's line: as high as the arrow (an Icon's 24 px) and the row's button.
+const double kHjvTitleLine = 24;
+
+/// Every line of a title kHjvTitleLine high with the text in its middle, whatever the font's own
+/// line height. ListTileTitleAlignment.top puts the arrow and the button at the title's top, so
+/// that they then sit on the middle of its first line.
+StrutStyle hjvTitleLineStrut(double fontSize) => StrutStyle(
+      fontSize: fontSize,
+      height: kHjvTitleLine / fontSize,
+      leadingDistribution: TextLeadingDistribution.even,
+      forceStrutHeight: true,
+    );
+
+/// A text button on the title's line (the row's trailing): kHjvTitleLine high in every visual
+/// density (a desktop's compact one takes 8 px off a minimum size), its label on the line's middle.
+ButtonStyle hjvTitleLineButton(Color foreground) => TextButton.styleFrom(
+      foregroundColor: foreground,
+      padding: const EdgeInsets.symmetric(horizontal: 10),
+      minimumSize: const Size(0, kHjvTitleLine),
+      visualDensity: VisualDensity.standard,
+      tapTargetSize: MaterialTapTargetSize.shrinkWrap,
+    );
+
+/// The row: the arrow before the title, `subtitle` under it, `trailing` (hjvTitleLineButton) at
+/// the end of the title's line, and `children` when opened. The low least height (48) puts every
+/// row's title at the top padding, where ListTileTitleAlignment.top puts the arrow and `trailing`;
+/// with a taller one a row of one line under the title would centre its title lower.
+Widget hjvTitleLineTile({
+  required String title,
+  required TextStyle titleStyle,
+  required Widget subtitle,
+  Widget? trailing,
+  required List<Widget> children,
+  Color? iconColor,
+  Color? collapsedIconColor,
+}) =>
+    IconTheme.merge(
+      // the arrow as high as the title's line, also under a theme with other icon sizes
+      data: const IconThemeData(size: kHjvTitleLine),
+      child: ListTileTheme.merge(
+        // the arrow close to the text, so that a phone's narrow dialog keeps room for the lines
+        horizontalTitleGap: 8,
+        minLeadingWidth: kHjvTitleLine,
+        minVerticalPadding: 4,
+        titleAlignment: ListTileTitleAlignment.top,
+        child: ExpansionTile(
+          minTileHeight: 48,
+          controlAffinity: ListTileControlAffinity.leading,
+          tilePadding: const EdgeInsets.only(left: 10, right: 4),
+          shape: const Border(),
+          collapsedShape: const Border(),
+          iconColor: iconColor,
+          collapsedIconColor: collapsedIconColor,
+          title: Text(title,
+              style: titleStyle,
+              strutStyle: hjvTitleLineStrut(titleStyle.fontSize ?? 14)),
+          subtitle: subtitle,
+          trailing: trailing,
+          expandedCrossAxisAlignment: CrossAxisAlignment.start,
+          // under the title: the padding, the arrow and the gap
+          childrenPadding: const EdgeInsets.only(
+              left: 10 + kHjvTitleLine + 8, right: 12, bottom: 12),
+          children: children,
+        ),
+      ),
+    );
