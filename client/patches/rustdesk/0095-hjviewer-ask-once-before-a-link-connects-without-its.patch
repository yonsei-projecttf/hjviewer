+// them.
 
 import 'dart:convert';
 
+import 'package:flutter_hbb/common/formatter/id_formatter.dart' show formatID;
+
 /// The msgbox type of a refusal for access (src/hjviewer_access.rs MSGBOX_TYPE).
 const kHjvAccessMsgbox = 'hjv-access-error';
 
@@ -741,6 +744,15 @@ class HjvAccessTexts {
   String get askText => _t(
       '이 서버는 연세대학교 교직원만 쓸 수 있습니다. 연세포탈로 로그인하거나, 이용 비밀번호가 있으면 넣고 연결하세요. 그 PC의 비밀번호는 PC가 따로 묻습니다.',
       'This server is only for Yonsei University faculty and staff. Log in with your Yonsei portal account, or enter an access password if you have one, to connect. The PC asks for its own password separately.');
+
+  // LK1 (TV-C6): a link (hjviewer://<ID>, rustdesk://<ID>) opens a connection in a pinned build:
+  // asked once, [취소] [연결]; on a phone where A0 comes anyway, A0 carries linkNote instead
+  String linkAskTitle(String id) => _t('PC $id에 연결할까요?', 'Connect to PC $id?');
+  String get linkAskText => _t('링크로 열었습니다. 모르는 곳에서 받은 링크라면 [취소]를 누르세요.',
+      'This was opened from a link. If you got the link from someone you do not know, press [Cancel].');
+  String linkNote(String id) => _t(
+      'PC $id에 연결하는 링크로 열었습니다. 모르는 곳에서 받은 링크라면 [취소]를 누르세요.',
+      'This was opened from a link to PC $id. If you got the link from someone you do not know, press [Cancel].');
 }
 
 // ---- before connecting (A0) ----
@@ -760,3 +772,43 @@ bool hjvAsksBeforeConnect(
         required bool loggedIn,
         required bool held}) =>
     accountBuild && hjvGateCloses(mode) == true && !loggedIn && !held;
+
+// ---- links (TV-C6) ----
+
+/// The schemes a pinned server build takes links in (D-13: rustdesk:// only in 1.9.0); any other
+/// build takes what upstream does.
+bool hjvLinkTakesScheme(String scheme, {required bool pinned}) =>
+    !pinned || scheme == 'hjviewer' || scheme == 'rustdesk';
+
+/// A QR code that is a link for the app (scan_page.dart): either scheme, or the build's own prefix.
+bool hjvIsAppLink(String text, {required String prefix}) =>
+    text.startsWith(prefix) ||
+    text.startsWith('hjviewer://') ||
+    text.startsWith('rustdesk://');
+
+/// A link's password (?password=, --password): a pinned build drops it, so that the PC asks.
+String? hjvLinkPasswordOf(String? password, {required bool pinned}) =>
+    pinned ? null : password;
+
+/// The PC in LK1: the link's ID without its key (?key=), spaced as the ID field spaces it.
+String hjvLinkShownId(String id) => formatID(id.split('?').first);
+
+/// What a link hjviewer://hjv-gate/<what> (the tray's items, UX-G2) asks for: `notGate` for any
+/// other link, `nothing` for a gate link with another path, a query or a fragment.
+enum HjvGateLink { notGate, nothing, logIn, password }
+
+HjvGateLink hjvGateLinkAction(Uri? uri) {
+  if (uri == null ||
+      !hjvLinkTakesScheme(uri.scheme, pinned: true) ||
+      uri.host != 'hjv-gate') {
+    return HjvGateLink.notGate;
+  }
+  if (uri.hasQuery || uri.hasFragment || uri.userInfo.isNotEmpty || uri.hasPort) {
+    return HjvGateLink.nothing;
+  }
+  return switch (uri.path) {
+    '/login' => HjvGateLink.logIn,
+    '/password' => HjvGateLink.password,
+    _ => HjvGateLink.nothing,
+  };
+}
