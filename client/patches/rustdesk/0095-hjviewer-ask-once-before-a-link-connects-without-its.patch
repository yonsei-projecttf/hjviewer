@@ -1400,5 +1413,141 @@ Future<bool> _askDialog(HjvAccessTexts t, String target) async {
   if (opens == true) return true;
   if (!logIn) return false;
   if (await loginDialog() == true) return true;
-  return _askDialog(t, target);
+  return _askDialog(t, target, link: link);
+}
+
+// ---- links (TV-C6, LK1) ----
+
+/// A pinned server build: src/hjviewer.rs pins allow-deep-link-password to N (critic 2-7); any
+/// other build reads "" and keeps upstream's links.
+final bool _pinned = !isWeb &&
+    bind.mainGetBuildinOption(key: kOptionAllowDeepLinkPassword) == 'N';
+
+/// urlLinkToCmdArgs (common.dart): whether a pinned build takes a link of this scheme at all.
+bool hjvLinkSchemeOk(Uri uri) => hjvLinkTakesScheme(uri.scheme, pinned: _pinned);
+
+/// handleUriLink and urlLinkToCmdArgs: a link's password, which a pinned build drops.
+String? hjvLinkPassword(String? password) =>
+    hjvLinkPasswordOf(password, pinned: _pinned);
+
+/// Set while `again` runs after LK1's [연결]: the link goes on without asking again.
+var _linkPass = false;
+
+/// The PC a phone's link is opening while A0 asks in the place of LK1 (X-17): the session's ID,
+/// as LK1 would show it, and since when.
+String? _linkTarget;
+String? _linkShown;
+DateTime? _linkAt;
+
+/// handleUriLink (a desktop) and urlLinkToCmdArgs (a phone), once the link names a PC `id`: in a
+/// pinned build, true, and LK1 asks before `again` handles the same link once more; a phone that
+/// is to ask A0 anyway goes on at once, A0 then with LK1's line. Connections the app makes itself
+/// (cards, recent sessions, the waiting room's [연결]) call connect() and are not asked.
+bool hjvLinkAsk(String id, void Function() again) {
+  if (_linkPass) {
+    _linkPass = false;
+    return false;
+  }
+  if (!_pinned) return false;
+  unawaited(_linkAsk(id, again));
+  return true;
+}
+
+Future<void> _linkAsk(String id, void Function() again) async {
+  final shown = hjvLinkShownId(id);
+  if (isMobile) {
+    final target = await _askTarget(id);
+    if (target != null) {
+      _linkTarget = target;
+      _linkShown = shown;
+      _linkAt = DateTime.now();
+      _linkAgain(again);
+      return;
+    }
+  }
+  if (await _linkDialog(_t, shown)) _linkAgain(again);
+}
+
+void _linkAgain(void Function() again) {
+  _linkPass = true;
+  try {
+    again();
+  } catch (e) {
+    debugPrint('hjv: link: $e');
+  } finally {
+    _linkPass = false;
+  }
+}
+
+/// A0's link line for `target`, once, while the link that is opening it is fresh.
+String? _linkNoteFor(String target) {
+  final linked = _linkTarget, shown = _linkShown, at = _linkAt;
+  _linkTarget = _linkShown = _linkAt = null;
+  if (linked != target || at == null) return null;
+  if (DateTime.now().difference(at) > const Duration(seconds: 30)) return null;
+  return shown;
+}
+
+/// LK1: true for [연결]. A desktop link keeps the main window hidden (main.dart), so it comes up
+/// first; on a cold start the overlay may not be there yet. Nothing shown, nothing opens.
+Future<bool> _linkDialog(HjvAccessTexts t, String shown) async {
+  await windowOnTop(null);
+  for (var tries = 0;; tries++) {
+    try {
+      final yes = await gFFI.dialogManager.show<bool>((setState, close, context) {
+        void cancel() => close(false);
+        return CustomAlertDialog(
+          title: HjvDialogTitle(Icons.link_rounded, t.linkAskTitle(shown)),
+          content: Text(hjvKeepAll(t.linkAskText),
+              style: hjvDialogTextStyle(context)),
+          actions: [
+            _button(t.cancel, cancel, outline: true),
+            _button(t.connect, () => close(true)),
+          ],
+          onCancel: cancel,
+        );
+      });
+      return yes == true;
+    } catch (e) {
+      if (tries >= 20) {
+        debugPrint('hjv: LK1: $e');
+        return false;
+      }
+      await Future.delayed(const Duration(milliseconds: 250));
+    }
+  }
+}
+
+/// handleUriLink (common.dart), before anything else reads the link, from any of its three
+/// inputs (X-18): true for hjviewer://hjv-gate/login and …/password (the tray's items, UX-G2) and
+/// any other hjv-gate link. Only Windows opens something: its main window with the login, or P2
+/// while P1 shows; a phone, which any web page may hand the link, opens nothing.
+bool hjvHandleGateLink({List<String>? cmdArgs, Uri? uri, String? uriString}) {
+  final link = cmdArgs != null && cmdArgs.isNotEmpty
+      ? Uri.tryParse(cmdArgs[0])
+      : uri ?? (uriString == null ? null : Uri.tryParse(uriString));
+  final action = hjvGateLinkAction(link);
+  if (action == HjvGateLink.notGate) return false;
+  if (isWindows && _accountBuild && desktopType == DesktopType.main) {
+    unawaited(_gateLinkOpen(action));
+  }
+  return true;
+}
+
+Future<void> _gateLinkOpen(HjvGateLink action) async {
+  await windowOnTop(null);
+  // a cold start: the overlay and the PC's state (read every second) come a moment later
+  await Future.delayed(const Duration(seconds: 1));
+  switch (action) {
+    case HjvGateLink.logIn:
+      if (!bind.isDisableAccount()) await loginDialog();
+    case HjvGateLink.password:
+      for (var tries = 0; tries < 4 && _home() != HjvPcHome.refused; tries++) {
+        await Future.delayed(const Duration(milliseconds: 500));
+      }
+      if (_home() == HjvPcHome.refused) _pcPasswordDialog(_t);
+    case HjvGateLink.notGate:
+    case HjvGateLink.nothing:
+      break;
+  }
 }
