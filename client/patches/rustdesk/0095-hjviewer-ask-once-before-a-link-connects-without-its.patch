 /// handleMsgBox (model.dart), before the PC's own password box: once a session, the note that
@@ -1293,8 +1301,9 @@ void hjvAccessBeforePcPassword(SessionID sessionId, String peerId) {
 /// The sessions whose PC password box looked at the ticket A0 took.
 final _heldNoted = <String>{};
 
-/// A0: true to open the session (a ticket came, or the login), false for [취소].
-Future<bool> _askDialog(HjvAccessTexts t, String target) async {
+/// A0: true to open the session (a ticket came, or the login), false for [취소]. `link`: the PC
+/// a phone's link opened it for (X-17: A0 in the place of LK1, with LK1's line).
+Future<bool> _askDialog(HjvAccessTexts t, String target, {String? link}) async {
   final controller = TextEditingController();
   String? error;
   var busy = false;
@@ -1361,6 +1370,10 @@ Future<bool> _askDialog(HjvAccessTexts t, String target) async {
         crossAxisAlignment: CrossAxisAlignment.start,
