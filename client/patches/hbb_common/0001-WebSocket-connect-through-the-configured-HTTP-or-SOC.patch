+    /// `connect_async_tls_with_config`, but through the configured HTTP or SOCKS5 proxy if there
+    /// is one: where traffic may only leave through a proxy, that is the only way to the server.
+    async fn connect_maybe_proxied(
+        request: tungstenite::handshake::client::Request,
+        ws_config: Option<tungstenite::protocol::WebSocketConfig>,
+        disable_nagle: bool,
+        connector: Option<Connector>,
+    ) -> Result<
+        (
+            WebSocketStream<MaybeTlsStream<TcpStream>>,
+            tungstenite::handshake::client::Response,
+        ),
+        tungstenite::Error,
+    > {
+        let Some(conf) = Config::get_socks() else {
+            return connect_async_tls_with_config(request, ws_config, disable_nagle, connector)
+                .await;
+        };
+        let stream = Self::proxy_tunnel(&conf, request.uri())
+            .await
+            .map_err(|e| tungstenite::Error::Io(Error::new(ErrorKind::Other, e.to_string())))?;
+        stream.set_nodelay(disable_nagle).ok();
+        client_async_tls_with_config(request, stream, ws_config, connector).await
+    }
+
+    async fn proxy_tunnel(
+        conf: &Socks5Server,
+        uri: &tungstenite::http::Uri,
+    ) -> ResultType<TcpStream> {
+        let Some(host) = uri.host() else {
+            bail!("WebSocket URL without a host: {}", uri);
+        };
+        let port = uri
+            .port_u16()
+            .unwrap_or(if uri.scheme_str() == Some("wss") { 443 } else { 80 });
+        let target = TargetAddr::Domain(host.into(), port);
+        let proxy = Proxy::from_conf(conf, None)?;
+        let stream = TcpStream::connect(proxy.proxy_addrs().await?).await?;
+        Ok(match &proxy.intercept {
+            ProxyScheme::Http { .. } => proxy.http_connect(stream, &target).await?.into_inner(),
+            ProxyScheme::Socks5 { .. } => match proxy.intercept.maybe_auth() {
+                Some(auth) => Socks5Stream::connect_with_password_and_socket(
+                    stream,
+                    target,
+                    auth.username(),
+                    auth.password(),
+                )
+                .await?
+                .into_inner(),
+                None => Socks5Stream::connect_with_socket(stream, target)
+                    .await?
+                    .into_inner(),
+            },
+            ProxyScheme::Https { .. } => {
+                bail!("WebSocket through an HTTPS proxy is not supported")
+            }
+        })
+    }
