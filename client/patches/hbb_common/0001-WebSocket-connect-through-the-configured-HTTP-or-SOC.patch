+    #[tokio::test(flavor = "current_thread")]
+    async fn websocket_connects_through_the_configured_http_proxy() {
+        use crate::config::OVERWRITE_SETTINGS;
+        use tokio::io::AsyncReadExt;
+
+        let server = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let server_addr = server.local_addr().unwrap();
+        tokio::spawn(async move {
+            let (tcp, _) = server.accept().await.unwrap();
+            let mut ws = tokio_tungstenite::accept_async(tcp).await.unwrap();
+            while let Some(Ok(msg)) = ws.next().await {
+                if msg.is_binary() {
+                    ws.send(msg).await.unwrap();
+                }
+            }
+        });
+        let proxy = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let proxy_addr = proxy.local_addr().unwrap();
+        let (request_tx, request_rx) = tokio::sync::oneshot::channel();
+        tokio::spawn(async move {
+            let (mut client, _) = proxy.accept().await.unwrap();
+            let mut head = Vec::new();
+            while !head.ends_with(b"\r\n\r\n") {
+                head.push(client.read_u8().await.unwrap());
+            }
+            let head = String::from_utf8(head).unwrap();
+            let target = head.split_whitespace().nth(1).unwrap().to_owned();
+            let mut upstream = TcpStream::connect(target).await.unwrap();
+            client
+                .write_all(b"HTTP/1.1 200 Connection established\r\n\r\n")
+                .await
+                .unwrap();
+            request_tx.send(head).ok();
+            tokio::io::copy_bidirectional(&mut client, &mut upstream)
+                .await
+                .ok();
+        });
+
+        OVERWRITE_SETTINGS
+            .write()
+            .unwrap()
+            .insert(keys::OPTION_PROXY_URL.to_owned(), format!("http://{proxy_addr}"));
+        let stream = WsFramedStream::new(format!("ws://{server_addr}"), None, None, 5000).await;
+        OVERWRITE_SETTINGS
+            .write()
+            .unwrap()
+            .remove(keys::OPTION_PROXY_URL);
+        let mut stream = stream.unwrap();
+
+        let head = timeout(Duration::from_secs(5), request_rx)
+            .await
+            .expect("the connection did not go through the proxy")
+            .unwrap();
+        assert!(
+            head.starts_with(&format!("CONNECT {} HTTP/1.1\r\n", server_addr)),
+            "{}",
+            head
+        );
+        stream
+            .send_bytes(Bytes::from_static(b"through the proxy"))
+            .await
+            .unwrap();
+        let echoed = stream.next().await.unwrap().unwrap();
+        assert_eq!(&echoed[..], b"through the proxy");
+    }
