# /etc/hjviewer/hjviewer.env: settings of hjviewer-hbbs.service and hjviewer-hbbr.service.
# After a change: sudo systemctl restart hjviewer-hbbs hjviewer-hbbr

# Public DNS name the apps are built with (HJV_SERVER); hbbs hands it out as the relay address
HJV_DOMAIN=rd.example.com

# Relay caps in Mb/s: all sessions together (default 1024) and each session (default 128);
# leave empty for the defaults
TOTAL_BANDWIDTH=
SINGLE_BANDWIDTH=
