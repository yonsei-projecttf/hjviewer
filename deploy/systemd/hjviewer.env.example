# /etc/hjviewer/hjviewer.env: settings of hjviewer-hbbs.service and hjviewer-hbbr.service.
# After a change: sudo systemctl restart hjviewer-hbbs hjviewer-hbbr

# Public DNS name the apps are built with (HJV_SERVER); hbbs hands it out as the relay address
HJV_DOMAIN=rd.example.com

# Relay caps in Mb/s: all sessions together (default 1024) and each session (default 128);
# leave empty for the defaults
TOTAL_BANDWIDTH=
SINGLE_BANDWIDTH=

# hbbs's lowest controller version (docs/server-runbook.md 8-3): the file of MIN=, FROM= and TEXT=
# (deploy/min-controller.conf.example) that hbbs reads again every 10 seconds, no restart. No file
# there, which is how it starts, or MIN= with nothing after it: nobody is refused. It is a file of
# its own, root:hjviewer 0640, because its TEXT holds door 2's link and this file is not secret.
HJV_MIN_CONTROLLER_FILE=/etc/hjviewer/min-controller.conf

# hbbs's access check, the staff-only gate of 1.8.0 (docs/server-runbook.md 9): the file of MODE=,
# KEY= and NOT_BEFORE= (deploy/access.conf.example) that hbbs reads again every 10 seconds.
# Commented out, as it ships: no check. Set it only once that file is there, which the runbook
# writes with MODE=off first: from then on a missing or broken file refuses everyone, and so does
# HJV_ACCESS_FILE= with nothing after it. To turn the check off, write MODE=off in the file.
#HJV_ACCESS_FILE=/etc/hjviewer/access.conf
