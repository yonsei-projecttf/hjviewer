# Runs hjviewer-api-check.service every five minutes (design v3 §5-9). Enable it once hjv-api
# runs: sudo systemctl enable --now hjviewer-api-check.timer

[Unit]
Description=Check hjv-api every five minutes
Documentation=https://github.com/yonsei-projecttf/hjviewer/blob/main/server/api/README.md

[Timer]
OnCalendar=*:0/5
AccuracySec=10s

[Install]
WantedBy=timers.target
