# Public DNS name of the server; its A record (and AAAA, if any) must point at this machine.
HJV_DOMAIN=rd.example.com

# Optional, see docs/server-runbook.md:
# behind an existing web server on 80/443 (nginx, Apache) instead of Caddy
#COMPOSE_FILE=docker-compose.behind-proxy.yml
# base images from Docker Hub instead of its mirror on public.ecr.aws
#HJV_REGISTRY=docker.io/library
# parallel compile jobs of the server build (default 2; each can take about 1 GB of memory)
#HJV_BUILD_JOBS=2
# relay caps in Mb/s: all sessions together (default 1024), and each session (default 128)
#HJV_TOTAL_BANDWIDTH=100
#HJV_SINGLE_BANDWIDTH=20
